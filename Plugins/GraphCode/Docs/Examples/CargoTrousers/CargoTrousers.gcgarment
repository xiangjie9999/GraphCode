gcgarment 1  mesh:/Game/GraphCodeExamples/Garment/SM_TPoseBody  into:/Game/GraphCodeExamples/Garment/CargoTrousers/Built
# CargoTrousers: a GraphCode Garment example. Rings and numbers are measured on the example body (../GarmentBodies); re-measure them on yours.

build {
  SM_CargoTrousers = $Cargo
  T_CargoStitches = bake(decal, resolution=2048)
}

Twill = fabric(weight=281.88, thickness=0.70mm, stretch=(3.2%, 2.3%), shear=148, stiffness=(2.24, 1.84), friction=0.53)
Kit = shape('/Game/GraphCodeExamples/Garment/CargoTrousers/CargoParts')

Waist = ring((0, 9.859, 102.95), (-14.041, -0.15, 102.95), (0, -10.151, 102.95), (14.041, -0.15, 102.95)) {
  expand(0.24)
}
LoopRow = ring($Waist) {
  move((0, 0, 1.59))
  expand(1)
}
ButtonRow = ring($Waist) {
  move((0, 0, 2.065))
  expand(1)
}
Hip = ring((0, 10.2, 91), (-17.19, -0.9, 91), (0, -12.2, 91), (17.19, -0.9, 91)) {
  expand(1.114)
}
HighHip100 = ring((0, 9.943, 100), (-14.772, -0.9, 100), (0, -10.657, 100), (14.772, -0.9, 100)) {
  expand((0.456, 1.325))
}
HighHip97 = ring((0, 10.029, 97), (-15.585, -0.9, 97), (0, -11.171, 97), (15.585, -0.9, 97)) {
  expand((0.675, 1.745))
}
HighHip94 = ring((0, 10.114, 94), (-16.397, -0.9, 94), (0, -11.686, 94), (16.397, -0.9, 94)) {
  expand((0.895, 1.663))
}
HipFlapAt = ring((0, 10.046, 96.4), (15.747, -0.9, 96.4), (0, -11.274, 96.4), (-15.747, -0.9, 96.4)) {
  expand(1)
}
HipButtons = ring((0, 10.063, 95.8), (-15.91, -0.9, 95.8), (0, -11.377, 95.8), (15.909, -0.9, 95.8)) {
  expand(1)
}
Crotch = ring((-16.795, 0.8, 76.44), (16.795, 0.8, 76.44)) {
  expand(1.505)
}
Top_R = ring((-16.795, 0.8, 76.44), (-2.205, 0.8, 76.44)) {
  expand(1.505)
}
Top_L = ring((16.795, 0.8, 76.44), (2.205, 0.8, 76.44)) {
  expand(1.505)
}
UpperThigh_R = ring((-16.74, 0, 71.44), (-2.26, 0, 71.44)) {
  expand((1.56, 1.92))
}
UpperThigh_L = ring((16.74, 0, 71.44), (2.26, 0, 71.44)) {
  expand((1.56, 1.92))
}
Thigh_R = ring((-16.34, 0, 66.44), (-2.66, 0, 66.44)) {
  expand((1.96, 2.63))
}
Thigh_L = ring((16.34, 0, 66.44), (2.66, 0, 66.44)) {
  expand((1.96, 2.63))
}
PocketAt_R = ring($Thigh_R) {
  move((0, 0, -3.00))
}
PocketAt_L = ring($Thigh_L) {
  move((0, 0, -3.00))
}
PocketButtons_R = ring($Thigh_R) {
  move((0, 0, 4.27))
}
PocketButtons_L = ring($Thigh_L) {
  move((0, 0, 4.27))
}
Leg63_R = ring((-16.00, 0, 63), (-3.00, 0, 63)) {
  expand((2.300, 2.996))
}
Leg63_L = ring((16.00, 0, 63), (3.00, 0, 63)) {
  expand((2.300, 2.996))
}
Leg60_R = ring((-15.70, 0, 60), (-3.30, 0, 60)) {
  expand((2.600, 3.310))
}
Leg60_L = ring((15.70, 0, 60), (3.30, 0, 60)) {
  expand((2.600, 3.310))
}
Leg57_R = ring((-15.40, 0, 57), (-3.60, 0, 57)) {
  expand((2.900, 3.622))
}
Leg57_L = ring((15.40, 0, 57), (3.60, 0, 57)) {
  expand((2.900, 3.622))
}
Leg54_R = ring((-15.10, 0, 54), (-3.90, 0, 54)) {
  expand((3.200, 3.935))
}
Leg54_L = ring((15.10, 0, 54), (3.90, 0, 54)) {
  expand((3.200, 3.935))
}
Leg51_R = ring((-14.80, 0, 51), (-4.20, 0, 51)) {
  expand((3.500, 4.248))
}
Leg51_L = ring((14.80, 0, 51), (4.20, 0, 51)) {
  expand((3.500, 4.248))
}
Knee_R = ring((-14.50, 0, 48), (-4.50, 0, 48)) {
  expand((3.800, 4.566))
}
Knee_L = ring((14.50, 0, 48), (4.50, 0, 48)) {
  expand((3.800, 4.566))
}
Leg45_R = ring((-14.58, 0, 45), (-4.42, 0, 45)) {
  expand((3.717, 4.461))
}
Leg45_L = ring((14.58, 0, 45), (4.42, 0, 45)) {
  expand((3.717, 4.461))
}
Leg42_R = ring((-14.67, 0, 42), (-4.33, 0, 42)) {
  expand((3.633, 4.362))
}
Leg42_L = ring((14.67, 0, 42), (4.33, 0, 42)) {
  expand((3.633, 4.362))
}
Leg39_R = ring((-14.75, 0, 39), (-4.25, 0, 39)) {
  expand((3.550, 4.264))
}
Leg39_L = ring((14.75, 0, 39), (4.25, 0, 39)) {
  expand((3.550, 4.264))
}
Leg36_R = ring((-14.83, 0, 36), (-4.17, 0, 36)) {
  expand((3.467, 4.163))
}
Leg36_L = ring((14.83, 0, 36), (4.17, 0, 36)) {
  expand((3.467, 4.163))
}
Leg33_R = ring((-14.92, 0, 33), (-4.08, 0, 33)) {
  expand((3.383, 4.064))
}
Leg33_L = ring((14.92, 0, 33), (4.08, 0, 33)) {
  expand((3.383, 4.064))
}
Calf_R = ring((-15.00, 0, 30), (-4.00, 0, 30)) {
  expand((3.300, 3.969))
}
Calf_L = ring((15.00, 0, 30), (4.00, 0, 30)) {
  expand((3.300, 3.969))
}
Leg27_R = ring((-14.82, 0, 27), (-4.18, 0, 27)) {
  expand((3.477, 4.142))
}
Leg27_L = ring((14.82, 0, 27), (4.18, 0, 27)) {
  expand((3.477, 4.142))
}
Leg24_R = ring((-14.65, 0, 24), (-4.35, 0, 24)) {
  expand((3.655, 4.318))
}
Leg24_L = ring((14.65, 0, 24), (4.35, 0, 24)) {
  expand((3.655, 4.318))
}
Leg21_R = ring((-14.47, 0, 21), (-4.53, 0, 21)) {
  expand((3.832, 4.495))
}
Leg21_L = ring((14.47, 0, 21), (4.53, 0, 21)) {
  expand((3.832, 4.495))
}
Shin_R = ring((-14.29, 0, 18), (-4.71, 0, 18)) {
  expand((4.009, 4.672))
}
Shin_L = ring((14.29, 0, 18), (4.71, 0, 18)) {
  expand((4.009, 4.672))
}
Leg15_R = ring((-14.11, 0, 15), (-4.89, 0, 15)) {
  expand((4.186, 4.849))
}
Leg15_L = ring((14.11, 0, 15), (4.89, 0, 15)) {
  expand((4.186, 4.849))
}
Leg12_R = ring((-13.94, 0, 12), (-5.06, 0, 12)) {
  expand((4.364, 5.026))
}
Leg12_L = ring((13.94, 0, 12), (5.06, 0, 12)) {
  expand((4.364, 5.026))
}
Leg9_R = ring((-13.76, 0, 9), (-5.24, 0, 9)) {
  expand((4.541, 5.204))
}
Leg9_L = ring((13.76, 0, 9), (5.24, 0, 9)) {
  expand((4.541, 5.204))
}
Ankle_R = ring((-13.78, 0, 6), (-5.22, 0, 6)) {
  expand((4.525, 4.946))
}
Ankle_L = ring((13.78, 0, 6), (5.22, 0, 6)) {
  expand((4.525, 4.946))
}

Leg_R = garment($Top_R, $UpperThigh_R, $Thigh_R, $Leg63_R, $Leg60_R, $Leg57_R, $Leg54_R, $Leg51_R, $Knee_R, $Leg45_R, $Leg42_R, $Leg39_R, $Leg36_R, $Leg33_R, $Calf_R, $Leg27_R, $Leg24_R, $Leg21_R, $Shin_R, $Leg15_R, $Leg12_R, $Leg9_R, $Ankle_R, loose=100%, fabric=$Twill) {
  construct(rim=(turned=3.2cm, layers=2))
  add($Kit.CargoPocket, at=$PocketAt_R@0, hold=0)
  add($Kit.Button, at=$PocketButtons_R@0-2.92cm, gap=0.86, hold=0)
  add($Kit.Button, at=$PocketButtons_R@0+2.92cm, gap=0.86, hold=0)
  Side_R = line($Top_R@0, $Ankle_R@0)
  Inside_R = line($Top_R@0.5, $Ankle_R@0.5)
  stitch($Side_R, offset=0.635cm)
  stitch($Side_R, offset=-0.635cm)
  stitch($Inside_R, offset=0.635cm)
  stitch($Inside_R, offset=-0.635cm)
}
Leg_L = garment($Top_L, $UpperThigh_L, $Thigh_L, $Leg63_L, $Leg60_L, $Leg57_L, $Leg54_L, $Leg51_L, $Knee_L, $Leg45_L, $Leg42_L, $Leg39_L, $Leg36_L, $Leg33_L, $Calf_L, $Leg27_L, $Leg24_L, $Leg21_L, $Shin_L, $Leg15_L, $Leg12_L, $Leg9_L, $Ankle_L, loose=100%, fabric=$Twill) {
  construct(rim=(turned=3.2cm, layers=2))
  add($Kit.CargoPocket, at=$PocketAt_L@0, rotate=(0, 0, 180), hold=0)
  add($Kit.Button, at=$PocketButtons_L@0-2.92cm, gap=0.86, hold=0)
  add($Kit.Button, at=$PocketButtons_L@0+2.92cm, gap=0.86, hold=0)
  Side_L = line($Top_L@0, $Ankle_L@0)
  Inside_L = line($Top_L@0.5, $Ankle_L@0.5)
  stitch($Side_L, offset=0.635cm)
  stitch($Side_L, offset=-0.635cm)
  stitch($Inside_L, offset=0.635cm)
  stitch($Inside_L, offset=-0.635cm)
}
Top = garment($Waist, $HighHip100, $HighHip97, $HighHip94, $Hip, loose=100%, fabric=$Twill) {
  construct()
  band($Waist, width=4.13cm, fabric=$Twill, cut=100%)
  press($Waist, -0.95cm)
  add($Kit.Button, at=$ButtonRow@0-1.11cm, hold=0)
  add($Kit.BeltLoop, at=$LoopRow@0.125)
  add($Kit.BeltLoop, at=$LoopRow@0.875)
  add($Kit.BeltLoop, at=$LoopRow@0.265)
  add($Kit.BeltLoop, at=$LoopRow@0.735)
  add($Kit.BeltLoop, at=$LoopRow@0.515)
  add($Kit.BeltLoop, at=$LoopRow@0.3825)
  add($Kit.BeltLoop, at=$LoopRow@0.6175)
  stitch($Waist, offset=-0.24cm)
  Front = line($Waist@0, $Hip@0)
  FlyCentre = line($Front@0.24cm offset=0cm, $Front@11cm offset=0cm)
  FlySide = line($Front@0.24cm offset=-4.45cm, $Front@6.55cm offset=-4.45cm)
  FlyBase = line($Front@6.55cm offset=-4.45cm, $Front@11cm offset=0cm)
  stitch($FlyCentre)
  stitch($FlySide)
  stitch($FlyBase)
  FrontPocketR = line($Front@0.24cm offset=14.54cm, $Front@11.5cm offset=21.73cm)
  FrontPocketL = line($Front@0.24cm offset=-14.54cm, $Front@11.5cm offset=-21.73cm)
  stitch($FrontPocketR)
  stitch($FrontPocketL)
  add($Kit.HipFlap, at=$HipFlapAt@0.5+10.66cm, hold=0)
  add($Kit.HipFlap, at=$HipFlapAt@0.5-10.66cm, hold=0)
  add($Kit.Button, at=$HipButtons@0.5+8.88cm, gap=0.22, hold=0)
  add($Kit.Button, at=$HipButtons@0.5+12.44cm, gap=0.22, hold=0)
  add($Kit.Button, at=$HipButtons@0.5-8.88cm, gap=0.22, hold=0)
  add($Kit.Button, at=$HipButtons@0.5-12.44cm, gap=0.22, hold=0)
}
Cargo = garment($Hip, $Crotch, loose=100%, fabric=$Twill) {
  join($Crotch@0.25, $Crotch@0.75, $Top_L@0.5, $Top_R@0.5)
  add($Top)
  add($Leg_L)
  add($Leg_R)
  construct()
  hang(from=$Hip)
  stitch($Ankle_R, offset=2.96cm)
  stitch($Ankle_L, offset=2.96cm)
}
