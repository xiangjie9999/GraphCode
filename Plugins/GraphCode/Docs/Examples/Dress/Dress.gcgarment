gcgarment 1  mesh:/Game/GraphCodeExamples/Garment/SM_TPoseBody  into:/Game/GraphCodeExamples/Garment/Dress/Built
# Dress: a GraphCode Garment example. Rings and numbers are measured on the example body (../GarmentBodies); re-measure them on yours.

build {
  SM_Dress = $Dress
  T_DressStitches = bake(decal, resolution=2048)
}

Poplin = fabric(weight=135.1, thickness=0.38mm, stretch=(1.5%, 7.6%), shear=106.52, stiffness=(1.97, 1.83), friction=0.49)

Neck = ring((0.000, 9.174, 143.159), (2.437, 8.809, 143.476), (4.384, 7.865, 144.369), (5.951, 6.112, 145.754), (7.247, 0.000, 147.545), (6.463, -3.887, 147.115), (4.839, -5.642, 146.783), (2.607, -6.735, 146.569), (0.000, -7.126, 146.493), (-2.607, -6.735, 146.569), (-4.839, -5.642, 146.783), (-6.463, -3.887, 147.115), (-7.247, 0.000, 147.545), (-5.951, 6.112, 145.754), (-4.384, 7.865, 144.369), (-2.437, 8.809, 143.476)) {
  expand(0.15)
}
Armhole_L = ring((10.567, 0.000, 145.524), (10.567, 9.566, 136.438), (16.985, 1.400, 129.926), (10.567, -8.321, 136.438)) {
  expand(0.15)
}
Armhole_R = ring((-10.567, 0.000, 145.524), (-10.567, 9.566, 136.438), (-16.985, 1.400, 129.926), (-10.567, -8.321, 136.438)) {
  expand(0.15)
}
Chest = ring((0.000, 13.400, 128.000), (16.840, 1.400, 128.000), (0.000, -10.600, 128.000), (-16.840, 1.400, 128.000)) {
  expand(1.20)
}
Waist = ring((0.000, 9.800, 105.000), (13.500, 0.000, 105.000), (0.000, -9.800, 105.000), (-13.500, 0.000, 105.000)) {
  expand(0.59)
}
Hem = ring($Waist) {
  move((0, 0, -43.95))
  expand(25.38)
}

Skirt = garment($Waist, $Hem, loose=100%, fabric=$Poplin)

Yoke = profile(0=0%, 1=100%)
Dress = garment($Neck, $Chest, $Waist, loose@1=$Yoke, loose@2=100%, fabric=$Poplin) {
  cut($Armhole_L)
  cut($Armhole_R)
  add($Skirt)
  construct(rim=(turned=0.635cm, layers=3))
  rim($Neck, turned=0cm)
  rim($Armhole_L, turned=0cm)
  rim($Armhole_R, turned=0cm)
  band($Neck, width=(1.25cm, 2.5cm), fabric=$Poplin, cut=100%)
  band($Armhole_L, width=(1.25cm, 2.5cm), fabric=$Poplin, cut=100%)
  band($Armhole_R, width=(1.25cm, 2.5cm), fabric=$Poplin, cut=100%)
  settle(time=5)
  stitch($Neck, offset=1.25cm)
  stitch($Armhole_L, offset=1.25cm)
  stitch($Armhole_R, offset=1.25cm)
  stitch($Hem, offset=0.476cm)
}
