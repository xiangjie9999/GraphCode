gcgarment 1  mesh:/Game/GraphCodeExamples/Garment/SM_TPoseBody  into:/Game/GraphCodeExamples/Garment/LeatherArmour/Built
# LeatherArmour: a GraphCode Garment example. Rings and numbers are measured on the example body (../GarmentBodies); re-measure them on yours.

build {
  SM_LeatherArmour = $Armour
}

HardLeather = fabric(weight=4200, thickness=4mm, stretch=(3.46%, 8.07%), shear=1758.5, stiffness=(23, 23), friction=0.54)
Parts = shape('/Game/GraphCodeExamples/Garment/LeatherArmour/LeatherArmourParts')

Neck = ring((0.000, 7.188, 146.391), (3.605, 6.244, 146.793), (6.002, 3.465, 147.598), (6.500, 0.000, 148.000), (6.002, -3.465, 147.598), (3.605, -6.244, 146.793), (0.000, -7.188, 146.391), (-3.605, -6.244, 146.793), (-6.002, -3.465, 147.598), (-6.500, 0.000, 148.000), (-6.002, 3.465, 147.598), (-3.605, 6.244, 146.793)) {
  expand((0.478, 0.388))
}
Hem = ring((0.000, 10.000, 98.000), (15.300, 0.000, 98.000), (0.000, -11.000, 98.000), (-15.300, 0.000, 98.000)) {
  expand(0.418)
}
TabRing = ring($Hem) {
  shift((-1.2, 0, 0))
}
TabRivRing = ring($Hem) {
  shift((-0.6, 0, 0))
}
Armhole_L = ring((14.800, 0.000, 142.952), (13.026, 9.039, 131.375), (16.527, 0.454, 125.000), (12.198, -7.201, 132.750)) {
