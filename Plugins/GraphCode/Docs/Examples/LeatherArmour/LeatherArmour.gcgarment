Armour = garment($Neck, $Hem, loose=0%, fabric=$HardLeather) {
  cut($Armhole_L)
  cut($Armhole_R)
  construct()
  BackNeck = line($Neck@0.004, $Neck@0.5, $Neck@0.996)
  Collar = extend($BackNeck, 6.26)
  Front = line($Neck@0, $Hem@0)
  GapFrontL = line($Front@0.57 offset=22.45cm, $Hem@0.2344)
  GapBackL = line($Front@0.57 offset=24.15cm, $Hem@0.2546)
  GapBackR = line($Front@0.57 offset=-24.15cm, $Hem@0.7454)
  GapFrontR = line($Front@0.57 offset=-22.45cm, $Hem@0.7656)
  cut($GapFrontL, $GapBackL)
  cut($GapBackR, $GapFrontR)
  add($Parts.Lacing, at=$LaceL1@0, hold=0)
  add($Parts.Lacing, at=$LaceL2@0, hold=0)
  add($Parts.Lacing, at=$LaceL3@0, hold=0)
  add($Parts.Lacing, at=$LaceL4@0, hold=0)
  add($Parts.Lacing, at=$LaceL5@0, hold=0)
  add($Parts.Lacing, at=$LaceL6@0, hold=0)
  add($Parts.Lacing, at=$LaceL7@0, hold=0)
  add($Parts.Lacing, at=$LaceR1@0, hold=0)
  add($Parts.Lacing, at=$LaceR2@0, hold=0)
  add($Parts.Lacing, at=$LaceR3@0, hold=0)
  add($Parts.Lacing, at=$LaceR4@0, hold=0)
  add($Parts.Lacing, at=$LaceR5@0, hold=0)
  add($Parts.Lacing, at=$LaceR6@0, hold=0)
  add($Parts.Lacing, at=$LaceR7@0, hold=0)
  add($Parts.ShoulderBuckle, at=$StrapL@0)
  add($Parts.ShoulderBuckle, at=$StrapR@0, rotate=(0, 0, 180))
  add($Parts.ShoulderStrap, at=$StrapTopL@0)
  add($Parts.ShoulderStrap, at=$StrapTopR@0, rotate=(0, 0, 180))
  add($Parts.StrapRoot, at=$StrapBackL@0, rotate=(0, 0, 180))
  add($Parts.StrapRoot, at=$StrapBackR@0)
  add($Parts.LameSeg, along=$BandF1, repeat=9, spread=39.56%)
  add($Parts.LameSeg, along=$BandB1, repeat=8, spread=38.87%)
  add($Parts.LameSeg, along=$BandF2, repeat=8, spread=41.07%)
  add($Parts.LameSeg, along=$BandB2, repeat=8, spread=39.61%)
  add($Parts.LameSeg, along=$BandF3, repeat=9, spread=40.78%)
  add($Parts.LameSeg, along=$BandB3, repeat=9, spread=39.22%)
  add($Parts.LameSeg, along=$BandF4, repeat=10, spread=42.77%)
  add($Parts.LameSeg, along=$BandB4, repeat=9, spread=40.58%)
  add($Parts.LameSeg, along=$BandF5, repeat=11, spread=44.72%)
  add($Parts.LameSeg, along=$BandB5, repeat=10, spread=41.50%)
  add($Parts.LameSeg, along=$BandF6, repeat=7, spread=29.54%)
  add($Parts.LameSeg, along=$BandB6, repeat=7, spread=28.13%)
  add($Parts.LameSegUp, along=$BandF7, repeat=6, spread=23.97%)
  add($Parts.LameSegUp, along=$BandB7, repeat=7, spread=24.84%)
  add($Parts.Rivet, along=$BandF1, repeat=9, spread=39.56%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandB1, repeat=8, spread=38.87%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandF2, repeat=8, spread=41.07%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandB2, repeat=8, spread=39.61%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandF3, repeat=9, spread=40.78%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandB3, repeat=9, spread=39.22%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandF4, repeat=10, spread=42.77%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandB4, repeat=9, spread=40.58%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandF5, repeat=11, spread=44.72%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandB5, repeat=10, spread=41.50%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandF6, repeat=7, spread=29.54%, gap=0.4, hold=0)
  add($Parts.Rivet, along=$BandB6, repeat=7, spread=28.13%, gap=0.4, hold=0)
  add($Parts.RivetUp, along=$BandF7, repeat=6, spread=23.97%, gap=0.4, hold=0)
  add($Parts.RivetUp, along=$BandB7, repeat=7, spread=24.84%, gap=0.4, hold=0)
  add($Parts.Tab, at=$TabRing@0.8047, gap=0.4, hold=0, rotate=(4.14, 0, 0))
  add($Parts.Tab, at=$TabRing@0.8828, gap=0.4, hold=0)
  add($Parts.Tab, at=$TabRing@0.9609, gap=0.4, hold=0)
  add($Parts.Tab, at=$TabRing@0.0391, gap=0.4, hold=0)
  add($Parts.Tab, at=$TabRing@0.1172, gap=0.4, hold=0)
  add($Parts.Tab, at=$TabRing@0.1953, gap=0.4, hold=0, rotate=(5.30, 0, 0))
  add($Parts.Tab, at=$TabRing@0.2955, gap=0.4, hold=0, rotate=(6.03, 0, 0))
  add($Parts.Tab, at=$TabRing@0.3773, gap=0.4, hold=0, rotate=(2.95, 0, 0))
  add($Parts.Tab, at=$TabRing@0.4591, gap=0.4, hold=0, rotate=(2.27, 0, 0))
  add($Parts.Tab, at=$TabRing@0.5409, gap=0.4, hold=0, rotate=(2.56, 0, 0))
  add($Parts.Tab, at=$TabRing@0.6227, gap=0.4, hold=0, rotate=(2.90, 0, 0))
  add($Parts.Tab, at=$TabRing@0.7045, gap=0.4, hold=0, rotate=(5.95, 0, 0))
  add($Parts.Rivet, at=$TabRivRing@0.8047, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.8828, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.9609, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.0391, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.1172, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.1953, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.2955, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.3773, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.4591, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.5409, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.6227, gap=0.8, hold=0)
  add($Parts.Rivet, at=$TabRivRing@0.7045, gap=0.8, hold=0)
