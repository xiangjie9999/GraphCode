gcgarment 1  mesh:/Game/GraphCodeExamples/Garment/SM_TPoseBody  into:/Game/GraphCodeExamples/Garment/Scarf/Built
# Scarf: a GraphCode Garment example. Rings and numbers are measured on the example body (../GarmentBodies); re-measure them on yours.

build {
  SM_Scarf = $Scarf
}

Wool = fabric(weight=480, thickness=3.40mm, stretch=(122.47%, 119%), shear=25.17, stiffness=(2.47, 1.34), friction=2.22)

Top = ring((0.000, 5.800, 156.000), (2.220, 5.359, 156.000), (4.101, 4.101, 156.000), (5.359, 2.220, 156.000), (5.800, 0.000, 156.000), (5.359, -2.220, 156.000), (4.101, -4.101, 156.000), (2.220, -5.359, 156.000), (0.000, -5.800, 156.000), (-2.220, -5.359, 156.000), (-4.101, -4.101, 156.000), (-5.359, -2.220, 156.000), (-5.800, -0.000, 156.000), (-5.359, 2.220, 156.000), (-4.101, 4.101, 156.000), (-2.220, 5.359, 156.000)) {
  expand(0.27)
}
Bottom = ring((0.000, 8.553, 144.170), (3.371, 8.139, 144.310), (6.688, 6.688, 144.770), (9.330, 3.865, 145.410), (10.328, 0.000, 145.670), (9.330, -3.865, 145.410), (6.688, -6.688, 144.770), (3.371, -8.139, 144.310), (0.000, -8.553, 144.170), (-3.371, -8.139, 144.310), (-6.688, -6.688, 144.770), (-9.330, -3.865, 145.410), (-10.328, -0.000, 145.670), (-9.330, 3.865, 145.410), (-6.688, 6.688, 144.770), (-3.371, 8.139, 144.310)) {
  expand(0.27)
}

Scarf = garment($Top, $Bottom, loose=0%, fabric=$Wool) {
  construct()
  Right = line($Top@0.1013, $Bottom@0.1013)
  Left = line($Top@0.8987, $Bottom@0.8987)
  cut($Left, $Right)
  EndR = extend($Right, 64.99)
  EndL = extend($Left, 64.99)
  guide($EndR, (6.25, 12.834, 130), (6.25, 8.666, 105))
  guide($EndL, (-6.25, 13.514, 130), (-6.25, 8.666, 105))
}
