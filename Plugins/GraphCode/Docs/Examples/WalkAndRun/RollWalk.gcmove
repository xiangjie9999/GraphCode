gcmove 1 character:/Game/GraphCodeExamples/RifleWalk_20261003/BP_RifleWalker part:Body
         ik_rig:/Game/GraphCodeExamples/RifleWalk_20261003/IKR_RifleMan
         controls:/Game/__MCPTests/Gait_20261007/FootRoll
         into:/Game/__MCPTests/Gait_20261007 fps:30
build {
  A_RollWalk = $Walk [loop, root_motion]
  A_RollWalk4 = $Walk4
  A_RollWalkFK = $WalkFK [loop]
}
# MOVE-GAIT1 G2 fixture (Docs/GC-MOVE-GAIT-PLAN.md): RifleWalk.gcmove's legs, unchanged curves, with each plant rolling
# over the heel, the ball and the toes instead of holding the heel point at the landing turn. WalkFK is the same curves
# with no plant, the foot turn as drawn, which T2.3(c) compares against. Built into __MCPTests, never shipped.
Hip = profile(0.0000 = 20.56, 0.0294 = 21.96, 0.0588 = 20.36, 0.0882 = 20.42, 0.1176 = 19.55, 0.1471 = 17.48, 0.1765 = 14.88, 0.2059 = 11.99, 0.2353 = 9.03, 0.2647 = 6.22, 0.2941 = 3.70, 0.3235 = 1.50, 0.3529 = -0.58, 0.3824 = -2.85, 0.4118 = -5.94, 0.4412 = -6.79, 0.4706 = -8.27, 0.5000 = -5.95, 0.5294 = -10.81, 0.5588 = -9.84, 0.5882 = -6.51, 0.6176 = 0.88, 0.6471 = 2.16, 0.6765 = 3.51, 0.7059 = 4.50, 0.7353 = 6.34, 0.7647 = 8.26, 0.7941 = 12.09, 0.8235 = 14.86, 0.8529 = 15.84, 0.8824 = 14.57, 0.9118 = 17.60, 0.9412 = 19.78, 0.9706 = 20.85, loop=true)
Knee = profile(0.0000 = -1.23, 0.0294 = 5.07, 0.0588 = 3.92, 0.0882 = 7.85, 0.1176 = 10.47, 0.1471 = 10.46, 0.1765 = 9.28, 0.2059 = 7.42, 0.2353 = 5.37, 0.2647 = 3.61, 0.2941 = 2.51, 0.3235 = 2.09, 0.3529 = 1.96, 0.3824 = 1.42, 0.4118 = -0.95, 0.4412 = 1.36, 0.4706 = 3.04, 0.5000 = 13.18, 0.5294 = 6.14, 0.5588 = 10.76, 0.5882 = 18.69, 0.6176 = 37.33, 0.6471 = 38.09, 0.6765 = 35.84, 0.7059 = 30.52, 0.7353 = 25.98, 0.7647 = 20.88, 0.7941 = 19.79, 0.8235 = 16.40, 0.8529 = 9.60, 0.8824 = -1.23, 0.9118 = -1.23, 0.9412 = -1.23, 0.9706 = -1.23, loop=true)
Ankle = profile(0.0000 = -4.79, 0.0294 = -5.09, 0.0588 = -13.50, 0.0882 = -12.57, 0.1176 = -9.08, 0.1471 = -7.01, 0.1765 = -5.60, 0.2059 = -4.57, 0.2353 = -3.66, 0.2647 = -2.61, 0.2941 = -1.19, 0.3235 = 0.59, 0.3529 = 2.54, 0.3824 = 4.27, 0.4118 = 4.98, 0.4412 = 6.67, 0.4706 = 11.31, 0.5000 = 19.13, 0.5294 = 14.60, 0.5588 = 9.51, 0.5882 = -0.96, 0.6176 = 5.03, 0.6471 = 10.19, 0.6765 = 14.99, 0.7059 = 17.38, 0.7353 = 17.55, 0.7647 = 12.62, 0.7941 = 7.93, 0.8235 = 2.76, 0.8529 = -2.97, 0.8824 = -9.52, 0.9118 = -9.00, 0.9412 = -7.70, 0.9706 = -6.12, loop=true)
Toes = profile(0.0000 = -0.00, 0.0294 = -0.00, 0.0588 = -0.00, 0.0882 = -0.00, 0.1176 = -0.00, 0.1471 = -0.00, 0.1765 = -0.00, 0.2059 = -0.00, 0.2353 = -0.00, 0.2647 = -0.00, 0.2941 = -0.00, 0.3235 = -0.00, 0.3529 = -0.00, 0.3824 = -0.00, 0.4118 = -0.00, 0.4412 = 1.47, 0.4706 = -0.00, 0.5000 = -0.00, 0.5294 = 2.35, 0.5588 = 11.10, 0.5882 = 26.16, 0.6176 = 23.83, 0.6471 = 14.13, 0.6765 = 3.64, 0.7059 = 0.00, 0.7353 = 0.00, 0.7647 = 0.00, 0.7941 = 0.00, 0.8235 = 0.00, 0.8529 = 0.00, 0.8824 = 0.00, 0.9118 = 0.00, 0.9412 = 0.00, 0.9706 = 0.00, loop=true)
Bob = profile(0.0000 = -4.13, 0.0294 = -3.78, 0.0588 = -3.52, 0.0882 = -3.26, 0.1176 = -2.76, 0.1471 = -2.10, 0.1765 = -1.44, 0.2059 = -0.85, 0.2353 = -0.39, 0.2647 = -0.11, 0.2941 = 0.00, 0.3235 = -0.05, 0.3529 = -0.24, 0.3824 = -0.53, 0.4118 = -0.87, 0.4412 = -1.24, 0.4706 = -2.30, 0.5000 = -4.13, 0.5294 = -3.78, 0.5588 = -3.52, 0.5882 = -3.26, 0.6176 = -2.76, 0.6471 = -2.10, 0.6765 = -1.44, 0.7059 = -0.85, 0.7353 = -0.39, 0.7647 = -0.11, 0.7941 = 0.00, 0.8235 = -0.05, 0.8529 = -0.24, 0.8824 = -0.53, 0.9118 = -0.87, 0.9412 = -1.24, 0.9706 = -2.30, loop=true)
Floor = ground(z=0)
OnGroundR = profile(0=1, 0.6=1, 0.62=0, 0.98=0, loop=true)
OnGroundL = profile(0=1, 0.1=1, 0.12=0, 0.48=0, 0.5=1, loop=true)
Walk = clip(frames=34) {
  shift(Root, axis=X, by=$Bob)
  swing(thigh_r, axis=fold, by=$Hip)
  swing(thigh_l, axis=fold, by=$Hip) [phase=0.5]
  swing(thigh_r, axis=side, by=1.5)
  swing(thigh_l, axis=side, by=1.5)
  swing(calf_r, axis=fold, by=$Knee)
  swing(calf_l, axis=fold, by=$Knee) [phase=0.5]
  swing(foot_r, axis=fold, by=$Ankle)
  swing(foot_l, axis=fold, by=$Ankle) [phase=0.5]
  swing(ball_r, axis=fold, by=$Toes)
  swing(ball_l, axis=fold, by=$Toes) [phase=0.5]
  plant(leg_R, on=$Floor, roll=(Heel_R, Ball_R, Toe_R), drive=Root, weight=$OnGroundR)
  plant(leg_L, on=$Floor, roll=(Heel_L, Ball_L, Toe_L), drive=Root, weight=$OnGroundL)
}
Walk4 = clip(from=$Walk, repeat=4) { }
WalkFK = clip(frames=34) {
  shift(Root, axis=X, by=$Bob)
  swing(thigh_r, axis=fold, by=$Hip)
  swing(thigh_l, axis=fold, by=$Hip) [phase=0.5]
  swing(thigh_r, axis=side, by=1.5)
  swing(thigh_l, axis=side, by=1.5)
  swing(calf_r, axis=fold, by=$Knee)
  swing(calf_l, axis=fold, by=$Knee) [phase=0.5]
  swing(foot_r, axis=fold, by=$Ankle)
  swing(foot_l, axis=fold, by=$Ankle) [phase=0.5]
  swing(ball_r, axis=fold, by=$Toes)
  swing(ball_l, axis=fold, by=$Toes) [phase=0.5]
}
