build {
  A_Run = $Run [loop, root_motion]
  A_Run4 = $Run4
  A_RunFK = $RunFK [loop]
}
# MEASURED HUMAN RUN (3.96 m/s), written by Tools/Research/Gait/make_gait_clip.py; do not edit by hand.
# Source: Hamner, Seth and Delp 2010, subject02 running take, one stride from right 20 N strike, 0.7005 s; curves extracted in Docs/Research/gait-reference-curves.md; attribution in THIRD-PARTY-NOTICES.md.
# 42 frames at 60 fps = 0.7000 s against the measured 0.7005 s.
# Mapped (anatomical angle -> Runner rig control), in the source joint order:
#   pelvis Z <- PelvisTilt: pelvis tilt (+ posterior) -> pelvis Z (+ posterior)
#   pelvis Y <- PelvisList: pelvis list (+ top to the right) -> pelvis Y (+ top to the right)
#   pelvis X <- PelvisTurn: pelvis rotation (+ turns left) -> pelvis X (+ turns right), negated
#   spine fold <- LumbarExtension: lumbar extension -> spine fold, a third each, negated
#   spine side <- LumbarBend: lumbar bending (+ right) -> spine side (+ left), a third each, negated
#   spine twist <- LumbarTurn: lumbar rotation (+ left) -> spine twist (+ right), a third each, negated
#   upper arms lowered 90 from the T-pose first, so the measured shoulder angles apply about arms-down
#   thigh_X fold <- HipX: hip flexion -> thigh fold (+ forward)
#   thigh_X side <- HipAddX: hip adduction -> thigh side, negated (rig + side is outward)
#   thigh_X twist <- HipTurnX: hip internal rotation -> thigh twist (right + toes in, left - toes in)
#   calf_X fold <- KneeX: knee flexion -> calf fold
#   foot_X fold <- AnkleX: ankle dorsiflexion -> foot fold (pointing the toes is negative)
#   upperarm_X fold <- ShoulderX: shoulder flexion -> upper arm fold, about the lowered arm
#   upperarm_X side <- ShoulderAddX: shoulder adduction -> upper arm side (+ toward the body)
#   upperarm_X twist <- ShoulderTurnX: shoulder internal rotation -> upper arm twist (right + internal, left - internal)
#   lowerarm_X fold <- ElbowX: elbow flexion -> forearm fold
#   the rig's left thigh and upper-arm twist do NOT mirror the right: + turns the left limb out (probed)
#   Root X <- PelvisRise: the height in flight (in stance the planted legs set it)
# Authoring changes to the measured data, stated: each curve's end-to-start gap spread linearly so it loops (gap:
#   Run396PelvisTilt +0.55, Run396PelvisList -3.08, Run396PelvisTurn +2.45, Run396LumbarExtension +0.94, Run396LumbarBend +3.50, Run396LumbarTurn +1.23, Run396HipR -1.00, Run396HipL +1.83, Run396HipAddR +1.46, Run396HipAddL -4.79, Run396HipTurnR -1.45, Run396HipTurnL -1.95, Run396KneeR -0.47, Run396KneeL +4.41, Run396AnkleR +0.73, Run396AnkleL +4.57, Run396ShoulderR -4.65, Run396ShoulderL -1.85, Run396ShoulderAddR +1.53, Run396ShoulderAddL -0.90, Run396ShoulderTurnR -7.42, Run396ShoulderTurnL -5.23, Run396ElbowR +3.63, Run396ElbowL +6.50, Run396PelvisRise +0.35)
#   step width: each thigh 4 deg further out, so the swinging toes clear the standing calf of this rig.
#   arm carriage: each upper arm 6 deg further out, so the swinging forearm clears the thigh of this rig.
#   RunFK is the same curves with no plants: the measured motion as drawn, for comparing what the solver changed.
