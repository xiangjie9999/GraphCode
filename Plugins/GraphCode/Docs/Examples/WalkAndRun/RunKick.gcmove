Pace = profile(0.0000 = 1.059, 0.4367 = 1.059, 0.5563 = 1.059, 0.6311 = 0.792, 0.8506 = 0.000, 0.9989 = 0.000)
Floor = ground(z=0)
RunKick = clip(frames=385) {
  shift(Root, axis=X, by=$Rise)
  swing(thigh_r, axis=fold, by=$ThighRFold)
  swing(calf_r, axis=fold, by=$CalfRFold)
  swing(foot_r, axis=fold, by=$FootRFold)
  swing(thigh_r, axis=side, by=$ThighRSide)
  swing(thigh_r, axis=twist, by=$ThighRTwist)
  swing(thigh_l, axis=fold, by=$ThighLFold)
  swing(calf_l, axis=fold, by=$CalfLFold)
  swing(foot_l, axis=fold, by=$FootLFold)
  swing(thigh_l, axis=side, by=$ThighLSide)
  swing(thigh_l, axis=twist, by=$ThighLTwist)
  swing(pelvis, axis=Z, by=$PelvisZ)
  swing(pelvis, axis=Y, by=$PelvisY)
  swing(pelvis, axis=X, by=$PelvisX)
  swing(spine_01, axis=fold, by=$TrunkFold)
  swing(spine_02, axis=fold, by=$TrunkFold)
  swing(spine_03, axis=fold, by=$TrunkFold)
  swing(spine_01, axis=side, by=$TrunkSide)
  swing(spine_02, axis=side, by=$TrunkSide)
  swing(spine_03, axis=side, by=$TrunkSide)
  swing(spine_01, axis=twist, by=$TrunkTwist)
  swing(spine_02, axis=twist, by=$TrunkTwist)
  swing(spine_03, axis=twist, by=$TrunkTwist)
  swing(upperarm_r, axis=side, by=90)
  swing(upperarm_l, axis=side, by=90)
  swing(upperarm_r, axis=fold, by=$UpperArmRFold)
  swing(upperarm_r, axis=side, by=$UpperArmRSide)
  swing(upperarm_r, axis=twist, by=$UpperArmRTwist)
  swing(lowerarm_r, axis=fold, by=$LowerArmRFold)
  swing(upperarm_l, axis=fold, by=$UpperArmLFold)
  swing(upperarm_l, axis=side, by=$UpperArmLSide)
  swing(upperarm_l, axis=twist, by=$UpperArmLTwist)
  swing(lowerarm_l, axis=fold, by=$LowerArmLFold)
  swing(thigh_r, axis=side, by=4)
  swing(thigh_l, axis=side, by=4)
  swing(upperarm_r, axis=side, by=-6)
  swing(upperarm_l, axis=side, by=-6)
  travel(Root, velocity=$Pace)
  plant(leg_R, on=$Floor, roll=(Heel_R, Ball_R, Toe_R), weight=$OnR)
  plant(leg_L, on=$Floor, roll=(Heel_L, Ball_L, Toe_L), weight=$OnL)
}
