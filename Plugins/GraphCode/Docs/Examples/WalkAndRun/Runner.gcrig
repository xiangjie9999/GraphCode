  ring_mcp_r = region($ring_01_palm_r, long=1.4, wide=45%) [along=($hand_r, $ring_02_r)]
  ring_pip_r = region($ring_02_palm_r, long=1.1, wide=45%) [along=($ring_01_r, $ring_03_r)]
  ring_dip_r = region($ring_03_palm_r, long=0.9, wide=45%) [along=($ring_02_r, $ring_tip_r)]
  pinky_mcp_r = region($pinky_01_palm_r, long=1.4, wide=45%) [along=($hand_r, $pinky_02_r)]
  pinky_pip_r = region($pinky_02_palm_r, long=1.1, wide=45%) [along=($pinky_01_r, $pinky_03_r)]
  pinky_dip_r = region($pinky_03_palm_r, long=0.9, wide=45%) [along=($pinky_02_r, $pinky_tip_r)]
  thumb_cmc_r = region($thumb_01_in_r, long=1.4, wide=45%) [along=($hand_r, $thumb_02_r)]
