  thumb_ip_r = region($thumb_03_in_r, long=1.0, wide=45%) [along=($thumb_02_r, $thumb_tip_r)]
  hip_band_r = region($hip_front_r, long=10, wide=45%) [along=($pelvis, $calf_r)]
  knee_band_r = region($knee_back_r, long=8, wide=45%) [along=($thigh_r, $foot_r)]
  ankle_band_r = region($ankle_front_r, long=4, wide=45%) [along=($calf_r, $ball_r)]
  toes_r = region($toe_top_r, long=2, wide=45%) [along=($foot_r, $toe_r)]
  # The web between thumb and forefinger, where a gun's backstrap is pressed (as VRHand.gcrig): from the thumb's base out
  # through the web's edge. Soft below.
  web_fold_r = region($web_r, long=8, wide=3) [along=($thumb_01_r, $web_r)]
  # Where each forearm's roll goes (2026-10-04, user: "I remember we solved candy wrapper skinning issue isn't it"):
  # down the forearm, 28 of its 31 cm. Taken in the 5 cm elbow fold band it was in before, a 150 degree palm-up turn
  # wrung the arm into a neck at the elbow (ForearmTwist150.gcmove).
  forearm_l = region($forearm_mid_l, long=28) [along=($lowerarm_l, $hand_l)]
  forearm_r = region($forearm_mid_r, long=28) [along=($lowerarm_r, $hand_r)]
}

# The web is about 2 cm of muscle (the first intermetacarpal space) and a backstrap is pressed deep into it; it gives
# half that at its edge, faded to the hand's 0.35 at its border (GC-MOVE-GRIP-SEATING.md, 2026-10-04).
skin {
  web_fold_r [gives=1.0]
}
joints {
  Root
  pelvis
  spine_01 [turns_in=$waist, closes=forward, range=(-15, 30), side=(-15, 15), twists=(-15, 15)]
  spine_02 [turns_in=$mid_back, closes=forward, range=(-15, 25), side=(-15, 15), twists=(-15, 15)]
  spine_03 [turns_in=$thorax, closes=forward, range=(-15, 20), side=(-15, 15), twists=(-15, 15)]
  neck_01 [turns_in=$neck_base, closes=forward, range=(-25, 35), side=(-25, 25)]
  head [turns_in=$head_base, closes=forward, range=(-20, 25), side=(-20, 20)]
  head_tip
  clavicle_l [turns_in=$collar_band_l, closes=forward, range=(145, 178), side=(-10, 10)]
  # A shoulder lets the arm hang (side 90, 2026-10-05, Docs/GC-MOVE-ARM-LADDER.md rung 1): at 75 an arm by the side
  # stood 10 cm out from it.
  upperarm_l [turns_in=$shoulder_band_l, closes=forward, range=(-60, 150), side=(-90, 90), twists=(-60, 60)]
  # A forearm's NEUTRAL turn is the T-pose's palm-down: arm out to the side, thumb forward; lowered without turning,
  # that palm faces the thigh. A person turns about 85 degrees each way from there, so +-95 (rung 1b, 2026-10-05).
  # It was (-10, 160), on the belief that palm-down was the end of the turn, and every palm-down hold in front then
  # pushed the elbow out. Twist turns about the bone's length toward the hand.
  lowerarm_l [turns_in=$elbow_band_l, closes=forward, range=(-5, 145), twists=(-95, 95), twists_in=$forearm_l]
  hand_l [turns_in=$wrist_band_l, closes=down, range=(-70, 80), side=(-30, 30)]
  index_01_l [turns_in=$index_mcp_l, closes=down, range=(-20, 90), side=(-15, 15)]
  index_02_l [turns_in=$index_pip_l, closes=down, range=(-5, 110)]
  index_03_l [turns_in=$index_dip_l, closes=down, range=(-5, 80)]
  index_tip_l
  middle_01_l [turns_in=$middle_mcp_l, closes=down, range=(-20, 90), side=(-15, 15)]
  middle_02_l [turns_in=$middle_pip_l, closes=down, range=(-5, 110)]
  middle_03_l [turns_in=$middle_dip_l, closes=down, range=(-5, 80)]
  middle_tip_l
  ring_01_l [turns_in=$ring_mcp_l, closes=down, range=(-20, 90), side=(-15, 15)]
  ring_02_l [turns_in=$ring_pip_l, closes=down, range=(-5, 110)]
  ring_03_l [turns_in=$ring_dip_l, closes=down, range=(-5, 80)]
  ring_tip_l
  pinky_01_l [turns_in=$pinky_mcp_l, closes=down, range=(-20, 90), side=(-15, 15)]
  pinky_02_l [turns_in=$pinky_pip_l, closes=down, range=(-5, 110)]
  pinky_03_l [turns_in=$pinky_dip_l, closes=down, range=(-5, 80)]
  pinky_tip_l
  # The thumb's base turns three ways (2026-10-05, Docs/GC-MOVE-ARM-LADDER.md "The thumbs"; VRHand.gcrig's three
  # hinges): out in front of the palm (fold, closes=down: the T-pose palm faces down), across in the palm's plane
  # (side, + toward the forefinger) and rolled so the pad faces the fingers (twist, - on the left, + on the right).
  # With one hinge it could not come round a grip and its curl folded it onto itself.
  thumb_01_l [turns_in=$thumb_cmc_l, closes=down, range=(-40, 60), side=(-30, 30), twists=(-45, 10)]
  thumb_02_l [turns_in=$thumb_mcp_l, range=(-10, 60)]
  thumb_03_l [turns_in=$thumb_ip_l, range=(-10, 80)]
  thumb_tip_l
  thigh_l [turns_in=$hip_band_l, closes=forward, range=(-30, 120), side=(-35, 35), twists=(-40, 40)]
  calf_l [turns_in=$knee_band_l, closes=back, range=(-5, 150)]
  foot_l [turns_in=$ankle_band_l, closes=forward, range=(-50, 85), side=(-20, 20)]
  ball_l [turns_in=$toes_l, closes=up, range=(-15, 90)]
  toe_l
  clavicle_r [turns_in=$collar_band_r, closes=forward, range=(145, 178), side=(-10, 10)]
  upperarm_r [turns_in=$shoulder_band_r, closes=forward, range=(-60, 150), side=(-90, 90), twists=(-60, 60)]
  lowerarm_r [turns_in=$elbow_band_r, closes=forward, range=(-5, 145), twists=(-95, 95), twists_in=$forearm_r]
  hand_r [turns_in=$wrist_band_r, closes=down, range=(-70, 80), side=(-30, 30)]
  index_01_r [turns_in=$index_mcp_r, closes=down, range=(-20, 90), side=(-15, 15)]
  index_02_r [turns_in=$index_pip_r, closes=down, range=(-5, 110)]
  index_03_r [turns_in=$index_dip_r, closes=down, range=(-5, 80)]
  index_tip_r
  middle_01_r [turns_in=$middle_mcp_r, closes=down, range=(-20, 90), side=(-15, 15)]
  middle_02_r [turns_in=$middle_pip_r, closes=down, range=(-5, 110)]
  middle_03_r [turns_in=$middle_dip_r, closes=down, range=(-5, 80)]
  middle_tip_r
  ring_01_r [turns_in=$ring_mcp_r, closes=down, range=(-20, 90), side=(-15, 15)]
  ring_02_r [turns_in=$ring_pip_r, closes=down, range=(-5, 110)]
  ring_03_r [turns_in=$ring_dip_r, closes=down, range=(-5, 80)]
  ring_tip_r
  pinky_01_r [turns_in=$pinky_mcp_r, closes=down, range=(-20, 90), side=(-15, 15)]
  pinky_02_r [turns_in=$pinky_pip_r, closes=down, range=(-5, 110)]
  pinky_03_r [turns_in=$pinky_dip_r, closes=down, range=(-5, 80)]
  pinky_tip_r
  thumb_01_r [turns_in=$thumb_cmc_r, closes=down, range=(-40, 60), side=(-30, 30), twists=(-10, 45)]
  thumb_02_r [turns_in=$thumb_mcp_r, range=(-10, 60)]
  thumb_03_r [turns_in=$thumb_ip_r, range=(-10, 80)]
  thumb_tip_r
  thigh_r [turns_in=$hip_band_r, closes=forward, range=(-30, 120), side=(-35, 35), twists=(-40, 40)]
  calf_r [turns_in=$knee_band_r, closes=back, range=(-5, 150)]
  foot_r [turns_in=$ankle_band_r, closes=forward, range=(-50, 85), side=(-20, 20)]
  ball_r [turns_in=$toes_r, closes=up, range=(-15, 90)]
  toe_r
}
contacts {
  Palm_L = contact(chain=arm_L, at=$palm_l)
  Palm_R = contact(chain=arm_R, at=$palm_r)
  IndexPad_L = contact(chain=index_L, at=$index_pad_l)
  MiddlePad_L = contact(chain=middle_L, at=$middle_pad_l)
  RingPad_L = contact(chain=ring_L, at=$ring_pad_l)
  LittlePad_L = contact(chain=little_L, at=$little_pad_l)
  IndexPad_R = contact(chain=index_R, at=$index_pad_r)
  MiddlePad_R = contact(chain=middle_R, at=$middle_pad_r)
  RingPad_R = contact(chain=ring_R, at=$ring_pad_r)
  LittlePad_R = contact(chain=little_R, at=$little_pad_r)
  Sole_L = contact(chain=leg_L, at=$sole_l)
  Sole_R = contact(chain=leg_R, at=$sole_r)
  Heel_L = contact(chain=leg_L, at=$sole_l, bone=foot_l)
  Ball_L = contact(chain=leg_L, at=$ball_sole_l, bone=ball_l)
  Toe_L = contact(chain=leg_L, at=$toe_sole_l, bone=toe_l)
  Heel_R = contact(chain=leg_R, at=$sole_r, bone=foot_r)
  Ball_R = contact(chain=leg_R, at=$ball_sole_r, bone=ball_r)
  Toe_R = contact(chain=leg_R, at=$toe_sole_r, bone=toe_r)
}
# Where a held gun hangs (GC-MOVE-GRIP-SEATING.md, web meets web): at the web, in a GUN's frame, +X out of the palm,
# +Y along the hand toward the fingers (the bore), +Z the thumb side (the gun's top). hand_r is built aiming at its
# fingers with +Z the back of the hand (the rig's rule: +X toward the children, +Z nearest up), so out of the palm is
# its -Z and the thumb side its -Y. The gun is built untilted in its own frame (user, 2026-10-04: "Drop the tilt"), so
# its grip's own 22 degree rake lays the grip from the palm's heel to the web, the slant a fist holds a handle at. Was
# up=($heel_r, $web_r) with the rifle turned -22 in Rifle2H.gcshape to stand its grip along that slant: the same hold
# within 2 degrees, but the angle typed into the gun.
sockets {
  # On a bone of its own, grip_r, with no skin (user, 2026-10-04: "can't we refer to pistol example for proper hand
  # placement"): the rifle hangs on it, so RifleReady seats the rifle web to web by moving grip_r, as the pistol's clip
  # moves Epic's palm_r, and the hand stays on its wrist.
  web_grip_r = hand_r [at=$web_r, toward=-Z, up=-Y, bone=grip_r]
  # Where the support hand takes the handguard (user, 2026-10-04: "Why the other hand not connected? Should have
  # another socket isn't it?"): the palm's centre, +X out of the palm, +Z along the palm from its heel to the web, the
  # line a handle lies across a hand on. A .gcmove puts this frame on the rifle's PalmL by reach(from=), socket to
  # socket, where a palm POINT and a facing typed in the hand bone's axes left the arm 99 degrees off and its elbow
  # over the top of the rifle.
  palm_grip_l = hand_l [at=$palm_l, toward=-Z, up=($heel_l, $web_l)]
  # Rides the chest, so a stock held in it goes where the chest goes as the body walks.
  shoulder_pocket_r = spine_03 [at=$shoulder_pocket_r]
}
grips {
  # two palms on one long thing: the rifle at low ready
  carry = grip(contacts=($Palm_R, $Palm_L), required=($Palm_R, $Palm_L))
  fingers_R = grip(contacts=($MiddlePad_R, $RingPad_R, $LittlePad_R))
  fingers_L = grip(contacts=($IndexPad_L, $MiddlePad_L, $RingPad_L, $LittlePad_L))
}
