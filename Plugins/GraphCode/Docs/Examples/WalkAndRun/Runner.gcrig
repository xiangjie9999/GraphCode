  # (2026-10-04, web meets web as VRHand.gcrig). Measured with gc_render ask on SM_RifleManBody from below:
  # the palm's thumb-side edge turns into the thumb at X -83.3, Y 2.8, and the palm's skin there is at Z 151.4.
  web_r = (-83.300, 2.800, 151.400)
  # The heel of the palm on the little finger's side, where a held handle's lower end presses (2026-10-04). Measured
  # the same way: the palm's skin at its corner by the wrist, facing down. A handle lies across the palm from here to
  # the web, about 24 degrees off square to the hand toward the fingers, which is the slant a fist holds it at.
  heel_r = (-79.900, -4.700, 151.400)
  # The same two on the left hand, mirrored across X: the mesh is symmetric (every joint pair in this file mirrors
  # exactly). They give the support palm's socket its handle line (2026-10-04).
  web_l = (83.300, 2.800, 151.400)
  heel_l = (79.900, -4.700, 151.400)
  # The right shoulder pocket, where a rifle's stock sits (2026-10-04): the hollow between the chest's front and the
  # shoulder's, on the skin. Measured with gc_render ask on SM_RifleManBody from the front: the chest beside it at
  # (-15.2, 8.8, 149.3) facing forward and out, the shoulder's front at (-20.0, 6.0, 152.9).
  shoulder_pocket_r = (-16.500, 8.200, 150.000)
  # The middle of each forearm, on its own line half way from the elbow to the wrist: where the band its roll goes
  # down is centred, as TwistArm.gcrig's forearm band is (2026-10-04).
  forearm_mid_l = (60.618, -1.807, 153.699)
  forearm_mid_r = (-60.618, -1.807, 153.699)
}
chains {
  body = Root -> pelvis -> spine_01 -> spine_02 -> spine_03 -> neck_01 -> head -> head_tip
  collar_L = spine_03 -> clavicle_l -> upperarm_l
  arm_L = upperarm_l -> lowerarm_l -> hand_l
  # Each finger twice (2026-10-05): from the wrist, which gives the bones their parents, and from its own knuckle,
  # which is the chain its contact moves, so a reach bends the finger and not the hand (VRHand.gcrig's index_r). It ends
  # at the last finger bone: the tip is a skinless, unlimited leaf, and a chain ending there turned it, not the finger.
  index_L_hand = hand_l -> index_01_l -> index_02_l -> index_03_l -> index_tip_l
  index_L = index_01_l -> index_02_l -> index_03_l
  middle_L_hand = hand_l -> middle_01_l -> middle_02_l -> middle_03_l -> middle_tip_l
  middle_L = middle_01_l -> middle_02_l -> middle_03_l
  ring_L_hand = hand_l -> ring_01_l -> ring_02_l -> ring_03_l -> ring_tip_l
  ring_L = ring_01_l -> ring_02_l -> ring_03_l
  little_L_hand = hand_l -> pinky_01_l -> pinky_02_l -> pinky_03_l -> pinky_tip_l
  little_L = pinky_01_l -> pinky_02_l -> pinky_03_l
  thumb_L_hand = hand_l -> thumb_01_l -> thumb_02_l -> thumb_03_l -> thumb_tip_l
  thumb_L = thumb_01_l -> thumb_02_l -> thumb_03_l
  leg_L = pelvis -> thigh_l -> calf_l -> foot_l -> ball_l -> toe_l
  collar_R = spine_03 -> clavicle_r -> upperarm_r
  arm_R = upperarm_r -> lowerarm_r -> hand_r
  index_R_hand = hand_r -> index_01_r -> index_02_r -> index_03_r -> index_tip_r
  index_R = index_01_r -> index_02_r -> index_03_r
  middle_R_hand = hand_r -> middle_01_r -> middle_02_r -> middle_03_r -> middle_tip_r
  middle_R = middle_01_r -> middle_02_r -> middle_03_r
  ring_R_hand = hand_r -> ring_01_r -> ring_02_r -> ring_03_r -> ring_tip_r
  ring_R = ring_01_r -> ring_02_r -> ring_03_r
  little_R_hand = hand_r -> pinky_01_r -> pinky_02_r -> pinky_03_r -> pinky_tip_r
  little_R = pinky_01_r -> pinky_02_r -> pinky_03_r
  thumb_R_hand = hand_r -> thumb_01_r -> thumb_02_r -> thumb_03_r -> thumb_tip_r
  thumb_R = thumb_01_r -> thumb_02_r -> thumb_03_r
  leg_R = pelvis -> thigh_r -> calf_r -> foot_r -> ball_r -> toe_r
}
