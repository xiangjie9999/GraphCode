  elbow_band_r = region($elbow_front_r, long=5, wide=45%) [along=($upperarm_r, $hand_r)]
  wrist_band_r = region($wrist_palm_r, long=3, wide=45%) [along=($lowerarm_r, $middle_01_r)]
  index_mcp_r = region($index_01_palm_r, long=1.4, wide=45%) [along=($hand_r, $index_02_r)]
