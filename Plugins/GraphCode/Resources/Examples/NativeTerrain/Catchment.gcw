gcw 1

world {
  head = (25000, 42000)
  bend_upper = (27800, 33000)
  bend_lower = (23000, 24000)
  toe = (25000, 11000)
  drainage = course head -> bend_upper -> bend_lower -> toe
}

terrains {
  Catchment = terrain(base=flat(z=100), stream=tiles(components=2)) {
    BackRidge = ridge(along=((7000,42000) -> (26000,45000) -> (45000,39500)), width=29000, height=(0=1900,0.5=5000,1=2300), falloff=14500)
    WestRib = ridge(along=((12000,40000) -> (16500,28000) -> (12500,15000)), width=13500, height=(0=1800,0.5=1200,1=100), falloff=6750)
    EastRib = ridge(along=((37500,40500) -> (35000,29000) -> (31000,16000)), width=15000, height=(0=2100,0.5=1500,1=120), falloff=7500)
    CatchmentFloor = carve(along=$world.drainage, width=6500, depth=(0=330,0.5=200,1=25), falloff=3250)
    SoftenConstruction = smooth(iterations=512, strength=1)
    SoilVariation = perlin(seed=92401, frequency=0.0007, amplitude=85, octaves=3)
  }
}
