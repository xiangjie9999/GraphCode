gcw 1

terrains {
  Mountain = terrain(base=flat(z=4000)) {
    Summit = stamp(source=file'AsymmetricHeightStamp_Gray16.png', at=(25000,25000), width=43000, length=41000, rotation=-12, range=(Min=-22000,Max=22000), falloff=5000, smoothness=180, blend=add)
    Shoulder = stamp(source=file'AsymmetricHeightStamp_Gray16.png', at=(33000,32500), width=26000, length=30000, rotation=115, range=(Min=-10000,Max=10000), falloff=4000, smoothness=120, strength=0.8, blend=add)
    Surface = perlin(seed=4202, frequency=0.0008, amplitude=110, octaves=4)
    Weathering = erode(seed=4203, iterations=18000, strength=0.18, talus=35, deposition=0.3, evaporation=0.05)
  }
}
