  n7 = TextureSampleParameter2D(in0=n4.out0) [ParameterName=WeaveNormal, SamplerType=SAMPLERTYPE_Normal, Texture=obj'/Engine/EngineMaterials/FlatNormal.FlatNormal', link0.name="Coordinates"]
  n8 = ScalarParameter() [DefaultValue=0.8, ParameterName=FabricRoughness]
  n9 = MaterialFunctionCall /Game/GraphCode/Garment/MF_GcStitches.MF_GcStitches(BaseColor=n6.out0, Normal=n7.out0, Roughness=n8.out0)
  result = MaterialResult(BaseColor=n9.out0, Roughness=n9.out2, Normal=n9.out1, AmbientOcclusion=n9.out3)
