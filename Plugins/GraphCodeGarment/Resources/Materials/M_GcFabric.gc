  n1 = TextureCoordinate()
  n2 = ScalarParameter() [DefaultValue=5.0, ParameterName=WeaveCm]
  n3 = Divide(in1=n2.out0) [ConstA=100.0, link1.name="B"]
  n4 = Multiply(in0=n1.out0, in1=n3.out0) [link0.name="A", link1.name="B"]
