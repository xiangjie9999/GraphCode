  n43 = VectorParameter() [DefaultValue=(R=1.0,G=0.94,B=0.97,A=1.0), ParameterName=SheenTint]
  n44 = ScalarParameter() [DefaultValue=0.0, ParameterName=SheenStreak]
  n45 = ScalarParameter() [DefaultValue=0.0, ParameterName=Sheen2Strength]
  n46 = ScalarParameter() [DefaultValue=-0.2, ParameterName=Sheen2Shift]
