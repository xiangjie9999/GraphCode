# (helper of FootAt, right, not listed) the four bones in the figure's frame; the toes' aim also rolls the foot flat (the toe
# joint is a hinge).
FootAtAimR = pose(tx=0.0, ty=0.0, tz=-1.0, sx=0.0, sy=0.0, sz=-1.0, fx=0.0, fy=0.88, fz=-0.47, bx=0.0, by=0.97, bz=0.24) {
  aim(thigh_r, from=$ThighR, toward=(down, forward=atan2($ty, -$tz), right=asin(clamp(-$tx, -1, 1))))
  aim(calf_r, from=$ShinR, toward=(down, forward=atan2($sy, -$sz), right=asin(clamp(-$sx, -1, 1))))
  aim(foot_r, from=$FootR, toward=(down, forward=atan2($fy, -$fz), right=asin(clamp(-$fx, -1, 1))))
  aim(ball_r, from=$ToesR, toward=(down, forward=atan2($by, -$bz), right=asin(clamp(-$bx, -1, 1))))
}

# (helper of FootAt, left, not listed) the four bones in the figure's frame; the toes' aim also rolls the foot flat (the toe
# joint is a hinge).
FootAtAimL = pose(tx=0.0, ty=0.0, tz=-1.0, sx=0.0, sy=0.0, sz=-1.0, fx=0.0, fy=0.88, fz=-0.47, bx=0.0, by=0.97, bz=0.24) {
  aim(thigh_l, from=$ThighL, toward=(down, forward=atan2($ty, -$tz), right=asin(clamp(-$tx, -1, 1))))
  aim(calf_l, from=$ShinL, toward=(down, forward=atan2($sy, -$sz), right=asin(clamp(-$sx, -1, 1))))
  aim(foot_l, from=$FootL, toward=(down, forward=atan2($fy, -$fz), right=asin(clamp(-$fx, -1, 1))))
  aim(ball_l, from=$ToesL, toward=(down, forward=atan2($by, -$bz), right=asin(clamp(-$bx, -1, 1))))
}

# STANCE (second layer, not sided): the first line of a standing pose. Works out where the pelvis stands over the feet and passes
# it to Hips and to each FootAt; no plant, no balance. Called with nothing written it stands both feet at rest (the pose is
# rest, the legs held by their aims, so a Back hinge no longer swings them).
#  forward_r/_l, out_r/_l, turnout_r/_l, knee_out_r/_l, heel_r/_l   each foot, as FootAt's (rest: rig_rest_forward/out, 0).
#  drop      of leg length: the hips lowered. Not written, follows knees: 1 - cos(knees / 2).
#  knees     degrees, the knees' bend: the same fact as drop in degrees (10 is drop 0.004). Rest 0.
#  weight_side  -1 over the left foot's centre .. 1 over the right's: the pelvis between where the feet ACTUALLY stand. Rest 0.
#  weight_fore  -1 .. 1 toward the rear foot's centre / the front's, or the heels / balls when the feet are side by side. Rest 0.
#  hike, turn   as Hips' (the right hip up; turned to the right). Rest 0.
#  lean      degrees: the trunk's lean (write Back's lean here too): the hips go back by rig_lean_share (0.28) * leg * sin(lean),
#            which keeps a 45 degree lean standing (the centre of mass 1.5 cm inside the feet, 16.1 cm ahead without). Rest 0.
#  rig_gain_side, rig_gain_fore   the centre of mass's travel per cm of the pelvis (0.84, 0.82, read); rig_heel_ball 9.55 cm;
#  rig_centre_along / _out / rig_heading   the foot's centre from the ankle (4.6 along the foot's heading, 0.9 out; 10.06).
#  Measured: ankles within 0.12 cm of asked, soles within 0.05 cm of the floor in flat stances; worst the lunge's rear ball
#              0.50 cm into the floor (its heel lifted by itself). A share past where a leg reaches leaves that foot floating (not said).
#  Worked values (built): a crouch $Stance(out_r=0.8, out_l=0.8, turnout_r=25, turnout_l=25, drop=0.3) -> ankles 15.89 out,
#              turned 25.05, knees 87, soles -0.04; a fighter's stance $Stance(forward_l=0.25, out_l=0.3, turnout_l=-5,
#              forward_r=-0.25, out_r=0.5, turnout_r=40, drop=0.08) -> 21.55 / 5.95 / -5.00 and -21.53 / 10.00 / 40.03; on tiptoe
#              $Stance(heel_r=40, heel_l=40) -> heels 12.5 cm up, balls 0.00, hips 7.05 up.
#  rig_base_px, rig_base_py, rig_base_pz (cm), rig_base_turn, rig_base_hike (deg)   the key's BASE pose's pelvis off its rest (a key on a
#            source= frame): passed to each FootAt beside what Stance passes it, so the legs are worked out from the pelvis as it stands (Hips adds
#            to the base's pelvis). 0 on the reference pose. Convert to presets writes them (CODER-NOTES-17).
#  forward_r/_l -1..1 (a leg length each way; the accepted slash's back foot -0.65) and out_r/_l -0.5..1.5 (-0.5: the ankle under the body's
#            centre line, feet on one line), knee_out_r/_l -35..25 (-35: the hip's internal rotation, HUMAN-JOINT-RANGES.md; the slash's back
#            knee reads -25) since 19 Nov (CODER-NOTES-17); the old -0.35..0.5, 0 and -10 were the records' poses (-10 where a narrow stance's
#            thighs meet, a collision the build reports), not stops.
Stance = pose(forward_r=$rig_rest_forward, forward_r_min=-1, forward_r_max=1, forward_l=$rig_rest_forward, forward_l_min=-1, forward_l_max=1, out_r=$rig_rest_out, out_r_min=-0.5, out_r_max=1.5, out_l=$rig_rest_out, out_l_min=-0.5, out_l_max=1.5, turnout_r=0.0, turnout_r_min=-35, turnout_r_max=60, turnout_l=0.0, turnout_l_min=-35, turnout_l_max=60, knee_out_r=0.0, knee_out_r_min=-35, knee_out_r_max=25, knee_out_l=0.0, knee_out_l_min=-35, knee_out_l_max=25, heel_r=0.0, heel_r_min=-25, heel_r_max=53.5, heel_l=0.0, heel_l_min=-25, heel_l_max=53.5, knees=0.0, knees_min=0, knees_max=120, drop=1 - cos($knees / 2), drop_min=-0.08, drop_max=0.5, weight_side=0.0, weight_side_min=-1, weight_side_max=1, weight_fore=0.0, weight_fore_min=-1, weight_fore_max=1, hike=0.0, hike_min=-30, hike_max=30, turn=0.0, turn_min=-60, turn_max=60, lean=0.0, lean_min=-58.2, lean_max=180, rig_leg=86.2, rig_hip_width=20.04, rig_hip_x=10.022, rig_hip_y=2.796, rig_rest_forward=-0.0293, rig_rest_out=0.1954, rig_heading=10.06, rig_centre_along=4.6, rig_centre_out=0.9, rig_gain_side=0.84, rig_gain_fore=0.82, rig_heel_ball=9.55, rig_lean_share=0.28, rig_hl_r=14.414, rig_vd_r=7.748, rig_hl_l=14.348, rig_vd_l=7.606, rig_base_px=0.0, rig_base_py=0.0, rig_base_pz=0.0, rig_base_turn=0.0, rig_base_hike=0.0) {
  $Hips(drop=$drop - max(min((sqrt($rig_hl_r * $rig_hl_r + $rig_vd_r * $rig_vd_r) * sin(atan2($rig_vd_r, $rig_hl_r) + max($heel_r, 0)) - $rig_vd_r - pow($rig_hl_r - sqrt($rig_hl_r * $rig_hl_r + $rig_vd_r * $rig_vd_r) * cos(atan2($rig_vd_r, $rig_hl_r) + max($heel_r, 0)), 2) / (2 * $rig_leg)), (sqrt($rig_hl_l * $rig_hl_l + $rig_vd_l * $rig_vd_l) * sin(atan2($rig_vd_l, $rig_hl_l) + max($heel_l, 0)) - $rig_vd_l - pow($rig_hl_l - sqrt($rig_hl_l * $rig_hl_l + $rig_vd_l * $rig_vd_l) * cos(atan2($rig_vd_l, $rig_hl_l) + max($heel_l, 0)), 2) / (2 * $rig_leg))), 0) / $rig_leg, shift_right=-((((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2) + $weight_side * ((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) - (((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2)) / $rig_gain_side), shift_forward=(((($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) + ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2) - ($rig_hip_y + $rig_rest_forward * $rig_leg + $rig_centre_along * cos($rig_heading)) + $weight_fore * max(abs(($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) - ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2, $rig_heel_ball) / $rig_gain_fore - $rig_lean_share * $rig_leg * sin($lean)), hike=$hike, turn=$turn, rig_leg=$rig_leg)
  $FootAt(left=false, forward=$forward_r, out=$out_r, turnout=$turnout_r, knee_out=$knee_out_r, heel=$heel_r, px=(((((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2) + $weight_side * ((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) - (((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2)) / $rig_gain_side)) * cos($rig_base_turn) - ((((($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) + ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2) - ($rig_hip_y + $rig_rest_forward * $rig_leg + $rig_centre_along * cos($rig_heading)) + $weight_fore * max(abs(($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) - ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2, $rig_heel_ball) / $rig_gain_fore - $rig_lean_share * $rig_leg * sin($lean))) * sin($rig_base_turn) + $rig_base_px, py=(((((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2) + $weight_side * ((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) - (((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2)) / $rig_gain_side)) * sin($rig_base_turn) + ((((($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) + ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2) - ($rig_hip_y + $rig_rest_forward * $rig_leg + $rig_centre_along * cos($rig_heading)) + $weight_fore * max(abs(($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) - ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2, $rig_heel_ball) / $rig_gain_fore - $rig_lean_share * $rig_leg * sin($lean))) * cos($rig_base_turn) + $rig_base_py, pz=max(min((sqrt($rig_hl_r * $rig_hl_r + $rig_vd_r * $rig_vd_r) * sin(atan2($rig_vd_r, $rig_hl_r) + max($heel_r, 0)) - $rig_vd_r - pow($rig_hl_r - sqrt($rig_hl_r * $rig_hl_r + $rig_vd_r * $rig_vd_r) * cos(atan2($rig_vd_r, $rig_hl_r) + max($heel_r, 0)), 2) / (2 * $rig_leg)), (sqrt($rig_hl_l * $rig_hl_l + $rig_vd_l * $rig_vd_l) * sin(atan2($rig_vd_l, $rig_hl_l) + max($heel_l, 0)) - $rig_vd_l - pow($rig_hl_l - sqrt($rig_hl_l * $rig_hl_l + $rig_vd_l * $rig_vd_l) * cos(atan2($rig_vd_l, $rig_hl_l) + max($heel_l, 0)), 2) / (2 * $rig_leg))), 0) - $drop * $rig_leg + $rig_base_pz, hike=$hike + $rig_base_hike, turn=$turn + $rig_base_turn, rig_leg=$rig_leg, rig_hip_width=$rig_hip_width, rig_hip_x=$rig_hip_x, rig_hip_y=$rig_hip_y, rig_rest_forward=$rig_rest_forward, rig_rest_out=$rig_rest_out)
  $FootAt(right=false, forward=$forward_l, out=$out_l, turnout=$turnout_l, knee_out=$knee_out_l, heel=$heel_l, px=(((((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2) + $weight_side * ((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) - (((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2)) / $rig_gain_side)) * cos($rig_base_turn) - ((((($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) + ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2) - ($rig_hip_y + $rig_rest_forward * $rig_leg + $rig_centre_along * cos($rig_heading)) + $weight_fore * max(abs(($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) - ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2, $rig_heel_ball) / $rig_gain_fore - $rig_lean_share * $rig_leg * sin($lean))) * sin($rig_base_turn) + $rig_base_px, py=(((((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2) + $weight_side * ((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) - (((-1 * ($rig_hip_x + $out_r * $rig_hip_width + $rig_centre_out) + $rig_centre_along * -1 * sin($rig_heading + $turnout_r)) + (1 * ($rig_hip_x + $out_l * $rig_hip_width + $rig_centre_out) + $rig_centre_along * 1 * sin($rig_heading + $turnout_l))) / 2)) / $rig_gain_side)) * sin($rig_base_turn) + ((((($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) + ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2) - ($rig_hip_y + $rig_rest_forward * $rig_leg + $rig_centre_along * cos($rig_heading)) + $weight_fore * max(abs(($rig_hip_y + $forward_r * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_r)) - ($rig_hip_y + $forward_l * $rig_leg + $rig_centre_along * cos($rig_heading + $turnout_l))) / 2, $rig_heel_ball) / $rig_gain_fore - $rig_lean_share * $rig_leg * sin($lean))) * cos($rig_base_turn) + $rig_base_py, pz=max(min((sqrt($rig_hl_r * $rig_hl_r + $rig_vd_r * $rig_vd_r) * sin(atan2($rig_vd_r, $rig_hl_r) + max($heel_r, 0)) - $rig_vd_r - pow($rig_hl_r - sqrt($rig_hl_r * $rig_hl_r + $rig_vd_r * $rig_vd_r) * cos(atan2($rig_vd_r, $rig_hl_r) + max($heel_r, 0)), 2) / (2 * $rig_leg)), (sqrt($rig_hl_l * $rig_hl_l + $rig_vd_l * $rig_vd_l) * sin(atan2($rig_vd_l, $rig_hl_l) + max($heel_l, 0)) - $rig_vd_l - pow($rig_hl_l - sqrt($rig_hl_l * $rig_hl_l + $rig_vd_l * $rig_vd_l) * cos(atan2($rig_vd_l, $rig_hl_l) + max($heel_l, 0)), 2) / (2 * $rig_leg))), 0) - $drop * $rig_leg + $rig_base_pz, hike=$hike + $rig_base_hike, turn=$turn + $rig_base_turn, rig_leg=$rig_leg, rig_hip_width=$rig_hip_width, rig_hip_x=$rig_hip_x, rig_hip_y=$rig_hip_y, rig_rest_forward=$rig_rest_forward, rig_rest_out=$rig_rest_out)
}

# THIGH (first layer, sided): where the thigh (hip to knee) points, for a leg OFF the ground (an alternative per side to FootAt: one
# aim per bone). Directions as the arm's: raise 0 straight down, 90 level, 180 up; azimuth 0 ahead, 90 out to its own side, 180
# behind, below 0 across; in frame. Either one written asks the direction (raise alone: azimuth 0; azimuth alone: rig_rest_raise
# 2.9). Neither: not asked, the thigh (hip to knee) rides its parent.
#  turnout   degrees, the thigh turned about its own length, the toes out to its own side (below 0 in): the free leg's turnout
#            (rev 5 box A3). Not written: not asked. Range +-53.5 (the thigh's twist). The rig's twist turns the right toes IN
#            (+20 moved the right ball 4.8 cm inward), so the right line carries the flip.
#  Worked values (built, arms held out): a kick's chamber $Thigh(raise=90) $Shin(raise=0) -> thigh 90.00 / 0.00, shin 0.24;
#              a thigh out to the side $Thigh(raise=45, azimuth=90) -> 42.11 / 90.13 (the side stop 38.8: "2.9 short");
#              $Thigh(raise=30, turnout=30) -> 30.00 / 0.00, the foot turned out 23 in the floor plane. Behind the body the
#              thigh stops near 36 (its -35 extension): an arabesque line of 100 reads 67, said ("64.1 short").
Thigh = pose(raise=none, raise_min=0, raise_max=180, azimuth=0 * $raise, azimuth_min=-180, azimuth_max=180, turnout=none, turnout_min=-53.5, turnout_max=53.5, frame=character, left=true, right=true, rig_rest_raise=2.9) {
  if ($raise != none) {
    if ($azimuth != none) {
      $ThighDir(raise=$raise, azimuth=$azimuth, frame=$frame, left=$left, right=$right)
    } else {
      $ThighDir(raise=$raise, azimuth=0, frame=$frame, left=$left, right=$right)
    }
  } else {
    if ($azimuth != none) {
      $ThighDir(raise=$rig_rest_raise, azimuth=$azimuth, frame=$frame, left=$left, right=$right)
    }
  }
  if ($turnout != none) {
    if ($right) { swing(thigh_r, axis=twist, by=-$turnout) }
    if ($left) { swing(thigh_l, axis=twist, by=$turnout) }
  }
}
# (helper of Thigh, not listed) the aim, a block per side; the left line carries the flip.
ThighDir = pose(raise=0.0, azimuth=0.0, frame=character, left=true, right=true) {
  if ($right) { aim(thigh_r, from=$ThighR, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), right=asin(sin($raise) * sin($azimuth))), relative=$frame) }
  if ($left) { aim(thigh_l, from=$ThighL, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), left=asin(sin($raise) * sin($azimuth))), relative=$frame) }
}

# SHIN (first layer, sided): where the shin (knee to ankle) points, for a leg OFF the ground (an alternative per side to FootAt: one
# aim per bone). Directions as the arm's: raise 0 straight down, 90 level, 180 up; azimuth 0 ahead, 90 out to its own side, 180
# behind, below 0 across; in frame. Either one written asks the direction (raise alone: azimuth 0; azimuth alone: rig_rest_raise
# 3.4). Neither: not asked, the shin (knee to ankle) rides its parent.
#  Alone, Shin follows azimuth 0, not the thigh's (one preset cannot read another's value): say a whole leg with LegReach.
#  Worked values (built): $Shin(raise=0) under a level thigh -> 0.24; one knee up beside a planted foot
#              $FootAt(right=false) $Thigh(left=false, raise=90) $Shin(left=false, raise=0) -> the standing sole 0.00.
#              REFUSED on collision: $Thigh(raise=10, azimuth=180) $Shin(raise=170 or 150, azimuth=180) (the calf into the thigh,
#              "intersects ... by 0.995226 cm" / 2.25 cm): a quad stretch is not said by two directions on this body.
Shin = pose(raise=none, raise_min=0, raise_max=180, azimuth=0 * $raise, azimuth_min=-180, azimuth_max=180, frame=character, left=true, right=true, rig_rest_raise=3.4) {
  if ($raise != none) {
    if ($azimuth != none) {
      $ShinDir(raise=$raise, azimuth=$azimuth, frame=$frame, left=$left, right=$right)
    } else {
      $ShinDir(raise=$raise, azimuth=0, frame=$frame, left=$left, right=$right)
    }
  } else {
    if ($azimuth != none) {
      $ShinDir(raise=$rig_rest_raise, azimuth=$azimuth, frame=$frame, left=$left, right=$right)
    }
  }
}
# (helper of Shin, not listed) the aim, a block per side; the left line carries the flip.
ShinDir = pose(raise=0.0, azimuth=0.0, frame=character, left=true, right=true) {
  if ($right) { aim(calf_r, from=$ShinR, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), right=asin(sin($raise) * sin($azimuth))), relative=$frame) }
  if ($left) { aim(calf_l, from=$ShinL, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), left=asin(sin($raise) * sin($azimuth))), relative=$frame) }
}

# LEGREACH (second layer, sided: calls only Thigh and Shin): a free leg along a line from the hip joint and how far out.
#  raise, azimuth  the direction from the hip joint to the ankle; the pair rule (azimuth alone takes rig_rest_raise 3.1, the
#            rest line's). Neither written: nothing asked.
#  reach     the ankle's distance along that line as a share of rig_thigh_len + rig_shin_len (86.2 cm): 1 (default) straight;
#            the knee's 141.9 stop ends it near 0.33 (inferred); above 1 refused by the arithmetic.
#  swivel    degrees the knee is swung round the line from AHEAD (its natural fold side; for a raised leg: up), + out; default 0.
#  turnout   passed to Thigh.   frame, left, right   as Thigh's.
#  Arithmetic: ArmReach's, with the knee's zero half a turn from the elbow's (swivel 180 - swivel).
#  Worked values (built): a walking swing $LegReach(raise=15, azimuth=0, reach=0.8) -> line 14.97 / -0.39, reach 0.799,
#              knee ahead; $LegReach(raise=60, azimuth=0, reach=0.7, swivel=30) -> 59.91 / 0.09, 0.699, the knee 20.6 out; a tuck
#              $LegReach(raise=110, azimuth=0, reach=0.4) -> 87.2 / 11.2, 0.687: the thigh's 133.8 stop, said ("short"). reach's
#              end 0.4 is the calf meeting the thigh on a line of 45 (0.38 refused there); the tuck asked 0.38 before ranges.
LegReach = pose(raise=none, raise_min=0, raise_max=180, azimuth=0 * $raise, azimuth_min=-180, azimuth_max=180, reach=1.0, reach_min=0.4, reach_max=1, swivel=0.0, swivel_min=-30, swivel_max=30, turnout=none, turnout_min=-53.5, turnout_max=53.5, frame=character, left=true, right=true, rig_thigh_len=44.23, rig_shin_len=41.96, rig_rest_raise=3.1) {
  if ($raise != none) {
    if ($azimuth != none) {
      $LegReachKnee(raise=$raise, azimuth=$azimuth, swivel=180 - $swivel, d=$reach * ($rig_thigh_len + $rig_shin_len), ca=($rig_thigh_len * $rig_thigh_len + pow($reach * ($rig_thigh_len + $rig_shin_len), 2) - $rig_shin_len * $rig_shin_len) / (2 * $rig_thigh_len * $reach * ($rig_thigh_len + $rig_shin_len)), rig_thigh_len=$rig_thigh_len, frame=$frame, left=$left, right=$right)
    } else {
      $LegReachKnee(raise=$raise, azimuth=0, swivel=180 - $swivel, d=$reach * ($rig_thigh_len + $rig_shin_len), ca=($rig_thigh_len * $rig_thigh_len + pow($reach * ($rig_thigh_len + $rig_shin_len), 2) - $rig_shin_len * $rig_shin_len) / (2 * $rig_thigh_len * $reach * ($rig_thigh_len + $rig_shin_len)), rig_thigh_len=$rig_thigh_len, frame=$frame, left=$left, right=$right)
    }
  } else {
    if ($azimuth != none) {
      $LegReachKnee(raise=$rig_rest_raise, azimuth=$azimuth, swivel=180 - $swivel, d=$reach * ($rig_thigh_len + $rig_shin_len), ca=($rig_thigh_len * $rig_thigh_len + pow($reach * ($rig_thigh_len + $rig_shin_len), 2) - $rig_shin_len * $rig_shin_len) / (2 * $rig_thigh_len * $reach * ($rig_thigh_len + $rig_shin_len)), rig_thigh_len=$rig_thigh_len, frame=$frame, left=$left, right=$right)
    }
  }
  if ($turnout != none) { $Thigh(turnout=$turnout, left=$left, right=$right) }
}
# (helper of LegReach, not listed) the knee's direction and the ankle's place from the hip (ArmReachElbow's arithmetic).
LegReachKnee = pose(raise=90.0, azimuth=0.0, swivel=0.0, d=40.0, ca=0.7, rig_thigh_len=44.23, frame=character, left=true, right=true) {
  $LegReachAim(ux=$ca * sin($raise) * sin($azimuth) + sqrt(1 - $ca * $ca + 0.000000001) * (sin($swivel) * cos($azimuth) - cos($swivel) * cos($raise) * sin($azimuth)), uy=$ca * sin($raise) * cos($azimuth) - sqrt(1 - $ca * $ca + 0.000000001) * (sin($swivel) * sin($azimuth) + cos($swivel) * cos($raise) * cos($azimuth)), uz=-$ca * cos($raise) - sqrt(1 - $ca * $ca + 0.000000001) * cos($swivel) * sin($raise), wx=$d * sin($raise) * sin($azimuth), wy=$d * sin($raise) * cos($azimuth), wz=-$d * cos($raise), rig_thigh_len=$rig_thigh_len, frame=$frame, left=$left, right=$right)
}
# (helper of LegReach, not listed) the two directions back into raise/azimuth, handed to Thigh and Shin.
LegReachAim = pose(ux=0.0, uy=0.7, uz=-0.7, wx=0.0, wy=40.0, wz=0.0, rig_thigh_len=44.23, frame=character, left=true, right=true) {
  $Thigh(raise=atan2(sqrt($ux * $ux + $uy * $uy), -$uz), azimuth=atan2($ux, $uy), frame=$frame, left=$left, right=$right)
  $Shin(raise=atan2(sqrt(pow($wx - $rig_thigh_len * $ux, 2) + pow($wy - $rig_thigh_len * $uy, 2)), $rig_thigh_len * $uz - $wz), azimuth=atan2($wx - $rig_thigh_len * $ux, $wy - $rig_thigh_len * $uy), frame=$frame, left=$left, right=$right)
}

# FOOT (first layer, sided): the FREE foot's ankle and toes (foot fold and twist, ball fold), as offsets from where the leg leaves
# it. A planted foot's heel is FootAt.heel; Foot and FootAt do not both write one foot.
#  point       degrees, the foot pointed (toes down); below 0 flexed (toes up). Not written: not asked. Room: 61.8 down, 39 up.
#  toes_up     degrees, the toes bent up at the ball; below 0 curled down. Not written: not asked.
#  ankle_roll  degrees, the sole turned IN (inversion); below 0 out. Not written: not asked. Room +-27.7. The rig's twist turns
#              the right sole OUT, so the right line carries the flip.
#  Worked values (built, toes read against the ankle): pointed $Foot(point=40) -> toes 7.3 cm down; flexed
#              $Foot(point=-15, toes_up=30) -> toes 3.7 up; $Foot(ankle_roll=15) -> big toe 0.65 up, little toe 1.16 down (both
#              sides alike).
Foot = pose(point=none, point_min=-39, point_max=61.8, toes_up=none, toes_up_min=-35, toes_up_max=65.6, ankle_roll=none, ankle_roll_min=-27.7, ankle_roll_max=27.7, left=true, right=true) {
  if ($point != none) {
    if ($right) { swing(foot_r, axis=fold, by=-$point) }
    if ($left) { swing(foot_l, axis=fold, by=-$point) }
  }
  if ($toes_up != none) {
    if ($right) { swing(ball_r, axis=fold, by=-$toes_up) }
    if ($left) { swing(ball_l, axis=fold, by=-$toes_up) }
  }
  if ($ankle_roll != none) {
    if ($right) { swing(foot_r, axis=twist, by=-$ankle_roll) }
    if ($left) { swing(foot_l, axis=twist, by=$ankle_roll) }
  }
}

# ---- the hand preset (the same text as the Hand library) ----
# HAND (MOVE-PARAM1, 17 Nov 2026, author move-hand2; every reading behind it: Saved/Research/MOVE-PARAM1/STEP2-HAND2.md).
# The wrist, four fingers and the thumb of one or both hands, POSED: plain arithmetic to numbers found once, no solver.
# Values (-1..1 with 0 the rest hand, except where degrees are said). A value not written is not asked: its lines are not
# written, so $Hand alone writes no line and the hand stays at rest.
#   curl          the one coarse number: -1 flat, 1 closed, the thumb with it; below -1 the fingers bend back past flat,
#                 to the joints' stops at -2. knuckle (the fingers' first joints) and tip (second and third) follow it.
#   index, middle, ring, little   one finger's knuckle, REPLACING the hand's; index_tip .. little_tip follow the finger's
#                 own value when that is written, else the hand's tip. "Two" is $Hand(curl=1, index=-1, middle=-1).
#   fan           (-1..1) each finger a little more closed than the one before (0, 1/6, 1/3, 1/2 of it); feeds only the
#                 fingers not written.
#   spread        -1 pressed together, 1 splayed; index_side .. little_side in degrees, + toward the little finger, exact
#                 when written; spread's share fades as a finger closes.
#   thumb         its base lifted out from the hand 1, laid along it -1 (the base's FOLD). When written it REPLACES the
#                 lift the across sweep would add.
#   thumb_across  (0..1) swept across the palm (the base's SIDE and ROLL); follows max(curl, 0), so a closed hand is a fist
#                 with the thumb locked over the index and middle fingers; thumb_across=0 keeps it out.
#   thumb_tip     -1 straight, 1 closed; follows thumb_across.
#   wrist         degrees toward the palm (below 0 cocked back); wrist_side degrees toward the little finger.
#   left, right   which hands.
# How it closes: each finger joint's closed end is a rig_ number found ONCE by touch (a collision form closing the hand;
# where each joint stopped), reached here by arithmetic: fast, the same every build. Where the thumb lies across depends on
# which fingers are closed in front of the palm, so the middle and ring fingers carry shares of its lift, sweep and curl
# (all open: across the palm, "four"; ring and little closed: on the ring, "two"; the middle closed too: its pad over the
# index and middle second bones, the fist). The build's own collision check refuses anything inside anything.
# Moving between shapes (the build refuses the straight path; measured 17 Nov): out of a closed hand a finger opens
#   knuckle first, then its tips ((curl=1, index=-1, index_tip=1) between the fist and "one"), or its end slides
#   through its closed neighbour; and the thumb leaves a finger before that finger opens ("two" to "three": thumb out
#   with thumb_across=0, thumb=1, the ring opens, the thumb comes back onto the little finger). See the Count clip.
# Rig: the presets' body PoseBody (corrected wrist and thumb base). Every skeleton number is a rig_ parameter.
Hand = pose(curl=none, curl_min=-2, curl_max=1, knuckle=$curl, knuckle_min=-2, knuckle_max=1, tip=$curl, tip_min=-2, tip_max=1,
            index=none, index_min=-2, index_max=1, index_tip=$index, index_tip_min=-2, index_tip_max=1, middle=none, middle_min=-2,
            middle_max=1, middle_tip=$middle, middle_tip_min=-2, middle_tip_max=1, ring=none, ring_min=-2, ring_max=1,
            ring_tip=$ring, ring_tip_min=-2, ring_tip_max=1, little=none, little_min=-2, little_max=1, little_tip=$little,
            little_tip_min=-2, little_tip_max=1, fan=0.0, fan_min=-1, fan_max=1, spread=none, spread_min=-1, spread_max=1,
            index_side=none, index_side_min=-15, index_side_max=11, middle_side=none, middle_side_min=-8, middle_side_max=15,
            ring_side=none, ring_side_min=-15, ring_side_max=15, little_side=none, little_side_min=-15, little_side_max=15,
            thumb=none, thumb_min=-1, thumb_max=1, thumb_across=max($curl, 0), thumb_across_min=0, thumb_across_max=1,
            thumb_tip=$thumb_across, thumb_tip_min=-1, thumb_tip_max=1, wrist=none, wrist_min=-71, wrist_max=83, wrist_side=none,
            wrist_side_min=-16.8, wrist_side_max=38.5, left=true, right=true, rig_index_close1=56.5, rig_index_close2=60,
            rig_index_close3=36, rig_index_rest1=28.4, rig_index_rest2=25.5, rig_index_rest3=13.1, rig_index_splay=-15,
            rig_index_press=11, rig_middle_close1=52.1, rig_middle_close2=65.2, rig_middle_close3=45.6, rig_middle_rest1=32.8,
            rig_middle_rest2=30.1, rig_middle_rest3=12.7, rig_ring_close1=60.2, rig_ring_close2=60.8, rig_ring_close3=42.5,
            rig_ring_rest1=24.7, rig_ring_rest2=34.5, rig_ring_rest3=11.7, rig_ring_splay=7.5, rig_ring_press=-14,
            rig_little_close1=58.5, rig_little_close2=53.6, rig_little_close3=37.4, rig_little_rest1=16.6, rig_little_rest2=32.1,
            rig_little_rest3=15.6, rig_little_splay=15, rig_little_press=-15, rig_back1=26.3, rig_back2=16.2, rig_back3=8.4,
            rig_fan=0.5, rig_thumb_out=40.0, rig_thumb_in=10.0, rig_thumb_give=20.0, rig_thumb_side=-45.0,
            rig_thumb_side_middle=7.0, rig_thumb_roll=5.0, rig_thumb_lift_middle=6.0, rig_thumb_lift_ring=33.0, rig_thumb_lift=5.0,
            rig_thumb_mcp=13.9, rig_thumb_ip=79.0, rig_thumb_mcp_ring=-13.9, rig_thumb_ip_middle=-7.0, rig_thumb_ip_ring=-44.0,
            rig_thumb_rest2=46.1, rig_thumb_rest3=8.5, rig_wrist_palm=1.012, rig_wrist_back=1.028, rig_wrist_fold_palm=0.15,
            rig_wrist_side=0.99, rig_wrist_a1=0.1017, rig_wrist_a2=0.001056, rig_wrist_b1=0.0533, rig_wrist_b2=0.00378) {
  if ($left) {
    if ($index != none) {
      if ($index_side != none) {
        swing(index_01_l, axis=side, by=-$index_side)
      } else {
        if ($spread != none) {
          swing(index_01_l, axis=side, by=-(max($spread, 0) * $rig_index_splay - min($spread, 0) * $rig_index_press) * (1 - max(min($index, 1), 0)))
        }
      }
      swing(index_01_l, axis=fold, by=max(min($index, 1), 0) * $rig_index_close1 + min(max($index, -1), 0) * $rig_index_rest1 + min($index + 1, 0) * $rig_back1)
      if ($thumb == none) {
        if ($thumb_across != none) {
          swing(thumb_01_l, axis=fold, by=$rig_thumb_give * max(min($index, 1), 0) * (1 - $thumb_across))
        } else {
          swing(thumb_01_l, axis=fold, by=$rig_thumb_give * max(min($index, 1), 0))
        }
      }
    } else {
      if ($knuckle != none) {
        if ($index_side != none) {
          swing(index_01_l, axis=side, by=-$index_side)
        } else {
          if ($spread != none) {
            swing(index_01_l, axis=side, by=-(max($spread, 0) * $rig_index_splay - min($spread, 0) * $rig_index_press) * (1 - max(min($knuckle, 1), 0)))
          }
        }
        swing(index_01_l, axis=fold, by=max(min($knuckle, 1), 0) * $rig_index_close1 + min(max($knuckle, -1), 0) * $rig_index_rest1 + min($knuckle + 1, 0) * $rig_back1)
        if ($thumb == none) {
          if ($thumb_across != none) {
            swing(thumb_01_l, axis=fold, by=$rig_thumb_give * max(min($knuckle, 1), 0) * (1 - $thumb_across))
          } else {
            swing(thumb_01_l, axis=fold, by=$rig_thumb_give * max(min($knuckle, 1), 0))
          }
        }
      } else {
        if ($index_side != none) {
          swing(index_01_l, axis=side, by=-$index_side)
        } else {
          if ($spread != none) {
            swing(index_01_l, axis=side, by=-(max($spread, 0) * $rig_index_splay - min($spread, 0) * $rig_index_press))
          }
        }
      }
    }
    if ($index_tip != none) {
      swing(index_02_l, axis=fold, by=max(min($index_tip, 1), 0) * $rig_index_close2 + min(max($index_tip, -1), 0) * $rig_index_rest2 + min($index_tip + 1, 0) * $rig_back2)
      swing(index_03_l, axis=fold, by=max(min($index_tip, 1), 0) * $rig_index_close3 + min(max($index_tip, -1), 0) * $rig_index_rest3 + min($index_tip + 1, 0) * $rig_back3)
    } else {
      if ($tip != none) {
        swing(index_02_l, axis=fold, by=max(min($tip, 1), 0) * $rig_index_close2 + min(max($tip, -1), 0) * $rig_index_rest2 + min($tip + 1, 0) * $rig_back2)
        swing(index_03_l, axis=fold, by=max(min($tip, 1), 0) * $rig_index_close3 + min(max($tip, -1), 0) * $rig_index_rest3 + min($tip + 1, 0) * $rig_back3)
      }
    }
    if ($middle != none) {
      if ($middle_side != none) {
        swing(middle_01_l, axis=side, by=-$middle_side)
      }
      swing(middle_01_l, axis=fold, by=max(min($middle, 1), 0) * $rig_middle_close1 + min(max($middle, -1), 0) * $rig_middle_rest1 + min($middle + 1, 0) * $rig_back1)
      if ($thumb == none) {
        if ($thumb_across != none) {
          swing(thumb_01_l, axis=fold, by=$thumb_across * $rig_thumb_lift_middle * max(min($middle, 1), 0))
        }
      }
      if ($thumb_tip != none) {
        swing(thumb_03_l, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip_middle * max(min($middle, 1), 0))
      }
    } else {
      if ($knuckle != none) {
        if ($middle_side != none) {
          swing(middle_01_l, axis=side, by=-$middle_side)
        }
        swing(middle_01_l, axis=fold, by=max(min(($knuckle + $fan * $rig_fan * 0.333), 1), 0) * $rig_middle_close1 + min(max(($knuckle + $fan * $rig_fan * 0.333), -1), 0) * $rig_middle_rest1 + min(($knuckle + $fan * $rig_fan * 0.333) + 1, 0) * $rig_back1)
        if ($thumb == none) {
          if ($thumb_across != none) {
            swing(thumb_01_l, axis=fold, by=$thumb_across * $rig_thumb_lift_middle * max(min(($knuckle + $fan * $rig_fan * 0.333), 1), 0))
          }
        }
        if ($thumb_tip != none) {
          swing(thumb_03_l, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip_middle * max(min(($knuckle + $fan * $rig_fan * 0.333), 1), 0))
        }
      } else {
        if ($middle_side != none) {
          swing(middle_01_l, axis=side, by=-$middle_side)
        }
      }
    }
    if ($middle_tip != none) {
      swing(middle_02_l, axis=fold, by=max(min($middle_tip, 1), 0) * $rig_middle_close2 + min(max($middle_tip, -1), 0) * $rig_middle_rest2 + min($middle_tip + 1, 0) * $rig_back2)
      swing(middle_03_l, axis=fold, by=max(min($middle_tip, 1), 0) * $rig_middle_close3 + min(max($middle_tip, -1), 0) * $rig_middle_rest3 + min($middle_tip + 1, 0) * $rig_back3)
    } else {
      if ($tip != none) {
        swing(middle_02_l, axis=fold, by=max(min(($tip + $fan * $rig_fan * 0.333), 1), 0) * $rig_middle_close2 + min(max(($tip + $fan * $rig_fan * 0.333), -1), 0) * $rig_middle_rest2 + min(($tip + $fan * $rig_fan * 0.333) + 1, 0) * $rig_back2)
        swing(middle_03_l, axis=fold, by=max(min(($tip + $fan * $rig_fan * 0.333), 1), 0) * $rig_middle_close3 + min(max(($tip + $fan * $rig_fan * 0.333), -1), 0) * $rig_middle_rest3 + min(($tip + $fan * $rig_fan * 0.333) + 1, 0) * $rig_back3)
      }
    }
    if ($ring != none) {
      if ($ring_side != none) {
        swing(ring_01_l, axis=side, by=-$ring_side)
      } else {
        if ($spread != none) {
          swing(ring_01_l, axis=side, by=-(max($spread, 0) * $rig_ring_splay - min($spread, 0) * $rig_ring_press) * (1 - max(min($ring, 1), 0)))
        }
      }
      swing(ring_01_l, axis=fold, by=max(min($ring, 1), 0) * $rig_ring_close1 + min(max($ring, -1), 0) * $rig_ring_rest1 + min($ring + 1, 0) * $rig_back1)
      if ($thumb == none) {
        if ($thumb_across != none) {
          swing(thumb_01_l, axis=fold, by=$thumb_across * $rig_thumb_lift_ring * max(min($ring, 1), 0))
        }
      }
      if ($thumb_tip != none) {
        swing(thumb_02_l, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_mcp_ring * max(min($ring, 1), 0))
        swing(thumb_03_l, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip_ring * max(min($ring, 1), 0))
      }
    } else {
      if ($knuckle != none) {
        if ($ring_side != none) {
          swing(ring_01_l, axis=side, by=-$ring_side)
        } else {
          if ($spread != none) {
            swing(ring_01_l, axis=side, by=-(max($spread, 0) * $rig_ring_splay - min($spread, 0) * $rig_ring_press) * (1 - max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0)))
          }
        }
        swing(ring_01_l, axis=fold, by=max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0) * $rig_ring_close1 + min(max(($knuckle + $fan * $rig_fan * 0.667), -1), 0) * $rig_ring_rest1 + min(($knuckle + $fan * $rig_fan * 0.667) + 1, 0) * $rig_back1)
        if ($thumb == none) {
          if ($thumb_across != none) {
            swing(thumb_01_l, axis=fold, by=$thumb_across * $rig_thumb_lift_ring * max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0))
          }
        }
        if ($thumb_tip != none) {
          swing(thumb_02_l, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_mcp_ring * max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0))
          swing(thumb_03_l, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip_ring * max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0))
        }
      } else {
        if ($ring_side != none) {
          swing(ring_01_l, axis=side, by=-$ring_side)
        } else {
          if ($spread != none) {
            swing(ring_01_l, axis=side, by=-(max($spread, 0) * $rig_ring_splay - min($spread, 0) * $rig_ring_press))
          }
        }
      }
    }
    if ($ring_tip != none) {
      swing(ring_02_l, axis=fold, by=max(min($ring_tip, 1), 0) * $rig_ring_close2 + min(max($ring_tip, -1), 0) * $rig_ring_rest2 + min($ring_tip + 1, 0) * $rig_back2)
      swing(ring_03_l, axis=fold, by=max(min($ring_tip, 1), 0) * $rig_ring_close3 + min(max($ring_tip, -1), 0) * $rig_ring_rest3 + min($ring_tip + 1, 0) * $rig_back3)
    } else {
      if ($tip != none) {
        swing(ring_02_l, axis=fold, by=max(min(($tip + $fan * $rig_fan * 0.667), 1), 0) * $rig_ring_close2 + min(max(($tip + $fan * $rig_fan * 0.667), -1), 0) * $rig_ring_rest2 + min(($tip + $fan * $rig_fan * 0.667) + 1, 0) * $rig_back2)
        swing(ring_03_l, axis=fold, by=max(min(($tip + $fan * $rig_fan * 0.667), 1), 0) * $rig_ring_close3 + min(max(($tip + $fan * $rig_fan * 0.667), -1), 0) * $rig_ring_rest3 + min(($tip + $fan * $rig_fan * 0.667) + 1, 0) * $rig_back3)
      }
    }
    if ($little != none) {
      if ($little_side != none) {
        swing(pinky_01_l, axis=side, by=-$little_side)
      } else {
        if ($spread != none) {
          swing(pinky_01_l, axis=side, by=-(max($spread, 0) * $rig_little_splay - min($spread, 0) * $rig_little_press) * (1 - max(min($little, 1), 0)))
        }
      }
      swing(pinky_01_l, axis=fold, by=max(min($little, 1), 0) * $rig_little_close1 + min(max($little, -1), 0) * $rig_little_rest1 + min($little + 1, 0) * $rig_back1)
    } else {
      if ($knuckle != none) {
        if ($little_side != none) {
          swing(pinky_01_l, axis=side, by=-$little_side)
        } else {
          if ($spread != none) {
            swing(pinky_01_l, axis=side, by=-(max($spread, 0) * $rig_little_splay - min($spread, 0) * $rig_little_press) * (1 - max(min(($knuckle + $fan * $rig_fan * 1), 1), 0)))
          }
        }
        swing(pinky_01_l, axis=fold, by=max(min(($knuckle + $fan * $rig_fan * 1), 1), 0) * $rig_little_close1 + min(max(($knuckle + $fan * $rig_fan * 1), -1), 0) * $rig_little_rest1 + min(($knuckle + $fan * $rig_fan * 1) + 1, 0) * $rig_back1)
      } else {
        if ($little_side != none) {
          swing(pinky_01_l, axis=side, by=-$little_side)
        } else {
          if ($spread != none) {
            swing(pinky_01_l, axis=side, by=-(max($spread, 0) * $rig_little_splay - min($spread, 0) * $rig_little_press))
          }
        }
      }
    }
    if ($little_tip != none) {
      swing(pinky_02_l, axis=fold, by=max(min($little_tip, 1), 0) * $rig_little_close2 + min(max($little_tip, -1), 0) * $rig_little_rest2 + min($little_tip + 1, 0) * $rig_back2)
      swing(pinky_03_l, axis=fold, by=max(min($little_tip, 1), 0) * $rig_little_close3 + min(max($little_tip, -1), 0) * $rig_little_rest3 + min($little_tip + 1, 0) * $rig_back3)
    } else {
      if ($tip != none) {
        swing(pinky_02_l, axis=fold, by=max(min(($tip + $fan * $rig_fan * 1), 1), 0) * $rig_little_close2 + min(max(($tip + $fan * $rig_fan * 1), -1), 0) * $rig_little_rest2 + min(($tip + $fan * $rig_fan * 1) + 1, 0) * $rig_back2)
        swing(pinky_03_l, axis=fold, by=max(min(($tip + $fan * $rig_fan * 1), 1), 0) * $rig_little_close3 + min(max(($tip + $fan * $rig_fan * 1), -1), 0) * $rig_little_rest3 + min(($tip + $fan * $rig_fan * 1) + 1, 0) * $rig_back3)
      }
    }
    if ($thumb != none) {
      swing(thumb_01_l, axis=fold, by=max($thumb, 0) * $rig_thumb_out + min($thumb, 0) * $rig_thumb_in)
    } else {
      if ($thumb_across != none) {
        swing(thumb_01_l, axis=fold, by=$thumb_across * $rig_thumb_lift)
      }
    }
    if ($thumb_across != none) {
      if ($middle != none) {
        swing(thumb_01_l, axis=side, by=$thumb_across * $rig_thumb_side_middle * max(min($middle, 1), 0))
      } else {
        if ($knuckle != none) {
          swing(thumb_01_l, axis=side, by=$thumb_across * $rig_thumb_side_middle * max(min(($knuckle + $fan * $rig_fan * 0.333), 1), 0))
        }
      }
      swing(thumb_01_l, axis=side, by=$thumb_across * $rig_thumb_side)
      swing(thumb_01_l, axis=twist, by=-$thumb_across * $rig_thumb_roll)
    }
    if ($thumb_tip != none) {
      swing(thumb_02_l, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_mcp + min($thumb_tip, 0) * $rig_thumb_rest2)
      swing(thumb_03_l, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip + min($thumb_tip, 0) * $rig_thumb_rest3)
    }
    if ($wrist != none) {
      if ($wrist_side != none) {
        swing(hand_l, axis=fold, by=$rig_wrist_side * $wrist_side + (-$rig_wrist_a1 * max($wrist, 0) - $rig_wrist_a2 * max($wrist, 0) * max($wrist, 0) + $rig_wrist_b1 * max(-$wrist, 0) + $rig_wrist_b2 * max(-$wrist, 0) * max(-$wrist, 0)))
        swing(hand_l, axis=side, by=-($rig_wrist_palm * max($wrist, 0) + $rig_wrist_back * min($wrist, 0)) - $rig_wrist_fold_palm * ($rig_wrist_side * $wrist_side + (-$rig_wrist_a1 * max($wrist, 0) - $rig_wrist_a2 * max($wrist, 0) * max($wrist, 0) + $rig_wrist_b1 * max(-$wrist, 0) + $rig_wrist_b2 * max(-$wrist, 0) * max(-$wrist, 0))))
      } else {
        swing(hand_l, axis=fold, by=(-$rig_wrist_a1 * max($wrist, 0) - $rig_wrist_a2 * max($wrist, 0) * max($wrist, 0) + $rig_wrist_b1 * max(-$wrist, 0) + $rig_wrist_b2 * max(-$wrist, 0) * max(-$wrist, 0)))
        swing(hand_l, axis=side, by=-($rig_wrist_palm * max($wrist, 0) + $rig_wrist_back * min($wrist, 0)) - $rig_wrist_fold_palm * (-$rig_wrist_a1 * max($wrist, 0) - $rig_wrist_a2 * max($wrist, 0) * max($wrist, 0) + $rig_wrist_b1 * max(-$wrist, 0) + $rig_wrist_b2 * max(-$wrist, 0) * max(-$wrist, 0)))
      }
    } else {
      if ($wrist_side != none) {
        swing(hand_l, axis=fold, by=$rig_wrist_side * $wrist_side)
        swing(hand_l, axis=side, by=-$rig_wrist_fold_palm * $rig_wrist_side * $wrist_side)
      }
    }
  }
  if ($right) {
    if ($index != none) {
      if ($index_side != none) {
        swing(index_01_r, axis=side, by=-$index_side)
      } else {
        if ($spread != none) {
          swing(index_01_r, axis=side, by=-(max($spread, 0) * $rig_index_splay - min($spread, 0) * $rig_index_press) * (1 - max(min($index, 1), 0)))
        }
      }
      swing(index_01_r, axis=fold, by=max(min($index, 1), 0) * $rig_index_close1 + min(max($index, -1), 0) * $rig_index_rest1 + min($index + 1, 0) * $rig_back1)
      if ($thumb == none) {
        if ($thumb_across != none) {
          swing(thumb_01_r, axis=fold, by=$rig_thumb_give * max(min($index, 1), 0) * (1 - $thumb_across))
        } else {
          swing(thumb_01_r, axis=fold, by=$rig_thumb_give * max(min($index, 1), 0))
        }
      }
    } else {
      if ($knuckle != none) {
        if ($index_side != none) {
          swing(index_01_r, axis=side, by=-$index_side)
        } else {
          if ($spread != none) {
            swing(index_01_r, axis=side, by=-(max($spread, 0) * $rig_index_splay - min($spread, 0) * $rig_index_press) * (1 - max(min($knuckle, 1), 0)))
          }
        }
        swing(index_01_r, axis=fold, by=max(min($knuckle, 1), 0) * $rig_index_close1 + min(max($knuckle, -1), 0) * $rig_index_rest1 + min($knuckle + 1, 0) * $rig_back1)
        if ($thumb == none) {
          if ($thumb_across != none) {
            swing(thumb_01_r, axis=fold, by=$rig_thumb_give * max(min($knuckle, 1), 0) * (1 - $thumb_across))
          } else {
            swing(thumb_01_r, axis=fold, by=$rig_thumb_give * max(min($knuckle, 1), 0))
          }
        }
      } else {
        if ($index_side != none) {
          swing(index_01_r, axis=side, by=-$index_side)
        } else {
          if ($spread != none) {
            swing(index_01_r, axis=side, by=-(max($spread, 0) * $rig_index_splay - min($spread, 0) * $rig_index_press))
          }
        }
      }
    }
    if ($index_tip != none) {
      swing(index_02_r, axis=fold, by=max(min($index_tip, 1), 0) * $rig_index_close2 + min(max($index_tip, -1), 0) * $rig_index_rest2 + min($index_tip + 1, 0) * $rig_back2)
      swing(index_03_r, axis=fold, by=max(min($index_tip, 1), 0) * $rig_index_close3 + min(max($index_tip, -1), 0) * $rig_index_rest3 + min($index_tip + 1, 0) * $rig_back3)
    } else {
      if ($tip != none) {
        swing(index_02_r, axis=fold, by=max(min($tip, 1), 0) * $rig_index_close2 + min(max($tip, -1), 0) * $rig_index_rest2 + min($tip + 1, 0) * $rig_back2)
        swing(index_03_r, axis=fold, by=max(min($tip, 1), 0) * $rig_index_close3 + min(max($tip, -1), 0) * $rig_index_rest3 + min($tip + 1, 0) * $rig_back3)
      }
    }
    if ($middle != none) {
      if ($middle_side != none) {
        swing(middle_01_r, axis=side, by=-$middle_side)
      }
      swing(middle_01_r, axis=fold, by=max(min($middle, 1), 0) * $rig_middle_close1 + min(max($middle, -1), 0) * $rig_middle_rest1 + min($middle + 1, 0) * $rig_back1)
      if ($thumb == none) {
        if ($thumb_across != none) {
          swing(thumb_01_r, axis=fold, by=$thumb_across * $rig_thumb_lift_middle * max(min($middle, 1), 0))
        }
      }
      if ($thumb_tip != none) {
        swing(thumb_03_r, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip_middle * max(min($middle, 1), 0))
      }
    } else {
      if ($knuckle != none) {
        if ($middle_side != none) {
          swing(middle_01_r, axis=side, by=-$middle_side)
        }
        swing(middle_01_r, axis=fold, by=max(min(($knuckle + $fan * $rig_fan * 0.333), 1), 0) * $rig_middle_close1 + min(max(($knuckle + $fan * $rig_fan * 0.333), -1), 0) * $rig_middle_rest1 + min(($knuckle + $fan * $rig_fan * 0.333) + 1, 0) * $rig_back1)
        if ($thumb == none) {
          if ($thumb_across != none) {
            swing(thumb_01_r, axis=fold, by=$thumb_across * $rig_thumb_lift_middle * max(min(($knuckle + $fan * $rig_fan * 0.333), 1), 0))
          }
        }
        if ($thumb_tip != none) {
          swing(thumb_03_r, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip_middle * max(min(($knuckle + $fan * $rig_fan * 0.333), 1), 0))
        }
      } else {
        if ($middle_side != none) {
          swing(middle_01_r, axis=side, by=-$middle_side)
        }
      }
    }
    if ($middle_tip != none) {
      swing(middle_02_r, axis=fold, by=max(min($middle_tip, 1), 0) * $rig_middle_close2 + min(max($middle_tip, -1), 0) * $rig_middle_rest2 + min($middle_tip + 1, 0) * $rig_back2)
      swing(middle_03_r, axis=fold, by=max(min($middle_tip, 1), 0) * $rig_middle_close3 + min(max($middle_tip, -1), 0) * $rig_middle_rest3 + min($middle_tip + 1, 0) * $rig_back3)
    } else {
      if ($tip != none) {
        swing(middle_02_r, axis=fold, by=max(min(($tip + $fan * $rig_fan * 0.333), 1), 0) * $rig_middle_close2 + min(max(($tip + $fan * $rig_fan * 0.333), -1), 0) * $rig_middle_rest2 + min(($tip + $fan * $rig_fan * 0.333) + 1, 0) * $rig_back2)
        swing(middle_03_r, axis=fold, by=max(min(($tip + $fan * $rig_fan * 0.333), 1), 0) * $rig_middle_close3 + min(max(($tip + $fan * $rig_fan * 0.333), -1), 0) * $rig_middle_rest3 + min(($tip + $fan * $rig_fan * 0.333) + 1, 0) * $rig_back3)
      }
    }
    if ($ring != none) {
      if ($ring_side != none) {
        swing(ring_01_r, axis=side, by=-$ring_side)
      } else {
        if ($spread != none) {
          swing(ring_01_r, axis=side, by=-(max($spread, 0) * $rig_ring_splay - min($spread, 0) * $rig_ring_press) * (1 - max(min($ring, 1), 0)))
        }
      }
      swing(ring_01_r, axis=fold, by=max(min($ring, 1), 0) * $rig_ring_close1 + min(max($ring, -1), 0) * $rig_ring_rest1 + min($ring + 1, 0) * $rig_back1)
      if ($thumb == none) {
        if ($thumb_across != none) {
          swing(thumb_01_r, axis=fold, by=$thumb_across * $rig_thumb_lift_ring * max(min($ring, 1), 0))
        }
      }
      if ($thumb_tip != none) {
        swing(thumb_02_r, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_mcp_ring * max(min($ring, 1), 0))
        swing(thumb_03_r, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip_ring * max(min($ring, 1), 0))
      }
    } else {
      if ($knuckle != none) {
        if ($ring_side != none) {
          swing(ring_01_r, axis=side, by=-$ring_side)
        } else {
          if ($spread != none) {
            swing(ring_01_r, axis=side, by=-(max($spread, 0) * $rig_ring_splay - min($spread, 0) * $rig_ring_press) * (1 - max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0)))
          }
        }
        swing(ring_01_r, axis=fold, by=max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0) * $rig_ring_close1 + min(max(($knuckle + $fan * $rig_fan * 0.667), -1), 0) * $rig_ring_rest1 + min(($knuckle + $fan * $rig_fan * 0.667) + 1, 0) * $rig_back1)
        if ($thumb == none) {
          if ($thumb_across != none) {
            swing(thumb_01_r, axis=fold, by=$thumb_across * $rig_thumb_lift_ring * max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0))
          }
        }
        if ($thumb_tip != none) {
          swing(thumb_02_r, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_mcp_ring * max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0))
          swing(thumb_03_r, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip_ring * max(min(($knuckle + $fan * $rig_fan * 0.667), 1), 0))
        }
      } else {
        if ($ring_side != none) {
          swing(ring_01_r, axis=side, by=-$ring_side)
        } else {
          if ($spread != none) {
            swing(ring_01_r, axis=side, by=-(max($spread, 0) * $rig_ring_splay - min($spread, 0) * $rig_ring_press))
          }
        }
      }
    }
    if ($ring_tip != none) {
      swing(ring_02_r, axis=fold, by=max(min($ring_tip, 1), 0) * $rig_ring_close2 + min(max($ring_tip, -1), 0) * $rig_ring_rest2 + min($ring_tip + 1, 0) * $rig_back2)
      swing(ring_03_r, axis=fold, by=max(min($ring_tip, 1), 0) * $rig_ring_close3 + min(max($ring_tip, -1), 0) * $rig_ring_rest3 + min($ring_tip + 1, 0) * $rig_back3)
    } else {
      if ($tip != none) {
        swing(ring_02_r, axis=fold, by=max(min(($tip + $fan * $rig_fan * 0.667), 1), 0) * $rig_ring_close2 + min(max(($tip + $fan * $rig_fan * 0.667), -1), 0) * $rig_ring_rest2 + min(($tip + $fan * $rig_fan * 0.667) + 1, 0) * $rig_back2)
        swing(ring_03_r, axis=fold, by=max(min(($tip + $fan * $rig_fan * 0.667), 1), 0) * $rig_ring_close3 + min(max(($tip + $fan * $rig_fan * 0.667), -1), 0) * $rig_ring_rest3 + min(($tip + $fan * $rig_fan * 0.667) + 1, 0) * $rig_back3)
      }
    }
    if ($little != none) {
      if ($little_side != none) {
        swing(pinky_01_r, axis=side, by=-$little_side)
      } else {
        if ($spread != none) {
          swing(pinky_01_r, axis=side, by=-(max($spread, 0) * $rig_little_splay - min($spread, 0) * $rig_little_press) * (1 - max(min($little, 1), 0)))
        }
      }
      swing(pinky_01_r, axis=fold, by=max(min($little, 1), 0) * $rig_little_close1 + min(max($little, -1), 0) * $rig_little_rest1 + min($little + 1, 0) * $rig_back1)
    } else {
      if ($knuckle != none) {
        if ($little_side != none) {
          swing(pinky_01_r, axis=side, by=-$little_side)
        } else {
          if ($spread != none) {
            swing(pinky_01_r, axis=side, by=-(max($spread, 0) * $rig_little_splay - min($spread, 0) * $rig_little_press) * (1 - max(min(($knuckle + $fan * $rig_fan * 1), 1), 0)))
          }
        }
        swing(pinky_01_r, axis=fold, by=max(min(($knuckle + $fan * $rig_fan * 1), 1), 0) * $rig_little_close1 + min(max(($knuckle + $fan * $rig_fan * 1), -1), 0) * $rig_little_rest1 + min(($knuckle + $fan * $rig_fan * 1) + 1, 0) * $rig_back1)
      } else {
        if ($little_side != none) {
          swing(pinky_01_r, axis=side, by=-$little_side)
        } else {
          if ($spread != none) {
            swing(pinky_01_r, axis=side, by=-(max($spread, 0) * $rig_little_splay - min($spread, 0) * $rig_little_press))
          }
        }
      }
    }
    if ($little_tip != none) {
      swing(pinky_02_r, axis=fold, by=max(min($little_tip, 1), 0) * $rig_little_close2 + min(max($little_tip, -1), 0) * $rig_little_rest2 + min($little_tip + 1, 0) * $rig_back2)
      swing(pinky_03_r, axis=fold, by=max(min($little_tip, 1), 0) * $rig_little_close3 + min(max($little_tip, -1), 0) * $rig_little_rest3 + min($little_tip + 1, 0) * $rig_back3)
    } else {
      if ($tip != none) {
        swing(pinky_02_r, axis=fold, by=max(min(($tip + $fan * $rig_fan * 1), 1), 0) * $rig_little_close2 + min(max(($tip + $fan * $rig_fan * 1), -1), 0) * $rig_little_rest2 + min(($tip + $fan * $rig_fan * 1) + 1, 0) * $rig_back2)
        swing(pinky_03_r, axis=fold, by=max(min(($tip + $fan * $rig_fan * 1), 1), 0) * $rig_little_close3 + min(max(($tip + $fan * $rig_fan * 1), -1), 0) * $rig_little_rest3 + min(($tip + $fan * $rig_fan * 1) + 1, 0) * $rig_back3)
      }
    }
    if ($thumb != none) {
      swing(thumb_01_r, axis=fold, by=max($thumb, 0) * $rig_thumb_out + min($thumb, 0) * $rig_thumb_in)
    } else {
      if ($thumb_across != none) {
        swing(thumb_01_r, axis=fold, by=$thumb_across * $rig_thumb_lift)
      }
    }
    if ($thumb_across != none) {
      if ($middle != none) {
        swing(thumb_01_r, axis=side, by=$thumb_across * $rig_thumb_side_middle * max(min($middle, 1), 0))
      } else {
        if ($knuckle != none) {
          swing(thumb_01_r, axis=side, by=$thumb_across * $rig_thumb_side_middle * max(min(($knuckle + $fan * $rig_fan * 0.333), 1), 0))
        }
      }
      swing(thumb_01_r, axis=side, by=$thumb_across * $rig_thumb_side)
      swing(thumb_01_r, axis=twist, by=$thumb_across * $rig_thumb_roll)
    }
    if ($thumb_tip != none) {
      swing(thumb_02_r, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_mcp + min($thumb_tip, 0) * $rig_thumb_rest2)
      swing(thumb_03_r, axis=fold, by=max($thumb_tip, 0) * $rig_thumb_ip + min($thumb_tip, 0) * $rig_thumb_rest3)
    }
    if ($wrist != none) {
      if ($wrist_side != none) {
        swing(hand_r, axis=fold, by=$rig_wrist_side * $wrist_side + (-$rig_wrist_a1 * max($wrist, 0) - $rig_wrist_a2 * max($wrist, 0) * max($wrist, 0) + $rig_wrist_b1 * max(-$wrist, 0) + $rig_wrist_b2 * max(-$wrist, 0) * max(-$wrist, 0)))
        swing(hand_r, axis=side, by=-($rig_wrist_palm * max($wrist, 0) + $rig_wrist_back * min($wrist, 0)) - $rig_wrist_fold_palm * ($rig_wrist_side * $wrist_side + (-$rig_wrist_a1 * max($wrist, 0) - $rig_wrist_a2 * max($wrist, 0) * max($wrist, 0) + $rig_wrist_b1 * max(-$wrist, 0) + $rig_wrist_b2 * max(-$wrist, 0) * max(-$wrist, 0))))
      } else {
        swing(hand_r, axis=fold, by=(-$rig_wrist_a1 * max($wrist, 0) - $rig_wrist_a2 * max($wrist, 0) * max($wrist, 0) + $rig_wrist_b1 * max(-$wrist, 0) + $rig_wrist_b2 * max(-$wrist, 0) * max(-$wrist, 0)))
        swing(hand_r, axis=side, by=-($rig_wrist_palm * max($wrist, 0) + $rig_wrist_back * min($wrist, 0)) - $rig_wrist_fold_palm * (-$rig_wrist_a1 * max($wrist, 0) - $rig_wrist_a2 * max($wrist, 0) * max($wrist, 0) + $rig_wrist_b1 * max(-$wrist, 0) + $rig_wrist_b2 * max(-$wrist, 0) * max(-$wrist, 0)))
      }
    } else {
      if ($wrist_side != none) {
        swing(hand_r, axis=fold, by=$rig_wrist_side * $wrist_side)
        swing(hand_r, axis=side, by=-$rig_wrist_fold_palm * $rig_wrist_side * $wrist_side)
      }
    }
  }
}

# =====================================================================================================================
# FASTESTAT (timing, a clip: call it on a build line, A_Claw = $FastestAt(poses=$ClawKeys, at=$Contact, point=$MClaw, effort=200)):
# your poses played at ONE effort across, the point fastest at the pose you name, then the stop. It writes only the engine's words.
#  poses   your pose(steps) list.  at   the pose passed at top speed (not the first or last: a rest).  point   your point() timed.
#  effort  % of the reference speed, one across (20 the Starter's slow end, 600 the claw's fast end).  stop   the speed curve:
#          Preset.FastStop (top late, a hard stop), Preset.Even, Preset.FastStart.
FastestAt = clip(frames=300, poses=none, at=none, point=none, effort=100, effort_min=20, effort_max=600, stop=Preset.FastStop) {
  if ($poses != none) {
    $poses [effort=$effort%, pace=$stop, point=$point, peak_at=$at]
  }
}
