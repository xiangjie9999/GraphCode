  if ($left) { $FootAtCalc1(forward=$forward, out=$out, turnout=$turnout, knee_out=$knee_out, heel=$heel, px=$px, py=$py, pz=$pz, hike=$hike, turn=$turn, rig_s=1, rig_thigh=$rig_thigh_l, rig_shin=$rig_shin_l, rig_ankle_z=$rig_ankle_z_l, rig_hl=$rig_hl_l, rig_vd=$rig_vd_l, rig_heading=$rig_heading_l, rig_he=$rig_he_l, rig_hv=$rig_hv_l, rig_ankle_rest=$rig_ankle_rest_l, rig_toe_raise=$rig_toe_raise_l, rig_toe_azimuth=$rig_toe_azimuth_l, rig_side=0, rig_leg=$rig_leg, rig_hip_width=$rig_hip_width, rig_hip_x=$rig_hip_x, rig_hip_y=$rig_hip_y, rig_pelvis_y=$rig_pelvis_y, rig_pelvis_z=$rig_pelvis_z, rig_hip_up=$rig_hip_up, rig_hip_fwd=$rig_hip_fwd, rig_ankle_room=$rig_ankle_room) }
