$rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))) + ($kx * cos($knee_out) + $rig_s * ($uy * $kz - $uz * $ky) * sin($knee_out)) * sin(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1)))), ty=($uy * cos(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))) + ($ky * cos($knee_out) + $rig_s * ($uz * $kx - $ux * $kz) * sin($knee_out)) * sin(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1)))), tz=($uz * cos(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))) + ($kz * cos($knee_out) + $rig_s * ($ux * $ky - $uy * $kx) * sin($knee_out)) * sin(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1)))), sx=(($d * $ux - $rig_thigh * ($ux * cos(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))) + ($kx * cos($knee_out) + $rig_s * ($uy * $kz - $uz * $ky) * sin($knee_out)) * sin(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))))) / $rig_shin), sy=(($d * $uy - $rig_thigh * ($uy * cos(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))) + ($ky * cos($knee_out) + $rig_s * ($uz * $kx - $ux * $kz) * sin($knee_out)) * sin(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))))) / $rig_shin), sz=(($d * $uz - $rig_thigh * ($uz * cos(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))) + ($kz * cos($knee_out) + $rig_s * ($ux * $ky - $uy * $kx) * sin($knee_out)) * sin(acos(clamp(($rig_thigh * $rig_thigh + min($d, ($rig_thigh + $rig_shin) * 0.99999) * min($d, ($rig_thigh + $rig_shin) * 0.99999) - $rig_shin * $rig_shin) / (2 * $rig_thigh * min($d, ($rig_thigh + $rig_shin) * 0.99999)), -1, 1))))) / $rig_shin), fx=(cos((atan2($rig_vd, $rig_hl) + $heel)) * $hdx), fy=(cos((atan2($rig_vd, $rig_hl) + $heel)) * $hdy), fz=(-sin((atan2($rig_vd, $rig_hl) + $heel))), bx=$rig_s * sin($rig_toe_raise - min($heel, 0)) * sin($rig_toe_azimuth + $turnout), by=sin($rig_toe_raise - min($heel, 0)) * cos($rig_toe_azimuth + $turnout), bz=-cos($rig_toe_raise - min($heel, 0))) }
