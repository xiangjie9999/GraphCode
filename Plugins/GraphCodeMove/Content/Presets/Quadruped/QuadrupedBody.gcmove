ForeAtBlade = pose(b=0.0, px=0.0, py=0.0, pz=0.0, qx=0.0, qy=0.0, qz=0.0, heel=50.0, tilt=0.0, turn=0.0, sg=0.0, kx=0.0, ky=0.0, kz=1.0, rig_vx=0.0, rig_vy=3.0, rig_vz=-5.0, rig_cx=0.0, rig_cy=-5.0, rig_cz=-3.0, rig_mx=0.0, rig_my=0.0, rig_mz=0.0, rig_meta=3.0, rig_heading=0.0, s=1, rig_upper=10.0, rig_fore=9.0, rig_elbow_out=30.0, rig_heel_rest=50.0) {
