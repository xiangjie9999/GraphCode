StanceFore = pose(px=0.0, py=0.0, pz=25.0, qx=0.0, qy=0.0, qz=3.0, heel=none, blade=none, tilt=0.0, turn=0.0, side=0.0, rig_reach=28.4, reach=sqrt(pow($px - $qx, 2) + pow($py - $qy, 2) + pow($pz - $qz, 2)) / $rig_reach, reach_min=0, reach_max=1, left=true, right=true) {
  if ($reach <= 1) { $ForeAt(pivot_x=$px, pivot_y=$py, pivot_z=$pz, paw_x=$qx, paw_y=$qy, heel=$heel, blade=$blade, tilt=$tilt, turn=$turn, side=$side, rig_paw_z_r=$qz, rig_paw_z_l=$qz, left=$left, right=$right) } else {
    $ForeAt(pivot_x=$px, pivot_y=$py, pivot_z=$pz, paw_x=$qx, paw_y=$qy, heel=$heel, blade=$blade, tilt=$tilt, turn=$turn, side=$side, rig_paw_z_r=$qz, rig_paw_z_l=$qz, left=$left, right=$right)
  }
}
