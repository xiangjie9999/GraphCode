}
HindAtPick3 = pose(hip_x=-1.483, hip_y=-11.982, hip_z=none, paw_x=none, paw_y=none, heel=none, rig_side=-1, rig_hip_z=24.128, rig_paw_x=-2.572, rig_paw_y=-17.718, rig_paw_z=5.415, rig_heel=75.7, rig_meta=4.8, rig_meta_in=0.825, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  if ($hip_z != none) { $HindAtPick4(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=$rig_side, rig_paw_x=$rig_paw_x, rig_paw_y=$rig_paw_y, rig_paw_z=$rig_paw_z, rig_heel=$rig_heel, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) } else { $HindAtPick4(hip_x=$hip_x, hip_y=$hip_y, hip_z=$rig_hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=$rig_side, rig_paw_x=$rig_paw_x, rig_paw_y=$rig_paw_y, rig_paw_z=$rig_paw_z, rig_heel=$rig_heel, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) }
}
HindAtPick4 = pose(hip_x=-1.483, hip_y=-11.982, hip_z=24.128, paw_x=none, paw_y=none, heel=none, rig_side=-1, rig_paw_x=-2.572, rig_paw_y=-17.718, rig_paw_z=5.415, rig_heel=75.7, rig_meta=4.8, rig_meta_in=0.825, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  if ($paw_x != none) { $HindAtPick5(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=$rig_side, rig_paw_y=$rig_paw_y, rig_paw_z=$rig_paw_z, rig_heel=$rig_heel, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) } else { $HindAtPick5(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$rig_paw_x, paw_y=$paw_y, heel=$heel, rig_side=$rig_side, rig_paw_y=$rig_paw_y, rig_paw_z=$rig_paw_z, rig_heel=$rig_heel, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) }
}
HindAtPick5 = pose(hip_x=-1.483, hip_y=-11.982, hip_z=24.128, paw_x=-2.572, paw_y=none, heel=none, rig_side=-1, rig_paw_y=-17.718, rig_paw_z=5.415, rig_heel=75.7, rig_meta=4.8, rig_meta_in=0.825, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  if ($paw_y != none) { $HindAtPick6(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=$rig_side, rig_paw_z=$rig_paw_z, rig_heel=$rig_heel, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) } else { $HindAtPick6(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$rig_paw_y, heel=$heel, rig_side=$rig_side, rig_paw_z=$rig_paw_z, rig_heel=$rig_heel, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) }
}
HindAtPick6 = pose(hip_x=-1.483, hip_y=-11.982, hip_z=24.128, paw_x=-2.572, paw_y=-17.718, heel=none, rig_side=-1, rig_paw_z=5.415, rig_heel=75.7, rig_meta=4.8, rig_meta_in=0.825, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  if ($heel != none) { $HindAtSide(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=$rig_side, rig_paw_z=$rig_paw_z, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) } else { $HindAtSide(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$rig_heel, rig_side=$rig_side, rig_paw_z=$rig_paw_z, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) }
}
HindAtSide = pose(hip_x=-1.483, hip_y=-11.982, hip_z=24.128, paw_x=-2.572, paw_y=-17.718, heel=75.7, rig_side=-1, rig_paw_z=5.415, rig_meta=4.8, rig_meta_in=0.825, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  $HindAtLeg(hx=$hip_x, hy=$hip_y, hz=$hip_z, kx=$paw_x + $rig_meta_in * min(1, $rig_meta * cos($heel) / abs($rig_meta_in)), ky=$paw_y - sqrt(max(pow($rig_meta * cos($heel), 2) - pow($rig_meta_in * min(1, $rig_meta * cos($heel) / abs($rig_meta_in)), 2), 0)), kz=$rig_paw_z + $rig_meta * sin($heel), mx=-$rig_meta_in * min(1, $rig_meta * cos($heel) / abs($rig_meta_in)) / $rig_meta, my=sqrt(max(pow($rig_meta * cos($heel), 2) - pow($rig_meta_in * min(1, $rig_meta * cos($heel) / abs($rig_meta_in)), 2), 0)) / $rig_meta, mz=-sin($heel), rig_side=$rig_side, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z)
}
HindAtLeg = pose(hx=-1.483, hy=-11.982, hz=24.128, kx=-1.747, ky=-18.568, kz=10.067, mx=-0.172, my=0.177, mz=-0.969, rig_side=-1, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  $HindAtTurn(ux=($kx - $hx) / sqrt(pow($kx - $hx, 2) + pow($ky - $hy, 2) + pow($kz - $hz, 2)), uy=($ky - $hy) / sqrt(pow($kx - $hx, 2) + pow($ky - $hy, 2) + pow($kz - $hz, 2)), uz=($kz - $hz) / sqrt(pow($kx - $hx, 2) + pow($ky - $hy, 2) + pow($kz - $hz, 2)), d=min(sqrt(pow($kx - $hx, 2) + pow($ky - $hy, 2) + pow($kz - $hz, 2)), ($rig_thigh + $rig_crus) * 0.99999), mx=$mx, my=$my, mz=$mz, rig_side=$rig_side, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z)
}
# (helper of HindAt, not listed) the stifle's swivel round the hip-to-hock line: the one that keeps the leg plane's normal at
# its rest component along the metatarsus (rig_lean: -0.21152 right, 0.29947 left), so the hinged hock reaches it; the rest's
# own swivel (5.88 / -4.81) comes out of it at the rest.
HindAtTurn = pose(ux=-0.017, uy=-0.424, uz=-0.905, d=15.53, mx=-0.172, my=0.177, mz=-0.969, rig_side=-1, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  $HindAtKnee(ux=$ux, uy=$uy, uz=$uz, d=$d, mx=$mx, my=$my, mz=$mz, rig_side=$rig_side, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_swivel=atan2((-(-$uy * $ux * $mx + (1 - $uy * $uy) * $my - $uy * $uz * $mz) / sqrt(1 - $uy * $uy)), (($ux * $mz - $uz * $mx) / sqrt(1 - $uy * $uy))) + acos(clamp($rig_lean / sqrt(pow((($ux * $mz - $uz * $mx) / sqrt(1 - $uy * $uy)), 2) + pow((-(-$uy * $ux * $mx + (1 - $uy * $uy) * $my - $uy * $uz * $mz) / sqrt(1 - $uy * $uy)), 2)), -1, 1)), rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z)
}
HindAtKnee = pose(ux=-0.017, uy=-0.424, uz=-0.905, d=15.53, mx=-0.172, my=0.177, mz=-0.969, rig_side=-1, rig_thigh=9.21, rig_crus=8.789, rig_swivel=5.88, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  $HindAtAim(ux=$ux, uy=$uy, uz=$uz, d=$d, ca=($rig_thigh * $rig_thigh + $d * $d - $rig_crus * $rig_crus) / (2 * $rig_thigh * $d), qx=(-$uy * $ux * cos($rig_swivel) + ($uy * (-$uy * $uz) - $uz * (1 - $uy * $uy)) * sin($rig_swivel)) / sqrt(1 - $uy * $uy), qy=((1 - $uy * $uy) * cos($rig_swivel) + ($uz * (-$uy * $ux) - $ux * (-$uy * $uz)) * sin($rig_swivel)) / sqrt(1 - $uy * $uy), qz=(-$uy * $uz * cos($rig_swivel) + ($ux * (1 - $uy * $uy) - $uy * (-$uy * $ux)) * sin($rig_swivel)) / sqrt(1 - $uy * $uy), mx=$mx, my=$my, mz=$mz, rig_side=$rig_side, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z)
}
HindAtAim = pose(ux=-0.017, uy=-0.424, uz=-0.905, d=15.53, ca=0.87, qx=0.0, qy=0.9, qz=-0.42, mx=-0.172, my=0.177, mz=-0.969, rig_side=-1, rig_thigh=9.21, rig_crus=8.789, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  if ($rig_side < 0) {
    aim(hip_L, from=$ThighL, toward=(down, forward=atan2($uy * $ca + $qy * sqrt(1 - $ca * $ca), -($uz * $ca + $qz * sqrt(1 - $ca * $ca))), left=asin(clamp($ux * $ca + $qx * sqrt(1 - $ca * $ca), -1, 1))))
    aim(stifle_L, from=$ShinL, toward=(down, forward=atan2(($d * $uy - $rig_thigh * ($uy * $ca + $qy * sqrt(1 - $ca * $ca))) / $rig_crus, -($d * $uz - $rig_thigh * ($uz * $ca + $qz * sqrt(1 - $ca * $ca))) / $rig_crus), left=asin(clamp(($d * $ux - $rig_thigh * ($ux * $ca + $qx * sqrt(1 - $ca * $ca))) / $rig_crus, -1, 1))))
    aim(hock_L, from=$MetaL, toward=(down, forward=atan2($my, -$mz), left=asin(clamp($mx, -1, 1))))
    aim(paw_B_L, from=$ToesL, toward=(down, forward=atan2($rig_toe_y, -$rig_toe_z), left=asin(clamp($rig_toe_x, -1, 1))))
  } else {
    aim(hip_R, from=$ThighR, toward=(down, forward=atan2($uy * $ca + $qy * sqrt(1 - $ca * $ca), -($uz * $ca + $qz * sqrt(1 - $ca * $ca))), left=asin(clamp($ux * $ca + $qx * sqrt(1 - $ca * $ca), -1, 1))))
    aim(stifle_R, from=$ShinR, toward=(down, forward=atan2(($d * $uy - $rig_thigh * ($uy * $ca + $qy * sqrt(1 - $ca * $ca))) / $rig_crus, -($d * $uz - $rig_thigh * ($uz * $ca + $qz * sqrt(1 - $ca * $ca))) / $rig_crus), left=asin(clamp(($d * $ux - $rig_thigh * ($ux * $ca + $qx * sqrt(1 - $ca * $ca))) / $rig_crus, -1, 1))))
    aim(hock_R, from=$MetaR, toward=(down, forward=atan2($my, -$mz), left=asin(clamp($mx, -1, 1))))
    aim(paw_B_R, from=$ToesR, toward=(down, forward=atan2($rig_toe_y, -$rig_toe_z), left=asin(clamp($rig_toe_x, -1, 1))))
  }
}

# HINDREACH (second layer, sided: calls only Thigh and Shin; the human LegReach): a lifted hind leg along a line from the hip
# joint to the HOCK, and how far out.
#  raise, azimuth  the line's direction, the pair rule (azimuth alone takes the rest line's raise, rig_rest_raise_r/_l 25.1 /
#            19.8). Neither written: nothing asked. Right = the figure's right = this cat's _L bones.
#  reach     the hock's distance along that line as a share of thigh + crus (rig_thigh_*, rig_crus_*: 17.999 right, 17.969 left): 1
#            straight. Range reach_min 0.25 .. reach_max 1; the stifle's 16 stop ends it at 0.990 (the build says so at 1).
#  swivel    degrees the stifle is swung round the line, 0 = its natural fold side: the stifle toward the figure's FORWARD
#            whatever way the line points (a line straight forward: up), + out. Range -30..30. HindAt keeps the rest's ~5 degrees
#            medial (5.88 right, 4.81 left), so the two can differ by that much on one line.
#  Arithmetic: LegReach's two-bone sum, per side with that side's lengths, its knee zero as above. The paw is HindPaw's.
#  Worked values (built): the design's trot $HindReach(raise=30, azimuth=180, reach=0.95, left=false) -> line 30.00 /
#              179.95, reach 0.950; a forward line $HindReach(raise=15, azimuth=0, reach=max, right=false) -> 7.27 / -2.04, reach
#              0.990 (the stifle's 16 stop, said), as before the knee's zero moved. A line above level meets the hip's stops (raise 100:
#              "'hip_L' ... short").
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
HindReach = pose(raise=none, raise_min=0, raise_max=180, azimuth=0 * $raise, azimuth_min=-180, azimuth_max=180, reach=1.0, reach_min=0.25, reach_max=1, swivel=0.0, swivel_min=-30, swivel_max=30, left=true, right=true, rig_thigh_l=9.394, rig_crus_l=8.575, rig_thigh_r=9.210, rig_crus_r=8.789, rig_rest_raise_l=19.8, rig_rest_raise_r=25.1) {
  if ($left) { $HindReachSide(raise=$raise, azimuth=$azimuth, reach=$reach, swivel=$swivel, rig_thigh=$rig_thigh_l, rig_crus=$rig_crus_l, rig_rest_raise=$rig_rest_raise_l, right=false) }
  if ($right) { $HindReachSide(raise=$raise, azimuth=$azimuth, reach=$reach, swivel=$swivel, rig_thigh=$rig_thigh_r, rig_crus=$rig_crus_r, rig_rest_raise=$rig_rest_raise_r, left=false) }
}
HindReachSide = pose(raise=none, azimuth=0 * $raise, reach=1.0, swivel=0.0, rig_thigh=9.21, rig_crus=8.789, rig_rest_raise=25.1, left=true, right=true) {
  if ($raise != none) {
    if ($azimuth != none) {
      $HindReachKnee(raise=$raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_thigh + $rig_crus), ca=($rig_thigh * $rig_thigh + pow($reach * ($rig_thigh + $rig_crus), 2) - $rig_crus * $rig_crus) / (2 * $rig_thigh * $reach * ($rig_thigh + $rig_crus)), rig_thigh=$rig_thigh, left=$left, right=$right)
    } else {
      $HindReachKnee(raise=$raise, azimuth=0, swivel=$swivel, d=$reach * ($rig_thigh + $rig_crus), ca=($rig_thigh * $rig_thigh + pow($reach * ($rig_thigh + $rig_crus), 2) - $rig_crus * $rig_crus) / (2 * $rig_thigh * $reach * ($rig_thigh + $rig_crus)), rig_thigh=$rig_thigh, left=$left, right=$right)
    }
  } else {
    if ($azimuth != none) {
      $HindReachKnee(raise=$rig_rest_raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_thigh + $rig_crus), ca=($rig_thigh * $rig_thigh + pow($reach * ($rig_thigh + $rig_crus), 2) - $rig_crus * $rig_crus) / (2 * $rig_thigh * $reach * ($rig_thigh + $rig_crus)), rig_thigh=$rig_thigh, left=$left, right=$right)
    }
  }
}
HindReachKnee = pose(raise=90.0, azimuth=0.0, swivel=0.0, d=10.0, ca=0.7, rig_thigh=9.21, left=true, right=true) {
  $HindReachBend(lx=sin($raise) * sin($azimuth), ly=sin($raise) * cos($azimuth), lz=-cos($raise), kx=(-(sin($raise) * cos($azimuth)) * (sin($raise) * sin($azimuth)) - 0.001 * (-cos($raise)) * (sin($raise) * sin($azimuth))) / sqrt(pow((-(sin($raise) * cos($azimuth)) * (sin($raise) * sin($azimuth)) - 0.001 * (-cos($raise)) * (sin($raise) * sin($azimuth))), 2) + pow((1 - pow(sin($raise) * cos($azimuth), 2) - 0.001 * (-cos($raise)) * (sin($raise) * cos($azimuth))), 2) + pow((-(sin($raise) * cos($azimuth)) * (-cos($raise)) + 0.001 * (1 - pow(-cos($raise), 2))), 2)), ky=(1 - pow(sin($raise) * cos($azimuth), 2) - 0.001 * (-cos($raise)) * (sin($raise) * cos($azimuth))) / sqrt(pow((-(sin($raise) * cos($azimuth)) * (sin($raise) * sin($azimuth)) - 0.001 * (-cos($raise)) * (sin($raise) * sin($azimuth))), 2) + pow((1 - pow(sin($raise) * cos($azimuth), 2) - 0.001 * (-cos($raise)) * (sin($raise) * cos($azimuth))), 2) + pow((-(sin($raise) * cos($azimuth)) * (-cos($raise)) + 0.001 * (1 - pow(-cos($raise), 2))), 2)), kz=(-(sin($raise) * cos($azimuth)) * (-cos($raise)) + 0.001 * (1 - pow(-cos($raise), 2))) / sqrt(pow((-(sin($raise) * cos($azimuth)) * (sin($raise) * sin($azimuth)) - 0.001 * (-cos($raise)) * (sin($raise) * sin($azimuth))), 2) + pow((1 - pow(sin($raise) * cos($azimuth), 2) - 0.001 * (-cos($raise)) * (sin($raise) * cos($azimuth))), 2) + pow((-(sin($raise) * cos($azimuth)) * (-cos($raise)) + 0.001 * (1 - pow(-cos($raise), 2))), 2)), swivel=$swivel, d=$d, ca=$ca, rig_thigh=$rig_thigh, left=$left, right=$right)
}
# (helper of HindReach, not listed) the thigh's direction: ca along the line, the rest toward the knee's side swung by swivel
# (+ out); the hock's place along the line.
HindReachBend = pose(lx=0.0, ly=0.5, lz=-0.87, kx=0.0, ky=0.87, kz=0.5, swivel=0.0, d=10.0, ca=0.7, rig_thigh=9.21, left=true, right=true) {
  $HindReachAim(ux=$ca * $lx + sqrt(1 - $ca * $ca + 0.000000001) * ($kx * cos($swivel) + ($ly * $kz - $lz * $ky) * sin($swivel)), uy=$ca * $ly + sqrt(1 - $ca * $ca + 0.000000001) * ($ky * cos($swivel) + ($lz * $kx - $lx * $kz) * sin($swivel)), uz=$ca * $lz + sqrt(1 - $ca * $ca + 0.000000001) * ($kz * cos($swivel) + ($lx * $ky - $ly * $kx) * sin($swivel)), wx=$d * $lx, wy=$d * $ly, wz=$d * $lz, rig_thigh=$rig_thigh, left=$left, right=$right)
}
HindReachAim = pose(ux=0.0, uy=0.7, uz=-0.7, wx=0.0, wy=10.0, wz=0.0, rig_thigh=9.21, left=true, right=true) {
  $Thigh(raise=atan2(sqrt($ux * $ux + $uy * $uy), -$uz), azimuth=atan2($ux, $uy), left=$left, right=$right)
  $Shin(raise=atan2(sqrt(pow($wx - $rig_thigh * $ux, 2) + pow($wy - $rig_thigh * $uy, 2)), $rig_thigh * $uz - $wz), azimuth=atan2($wx - $rig_thigh * $ux, $wy - $rig_thigh * $uy), left=$left, right=$right)
}

# #####################################################################################################################
# THE FORE LEG (sided): UpperArm, Forearm, ForePaw, ForeAt (first layer); ForeReach (second layer). The fore leg is the human
# arm with the scapula (the blade) in place of the collar bone: scapula_*, shoulder_*, elbow_*, wrist_*, paw_F_*.
# #####################################################################################################################
# =====================================================================================================================
# UPPERARM (first layer, sided): where the upper arm (shoulder joint to elbow, bone shoulder_*) points, and the blade (scapula_*)
# with it: the human UpperArm, the blade in place of the collar bone.
#  raise, azimuth  where the upper arm points, absolute in the figure's frame. Either one written asks the direction: raise alone
#            takes azimuth 0, azimuth alone the rest raise (rig_rest_raise 3.63, the mean of 4.06 / 3.20). Neither: not asked.
#            Measured: every direction asked built exact. raise_max 100 (-> 100.00 / -0.00, the blade following to -1): at 120 forward
#            the elbow went into the head (self-collision 'head' / 'elbow_L' 2.27 cm, refused), so the end is the head's.
#  blade     -1..1: 1 the scapula at its back stop (38: the shoulder joint carried back), -1 at its forward stop (-40), 0 rest.
#            Not written, follows the upper arm: rig_blade_share (0.5) of the upper arm's fore-aft swing from its rest
#            (rig_rest_swing -1.64, the two sides' mean of -0.19 / -3.08), forward swing -> blade forward (Rahmati 2024: the line
#            sweeps ~72, the shoulder joint ~37), on the stops' scale, clamped -1..1. raise not written: blade not asked.
#  left, right   sides.   rig_blade_back, rig_blade_forward   the scapula's stops (38, 40).
#  Worked values (built, readings): $UpperArm(raise=60, left=false) -> 60.00 / -0.00, blade followed -0.7705 (scapula
#            -30.82); $UpperArm(raise=30, azimuth=180, right=false) -> 30.00 / 180.00, blade 0.373 (14.18); ends raise=max 100.00,
#            raise=min 0.00, blade=max alone 38.000 (the upper arm rides it), blade=min -40.000.
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
UpperArm = pose(raise=none, raise_min=0, raise_max=100, azimuth=0 * $raise, azimuth_min=-180, azimuth_max=180, blade=clamp(max(-$rig_blade_share * (atan2(sin($raise) * cos($azimuth), cos($raise)) - $rig_rest_swing), 0) / $rig_blade_back + min(-$rig_blade_share * (atan2(sin($raise) * cos($azimuth), cos($raise)) - $rig_rest_swing), 0) / $rig_blade_forward, -1, 1), blade_min=-1, blade_max=1, left=true, right=true, rig_rest_raise=3.63, rig_rest_swing=-1.64, rig_blade_share=0.5, rig_blade_back=38, rig_blade_forward=40) {
  if ($blade != none) {
    if ($right) { swing(scapula_L, axis=fold, by=max($blade, 0) * $rig_blade_back + min($blade, 0) * $rig_blade_forward) }
    if ($left) { swing(scapula_R, axis=fold, by=max($blade, 0) * $rig_blade_back + min($blade, 0) * $rig_blade_forward) }
  }
  if ($raise != none) {
    if ($azimuth != none) {
      $UpperArmDir(raise=$raise, azimuth=$azimuth, left=$left, right=$right)
    } else {
      $UpperArmDir(raise=$raise, azimuth=0, left=$left, right=$right)
    }
  } else {
    if ($azimuth != none) {
      $UpperArmDir(raise=$rig_rest_raise, azimuth=$azimuth, left=$left, right=$right)
    }
  }
}
# (helper of UpperArm, not listed) the aim, each side in its own block; the left line carries the flip (left=). right = the figure's
# right, the build's -X, where the _L bones stand.
UpperArmDir = pose(raise=0.0, azimuth=0.0, left=true, right=true) {
  if ($right) { aim(shoulder_L, from=$UpperArmFL, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), right=asin(sin($raise) * sin($azimuth))), relative=character) }
  if ($left) { aim(shoulder_R, from=$UpperArmFR, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), left=asin(sin($raise) * sin($azimuth))), relative=character) }
}

# FOREARM (first layer, sided): where the forearm (elbow to wrist, bone elbow_*) points, absolute (not counted from the upper arm):
# the human Forearm without palm. The pair rule as UpperArm's (azimuth alone takes rig_rest_raise 15.85, the mean of 15.29 / 16.40).
# Neither: the forearm rides the upper arm. The elbow is a hinge (its fold and the forearm's own turn), so the direction is met
# where the elbow's fold and the shoulder's turn about the upper arm bring it; elsewhere the build says how far short.
#  Worked values (built, the upper arm at (30, 180)): $Forearm(raise=40, left=false) -> 40.01 / -0.10; $Forearm(raise=60,
#            azimuth=-20, right=false) -> 60.03 / -20.11. Ends, said by the build: raise=max (120) reads 121.3 / -18.3 ('elbow_L'
#            15.8 short: the hinge's plane); raise=min (0) under a resting upper arm reads 11.3 (the elbow's straight stop, 11.3
#            short); 180 was refused on self-collision (the paw 2.53 cm into the chest), hence 120. azimuth=max / min at raise 60
#            point the forearm behind the upper arm: the elbow cannot open past straight (67.5 / 66.1 short).
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
Forearm = pose(raise=none, raise_min=0, raise_max=120, azimuth=0 * $raise, azimuth_min=-180, azimuth_max=180, left=true, right=true, rig_rest_raise=15.85) {
  if ($raise != none) {
    if ($azimuth != none) {
      $ForearmDir(raise=$raise, azimuth=$azimuth, left=$left, right=$right)
    } else {
      $ForearmDir(raise=$raise, azimuth=0, left=$left, right=$right)
    }
  } else {
    if ($azimuth != none) {
      $ForearmDir(raise=$rig_rest_raise, azimuth=$azimuth, left=$left, right=$right)
    }
  }
}
# (helper of Forearm, not listed) the aim, a block per side.
ForearmDir = pose(raise=0.0, azimuth=0.0, left=true, right=true) {
  if ($right) { aim(elbow_L, from=$ForearmFL, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), right=asin(sin($raise) * sin($azimuth))), relative=character) }
  if ($left) { aim(elbow_R, from=$ForearmFR, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), left=asin(sin($raise) * sin($azimuth))), relative=character) }
}

# FOREPAW (first layer, sided): a FREE forepaw, the wrist (carpus, bone wrist_*) and the toes (paw_F_*), as turns from the rest:
# the human Foot's words without ankle_roll. A PLANTED forepaw is ForeAt's; ForePaw and ForeAt do not both write one paw.
#  point     degrees from the wrist's rest bend: + folds the paw back under the forearm (palmar flexion; a relaxed lifted paw about
#            50), below 0 cocked forward. It is the wrist's fold NEGATIVE. Not written: not asked.
#  toes_up   degrees, + the toes bent up at the paw joint, below 0 curled down. Not written: not asked.
#  The ranges are the IK rig's own wrist and toe stops on the reading (wrist -99..61 / -113..47, toes -72..78 / -70..80; the
#  .gcrig's -80..80 and -40..110 are not what the build holds) less each side's rest reading (wrist 4.67 / -9.49, toes -0.98 /
#  1.08): point -56.8 .. 103.2, toes_up -70.6 .. 79.4, the same on both sides to 0.1.
#  Worked values (built): $ForePaw(point=50, left=false) -> the wrist exactly 50 from rest (-45.327); the ends on both sides:
#            point=min / max and toes_up=min / max each within 0.4 of asked (the build names the 0.3-0.4 it clamps).
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
ForePaw = pose(point=none, point_min=-56.8, point_max=103.2, toes_up=none, toes_up_min=-70.6, toes_up_max=79.4, left=true, right=true) {
  if ($point != none) {
    if ($right) { swing(wrist_L, axis=fold, by=-$point) }
    if ($left) { swing(wrist_R, axis=fold, by=-$point) }
  }
  if ($toes_up != none) {
    if ($right) { swing(paw_F_L, axis=fold, by=$toes_up) }
    if ($left) { swing(paw_F_R, axis=fold, by=$toes_up) }
  }
}

# =====================================================================================================================
# FOREAT (first layer, sided): a PLANTED forepaw, POSED by arithmetic (no plant, reach or balance), the human FootAt with the paw
# joint fixed: the blade swung by blade, the metacarpus standing at heel from the paw joint, the upper arm and forearm by the
# two-bone arithmetic from the shoulder joint to the wrist, the elbow BEHIND the line, the toes counter-folded to keep their rest
# lie. Called by Stance with the places it works out; called alone it stands the paw on its rest footprint.
#  pivot_x, pivot_y, pivot_z   the blade's pivot (scapula_*'s point) in the figure's frame, cm. paw_x, paw_y   where the paw joint
#            stands on the floor, cm (its height stays the rest's, rig_paw_z 4.094 / 3.742). The five are ONE side's places, written
#            together with left=false or right=false (Stance writes all five); not written, that side's rest (built).
#  heel      the metacarpus' angle from the floor, degrees, the paw turning about its paw joint: 0 the wrist on the floor, 90 upright.
#            Not written: that leg's rest (rig_heel 47.46 / 54.55), so the paw stands on its toes as the cat does.
#  blade     -1..1 as UpperArm's (38 back, 40 forward). Not written, follows the leg's line: rig_blade_share (0.5) of the pivot-to-paw
#            line's fore-aft swing from its rest (rig_line 15.71 / 13.45), counted against the chest (so + tilt), forward -> blade
#            forward, held to the stops.
#  tilt      GAP (the file's head, the fore leg): the chest's pitch from its rest, + front down, degrees, passed by Stance. Default 0.
#  turn, side   the chest's turn (Hips' turn, about the vertical) and side bend (Back's side), degrees, + to the figure's right,
#            passed by Stance with tilt: the blade's place is worked in the chest as it stands, turned, bent, pitched.
#            Not written: 0. rig_side_rate, rig_side_a*   Back's side 5 turned the chest 12.09 about (0.052, -0.309, 0.950)
#            (fitted to 0.0003 cm over both blades), so side turns it rig_side_rate (2.4172) a degree about that axis.
#  rig_*_l / rig_*_r   each leg's rest: the pivot, the paw joint and its height, the pivot-to-shoulder vector rig_v, the blade's
#            fold axis worked into rig_c (its cross with rig_v) and rig_m (rig_v's part along it) from 20-degree swings on the test cat
#            (left axis (-0.986, -0.006, 0.164), right (-0.998, 0.064, 0.002)), the metacarpus' length, heading and heel, the upper
#            arm and forearm lengths, the rest line, and rig_elbow_out (31.6 / 29.1): the rest elbow's turn out from straight behind.
#  Reach: nothing holds the paw. Where the wrist lies past rig_upper + rig_fore (19.10 / 19.81) from the shoulder joint the forearm
#  points at it and the paw floats; Stance's reach shares say so.
#  Worked values (built): $ForeAt -> the rest: paw joints (-0.945, 18.423, 4.095) / (7.000, 18.652, 3.742) against
