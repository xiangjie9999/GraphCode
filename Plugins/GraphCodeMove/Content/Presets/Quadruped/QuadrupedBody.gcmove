# turned the chest 12.09 about (0.052, -0.309, 0.950)).
ForeAtChest = pose(b=0.0, px=0.0, py=0.0, pz=0.0, vx=0.0, vy=3.0, vz=-5.0, tilt=0.0, turn=0.0, sg=0.0, kx=0.0, ky=0.0, kz=1.0, wx=0.0, wy=0.0, wz=0.0, mx=0.0, my=0.5, mz=-0.8, toe=0.0, s=1, rig_upper=10.0, rig_fore=9.0, rig_elbow_out=30.0) {
  $ForeAtTurn(b=$b, px=$px, py=$py, pz=$pz, ux=$vx * cos($sg) + ($ky * $vz - $kz * $vy) * sin($sg) + $kx * ($kx * $vx + $ky * $vy + $kz * $vz) * (1 - cos($sg)), uy=$vy * cos($sg) + ($kz * $vx - $kx * $vz) * sin($sg) + $ky * ($kx * $vx + $ky * $vy + $kz * $vz) * (1 - cos($sg)), uz=$vz * cos($sg) + ($kx * $vy - $ky * $vx) * sin($sg) + $kz * ($kx * $vx + $ky * $vy + $kz * $vz) * (1 - cos($sg)), tilt=$tilt, turn=$turn, wx=$wx, wy=$wy, wz=$wz, mx=$mx, my=$my, mz=$mz, toe=$toe, s=$s, rig_upper=$rig_upper, rig_fore=$rig_fore, rig_elbow_out=$rig_elbow_out)
}
# (helper of ForeAt, not listed) then the chest's pitch (tilt, about the figure's right axis) and its turn about the vertical: the
# shoulder joint's place.
ForeAtTurn = pose(b=0.0, px=0.0, py=0.0, pz=0.0, ux=0.0, uy=3.0, uz=-5.0, tilt=0.0, turn=0.0, wx=0.0, wy=0.0, wz=0.0, mx=0.0, my=0.5, mz=-0.8, toe=0.0, s=1, rig_upper=10.0, rig_fore=9.0, rig_elbow_out=30.0) {
  $ForeAtLine(b=$b, sx=$px + $ux * cos($turn) - ($uy * cos($tilt) + $uz * sin($tilt)) * sin($turn), sy=$py + $ux * sin($turn) + ($uy * cos($tilt) + $uz * sin($tilt)) * cos($turn), sz=$pz - $uy * sin($tilt) + $uz * cos($tilt), wx=$wx, wy=$wy, wz=$wz, mx=$mx, my=$my, mz=$mz, toe=$toe, s=$s, rig_upper=$rig_upper, rig_fore=$rig_fore, rig_elbow_out=$rig_elbow_out)
}
# (helper of ForeAt, not listed) the line from the shoulder joint to the wrist: its direction, its length, the elbow's angle to it.
ForeAtLine = pose(b=0.0, sx=0.0, sy=0.0, sz=20.0, wx=0.0, wy=0.0, wz=0.0, mx=0.0, my=0.5, mz=-0.8, toe=0.0, s=1, rig_upper=10.0, rig_fore=9.0, rig_elbow_out=30.0) {
  $ForeAtBend(b=$b, dx=($wx - $sx) / sqrt(pow($wx - $sx, 2) + pow($wy - $sy, 2) + pow($wz - $sz, 2)), dy=($wy - $sy) / sqrt(pow($wx - $sx, 2) + pow($wy - $sy, 2) + pow($wz - $sz, 2)), dz=($wz - $sz) / sqrt(pow($wx - $sx, 2) + pow($wy - $sy, 2) + pow($wz - $sz, 2)), d=sqrt(pow($wx - $sx, 2) + pow($wy - $sy, 2) + pow($wz - $sz, 2)), ca=clamp(($rig_upper * $rig_upper + min(sqrt(pow($wx - $sx, 2) + pow($wy - $sy, 2) + pow($wz - $sz, 2)), ($rig_upper + $rig_fore) * 0.99999) * min(sqrt(pow($wx - $sx, 2) + pow($wy - $sy, 2) + pow($wz - $sz, 2)), ($rig_upper + $rig_fore) * 0.99999) - $rig_fore * $rig_fore) / (2 * $rig_upper * min(sqrt(pow($wx - $sx, 2) + pow($wy - $sy, 2) + pow($wz - $sz, 2)), ($rig_upper + $rig_fore) * 0.99999)), -1, 1), mx=$mx, my=$my, mz=$mz, toe=$toe, s=$s, rig_upper=$rig_upper, rig_elbow_out=$rig_elbow_out)
}
# (helper of ForeAt, not listed) the elbow BEHIND the line (the figure's back square to it), turned out to its own side by
# rig_elbow_out (the rest bend's); the upper arm's direction u and the forearm's (the wrist less the elbow).
ForeAtBend = pose(b=0.0, dx=0.0, dy=0.0, dz=-1.0, d=18.0, ca=0.9, mx=0.0, my=0.5, mz=-0.8, toe=0.0, s=1, rig_upper=10.0, rig_elbow_out=30.0) {
  $ForeAtAim(b=$b, ux=($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($rig_elbow_out) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($rig_elbow_out) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001))), uy=($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($rig_elbow_out) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001))), uz=($ca * $dz + sqrt(1 - $ca * $ca + 0.000000001) * (cos($rig_elbow_out) * $dy * $dz / sqrt(1 - $dy * $dy + 0.000000001) + sin($rig_elbow_out) * $s * $dx / sqrt(1 - $dy * $dy + 0.000000001))), fx=$d * $dx - $rig_upper * ($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($rig_elbow_out) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($rig_elbow_out) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001))), fy=$d * $dy - $rig_upper * ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($rig_elbow_out) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001))), fz=$d * $dz - $rig_upper * ($ca * $dz + sqrt(1 - $ca * $ca + 0.000000001) * (cos($rig_elbow_out) * $dy * $dz / sqrt(1 - $dy * $dy + 0.000000001) + sin($rig_elbow_out) * $s * $dx / sqrt(1 - $dy * $dy + 0.000000001))), mx=$mx, my=$my, mz=$mz, toe=$toe, s=$s)
}
# (helper of ForeAt, not listed) the blade's swing, the three aims in the figure's frame and the toes' counter-fold.
ForeAtAim = pose(b=0.0, ux=0.0, uy=0.0, uz=-1.0, fx=0.0, fy=0.0, fz=-1.0, mx=0.0, my=0.5, mz=-0.8, toe=0.0, s=1) {
  if ($s > 0) {
    swing(scapula_R, axis=fold, by=$b)
    aim(shoulder_R, from=$UpperArmFR, toward=(down, forward=atan2($uy, -$uz), left=asin(clamp($ux / sqrt($ux * $ux + $uy * $uy + $uz * $uz), -1, 1))), relative=character)
    aim(elbow_R, from=$ForearmFR, toward=(down, forward=atan2($fy, -$fz), left=asin(clamp($fx / sqrt($fx * $fx + $fy * $fy + $fz * $fz), -1, 1))), relative=character)
    aim(wrist_R, from=$MetaFR, toward=(down, forward=atan2($my, -$mz), left=asin(clamp($mx / sqrt($mx * $mx + $my * $my + $mz * $mz), -1, 1))), relative=character)
    swing(paw_F_R, axis=fold, by=$toe)
  }
  if ($s < 0) {
    swing(scapula_L, axis=fold, by=$b)
    aim(shoulder_L, from=$UpperArmFL, toward=(down, forward=atan2($uy, -$uz), left=asin(clamp($ux / sqrt($ux * $ux + $uy * $uy + $uz * $uz), -1, 1))), relative=character)
    aim(elbow_L, from=$ForearmFL, toward=(down, forward=atan2($fy, -$fz), left=asin(clamp($fx / sqrt($fx * $fx + $fy * $fy + $fz * $fz), -1, 1))), relative=character)
    aim(wrist_L, from=$MetaFL, toward=(down, forward=atan2($my, -$mz), left=asin(clamp($mx / sqrt($mx * $mx + $my * $my + $mz * $mz), -1, 1))), relative=character)
    swing(paw_F_L, axis=fold, by=$toe)
  }
}

# =====================================================================================================================
# FOREREACH (second layer, sided: calls only UpperArm and Forearm): the human ArmReach, a fore leg along a line from the shoulder
# joint to the wrist and how far out. For a lifted leg beside a Stance the shoulder joint stands where the trunk put it.
#  raise, azimuth  the direction from the shoulder joint to the wrist; the pair rule (azimuth alone takes rig_rest_raise 7.07, the
#            rest line's mean of 6.51 / 7.63). Neither written: no line asked (blade still passes on).
#  reach     the wrist's distance along that line as a share of the two long bones (rig_upper + rig_fore, 19.10 / 19.81).
#            Measured: reach_max (and the default) 0.995, the elbow's straight stop (reading -0.5): -> 19.000 cm (asked 19.006), line
#            30.14 / -1.19; reach_min 0.22, its fold stop (148.5): 0.21 read 4.389 cm (asked 4.160), so the end is 0.22.
#            A line within a few degrees of level straight ahead or behind has no 'behind' square to it, so raise ends at 85.
#  swivel    degrees the elbow is swung round the line from straight BEHIND it (the figure's back, square to the line: for a
#            hanging leg the same as ArmReach's lowest), + out to its own side; default 0.
#  blade     passed to UpperArm (not written: it follows the upper arm there).   left, right   sides.
#  Worked values (built): the design's trot fore lines (CatGait's 'right fore lifted' is the figure's LEFT leg, the _R bones,
#            ) $ForeReach(raise=25, azimuth=180, reach=0.9, left=false) $ForePaw(point=50, left=false) -> line 25.00 /
#            -179.90, 17.191 cm (asked 17.19), wrist -45.327; $ForeReach(raise=55, azimuth=15, reach=0.65, right=false) -> 55.04 /
#            15.14, 12.879 (12.875). Ends: raise=max 85 -> 84.99 / 0.10; raise=min -> 0.07; azimuth=min (-180, raise 40, blade 0.5)
#            -> 39.99 / -179.89; swivel=max 30 -> line 30.02 / 0.09; swivel=min -30 -> 31.43 / -3.91 ('elbow_R' 3.8 short).
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
ForeReach = pose(raise=none, raise_min=0, raise_max=85, azimuth=0 * $raise, azimuth_min=-180, azimuth_max=180, reach=0.995, reach_min=0.22, reach_max=0.995, swivel=0.0, swivel_min=-30, swivel_max=30, blade=none, blade_min=-1, blade_max=1, left=true, right=true, rig_upper_l=10.771, rig_fore_l=9.037, rig_upper_r=10.386, rig_fore_r=8.716, rig_rest_raise=7.07) {
  if ($raise != none) {
    if ($azimuth != none) {
      if ($left) { if ($blade != none) { $ForeReachLine(raise=$raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_upper_l + $rig_fore_l), ca=($rig_upper_l * $rig_upper_l + pow($reach * ($rig_upper_l + $rig_fore_l), 2) - $rig_fore_l * $rig_fore_l) / (2 * $rig_upper_l * $reach * ($rig_upper_l + $rig_fore_l)), s=1, rig_upper=$rig_upper_l, left=true, right=false, blade=$blade) } else { $ForeReachLine(raise=$raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_upper_l + $rig_fore_l), ca=($rig_upper_l * $rig_upper_l + pow($reach * ($rig_upper_l + $rig_fore_l), 2) - $rig_fore_l * $rig_fore_l) / (2 * $rig_upper_l * $reach * ($rig_upper_l + $rig_fore_l)), s=1, rig_upper=$rig_upper_l, left=true, right=false) } }
      if ($right) { if ($blade != none) { $ForeReachLine(raise=$raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_upper_r + $rig_fore_r), ca=($rig_upper_r * $rig_upper_r + pow($reach * ($rig_upper_r + $rig_fore_r), 2) - $rig_fore_r * $rig_fore_r) / (2 * $rig_upper_r * $reach * ($rig_upper_r + $rig_fore_r)), s=-1, rig_upper=$rig_upper_r, left=false, right=true, blade=$blade) } else { $ForeReachLine(raise=$raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_upper_r + $rig_fore_r), ca=($rig_upper_r * $rig_upper_r + pow($reach * ($rig_upper_r + $rig_fore_r), 2) - $rig_fore_r * $rig_fore_r) / (2 * $rig_upper_r * $reach * ($rig_upper_r + $rig_fore_r)), s=-1, rig_upper=$rig_upper_r, left=false, right=true) } }
    } else {
      if ($left) { if ($blade != none) { $ForeReachLine(raise=$raise, azimuth=0, swivel=$swivel, d=$reach * ($rig_upper_l + $rig_fore_l), ca=($rig_upper_l * $rig_upper_l + pow($reach * ($rig_upper_l + $rig_fore_l), 2) - $rig_fore_l * $rig_fore_l) / (2 * $rig_upper_l * $reach * ($rig_upper_l + $rig_fore_l)), s=1, rig_upper=$rig_upper_l, left=true, right=false, blade=$blade) } else { $ForeReachLine(raise=$raise, azimuth=0, swivel=$swivel, d=$reach * ($rig_upper_l + $rig_fore_l), ca=($rig_upper_l * $rig_upper_l + pow($reach * ($rig_upper_l + $rig_fore_l), 2) - $rig_fore_l * $rig_fore_l) / (2 * $rig_upper_l * $reach * ($rig_upper_l + $rig_fore_l)), s=1, rig_upper=$rig_upper_l, left=true, right=false) } }
      if ($right) { if ($blade != none) { $ForeReachLine(raise=$raise, azimuth=0, swivel=$swivel, d=$reach * ($rig_upper_r + $rig_fore_r), ca=($rig_upper_r * $rig_upper_r + pow($reach * ($rig_upper_r + $rig_fore_r), 2) - $rig_fore_r * $rig_fore_r) / (2 * $rig_upper_r * $reach * ($rig_upper_r + $rig_fore_r)), s=-1, rig_upper=$rig_upper_r, left=false, right=true, blade=$blade) } else { $ForeReachLine(raise=$raise, azimuth=0, swivel=$swivel, d=$reach * ($rig_upper_r + $rig_fore_r), ca=($rig_upper_r * $rig_upper_r + pow($reach * ($rig_upper_r + $rig_fore_r), 2) - $rig_fore_r * $rig_fore_r) / (2 * $rig_upper_r * $reach * ($rig_upper_r + $rig_fore_r)), s=-1, rig_upper=$rig_upper_r, left=false, right=true) } }
    }
  } else {
    if ($azimuth != none) {
      if ($left) { if ($blade != none) { $ForeReachLine(raise=$rig_rest_raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_upper_l + $rig_fore_l), ca=($rig_upper_l * $rig_upper_l + pow($reach * ($rig_upper_l + $rig_fore_l), 2) - $rig_fore_l * $rig_fore_l) / (2 * $rig_upper_l * $reach * ($rig_upper_l + $rig_fore_l)), s=1, rig_upper=$rig_upper_l, left=true, right=false, blade=$blade) } else { $ForeReachLine(raise=$rig_rest_raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_upper_l + $rig_fore_l), ca=($rig_upper_l * $rig_upper_l + pow($reach * ($rig_upper_l + $rig_fore_l), 2) - $rig_fore_l * $rig_fore_l) / (2 * $rig_upper_l * $reach * ($rig_upper_l + $rig_fore_l)), s=1, rig_upper=$rig_upper_l, left=true, right=false) } }
      if ($right) { if ($blade != none) { $ForeReachLine(raise=$rig_rest_raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_upper_r + $rig_fore_r), ca=($rig_upper_r * $rig_upper_r + pow($reach * ($rig_upper_r + $rig_fore_r), 2) - $rig_fore_r * $rig_fore_r) / (2 * $rig_upper_r * $reach * ($rig_upper_r + $rig_fore_r)), s=-1, rig_upper=$rig_upper_r, left=false, right=true, blade=$blade) } else { $ForeReachLine(raise=$rig_rest_raise, azimuth=$azimuth, swivel=$swivel, d=$reach * ($rig_upper_r + $rig_fore_r), ca=($rig_upper_r * $rig_upper_r + pow($reach * ($rig_upper_r + $rig_fore_r), 2) - $rig_fore_r * $rig_fore_r) / (2 * $rig_upper_r * $reach * ($rig_upper_r + $rig_fore_r)), s=-1, rig_upper=$rig_upper_r, left=false, right=true) } }
    } else {
      if ($blade != none) { $UpperArm(blade=$blade, left=$left, right=$right) }
    }
  }
}
# (helper of ForeReach, not listed) the line's direction D in the figure's frame (x right), handed on with the elbow's angle.
ForeReachLine = pose(raise=90.0, azimuth=0.0, swivel=0.0, d=15.0, ca=0.7, s=1, rig_upper=10.0, blade=none, left=true, right=true) {
  if ($blade != none) {
    $ForeReachBend(dx=$s * sin($raise) * sin($azimuth), dy=sin($raise) * cos($azimuth), dz=-cos($raise), swivel=$swivel, d=$d, ca=$ca, s=$s, rig_upper=$rig_upper, blade=$blade, left=$left, right=$right)
  } else {
    $ForeReachBend(dx=$s * sin($raise) * sin($azimuth), dy=sin($raise) * cos($azimuth), dz=-cos($raise), swivel=$swivel, d=$d, ca=$ca, s=$s, rig_upper=$rig_upper, left=$left, right=$right)
  }
}
# (helper of ForeReach, not listed) the elbow BEHIND the line (the figure's back square to it) swung out by swivel; the upper arm u
# and the forearm (the wrist d * D less the elbow), handed to UpperArm and Forearm as raise / azimuth.
ForeReachBend = pose(dx=0.0, dy=0.0, dz=-1.0, swivel=0.0, d=15.0, ca=0.7, s=1, rig_upper=10.0, blade=none, left=true, right=true) {
  if ($blade != none) {
    $UpperArm(raise=atan2(sqrt(($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001))) * ($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001))) + ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001))) * ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001)))), -($ca * $dz + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dz / sqrt(1 - $dy * $dy + 0.000000001) + sin($swivel) * $s * $dx / sqrt(1 - $dy * $dy + 0.000000001)))), azimuth=atan2($s * ($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001))), ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001)))), raise_max=180, blade=$blade, left=$left, right=$right)
  } else {
    $UpperArm(raise=atan2(sqrt(($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001))) * ($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001))) + ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001))) * ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001)))), -($ca * $dz + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dz / sqrt(1 - $dy * $dy + 0.000000001) + sin($swivel) * $s * $dx / sqrt(1 - $dy * $dy + 0.000000001)))), azimuth=atan2($s * ($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001))), ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001)))), raise_max=180, left=$left, right=$right)
  }
  $Forearm(raise=atan2(sqrt(($d * $dx - $rig_upper * ($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001)))) * ($d * $dx - $rig_upper * ($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001)))) + ($d * $dy - $rig_upper * ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001)))) * ($d * $dy - $rig_upper * ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001))))), -($d * $dz - $rig_upper * ($ca * $dz + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dz / sqrt(1 - $dy * $dy + 0.000000001) + sin($swivel) * $s * $dx / sqrt(1 - $dy * $dy + 0.000000001))))), azimuth=atan2($s * ($d * $dx - $rig_upper * ($ca * $dx + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * $dy * $dx / sqrt(1 - $dy * $dy + 0.000000001) - sin($swivel) * $s * $dz / sqrt(1 - $dy * $dy + 0.000000001)))), ($d * $dy - $rig_upper * ($ca * $dy + sqrt(1 - $ca * $ca + 0.000000001) * (cos($swivel) * (-1 + $dy * $dy) / sqrt(1 - $dy * $dy + 0.000000001))))), raise_max=180, left=$left, right=$right)
}

# #####################################################################################################################
# STANCE (second layer, not sided): the trunk ONCE and the four paws on the floor. It calls Hips, Back, HindAt and ForeAt above.
# #####################################################################################################################
# STANCE: the trunk ONCE (it calls Hips and Back, as the human Stance calls Hips), the four paw joints placed on the FLOOR in the
# ground frame against their rest footprints; Stance works out where each hip joint and blade pivot then stands and passes the
# two places to HindAt / ForeAt. The author never works out a pivot. Do not call Back beside Stance: Back is swings and ADDS.
#  drop      of the mean hind leg (rig_leg 22.81): the pelvis lowered, counted from the skeleton's rest (Hips'). Written, it is
#            the author's, whatever is planted. Not written, it FOLLOWS the switches by one formula default (true is 1): with a
#            hind paw planted rig_rest_drop 0.12766 (SOLVED with rig_rest_lean so the rest stand stands all four pads on the floor:
#            the hind pads float 2.97 / 3.00 at the built rest, the fore 0.77 / 0.76); with BOTH hind paws lifted the drop that
#            keeps the blade pivots' mean height at the rest stand's (rig_fore_float below the rest) for the lean written (the
#            front stays, the rear swings about it). The notes print the value used; writing that same value builds the same.
#            Range: drop_min -0.072 with a hind paw planted (the hind legs straight), -1 with both lifted; drop_max 0.893.
#  shift_forward, shift_right (cm), turn (degrees)   passed to Hips. Default 0 (written as 0, not none: the places are worked
#            from them). turn turns the hip joints and blade pivots about the pelvis's vertical.
#  lean, round, side   passed to Back with Back's meanings, ranges and round's default (round follows lean). lean's DEFAULT is
#            rig_rest_lean 70.756 (the solved rest stand: 5 degrees nose-up of the skeleton's 75.74; round follows it, 0.042).
