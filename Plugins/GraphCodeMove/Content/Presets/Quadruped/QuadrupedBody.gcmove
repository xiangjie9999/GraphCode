# (helper of Head, not listed) of the two exact solutions, the one with the smaller turns.
HeadSolvePick = pose(t1a=0.0, t2a=0.0, t1b=0.0, t2b=0.0, j=0.0) {
  $HeadSolveSet(ca=abs($t1a) + abs($t2a), cb=abs($t1b) + abs($t2b), t1a=$t1a, t2a=$t2a, t1b=$t1b, t2b=$t2b, j=$j)
}
HeadSolveSet = pose(ca=0.0, cb=0.0, t1a=0.0, t2a=0.0, t1b=0.0, t2b=0.0, j=0.0) {
  swing(neck, axis=fold, by=$j)
  if ($ca <= $cb) {
    swing(neck, axis=side, by=$t1a)
    swing(head, axis=fold, by=-$t2a)
  } else {
    swing(neck, axis=side, by=$t1b)
    swing(head, axis=fold, by=-$t2b)
  }
}
# =====================================================================================================================
# TAIL (first layer, not sided): tail_01..04, Back's way: the curve, then tail_01 turned so the root-to-tip line points.
#  raise, azimuth  the line from the root (tail_01) to the tip, absolute: raise 0 down, 180 up; azimuth 180 straight behind,
#            below 180 toward the figure's RIGHT (-X), above toward its left; rest 148.8 / 192.8. raise alone: azimuth 180;
#            azimuth alone: the rest raise. Past tail_01's side stop (+-30) tail_02 and tail_03 take the rest of the side, to their 30.
#            raise_min 30: tail_01's fold stop (125); straight down is past this rig.
#  curl      -1..1: 1 the tip hooked forward over the back (tail_02..04 fold forward 69.7 each, tail_04's stop), -1 laid back
#            (141.4 each, tail_02's stop). curl=max is refused at raise 150: the coil meets the pelvis (2.52 cm, 2.0 allowed).
#  curl_side -1..1: + wraps the tail toward the figure's RIGHT (tail_02..04 side -30 each at 1).
#  How: the line with tail_01 at rest is carried through each joint's own axes (side, then fold, the build's order; matches
#  all 19 probe readings within 0.02), then tail_01 solved exactly (fold outer, side inner), the solution with the smaller
#  turns. Not reachable within the stops: the build names each clamp (the design's sit, raise 65 azimuth 120 with curl_side
#  0.6, is 25 degrees past them; with curl=1 it is reachable).
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
#  ITS HELPERS BELOW HOLD THE TEST CAT'S JOINT AXES AS rig_ VALUES (THE TEST CAT'S DEFAULT: MEASURE YOUR OWN), derived by
#  Saved/Research/MOVE-PARAM1/work-quad-headtail/gen3.py from [readings=(0)] of the built rest.
Tail = pose(raise=none, raise_min=30, raise_max=180, azimuth=180 + 0 * $raise, azimuth_min=90, azimuth_max=270, curl=none, curl_min=-1, curl_max=1, curl_side=none, curl_side_min=-1, curl_side_max=1, rig_curl_forward=69.7, rig_curl_back=141.4, rig_side_room=30.0, rig_rest_raise=148.82) {
  if ($curl != none) {
    swing(tail_02, axis=fold, by=-(max($curl, 0) * $rig_curl_forward + min($curl, 0) * $rig_curl_back))
    swing(tail_03, axis=fold, by=-(max($curl, 0) * $rig_curl_forward + min($curl, 0) * $rig_curl_back))
    swing(tail_04, axis=fold, by=-(max($curl, 0) * $rig_curl_forward + min($curl, 0) * $rig_curl_back))
  }
  if ($curl_side != none) {
    swing(tail_02, axis=side, by=-$curl_side * $rig_side_room)
    swing(tail_03, axis=side, by=-$curl_side * $rig_side_room)
    swing(tail_04, axis=side, by=-$curl_side * $rig_side_room)
  }
  if ($raise != none && $curl != none && $curl_side != none) {
    $TailP1S4(vx=0, vy=0, vz=0, f=-(max($curl, 0) * $rig_curl_forward + min($curl, 0) * $rig_curl_back), s=-$curl_side * $rig_side_room, u=-$curl_side * $rig_side_room, r=$raise, a=$azimuth)
  } else if ($raise != none && $curl != none && $curl_side == none) {
    $TailP1S4(vx=0, vy=0, vz=0, f=-(max($curl, 0) * $rig_curl_forward + min($curl, 0) * $rig_curl_back), s=0, u=0, r=$raise, a=$azimuth)
  } else if ($raise != none && $curl == none && $curl_side != none) {
    $TailP1S4(vx=0, vy=0, vz=0, f=0, s=-$curl_side * $rig_side_room, u=-$curl_side * $rig_side_room, r=$raise, a=$azimuth)
  } else if ($raise != none && $curl == none && $curl_side == none) {
    $TailP1S4(vx=0, vy=0, vz=0, f=0, s=0, u=0, r=$raise, a=$azimuth)
  } else if ($raise == none && $azimuth != none && $curl != none && $curl_side != none) {
    $TailP1S4(vx=0, vy=0, vz=0, f=-(max($curl, 0) * $rig_curl_forward + min($curl, 0) * $rig_curl_back), s=-$curl_side * $rig_side_room, u=-$curl_side * $rig_side_room, r=$rig_rest_raise, a=$azimuth)
  } else if ($raise == none && $azimuth != none && $curl != none && $curl_side == none) {
    $TailP1S4(vx=0, vy=0, vz=0, f=-(max($curl, 0) * $rig_curl_forward + min($curl, 0) * $rig_curl_back), s=0, u=0, r=$rig_rest_raise, a=$azimuth)
  } else if ($raise == none && $azimuth != none && $curl == none && $curl_side != none) {
    $TailP1S4(vx=0, vy=0, vz=0, f=0, s=-$curl_side * $rig_side_room, u=-$curl_side * $rig_side_room, r=$rig_rest_raise, a=$azimuth)
  } else if ($raise == none && $azimuth != none && $curl == none && $curl_side == none) {
    $TailP1S4(vx=0, vy=0, vz=0, f=0, s=0, u=0, r=$rig_rest_raise, a=$azimuth)
  }
}
