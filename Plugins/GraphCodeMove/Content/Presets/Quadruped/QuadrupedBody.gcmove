TailH2Pick = pose(t1a=0.0, t2a=0.0, t1b=0.0, t2b=0.0, x=0.0, rig_tail_side_stop=30.000000) {
  $TailH2Set(ca=abs($t1a) + abs($t2a) + 10 * max(abs($t2a) - $rig_tail_side_stop, 0), cb=abs($t1b) + abs($t2b) + 10 * max(abs($t2b) - $rig_tail_side_stop, 0), t1a=$t1a, t2a=$t2a, t1b=$t1b, t2b=$t2b, x=$x)
}
TailH2Set = pose(ca=0.0, cb=0.0, t1a=0.0, t2a=0.0, t1b=0.0, t2b=0.0, x=0.0) {
  swing(tail_02, axis=side, by=$x)
  swing(tail_03, axis=side, by=$x)
  if ($ca <= $cb) {
    swing(tail_01, axis=fold, by=$t1a)
    swing(tail_01, axis=side, by=$t2a)
  } else {
    swing(tail_01, axis=fold, by=$t1b)
    swing(tail_01, axis=side, by=$t2b)
  }
}
# =====================================================================================================================
# THIGH (first layer, sided; the human Thigh): where the thigh (hip joint to stifle) points, for a leg OFF the ground (an
# alternative per side to HindAt). raise, azimuth as the file's head; either one written asks the direction (raise alone: azimuth
# 0; azimuth alone: the rest raise, rig_rest_raise_r/_l 4.77 / 9.54). Neither: not asked, the thigh rides the pelvis.
#  Ranges: raise 0..180, azimuth -180..180 (the value's own scale, as the human Thigh); where the hip stops a direction the build
#  says so. Rest (built): right 4.73 / -22.75, left 9.53 / 12.70. Right = the figure's right = this cat's _L bones.
#  Worked values (built): $Thigh(raise=90, left=false) -> 90.00 / 0.00; $Thigh(raise=60, azimuth=180) and azimuth=-180 -> 60.00 / 180.00 both
#              sides; $Thigh(raise=0, right=false) -> 0.00. Ends said by the build: raise=180 -> 66.78 ("'hip_L' ... 113.2° short",
#              its fold asked 172.9 past its stop 95.9); $Thigh(raise=45, azimuth=90, right=false) -> 22.80 / 76.14 (side -42.9 past
#              -20, "23.4° short").
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
Thigh = pose(raise=none, raise_min=0, raise_max=180, azimuth=0 * $raise, azimuth_min=-180, azimuth_max=180, left=true, right=true, rig_rest_raise_l=9.54, rig_rest_raise_r=4.77) {
  if ($raise != none) {
    if ($azimuth != none) {
      $ThighDir(raise=$raise, azimuth=$azimuth, left=$left, right=$right)
    } else {
      $ThighDir(raise=$raise, azimuth=0, left=$left, right=$right)
    }
  } else {
    if ($azimuth != none) {
      if ($left) { $ThighDir(raise=$rig_rest_raise_l, azimuth=$azimuth, right=false) }
      if ($right) { $ThighDir(raise=$rig_rest_raise_r, azimuth=$azimuth, left=false) }
    }
  }
}
# (helper of Thigh, not listed) the aim, a block per side; the _L leg's own side is the tool's right, the _R leg's its left.
ThighDir = pose(raise=0.0, azimuth=0.0, left=true, right=true) {
  if ($right) { aim(hip_L, from=$ThighL, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), right=asin(sin($raise) * sin($azimuth))), relative=character) }
  if ($left) { aim(hip_R, from=$ThighR, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), left=asin(sin($raise) * sin($azimuth))), relative=character) }
}

# SHIN (first layer, sided; the human Shin): where the crus (stifle to hock) points, for a leg OFF the ground. UNLIKE Thigh
#: raise alone takes that side's REST crus azimuth, pointing BACK (rig_rest_azimuth_r/_l 175.62 / 173.19), so
# $Shin(raise=<rest raise>) stands the rest; azimuth alone takes the rest raise (rig_rest_raise_r/_l 56.25 / 51.52). Right = the
# figure's right = this cat's _L bones.
#  Alone, Shin does not follow the thigh (one preset cannot read another's value): say a whole lifted leg with HindReach.
#  Ranges: raise 0..180, azimuth -180..180. REFUSED by the build at the top: Shin(raise=180) folds the hock into the pelvis
#  ("'pelvis' intersects 'hock_L' by 3.308701 cm (allowed 2.000000 cm)").
#  Worked values (built): $Shin(raise=51.52, right=false) -> 51.52 / 173.19 (the rest azimuth default); $Shin(raise=90, azimuth=180,
#              left=false) -> 89.99 / 175.56 and raise=120 -> 120.07 / 175.50: the AZIMUTH stays in the thigh's bend plane (the
#              stifle is a hinge), said by the build ("'stifle_L' ... 4.4° short", 3.9); azimuth=-180 alone -> 51.41 / 173.19.
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
Shin = pose(raise=none, raise_min=0, raise_max=180, azimuth=none, azimuth_min=-180, azimuth_max=180, left=true, right=true, rig_rest_raise_l=51.52, rig_rest_raise_r=56.25, rig_rest_azimuth_l=173.19, rig_rest_azimuth_r=175.62) {
  if ($raise != none) {
    if ($azimuth != none) {
      $ShinDir(raise=$raise, azimuth=$azimuth, left=$left, right=$right)
    } else {
      if ($left) { $ShinDir(raise=$raise, azimuth=$rig_rest_azimuth_l, right=false) }
      if ($right) { $ShinDir(raise=$raise, azimuth=$rig_rest_azimuth_r, left=false) }
    }
  } else {
    if ($azimuth != none) {
      if ($left) { $ShinDir(raise=$rig_rest_raise_l, azimuth=$azimuth, right=false) }
      if ($right) { $ShinDir(raise=$rig_rest_raise_r, azimuth=$azimuth, left=false) }
    }
  }
}
# (helper of Shin, not listed) the aim, a block per side, sides as ThighDir.
ShinDir = pose(raise=0.0, azimuth=0.0, left=true, right=true) {
  if ($right) { aim(stifle_L, from=$ShinL, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), right=asin(sin($raise) * sin($azimuth))), relative=character) }
  if ($left) { aim(stifle_R, from=$ShinR, toward=(down, forward=atan2(sin($raise) * cos($azimuth), cos($raise)), left=asin(sin($raise) * sin($azimuth))), relative=character) }
}

# HINDPAW (first layer, sided; the human Foot without ankle_roll): a FREE hind paw, the hock and the toes, as offsets from the
# hock's rest bend. A planted paw's angle is HindAt's heel; HindPaw and HindAt do not both write one paw.
#  point     degrees: + the paw pointed (the hock opens, the toes trail back and down), below 0 flexed. Not written: not asked.
#            Range point_min -91.8 .. point_max 53.3: the hock's stops 13..159 of fold from straight against its built rest bend
#            (66.3 right, 67.2 left; the nearer side's room).
#  toes_up   degrees: + the toes bent up at the paw joint, below 0 curled down. Not written: not asked. Range toes_up_min -85.9 ..
#            toes_up_max 63.9: the toe joint's -40..110 against its rest bend (45.9 right, 46.1 left). Right = _L bones.
#  Worked values (built): (the joint's own fold read against the rest) point=30 -> -30.000, point=-30 -> +30.000, point=max -> -53.300,
#              point=min -> +91.800, toes_up=max -> +63.900; toes_up=-85.9 was clamped 0.9 at the left toe's stop (-78.7, "range
#              -79 to 71"): -85.00, so toes_up_min is -84.9.
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
HindPaw = pose(point=none, point_min=-91.8, point_max=53.3, toes_up=none, toes_up_min=-84.9, toes_up_max=63.9, left=true, right=true) {
  if ($point != none) {
    if ($right) { swing(hock_L, axis=fold, by=-$point) }
    if ($left) { swing(hock_R, axis=fold, by=-$point) }
  }
  if ($toes_up != none) {
    if ($right) { swing(paw_B_L, axis=fold, by=$toes_up) }
    if ($left) { swing(paw_B_R, axis=fold, by=$toes_up) }
  }
}

# HINDAT (first layer, sided; the human FootAt): a PLANTED hind paw, POSED (no plant, reach or balance): thigh, crus, metatarsus
# and toes, each an aim worked out from where the hip joint is and where the paw joint stands. Called by Stance, which writes
# every place; the places are values the caller writes, so they carry no range (the Pose tab hides them).
#  hip_x, hip_y, hip_z   cm, component space (x as the readings print it, y forward, z up): where the trunk has put this
#            side's hip joint. Not written: its rest place (rig_hip_*_r/_l). The trunk is NOT moved: a hip passed where the trunk
#            does not have it floats the paw, and nothing says so here (Stance's reach shares are the check).
#  paw_x, paw_y   cm: where the paw JOINT (paw_B_*, over the pads) stands on the floor. Not written: its rest footprint
#            (-2.572, -17.718) right, (11.682, -15.591) left. Its height is its pad clearance, rig_paw_z_r/_l 2.444 / 2.342: the
#            pads on the floor (file head), so under the REST trunk the paw cannot reach: Stance lowers the trunk.
#  heel      degrees, the metatarsus' angle from the floor, the paw turning about its paw joint: 0 the hock on the floor (a sit),
#            90 upright. Not written: that leg's rest, rig_heel_r/_l 75.7 / 65.1 (built), so an unwritten paw stands on its toes.
#            Range heel_min 0 .. heel_max 90. The metatarsus keeps its rest sideways lean (rig_meta_in, cm: the hock 0.825 / 1.578
#            in from the paw) as long as its floor run allows; the rest of the run goes BACK (the paw heads the figure's forward).
#  Right = the figure's right = this cat's _L bones; every rig_*_r is an _L bone's number.
#  The stifle stands ahead of the hip-to-hock line, swung round it so the leg plane keeps its rest relation to the metatarsus
#  (rig_lean_r/_l -0.21152 / 0.29947: the plane normal's component along it), so the hinged hock can reach it; the defaults
#  stand the rest (swivel 5.88 / -4.81). The toes keep their rest direction, so the pads stay
#  flat where they stood. Past the leg's length (thigh + crus) the line is cut to it, the stifle at its stop and the paw short.
#  Worked values (built): the design's trot does not use HindAt. Under the rest trunk, with the pads on the floor, the leg
#              runs out of length: $HindAt -> reach 0.990 (the stifle's 16 stop), the paw joint 3.93 / 3.67 for 2.44 / 2.34.
#              heel=90 -> 83.3 / 82.2 there. The crouch's hind part (heel=35, hips 10.26 down) -> 40.4 / 43.0; the sit's (heel=0, hips
#              16 down, 3 back) -> 46.7 / 42.6, the hock at its 159 FLEXION STOP (153.8 / 156.6 read on the bone lines): a rig stop,
#              said by the build ("'hock_L' ... short"). At the rest place and height (rig_paw_z 5.415 / 5.342) the rest stands
#              within 0.05 degrees. heel=90 on the left meets the hip's SIDE STOP (asked 22.5, stop 20): a rig stop, said by the build.
#              The two hinge axes as rig_ values (the hock's turned 13.36 / 18.95 from the stifle's) were tried and NOT kept: the
#              crouch read 46.3 / 41.9, not within 1 degree.
#  rig_ values: THE TEST CAT'S DEFAULT: MEASURE YOUR OWN (QUADRUPED-PRESETS.md, 'Fitting your own quadruped').
HindAt = pose(hip_x=none, hip_y=none, hip_z=none, paw_x=none, paw_y=none, heel=none, heel_min=0, heel_max=90, left=true, right=true, rig_hip_x_l=8.966, rig_hip_y_l=-11.739, rig_hip_z_l=24.348, rig_paw_x_l=11.682, rig_paw_y_l=-15.591, rig_paw_z_l=2.342, rig_heel_l=65.1, rig_meta_l=4.857, rig_meta_in_l=-1.578, rig_thigh_l=9.394, rig_crus_l=8.575, rig_lean_l=0.29947, rig_toe_x_l=0.40992, rig_toe_y_l=0.83228, rig_toe_z_l=-0.37318, rig_hip_x_r=-1.483, rig_hip_y_r=-11.982, rig_hip_z_r=24.128, rig_paw_x_r=-2.572, rig_paw_y_r=-17.718, rig_paw_z_r=2.444, rig_heel_r=75.7, rig_meta_r=4.800, rig_meta_in_r=0.825, rig_thigh_r=9.210, rig_crus_r=8.789, rig_lean_r=-0.21152, rig_toe_x_r=-0.35416, rig_toe_y_r=0.78209, rig_toe_z_r=-0.51274) {
  if ($left) { $HindAtPick1(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=1, rig_hip_x=$rig_hip_x_l, rig_hip_y=$rig_hip_y_l, rig_hip_z=$rig_hip_z_l, rig_paw_x=$rig_paw_x_l, rig_paw_y=$rig_paw_y_l, rig_paw_z=$rig_paw_z_l, rig_heel=$rig_heel_l, rig_meta=$rig_meta_l, rig_meta_in=$rig_meta_in_l, rig_thigh=$rig_thigh_l, rig_crus=$rig_crus_l, rig_lean=$rig_lean_l, rig_toe_x=$rig_toe_x_l, rig_toe_y=$rig_toe_y_l, rig_toe_z=$rig_toe_z_l) }
  if ($right) { $HindAtPick1(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=-1, rig_hip_x=$rig_hip_x_r, rig_hip_y=$rig_hip_y_r, rig_hip_z=$rig_hip_z_r, rig_paw_x=$rig_paw_x_r, rig_paw_y=$rig_paw_y_r, rig_paw_z=$rig_paw_z_r, rig_heel=$rig_heel_r, rig_meta=$rig_meta_r, rig_meta_in=$rig_meta_in_r, rig_thigh=$rig_thigh_r, rig_crus=$rig_crus_r, rig_lean=$rig_lean_r, rig_toe_x=$rig_toe_x_r, rig_toe_y=$rig_toe_y_r, rig_toe_z=$rig_toe_z_r) }
}
# (helpers of HindAt, not listed) a none passed down a call stays none, so each value is picked here: as written, else this
# side's rest. Then HindAtSide (the hock from the paw and heel), HindAtLeg (the hip-to-hock line), HindAtKnee (the stifle's
# side), HindAtAim (the four aims). rig_side -1 = the bones at -X = the figure's RIGHT (_L bones), 1 = the left (_R); every
# helper default below is the figure's right leg's (HindAt passes every value, so a default is only the declaration's check).
HindAtPick1 = pose(hip_x=none, hip_y=none, hip_z=none, paw_x=none, paw_y=none, heel=none, rig_side=-1, rig_hip_x=-1.483, rig_hip_y=-11.982, rig_hip_z=24.128, rig_paw_x=-2.572, rig_paw_y=-17.718, rig_paw_z=5.415, rig_heel=75.7, rig_meta=4.8, rig_meta_in=0.825, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
  if ($hip_x != none) { $HindAtPick2(hip_x=$hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=$rig_side, rig_hip_y=$rig_hip_y, rig_hip_z=$rig_hip_z, rig_paw_x=$rig_paw_x, rig_paw_y=$rig_paw_y, rig_paw_z=$rig_paw_z, rig_heel=$rig_heel, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) } else { $HindAtPick2(hip_x=$rig_hip_x, hip_y=$hip_y, hip_z=$hip_z, paw_x=$paw_x, paw_y=$paw_y, heel=$heel, rig_side=$rig_side, rig_hip_y=$rig_hip_y, rig_hip_z=$rig_hip_z, rig_paw_x=$rig_paw_x, rig_paw_y=$rig_paw_y, rig_paw_z=$rig_paw_z, rig_heel=$rig_heel, rig_meta=$rig_meta, rig_meta_in=$rig_meta_in, rig_thigh=$rig_thigh, rig_crus=$rig_crus, rig_lean=$rig_lean, rig_toe_x=$rig_toe_x, rig_toe_y=$rig_toe_y, rig_toe_z=$rig_toe_z) }
}
HindAtPick2 = pose(hip_x=-1.483, hip_y=none, hip_z=none, paw_x=none, paw_y=none, heel=none, rig_side=-1, rig_hip_y=-11.982, rig_hip_z=24.128, rig_paw_x=-2.572, rig_paw_y=-17.718, rig_paw_z=5.415, rig_heel=75.7, rig_meta=4.8, rig_meta_in=0.825, rig_thigh=9.21, rig_crus=8.789, rig_lean=-0.21152, rig_toe_x=-0.35416, rig_toe_y=0.78209, rig_toe_z=-0.51274) {
