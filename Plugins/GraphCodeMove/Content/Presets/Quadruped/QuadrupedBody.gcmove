# (helper of Stance, not listed) one planted hind leg: its reach share (the hip joint to the paw joint over the leg's straight
# reach, printed in the notes; past 1 the leg cannot reach and the notes say 'if ($reach <= 1) is false'), then HindAt.
StanceHind = pose(hx=0.0, hy=0.0, hz=20.0, qx=0.0, qy=0.0, qz=2.4, heel=none, rig_reach=22.6, reach=sqrt(pow($hx - $qx, 2) + pow($hy - $qy, 2) + pow($hz - $qz, 2)) / $rig_reach, reach_min=0, reach_max=1, left=true, right=true) {
  if ($reach <= 1) { $HindAt(hip_x=$hx, hip_y=$hy, hip_z=$hz, paw_x=$qx, paw_y=$qy, heel=$heel, left=$left, right=$right) } else {
    $HindAt(hip_x=$hx, hip_y=$hy, hip_z=$hz, paw_x=$qx, paw_y=$qy, heel=$heel, left=$left, right=$right)
  }
}
# (helper of Stance, not listed) one planted fore leg: its reach share (the blade pivot to the paw joint over the leg's straight
