gcshape 1 into:/Game/AnimalStudies/Parts/Paws smooth:.045 shade:76 uv:keep
# Paw faces +X. Heel, metacarpal pad, four unequal digits and keratin tips
# share a local sole plane. The wrist fits the caudal half from above.
build { SM_AnimalPaw = $Paw [pivot=(0,0,0)] }
Width = 4.5
Length = 5.4
Spread = 1
ToeLength = 1
DigitArch = 1
PadDepth = 1
ClawLength = .13
Coat = material('/Game/AnimalStudies/Catalogue/Materials/MI_Coat')
PadLeather = material('/Game/AnimalStudies/Catalogue/Materials/M_NasalLeather')
Keratin = material('/Game/AnimalStudies/Catalogue/Materials/MI_Dark')
Ball = formula(q,w) { .5+.5*cos(180*clamp($q/$w,-1,1)) }
HeelWidth = profile(0=.06,.13=.29,.32=.40,.55=.46,.72=.44,.91=.31,1=.01)
HeelRoof = profile(0=.20,.14=.45,.29=.64,.45=.71,.60=.62,.76=.46,.90=.32,1=.14)
HeelFloor = profile(0=.16,.15=.071,.38=.034,.68=.035,.86=.059,1=.13)
# Axial positions and widths are fractions of length and breadth.
HeelHeightScale = 1
HeelStart = -.46
HeelEnd = .44
ToeRootBreadth = .80
ToeTipTaper = .18
ToeSplayRoot = .70
KnuckleStation = .44
KnuckleSpan = .42
ToeCentreHeight = .14
ToeAxialArch = .014
KnuckleLift = .040
ToeCrossDepth = .137
KnuckleDepth = .038
PadLobes = 3
PadLobeDepth = .10
PadToeTaper = .19
PadCentreHeight = .115
PadCrossDepth = .105
ClawRootLength = .18
ClawRootRoundness = .81
ClawBurial = .12
ClawBreadth = .053
ClawBaseHeight = .177
ClawDescent = .064
ClawHook = .039
ClawCrossDepth = .073
DigitalPadStation = .70
ClawVisibilityThreshold = .015
ClawReferenceBreadth = .158
PalmSilhouetteFit = 1
PalmContactRoundness = .62
PalmAsymmetry = 0
PalmContourOffset = profile(0=0,1=0)
PalmPadBreadth = .304
PalmPadLength = .268
PalmPadStation = -.08
DewDigitReach = .18
DewDigitBreadth = .119
DewDigitLength = .37
DewPadStation = .135
DewPadBreadth = .084
DewPadLength = .090
DewClawStation = .16
CarpalPadBreadth = .172
CarpalPadLength = .189
HeelBreadthOffset = profile(0=0,1=0)
HeelRoofOffset = profile(0=0,1=0)
HeelFloorOffset = profile(0=0,1=0)
HeelBase = mesh() {
  arc(radius=1,from=-90,to=90,segments=44)
  revolve(segments=48,rotate=(0,-90,0))
  warp(with=(S: point.t.x,R: max(.00001,sqrt(max(0,1-point.x*point.x))),H: point.z/$R,V: point.y/$R,A: .5+.5*$H),to=(lerp($HeelStart,$HeelEnd,$S)*$Length,$Width*$V*$HeelWidth($S),$Width*lerp($HeelFloor($S),$HeelRoof($S),$A)))
  material($Coat)
}
# Deform the joined heel and digital roots together. Changing the dorsum
# leaves the plantar boundary fixed and preserves every fused interface.
FitHeel = instruction() {
  warp(with=(S: clamp((point.x/$Length-$HeelStart)/max(.00001,$HeelEnd-$HeelStart),0,1),Floor: $HeelFloor($S),Roof: $HeelRoof($S),Height: clamp((point.z/$Width-$Floor)/max(.00001,$Roof-$Floor),0,1),Rise: lerp($HeelFloorOffset($S),($HeelHeightScale-1)*($Roof-$Floor)+$HeelRoofOffset($S),$Height)),by=(0,point.y*$HeelBreadthOffset($S)/max(.00001,$HeelWidth($S)),$Width*$Rise))
}
Heel = mesh() {
  add($HeelBase,join=none)
  $FitHeel()
}
Toe = mesh(side=.10,reach=.73,thick=.143,length=.65) {
  arc(radius=1,from=-90,to=90,segments=40)
  revolve(segments=36,rotate=(0,-90,0))
  warp(with=(S: point.t.x,R: max(.00001,sqrt(max(0,1-point.x*point.x))),V: point.y/$R,H: point.z/$R,Breadth: $thick*lerp($ToeRootBreadth,1,sin(180*$S))*(1-$ToeTipTaper*$S)*$R,Knuckle: $Ball($S-$KnuckleStation,$KnuckleSpan),Center: $side*lerp($ToeSplayRoot,1,$S)*$Spread),to=($Length*($reach-$length+$length*$S)*$ToeLength,$Width*($Center+$V*$Breadth),$Width*($ToeCentreHeight+$R*($ToeAxialArch+$KnuckleLift*$Knuckle*$DigitArch)+$H*$R*($ToeCrossDepth+$KnuckleDepth*$Knuckle*$DigitArch))))
  material($Coat)
}
# Exposed central forepad in Amos T Fairchild's labelled photograph.
# Azimuth runs from the caudal cleft around both lobes and the rostral apex.
PalmReferenceRadius = profile(0.00000=0.36419,0.02083=0.37713,0.04167=0.41632,0.06250=0.53425,0.08333=1.00512,0.10417=1.24335,0.12500=1.24141,0.14583=1.18736,0.16667=1.12013,0.18750=1.07047,0.20833=1.03514,0.22917=1.00512,0.25000=0.96795,0.27083=0.92827,0.29167=0.86987,0.31250=0.80326,0.33333=0.75254,0.35417=0.74591,0.37500=0.75644,0.39583=0.79994,0.41667=0.86380,0.43750=0.94836,0.45833=1.00210,0.47917=1.00491,0.50000=0.99052,0.52083=0.96279,0.54167=0.91061,0.56250=0.85191,0.58333=0.79458,0.60417=0.75536,0.62500=0.71920,0.64583=0.69930,0.66667=0.73562,0.68750=0.79018,0.70833=0.85577,0.72917=0.94372,0.75000=0.98661,0.77083=1.00099,0.79167=1.01447,0.81250=1.03114,0.83333=1.04983,0.85417=1.04737,0.87500=0.84301,0.89583=0.50318,0.91667=0.42835,0.93750=0.39093,0.95833=0.36528,0.97917=0.35803,1.00000=0.36419)
PalmRadius = formula(t) { lerp(.5*($PalmReferenceRadius($t)+$PalmReferenceRadius(1-$t)),$PalmReferenceRadius($t),$PalmAsymmetry)+$PalmContourOffset($t) }
Pad = mesh(side=0,x=.01,w=.36,len=.34,digital=0,palmar=0) {
  arc(radius=1,from=-90,to=90,segments=28)
  revolve(segments=36)
  warp(with=(X: point.x,Y: point.y,R: sqrt($X*$X+$Y*$Y),Angle: (atan2($Y,$X+max(0,.0000001-$R))+180)/360,Fit: $PalmSilhouetteFit*$palmar,Radius: max(.00001,$PalmRadius($Angle))*pow(max(.00001,$R),$PalmContactRoundness-1),Fork: $PadLobeDepth*cos(180*$PadLobes*$Y)*max(0,-$X)*(1-$digital)),to=(($x+$len*lerp($X+$Fork,$X*$Radius,$Fit))*$Length,($side*$Spread+$w*$Y*lerp(1-$PadToeTaper*$X,$Radius,$Fit))*$Width,($PadCentreHeight+$PadCrossDepth*point.z)*$Width*$PadDepth))
  material($PadLeather)
}
Claw = mesh(side=.12,x=.72,reach=.13) {
  arc(radius=1,from=-90,to=90,segments=28)
  revolve(segments=24,rotate=(0,-90,0))
  warp(with=(S: point.t.x,R: max(.00001,sqrt(max(0,1-point.x*point.x))),Taper: sqrt(max(0,1-pow(clamp(1-$S/max(.00001,$ClawRootLength),0,1),2)))*(1-$S)*lerp($ClawRootRoundness,1,cos(90*$S))),to=($Length*($x*$ToeLength+$reach*($S-$ClawBurial)),($side*$Spread+point.y/$R*$ClawBreadth*$Taper)*$Width,($Width*($ClawBaseHeight-$ClawDescent*$S-$ClawHook*$S*$S+point.z/$R*$ClawCrossDepth*$Taper))))
  material($Keratin)
}
# Digit index follows the medial to lateral order on the right foot.
# Each length drives its own skin, terminal pad and claw attachment.
DigitReach = profile(0=.568,.333333=.732,.666667=.710,1=.532)
DigitBreadth = profile(0=.134,.333333=.158,.666667=.155,1=.133)
DigitSpan = profile(0=-.346,.333333=-.118,.666667=.117,1=.338)
DigitLength = profile(0=.56,.333333=.68,.666667=.67,1=.55)
DigitalPadWidth = .81
DigitalPadLength = .205
ClawSetback = .03
DigitReachOffset = profile(0=0,1=0)
DigitLengthScale = profile(0=1,1=1)
DigitBreadthScale = profile(0=1,1=1)
DigitSpanOffset = profile(0=0,1=0)
Digit = mesh(index=0) {
  add($Toe,side=($DigitSpan($index)+$DigitSpanOffset($index)),reach=($DigitReach($index)+$DigitReachOffset($index)),thick=($DigitBreadth($index)*$DigitBreadthScale($index)),length=($DigitLength($index)*$DigitLengthScale($index)))
  add($Pad,side=($DigitSpan($index)+$DigitSpanOffset($index)),x=$DigitalPadStation*($DigitReach($index)+$DigitReachOffset($index))*$ToeLength,w=$DigitalPadWidth*($DigitBreadth($index)*$DigitBreadthScale($index)),len=$DigitalPadLength*($DigitLength($index)*$DigitLengthScale($index)),digital=1)
  if ($ClawLength > $ClawVisibilityThreshold) {
    add($Claw,side=($DigitSpan($index)+$DigitSpanOffset($index)),x=($DigitReach($index)+$DigitReachOffset($index))-$ClawSetback,reach=$ClawLength*($DigitBreadth($index)*$DigitBreadthScale($index))/max(.00001,$ClawReferenceBreadth))
  }
}
Dewclaw = mesh() {
  add($Toe,side=0,reach=$DewDigitReach,thick=$DewDigitBreadth,length=$DewDigitLength)
  add($Pad,side=0,x=$DewPadStation,w=$DewPadBreadth,len=$DewPadLength,digital=1)
  if ($ClawLength > $ClawVisibilityThreshold) {
    add($Claw,side=0,x=$DewClawStation,reach=$ClawLength)
  }
  uv(box,scale=$Width)
}
CarpalPad = mesh() { add($Pad,w=$CarpalPadBreadth,len=$CarpalPadLength,x=0) }
Paw = mesh() {
  add($HeelBase)
  add($Digit,index=0)
  add($Digit,index=1/3)
  add($Digit,index=2/3)
  add($Digit,index=1)
  add($Pad,w=$PalmPadBreadth,len=$PalmPadLength,x=$PalmPadStation,palmar=1)
  $FitHeel()
  uv(box,scale=$Width)
}
