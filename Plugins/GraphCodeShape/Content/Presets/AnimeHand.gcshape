gcshape 1 into:/Game/GraphCodeMarket/GraphCode/AnimeHand smooth:.006 shade:80

# Planar anime rest hand. A style recipe over the shared organic assembly,
# not a separate merge implementation. Lengths in cm, pose angles in degrees.
build { SM_AnimeHand = $Hand [pivot=(0,0,0)] }
PalmWidth = 7.1
PalmLength = 7.4
PalmDepth = 3.0
Handedness = 1
FingerLength = 7.7
# Target digit edge length as a fraction of its authored width.
DigitResolutionRatio = .02
ThumbLength = 7.0
PalmCup = 12
IndexCurl = 12
MiddleCurl = 16
RingCurl = 21
LittleCurl = 26
ThumbCurl = 15
NailLength = .08
IndexNailLength = $NailLength
MiddleNailLength = $NailLength
RingNailLength = $NailLength
LittleNailLength = $NailLength
ThumbNailLength = $NailLength
Nails = 1
Skin = material()
Nail = material()
WristWidth = $PalmWidth * .58
WristDepth = $PalmDepth * .82
IndexDepth = $PalmDepth * .53
MiddleDepth = $PalmDepth * .55
RingDepth = $PalmDepth * .51
LittleDepth = $PalmDepth * .44
ThumbDepth = $PalmDepth * .63
IndexNailWidth = $PalmWidth * .237 * .48
MiddleNailWidth = $PalmWidth * .25 * .48
RingNailWidth = $PalmWidth * .231 * .48
LittleNailWidth = $PalmWidth * .192 * .48
ThumbNailWidth = $PalmWidth * .275 * .46
ThumbX = -$PalmWidth * .32 * $Handedness
ThumbY = -$PalmDepth * .19
ThumbZ = $PalmLength * .43
PalmResolution = $PalmWidth * .013
PalmFinish = $PalmWidth * .016
RootSeat = $PalmDepth * .509433962
Profiles = shape('/GraphCodeShape/Presets/Profiles')
Anatomy = shape('/GraphCodeShape/Presets/FingerAnatomy')
PalmSection = plane(width=$PalmWidth,depth=$PalmDepth) {
  # Broad dorsal plane, a shallow palmar hollow and the fuller thumb-side pad.
  # These are authored sections, not a post-merge inflation of the entire hand.
  curve((0,$depth * .40),(-$width * .32,$depth * .37),(-$width * .49,$depth * .13),(-$width * .48,-$depth * .19),(-$width * .30,-$depth * .47),(0,-$depth * .42),($width * .30,-$depth * .44),($width * .48,-$depth * .17),($width * .49,$depth * .12),($width * .32,$depth * .37),loop=true)
}
RoundPalm = mesh() {
  circle(radius=$WristWidth / 2,scale=(1,$WristDepth / $WristWidth,1))
  loft(to=$PalmSection,scale=(.68,.96,1),at=(0,0,$PalmLength * .15))
  loft(to=$PalmSection,scale=(.80,1,1),at=(0,0,$PalmLength * .30))
  loft(to=$PalmSection,at=(0,0,$PalmLength * .56))
  loft(to=$PalmSection,scale=(1,.86,1),at=(0,0,$PalmLength * .81))
  loft(to=$PalmSection,scale=(.94,.66,1),at=(0,0,$PalmLength * .98))
}
SmoothFinger = mesh(length=7.7,width=1.8,depth=1.65) {
  # Named phalanges and a rounded pulp; the skin is independent of nail length.
  add($Anatomy.SkinForm,length=$length,width=$width,depth=$depth,knuckle=1.04,pad=1.03,detail=0,with_nail=0,resolution_ratio=$DigitResolutionRatio)
}
CrownedNail = mesh(width=1.15,length=2,arch=.16) {
  rect(w=$width,h=$length)
  round(($width * .35,$width * .35,$width * .20,$width * .20))
  fill()
  bend(radius=$width * $width / (8 * $arch) + $arch / 2,around=-Y,along=X,at=(0,0,0))
  # A nail is crowned lengthwise too; its free edge continues this curvature.
  bend(radius=$length * 1.6,around=X,along=Y,at=(0,0,0))
}
RoundThumb = mesh() {
  add($SmoothFinger,length=$ThumbLength,width=$PalmWidth * .275,depth=$ThumbDepth,at=(0,0,-$RootSeat))
}
ThumbGuide = mesh() {
  # The guide represents the thumb's broad proximal flesh, not a narrow peg.
  circle(radius=$PalmWidth * .275 * .42,scale=(1,$ThumbDepth / ($PalmWidth * .275),1))
  extrude(height=$RootSeat * 2.22)
  taper(to=90%)
  round($RootSeat * .104)
  place(by=(0,0,-$RootSeat * .593))
}
ThumbGuideBox = mesh() {
  rect(w=$PalmWidth * .275 * .95,h=$ThumbDepth * 1.05)
  extrude(height=$RootSeat * 2,at=(0,0,$RootSeat * .566666667))
}
ThumbGuideReplacement = mesh() {
  add($ThumbGuideBox,at=($ThumbX,$ThumbY,$ThumbZ),rotate=(0,46 * $Handedness,0))
}
Kit = shape('/GraphCodeShape/Presets/HandAnatomy',
  Handedness=$Handedness,
  PalmCore=$RoundPalm,FingerSurface=$SmoothFinger,ThumbForm=$RoundThumb,NailBlank=$CrownedNail,
  RoughThumb=$ThumbGuide,ThumbReplace=$ThumbGuideReplacement,
  PalmWidth=$PalmWidth,PalmLength=$PalmLength,PalmDepth=$PalmDepth,
  WristWidth=$WristWidth,WristDepth=$WristDepth,
  FingerLength=$FingerLength,ThumbLength=$ThumbLength,
  IndexDepth=$IndexDepth,MiddleDepth=$MiddleDepth,
  RingDepth=$RingDepth,LittleDepth=$LittleDepth,ThumbDepth=$ThumbDepth,
  ThumbX=$ThumbX,ThumbY=$ThumbY,ThumbZ=$ThumbZ,
  PalmPads=1,PalmCup=$PalmCup,PalmResolution=$PalmResolution,PalmFinish=$PalmFinish,
  IndexCurl=$IndexCurl,MiddleCurl=$MiddleCurl,RingCurl=$RingCurl,LittleCurl=$LittleCurl,ThumbCurl=$ThumbCurl,
  NailLength=$NailLength,IndexNailLength=$IndexNailLength,MiddleNailLength=$MiddleNailLength,
  RingNailLength=$RingNailLength,LittleNailLength=$LittleNailLength,ThumbNailLength=$ThumbNailLength,
  NailBedEnd=.93,ThumbNailBedEnd=.93,NailTipEnd=.96,
  IndexNailWidth=$IndexNailWidth,MiddleNailWidth=$MiddleNailWidth,RingNailWidth=$RingNailWidth,
  LittleNailWidth=$LittleNailWidth,ThumbNailWidth=$ThumbNailWidth,
  Nails=$Nails,Skin=$Skin,Nail=$Nail)
Hand = mesh() { add($Kit.Hand) }
SkinOnly = mesh() { add($Kit.HandSkin) }
NailsOnly = mesh() { add($Kit.HandNails) }
Middle = mesh() { add($Kit.Middle) }
MiddleWithNail = mesh() { add($Kit.Middle) add($Kit.MiddleNail,join=none) }
Palm = mesh() { add($Kit.Palm) }
