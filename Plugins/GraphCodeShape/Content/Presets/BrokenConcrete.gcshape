# ---- debris pieces --------------------------------------------------------------------------------
# a chunk: an irregular plane-bounded mass, its largest face (`bottom`) a piece of cast skin, the rest
# break faces; round 3: angular (few planes, flattened), the big ones' break faces roughened lightly at
# about half their size, so they read rough while the arrises stay sharp (the small ones stay plane: the
# debris line keeps 6,000 triangles of ~150 pieces); mapped in its own frame
Chunk = mesh(size=12.0, ar=0.7, tr=0.5, faces=7.0, even=5.0, rough=0.03, noise=1) {
  polyhedron(size=($size, $size * $ar, $size * $tr), faces=floor($faces), evenness=$even%, seed=floor($noise))
  material($Broken)
  material($Face) [bottom]
  if ($rough > 0) {
    roughen(by=$rough * $size, scale=0.6 * $size, seed=floor($noise) + 3, form=faceted) [!bottom]
  }
  uv(box, scale=100.0)
}
# a slab plate: an irregular prism `t` thick, its bottom (and with `skins` 2 its top) cast skin, its
# sides broken
Plate = mesh(w=30.0, d=24.0, t=12.0, faces=8.0, even=20.0, skins=2, rough=0.07, noise=1) {
  polyhedron(size=($w, $d, $t), faces=floor($faces), evenness=$even%, seed=floor($noise), mode=prism)
  material($Broken)
  material($Face) [bottom]
  if ($skins > 1.5) {
    material($Face) [top]
  }
  if ($rough > 0) {
    roughen(by=$rough * $t, scale=0.4 * $w, seed=floor($noise) + 3, form=faceted) [side]
  }
  uv(box, scale=100.0)
}

GroundDisc = mesh(rx=50.0, ry=50.0) {
  points(($rx * 1.00000, $ry * 0.00000), ($rx * 0.96593, $ry * 0.25882), ($rx * 0.86603, $ry * 0.50000), ($rx * 0.70711, $ry * 0.70711), ($rx * 0.50000, $ry * 0.86603), ($rx * 0.25882, $ry * 0.96593), ($rx * 0.00000, $ry * 1.00000), ($rx * -0.25882, $ry * 0.96593), ($rx * -0.50000, $ry * 0.86603), ($rx * -0.70711, $ry * 0.70711), ($rx * -0.86603, $ry * 0.50000), ($rx * -0.96593, $ry * 0.25882), ($rx * -1.00000, $ry * 0.00000), ($rx * -0.96593, $ry * -0.25882), ($rx * -0.86603, $ry * -0.50000), ($rx * -0.70711, $ry * -0.70711), ($rx * -0.50000, $ry * -0.86603), ($rx * -0.25882, $ry * -0.96593), ($rx * -0.00000, $ry * -1.00000), ($rx * 0.25882, $ry * -0.96593), ($rx * 0.50000, $ry * -0.86603), ($rx * 0.70711, $ry * -0.70711), ($rx * 0.86603, $ry * -0.50000), ($rx * 0.96593, $ry * -0.25882), loop=true)
  extrude(height=1.0)
}

# ---- linked debris (kit 3.6) ---------------------------------------------------------------------
SlabDebris = mesh(size_x=200.0, size_y=200.0, thick=15.0, noise=1, budget=1, bar=1.27, spacing=30.0, cover=3.8, mats=1, bar_jitter=2.5, bar_yaw=0.6, bar_kink=0.4, hole_x=100.0, hole_y=100.0, hole_rx=0.0, hole_ry=0.0, rim=0.3, crater_rim=0.6, scab_rim=0.45, bite=0.25, scab=1.3, crater=1.18, crater_d=0.45, scab_d=0.45, funnel=0.3, cone=0.1, coarse=1.8, mid=0.0, rough=14.0, fine=10.0, ramp_rough=1.75, stone=1.3, stone_size=8.0, stone_cut=0, stone_fade=0.0, sag=16.0, lean=0.3, twist=3.0, snapped=0.3, stub=0.1, pulled=0.15, gone=0.1, droop=55.0, hang=85.0, band=0.0, band_x=110.0, band_rim=0.4, wander=12.0, slant=0.12, walk=5.0, jog=0.25, jog_size=14.0, lip=7.0, lip_d=1.15, tear=7.0, fold=25.0, fold_var=0.3, tilt=3.5, drop=9.0, crush=5, plates=3, plate_merge=0.35, plate_var=0.4, crack_w=7.0, crack_walk=4.0, crack_cross=0.75, crack_rough=0.5, crack_stone=0.0, crack_jag=3.2, crack_calm=0.3, crack_step=0.5, crack_slope=1.5, crack_gap=0.18, crack_diag=0.35, crack_cell=1.0, shards=2, shard_two=0.5, shard_len=28.0, shard_fold=10.0, branch_w=4.5, edge=4.5, edge_d=0.6, edge_chip=0.5, bend_crack=2, bend_w=2.2, bend_d=0.38, tile=100.0, bar_tile=100.0, bar_aspect=1.0, uvfit=1, skin=0.5, skin_edge=0.0, skin_chips=1.0, skin_chip=5.0, tend=4.0, tend_walk=2.0, tend_jag=2.2, tend_lift=5.0, tend_lean=3.0, tend_rough=0.85, tend_cell=0.8, tend_stone=0.0, tend_bar=2.0, pop=2.5, pop_size=1.8, scale_n=0.5, scale_size=22.5, scale_d=0.5, shrink=0.0, shrink_w=0.45, shrink_d=0.8, tend_step=1.0, tend_mid=1.0, soft=0.0, keep=0.93, spread=1.3, pile=0.5, chunk_rough=0.03, bit_max=16.0, bit_kink=0.6) {
  $r = 0.5 * $bar
  $zX = -$thick + $cover + $r
  $zY = $zX + $bar
  $zTY = -$cover - $r
  $zTX = $zTY - $bar
  $Lbx = $size_x - 2 * $cover
  $Lby = $size_y - 2 * $cover
  $nb = floor(($size_y - 2 * $cover) / $spacing) + 1
  $nbx_ = floor(($size_x - 2 * $cover) / $spacing) + 1
  $mg = $coarse + $mid + $stone + 0.8
  $k0 = $noise * 1009
  $isb = clamp(ceil($band), 0, 1)
  $wdy = ($size_y + 12.0) / 13
  $za = sin(($noise * 1009 + 690) * 12.9898 + 0.7) * 43758.5453
  $za = $za - floor($za)
  $zb = sin(($noise * 1009 + 690) * 12.9898 + 1.9) * 43758.5453
  $zb = $zb - floor($zb)
  $zc = sin(($noise * 1009 + 690) * 12.9898 + 3.1) * 43758.5453
  $zc = $zc - floor($zc)
  $zd = sin(($noise * 1009 + 690) * 12.9898 + 4.7) * 43758.5453
  $zd = $zd - floor($zd)
  $ze = sin(($noise * 1009 + 690) * 12.9898 + 6.1) * 43758.5453
  $ze = $ze - floor($ze)
  $zf = sin(($noise * 1009 + 690) * 12.9898 + 7.3) * 43758.5453
  $zf = $zf - floor($zf)
