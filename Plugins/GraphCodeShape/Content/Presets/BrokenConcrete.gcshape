  $tx5 = -20.0 + ($size_x + 40.0) * 0.8333
  $td5 = $tear * (0.75 + 0.5 * $t5)
  $t6 = sin(($noise * 1009 + 746 + 20 * $side) * 12.9898 + 0.7) * 43758.5453
  $t6 = $t6 - floor($t6)
  $tx6 = -20.0 + ($size_x + 40.0) * 1.0000
  $td6 = $tear * (0.75 + 0.5 * $t6)
  if ($side < 0.5) {
    points(($tx0, $td0), ($tx1, $td1), ($tx2, $td2), ($tx3, $td3), ($tx4, $td4), ($tx5, $td5), ($tx6, $td6), ($tx6, -20.0), ($tx0, -20.0), loop=true)
  } else {
    points(($tx0, $size_y + 20.0), ($tx6, $size_y + 20.0), ($tx6, $size_y - $td6), ($tx5, $size_y - $td5), ($tx4, $size_y - $td4), ($tx3, $size_y - $td3), ($tx2, $size_y - $td2), ($tx1, $size_y - $td1), ($tx0, $size_y - $td0), loop=true)
  }
  extrude(height=$thick + 4.0)
  roughen(by=0.5 * $coarse, scale=$rough, seed=$noise * 1009 + 320 + $side, form=faceted) [side]
}

# (kept blank: the installed build keys each drawn line by its line in the file, so these hold
#  SlabDebris's hole-state draws on the lines they passed with; Docs/GC-SHAPE-DAMAGE-KIT-ROUNDS.md, C1 round 4)















































































































































# ---- bars: a #4 bar is 8-sided, along +X from x = 0 ------------------------------------------------
# swept along a two-point path (28 triangles; `circle` + `extrude` subdivides a long side, kit 4.1 N2),
# scaled to length, its section turned by `roll` about its own axis, then cylinder-mapped along it
Path100 = plane() {
  points((0.0, 0.0, 0.0), (100.0, 0.0, 0.0))
}
Rod = mesh(r=0.635) {
  circle(radius=$r, segments=8)
  sweep(along=$Path100)
  material($Steel)
}
RodX = mesh(r=0.635, len=100.0, roll=0.0, tile=100.0, aspect=1.0) {
  add($Rod, r=$r, scale=($len / 100.0, 1.0, 1.0), rotate=($roll, 0.0, 0.0))
  uv(cylinder, at=(0.0, 0.0, 0.0), facing=(1.0, 0.0, 0.0), up=(0.0, 0.0, 1.0), scale=($tile / $aspect, $tile))
}
# the same bar with 11 stations, so a warp has rings to bend
Path100r = plane() {
  points((0.0000, 0.0, 0.0), (10.0000, 0.0, 0.0), (20.0000, 0.0, 0.0), (30.0000, 0.0, 0.0), (40.0000, 0.0, 0.0), (50.0000, 0.0, 0.0), (60.0000, 0.0, 0.0), (70.0000, 0.0, 0.0), (80.0000, 0.0, 0.0), (90.0000, 0.0, 0.0), (100.0000, 0.0, 0.0))
}
RodRinged = mesh(r=0.635) {
  circle(radius=$r, segments=8)
  sweep(along=$Path100r)
  material($Steel)
}
RodXr = mesh(r=0.635, len=100.0, roll=0.0, tile=100.0, aspect=1.0) {
  add($RodRinged, r=$r, scale=($len / 100.0, 1.0, 1.0), rotate=($roll, 0.0, 0.0))
  uv(cylinder, at=(0.0, 0.0, 0.0), facing=(1.0, 0.0, 0.0), up=(0.0, 0.0, 1.0), scale=($tile / $aspect, $tile))
}
# the exposed middle of a bar that held: down by `sag` at a low point moved off-centre by `k`, sideways
# by `lat` and twisted by `tw`, level where it enters the concrete at both ends
RodSag = mesh(r=0.635, len=60.0, roll=0.0, sag=10.0, k=1.0, lat=0.0, tw=0.0, tile=100.0, aspect=1.0) {
  add($RodXr, r=$r, len=$len, roll=$roll, tile=$tile, aspect=$aspect)
  warp(to=(point.x - point.z * (-$sag * (3.14159 / $len * sin(360 * pow(max(point.x / $len, 0.0001), $k)) * $k * pow(max(point.x / $len, 0.0001), $k - 1))) / sqrt(1 + (-$sag * (3.14159 / $len * sin(360 * pow(max(point.x / $len, 0.0001), $k)) * $k * pow(max(point.x / $len, 0.0001), $k - 1))) * (-$sag * (3.14159 / $len * sin(360 * pow(max(point.x / $len, 0.0001), $k)) * $k * pow(max(point.x / $len, 0.0001), $k - 1)))), point.y + $lat * pow(sin(180 * pow(max(point.x / $len, 0.0001), $k)), 2) + $tw * sin(360 * pow(max(point.x / $len, 0.0001), $k)) * sin(180 * pow(max(point.x / $len, 0.0001), $k)), -$sag * pow(sin(180 * pow(max(point.x / $len, 0.0001), $k)), 2) + point.z / sqrt(1 + (-$sag * (3.14159 / $len * sin(360 * pow(max(point.x / $len, 0.0001), $k)) * $k * pow(max(point.x / $len, 0.0001), $k - 1))) * (-$sag * (3.14159 / $len * sin(360 * pow(max(point.x / $len, 0.0001), $k)) * $k * pow(max(point.x / $len, 0.0001), $k - 1))))))
}
# a bent end: `len` cm of bar (arc length) turned down through `angle` degrees on a circular arc, level
# at its root; placed with a roll, it bends down and sideways
RodArc = mesh(r=0.635, len=6.0, angle=25.0, roll=0.0, tile=100.0, aspect=1.0) {
  add($RodXr, r=$r, len=$len, roll=$roll, tile=$tile, aspect=$aspect)
  $R = $len * 180 / (3.14159 * max($angle, 0.5))
  warp(to=($R * sin(($angle * point.x / $len)) + point.z * sin(($angle * point.x / $len)), point.y, -$R * (1 - cos(($angle * point.x / $len))) + point.z * cos(($angle * point.x / $len))))
}
# a bar bent across the fold's gap, built in the module frame: from A leaving along T0 to B arriving
