      $p = 0.5 * $size_y + ($j - 0.5 * ($nb - 1)) * $spacing + (2 * $q0 - 1) * $bar_jitter
      $yw = $bar_yaw * (2 * $q7 - 1)
      $kk = $bar_kink * (2 * $q8 - 1)
      $a1 = $yw - $kk
      $a2 = $yw + $kk
      $xc = ($wx0 + $wd0 * clamp(($p - $wy0) / $ww0, 0, 1) + $wd1 * clamp(($p - $wy1) / $ww1, 0, 1) + $wd2 * clamp(($p - $wy2) / $ww2, 0, 1) + $wd3 * clamp(($p - $wy3) / $ww3, 0, 1) + $wd4 * clamp(($p - $wy4) / $ww4, 0, 1) + $wd5 * clamp(($p - $wy5) / $ww5, 0, 1) + $wd6 * clamp(($p - $wy6) / $ww6, 0, 1) + $wd7 * clamp(($p - $wy7) / $ww7, 0, 1) + $wd8 * clamp(($p - $wy8) / $ww8, 0, 1) + $wd9 * clamp(($p - $wy9) / $ww9, 0, 1) + $wd10 * clamp(($p - $wy10) / $ww10, 0, 1) + $wd11 * clamp(($p - $wy11) / $ww11, 0, 1) + $wd12 * clamp(($p - $wy12) / $ww12, 0, 1))
      $xA = (($wx0 + $wd0 * clamp(($p - $wy0) / $ww0, 0, 1) + $wd1 * clamp(($p - $wy1) / $ww1, 0, 1) + $wd2 * clamp(($p - $wy2) / $ww2, 0, 1) + $wd3 * clamp(($p - $wy3) / $ww3, 0, 1) + $wd4 * clamp(($p - $wy4) / $ww4, 0, 1) + $wd5 * clamp(($p - $wy5) / $ww5, 0, 1) + $wd6 * clamp(($p - $wy6) / $ww6, 0, 1) + $wd7 * clamp(($p - $wy7) / $ww7, 0, 1) + $wd8 * clamp(($p - $wy8) / $ww8, 0, 1) + $wd9 * clamp(($p - $wy9) / $ww9, 0, 1) + $wd10 * clamp(($p - $wy10) / $ww10, 0, 1) + $wd11 * clamp(($p - $wy11) / $ww11, 0, 1) + $wd12 * clamp(($p - $wy12) / $ww12, 0, 1)) - ($hn0 + ($hn1 - $hn0) * clamp(($p - $wy0) / $wdy, 0, 1) + ($hn2 - $hn1) * clamp(($p - $wy1) / $wdy, 0, 1) + ($hn3 - $hn2) * clamp(($p - $wy2) / $wdy, 0, 1) + ($hn4 - $hn3) * clamp(($p - $wy3) / $wdy, 0, 1) + ($hn5 - $hn4) * clamp(($p - $wy4) / $wdy, 0, 1) + ($hn6 - $hn5) * clamp(($p - $wy5) / $wdy, 0, 1) + ($hn7 - $hn6) * clamp(($p - $wy6) / $wdy, 0, 1) + ($hn8 - $hn7) * clamp(($p - $wy7) / $wdy, 0, 1) + ($hn9 - $hn8) * clamp(($p - $wy8) / $wdy, 0, 1) + ($hn10 - $hn9) * clamp(($p - $wy9) / $wdy, 0, 1) + ($hn11 - $hn10) * clamp(($p - $wy10) / $wdy, 0, 1) + ($hn12 - $hn11) * clamp(($p - $wy11) / $wdy, 0, 1) + ($hn13 - $hn12) * clamp(($p - $wy12) / $wdy, 0, 1))) - $mg
      $yA = $p + sin($a1) / cos($a1) * ($xA - $xc)
      $xB = (($wx0 + $wd0 * clamp(($p - $wy0) / $ww0, 0, 1) + $wd1 * clamp(($p - $wy1) / $ww1, 0, 1) + $wd2 * clamp(($p - $wy2) / $ww2, 0, 1) + $wd3 * clamp(($p - $wy3) / $ww3, 0, 1) + $wd4 * clamp(($p - $wy4) / $ww4, 0, 1) + $wd5 * clamp(($p - $wy5) / $ww5, 0, 1) + $wd6 * clamp(($p - $wy6) / $ww6, 0, 1) + $wd7 * clamp(($p - $wy7) / $ww7, 0, 1) + $wd8 * clamp(($p - $wy8) / $ww8, 0, 1) + $wd9 * clamp(($p - $wy9) / $ww9, 0, 1) + $wd10 * clamp(($p - $wy10) / $ww10, 0, 1) + $wd11 * clamp(($p - $wy11) / $ww11, 0, 1) + $wd12 * clamp(($p - $wy12) / $ww12, 0, 1)) + ($hf0 + ($hf1 - $hf0) * clamp(($p - $wy0) / $wdy, 0, 1) + ($hf2 - $hf1) * clamp(($p - $wy1) / $wdy, 0, 1) + ($hf3 - $hf2) * clamp(($p - $wy2) / $wdy, 0, 1) + ($hf4 - $hf3) * clamp(($p - $wy3) / $wdy, 0, 1) + ($hf5 - $hf4) * clamp(($p - $wy4) / $wdy, 0, 1) + ($hf6 - $hf5) * clamp(($p - $wy5) / $wdy, 0, 1) + ($hf7 - $hf6) * clamp(($p - $wy6) / $wdy, 0, 1) + ($hf8 - $hf7) * clamp(($p - $wy7) / $wdy, 0, 1) + ($hf9 - $hf8) * clamp(($p - $wy8) / $wdy, 0, 1) + ($hf10 - $hf9) * clamp(($p - $wy9) / $wdy, 0, 1) + ($hf11 - $hf10) * clamp(($p - $wy10) / $wdy, 0, 1) + ($hf12 - $hf11) * clamp(($p - $wy11) / $wdy, 0, 1) + ($hf13 - $hf12) * clamp(($p - $wy12) / $wdy, 0, 1))) + $mg
      $yB = $p + sin($a2) / cos($a2) * ($xB - $xc)
      $gap = $xB - $xA
      $fsnap = clamp(ceil(0.5 * $snapped - $q1), 0, 1)
      $fstub = clamp(ceil(0.5 * $snapped + $stub - $q1), 0, 1) * (1 - $fsnap)
      $fpull = clamp(ceil(0.5 * $snapped + $stub + $pulled - $q1), 0, 1) * (1 - $fsnap) * (1 - $fstub)
      $fgone = clamp(ceil(0.5 * $snapped + $stub + $pulled + 0.5 * $gone - $q1), 0, 1) * (1 - $fsnap) * (1 - $fstub) * (1 - $fpull)
      $fbend = (1 - $fsnap) * (1 - $fstub) * (1 - $fpull) * (1 - $fgone)
      $pfar = clamp(ceil($q10 - 0.5), 0, 1)
      $ext = 6 + 16 * $q9
      if ($fgone > 0.5) {
        add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=(($xA - 3.0 - 4.0 * $q9) - ($cover)) / cos($a1), roll=0.0, at=($cover, $p + sin($a1) / cos($a1) * (($cover) - $xc), $z), rotate=(0.0, 0.0, $a1), join=none)
      } else {
        if ($fpull * (1 - $pfar) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=(($xA - $ext) - ($cover)) / cos($a1), roll=0.0, at=($cover, $p + sin($a1) / cos($a1) * (($cover) - $xc), $z), rotate=(0.0, 0.0, $a1), join=none)
        } else {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=(($xA + 0.6) - ($cover)) / cos($a1), roll=0.0, at=($cover, $p + sin($a1) / cos($a1) * (($cover) - $xc), $z), rotate=(0.0, 0.0, $a1), join=none)
          if ($fsnap > 0.5) {
            add($RodArc, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$gap * (0.3 + 0.35 * $q9) + 3.0, angle=$droop * (0.3 + 0.7 * $q5), roll=22.5, at=($xA, $yA, $z), rotate=(20.0 * (2 * $q11 - 1), 0.0, $a1 + $sgn * (3.0 + 12.0 * $q3)), join=none)
          }
          if ($fstub > 0.5) {
            add($RodArc, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=2.0 + 6.0 * $q9, angle=10.0 + 25.0 * $q5, roll=22.5, at=($xA, $yA, $z), rotate=(20.0 * (2 * $q11 - 1), 0.0, $a1 + $sgn * 8.0 * $q3), join=none)
          }
          if ($fpull * $pfar > 0.5) {
            add($RodArc, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$gap * (0.5 + 0.4 * $q9) + 6.0, angle=$hang * (0.75 + 0.25 * $q2), roll=22.5, at=($xA, $yA, $z), rotate=(20.0 * (2 * $q11 - 1), 0.0, $a1 + $sgn * (2.0 + 8.0 * $q3)), join=none)
          }
        }
      }
    }
    loop (repeat=$nbx_) {
      $j = output.index - 1
      $g = $noise * 1009 + $j + 1500
      $q0 = sin(($g) * 12.9898 + 0.3) * 43758.5453
      $q0 = $q0 - floor($q0)
      $q1 = sin(($g) * 12.9898 + 1.9) * 43758.5453
      $q1 = $q1 - floor($q1)
      $q2 = sin(($g) * 12.9898 + 3.1) * 43758.5453
      $q2 = $q2 - floor($q2)
      $q3 = sin(($g) * 12.9898 + 4.7) * 43758.5453
      $q3 = $q3 - floor($q3)
      $q4 = sin(($g) * 12.9898 + 6.1) * 43758.5453
      $q4 = $q4 - floor($q4)
      $q5 = sin(($g) * 12.9898 + 7.3) * 43758.5453
      $q5 = $q5 - floor($q5)
      $q6 = sin(($g) * 12.9898 + 8.9) * 43758.5453
      $q6 = $q6 - floor($q6)
      $q7 = sin(($g) * 12.9898 + 10.7) * 43758.5453
      $q7 = $q7 - floor($q7)
      $q8 = sin(($g) * 12.9898 + 11.3) * 43758.5453
      $q8 = $q8 - floor($q8)
      $q9 = sin(($g) * 12.9898 + 12.1) * 43758.5453
      $q9 = $q9 - floor($q9)
      $q10 = sin(($g) * 12.9898 + 13.7) * 43758.5453
      $q10 = $q10 - floor($q10)
      $q11 = sin(($g) * 12.9898 + 14.3) * 43758.5453
      $q11 = $q11 - floor($q11)
      $sgn = 2 * clamp(ceil($q6 - 0.5), 0, 1) - 1
      $z = $zTY
      $p = 0.5 * $size_x + ($j - 0.5 * ($nbx_ - 1)) * $spacing + (2 * $q0 - 1) * $bar_jitter
      $yw = $bar_yaw * (2 * $q7 - 1)
      $kk = $bar_kink * (2 * $q8 - 1)
      $mY = $mg + 0.9
      $whole = clamp(ceil($nmin - $mY - $p), 0, 1)
      if ($whole > 0.5) {
        add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=((0.5 * $size_y + 0.6) - ($cover)) / cos($yw - $kk), roll=0.0, at=($p - sin($yw - $kk) / cos($yw - $kk) * (($cover) - 0.5 * $size_y), $cover, $z), rotate=(0.0, 0.0, 90.0 + $yw - $kk), join=none)
        add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=(($size_y - $cover) - (0.5 * $size_y - 0.6)) / cos($yw + $kk), roll=22.5, at=($p - sin($yw + $kk) / cos($yw + $kk) * ((0.5 * $size_y - 0.6) - 0.5 * $size_y), 0.5 * $size_y - 0.6, $z), rotate=(0.0, 0.0, 90.0 + $yw + $kk), join=none)
      } else {
        $s0 = max($wy0 - 0.3, $cover)
        $s1 = min($wy1 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx0, min($nm0, $nx1)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=0.0, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy1 - 0.3, $cover)
        $s1 = min($wy2 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx1, min($nm1, $nx2)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=22.5, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy2 - 0.3, $cover)
        $s1 = min($wy3 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx2, min($nm2, $nx3)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=0.0, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy3 - 0.3, $cover)
        $s1 = min($wy4 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx3, min($nm3, $nx4)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=22.5, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy4 - 0.3, $cover)
        $s1 = min($wy5 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx4, min($nm4, $nx5)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=0.0, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy5 - 0.3, $cover)
        $s1 = min($wy6 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx5, min($nm5, $nx6)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=22.5, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy6 - 0.3, $cover)
        $s1 = min($wy7 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx6, min($nm6, $nx7)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=0.0, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy7 - 0.3, $cover)
        $s1 = min($wy8 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx7, min($nm7, $nx8)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=22.5, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy8 - 0.3, $cover)
        $s1 = min($wy9 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx8, min($nm8, $nx9)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=0.0, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy9 - 0.3, $cover)
        $s1 = min($wy10 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx9, min($nm9, $nx10)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=22.5, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy10 - 0.3, $cover)
        $s1 = min($wy11 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx10, min($nm10, $nx11)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=0.0, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy11 - 0.3, $cover)
        $s1 = min($wy12 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx11, min($nm11, $nx12)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=22.5, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
        $s0 = max($wy12 - 0.3, $cover)
        $s1 = min($wy13 + 0.3, $size_y - $cover)
        if (clamp(ceil(min($nx12, min($nm12, $nx13)) - $mY - $p), 0, 1) * clamp(ceil($s1 - $s0 - 1), 0, 1) > 0.5) {
          add($RodX, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=$s1 - $s0, roll=0.0, at=($p, $s0, $z), rotate=(0.0, 0.0, 90.0), join=none)
        }
      }
    }
  }
  if ($crush > 0.5) {
    $ncr = floor($crush + 0.5)
    loop (repeat=$ncr) {
      $c = output.index - 1
      $u1 = sin(($noise * 1009 + 900 + $c) * 12.9898 + 0.7) * 43758.5453
      $u1 = $u1 - floor($u1)
      $u2 = sin(($noise * 1009 + 900 + $c) * 12.9898 + 2.3) * 43758.5453
      $u2 = $u2 - floor($u2)
      $u3 = sin(($noise * 1009 + 900 + $c) * 12.9898 + 4.1) * 43758.5453
      $u3 = $u3 - floor($u3)
      $cy = 14.0 + ($size_y - 28.0) * ($c + 0.5 + 0.35 * (2 * $u1 - 1)) / max($ncr, 1)
      $cs = 0.35 * $thick + 0.45 * $thick * $u2
      $cx = (($wx0 + $wd0 * clamp(($cy - $wy0) / $ww0, 0, 1) + $wd1 * clamp(($cy - $wy1) / $ww1, 0, 1) + $wd2 * clamp(($cy - $wy2) / $ww2, 0, 1) + $wd3 * clamp(($cy - $wy3) / $ww3, 0, 1) + $wd4 * clamp(($cy - $wy4) / $ww4, 0, 1) + $wd5 * clamp(($cy - $wy5) / $ww5, 0, 1) + $wd6 * clamp(($cy - $wy6) / $ww6, 0, 1) + $wd7 * clamp(($cy - $wy7) / $ww7, 0, 1) + $wd8 * clamp(($cy - $wy8) / $ww8, 0, 1) + $wd9 * clamp(($cy - $wy9) / $ww9, 0, 1) + $wd10 * clamp(($cy - $wy10) / $ww10, 0, 1) + $wd11 * clamp(($cy - $wy11) / $ww11, 0, 1) + $wd12 * clamp(($cy - $wy12) / $ww12, 0, 1)) - ($hn0 + ($hn1 - $hn0) * clamp(($cy - $wy0) / $wdy, 0, 1) + ($hn2 - $hn1) * clamp(($cy - $wy1) / $wdy, 0, 1) + ($hn3 - $hn2) * clamp(($cy - $wy2) / $wdy, 0, 1) + ($hn4 - $hn3) * clamp(($cy - $wy3) / $wdy, 0, 1) + ($hn5 - $hn4) * clamp(($cy - $wy4) / $wdy, 0, 1) + ($hn6 - $hn5) * clamp(($cy - $wy5) / $wdy, 0, 1) + ($hn7 - $hn6) * clamp(($cy - $wy6) / $wdy, 0, 1) + ($hn8 - $hn7) * clamp(($cy - $wy7) / $wdy, 0, 1) + ($hn9 - $hn8) * clamp(($cy - $wy8) / $wdy, 0, 1) + ($hn10 - $hn9) * clamp(($cy - $wy9) / $wdy, 0, 1) + ($hn11 - $hn10) * clamp(($cy - $wy10) / $wdy, 0, 1) + ($hn12 - $hn11) * clamp(($cy - $wy11) / $wdy, 0, 1) + ($hn13 - $hn12) * clamp(($cy - $wy12) / $wdy, 0, 1))) + 0.2 * $cs
      add($Chunk, size=$cs, ar=0.55 + 0.35 * $u3, tr=0.4 + 0.3 * $u1, faces=6.0 + 4.0 * $u2, even=15.0 * $u3, rough=$chunk_rough_, noise=$noise * 1009 + 900 + $c, at=($cx, $cy, -$thick + 0.3 * $cs), rotate=(30.0 * (2 * $u1 - 1), 30.0 * (2 * $u2 - 1), 360.0 * $u3), join=none)
    }
  }
}

