# BROKEN CONCRETE — the damage kit's concrete subjects (Docs/GC-SHAPE-DAMAGE-KIT.md, C1, tier 1).
# GENERATED by Content/__MCPTests/DamageKit/gen/genconcrete.py: edit the generator, not this file.
#
#   BC = shape('/GraphCodeShape/Presets/BrokenConcrete', Face = $MyCast, Broken = $MyAggregate, Steel = $MyRebar)
#   Ruin = mesh() { add($BC.Slab, hole_rx=55.0, hole_ry=40.0, noise=7)  add($BC.SlabDebris, hole_rx=55.0, hole_ry=40.0, noise=7, at=(0, 0, -330)) }
#
# THE REINFORCED FLOOR SLAB MODULE (`Slab`). Frame: origin at the top-surface min corner, the slab
# from z = -thick to 0, a `size_x` x `size_y` module on the kit grid. Every look-defining number is a
# knob with a default; the seed knob is `noise` (`seed=` is reserved on add/subtract), every draw is
# keyed `noise * 1009 + index`.
#   - `hole_rx`/`hole_ry` > 0 BREACHES it through `SlabBreach` (the cutter entry): the union of a
#     through CORE (`rim`, `cone` narrower at the top), a top CRATER funnel (`crater` x wide at the skin,
#     narrowing by `funnel` over `crater_d` of the depth, `crater_rim`, chunks bitten out by `bite`) and
#     an underside SCAB funnel (`scab`, `scab_rim`, `scab_d`), each its own seeded 24-point outline,
#     roughened coarse (`coarse` at `rough`; `mid` at `fine` a second octave, off by default).
#   - THE STONES: every break face (they wear `cut`) gets one faceted octave at aggregate size, `stone`
#     cm of relief on `stone_size` cm cells, faded out at the break's edge: stones proud, pits, steps.
#   - BARS (`bar` #4, `spacing`, `cover`; `mats` 2 adds a top mat) are drawn only when the slab is
#     broken, in `Steel`, `join=none`: each `bar_jitter` cm off its grid line and `bar_yaw` degrees off
#     its direction, kinked once by `bar_kink`; two pieces of one bar overlap 0.6 cm with their sections
#     turned 22.5 degrees, so no two piece ends coincide. A bar crossing the opening reads its
#     ENVELOPE (the breach's outline at its depth, worst case, less roughen and stones) and draws its
#     own fate: snapped (two ends bent down on arcs through up to `droop` degrees, each its own length,
#     sideways turn and roll), snapped short (`stub`), PULLED (`pulled`: torn out of one side, hanging
#     through the hole from the other on an arc of up to `hang` degrees), gone (`gone`), else it SAGS
#     (`sag`, low point off-centre, `lean` sideways, an S-`twist`). Snapping is likelier mid-hole.
#   - `band` > 0 is the FOLD (`_Wrecked`). Its line is WALKED along Y: each station steps from the last
#     by a smooth draw (`walk`) or now and then a sudden jog (`jog` share, `jog_size` cm), pulled toward
#     a per-seed slanted base (`band_x` +- `wander`, `slant`). Its two lips lie the line's half-widths
#     either side (`band` x (1 +- `band_rim`)) and are SPALLED top and underside in ragged patches
#     (`lip` cm wide, `lip_d` x cover deep, so the underside spalls bare the bars). The far piece tore
#     from its neighbours along both sides (`tear`) and BREAKS INTO PLATES (`plates` 3, one fewer on a
#     `plate_merge` share of seeds; 1 is one rigid piece). Each main crack (`crack_w` cm wide) WALKS
#     from the band to the module's end inside the gap between two X bars (`crack_walk`), and on a
#     `crack_cross` share crosses the next bar on a diagonal, which then bends across the crack from
#     plate to plate or snaps there; the gaps the cracks leave the lip in are drawn, so the plates
#     differ in size. Up to two SHARDS (`shards`, the second on a `shard_two` share) break off at the
#     fold, each between a main crack and a BRANCH crack (`branch_w` wide) that leaves the lip one gap
#     over and runs into the main crack `shard_len` cm out, holding one X bar. Each plate and shard is
#     hinged at the lowest point of its own lip, DROPS (`drop`, varied per plate) and turns on two
#     axes: pitched down by `fold` (+- `fold_var` per seed, +- `plate_var` per plate, a shard
#     `shard_fold` off its plate) and rolled by up to `tilt` degrees, hanging from the bars across the
#     gap. Every plate edge on a crack is SPALLED and chipped (`edge` cm wide, `edge_d` x cover deep on
#     top, `edge_chip` x cover under), and each plate is cracked across its top `bend_crack` times
#     (V-grooves `bend_w` cm wide, `bend_d` x thick deep, the first parallel to the fold, the others
#     slanted). Each crossing bar draws its fate: snapped, snapped
#     short, pulled out of one piece and hanging from the other (`hang`), torn out, else BENT across the
#     gap on its own curve (tangents 0.35-1.2 x the chord at each lip, bowed sideways by up to `twist`)
#     to the plate it enters. The Y bars crossing a plate crack are bent across it from plate to plate,
#     or snapped there (`snapped`). `crush` chunks stay wedged against each lip. Bars along the fold
#     that lay in the band fell (debris). A plate's OUTER END TORE from the slab beyond (`EndCut`): one
#     torn line across the module's far end, `tend` cm back on average, wandering (`tend_walk`) and
#     stepping (`tend_jag`) at drawn places; above the bottom mat it broke back further by a walked
#     `tend_lift`, the step's height itself walking along the end (`tend_step`, round 7: no two even shelves),
#     its top arris spalled like a crack's; roughened `tend_rough` x `coarse` (stones with `tend_stone`), then a
#     mid-scale octave on the torn wall only (`tend_mid`, 5 cm cells at budget 1); it never bares the last Y bar,
#     and the X bars stand `tend_bar` past their cover, so they stick out where it tore back.
#   - AGED SKIN AND AGE IN GEOMETRY, every state (kit 12.3; round 7): the top lies `skin` cm out of plane on a
#     field of four plane waves with WHOLE cycles across the module, drawn from `noise`, so the top at each
#     boundary equals the opposite one and modules tile with no step and no flat frame (`skin_edge` above 0 fades
#     it out instead). Then, by `age` (the wrappers scale each knob; 0 a new cast skin): the top ARRISES chipped,
#     floor(`skin_chips` x 1.5-4) bites per arris of 0.25-1.35 x `skin_chip` cm, most small; POP-OUTS, `pop` per
#     m2 of faceted pits `pop_size` cm wide (1-3), 0.3-0.5 of that deep; SCALING, `scale_n` per m2 of patches
#     `scale_size` cm across (10-40), `scale_d` cm deep (3-8 mm), ragged, most flaked in two layers; and above
#     age 1 at budget 1 or more, `shrink` SHRINKAGE CRACKS, wandering grooves 30-90 cm long, `shrink_w` wide,
#     `shrink_d` deep. All one cutter (`SlabAge`) in the module frame, after the stones, painted `Broken`; a
#     feature that reaches over an edge is cut again one module over, so a neighbour carries the rest of it.
#     Map cracking, stains and fine pitting are the texture tier.
# SLOTS: `Face` the cast skin, `Broken` every break face, `Steel` the bars. They have NO default path
# (a shipped preset never names a `/Game` asset): bind them at import, as above.
# UVs: one box mapping, `tile` cm a tile, written after the break; then (`uvfit` 1) the break faces are
# split by facing: the six axes, then the twelve edge and eight corner directions as narrow windows,
# so no face is mapped onto a plane far off its own (a fold piece writes only its lip's half); `uvfit` 2
# is the six axis windows alone, 0 the box alone. `_Wrecked` uses 0: MEASURED at its budget, the box
# reads stretch 1.63 against 3.15 with the windows, for more self-overlapping torn islands; `_Broken` too
# from round 6 (the lead's ruling after round 3: one UV rule across the slab's states). Every
# bar is cylinder-mapped along its own length before it is bent (`bar_tile` along, `bar_tile /
# bar_aspect` around); arcs and spans keep arc length. Debris pieces are mapped in their own frames.
# DEBRIS (`SlabDebris`): the same knobs; on its own ground (z = 0) in the module's frame. Its pieces
# share `keep` of the removed volume: one or two big slab pieces, full-depth, half-depth and thin spall
# plates (about half the volume), ANGULAR chunks (6-10 planes, flattened, the big ones lightly rough) head,
# fist-to-head, fist and fine size, and the bar each fate lost (snapped middles, torn-out runs, the
# fold's fallen bars) as pieces at most `bit_max` long, arched and waved, a `bit_kink` share bent hard
# once (an L or a hook), lying on top.
#
# STATES (kit 2.0): each a wrapper below taking the top-level knobs, each built with the same grid box and pivot.
#
# KNOBS (kit 11a): the TOP-LEVEL ones first (the state wrappers SlabIntact/SlabBroken/SlabWrecked and their
# debris take exactly these, clamped to the range), then the ADVANCED ones of `Slab` and `SlabDebris`.
#   KNOB         DEFAULT  RANGE      UNIT          MEANING
#   size_x       200.0    100-400    cm            module length along x (the fold runs across it)
#   size_y       200.0    100-400    cm            module width along y
#   thick        15.0     10-30      cm            slab thickness
#   damage       1.0      0.3-2      x             how broken (wrappers only): breach radii, bar fates and sag; fold pitch, drop, roll and the torn ends
#   age          1.0      0-2        x             how worn (wrappers only), in geometry: the skin out of plane (0.5 cm x age), arris chips (count and size), pop-outs, scaling patches, and above 1 shrinkage cracks (budget 1+); 0 a new cast skin
#   softness     -        0-1        x             owner, round 7: 0 crisp breaks (the default); 1 worn smooth: the blank arrises rounded up to 1.5 cm, chips and pop-outs rounded scoops, scaling rims eased, cracks wider; independent of age; the break faces stay crisp; the debris ignores it
#   noise        1        1-99999    seed          the seed: every draw is keyed noise * 1009 + index
#   budget       1        0-2        tier          0 game, 1 high, 2 ultra: the skin grid and the torn ends' cells (the build line's [triangles=] is the ceiling)
#   ---------------------------------------- advanced
#   bar          1.27     0.95-2.5   cm            bar diameter (#4 = 1.27)
#   spacing      30.0     15-45      cm            bar spacing
#   cover        3.8      2-8        cm            concrete cover to the bars
#   mats         1        1-2        count         2 adds a top mat
#   bar_jitter   2.5      0-5        cm            each bar off its grid line
#   bar_yaw      0.6      0-2        deg           each bar off its direction
#   bar_kink     0.4      0-1        share         share of bars kinked once
#   hole_x       100.0    in module  cm            breach centre x
#   hole_y       100.0    in module  cm            breach centre y
#   hole_rx      0.0      0-55       cm            breach radius x (0: no breach)
#   hole_ry      0.0      0-55       cm            breach radius y
#   rim          0.3      0-0.6      x             core outline raggedness
#   crater_rim   0.6      0-1        x             crater outline raggedness
#   scab_rim     0.45     0-1        x             scab outline raggedness
#   bite         0.25     0-0.5      x             chunks bitten from the crater
#   scab         1.3      1-1.6      x             scab width over the hole
#   crater       1.18     1-1.5      x             crater width over the hole
#   crater_d     0.45     0.2-0.7    x thick       crater depth
#   scab_d       0.45     0.2-0.7    x thick       scab depth
#   funnel       0.3      0-0.5      x             crater narrowing with depth
#   cone         0.1      0-0.3      x             core narrower at the top
#   coarse       1.8      0.5-3      cm            break faces' coarse roughen
#   mid          0.0      0-1.5      cm            second roughen octave (off)
#   rough        14.0     8-24       cm            coarse roughen cell
#   fine         10.0     5-15       cm            second octave cell
#   ramp_rough   1.75     1-2.5      x             roughen growth toward the crater/scab rims
#   stone        1.3      0-2        cm            stones proud on the break faces
#   stone_size   8.0      5-14       cm            stone cell
#   stone_cut    0        0-1        flag          1: no stones on the breach
#   stone_fade   0.0      0-3        cm            stones faded at the rim (0: a Z band)
#   sag          16.0     0-30       cm            a held bar's sag
#   lean         0.3      0-1        x             its sideways lean
#   twist        3.0      0-8        cm            its S-twist
#   snapped      0.3      0-0.6      share         bars snapped
#   stub         0.1      0-0.3      share         snapped short
#   pulled       0.15     0-0.4      share         pulled out of one side
#   gone         0.1      0-0.3      share         bars gone
#   droop        55.0     20-80      deg           snapped ends' bend
#   hang         85.0     40-90      deg           pulled bars' hang
#   band         0.0      0-40       cm            the fold band width (0: no fold)
#   band_x       110.0    in module  cm            fold line x
#   band_rim     0.4      0-0.8      x             lip widths either side
#   wander       12.0     0-25       cm            fold line wander
#   slant        0.12     0-0.3      x             fold line slant
#   walk         5.0      0-10       cm            fold line step
#   jog          0.25     0-0.5      share         sudden jogs
#   jog_size     14.0     0-25       cm            jog size
#   lip          7.0      0-12       cm            lip spall width
#   lip_d        1.15     0.5-1.5    x cover       lip spall depth
#   tear         7.0      3-12       cm            side tears' depth
#   fold         25.0     8-45       deg           plate pitch
#   fold_var     0.3      0-0.5      x             per-seed pitch variation
#   tilt         3.5      0-7        deg           plate roll
#   drop         9.0      0-18       cm            plate drop
#   crush        5        0-8        count         chunks wedged at each lip
#   plates       3        1-3        count         plates the far part breaks into
#   plate_merge  0.35     0-1        share         seeds with one fewer
#   plate_var    0.4      0-0.6      x             per-plate pitch variation
#   crack_w      7.0      4-10       cm            main crack width
#   crack_walk   4.0      0-6        cm            main crack coarse wander
#   crack_cross  0.75     0-1        share         cracks crossing a bar
#   crack_rough  0.5      0-1        x coarse      crack walls' roughen
#   crack_stone  0.0      0-1        x stone       stones on the crack walls (off: UV stretch)
#   crack_jag    3.2      0-5        cm            crack walls' mid-scale steps
#   crack_calm   0.3      0-0.8      share         calmer stretches
#   crack_step   0.5      0-1        share         points that step
#   crack_slope  1.5      0.8-2.5    x             steepest jog (1.5 = 56 deg)
#   crack_gap    0.18     0-0.4      x             gap width wander
#   crack_diag   0.35     0-1        x             jitter on a crossing
#   crack_cell   1.0      0.6-1.6    x stone_size  wall stones' cell
#   shards       2        0-2        count         shards at the fold
#   shard_two    0.5      0-1        share         seeds with a second
#   shard_len    28.0     15-40      cm            shard length
#   shard_fold   10.0     0-20       deg           shard pitch off its plate
#   branch_w     4.5      3-7        cm            branch crack width
#   edge         4.5      0-8        cm            crack-edge spall width
#   edge_d       0.6      0.3-1      x cover       its depth
#   edge_chip    0.5      0-1        x cover       underside chips
#   bend_crack   2        0-3        count         skin cracks per plate
#   bend_w       2.2      1-4        cm            their width
#   bend_d       0.38     0.2-0.6    x thick       their depth
#   tile         100.0    50-200     cm            UV tile on the concrete
#   bar_tile     100.0    50-200     cm            UV tile along a bar
#   bar_aspect   1.0      1-4        x             along / around
#   uvfit        1        0-2        mode          0 box (shipped), 1 facing windows, 2 axis windows
#   skin         0.5      0-1.2      cm            top out of plane: a field periodic in the module (whole cycles), so modules tile (wrappers set 0.5 x age)
#   skin_edge    0.0      0-40       cm            0 (round 7): no fade, the periodic field tiles; above 0 round 6's return to the field's zero over that width
#   skin_chips   1.0      0-2        x             chips per top arris: floor(x (1.5 + 2.5 draw)), 0 none (wrappers set x age)
#   skin_chip    5.0      3-9        cm            chip size, 0.25-1.35 x, most small (wrappers 3 + 2 x age)
#   pop          2.5      0-10       per m2        pop-outs: shallow faceted pits (wrappers 2.5 x age x (0.6 + 0.4 x age))
#   pop_size     1.8      1-3        cm            a pop-out's mean width (0.55-1.65 x), 0.3-0.5 of it deep (wrappers 1.4 + 0.4 x age)
#   scale_n      0.5      0-3        per m2        scaling: patches where the top layer flaked off (wrappers 0.5 x age x age)
#   scale_size   22.5     10-40      cm            a patch's mean width (0.45-1.25 x; wrappers 15 + 7.5 x age)
#   scale_d      0.5      0.3-0.8    cm            a patch's depth (0.6-1.2 x; wrappers 0.3 + 0.2 x age)
#   shrink       0.0      0-8        count         shrinkage cracks: shallow wandering grooves 30-90 cm long, budget 1 or more (wrappers 4 x (age - 1) above age 1)
#   shrink_w     0.45     0.2-0.8    cm            their width at the middle (0.7-1.3 x), tapering to a point
#   shrink_d     0.8      0.4-1.5    cm            their depth (0.7-1.3 x)
#   tend         4.0      0-8        cm            plates' torn ends: mean tear-back (0: round 5's flat end)
#   tend_walk    2.0      0-4        cm            its slow wander
#   tend_jag     2.2      0-4        cm            its stepped level
#   tend_lift    5.0      0-8        cm            upper part broken back further
#   tend_lean    3.0      0-5        cm            lower part's lean
#   tend_rough   0.85     0-1.2      x coarse      torn face roughen
#   tend_cell    0.8      0.5-1.2    x rough       its cell
#   tend_stone   0.0      0-1        x stone       stones on the torn ends (off: UV stretch)
#   tend_bar     2.0      0-3        cm            X bars past their cover at the end (stubs)
#   soft         0.0      0-1        x             the softness of the wrappers, clamped (0 crisp)
#   tend_step    1.0      0-1        x             the step between the end's lower and upper parts walks up and down along the end (0: one level, round 6)
#   tend_mid     1.0      0-1.5      x             a mid-scale faceted octave (5 cm cells at budget 1, 3.75 at 2, off at 0) on the torn wall only
#   keep         0.93     0.7-1.1    x             debris: share of the removed volume
#   spread       1.3      1-2        x             debris spread
#   pile         0.5      0-1        x             debris heap
#   chunk_rough  0.03     0-0.06     x             big chunks' roughen
#   bit_max      16.0     8-30       cm            longest loose bar piece
#   bit_kink     0.6      0-1        share         pieces bent hard

build {
  SM_ConcreteSlab_Intact         = $SlabIntact        [bounds=(200, 200, *), pivot=(0, 0, 0), triangles=4000]
  SM_ConcreteSlab_Broken         = $SlabBroken        [bounds=(200, 200, *), pivot=(0, 0, 0), triangles=10000]
  SM_ConcreteSlab_Wrecked        = $SlabWrecked       [bounds=(200, 200, *), pivot=(0, 0, 0), triangles=20000]
  SM_ConcreteSlab_Broken_Debris  = $SlabBrokenDebris  [bounds=(240, 240, *), pivot=(0, 0, 0), triangles=10000]
  SM_ConcreteSlab_Wrecked_Debris = $SlabWreckedDebris [bounds=(240, 240, *), pivot=(0, 0, 0), triangles=12000]
}

Face   = material()
Broken = material()
Steel  = material()

# a corner where the reading leaves its held end: the edge spalls' floors (round 4, CrackCut and BranchCut)
Hinge = profile(0 = 0@sharp, 1 = 1)

# ---- the subjects: one entry per state (a build line cannot pass knob values, kit 4.1 (a)); each leads with the
# TOP-LEVEL knobs (kit 11a), clamped here to their documented ranges (a value past one is clamped, never a broken
# mesh): `size_x`, `size_y` 100-400 cm, `thick` 10-30 cm, `damage` 0.3-2 (1 = the shipped state), `age` 0-2 (0 a
# new cast skin, 1 the shipped aged skin, 2 old: in geometry, the skin out of plane, arris chips, pop-outs,
# scaling patches and, above 1, shrinkage cracks), `softness` 0-1 (owner, round 7: 0 crisp breaks, the default; 1 worn
# smooth: rounded arrises and scars, eased rims; the debris ignores it), `noise` the seed, `budget` 0-2 (0 game, 1 high, 2 ultra: the
# recipe's own detail; the build line's `[triangles=]` is the ceiling). The slots `Face`, `Broken`, `Steel` follow.
SlabIntact = mesh(size_x=200.0, size_y=200.0, thick=15.0, damage=1.0, age=1.0, softness=0.0, noise=1, budget=1) {
  $tsf = clamp($softness, 0, 1)
  $tsx = clamp($size_x, 100, 400)
  $tsy = clamp($size_y, 100, 400)
  $tth = clamp($thick, 10, 30)
  $tdm = clamp($damage, 0.3, 2)
  $tag = clamp($age, 0, 2)
  $tno = clamp(floor($noise), 1, 99999)
  $tbu = clamp(floor($budget + 0.5), 0, 2)
  $tsc = min($tsx, $tsy) / 200
  add($Slab, size_x=$tsx, size_y=$tsy, thick=$tth, noise=$tno, budget=$tbu, skin=0.5 * $tag, skin_chips=$tag, skin_chip=3.0 + 2.0 * $tag, pop=2.5 * $tag * (0.6 + 0.4 * $tag), pop_size=1.4 + 0.4 * $tag, scale_n=0.5 * $tag * $tag, scale_size=15.0 + 7.5 * $tag, scale_d=0.3 + 0.2 * $tag, shrink=4.0 * max($tag - 1, 0), soft=$tsf)
}
SlabBroken = mesh(size_x=200.0, size_y=200.0, thick=15.0, damage=1.0, age=1.0, softness=0.0, noise=1, budget=1) {
  $tsf = clamp($softness, 0, 1)
  $tsx = clamp($size_x, 100, 400)
  $tsy = clamp($size_y, 100, 400)
  $tth = clamp($thick, 10, 30)
  $tdm = clamp($damage, 0.3, 2)
  $tag = clamp($age, 0, 2)
  $tno = clamp(floor($noise), 1, 99999)
  $tbu = clamp(floor($budget + 0.5), 0, 2)
  $tsc = min($tsx, $tsy) / 200
  $thx = $tsx * 92.0 / 200.0
  $thy = $tsy * 106.0 / 200.0
  $trm = min(min($thx, $tsx - $thx), min($thy, $tsy - $thy)) / (1.75 * (0.85 + 0.15 * max($tdm, 1)))
  add($Slab, size_x=$tsx, size_y=$tsy, thick=$tth, noise=$tno, budget=$tbu, hole_x=$thx, hole_y=$thy, hole_rx=min(40.0 * $tsc * $tdm, 0.8 * $trm), hole_ry=min(50.0 * $tsc * $tdm, $trm), crater=1.18 * (0.85 + 0.15 * $tdm), snapped=min(0.3 * $tdm, 0.6), sag=min(16.0 * $tdm, 30.0), uvfit=0, skin=0.5 * $tag, skin_chips=$tag, skin_chip=3.0 + 2.0 * $tag, pop=2.5 * $tag * (0.6 + 0.4 * $tag), pop_size=1.4 + 0.4 * $tag, scale_n=0.5 * $tag * $tag, scale_size=15.0 + 7.5 * $tag, scale_d=0.3 + 0.2 * $tag, shrink=4.0 * max($tag - 1, 0), soft=$tsf)
}
SlabWrecked = mesh(size_x=200.0, size_y=200.0, thick=15.0, damage=1.0, age=1.0, softness=0.0, noise=1, budget=1) {
  $tsf = clamp($softness, 0, 1)
  $tsx = clamp($size_x, 100, 400)
  $tsy = clamp($size_y, 100, 400)
  $tth = clamp($thick, 10, 30)
  $tdm = clamp($damage, 0.3, 2)
  $tag = clamp($age, 0, 2)
  $tno = clamp(floor($noise), 1, 99999)
  $tbu = clamp(floor($budget + 0.5), 0, 2)
  $tsc = min($tsx, $tsy) / 200
