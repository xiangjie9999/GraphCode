# a loose bar piece for the debris: arched by `curl`, waved sideways by `wob`
Path100b = plane() {
  points((0.0000, 0.0, 0.0), (12.5000, 0.0, 0.0), (25.0000, 0.0, 0.0), (37.5000, 0.0, 0.0), (50.0000, 0.0, 0.0), (62.5000, 0.0, 0.0), (75.0000, 0.0, 0.0), (87.5000, 0.0, 0.0), (100.0000, 0.0, 0.0))
}
RodRingedB = mesh(r=0.635) {
  circle(radius=$r, segments=8)
  sweep(along=$Path100b)
  material($Steel)
}
BarBit = mesh(r=0.635, len=40.0, curl=6.0, wob=2.0, waves=1.0, ph=0.0, kink=0.0, kat=0.5, tile=100.0, aspect=1.0) {
  add($RodRingedB, r=$r, scale=($len / 100.0, 1.0, 1.0), at=(-0.5 * $len, 0.0, 0.0))
  uv(cylinder, at=(0.0, 0.0, 0.0), facing=(1.0, 0.0, 0.0), up=(0.0, 0.0, 1.0), scale=($tile / $aspect, $tile))
  # the arch and the waves held to the piece's length (round 3: shorter pieces, MEASURED stretch 3.63 when a
  # 15 cm piece kept a 14 cm arch)
  $cu = min($curl, 0.12 * $len)
  $wb = min($wob, 0.06 * $len)
  warp(to=(point.x - point.z * ($cu * 3.14159 / $len * sin(360 * max((point.x + 0.5 * $len) / $len, 0.0001))) / sqrt(1 + ($cu * 3.14159 / $len * sin(360 * max((point.x + 0.5 * $len) / $len, 0.0001))) * ($cu * 3.14159 / $len * sin(360 * max((point.x + 0.5 * $len) / $len, 0.0001)))), point.y + $wb * sin(360 * $waves * max((point.x + 0.5 * $len) / $len, 0.0001) + $ph), $cu * pow(sin(180 * max((point.x + 0.5 * $len) / $len, 0.0001)), 2) + point.z / sqrt(1 + ($cu * 3.14159 / $len * sin(360 * max((point.x + 0.5 * $len) / $len, 0.0001))) * ($cu * 3.14159 / $len * sin(360 * max((point.x + 0.5 * $len) / $len, 0.0001))))))
  # round 3: a piece bent hard once (an L or a hook, as bars bent across a fold come out of the
  # rubble), `kink` degrees round a bend `$kl` cm long at `kat` of its length, lying flat; the bend keeps
  # arc length, so the mapping keeps its density along the bar
  if ($kink > 1) {
    $kl = min(0.3 * $len, 6.0)
