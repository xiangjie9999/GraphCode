            add($RodSag, r=$r, tile=$bar_tile, aspect=$bar_aspect, len=2 * $hs, roll=22.5, sag=$sag * (0.35 + 0.65 * $q2), k=0.7 + 0.7 * $q5, lat=$lean * $sag * (2 * $q6 - 1), tw=$twist * (2 * $q11 - 1), at=(($p - sin($yw) / cos($yw) * ($u0 - $hole_y)), $u0, $z), rotate=(0.0, 0.0, 90.0 + $yw), join=none)
