          $wsb = $hole_rx * $Gsb * sqrt(max(0, 1 - pow(($p - $hole_y) / ($hole_ry * max($Gsb, 0.01)), 2)))
          $Osb = $Fs * (1 + $scab_rim * (0.4 * sin(2 * $tsb + $sp1) + 0.2 * sin(3 * $tsb + $sp2) + 0.1 * sin(5 * $tsb + $sp3) + 0.3) + 0.5 * $bite)
          $osb = $hole_rx * $Osb * sqrt(max(0, 1 - pow(($p - $hole_y) / ($hole_ry * max($Osb, 0.01)), 2)))
