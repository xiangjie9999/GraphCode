RodSpan = mesh(r=0.635, len=30.0, ax=0.0, ay=0.0, az=0.0, bx=30.0, by=0.0, bz=0.0, t0x=30.0, t0y=0.0, t0z=0.0, t1x=30.0, t1y=0.0, t1z=0.0, tile=100.0, aspect=1.0) {
