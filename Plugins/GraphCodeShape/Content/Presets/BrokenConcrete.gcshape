# the same for a span that runs mostly along Y: a Y bar bent across a crack between two plates
RodSpanY = mesh(r=0.635, len=30.0, ax=0.0, ay=0.0, az=0.0, bx=0.0, by=30.0, bz=0.0, t0x=0.0, t0y=30.0, t0z=0.0, t1x=0.0, t1y=30.0, t1z=0.0, tile=100.0, aspect=1.0) {
