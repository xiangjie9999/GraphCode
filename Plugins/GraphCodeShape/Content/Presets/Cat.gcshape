gcshape 1 into:/Game/AnimalStudies/Cat smooth:.04 shade:80 uv:keep

# Domestic shorthair torso. Rounded flank, subtle waist and high croup.
# Override these centimetre dimensions at import. Positive LoinExtra lengthens
# the space between pelvis and ribs. Torso carries the six common landmarks.
build {
  SM_Cat = $Animal [pivot=(0,0,0)]
  SM_CatTorso = $Torso [pivot=(0,0,0)]
  SM_CatNeck = $Neck [pivot=(0,0,0)]
  SM_CatWithNeck = $WithNeck [pivot=(0,0,0)]
}

Defaults = shape('/GraphCodeShape/Presets/QuadrupedAnimal',Feline=$Feline)
# The lower jaw rests beneath the nasal collar. Distances on the border
# profiles are head-length fractions, sampled from occiput to muzzle.
EyeToPlanumFit = $Defaults.EyeToPlanumFit
EyeToPlanumRatio = $Defaults.EyeToPlanumRatio
PalpebralTurnInset = $Defaults.PalpebralTurnInset
SupraorbitalRimRadius = $Defaults.SupraorbitalRimRadius
