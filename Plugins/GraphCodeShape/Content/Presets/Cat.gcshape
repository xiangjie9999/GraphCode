# Relax span, strength and falloff are fractions of pinna breadth at the ear root.
PinnaSeamRelax = $Defaults.PinnaSeamRelax
PinnaSeamExtent = $Defaults.PinnaSeamExtent
PinnaSeamFalloff = $Defaults.PinnaSeamFalloff
# Growth-region distances follow the actual ear roots, lobe and lid opening.
