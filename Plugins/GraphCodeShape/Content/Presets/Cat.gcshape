hScale=$TrunkGirthScale,ShoulderStation=$ShoulderStation,HipStation=$HipStation,ForeTrack=$ForeTrack,HindTrack=$HindTrack,TailStation=$TailStation,TailRootLevel=$TailRootLevel,Length=$Length,LoinExtra=$LoinExtra,ChestWidth=$ChestWidth,ChestDepth=$ChestDepth,HipWidth=$HipWidth,WaistWidth=$WaistWidth,Tuck=$Tuck,CroupRise=$CroupRise,WitherRise=$WitherRise,Skin=$Skin,Reach=$NeckReach,Rise=$NeckRise,RootWidth=$NeckRootWidth,SkullWidth=$SkullWidth,SkullDepth=$SkullDepth,SkullPitch=$SkullPitch,ThroatFullness=$ThroatFullness,BreastProjection=$BreastProjection,JawInset=$JawInset,MuscleRelief=$MuscleRelief,ShoulderRelief=$ShoulderRelief,Stations=$NeckStations,Sides=$NeckSides)
Neck = mesh() {
  add($Cervical.Neck,join=none)
  save($SkullBand) [$output.SkullBand]
}
WithNeck = mesh() {
  add($Cervical.WithNeck,join=none)
  save($SkullBand) [$output.SkullBand]
}

# Whole-animal layer. Base supplies the shared family dimensions. Options
# binds all numeric overrides before individual feature defaults are selected.
# Each caller supplies a concrete torso at its requested tessellation.
# A landmark-bearing replacement preserves the named cervical transition band.
TorsoPart = mesh(source=$RequiredSurface,landmarks=1) {
  add($source,join=none)
  if ($landmarks > 0) { save($NeckBand) [$output.NeckBand] }
}
CervicalForm = instruction(baseline=$RequiredCervicalForm) { $baseline() }
