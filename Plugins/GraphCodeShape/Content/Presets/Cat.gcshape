Body = shape('/GraphCodeShape/Presets/QuadrupedTorso',RumpCapSpan=$RumpCapSpan,BreastCapStart=$BreastCapStart,BladeStationOffset=$BladeStationOffset,BladeRake=$BladeRake,BladeSpan=$BladeSpan,BladeRelief=$BladeRelief,HaunchStationOffset=$HaunchStationOffset,HaunchRake=$HaunchRake,HaunchSpan=$HaunchSpan,HaunchRelief=$HaunchRelief,KeelTaper=$KeelTaper,CervicalSeatStation=$CervicalSeatStation,CervicalSeatLevel=$CervicalSeatLevel,CervicalWithersShare=$CervicalWithersShare,CervicalSeatPitch=$CervicalSeatPitch,CervicalSeatBand=$CervicalSeatBand,ShoulderSeatLevel=$ShoulderSeatLevel,HipSeatLevel=$HipSeatLevel,HipCroupShare=$HipCroupShare,ShoulderSeatRake=$ShoulderSeatRake,HipSeatRake=$HipSeatRake,TailSeatSlope=$TailSeatSlope,LoinTravelOffset=$LoinTravelOffset,HipShareOffset=$HipShareOffset,RibShareOffset=$RibShareOffset,PelvisOffset=$PelvisOffset,WithersOffset=$WithersOffset,BackProfileOffset=$BackProfileOffset,UnderProfileOffsetScale=$UnderProfileOffsetScale,UnderProfileOffset=$UnderProfileOffset,FlankOffset=$FlankOffset,Feline=$Feline,SpineOffset=$SpineOffset,BellyOffset=$BellyOffset,TrunkGirthScale=$TrunkGirthScale,ShoulderStation=$ShoulderStation,HipStation=$HipStation,ForeTrack=$ForeTrack,HindTrack=$HindTrack,TailStation=$TailStation,TailRootLevel=$TailRootLevel, Length=$Length, LoinExtra=$LoinExtra, ChestWidth=$ChestWidth, ChestDepth=$ChestDepth, HipWidth=$HipWidth, WaistWidth=$WaistWidth, Tuck=$Tuck, CroupRise=$CroupRise, WitherRise=$WitherRise, Skin=$Skin)
TorsoStations = 56
TorsoSides = 48
StockTorso = mesh() {
  add($Body.Torso,stations=$TorsoStations,sides=$TorsoSides,join=none)
  save($NeckBand) [$output.NeckBand]
}
Torso = mesh() {
  add($TorsoPart,source=$StockTorso,landmarks=1,join=none)
  save($NeckBand) [$output.NeckBand]
}

NeckReach = .221*$Length
NeckRise = .25*$ChestDepth
NeckRootWidth = .88*$ChestWidth
SkullWidth = .64*$ChestWidth
