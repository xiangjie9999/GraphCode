gcshape 1  into:/GraphCodeShape/Presets  smooth:0.1  shade:40

# CONCRETE PARTS — the debris lane's concrete pieces (L2 primitives, one act each: Docs/GC-SHAPE-DEBRIS-LANE.md §1.1-1.2).
# GENERATED by Content/__MCPTests/DamageKit/gen/debris/gendebris.py: edit the generator, not this file.
#
#   CP = shape('/GraphCodeShape/Presets/ConcreteParts', Face = $MyCast, Broken = $MyAggregate)
#   Rubble = mesh() { add($CP.Chunk, size=18, damage=0.7, noise=4)  add($CP.Plate, w=40, at=(30, 0, 0)) }
#
# THE FRAME: a LYING piece, centred in X/Y with its largest face on z = 0 (the polyhedron's own rule). `Chunk` is an
# irregular plane-bounded mass whose bottom is cast skin; `Plate` an irregular prism, cast skin below (and above with
# `skins` 2), broken sides. SLOTS (pathless, bind at import): `Face` the cast skin, `Broken` every fresh break.
# UVs: one box map after the shaping, in the piece's own frame, `tile` cm a tile (skin and break share the density).
#   STATES AND TIERS: every piece ships three build lines from one recipe (kit §12.1, §8a.6: the budget is the author's,
#   no ceiling): `_Game` (`budget=0`), `_High` (`budget=1`), `_Ultra` (`budget=2`). Pass any `budget` and your own
#   `[triangles=]` for another weight.
#   SAFE TO TURN (kit §11a): every knob is clamped to the range stated beside it inside the recipe, so a value past it
#   builds the nearest good piece, never a broken mesh. A knob written -1 is AUTO: drawn from `noise` (and `damage`).
#   SEED: `noise` (`seed=` is reserved on add); every draw is a sine hash keyed `noise * 1009 + k`, so an edit above an
#   entry never re-rolls it.
#
# TOP-LEVEL KNOBS (the same names in every kit file), then ADVANCED:
#   Chunk(size, damage, age, noise, budget | ar, tr, faces, even, rough, skin, tile)
#   Plate(w, damage, age, noise, budget | d, t, faces, even, skins, rough, lean, chips, tile)
# meaning, unit, range [clamp], default:
#   size    cm, a Chunk's longest side (fist 8-10, head 20-25)                    [2, 80]   12
#   w       cm, a Plate's longest side                                           [4, 300]  30
#   damage  how broken: 0 a blocky piece (6 planes, even, near-smooth faces) -> 1 a sharp angular one (9-10 uneven
#           planes, faces roughened to 5 % of its size; a Plate's sides lean up to 12 deg and its top rim is chipped)
#                                                                                [0, 1]    0.5
#   age     wear: corners and arrises abraded round (up to 12 % of the way to the middle at a corner)   [0, 1]  0
#   noise   the seed                                                             [1, 99999] 1
#   budget  0 game (no roughen under 8 cm, coarse above), 1 high, 2 ultra (fine faceted roughen)   [0, 2] 1
#   ar      a Chunk's width over its length (-1: 0.55-0.85 drawn)                 [0.3, 1]  -1
#   tr      a Chunk's height over its length (-1: 0.4-0.7, flatter as damage grows)   [0.15, 1] -1
#   d, t    cm, a Plate's depth and thickness (-1: 0.62-0.87 x w, 0.12-0.24 x w)  [0.2 w, w], [0.5, w]  -1
#   faces   planes (-1: Chunk 6 + 3 x damage + a draw; Plate 7 + 3 x damage + a draw, top and bottom included)   [5, 16]  -1
#   even    % evenness of those planes, 0 = most unequal (-1: Chunk 45 - 40 x damage +- 10; Plate 14 - 14 x damage +- 6)   [0, 100]  -1
#   rough   faceted relief of the break faces, a fraction of the size (Plate: of t) (-1: from damage)   [0, 0.15]  -1
#   skin    Chunk: 1 its bottom is cast skin, 0 all broken (a piece from inside a member)   [0, 1]  1
#   skins   Plate: 2 both faces cast skin, 1 the top is a spall floor (broken)  [1, 2]    2
#   lean    degrees a Plate's sides lie off vertical (-1: 2 + 10 x damage)       [0, 30]   -1
#   chips   bites out of a Plate's top rim on high and ultra (-1: drawn from damage, up to 3)   [0, 3]  -1
#   tile    cm per UV tile                                                       [any] 100

build {
  SM_Concrete_Chunk_Game  = $ChunkGame  [pivot=(0, 0, 0), triangles=160, maps=(normal, ao), from=$ChunkUltra, resolution=512]
  SM_Concrete_Chunk_High  = $ChunkHigh  [pivot=(0, 0, 0)]
  SM_Concrete_Chunk_Ultra = $ChunkUltra [pivot=(0, 0, 0)]
  SM_Concrete_Plate_Game  = $PlateGame  [pivot=(0, 0, 0), triangles=60, maps=(normal, ao), from=$PlateUltra, resolution=512]
  SM_Concrete_Plate_High  = $PlateHigh  [pivot=(0, 0, 0)]
  SM_Concrete_Plate_Ultra = $PlateUltra [pivot=(0, 0, 0)]
}

Face   = material()
Broken = material()

# ---- the tiers: one wrapper each (a build line cannot pass knob values) ----------------------------------------
ChunkGame  = mesh(noise=1) { add($Chunk, size=17.0, budget=0, noise=$noise) }
ChunkHigh  = mesh(noise=1) { add($Chunk, size=17.0, budget=1, noise=$noise) }
ChunkUltra = mesh(noise=1) { add($Chunk, size=17.0, budget=2, noise=$noise) }
PlateGame  = mesh(noise=1) { add($Plate, budget=0, noise=$noise) }
PlateHigh  = mesh(noise=1) { add($Plate, budget=1, noise=$noise) }
PlateUltra = mesh(noise=1) { add($Plate, budget=2, noise=$noise) }

# a chip's cutter: a few-faced irregular solid centred on its own middle, so a bite leaves flat flaked planes
ChipCut = mesh(a=4.0, b=3.0, c=2.0, faces=8, ev=30.0, sd=1) {
  polyhedron(size=($a, $b, $c), faces=floor($faces), evenness=$ev%, seed=floor($sd))
  place(by=(0, 0, 0 - $c * 0.5))
}

# ---- Chunk: an angular mass of fist to head size ----------------------------------------------------------------
Chunk = mesh(size=12.0, damage=0.5, age=0.0, noise=1, budget=1, ar=-1.0, tr=-1.0, faces=-1, even=-1.0, rough=-1.0, skin=1, tile=100.0) {
  $S = clamp($size, 2.0, 80.0)
  $dm = clamp($damage, 0.0, 1.0)
  $ag = clamp($age, 0.0, 1.0)
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $nz = clamp(floor($noise), 1, 99999)
  $k0 = $nz * 1009
  $q1 = sin(($k0 + 41) * 12.9898 + 0.7) * 43758.5453
  $q1 = $q1 - floor($q1)
  $q2 = sin(($k0 + 42) * 12.9898 + 0.7) * 43758.5453
  $q2 = $q2 - floor($q2)
  $q3 = sin(($k0 + 43) * 12.9898 + 0.7) * 43758.5453
  $q3 = $q3 - floor($q3)
  $q4 = sin(($k0 + 44) * 12.9898 + 0.7) * 43758.5453
  $q4 = $q4 - floor($q4)
  $AR = clamp(ceil($ar + 0.5), 0, 1) * clamp($ar, 0.3, 1.0) + (1 - clamp(ceil($ar + 0.5), 0, 1)) * (0.5 + 0.25 * $q1)
  $TR = clamp(ceil($tr + 0.5), 0, 1) * clamp($tr, 0.15, 1.0) + (1 - clamp(ceil($tr + 0.5), 0, 1)) * (0.42 - 0.08 * $dm + 0.16 * ($q2 - 0.5))
  $FC = clamp(ceil($faces + 0.5), 0, 1) * clamp($faces, 5, 16) + (1 - clamp(ceil($faces + 0.5), 0, 1)) * (floor(6 + 3 * $dm + 1.99 * $q3))
  $EV = clamp(ceil($even + 0.5), 0, 1) * clamp($even, 0.0, 100.0) + (1 - clamp(ceil($even + 0.5), 0, 1)) * (clamp(45 - 40 * $dm + 20 * ($q4 - 0.5), 0, 100))
  $RG = clamp(ceil($rough + 0.5), 0, 1) * clamp($rough, 0.0, 0.15) + (1 - clamp(ceil($rough + 0.5), 0, 1)) * (0.012 + 0.04 * $dm)
  polyhedron(size=($S, $S * $AR, $S * $TR), faces=floor($FC), evenness=$EV%, seed=$nz)
  material($Broken)
  if ($skin > 0.5) {
    material($Face) [bottom]
  }
  if ($RG > 0) {
    if ($bg > 1.5) {
      roughen(by=0.45 * $RG * $S, scale=0.22 * $S, seed=$nz + 3, form=faceted) [!bottom]
    } else {
      if ($bg > 0.5) {
        roughen(by=0.65 * $RG * $S, scale=0.32 * $S, seed=$nz + 3, form=faceted) [!bottom]
      } else {
        if ($S > 5) {
          roughen(by=0.85 * $RG * $S, scale=0.6 * $S, seed=$nz + 3, form=faceted) [!bottom]
        }
      }
    }
  }
  if ($ag > 0) {
    warp(to=(point.x * (1 - 0.12 * $ag * pow(clamp((sqrt(pow(point.x / (0.5 * $S), 2) + pow(point.y / (0.5 * $S * $AR), 2) + pow((point.z - (0.5 * $S * $TR)) / (0.5 * $S * $TR), 2)) - 0.85) / 0.88, 0, 1), 2)), point.y * (1 - 0.12 * $ag * pow(clamp((sqrt(pow(point.x / (0.5 * $S), 2) + pow(point.y / (0.5 * $S * $AR), 2) + pow((point.z - (0.5 * $S * $TR)) / (0.5 * $S * $TR), 2)) - 0.85) / 0.88, 0, 1), 2)), (0.5 * $S * $TR) + (point.z - (0.5 * $S * $TR)) * (1 - 0.12 * $ag * pow(clamp((sqrt(pow(point.x / (0.5 * $S), 2) + pow(point.y / (0.5 * $S * $AR), 2) + pow((point.z - (0.5 * $S * $TR)) / (0.5 * $S * $TR), 2)) - 0.85) / 0.88, 0, 1), 2))))
  }
  uv(box, scale=$tile)
}

# ---- Plate: a slab piece, skin on one or both faces, broken sides --------------------------------------------------
Plate = mesh(w=30.0, damage=0.5, age=0.0, noise=1, budget=1, d=-1.0, t=-1.0, faces=-1, even=-1.0, skins=2, rough=-1.0, lean=-1.0, chips=-1, tile=100.0) {
  $W = clamp($w, 4.0, 300.0)
  $dm = clamp($damage, 0.0, 1.0)
  $ag = clamp($age, 0.0, 1.0)
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $nz = clamp(floor($noise), 1, 99999)
  $k0 = $nz * 1009
  $q1 = sin(($k0 + 51) * 12.9898 + 0.7) * 43758.5453
  $q1 = $q1 - floor($q1)
  $q2 = sin(($k0 + 52) * 12.9898 + 0.7) * 43758.5453
  $q2 = $q2 - floor($q2)
  $q3 = sin(($k0 + 53) * 12.9898 + 0.7) * 43758.5453
  $q3 = $q3 - floor($q3)
  $q4 = sin(($k0 + 54) * 12.9898 + 0.7) * 43758.5453
  $q4 = $q4 - floor($q4)
  $q5 = sin(($k0 + 55) * 12.9898 + 0.7) * 43758.5453
  $q5 = $q5 - floor($q5)
  $q6 = sin(($k0 + 56) * 12.9898 + 0.7) * 43758.5453
  $q6 = $q6 - floor($q6)
  $q7 = sin(($k0 + 57) * 12.9898 + 0.7) * 43758.5453
  $q7 = $q7 - floor($q7)
  $q8 = sin(($k0 + 58) * 12.9898 + 0.7) * 43758.5453
  $q8 = $q8 - floor($q8)
  $q9 = sin(($k0 + 59) * 12.9898 + 0.7) * 43758.5453
  $q9 = $q9 - floor($q9)
  $q10 = sin(($k0 + 60) * 12.9898 + 0.7) * 43758.5453
  $q10 = $q10 - floor($q10)
  $q11 = sin(($k0 + 61) * 12.9898 + 0.7) * 43758.5453
  $q11 = $q11 - floor($q11)
  $DD = clamp(ceil($d + 0.5), 0, 1) * clamp($d, 0.2 * $W, $W) + (1 - clamp(ceil($d + 0.5), 0, 1)) * ($W * (0.62 + 0.25 * $q1))
  $TT = clamp(ceil($t + 0.5), 0, 1) * clamp($t, 0.5, $W) + (1 - clamp(ceil($t + 0.5), 0, 1)) * ($W * (0.12 + 0.12 * $q2))
  $FC = clamp(ceil($faces + 0.5), 0, 1) * clamp($faces, 5, 14) + (1 - clamp(ceil($faces + 0.5), 0, 1)) * (floor(7 + 3 * $dm + 1.99 * $q3))
  $EV = clamp(ceil($even + 0.5), 0, 1) * clamp($even, 0.0, 100.0) + (1 - clamp(ceil($even + 0.5), 0, 1)) * (clamp(14 - 14 * $dm + 12 * ($q4 - 0.5), 0, 100))
  $RG = clamp(ceil($rough + 0.5), 0, 1) * clamp($rough, 0.0, 0.15) + (1 - clamp(ceil($rough + 0.5), 0, 1)) * (0.02 + 0.06 * $dm)
  $LN = clamp(ceil($lean + 0.5), 0, 1) * clamp($lean, 0.0, 30.0) + (1 - clamp(ceil($lean + 0.5), 0, 1)) * (2.0 + 10.0 * $dm)
  $CH = (clamp(ceil($chips + 0.5), 0, 1) * clamp($chips, 0, 3) + (1 - clamp(ceil($chips + 0.5), 0, 1)) * (floor(0.5 + 0.6 * $dm + 2.2 * $dm * $q5))) * clamp($bg, 0, 1)
  $Lx = $LN * (2 * $q6 - 1)
  $Ly = $LN * (2 * $q7 - 1)
  $Ls = 0.8 * $LN * (2 * $q8 - 1)
  polyhedron(size=($W, $DD, $TT), faces=floor($FC), evenness=$EV%, seed=$nz, mode=prism)
  material($Broken)
  material($Face) [bottom]
  if ($skins > 1.5) {
    material($Face) [top]
  }
  # the sides lean: each pair splayed by its own draw, and all of them sheared one way (a break through the
  # slab runs at an angle, as a punching cone does)
  if ($LN > 0) {
    warp(to=(point.x * (1 + tan($Lx) * (point.z - 0.5 * $TT) / (0.5 * $W)) + tan($Ls) * (point.z - 0.5 * $TT), point.y * (1 + tan($Ly) * (point.z - 0.5 * $TT) / (0.5 * $DD)), point.z))
  }
  if ($RG > 0) {
    if ($bg > 1.5) {
      roughen(by=$RG * $TT, scale=0.22 * $W, seed=$nz + 3, form=faceted) [side]
    } else {
      if ($bg > 0.5) {
        roughen(by=$RG * $TT, scale=0.4 * $W, seed=$nz + 3, form=faceted) [side]
      } else {
        roughen(by=$RG * $TT, scale=0.8 * $W, seed=$nz + 3, form=faceted) [side]
      }
    }
  }
  # chips: up to three bites out of the top rim, each found by a ray from the middle to the side near the top
  $cs = min((0.08 + 0.06 * $dm) * $W, 0.8 * $TT)
  if ($CH > 0.5) {
    $cx = cos(360 * $q9)
    $cy = sin(360 * $q9)
    save($Chip1) [at=(0.0, 0.0, 0.96 * $TT), project=($cx, $cy, 0.0), within=$W]
    subtract($ChipCut, a=$cs, b=0.8 * $cs, c=0.75 * $cs, faces=8, ev=30.0, sd=$nz + 1, at=$Chip1)
  }
  if ($CH > 1.5) {
    $cx = cos(360 * $q10)
    $cy = sin(360 * $q10)
    save($Chip2) [at=(0.0, 0.0, 0.96 * $TT), project=($cx, $cy, 0.0), within=$W]
    subtract($ChipCut, a=$cs, b=0.8 * $cs, c=0.75 * $cs, faces=8, ev=30.0, sd=$nz + 2, at=$Chip2)
  }
  if ($CH > 2.5) {
    $cx = cos(360 * $q11)
    $cy = sin(360 * $q11)
    save($Chip3) [at=(0.0, 0.0, 0.96 * $TT), project=($cx, $cy, 0.0), within=$W]
    subtract($ChipCut, a=$cs, b=0.8 * $cs, c=0.75 * $cs, faces=8, ev=30.0, sd=$nz + 3, at=$Chip3)
  }
  if ($CH > 0.5) {
    material($Broken) [cut]
  }
  if ($ag > 0) {
    warp(to=(point.x * (1 - 0.1 * $ag * pow(clamp((sqrt(pow(point.x / (0.5 * $W), 2) + pow(point.y / (0.5 * $DD), 2) + pow((point.z - (0.5 * $TT)) / (0.5 * $TT), 2)) - 0.85) / 0.88, 0, 1), 2)), point.y * (1 - 0.1 * $ag * pow(clamp((sqrt(pow(point.x / (0.5 * $W), 2) + pow(point.y / (0.5 * $DD), 2) + pow((point.z - (0.5 * $TT)) / (0.5 * $TT), 2)) - 0.85) / 0.88, 0, 1), 2)), (0.5 * $TT) + (point.z - (0.5 * $TT)) * (1 - 0.1 * $ag * pow(clamp((sqrt(pow(point.x / (0.5 * $W), 2) + pow(point.y / (0.5 * $DD), 2) + pow((point.z - (0.5 * $TT)) / (0.5 * $TT), 2)) - 0.85) / 0.88, 0, 1), 2))))
  }
  uv(box, scale=$tile)
}
