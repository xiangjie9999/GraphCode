gcshape 1  into:/GraphCodeShape/Presets  smooth:0.2  shade:40

# DAMAGE — L2 Primitives, the ways a solid loses material.
# `Docs/GC-SHAPE-PRESET-LIBRARY.md` §3, L2.
#
#   Dmg = shape('/GraphCodeShape/Presets/Damage')
#   Brick = mesh() { … $Dmg.EdgeChip(origin=(10, 5, 6), rotation=(0, 0, 20)) }
#
# DAMAGE REMOVES REAL VOLUME. Every entry here subtracts a solid or cuts a
# plane; none of them darkens a groove or fakes a break with a displacement. A
# crack you can see the far side of is a crack, and one that is only a shaded
# dent is a texture pretending.
#
# TWO KINDS OF ENTRY, AND THE DIFFERENCE IS WHO AIMS THEM.
#   · A BRACKETED treatment takes the caller's selection — `$Dmg.Spall() [top]`.
#   · A WHOLE-MESH treatment takes an `origin=` and a `rotation=` instead,
#     because a chip is at a PLACE, not on a set of faces, and the bracket on a
#     group-5 line is reserved. Those are called with no bracket at all.
# Each entry below says which it is on its own line.
#
# BEVEL BEFORE DAMAGE, NEVER AFTER. A `round()` run after a break tries to bevel
# the fracture's own edges, which is both wrong to look at and — measured in
# `GC-SHAPE-ROCK-WALK.md` MR1 — the case where `round` after a boolean sprays
# geometry and every metric still reads clean. Order the calls so the part is
# finished first and broken second.
#
# NAMES AVOID THE GROUP-5 RESERVED SET, which is why the placement arguments are
# `origin=` and `rotation=` and not `at=` and `rotate=`: those two are claimed by
# the `subtract()` the entry is about to make, and a colliding parameter is one
# no caller could ever pass. The two shipped entries already chose these names
# and the rest follow them.
#
# FRACTURE IS DELIBERATELY NOT HERE. `fracture` changes the PART COUNT, and
# every entry in this file leaves one solid where it found one. Breaking a thing
# into pieces is its own family — `Debris` — for the same reason an instruction
# that alters a shape is not a mesh that replaces it.

build {
  SM_Damage_CornerCrack = $Example    [bounds=(41.0, 31.0, 11.0), triangles=2000]
  SM_Damage_Chip        = $Chip_Ex    [bounds=(41.0, 31.0, 11.0), triangles=2000]
  SM_Damage_EdgeChip    = $Edge_Ex    [bounds=(41.0, 31.0, 11.0), triangles=2000]
  SM_Damage_Crack       = $Crack_Ex   [bounds=(41.0, 31.0, 11.0), triangles=2000]
  SM_Damage_Gouge       = $Gouge_Ex   [bounds=(41.0, 31.0, 11.0), triangles=3000]
  SM_Damage_Spall       = $Spall_Ex   [bounds=(41.0, 31.0, 11.0), triangles=9000]
  SM_Damage_Puncture    = $Punc_Ex    [bounds=(41.0, 31.0, 11.0), triangles=2000]
  SM_Damage_BrokenEnd   = $Broken_Ex  [bounds=(41.0, 31.0, 11.0), triangles=30000]
  SM_Damage_Snap        = $Snap_Ex      [bounds=(23.5, 60.0, 9.5), triangles=12000]
  SM_Damage_SnapOff     = $SnapOff_Ex   [bounds=(23.5, 56.0, 9.5), triangles=12000]
  SM_Damage_Crumble     = $Crumble_Ex   [bounds=(23.5, 60.0, 4.5), triangles=8000]
  SM_Damage_Split       = $Split_Ex     [bounds=(23.5, 61.0, 4.5), triangles=8000]
  SM_Damage_BeamBreak   = $BeamBreak_Ex [bounds=(21.0, 80.0, 21.0), triangles=18000]
  SM_Damage_SnapMaps    = $Snap_Ex      [bounds=(23.5, 60.0, 9.5), triangles=12000, maps=(normal, ao), from=$Snap_ExDetail, resolution=1024, supersample=1]
}

# ---- the cutters ----------------------------------------------------------

# The cutter a crack is made with: a thin, irregular wedge of solid. Placed and
# subtracted by CornerCrack; usable on its own where you want to route the break
# yourself.
Fissure = mesh(width=.5,length=12,depth=4) {
  points((-$width*.5,-$length*.5),($width*.5,-$length*.5),($width*.8,-$length*.15),($width*.3,$length*.2),($width*.5,$length*.5),(-$width*.5,$length*.5),(-$width*.7,$length*.2),(-$width*.2,-$length*.15),loop=true)
  extrude(height=$depth)
}

# A chip's cutter: a small irregular wedge that tapers to nothing, so what it
# takes out is a flake rather than a punched pocket. `extrude(to=)` is the taper
# and it is what keeps the chip's floor from reading as machined.
Flake = mesh(size=2.0, depth=1.2, sharpness=25) {
  points((-$size*.5, -$size*.45), ($size*.5, -$size*.3), ($size*.42, $size*.5), (-$size*.28, $size*.38), loop=true)
  extrude(height=$depth, to=$sharpness%)
}

# A gouge's cutter: a round-bottomed channel, made by laying a cylinder on its
# side. A scrape from a tool or a dragged edge, which has a radius where a chip
# has corners.
Scoop = mesh(r=0.9, len=10.0) {
  circle(radius=$r)
  extrude(height=$len)
  place(by=(0.0, 0.0, -$len * 0.5))
}

# A spall's cutter: a wide shallow lens, roughened so the flake it takes off a
# face is uneven. Concrete and fired brick shed material this way — in broad thin
# sheets, not in cubes. THE ROUGHEN IS ON THE CUTTER and not on the result, which
# is what makes one call leave an irregular scar instead of a clean saucer.
Lens = mesh(r=5.0, depth=0.5, grain=2.0, noise=5) {
  circle(radius=$r)
  extrude(height=$depth, to=55%)
  roughen(by=$depth * 0.45, scale=$grain, seed=$noise, form=faceted)
}

# A puncture's cutter: a plain cone, point first. `extrude(to=0%)` IS the cone —
# there is no cone noun in this grammar and there does not need to be.
Spike = mesh(r=1.1, len=14.0) {
  circle(radius=$r)
  extrude(height=$len, to=0%)
}

# ---- whole-mesh damage, aimed by origin and rotation ----------------------

# Break a real corner off, by subtracting a jagged solid rather than darkening a
# groove. Whole-mesh: call it without a selecting bracket and let
# `origin`/`rotation` aim the cutter.
# Bevel BEFORE damage — a later bevel may not fit the fractured edges.
CornerCrack = instruction(width=.5,length=12,depth=4,origin=(0,0,0),rotation=(0,0,0)) {
  subtract($Fissure,width=$width,length=$length,depth=$depth,at=$origin,rotate=$rotation)
}

# A single chip out of a face. Whole-mesh. The commonest damage there is, and the
# one most often faked — this one removes volume, so the chip has a floor you can
# see into and a rim the light catches.
Chip = instruction(size=2.0, depth=1.2, sharpness=25, origin=(0,0,0), rotation=(0,0,0)) {
  subtract($Flake, size=$size, depth=$depth, sharpness=$sharpness, at=$origin, rotate=$rotation)
}

# A chip taken off an ARRIS — the edge where two faces meet. Whole-mesh, and the
# only difference from `Chip` is proportion and aim: wider, shallower, and turned
# so it bites the edge rather than the flat. A worn brick loses its arrises long
# before it loses its faces, which is why this is the one to reach for first on
# masonry.
EdgeChip = instruction(size=3.0, depth=0.8, sharpness=15, origin=(0,0,0), rotation=(0,0,0)) {
  subtract($Flake, size=$size, depth=$depth, sharpness=$sharpness, at=$origin, rotate=$rotation)
}

# A surface-breaking crack — the `Fissure` cutter run shallow, so it splits the
# face without taking a corner off. Whole-mesh. Give it a `rotation` to route it
# across the surface; a crack that runs square to an edge reads as a saw cut.
Crack = instruction(width=.3, length=16, depth=1.5, origin=(0,0,0), rotation=(0,0,0)) {
  subtract($Fissure, width=$width, length=$length, depth=$depth, at=$origin, rotate=$rotation)
}

# A dragged scrape with a round bottom. Whole-mesh. `rotation` turns the channel;
# left at zero it runs along X.
Gouge = instruction(r=0.9, len=10.0, origin=(0,0,0), rotation=(0,0,90)) {
  subtract($Scoop, r=$r, len=$len, at=$origin, rotate=$rotation)
}

# A puncture straight through, or part way. Whole-mesh. `len` past the wall
# thickness makes it a hole; short of it makes it a dimple with a point.
Puncture = instruction(r=1.1, len=14.0, origin=(0,0,0), rotation=(0,0,0)) {
  subtract($Spike, r=$r, len=$len, at=$origin, rotate=$rotation)
}

# ---- bracketed damage, aimed by the caller's selection --------------------

# A broad shallow flake off a face — concrete spalling, a shed brick face, frost
# damage. BRACKETED: `$Dmg.Spall() [top]` and the caller's selection decides
# which face loses material.
Spall = instruction(r=5.0, depth=0.5, grain=2.0, noise=5, origin=(0,0,0)) {
  subtract($Lens, r=$r, depth=$depth, grain=$grain, noise=$noise, at=$origin)
}

# ---- a break, which is a cut and not a subtraction ------------------------

# A snapped-off end. THIS IS THE ONE ENTRY THAT IS A `cut` AND NOT A
# `subtract`, and the reason is worth reading: a break goes all the way through,
# and a cutter big enough to guarantee that is a cutter whose own size the caller
# would have to know. A plane has no size.
# THE TWO LINES ARE THE WHOLE IDEA. `cut` leaves a perfectly flat face wearing
# the `cut` tag, which reads as sawn; roughening exactly that tag and nothing
# else turns the saw cut into a fracture and leaves the rest of the part alone.
# `form=faceted` is the noise that makes flat plates meeting at sharp edges —
# broken stone and split timber in the grammar's own words — and it is what a
# break face actually looks like.
BrokenEnd = instruction(axis=X, where=70%, depth=0.7, grain=2.5, noise=23) {
  cut(plane=$axis, at=$where, fill=true)
  roughen(by=$depth, scale=$grain, seed=$noise, form=faceted) [cut]
}

# ---- the shop window ------------------------------------------------------
# One bevelled 40 x 30 x 10 block per kind of damage, so two can be compared
# without a second variable changing.

Blank = mesh(w=40, d=30, h=10) {
  rect(w=$w, h=$d)
  extrude(height=$h)
  round(.5, segments=2) [sharp]
}

# Example: a bevelled block with one cracked corner. Built by this file, not by
# an importer.
Example = mesh() {
  rect(w=40,h=30)
  extrude(height=10)
  round(.5,segments=2) [sharp]
  $CornerCrack(origin=(18,12,8),rotation=(0,0,30))
}

Chip_Ex   = mesh() { add($Blank) $Chip(origin=(8.0, -6.0, 10.0), rotation=(0.0, 0.0, 35.0)) }
Edge_Ex   = mesh() { add($Blank) $EdgeChip(origin=(-6.0, 15.0, 9.4), rotation=(35.0, 0.0, 10.0)) }
Crack_Ex  = mesh() { add($Blank) $Crack(origin=(0.0, 0.0, 9.2), rotation=(0.0, 0.0, 22.0)) }
Gouge_Ex  = mesh() { add($Blank) $Gouge(origin=(0.0, -4.0, 10.1)) }
Spall_Ex  = mesh() { add($Blank) $Spall(origin=(-9.0, 3.0, 9.9)) }
Punc_Ex   = mesh() { add($Blank) $Puncture(origin=(12.0, 6.0, 10.5), rotation=(180.0, 0.0, 0.0)) }
Broken_Ex = mesh() { add($Blank) $BrokenEnd() }

# ==== WOOD — BREAKS THAT FOLLOW THE GRAIN ==================================
# `Docs/GC-SHAPE-WOOD-DAMAGE.md` v2. Owner, 2026-11-18: damage is IRREGULAR AND
# CHAOTIC, parametric, and never "triangles cut out of a rectangle"; WOODS ARE
# DIRECTION-BASED — the grain is the one fact every part below follows; and
# EVERYTHING IS PARAMETRIC — every look-defining number is an entry argument
# with a default and a one-line note, never a literal inside a cutter.
#
# THE FRAME, ONE FOR EVERY WOOD ENTRY. Grain along +Y, width along X, thickness
# up +Z — the way `Masonry.Plank` lies. The board is on the -Y side of the
# break; what breaks away is +Y. `origin=` is the point on the board's BOTTOM
# face, mid-width, where the break line (or a split's mouth) crosses; so a snap
# 40 cm from the +Y end of the centred 200 cm Plank is `origin=(0, 60, 0)`.
# `rotation=` turns the whole frame (a slanted break is `rotation=(0, 0, 12)`;
# keep a slant under about 20 degrees, past it the break face no longer spans
# the board's width). WHOLE-MESH, no bracket: `$Dmg.Snap(origin=(0, 60, 0))`.
#
# THE BREAK IS A STEPPED FIELD ALONG THE GRAIN (round 2, 2026-11-18). Each
# break is ONE cutter, `Strata`, whose face toward the wood is a height field —
# how far along the grain the fibre at each point of the cross-section reaches —
# written as three `warp`s that move the face ALONG THE GRAIN ONLY, so it stays
# a height field and cannot fold. The field is built the way real boards break
# (`Docs/Research/wood-break-real-photos.md`), in three tiers, each a set of
# CELLS whose own random value comes from a sine hash of the cell's number
# (`floor(...)`), so neighbouring cells never match and edges between them are
# crisp steps, not lumps:
#   SHELVES — 2-4 layers through the thickness (their boundaries wander across
#     the width), each offset along the grain, so the top and bottom faces tear
#     about two thicknesses apart in steps joined by an oblique run (rule 5);
#   SPIRES — tier A, one row of cells across the width PER SHELF, each its own
#     length, peak and tip (pointed, blunt or squared), so every shelf breaks in
#     its own places (rule 2: 3-8 spires 1-3 T long, 0.1-0.25 W wide);
#   RIBBONS — tier B, thin cells through each shelf and narrow across it, with
#     stepped sides and pointed tips, riding on the spires (0.2-1 T long,
#     0.02-0.08 W wide): the "small teeth on bigger teeth".
# A HORN (one long spire) or, with a negative length, a V BITE rides on top.
# Fibre hairs are the material's (tier C): a baked map, never triangles.
# Round 1's noisy roughen made the end faces pebbled lumps (orange peel) seen
# end-on; the cells make them stepped planes and ridges along the grain.
# MEASURED (`Content/__MCPTests/WoodDamage/BreaksR2Strata.gcshape`): the face is
# given its points by a near-zero `roughen` on `[top]` (a roughen refines only
# the region it moves; `[smooth=]` on the warp refined the whole cutter box,
# 208k triangles); the moves fade out at the cutter's back so its union with
# `Beyond` stays clean. When `noise()`/`cell()` land in warp formulas (G5), the
# sine hashes collapse into them.
#
# ONE SURFACE, TWO HALVES. `Snap` subtracts the break and `SnapOff` intersects
# THE SAME break, so with the same arguments the two halves interlock tooth into
# socket; each half then loses its OWN pieces (`loss`: a second field trims the
# longest spires; its chewed edges and its peeled strip take seeds of their
# own), so they are complements, never mirrors.
#
# DAMAGE PAINTS NOTHING. Every break face wears `cut`; paint it with your own
# slot, `material($Broken) [cut]`, as the shop window does. It DOES write UV0,
# because a boolean throws UVs away, `tile=` cm a tile (default 100, the
# family's one density): the skin box-projected in the wood frame with U ALONG
# THE GRAIN on every long face (top, bottom, both edges); then (round 4) the torn
# faces SPLIT BY FACING with the `[cut, facing=<axis>]` selector (faces within
# 60 degrees): those pointing sideways or up/down on planes whose U runs along
# the grain, the end grain (across it) LAST, since the cones overlap and the last
# line wins. MEASURED on the shipped plank: uvfolds 419 -> 16 against one box over
# the break, density 91-100 %. A bracket that selects no face is REFUSED, so each
# pair is written only under the knob that makes such faces (`deep > 0` for the
# flanks, `fray`/`clump > 0` for the steps); a face no line takes keeps the box.
# The selector takes fixed axes and an `if` cannot read a vector's component
# (`'$fibre.z' is not an entry`), so `upright=1` swaps the lines for a standing
# timber (grain up +Z). `aspect=` is the along-grain tile over the across tile
# (4 = the direction checker the critics read). `fibre=` is the grain's direction
# and `face=` the board's wide-face normal, both IN THE MESH'S OWN AXES — pass
# them with any `rotation=` that moves the grain, since an instruction cannot
# read one number out of `rotation=` (`'$rotation.z' is not an entry in this
# file`).
# A BOARD BEVELLED AFTER EXTRUDING ITS PLAN (`rect` of the plan, `extrude`,
# `round [sharp]`) leaves single corner triangles where three bevels meet, and
# the engine's box projection can swap a long bevel triangle into the END
# GRAIN's plane, where it maps to a line (MEASURED: `stretch 1000`). Sweep the
# board's SECTION along the grain instead, as `WoodBoard` below does: its
# arrises run the whole length and its ends are flat.
#
# GEOMETRY HERE, FIBRE IN A MAP (owner, 2026-11-18: "some uses texture
# instead of mesh"). These entries make the silhouette and the coarse and middle
# chaos; the fibre grooves, fine ridges and hairs belong in a normal/AO map. A
# modifier cannot bake (a bake is a build line's), so a caller wanting the fibre
# writes a detail version of its own mesh — the same lines, then ONE fine
# `ridged` roughen on the torn faces, six times longer along the grain than
# across it, `roughen(by=0.06, scale=(0.6, 3.6, 0.6), form=ridged) [cut]` —
# and bakes it onto the light mesh with `[maps=(normal, ao), from=$ItsDetail]`
# on its build line, as `SM_Damage_SnapMaps` below does. Its smallest bump is
# about the break's own point spacing, so it refines little. The bake needs a
# unique UV0 and lays out its own over the tiling grain UV0 these entries write
# (Shape writes one channel; G15).
#
# UNITS. Lengths cm; `deep`, `grain`, `wander`, `slant`, `strip`, `open`,
# `bite`, `chew`, `ledge`, `peelw`, `tear`, `ridges`, `rib`, `hornw`, `clump`,
# `clumpw` are FRACTIONS OF THE WIDTH; `lean`, `fray`, `ply`, `bitlen`, `lip`,
# `run`, `ridge`, `horn`, `clumpt` FRACTIONS OF THE THICKNESS; angles in
# degrees; `noise=` is the seed, any whole number above 0. `detail=` scales the
# break's point spacing (2 = twice as fine, four times the triangles).
#
# CUSTOMISING (round 13; owner, 2026-11-19: "ensure they are parametric and easily customisable"). Every
# entry leads with the same TOP-LEVEL knobs, named as in every other damage kit file, then its placement,
# then its ADVANCED knobs, then its UV frame:
#   size     the board's `width` and `thick` (cm; a BrokenTimber mesh also `length`, the post `height`)
#   damage   0 to 3, default 1: how broken. It scales the break's reach and its loose material (each entry's
#            KNOBS table says which knobs); 1 is the entry as written, 0.4 a light break, 2 a heavy one
#   age      0 to 2, default 1: how worn. 0 a fresh break (its fine tips long, little chew), 2 a weathered
#            one (fine tips halved, chew and crumbs 1.5 x); on a BrokenTimber blank also its eased arrises
#   noise    the seed: any number, every one valid
#   budget   0 to 2, default 1: point spacing, 0 game (half the detail), 1 high, 2 ultra (1.5 x); the build
#            line's [triangles=] still sets the final count
# EVERY KNOB IS CLAMPED to the range in its entry's KNOBS table (a value past it builds the nearest end of
# the range, never a broken mesh): each knob is read through a body-local `$k<name>`. At the defaults the
# meshes are exactly the ones before these knobs existed (checked by full-mesh hash).

# ---- wood cutters ---------------------------------------------------------

# THE BREAK FACE, built in its own frame: X across the face, Y through it (the
# band of wood it breaks, `tb` thick, centred `yb` off the cutter's middle), +Z
# toward the wood; the face is `[top]` and moves only along Z (by minus the reach
# H, so a larger H is wood reaching further). A near-zero roughen gives the face
# points `res` apart and nothing else; three warps then add the tiers:
#   1 shelves + sway + horn: `layers` layers through the band whose boundaries
#     wobble `wob` layers across the width; `lean` cm from the band's bottom to
#     its top, `ramp` of it a smooth oblique run and the rest steps, each step
#     off by up to `jog` of its share; `wa`/`sk` sway and slant the line; a horn
#     `hl` cm long (negative: a bite), `hw` half-wide at `hx`, shaped by `hq`
#     and flattened at its tip by `hcap`, over the band fraction `hv0`..`hv1`.
#   2 spires: per shelf a row of cells `ca` cm wide (`uneven` makes them vary
#     about 4:1), each up to `la` cm long (`rough` how unequal), pointed by
#     `qa` + up to `qr` more (higher = more needle-like), squared off by `blunt`.
#   3 ribbons: cells `cb` wide and `db` through, up to `lb` long, `sparse`
#     making most short, `root` the share that is a squared base below the
#     pointed tip, `bblunt` squaring the tip; `ub` how unequal their widths are,
#     `jb` how much their rows wobble across the width and `jc` how much they
#     step per column (uneven depths, rot's blocks).
# Round 3: `hstep` steps the horn or bite with the spire cells; `hrib` ribbons the horn (each ribbon cell in it stops its own share
# short: a bundle of fibres, not one smooth surface); `hb` clears that share of
# the ribbons inside the horn or bite; `hs` offsets the seed of the cells' own
# draws (lengths, tips) but not their layout, so a second field can share the
# break's cells exactly (`Loss`).
# Round 4: `tilt` leans each shelf's cell walls (cm across per cm through the
# band, each shelf its own way: end-on, wedges and parallelograms, not the
# axis-aligned prisms that read as basalt columns); `skew` how far a spire's tip
# sits off its cell's middle (0.5 round 3, 1 the full width); SUB-CELLS `subw` of
# a spire wide and `subrows` to a shelf, each stopping its own 0.4-1 x `sub` x
# `bw` short (never past 0.6 of the spire there), so the flanks step and the tips
# fray into bundles: smaller teeth riding on the big ones; `tipfray` lengthens the
# ribbons on the spires' tips (the tips fray, the roots stay quiet); `tiltend`
# tilts each cell's end by its own slope (rot's blocks end in slanted planes).
# `uneven` now sums two sines of unrelated periods (one repeated every 2.3 cells).
# `fx`/`fo` fade the whole field across X (a chewed edge deepest at the break);
# every move fades to nothing at the cutter's back (`point.z` 0..1) so the
# union with `Beyond` meets a flat face.
Strata = mesh(w=25.5, t=6.8, tb=3.8, yb=0.0, len=30.0, bw=22.5, res=0.2, s=3, layers=3, wob=0.3, lean=0.0, ramp=0.35, jog=0.35, la=8.0, ca=3.6, uneven=0.2, rough=0.8, blunt=0.0, qa=0.7, qr=1.2, lb=3.0, cb=0.9, db=0.65, sparse=2.0, bblunt=0.0, root=0.35, hl=0.0, hx=0.0, hw=3.0, hq=0.8, hcap=0.0, hv0=0.0, hv1=1.0, wa=0.0, sk=0.0, fx=0.0, fo=1.0, hs=0, ub=0.2, jb=0.15, jc=0.0, hrib=0.0, hb=0.0, hstep=0.0, tilt=0.0, skew=0.5, sub=0.0, subw=0.33, subrows=2, tipfray=0.0, tiltend=0.0, taper=0.0, tvar=0.0, long=0.0, vdep=0.0, hblock=0.0, stap=0.0, stag=0.0, rings=0.0, px=0.0, pz=0.0, hold=1.0, heart=0.0, torn=0.0, ttilt=0.0, trib=0.0, tsep=0.15, lside=0.0, htilt=0.0) {
  $zc17_3 = sin($s * 17.3) * 4375.85
  $zc17_3 = $zc17_3 - floor($zc17_3)
  $zc71_3 = sin($s * 71.3) * 4375.85
  $zc71_3 = $zc71_3 - floor($zc71_3)
  $zc61_7 = sin($s * 61.7) * 4375.85
  $zc61_7 = $zc61_7 - floor($zc61_7)
  $zc23_9 = sin($s * 23.9) * 4375.85
  $zc23_9 = $zc23_9 - floor($zc23_9)
  $zc29_3 = sin($s * 29.3) * 4375.85
  $zc29_3 = $zc29_3 - floor($zc29_3)
  $zc37_1 = sin($s * 37.1) * 4375.85
  $zc37_1 = $zc37_1 - floor($zc37_1)
  $zc41_3 = sin($s * 41.3) * 4375.85
  $zc41_3 = $zc41_3 - floor($zc41_3)
  $zc43_1 = sin($s * 43.1) * 4375.85
  $zc43_1 = $zc43_1 - floor($zc43_1)
  $zc53_3 = sin($s * 53.3) * 4375.85
  $zc53_3 = $zc53_3 - floor($zc53_3)
  $zc31_7 = sin($s * 31.7) * 4375.85
  $zc31_7 = $zc31_7 - floor($zc31_7)
  $zc19_9 = sin($s * 19.9) * 4375.85
  $zc19_9 = $zc19_9 - floor($zc19_9)
  $zc829_7 = sin($s * 829.7) * 4375.85
