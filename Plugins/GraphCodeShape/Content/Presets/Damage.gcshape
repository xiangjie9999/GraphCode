  $ktvar = clamp($tvar, 0.0, 1.0)
  $kstap = clamp($stap, 0.0, 1.0)
  $krowjog = clamp($rowjog, 0.0, 1.0)
  $klong = clamp($long, 0.0, 3.0)
  $kvdep = clamp($vdep, 0.0, 2.0)
  $kuvfit = clamp($uvfit, 0.0, 2.0)
