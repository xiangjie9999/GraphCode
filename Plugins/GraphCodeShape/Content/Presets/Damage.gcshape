          uv(plane, at=$origin, facing=(0.577, -0.577, -0.577), up=(0.408, 0.816, -0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.126, -0.949, -0.29), facing=(0.784, 0.039, -0.62), facing=(0.075, -0.36, -0.93), facing=(0.835, -0.55, 0.02)]
          uv(plane, at=$origin, facing=(-0.577, -0.577, 0.577), up=(-0.408, 0.816, 0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.846, 0.014, 0.533), facing=(-0.064, -0.924, 0.377), facing=(-0.771, -0.636, -0.042), facing=(-0.139, -0.274, 0.952)]
          uv(plane, at=$origin, facing=(-0.577, -0.577, -0.577), up=(-0.408, 0.816, -0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.938, -0.093, -0.334), facing=(0.028, -0.817, -0.576), facing=(-0.316, -0.106, -0.943), facing=(-0.594, -0.804, 0.033)]
        }
      }
    }
  }
}

# ROTTEN OR DRY, BRASH WOOD (real photos rule 11): it breaks short and BLOCKY,
# never in spikes. Every knob:
#   deep    the blocks' reach (fraction of width; 3-4 steps 0.2-0.4 real)
#   grain   block width (fraction of width)
#   steps   shelves through the thickness (3-4 real)
#   lean    top face's break off the bottom face's (thicknesses)
#   shelf   share of it in steps; jog how unequal the steps are
#   wander  sway of the line; slant its slant (fractions of width)
#   square  how squared the block ends are (0.9-0.97 blocky)
#   tilt    the blocks' walls leaning end-on; tiltend each block's end tilted by
#           its own slope (0 machined slots .. 1); sub, subw, subrows the
#           crumbly steps on each block (as `Snap`)
#   clump   crumbs' reach (fraction of width); clumpw their width (fraction of
#           width); clumpt their thickness (fraction of thickness): about 2:1:1
#   clumpu  how unequal the crumbs' widths are (0 even .. 0.5 about 5:1)
#   clumpd  how unequally deep they sit (0 even rows .. 0.6 every column its own)
#   bite    one V bite's depth (fraction of width; 0 none); bitew its half-width
#           (fraction of the bite); bitecap how flat its floor is (0 pointed)
#   bitecrumb share of the crumbs kept inside the bite (1 all; round 2 kept all,
#           and their one pitch stepped down the bite's flanks as a comb)
#   bitestep how blocky the bite's sides are (0 a smooth V .. 1 receding in the
#           blocks' own steps; a smooth V across squared blocks left needles)
#   detail, noise, origin, rotation, fibre, face, upright, tile, aspect as `Snap`
#   bitetilt 0 (round 12) tilts each block's floor inside the bite by its own draw (1: its
#           depth up to +-50 % across the block and through its shelf), so the bite's
#           back wall is many planes; RottenPlank writes 1 with `bitestep` 0.5 and
#           `bitecap` 0.1 (round 11's bite was a flat-floored rectangular slot).
# KNOBS (round 13): name, unit, range (a value past it is clamped), default, meaning. The top-level knobs
# come first; damage scales deep (x damage) and the bite (x 0.5 + 0.5 x damage); age scales the crumbs (clump) and the bite's torn stubs (biterib) by 0.5 + 0.5 x age; budget scales detail.
#   width      cm           1 to 200         22.5      the board's width (across the grain, X)
#   thick      cm           0.3 to 100       3.8       the board's thickness (Z)
#   damage     x            0 to 3           1.0       how broken: scales the break's reach and its loose material (see the entry's line); 1 as written
#   age        0-2          0 to 2           1.0       how worn: 0 fresh, 1 as written, 2 weathered (see the entry's line)
#   noise      seed         not clamped      5         the seed: any number, every one valid (not clamped)
#   budget     0-2          0 to 2           1         point spacing: 0 game (half the detail), 1 high (as written), 2 ultra (1.5 x the detail); the build line's [triangles=] sets the final count
#   origin     cm           not clamped      (0,0,0)   where the break crosses the board's bottom face, mid-width (the Damage frame)
#   rotation   degrees      not clamped      (0,0,0)   turns the frame (a slanted break, a standing post)
#   deep       x width      0 to 3           0.3       the blocks' reach
#   grain      x width      0.03 to 1        0.26      a block's width
#   steps      count        1 to 8           3         rot's shelves through the thickness
#   lean       x thickness  0 to 4           0.5       the top face's crumble off the bottom face's
#   shelf      0-1          0 to 1           1.0       share of the lean taken in steps rather than one oblique run
#   jog        x step       0 to 1           0.7       how unequal the shelves' steps are
#   wander     x width      0 to 0.5         0.06      sway of the break line
#   slant      x width      0 to 0.5         0.1       slant of the break line across the width
#   square     0-1          0 to 0.99        0.93      how squared the block ends are
#   tilt       slope        0 to 2           0.4       how the shelves' cell walls lean end-on (0 square prisms)
#   tiltend    x            0 to 3           1.0       how far each block's end tilts
#   sub        x width      0 to 0.5         0.045     steps on each spire: sub-cells stop 0.4-1 x sub x width short (0 none)
#   subw       x spire      0.05 to 1        0.33      a sub-cell's width
#   subrows    count        1 to 8           2         sub-cells to a shelf through the thickness
#   clump      x width      0 to 0.5         0.1       the crumbs' reach (0 none)
#   clumpw     x width      0.005 to 0.3     0.05      a crumb's width
#   clumpt     x thickness  0.02 to 1        0.3       a crumb's thickness
#   clumpu     0-1          0 to 1           0.45      how unequal the crumbs' widths are
#   clumpd     0-1          0 to 1           0.5       how unequal the crumbs' rows are
#   bite       x width      0 to 1           0.3       the V bite's depth (0 none)
#   bitew      x bite       0.1 to 2         0.6       the bite's width
#   bitecap    0-1          0 to 0.95        0.3       how flat the bite's floor is (0 pointed)
#   bitecrumb  0-1          0 to 1           0.5       how much of the crumbs stay inside the bite (1 all)
#   bitestep   0-1          0 to 1           1.0       how far the bite steps with the blocks (1 in blocks)
#   bitevar    0-1          0 to 1           0.7       each block of the bite its own depth
#   bitetilt   x            0 to 2           0.0       each block's floor in the bite tilted by its own draw
#   uvfit      0/1/2        0 to 2           1         the torn faces' UVs: 0 the facing split, 1 + narrow windows, 2 an automatic unwrap
#   detail     x            0.05 to 4        1.0       point spacing scale (2 twice as fine, about 4 x the triangles)
#   biterib    0-1          0 to 1           0.0       the bite's floor torn into fibre stubs: each crumb cell stops up to this share short (0 smooth)
#   fibre      vector       not clamped      (0,1,0)   the grain direction in the mesh's axes, when `rotation` turns the board
#   face       vector       not clamped      (0,0,1)   the wide face's normal in the mesh's axes, when `rotation` turns the board
#   upright    switch       0 to 1           0         1 when the grain stands up +Z (a post): the torn faces' UV split turns with it
#   tile       cm           1 to 10000       100.0     one texture tile
#   aspect     x            0.1 to 20        1.0       the along-grain tile over the across tile (1 square; 4 the direction checker)
Crumble = instruction(width=22.5, thick=3.8, damage=1.0, age=1.0, noise=5, budget=1, origin=(0,0,0), rotation=(0,0,0), deep=0.3, grain=0.26, steps=3, lean=0.5, shelf=1.0, jog=0.7, wander=0.06, slant=0.1, square=0.93, tilt=0.4, tiltend=1.0, sub=0.045, subw=0.33, subrows=2, clump=0.1, clumpw=0.05, clumpt=0.3, clumpu=0.45, clumpd=0.5, bite=0.3, bitew=0.6, bitecap=0.3, bitecrumb=0.5, bitestep=1.0, bitevar=0.7, bitetilt=0.0, uvfit=1, detail=1.0, biterib=0.0, fibre=(0,1,0), face=(0,0,1), upright=0, tile=100.0, aspect=1.0) {
  $kdamage = clamp($damage, 0.0, 3.0)
  $kage = clamp($age, 0.0, 2.0)
  $kbudget = clamp($budget, 0.0, 2.0)
  $kwidth = clamp($width, 1.0, 200.0)
  $kthick = clamp($thick, 0.3, 100.0)
  $kdeep = clamp($deep * $kdamage, 0.0, 3.0)
  $kgrain = clamp($grain, 0.03, 1.0)
  $ksteps = clamp($steps, 1.0, 8.0)
  $klean = clamp($lean, 0.0, 4.0)
  $kshelf = clamp($shelf, 0.0, 1.0)
  $kjog = clamp($jog, 0.0, 1.0)
  $kwander = clamp($wander, 0.0, 0.5)
  $kslant = clamp($slant, 0.0, 0.5)
  $ksquare = clamp($square, 0.0, 0.99)
  $ktilt = clamp($tilt, 0.0, 2.0)
  $ktiltend = clamp($tiltend, 0.0, 3.0)
  $ksub = clamp($sub, 0.0, 0.5)
  $ksubw = clamp($subw, 0.05, 1.0)
  $ksubrows = clamp($subrows, 1.0, 8.0)
  $kclump = clamp($clump * (0.5 + 0.5 * $kage), 0.0, 0.5)
  $kclumpw = clamp($clumpw, 0.005, 0.3)
  $kclumpt = clamp($clumpt, 0.02, 1.0)
  $kclumpu = clamp($clumpu, 0.0, 1.0)
  $kclumpd = clamp($clumpd, 0.0, 1.0)
  $kbite = clamp($bite * (0.5 + 0.5 * $kdamage), 0.0, 1.0)
  $kbitew = clamp($bitew, 0.1, 2.0)
  $kbitecap = clamp($bitecap, 0.0, 0.95)
  $kbitecrumb = clamp($bitecrumb, 0.0, 1.0)
  $kbitestep = clamp($bitestep, 0.0, 1.0)
  $kbitevar = clamp($bitevar, 0.0, 1.0)
  $kbitetilt = clamp($bitetilt, 0.0, 2.0)
  $kuvfit = clamp($uvfit, 0.0, 2.0)
  $kdetail = clamp($detail * (0.5 + 0.5 * $kbudget), 0.05, 4.0)
  $kbiterib = clamp($biterib * (0.5 + 0.5 * $kage), 0.0, 1.0)
  $kupright = clamp($upright, 0.0, 1.0)
  $ktile = clamp($tile, 1.0, 10000.0)
  $kaspect = clamp($aspect, 0.1, 20.0)
  subtract($Tear, width=$kwidth, thick=$kthick, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, s=$noise, layers=$ksteps, wob=0.2, lean=$klean, shelf=$kshelf, jog=$kjog, la=$kdeep * $kwidth, ca=$kgrain * $kwidth, uneven=0.25, rough=0.75, blunt=$ksquare, qa=1.0, qr=0.5, tilt=$ktilt, tiltend=$ktiltend, sub=$ksub, subw=$ksubw, subrows=$ksubrows, lb=$kclump * $kwidth, cb=$kclumpw * $kwidth, db=$kclumpt * $kthick, sparse=1.4, bblunt=1.0, root=1.0, hl=-$kbite * $kwidth, hx=$kwidth * (0.5 * (atan(tan((sin($noise * 4.7) * 4375.85) * 180 - 90)) / 180 + 0.5) - 0.25), hw=$kbitew * $kbite * $kwidth, hq=1.0, hcap=$kbitecap, ub=$kclumpu, jc=$kclumpd, hb=1 - $kbitecrumb, hstep=$kbitestep, hblock=$kbitevar, htilt=$kbitetilt, hrib=$kbiterib, wander=$kwander, slant=$kslant, at=$origin, rotate=$rotation)
  if ($kuvfit > 1.5) {
    uv(auto)
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile)) [!cut]
  } else {
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile)) [!cut]
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile), offset=(0.37, 0.61)) [cut]
    if ($kupright > 0) {
      if ($kdeep > 0) {
        uv(plane, at=$origin, facing=+X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+X]
        uv(plane, at=$origin, facing=-X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-X]
      }
      if ($kclump > 0) {
        uv(plane, at=$origin, facing=+Y, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+Y]
        uv(plane, at=$origin, facing=-Y, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-Y]
      }
      uv(plane, at=$origin, facing=+Z, up=+X, scale=($ktile, $ktile)) [cut, facing=+Z]
      if ($kuvfit > 0.5) {
        if ($kdeep > 0) {
          uv(plane, at=$origin, facing=(0.707, -0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.486, -0.672, -0.558), facing=(0.672, -0.486, 0.558), facing=(0.974, -0.184, -0.132), facing=(0.184, -0.974, 0.132)]
          uv(plane, at=$origin, facing=(0.707, 0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.627, 0.532, -0.57), facing=(0.532, 0.627, 0.57), facing=(0.176, 0.982, -0.067), facing=(0.982, 0.176, 0.067)]
          uv(plane, at=$origin, facing=(-0.707, -0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.627, -0.532, 0.57), facing=(-0.532, -0.627, -0.57), facing=(-0.982, -0.176, -0.067), facing=(-0.176, -0.982, 0.067)]
          uv(plane, at=$origin, facing=(-0.707, 0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.486, 0.672, 0.558), facing=(-0.672, 0.486, -0.558), facing=(-0.184, 0.974, -0.132), facing=(-0.974, 0.184, 0.132)]
          uv(plane, at=$origin, facing=(0.707, 0, 0.707), up=(-0.707, 0, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.98, 0.089, 0.179), facing=(0.179, -0.089, 0.98), facing=(0.516, 0.567, 0.642), facing=(0.642, -0.567, 0.516)]
          uv(plane, at=$origin, facing=(-0.707, 0, 0.707), up=(0.707, 0, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.192, 0.172, 0.966), facing=(-0.966, -0.172, 0.192), facing=(-0.701, 0.547, 0.458), facing=(-0.458, -0.547, 0.701)]
          uv(plane, at=$origin, facing=(0, -0.707, 0.707), up=(0, 0.707, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.507, -0.389, 0.769), facing=(-0.507, -0.769, 0.389), facing=(-0.269, -0.221, 0.938), facing=(0.269, -0.938, 0.221)]
          uv(plane, at=$origin, facing=(0, 0.707, 0.707), up=(0, -0.707, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.528, 0.738, 0.421), facing=(-0.528, 0.421, 0.738), facing=(-0.224, 0.953, 0.206), facing=(0.224, 0.206, 0.953)]
          uv(plane, at=$origin, facing=(0.577, -0.577, 0.577), up=(-0.408, 0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.938, -0.334, 0.093), facing=(-0.028, -0.576, 0.817), facing=(0.594, 0.033, 0.804), facing=(0.316, -0.943, 0.106)]
          uv(plane, at=$origin, facing=(0.577, 0.577, 0.577), up=(-0.408, -0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.846, 0.533, -0.014), facing=(0.064, 0.377, 0.924), facing=(0.139, 0.952, 0.274), facing=(0.771, -0.042, 0.636)]
          uv(plane, at=$origin, facing=(-0.577, -0.577, 0.577), up=(0.408, 0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.126, -0.29, 0.949), facing=(-0.784, -0.62, -0.039), facing=(-0.835, 0.02, 0.55), facing=(-0.075, -0.93, 0.36)]
          uv(plane, at=$origin, facing=(-0.577, 0.577, 0.577), up=(0.408, -0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.044, 0.655, 0.755), facing=(-0.954, 0.255, 0.155), facing=(-0.397, 0.916, 0.051), facing=(-0.513, -0.006, 0.859)]
        }
      }
    } else {
      if ($kdeep > 0) {
        uv(plane, at=$origin, facing=+X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+X]
        uv(plane, at=$origin, facing=-X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-X]
      }
      if ($kclump > 0) {
        uv(plane, at=$origin, facing=+Z, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+Z]
        uv(plane, at=$origin, facing=-Z, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-Z]
      }
      uv(plane, at=$origin, facing=+Y, up=+X, scale=($ktile, $ktile)) [cut, facing=+Y]
      if ($kuvfit > 0.5) {
        if ($kdeep > 0) {
          uv(plane, at=$origin, facing=(0.707, 0, 0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)]
          uv(plane, at=$origin, facing=(0.707, 0, -0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)]
          uv(plane, at=$origin, facing=(-0.707, 0, 0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)]
          uv(plane, at=$origin, facing=(-0.707, 0, -0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)]
          uv(plane, at=$origin, facing=(0.707, 0.707, 0), up=(-0.707, 0.707, 0), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.98, 0.179, -0.089), facing=(0.179, 0.98, 0.089), facing=(0.516, 0.642, -0.567), facing=(0.642, 0.516, 0.567)]
          uv(plane, at=$origin, facing=(-0.707, 0.707, 0), up=(0.707, 0.707, 0), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.192, 0.966, -0.172), facing=(-0.966, 0.192, 0.172), facing=(-0.701, 0.458, -0.547), facing=(-0.458, 0.701, 0.547)]
          uv(plane, at=$origin, facing=(0, 0.707, 0.707), up=(0, 0.707, -0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.507, 0.769, 0.389), facing=(-0.507, 0.389, 0.769), facing=(-0.269, 0.938, 0.221), facing=(0.269, 0.221, 0.938)]
          uv(plane, at=$origin, facing=(0, 0.707, -0.707), up=(0, 0.707, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.528, 0.421, -0.738), facing=(-0.528, 0.738, -0.421), facing=(-0.224, 0.206, -0.953), facing=(0.224, 0.953, -0.206)]
          uv(plane, at=$origin, facing=(0.577, 0.577, 0.577), up=(-0.408, 0.816, -0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.938, 0.093, 0.334), facing=(-0.028, 0.817, 0.576), facing=(0.594, 0.804, -0.033), facing=(0.316, 0.106, 0.943)]
          uv(plane, at=$origin, facing=(0.577, 0.577, -0.577), up=(-0.408, 0.816, 0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.846, -0.014, -0.533), facing=(0.064, 0.924, -0.377), facing=(0.139, 0.274, -0.952), facing=(0.771, 0.636, 0.042)]
          uv(plane, at=$origin, facing=(-0.577, 0.577, 0.577), up=(0.408, 0.816, -0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.126, 0.949, 0.29), facing=(-0.784, -0.039, 0.62), facing=(-0.835, 0.55, -0.02), facing=(-0.075, 0.36, 0.93)]
          uv(plane, at=$origin, facing=(-0.577, 0.577, -0.577), up=(0.408, 0.816, 0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.044, 0.755, -0.655), facing=(-0.954, 0.155, -0.255), facing=(-0.397, 0.051, -0.916), facing=(-0.513, 0.859, 0.006)]
        }
      }
    }
  }
}

# A SPLIT ALONG THE GRAIN from an end (real photos rule 9). `origin` is the mouth,
# on the bottom face at the board's end; the split runs `length` cm back toward
# -Y. Every knob is the `Rift`'s (see there), fractions of the width: `open`
# mouth, `wedge` how much wider it opens at the bottom face than the top (a
# wedge-driven V end on), `close` taper, `bevel` mouth bevel, `wander` path, `ledge` ledge size
# every `stair` widths, `plies` layers it steps through by up to `peelw`, `tear`
# wall tearing in ridges `ridges` apart; `detail`, `noise`, the frame, `tile`
# and `aspect` as `Snap`.
#   lipfray 0 (round 12) how far the plies' steps and the torn ridges reach the board's
#           faces (0: they fade out 0.12 x thickness short, clean lips; 0.25 frayed,
#           layered lips, as SplitBoard and the shop mesh write).
#   uvfit   0 (round 12) 1 maps the torn walls on four narrow windows between the width
#           and the thickness (stretch 1.35-1.40 -> 1.27-1.30); they sit under
#           `tear` > 0, which guarantees their faces (an empty window is refused).
# KNOBS (round 13): name, unit, range (a value past it is clamped), default, meaning. The top-level knobs
# come first; damage scales the opening (open) and the torn walls (tear); age scales tear and the mouth's bevel by 0.5 + 0.5 x age; length is a size and is never scaled; budget scales detail.
#   length     cm           1 to 1000        30.0      how far back the split runs
#   width      cm           1 to 200         22.5      the board's width (across the grain, X)
#   thick      cm           0.3 to 100       3.8       the board's thickness (Z)
#   damage     x            0 to 3           1.0       how broken: scales the break's reach and its loose material (see the entry's line); 1 as written
#   age        0-2          0 to 2           1.0       how worn: 0 fresh, 1 as written, 2 weathered (see the entry's line)
#   noise      seed         not clamped      7         the seed: any number, every one valid (not clamped)
#   budget     0-2          0 to 2           1         point spacing: 0 game (half the detail), 1 high (as written), 2 ultra (1.5 x the detail); the build line's [triangles=] sets the final count
#   origin     cm           not clamped      (0,0,0)   where the break crosses the board's bottom face, mid-width (the Damage frame)
#   rotation   degrees      not clamped      (0,0,0)   turns the frame (a slanted break, a standing post)
#   open       x width      0 to 0.6         0.12      the mouth's opening
#   wedge      x            -1 to 1          0.5       how much wider the mouth is at the bottom than the top
#   close      exponent     0 to 6           2.0       how fast the mouth closes to a hairline
#   bevel      x width      0 to 0.4         0.08      the mouth's torn bevel
#   wander     x width      0 to 0.5         0.12      the split's sway
#   ledge      x width      0 to 0.2         0.03      the stepped ledges' jog along the grain
#   stair      x width      0.1 to 5         1.0       a ledge's length
#   plies      count        1 to 8           3         the layers the split steps through
#   peelw      x width      0.01 to 0.3      0.08      the peeled strip's width (Split: a ply's step across the split)
#   tear       x width      0 to 0.3         0.045     the torn walls' ridge height (0 smooth)
#   ridges     x width      0.005 to 0.3     0.03      the torn ridges' pitch through the thickness
#   tearblk    x stair      0.01 to 1        0.07      a torn ridge's length along the grain
#   lipfray    0-1          0 to 1           0.0       how far the plies' steps and torn ridges reach the faces (0 clean lips)
#   uvfit      0/1/2        0 to 2           0         the torn faces' UVs: 0 the facing split, 1 + narrow windows, 2 an automatic unwrap
#   detail     x            0.05 to 4        1.0       point spacing scale (2 twice as fine, about 4 x the triangles)
#   lipridge   0-1          0 to 1           0.0       the walls' ridges become fibres: tented through the thickness and tapering along the grain (0 flat blocks)
#   fibre      vector       not clamped      (0,1,0)   the grain direction in the mesh's axes, when `rotation` turns the board
#   face       vector       not clamped      (0,0,1)   the wide face's normal in the mesh's axes, when `rotation` turns the board
#   tile       cm           1 to 10000       100.0     one texture tile
#   aspect     x            0.1 to 20        1.0       the along-grain tile over the across tile (1 square; 4 the direction checker)
Split = instruction(length=30.0, width=22.5, thick=3.8, damage=1.0, age=1.0, noise=7, budget=1, origin=(0,0,0), rotation=(0,0,0), open=0.12, wedge=0.5, close=2.0, bevel=0.08, wander=0.12, ledge=0.03, stair=1.0, plies=3, peelw=0.08, tear=0.045, ridges=0.03, tearblk=0.07, lipfray=0.0, uvfit=0, detail=1.0, lipridge=0.0, fibre=(0,1,0), face=(0,0,1), tile=100.0, aspect=1.0) {
  $kdamage = clamp($damage, 0.0, 3.0)
  $kage = clamp($age, 0.0, 2.0)
  $kbudget = clamp($budget, 0.0, 2.0)
  $klength = clamp($length, 1.0, 1000.0)
  $kwidth = clamp($width, 1.0, 200.0)
  $kthick = clamp($thick, 0.3, 100.0)
  $kopen = clamp($open * $kdamage, 0.0, 0.6)
  $kwedge = clamp($wedge, -1.0, 1.0)
  $kclose = clamp($close, 0.0, 6.0)
  $kbevel = clamp($bevel * (0.5 + 0.5 * $kage), 0.0, 0.4)
  $kwander = clamp($wander, 0.0, 0.5)
  $kledge = clamp($ledge, 0.0, 0.2)
  $kstair = clamp($stair, 0.1, 5.0)
  $kplies = clamp($plies, 1.0, 8.0)
  $kpeelw = clamp($peelw, 0.01, 0.3)
  $ktear = clamp($tear * $kdamage * (0.5 + 0.5 * $kage), 0.0, 0.3)
  $kridges = clamp($ridges, 0.005, 0.3)
  $ktearblk = clamp($tearblk, 0.01, 1.0)
  $klipfray = clamp($lipfray, 0.0, 1.0)
  $kuvfit = clamp($uvfit, 0.0, 2.0)
  $kdetail = clamp($detail * (0.5 + 0.5 * $kbudget), 0.05, 4.0)
  $klipridge = clamp($lipridge, 0.0, 1.0)
  $ktile = clamp($tile, 1.0, 10000.0)
  $kaspect = clamp($aspect, 0.1, 20.0)
  if ($klipfray > 0) {
    subtract($RiftL, width=$kwidth, thick=$kthick, open=$kopen, wedge=$kwedge, length=$klength, close=$kclose, bevel=$kbevel, wander=$kwander, ledge=$kledge, stair=$kstair, plies=$kplies, peelw=$kpeelw, tear=$ktear, ridges=$kridges, blk=$ktearblk, lf=$klipfray, lr=$klipridge, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, s=$noise, at=$origin, rotate=$rotation)
  } else {
    subtract($Rift, width=$kwidth, thick=$kthick, open=$kopen, wedge=$kwedge, length=$klength, close=$kclose, bevel=$kbevel, wander=$kwander, ledge=$kledge, stair=$kstair, plies=$kplies, peelw=$kpeelw, tear=$ktear, ridges=$kridges, blk=$ktearblk, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, s=$noise, at=$origin, rotate=$rotation)
  }
  if ($klipridge > 0) {
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile)) [!cut]
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile), offset=(0.37, 0.61)) [cut]
    uv(plane, at=$origin, facing=+X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.966, -0.257, 0.029), facing=(0.966, 0.257, -0.029), facing=(0.966, -0.029, -0.257), facing=(0.966, 0.029, 0.257)]
    uv(plane, at=$origin, facing=-X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.966, 0.257, -0.029), facing=(-0.966, -0.257, 0.029), facing=(-0.966, -0.029, -0.257), facing=(-0.966, 0.029, 0.257)]
  } else {
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile)) [!cut]
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile), offset=(0.37, 0.61)) [cut]
    uv(plane, at=$origin, facing=+X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+X]
    uv(plane, at=$origin, facing=-X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-X]
  }
  if ($kuvfit > 0.5) {
    if ($ktear > 0) {
      uv(plane, at=$origin, facing=(0.707, 0, 0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)]
      uv(plane, at=$origin, facing=(0.707, 0, -0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)]
      uv(plane, at=$origin, facing=(-0.707, 0, 0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)]
      uv(plane, at=$origin, facing=(-0.707, 0, -0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)]
    }
  }
}

# A THICK BEAM SNAPPED (rule 4) — NOT the board saw-tooth. The top `1 - lip` of
# the depth breaks at the origin in shelves with spires and ONE HORN; the bottom
# `lip` reaches `run` x depth further (one stair step) and breaks there with
# short spires; the tread between is torn and ribbed (`Ledge`), and a
# delamination opens along the grain at `delam` of the depth. Every knob:
#   deep, grain, layers, lean, shelf, tilt, skew, sub, subw, subrows, fray,
#   strip, ply, needle, tipfray   as `Snap`, for the upper part (fray and ply in
#           depths; the lower part takes about half of each). Round 4 defaults:
#           two shelves on one oblique run, leaning cell walls, wide thin SHEETS
#           of fibre (strip 0.15, ply 0.045) fraying at the tips, stepped flanks
#           (end-on, round 3's narrow tall cells read as basalt prisms). Round 6:
#           three sheets to a shelf (subrows 3), sheets 1.8 cm thick (ply 0.09: the
#           beam's points sit 0.5-0.7 cm apart, so thinner sheets aliased), walls
#           leaning less (tilt 0.3: at 0.7 they crossed the sheets, a rock floor end-on)
#   lip     the step's height (fraction of depth); run its length (depths)
#   ridge   the tread's ribs' height (depths); rib their width (fraction of width)
#   delam   the delamination's height (fraction of depth); split its length (depths)
#   horn    the horn's length (depths); hornw its half-width (fraction of width);
#           hornrib how unequal its fibres are (as `Snap`);
#   sparse  how few of the upper part's fibre bundles are long (as `Snap`);
#           hornq its shape (below 1 full-bodied, above 1 needle)
#   detail, noise, origin, rotation, fibre, face, upright, tile, aspect as `Snap`
#   rings   0 (default; round 8 A/B kept the grid): the break's cells are RING bands about a pith crossed by
#           RAYS from it, as wood's end grain is (round 8); 0 the round-7 grid of
#           shelves and columns. pithx / pithz the pith (x width from the middle,
#           x thickness up from the bottom face: -3 a flat-sawn board's heart well
#           below it, 0.5 a boxed heart), pithd a per-seed shift of it (x width);
#           hold how much the board's faces keep their full teeth (1); heart 1
#           (default) makes the inner rings reach furthest (a post: no pit at its heart)
#   torn    above 0 (round 9): every fibre bundle ends in a BLUNT TORN END roughly
#           across the grain over `torn` of its section (0.85 on the shop mesh and
#           BrokenBeam; round 9 A/B: on rings a beam's boxed heart fans into a
#           radial burst, so beams keep the grid), at its own depth, never a pyramid tip (a
#           field of small tips read end-on as gravel or crystal); 0 (default, so
#           a mesh that already calls it keeps its look) round 8's tapered tips.
#           torntilt how far each end tilts (0.15: a few degrees to about 20);
#           tornrib 1 gives each bundle one ribbon length (no second, finer set of
#           ribbon cells cutting the bundles into chips); tornsep how deep the
#           cracks between bundles are, x the spires' reach (0.15; large: every
#           bundle free to its root). Finer fibre is the texture layer's.
#   treadtorn 1 (round 10) passes `torn` to the tread (`Ledge`), so its ridges end
#           in plateaus too; 0 is round 9's tread. The shop mesh and BrokenBeam also
#           write `rib` 0.25: at 0.1 the tread's 2 cm ridges read end-on as a zipper.
#   lowfray 0.6 (round 12) the lower step's ribbons, x `fray` (0.3 on BrokenBeam and the
#           shop mesh: at 0.6 a row of small chips ran along the end-on's lower edge);
#           treadfray 0.35 the tread's ribbons, x `ridge`.
# KNOBS (round 13): name, unit, range (a value past it is clamped), default, meaning. The top-level knobs
# come first; damage scales deep, fray and split (the delamination); age scales tipfray (1.5 - 0.5 x age); budget scales detail.
#   width      cm           1 to 200         20.0      the board's width (across the grain, X)
#   thick      cm           0.3 to 100       20.0      the board's thickness (Z)
#   damage     x            0 to 3           1.0       how broken: scales the break's reach and its loose material (see the entry's line); 1 as written
#   age        0-2          0 to 2           1.0       how worn: 0 fresh, 1 as written, 2 weathered (see the entry's line)
#   noise      seed         not clamped      9         the seed: any number, every one valid (not clamped)
#   budget     0-2          0 to 2           1         point spacing: 0 game (half the detail), 1 high (as written), 2 ultra (1.5 x the detail); the build line's [triangles=] sets the final count
#   origin     cm           not clamped      (0,0,0)   where the break crosses the board's bottom face, mid-width (the Damage frame)
#   rotation   degrees      not clamped      (0,0,0)   turns the frame (a slanted break, a standing post)
#   deep       x width      0 to 6           0.6       the spires' reach: up to 0.4 x deep x width
#   grain      x width      0.03 to 1        0.2       spire width (about 1/grain spires per shelf)
#   layers     count        1 to 16          2         shelves through the thickness
#   lean       x thickness  0 to 4           0.6       the top face's tear off the bottom face's
#   shelf      0-1          0 to 1           0.15      share of the lean taken in steps rather than one oblique run
#   tilt       slope        0 to 2           0.3       how the shelves' cell walls lean end-on (0 square prisms)
#   skew       x            0 to 2           0.8       how far each tip sits off its spire's middle (0 centred, 1 the edge)
#   sub        x width      0 to 0.5         0.06      steps on each spire: sub-cells stop 0.4-1 x sub x width short (0 none)
#   subw       x spire      0.05 to 1        0.33      a sub-cell's width
#   subrows    count        1 to 8           3         sub-cells to a shelf through the thickness
#   fray       x thickness  0 to 3           0.3       the ribbons' reach (0 none)
#   strip      x width      0.005 to 0.5     0.15      ribbon width
#   ply        x thickness  0.01 to 1        0.09      ribbon thickness
#   needle     x            0.1 to 3         0.8       tip sharpness (0.4 blunt, 1.5 needles)
#   tipfray    x            0 to 3           1.0       how much longer the ribbons on the spires' tips run (0 even)
#   lip        x thickness  0.05 to 0.6      0.25      the lower step's height
#   run        x thickness  0 to 2           0.5       how far the lower step reaches on
#   ridge      x thickness  0 to 0.3         0.05      the tread's ridge height
#   rib        x width      0.02 to 1        0.1       the tread's ridge pitch
#   delam      x thickness  0.05 to 0.95     0.33      the delamination's height
#   split      x thickness  0 to 4           1.0       the delamination's length (BeamBreak); SplitBoard: the split's length in cm
#   horn       x thickness  0 to 6           0.9       one long spire (0 none)
#   hornw      x width      0.02 to 0.6      0.11      the horn's width
#   hornq      x            0.2 to 4         1.1       the horn's tip exponent
#   hornrib    0-1          0 to 1           0.5       how ragged the horn's fibres are (0 one smooth horn)
#   sparse     x            0.5 to 4         2.5       how few ribbons are long (1 many, 3 few)
#   taper      0-1          0 to 1           1.0       each bundle tents through its row (pyramid tips; `torn` blunts them)
#   tvar       0-1          0 to 1           0.5       how many cells stay blunter
#   stap       0-1          0 to 1           1.0       the same tent per sub-cell (narrow sub-bundles)
#   rowjog     0-1          0 to 1           1.0       sub-rows staggered per sub-column
#   long       x reach      0 to 3           0.5       one to three long splinters this much further (0 none)
#   vdep       x reach      0 to 2           0.4       each pair of cells' base set back by its own draw (no comb of valleys)
#   uvfit      0/1/2        0 to 2           1         the torn faces' UVs: 0 the facing split, 1 + narrow windows, 2 an automatic unwrap
#   rings      switch       0 to 1           0         1: cells are growth-ring bands about a pith crossed by rays; 0 a grid
#   pithx      x width      -3 to 3          0.0       the pith across, from the middle
#   pithz      x thickness  -10 to 10        0.5       the pith up from the bottom face (-3 flat-sawn, 0.5 a boxed heart)
#   pithd      x width      0 to 1           0.1       a per-seed shift of the pith
#   hold       0-1          0 to 1           1.0       how much the board's faces keep their full teeth
#   heart      switch       0 to 1           1         1: the inner rings reach furthest (a post's heart never pits)
#   torn       0-1          0 to 0.98        0.0       bundles end in blunt torn ends over this share of their section (0 tapered tips)
#   torntilt   x            0 to 1           0.0       how far each torn end tilts
#   tornrib    switch       0 to 1           0         1: one ribbon length per bundle
#   tornsep    x reach      0 to 1           0.15      how deep the cracks between bundles run
#   treadtorn  switch       0 to 1           1         1 passes `torn` to the tread
#   lowfray    x fray       0 to 2           0.6       the lower step's ribbons
#   treadfray  x ridge      0 to 2           0.35      the tread's ribbons
#   detail     x            0.05 to 4        1.0       point spacing scale (2 twice as fine, about 4 x the triangles)
#   fibre      vector       not clamped      (0,1,0)   the grain direction in the mesh's axes, when `rotation` turns the board
#   face       vector       not clamped      (0,0,1)   the wide face's normal in the mesh's axes, when `rotation` turns the board
#   upright    switch       0 to 1           0         1 when the grain stands up +Z (a post): the torn faces' UV split turns with it
#   tile       cm           1 to 10000       100.0     one texture tile
#   aspect     x            0.1 to 20        1.0       the along-grain tile over the across tile (1 square; 4 the direction checker)
BeamBreak = instruction(width=20.0, thick=20.0, damage=1.0, age=1.0, noise=9, budget=1, origin=(0,0,0), rotation=(0,0,0), deep=0.6, grain=0.2, layers=2, lean=0.6, shelf=0.15, tilt=0.3, skew=0.8, sub=0.06, subw=0.33, subrows=3, fray=0.3, strip=0.15, ply=0.09, needle=0.8, tipfray=1.0, lip=0.25, run=0.5, ridge=0.05, rib=0.1, delam=0.33, split=1.0, horn=0.9, hornw=0.11, hornq=1.1, hornrib=0.5, sparse=2.5, taper=1.0, tvar=0.5, stap=1.0, rowjog=1.0, long=0.5, vdep=0.4, uvfit=1, rings=0, pithx=0.0, pithz=0.5, pithd=0.1, hold=1.0, heart=1, torn=0.0, torntilt=0.0, tornrib=0, tornsep=0.15, treadtorn=1, lowfray=0.6, treadfray=0.35, detail=1.0, fibre=(0,1,0), face=(0,0,1), upright=0, tile=100.0, aspect=1.0) {
  $kdamage = clamp($damage, 0.0, 3.0)
  $kage = clamp($age, 0.0, 2.0)
  $kbudget = clamp($budget, 0.0, 2.0)
  $kwidth = clamp($width, 1.0, 200.0)
  $kthick = clamp($thick, 0.3, 100.0)
  $kdeep = clamp($deep * $kdamage, 0.0, 6.0)
  $kgrain = clamp($grain, 0.03, 1.0)
  $klayers = clamp($layers, 1.0, 16.0)
  $klean = clamp($lean, 0.0, 4.0)
  $kshelf = clamp($shelf, 0.0, 1.0)
  $ktilt = clamp($tilt, 0.0, 2.0)
  $kskew = clamp($skew, 0.0, 2.0)
  $ksub = clamp($sub, 0.0, 0.5)
  $ksubw = clamp($subw, 0.05, 1.0)
  $ksubrows = clamp($subrows, 1.0, 8.0)
  $kfray = clamp($fray * $kdamage, 0.0, 3.0)
  $kstrip = clamp($strip, 0.005, 0.5)
  $kply = clamp($ply, 0.01, 1.0)
  $kneedle = clamp($needle, 0.1, 3.0)
  $ktipfray = clamp($tipfray * (1.5 - 0.5 * $kage), 0.0, 3.0)
  $klip = clamp($lip, 0.05, 0.6)
  $krun = clamp($run, 0.0, 2.0)
  $kridge = clamp($ridge, 0.0, 0.3)
  $krib = clamp($rib, 0.02, 1.0)
  $kdelam = clamp($delam, 0.05, 0.95)
  $ksplit = clamp($split * $kdamage, 0.0, 4.0)
  $khorn = clamp($horn, 0.0, 6.0)
  $khornw = clamp($hornw, 0.02, 0.6)
  $khornq = clamp($hornq, 0.2, 4.0)
  $khornrib = clamp($hornrib, 0.0, 1.0)
  $ksparse = clamp($sparse, 0.5, 4.0)
  $ktaper = clamp($taper, 0.0, 1.0)
  $ktvar = clamp($tvar, 0.0, 1.0)
  $kstap = clamp($stap, 0.0, 1.0)
  $krowjog = clamp($rowjog, 0.0, 1.0)
  $klong = clamp($long, 0.0, 3.0)
  $kvdep = clamp($vdep, 0.0, 2.0)
  $kuvfit = clamp($uvfit, 0.0, 2.0)
  $krings = clamp($rings, 0.0, 1.0)
  $kpithx = clamp($pithx, -3.0, 3.0)
  $kpithz = clamp($pithz, -10.0, 10.0)
  $kpithd = clamp($pithd, 0.0, 1.0)
  $khold = clamp($hold, 0.0, 1.0)
  $kheart = clamp($heart, 0.0, 1.0)
  $ktorn = clamp($torn, 0.0, 0.98)
  $ktorntilt = clamp($torntilt, 0.0, 1.0)
  $ktornrib = clamp($tornrib, 0.0, 1.0)
  $ktornsep = clamp($tornsep, 0.0, 1.0)
  $ktreadtorn = clamp($treadtorn, 0.0, 1.0)
  $klowfray = clamp($lowfray, 0.0, 2.0)
  $ktreadfray = clamp($treadfray, 0.0, 2.0)
  $kdetail = clamp($detail * (0.5 + 0.5 * $kbudget), 0.05, 4.0)
  $kupright = clamp($upright, 0.0, 1.0)
  $ktile = clamp($tile, 1.0, 10000.0)
  $kaspect = clamp($aspect, 0.1, 20.0)
  subtract($Tear, width=$kwidth, thick=$kthick, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, s=$noise, layers=$klayers, lean=$klean, shelf=$kshelf, jog=0.5, la=0.4 * $kdeep * $kwidth, ca=$kgrain * $kwidth, uneven=0.25, rough=0.95, qa=$kneedle, skew=$kskew, tilt=$ktilt, sub=$ksub, subw=$ksubw, subrows=$ksubrows, tipfray=$ktipfray, lb=$kfray * $kthick, cb=$kstrip * $kwidth, db=$kply * $kthick, sparse=$ksparse, hrib=$khornrib, hl=$khorn * $kthick, hx=$kwidth * (0.5 * (atan(tan((sin($noise * 2.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 0.25), hw=$khornw * $kwidth, hq=$khornq, hv0=0.1 + 0.3 * (atan(tan((sin($noise * 3.7) * 4375.85) * 180 - 90)) / 180 + 0.5), hv1=0.55 + 0.35 * (atan(tan((sin($noise * 3.7) * 4375.85) * 180 - 90)) / 180 + 0.5), taper=$ktaper, tvar=$ktvar, stap=$kstap, stag=$krowjog, jc=$krowjog, long=$klong, vdep=$kvdep, rings=$krings, px=($kpithx + $kpithd * (2 * (atan(tan((sin($noise * 6.7) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $kwidth, pz=$kpithz * $kthick + $kpithd * $kwidth * (2 * (atan(tan((sin($noise * 7.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1), hold=$khold, heart=$kheart, torn=$ktorn, ttilt=$ktorntilt, trib=$ktornrib, tsep=$ktornsep, wander=0.08, slant=0.1, z0=$klip, z1=1.0, at=$origin, rotate=$rotation)
  subtract($Tear, width=$kwidth, thick=$kthick, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, s=$noise + 5, layers=2, lean=0.1, shelf=0.5, jog=0.5, la=0.2 * $kdeep * $kwidth, ca=1.3 * $kgrain * $kwidth, uneven=0.25, rough=0.9, qa=$kneedle, skew=$kskew, tilt=$ktilt, sub=$ksub, subw=$ksubw, subrows=$ksubrows, tipfray=$ktipfray, lb=$klowfray * $kfray * $kthick, cb=$kstrip * $kwidth, db=0.6 * $kply * $kthick, sparse=2.0, taper=$ktaper, tvar=$ktvar, stap=$kstap, stag=$krowjog, jc=$krowjog, rings=$krings, px=($kpithx + $kpithd * (2 * (atan(tan((sin($noise * 6.7) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $kwidth, pz=$kpithz * $kthick + $kpithd * $kwidth * (2 * (atan(tan((sin($noise * 7.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1), hold=$khold, heart=$kheart, torn=$ktorn, ttilt=$ktorntilt, trib=$ktornrib, tsep=$ktornsep, wander=0.06, slant=0.08, z0=0.0, z1=$klip - 0.35 / $kthick, shift=$krun * $kthick, at=$origin, rotate=$rotation)
  subtract($Ledge, width=$kwidth, thick=$kthick, lip=$klip, run=$krun, from=-(0.5 * $klean * (1 - $klip) * $kthick + 0.21 * $kwidth + 1.5), over=0.2 * $kdeep * $kwidth + 0.6 * $kfray * $kthick + 2.0, res=1.3 * 0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, ridge=$kridge, rib=$krib, s=$noise + 19, torn=$ktreadtorn * $ktorn, ttilt=$ktorntilt, trib=$ktornrib, tsep=$ktornsep, tf=$ktreadfray, at=$origin, rotate=$rotation)
  subtract($Delam, width=$kwidth, thick=$kthick, delam=$kdelam, split=$ksplit, s=$noise + 23, at=$origin, rotate=$rotation)
  if ($kuvfit > 1.5) {
    uv(auto)
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile)) [!cut]
  } else {
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile)) [!cut]
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile), offset=(0.37, 0.61)) [cut]
    if ($kupright > 0) {
      if ($kdeep > 0) {
        uv(plane, at=$origin, facing=+X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+X]
        uv(plane, at=$origin, facing=-X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-X]
      }
      if ($kfray > 0) {
        uv(plane, at=$origin, facing=+Y, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+Y]
        uv(plane, at=$origin, facing=-Y, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-Y]
      }
      uv(plane, at=$origin, facing=+Z, up=+X, scale=($ktile, $ktile)) [cut, facing=+Z]
      if ($kuvfit > 0.5) {
        if ($kdeep > 0) {
          uv(plane, at=$origin, facing=(0.707, -0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.486, -0.672, -0.558), facing=(0.672, -0.486, 0.558), facing=(0.974, -0.184, -0.132), facing=(0.184, -0.974, 0.132)]
          uv(plane, at=$origin, facing=(0.707, 0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.627, 0.532, -0.57), facing=(0.532, 0.627, 0.57), facing=(0.176, 0.982, -0.067), facing=(0.982, 0.176, 0.067)]
          uv(plane, at=$origin, facing=(-0.707, -0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.627, -0.532, 0.57), facing=(-0.532, -0.627, -0.57), facing=(-0.982, -0.176, -0.067), facing=(-0.176, -0.982, 0.067)]
          uv(plane, at=$origin, facing=(-0.707, 0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.486, 0.672, 0.558), facing=(-0.672, 0.486, -0.558), facing=(-0.184, 0.974, -0.132), facing=(-0.974, 0.184, 0.132)]
          uv(plane, at=$origin, facing=(0.707, 0, 0.707), up=(-0.707, 0, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.98, 0.089, 0.179), facing=(0.179, -0.089, 0.98), facing=(0.516, 0.567, 0.642), facing=(0.642, -0.567, 0.516)]
          uv(plane, at=$origin, facing=(-0.707, 0, 0.707), up=(0.707, 0, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.192, 0.172, 0.966), facing=(-0.966, -0.172, 0.192), facing=(-0.701, 0.547, 0.458), facing=(-0.458, -0.547, 0.701)]
          uv(plane, at=$origin, facing=(0, -0.707, 0.707), up=(0, 0.707, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.507, -0.389, 0.769), facing=(-0.507, -0.769, 0.389), facing=(-0.269, -0.221, 0.938), facing=(0.269, -0.938, 0.221)]
          uv(plane, at=$origin, facing=(0, 0.707, 0.707), up=(0, -0.707, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.528, 0.738, 0.421), facing=(-0.528, 0.421, 0.738), facing=(-0.224, 0.953, 0.206), facing=(0.224, 0.206, 0.953)]
          uv(plane, at=$origin, facing=(0.577, -0.577, 0.577), up=(-0.408, 0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.938, -0.334, 0.093), facing=(-0.028, -0.576, 0.817), facing=(0.594, 0.033, 0.804), facing=(0.316, -0.943, 0.106)]
          uv(plane, at=$origin, facing=(0.577, 0.577, 0.577), up=(-0.408, -0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.846, 0.533, -0.014), facing=(0.064, 0.377, 0.924), facing=(0.139, 0.952, 0.274), facing=(0.771, -0.042, 0.636)]
          uv(plane, at=$origin, facing=(-0.577, -0.577, 0.577), up=(0.408, 0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.126, -0.29, 0.949), facing=(-0.784, -0.62, -0.039), facing=(-0.835, 0.02, 0.55), facing=(-0.075, -0.93, 0.36)]
          uv(plane, at=$origin, facing=(-0.577, 0.577, 0.577), up=(0.408, -0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.044, 0.655, 0.755), facing=(-0.954, 0.255, 0.155), facing=(-0.397, 0.916, 0.051), facing=(-0.513, -0.006, 0.859)]
        }
      }
    } else {
      if ($kdeep > 0) {
        uv(plane, at=$origin, facing=+X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+X]
        uv(plane, at=$origin, facing=-X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-X]
      }
      if ($kfray > 0) {
        uv(plane, at=$origin, facing=+Z, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+Z]
        uv(plane, at=$origin, facing=-Z, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-Z]
      }
      uv(plane, at=$origin, facing=+Y, up=+X, scale=($ktile, $ktile)) [cut, facing=+Y]
      if ($kuvfit > 0.5) {
        if ($kdeep > 0) {
          uv(plane, at=$origin, facing=(0.707, 0, 0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)]
          uv(plane, at=$origin, facing=(0.707, 0, -0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)]
          uv(plane, at=$origin, facing=(-0.707, 0, 0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)]
          uv(plane, at=$origin, facing=(-0.707, 0, -0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)]
          uv(plane, at=$origin, facing=(0.707, 0.707, 0), up=(-0.707, 0.707, 0), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.98, 0.179, -0.089), facing=(0.179, 0.98, 0.089), facing=(0.516, 0.642, -0.567), facing=(0.642, 0.516, 0.567)]
          uv(plane, at=$origin, facing=(-0.707, 0.707, 0), up=(0.707, 0.707, 0), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.192, 0.966, -0.172), facing=(-0.966, 0.192, 0.172), facing=(-0.701, 0.458, -0.547), facing=(-0.458, 0.701, 0.547)]
