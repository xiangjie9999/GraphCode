}

# ---- the wood shop window --------------------------------------------------
# A 60 cm length of the scaffold board's 225 x 38 section with eased arrises,
# and a 20 x 20 beam 80 cm long, each SWEPT along its grain from its section
# (see the UV note above). Bevel before damage, as above. The slots are the
# family's two, declared here and painted by these examples only: the entries
# themselves paint nothing.

Face = material()
Broken = material()

WoodSection = mesh(width=22.5, thick=3.8, len=60.0, ease=0.25) {
  points((-0.5 * $width + $ease, -0.5 * $thick), (0.5 * $width - $ease, -0.5 * $thick), (0.5 * $width, -0.5 * $thick + $ease), (0.5 * $width, 0.5 * $thick - $ease), (0.5 * $width - $ease, 0.5 * $thick), (-0.5 * $width + $ease, 0.5 * $thick), (-0.5 * $width, 0.5 * $thick - $ease), (-0.5 * $width, -0.5 * $thick + $ease), loop=true)
  extrude(height=$len)
}

WoodBoard = mesh(width=22.5, thick=3.8, len=60.0) {
  add($WoodSection, width=$width, thick=$thick, len=$len, ease=0.065 * $thick, at=(0.0, 0.5 * $len, 0.5 * $thick), rotate=(-90.0, 0.0, 0.0))
}

WoodBeam = mesh(width=20.0, thick=20.0, len=80.0) {
  add($WoodSection, width=$width, thick=$thick, len=$len, ease=0.5, at=(0.0, 0.5 * $len, 0.5 * $thick), rotate=(-90.0, 0.0, 0.0))
}

Snap_Ex      = mesh() { add($WoodBoard) $Snap(origin=(0.0, 15.0, 0.0), rings=1, torn=0.85, torntilt=0.15, tornrib=1, tornsep=0.15, detail=0.75) keep(largest) uv(plane, facing=(0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)] uv(plane, facing=(0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)] uv(plane, facing=(-0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)] uv(plane, facing=(-0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)] material($Face) material($Broken) [cut] }
SnapOff_Ex   = mesh() { add($WoodBoard) $SnapOff(origin=(0.0, 15.0, 0.0), rings=1, torn=0.85, torntilt=0.15, tornrib=1, tornsep=0.15, detail=0.65, chew=0.05, longside=1) keep(largest) uv(plane, facing=(0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)] uv(plane, facing=(0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)] uv(plane, facing=(-0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)] uv(plane, facing=(-0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)] material($Face) material($Broken) [cut] }
Crumble_Ex   = mesh() { add($WoodBoard) $Crumble(origin=(0.0, 18.0, 0.0), bitetilt=1.0, bitestep=0.5, bitecap=0.1, square=0.85, tiltend=1.5, biterib=0.8, bitecrumb=1.0) keep(largest) uv(plane, facing=(0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)] uv(plane, facing=(0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)] uv(plane, facing=(-0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)] uv(plane, facing=(-0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)] material($Face) material($Broken) [cut] }
Split_Ex     = mesh() { add($WoodBoard) $Split(origin=(2.0, 30.0, 0.0), uvfit=1, lipfray=0.25, lipridge=1.0) uv(plane, facing=(0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)] uv(plane, facing=(0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)] uv(plane, facing=(-0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)] uv(plane, facing=(-0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)] material($Face) material($Broken) [cut] }
BeamBreak_Ex = mesh() { add($WoodBeam) $BeamBreak(origin=(0.0, 20.0, 0.0), torn=0.85, torntilt=0.15, tornrib=1, tornsep=0.15, rib=0.25, horn=0.0, lowfray=0.3, deep=1.125, grain=0.19, layers=8, lean=1.8, shelf=0.65, tilt=0.35, skew=0.8, sub=0.0675, subw=0.33, subrows=2, fray=0.19, strip=0.05, ply=0.034, needle=0.7, tipfray=0.6, sparse=1.3, long=0.8, vdep=0.7, rings=1, pithz=-0.57, pithd=0.17, heart=0, detail=1.0) keep(largest) uv(plane, facing=(0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)] uv(plane, facing=(0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)] uv(plane, facing=(-0.707, 0, 0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)] uv(plane, facing=(-0.707, 0, -0.707), up=(0, 1, 0), scale=(100.0, 100.0)) [!cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)] material($Face) material($Broken) [cut] }

# The texture layer, shown once: the snapped board again with fine fibre on its
# torn faces, ridges six times longer along the grain than across, baked onto
# `Snap_Ex` by `SM_Damage_SnapMaps`.
Snap_ExDetail = mesh() { add($Snap_Ex) roughen(by=0.06, scale=(0.6, 3.6, 0.6), seed=8, form=ridged) [cut] }

# ==== END WOOD ====
