    add($PeelStrip, width=$kwidth, thick=$kthick, la=0.4 * $kdeep * $kwidth, lean=$klean, shelf=$kshelf, layers=$klayers, wander=$kwander, slant=$kslant, peelang=$kpeelang, curl=$kcurl, peelw=$kpeelw, peelback=$kpeelback, dir=-1, n=$noise, s=$noise + 77, at=$origin, rotate=$rotation)
  }
