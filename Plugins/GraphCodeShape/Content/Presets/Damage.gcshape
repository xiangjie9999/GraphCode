# Everything past the break, so a board of any length loses its whole far end:
# a 20 m box, its near face buried in the back of the cutter.
Beyond = mesh(from=27.0) {
  rect(w=2000.0, h=2000.0)
  extrude(height=2000.0)
  place(by=(0.0, $from + 1000.0, -1000.0))
}

# A BREAK across the grain in the wood frame: the `Strata` turned so its face
# meets the wood (+Z onto -Y), plus `Beyond`. Its zero plane is y = `shift`;
# `z0`/`z1` keep it to a band of the thickness (a beam's two levels), a board
# is 0..1, with a 0.5 cm overhang at the board's own faces and 0.3 cm inside a
# beam. `lean` is in band thicknesses, its sign drawn from the seed (the top
# face shorter three times in four); `shelf` is the share of it taken in steps;
# `wander`/`slant` (fractions of the width) sway and slant the whole line. The
# rest pass straight to `Strata`. The cutter is deep enough that nothing the
# field reaches crosses `Beyond`'s face, and `Beyond` overlaps its back by the
# most the field can pull the back out.
Tear = mesh(width=22.5, thick=3.8, z0=0.0, z1=1.0, shift=0.0, s=3, res=0.2, layers=3, wob=0.3, lean=1.8, shelf=0.65, jog=0.35, la=9.0, ca=3.8, uneven=0.2, rough=0.8, blunt=0.0, qa=0.7, qr=1.2, lb=3.0, cb=1.0, db=0.68, sparse=2.0, bblunt=0.0, root=0.35, hl=0.0, hx=0.0, hw=2.7, hq=0.8, hcap=0.0, hv0=0.0, hv1=1.0, wander=0.1, slant=0.15, hs=0, ub=0.2, jb=0.15, jc=0.0, hrib=0.0, hb=0.0, hstep=0.0, tilt=0.0, skew=0.5, sub=0.0, subw=0.33, subrows=2, tipfray=0.0, tiltend=0.0, taper=0.0, tvar=0.0, long=0.0, vdep=0.0, hblock=0.0, stap=0.0, stag=0.0, rings=0.0, px=0.0, pz=0.0, hold=1.0, heart=0.0, torn=0.0, ttilt=0.0, trib=0.0, tsep=0.15, lside=0.0, htilt=0.0) {
  add($Strata, w=$width + 1.0, t=((($z1 - $z0) * $thick) + (0.5 - 0.2 * clamp(100 * $z0, 0, 1)) + (0.5 - 0.2 * clamp(100 * (1 - $z1), 0, 1))), tb=(($z1 - $z0) * $thick), yb=0.5 * ((0.5 - 0.2 * clamp(100 * $z0, 0, 1)) - (0.5 - 0.2 * clamp(100 * (1 - $z1), 0, 1))), len=(0.5 * $lean * (($z1 - $z0) * $thick) + max($la, 0) * (1 + $tiltend) + max($lb, 0) * (1 + $tipfray) + max($hl, 0) + max($la, 0) * ($long + $vdep) + 1.6 * $wander * $width + 0.6 * $slant * $width + 4.0 + (0.5 * $lean * (($z1 - $z0) * $thick) + max(-$la, 0) * (1 + $tiltend) + max(-$lb, 0) * (1 + $tipfray) + max(-$hl, 0) + 1.6 * $wander * $width + 0.6 * $slant * $width + 1.0)), bw=$width, res=$res, s=$s, layers=$layers + $rings * (max($layers, floor($layers * max(sqrt(pow(abs($px) + 0.5 * $width, 2) + pow(max(abs(($pz - $z0 * $thick)), abs((($z1 - $z0) * $thick) - ($pz - $z0 * $thick))), 2)) - sqrt(pow(max(0, abs($px) - 0.5 * $width), 2) + pow(max(0, max(-($pz - $z0 * $thick), ($pz - $z0 * $thick) - (($z1 - $z0) * $thick))), 2)), 0.01) / (($z1 - $z0) * $thick) + 0.5)) - $layers), wob=$wob, lean=-$lean * (($z1 - $z0) * $thick) * (1 - 2 * floor(1.33 * (atan(tan((sin($s * 5.3) * 4375.85) * 180 - 90)) / 180 + 0.5))) * (0.75 + 0.25 * (atan(tan((sin($s * 6.1) * 4375.85) * 180 - 90)) / 180 + 0.5)), ramp=1 - $shelf, jog=$jog, la=$la, ca=$ca, uneven=$uneven, rough=$rough, blunt=$blunt, qa=$qa, qr=$qr, lb=$lb, cb=$cb, db=$db * (1 + $rings * ((($z1 - $z0) * $thick) / max(sqrt(pow(abs($px) + 0.5 * $width, 2) + pow(max(abs(($pz - $z0 * $thick)), abs((($z1 - $z0) * $thick) - ($pz - $z0 * $thick))), 2)) - sqrt(pow(max(0, abs($px) - 0.5 * $width), 2) + pow(max(0, max(-($pz - $z0 * $thick), ($pz - $z0 * $thick) - (($z1 - $z0) * $thick))), 2)), 0.01) - 1)), sparse=$sparse, bblunt=$bblunt, root=$root, hl=$hl, hx=$hx, hw=$hw, hq=$hq, hcap=$hcap, hv0=$hv0, hv1=$hv1, hs=$hs, ub=$ub, jb=$jb, jc=$jc, hrib=$hrib, hb=$hb, hstep=$hstep, tilt=$tilt, skew=$skew, sub=$sub, subw=$subw, subrows=$subrows, tipfray=$tipfray, tiltend=$tiltend, taper=$taper, tvar=$tvar, long=$long, vdep=$vdep, hblock=$hblock, stap=$stap, stag=$stag, rings=$rings, px=$px, pz=$pz - $z0 * $thick, hold=$hold, heart=$heart, torn=$torn, ttilt=$ttilt, trib=$trib, tsep=$tsep, lside=$lside, htilt=$htilt, wa=$wander * $width, sk=$slant * $width, at=(0.0, $shift + (0.5 * $lean * (($z1 - $z0) * $thick) + max($la, 0) * (1 + $tiltend) + max($lb, 0) * (1 + $tipfray) + max($hl, 0) + max($la, 0) * ($long + $vdep) + 1.6 * $wander * $width + 0.6 * $slant * $width + 4.0 + (0.5 * $lean * (($z1 - $z0) * $thick) + max(-$la, 0) * (1 + $tiltend) + max(-$lb, 0) * (1 + $tipfray) + max(-$hl, 0) + 1.6 * $wander * $width + 0.6 * $slant * $width + 1.0)), $z0 * $thick - (0.5 - 0.2 * clamp(100 * $z0, 0, 1)) + 0.5 * ((($z1 - $z0) * $thick) + (0.5 - 0.2 * clamp(100 * $z0, 0, 1)) + (0.5 - 0.2 * clamp(100 * (1 - $z1), 0, 1)))), rotate=(-90.0, 0.0, 0.0))
  add($Beyond, from=$shift + (0.5 * $lean * (($z1 - $z0) * $thick) + max($la, 0) * (1 + $tiltend) + max($lb, 0) * (1 + $tipfray) + max($hl, 0) + max($la, 0) * ($long + $vdep) + 1.6 * $wander * $width + 0.6 * $slant * $width + 4.0 + (0.5 * $lean * (($z1 - $z0) * $thick) + max(-$la, 0) * (1 + $tiltend) + max(-$lb, 0) * (1 + $tipfray) + max(-$hl, 0) + 1.6 * $wander * $width + 0.6 * $slant * $width + 1.0)) - 2.0 - (0.5 * $lean * (($z1 - $z0) * $thick) + max(-$la, 0) * (1 + $tiltend) + max(-$lb, 0) * (1 + $tipfray) + max(-$hl, 0) + 1.6 * $wander * $width + 0.6 * $slant * $width + 1.0))
}

# THE LOSSES a half takes on its own (real photos rule 7: one surface cuts both
# halves, then each loses some 10-20 % of its own strips): a second, shallower
# field set `loss` of the way back from the spires' tips, so it trims only the
# longest spires and ribbons and leaves new broken tips, squared by `lossblunt`.
# ROUND 3: it uses THE BREAK'S OWN CELLS (the same seed `s`, cell width, layers
# and ribbons; only its draws take `hs`; its own point spacing, 1.3 x, because
# identical points pinched the boolean open), so each spire or ribbon is trimmed whole
# or not at all; round 2's own layout cut spires lengthwise into long needles.
# `dir=1` for the -Y half; `dir=-1` MIRRORS it (`mirror=Y`) for the +Y half, so
# the cells stay where they are across the width.
Loss = mesh(width=22.5, thick=3.8, res=0.2, la=9.0, ca=3.8, uneven=0.2, tilt=0.0, layers=3, lb=3.0, cb=1.0, db=0.68, wander=0.1, loss=0.15, lossblunt=0.5, dir=1, s=3, hs=91, rings=0.0, px=0.0, pz=0.0, hold=1.0, heart=0.0, lean=1.8, shelf=0.65, lfol=0.0) {
  if ($dir > 0) {
    add($Tear, width=$width, thick=$thick, res=1.3 * $res, s=$s, hs=$hs, layers=$layers, lean=0.3 + $lfol * ($lean - 0.3), shelf=0.5 + $lfol * ($shelf - 0.5), la=0.6 * $la, ca=$ca, uneven=$uneven, tilt=$tilt, blunt=$lossblunt, lb=$lb, cb=$cb, db=$db, wander=0.5 * $wander, slant=0.05, rings=$rings, px=$px, pz=$pz, hold=$hold, heart=$heart, shift=$la * (1 - 1.5 * $loss))
  } else {
    add($Tear, width=$width, thick=$thick, res=1.3 * $res, s=$s, hs=$hs, layers=$layers, lean=0.3 + $lfol * ($lean - 0.3), shelf=0.5 + $lfol * ($shelf - 0.5), la=0.6 * $la, ca=$ca, uneven=$uneven, tilt=$tilt, blunt=$lossblunt, lb=$lb, cb=$cb, db=$db, wander=0.5 * $wander, slant=0.05, rings=$rings, px=$px, pz=$pz, hold=$hold, heart=$heart, shift=-1.5 * $la * $loss, mirror=Y)
  }
}

# THE LOSSES, part 2: both long edges CHEWED near the break (rubric 12-13), each
# edge a `Strata` facing the board's side whose spires reach INTO the width
# (negative lengths): torn-off edge strips `bitlen` thicknesses long along the
# grain, up to `chew` x width deep, squared by `blunt`, in `layers` layers so the
# top and bottom arrises chew differently, fading out `zone` cm back from `reach`
# (the far end of the break). `dir` as `Loss`. Round 4: the two edges chew to
# different depths (1 +- `chewodd` x a draw) and in strips of their own lengths.
Chew = mesh(width=22.5, thick=3.8, res=0.2, chew=0.08, chewodd=0.5, reach=12.0, zone=24.0, layers=2, bitlen=1.2, blunt=0.6, dir=1, s=31) {
  add($Strata, w=$zone, t=$thick + 1.0, tb=$thick, yb=0.0, len=((1 + $chewodd) * $chew * $width + 3.0), bw=$zone, res=1.4 * $res, s=$s, layers=$layers, wob=0.25, lean=0.4 * $chew * $width * (2 * (atan(tan((sin($s * 7.7) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1), ramp=0.2, jog=0.6, la=-$chew * (1 + $chewodd * (2 * (atan(tan((sin($s * 9.1) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $width, ca=$bitlen * (0.6 + 0.8 * (atan(tan((sin($s * 2.3) * 4375.85) * 180 - 90)) / 180 + 0.5)) * $thick, uneven=0.25, rough=0.9, blunt=$blunt, qa=0.8, qr=0.8, lb=-0.3 * $chew * (1 + $chewodd * (2 * (atan(tan((sin($s * 9.1) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $width, cb=0.45 * $thick, db=0.22 * $thick, sparse=1.6, bblunt=0.6, root=0.5, fx=-1.3 / $zone, fo=0.6, at=($dir * (0.5 * $width + 0.1 + ((1 + $chewodd) * $chew * $width + 3.0)), $dir * ($reach - 0.5 * $zone), 0.5 * $thick), rotate=(-90.0, 0.0, -90.0 + 90.0 * (1 - $dir)))
  add($Strata, w=$zone, t=$thick + 1.0, tb=$thick, yb=0.0, len=((1 + $chewodd) * $chew * $width + 3.0), bw=$zone, res=1.4 * $res, s=$s + 3, layers=$layers, wob=0.25, lean=0.4 * $chew * $width * (2 * (atan(tan((sin($s + 3 * 7.7) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1), ramp=0.2, jog=0.6, la=-$chew * (1 - $chewodd * (2 * (atan(tan((sin($s * 9.1) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $width, ca=$bitlen * (0.6 + 0.8 * (atan(tan((sin($s + 3 * 2.3) * 4375.85) * 180 - 90)) / 180 + 0.5)) * $thick, uneven=0.25, rough=0.9, blunt=$blunt, qa=0.8, qr=0.8, lb=-0.3 * $chew * (1 - $chewodd * (2 * (atan(tan((sin($s * 9.1) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $width, cb=0.45 * $thick, db=0.22 * $thick, sparse=1.6, bblunt=0.6, root=0.5, fx=1.3 / $zone, fo=0.6, at=(-$dir * (0.5 * $width + 0.1 + ((1 + $chewodd) * $chew * $width + 3.0)), $dir * ($reach - 0.5 * $zone), 0.5 * $thick), rotate=(-90.0, 0.0, 90.0 - 90.0 * (1 - $dir)))
}

# THE BOTTOM FACE TORN AWAY toward the break, so the section thins (rubric 13; real
# photos: the tension face tears out): a `Strata` facing up whose band runs ALONG
# THE GRAIN from `back` to `front` (y in the wood frame; `front` the break side,
# either way round), so its three shelves are steps along the grain and its spire
# cells are ridges along the grain on the scar's floor; nothing is cut at `back`,
# about `thin` x thickness at `front`. Coarse points (3 x the break's spacing).
Thin = mesh(width=22.5, thick=3.8, thin=0.22, back=-11.0, front=15.0, res=0.6, s=41) {
  add($Strata, w=$width + 1.0, t=abs($front - $back), tb=abs($front - $back), yb=0.0, len=2.0 * $thin * $thick + 2.0, bw=$width, res=$res, s=$s, layers=3, wob=0.35, lean=-1.6 * $thin * $thick, ramp=0.25, jog=0.5, la=0.35 * $thin * $thick, ca=0.13 * $width, uneven=0.25, rough=0.9, blunt=0.3, qa=1.0, qr=0.6, lb=0.2 * $thin * $thick, cb=0.035 * $width, db=0.3 * abs($front - $back), sparse=1.5, root=0.5, at=(0.0, 0.5 * ($front + $back), 0.55 * $thin * $thick - 2.0 * $thin * $thick - 2.0), rotate=(0.0, 0.0, 90.0 - 90.0 * clamp(($front - $back) * 1000, -1, 1)))
}

# A ribbon about 12 : 1 : 0.15 tapering to 40 % of its width (round 3: a 12 %
# taper read as a needle), bent `curl` degrees along its length.
Ribbon = mesh(len=9.0, w=1.1, t=0.3, curl=25.0) {
  rect(w=$w, h=$t)
  extrude(height=$len, to=40%)
  bend(angle=$curl, around=X, at=(0.0, 0.0, 0.0))
}

# The scar a peeled strip leaves: a box `w` wide whose floor falls from the top
# face at its root to `d` deep `back` cm on (one linear warp, so the eight
# corners carry it exactly), `len` long.
PeelGroove = mesh(len=8.0, w=1.9, d=0.5, back=4.5) {
  rect(w=$w, h=$len)
  extrude(height=$d + 2.0)
  place(by=(0.0, 0.5 * $len, -0.03))
  warp(by=(0, 0, -$d * point.y / $back))
}

# THE GROOVE a peeled strip tore out of the top face, subtracted before the strip
# is added: from the strip's root, `peelback` thicknesses behind the top face's
# tear line, on past the break, 1.25 x the strip's width, 0.12 thickness deep at
# the tear line (round 3: round 2's strip rose straight out of an unbroken top
# face, an upright blade over a black wedge). Placed by `PeelStrip`'s arguments.
PeelScar = mesh(width=22.5, thick=3.8, la=9.0, lean=1.8, shelf=0.65, layers=3, wander=0.1, slant=0.15, peelang=35.0, curl=30.0, peelw=0.07, peelback=1.2, dir=1, n=3, s=47) {
  add($PeelGroove, len=$peelback * $thick + 0.3 * $la, w=1.25 * $peelw * $width, d=0.12 * $thick, back=$peelback * $thick, at=(($width * (0.2 + 0.6 * (atan(tan((sin($s * 3.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) - 0.5 * $width), (-$lean * $thick * (1 - 2 * floor(1.33 * (atan(tan((sin($n * 5.3) * 4375.85) * 180 - 90)) / 180 + 0.5))) * (0.75 + 0.25 * (atan(tan((sin($n * 6.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) * ($shelf * (($layers - 0.5) / $layers - 0.5) + (1 - $shelf) * 0.5)) + ($wander * $width * (0.6 * sin(360 * ($width * (0.2 + 0.6 * (atan(tan((sin($s * 3.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) - 0.5 * $width) / (1.2 * $width) + 360 * (atan(tan((sin($n * 17.3) * 4375.85) * 180 - 90)) / 180 + 0.5)) + 0.4 * sin(360 * ($width * (0.2 + 0.6 * (atan(tan((sin($s * 3.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) - 0.5 * $width) / (0.42 * $width) + 360 * (atan(tan((sin($n * 31.7) * 4375.85) * 180 - 90)) / 180 + 0.5))) + $slant * $width * (2 * (atan(tan((sin($n * 19.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1) * ($width * (0.2 + 0.6 * (atan(tan((sin($s * 3.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) - 0.5 * $width) / $width) - $dir * $peelback * $thick, $thick), rotate=(0.0, 0.0, 90.0 - 90.0 * $dir))
}

# A STRIP PEELED off the top face at the break (real photos: strips leave the
# surface at 20-70 degrees, the tip curling): the top shelf's tear line is worked
# out from the same seed `n`, `lean`, `shelf`, `layers`, `wander` and `slant` as
# the break; the strip is rooted `peelback` thicknesses behind it, at the back of
# its own groove (`PeelScar`), and lifts out of the groove `peelang` degrees,
# curling `curl` more, `peelw` x width wide.
PeelStrip = mesh(width=22.5, thick=3.8, la=9.0, lean=1.8, shelf=0.65, layers=3, wander=0.1, slant=0.15, peelang=35.0, curl=30.0, peelw=0.07, peelback=1.2, dir=1, n=3, s=47) {
  add($Ribbon, len=$peelback * $thick + 0.45 * $la + 0.3 * $thick, w=$peelw * $width, t=0.1 * $thick, curl=-$dir * $curl * (0.7 + 0.6 * (atan(tan((sin($s * 5.7) * 4375.85) * 180 - 90)) / 180 + 0.5)), at=(($width * (0.2 + 0.6 * (atan(tan((sin($s * 3.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) - 0.5 * $width), (-$lean * $thick * (1 - 2 * floor(1.33 * (atan(tan((sin($n * 5.3) * 4375.85) * 180 - 90)) / 180 + 0.5))) * (0.75 + 0.25 * (atan(tan((sin($n * 6.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) * ($shelf * (($layers - 0.5) / $layers - 0.5) + (1 - $shelf) * 0.5)) + ($wander * $width * (0.6 * sin(360 * ($width * (0.2 + 0.6 * (atan(tan((sin($s * 3.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) - 0.5 * $width) / (1.2 * $width) + 360 * (atan(tan((sin($n * 17.3) * 4375.85) * 180 - 90)) / 180 + 0.5)) + 0.4 * sin(360 * ($width * (0.2 + 0.6 * (atan(tan((sin($s * 3.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) - 0.5 * $width) / (0.42 * $width) + 360 * (atan(tan((sin($n * 31.7) * 4375.85) * 180 - 90)) / 180 + 0.5))) + $slant * $width * (2 * (atan(tan((sin($n * 19.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1) * ($width * (0.2 + 0.6 * (atan(tan((sin($s * 3.1) * 4375.85) * 180 - 90)) / 180 + 0.5)) - 0.5 * $width) / $width) - $dir * $peelback * $thick, 0.94 * $thick), rotate=($dir * (90.0 - $peelang * (0.8 + 0.4 * (atan(tan((sin($s * 8.3) * 4375.85) * 180 - 90)) / 180 + 0.5))), 0.0, 0.0))
}

# A SPLIT along the grain from an end (rule 6; real photos rule 9): a thin box
# through the thickness whose two long walls one warp moves across the grain —
# the mouth `open` x width at the end closing to a hairline `length` cm back
# (`close` the taper's power), widened into a bevel `bevel` x width at the mouth;
# the path wandering `wander` x width; stepped LEDGES `ledge` x width every
# `stair` widths along the grain; the path stepping through `plies` layers by
# up to `peelw` x width (peeled layers); and each wall torn on its own by
# `tear` x width in ridges `ridges` x width apart, the tearing fading where the
# gap closes so the walls never cross. The walls are given points `res` apart
# by a near-zero roughen; the move is linear across the box, so it cannot fold.
# Round 3: each ply's lip takes its own share of the bevel (torn lips, not a
# rounded flare), the ridges are twice as close in the first 0.3 of the length
# (the mouth tears finest), the ledges fade in over the first half stair (no
# spur at the mouth), the gap closes to a 0.05 cm hairline, and the ply steps
# and tearing fade out over 0.12 of the thickness at the board's faces, so the
# walls meet the faces cleanly.
Rift = mesh(width=22.5, thick=3.8, open=0.15, wedge=0.0, length=30.0, close=2.0, bevel=0.06, wander=0.12, ledge=0.03, stair=1.0, plies=3, peelw=0.025, tear=0.018, ridges=0.035, blk=0.7, res=0.4, s=7) {
