      points((-0.3, -0.5 * ($length + 1.5) + 0 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.0625 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.125 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.1875 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.25 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.3125 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.375 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.4375 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.5 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.5625 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.625 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.6875 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.75 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.8125 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.875 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.9375 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 1 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 1 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.9375 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.875 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.8125 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.75 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.6875 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.625 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.5625 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.5 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.4375 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.375 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.3125 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.25 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.1875 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.125 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.0625 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0 * ($length + 1.5)), loop=true)
    } else {
      if ($length + 1.5 > 6 * ($thick + 0.6)) {
        points((-0.3, -0.5 * ($length + 1.5) + 0 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.125 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.25 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.375 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.5 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.625 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.75 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.875 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 1 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 1 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.875 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.75 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.625 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.5 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.375 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.25 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.125 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0 * ($length + 1.5)), loop=true)
      } else {
        if ($length + 1.5 > 3 * ($thick + 0.6)) {
          points((-0.3, -0.5 * ($length + 1.5) + 0 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.25 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.5 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 0.75 * ($length + 1.5)), (-0.3, -0.5 * ($length + 1.5) + 1 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 1 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.75 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.5 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0.25 * ($length + 1.5)), (0.3, -0.5 * ($length + 1.5) + 0 * ($length + 1.5)), loop=true)
        } else {
          rect(w=0.6, h=$length + 1.5)
        }
      }
    }
  }
  extrude(height=$thick + 0.6)
  place(by=(0.0, -0.5 * $length + 0.75, -0.3))
  roughen(by=0.0005, scale=3.0 * $res, seed=1) [side]
  if ($lr > 0) {
    warp(by=((point.x / 0.3) * (0.5 * (max(0.05, $open * $width * pow(clamp(1 + point.y / $length, 0, 1), $close) * (1 + $wedge * (1 - 2 * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1))) + $bevel * $width * pow(clamp(1 + point.y / (0.35 * $width), 0, 1), 2) * (0.3 + 0.7 * (0.5 + 0.5 * sin(floor($plies * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1) + 0.3 * sin(360 * point.y / (1.7 * $width))) * 173.9 + (point.x / 0.3) * 47.0 + $s * 2.3))))) - 0.3) + ($wander * $width * (0.6 * sin(360 * point.y / (3.3 * $width) + 360 * (atan(tan((sin($s * 3.3) * 4375.85) * 180 - 90)) / 180 + 0.5)) + 0.4 * sin(360 * point.y / (1.3 * $width) + 360 * (atan(tan((sin($s * 4.4) * 4375.85) * 180 - 90)) / 180 + 0.5))) * clamp(-point.y / (0.5 * $width), 0, 1) + $ledge * $width * (2 * (atan(tan((sin(floor(point.y / ($stair * $width) + 0.37 * (atan(tan((sin($s * 5.5) * 4375.85) * 180 - 90)) / 180 + 0.5)) * 127.1 + $s * 13.1) * 43758.5) * 180 - 90)) / 180 + 0.5) - 1) * clamp(-point.y / (0.5 * $stair * $width), 0, 1) + max(clamp(min(point.z, $thick - point.z) / (0.12 * $thick), 0, 1), $lf) * $peelw * $width * (2 * (0.5 + 0.5 * sin(floor($plies * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1) + 0.3 * sin(360 * point.y / (1.7 * $width))) * 211.3 + floor(point.y / (3 * $blk * $stair * $width)) * 97.1 + $s * 7.7)) - 1) * (1 - 0.5 * $lr + $lr * (atan(tan((point.y / (3 * $blk * $stair * $width)) * 180 - 90)) / 180 + 0.5))) + (point.x / 0.3) * (max(clamp(min(point.z, $thick - point.z) / (0.12 * $thick), 0, 1), $lf) * $tear * $width * (2 * (0.5 + 0.5 * sin(floor((clamp((point.z + 0.3) / ($thick + 0.6), 0, 1) * $thick / ($ridges * $width * (0.5 + 0.5 * clamp(-point.y / (0.3 * $length), 0, 1))))) * 157.9 + floor(point.y / (3 * $blk * $stair * $width)) * 61.3 + (point.x / 0.3) * 91.0 + $s * 3.1)) - 1) * (1 - 0.5 * $lr + $lr * (atan(tan((point.y / (3 * $blk * $stair * $width)) * 180 - 90)) / 180 + 0.5))) * clamp((max(0.05, $open * $width * pow(clamp(1 + point.y / $length, 0, 1), $close) * (1 + $wedge * (1 - 2 * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1))) + $bevel * $width * pow(clamp(1 + point.y / (0.35 * $width), 0, 1), 2) * (0.3 + 0.7 * (0.5 + 0.5 * sin(floor($plies * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1) + 0.3 * sin(360 * point.y / (1.7 * $width))) * 173.9 + (point.x / 0.3) * 47.0 + $s * 2.3))))) / max(3.0 * $tear * $width, 0.001), 0, 1), 0, 0)) [side]
  } else {
    warp(by=((point.x / 0.3) * (0.5 * (max(0.05, $open * $width * pow(clamp(1 + point.y / $length, 0, 1), $close) * (1 + $wedge * (1 - 2 * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1))) + $bevel * $width * pow(clamp(1 + point.y / (0.35 * $width), 0, 1), 2) * (0.3 + 0.7 * (0.5 + 0.5 * sin(floor($plies * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1) + 0.3 * sin(360 * point.y / (1.7 * $width))) * 173.9 + (point.x / 0.3) * 47.0 + $s * 2.3))))) - 0.3) + ($wander * $width * (0.6 * sin(360 * point.y / (3.3 * $width) + 360 * (atan(tan((sin($s * 3.3) * 4375.85) * 180 - 90)) / 180 + 0.5)) + 0.4 * sin(360 * point.y / (1.3 * $width) + 360 * (atan(tan((sin($s * 4.4) * 4375.85) * 180 - 90)) / 180 + 0.5))) * clamp(-point.y / (0.5 * $width), 0, 1) + $ledge * $width * (2 * (atan(tan((sin(floor(point.y / ($stair * $width) + 0.37 * (atan(tan((sin($s * 5.5) * 4375.85) * 180 - 90)) / 180 + 0.5)) * 127.1 + $s * 13.1) * 43758.5) * 180 - 90)) / 180 + 0.5) - 1) * clamp(-point.y / (0.5 * $stair * $width), 0, 1) + max(clamp(min(point.z, $thick - point.z) / (0.12 * $thick), 0, 1), $lf) * $peelw * $width * (2 * (0.5 + 0.5 * sin(floor($plies * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1) + 0.3 * sin(360 * point.y / (1.7 * $width))) * 211.3 + floor(point.y / (3 * $blk * $stair * $width)) * 97.1 + $s * 7.7)) - 1)) + (point.x / 0.3) * (max(clamp(min(point.z, $thick - point.z) / (0.12 * $thick), 0, 1), $lf) * $tear * $width * (2 * (0.5 + 0.5 * sin(floor(clamp((point.z + 0.3) / ($thick + 0.6), 0, 1) * $thick / ($ridges * $width * (0.5 + 0.5 * clamp(-point.y / (0.3 * $length), 0, 1)))) * 157.9 + floor(point.y / ($blk * $stair * $width)) * 61.3 + (point.x / 0.3) * 91.0 + $s * 3.1)) - 1)) * clamp((max(0.05, $open * $width * pow(clamp(1 + point.y / $length, 0, 1), $close) * (1 + $wedge * (1 - 2 * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1))) + $bevel * $width * pow(clamp(1 + point.y / (0.35 * $width), 0, 1), 2) * (0.3 + 0.7 * (0.5 + 0.5 * sin(floor($plies * clamp((point.z + 0.3) / ($thick + 0.6), 0, 1) + 0.3 * sin(360 * point.y / (1.7 * $width))) * 173.9 + (point.x / 0.3) * 47.0 + $s * 2.3))))) / max(3.0 * $tear * $width, 0.001), 0, 1), 0, 0)) [side]
  }
}

# A BEAM's step: the tread of the stair, a `Strata` facing down (blocky ribs
# `rib` x width wide and `ridge` x depth high, along the grain, in three shelves
# along the run), from `from` cm past the break (negative: it starts inside the
# solid beam, behind anything the upper break reaches, so the tread opens as a
# delamination slot under the upper part and its end wall never meets a torn
# face) to `over` cm past the lower break, its top just above the upper break's
# floor, so the tread is torn and ribbed, not planed.
Ledge = mesh(width=20.0, thick=20.0, lip=0.25, run=0.5, from=2.0, over=4.0, res=0.45, ridge=0.06, rib=0.1, s=19, torn=0.0, ttilt=0.0, trib=0.0, tsep=0.15, tf=0.35) {
  add($Strata, w=$width + 1.0, t=($run * $thick + $over - $from + 2.0), tb=($run * $thick + $over - $from + 2.0), yb=0.0, len=0.15 + 2.2 * $ridge * $thick, bw=$width, res=$res, s=$s, layers=3, wob=0.6, lean=0.4 * $ridge * $thick, ramp=0.3, jog=0.8, la=$ridge * $thick, ca=$rib * $width, uneven=0.25, rough=0.9, blunt=0.85, qa=1.0, qr=0.5, lb=$tf * $ridge * $thick, cb=0.03 * $width, db=0.3 * $thick, sparse=3.0, ub=0.45, bblunt=0.7, root=0.6, torn=$torn, ttilt=$ttilt, trib=$trib, tsep=$tsep, at=(0.0, $from - 1.0 + 0.5 * ($run * $thick + $over - $from + 2.0), $lip * $thick - 0.15), rotate=(180.0, 0.0, 0.0))
}

# A DELAMINATION along the grain: the split's slot turned flat (pitch 90 puts its
# opening up Z and runs it across the width), opening into the break face at
# `delam` of the depth and `split` x depth long.
Delam = mesh(width=20.0, thick=20.0, delam=0.33, split=1.0, open=0.03, s=23) {
  add($Rift, width=$width, thick=$width, open=$open * $thick / $width, length=$split * $thick, close=1.2, bevel=0.0, wander=0.01, ledge=0.012, stair=0.8, plies=2, peelw=0.01, tear=0.0, res=0.6, s=$s, at=(0.5 * $width, 0.0, $delam * $thick), rotate=(0.0, 90.0, 0.0))
}

# ---- wood breaks, whole-mesh, aimed by origin and rotation -----------------

# A SOUND BOARD SNAPPED ACROSS THE GRAIN; keeps the -Y side. Defaults are the
# 225 x 38 scaffold board (`Masonry.Plank`). Every knob, its unit and its look:
#   deep    spires' reach: up to 0.4 x deep x width each side (fraction of width)
#   grain   spire width (fraction of width; ~1/grain spires per shelf)
#   uneven  how unequal neighbouring spire widths are (0 even .. 0.25 about 4:1)
#   rough   how unequal spire lengths are (0 even .. 1 stubs and long spires)
#   needle  tip sharpness (0.4 blunt .. 1.5 needles; each spire adds up to 1.2)
#   skew    how far each tip sits off its spire's middle (0 centred .. 1 the edge)
#   tilt    how the shelves' cell walls lean end-on (slope; 0 square prisms)
#   lean    top face's tear off the bottom face's (thicknesses; real about 2)
#   shelf   share of the lean taken in steps rather than an oblique run
#   layers  shelves through the thickness (2-4 real)
#   jog     how unequal the shelves' steps are (fraction of one step)
#   wander  sway of the break line (fraction of width)
#   slant   slant of the break line across the width (fraction of width)
#   sub     steps on each spire: sub-cells stop 0.4-1 x sub x width short
#           (fraction of width; 0 none); subw their width (fraction of a spire);
#           subrows how many to a shelf through the thickness
#   fray    ribbons' reach (thicknesses; 0 for none)
#   strip   ribbon width (fraction of width)
#   ply     ribbon thickness (fraction of thickness)
#   sparse  how few ribbons are long (1 many .. 3 few)
#   root    share of a ribbon that is a squared base below its point
#   tipfray how much longer the ribbons on the spires' tips run (0 even)
#   loss    share of the spires' length this half loses on its own (0 none);
#           lossblunt how squared the broken-off ends are (0 pointed .. 1 square)
#   chew    edge chew depth (fraction of width; 0 none); chewodd how
#           differently the two edges chew (0 alike .. 0.8)
#   bitlen  chewed-off edge strips' length along the grain (thicknesses)
#   thin    the bottom face torn away toward the break (fraction of the
#           thickness at the break; 0 none); thinlen how far back (thicknesses)
#   peel    1 peels a strip off the top face, 0 none
#   peelang the peeled strip's lift (degrees); curl its further curl (degrees)
#   peelw   the peeled strip's width (fraction of width)
#   peelback how far behind the top face's tear line it tore back (thicknesses),
#           leaving a groove (`PeelScar`) it lifts out of
#   horn    one long spire (thicknesses; 0 none)
#   hornrib how unequal the horn's fibres are (0 one smooth horn .. 1 ragged
#           bundle; each ribbon cell in it stops up to this share short)
#   detail  point spacing scale (2 = twice as fine, 4x triangles)
#   noise   the seed; origin, rotation, fibre, face, tile as the frame above;
#   upright 1 when `rotation` stands the grain up +Z (a post), so the torn faces'
#           facing split turns with it; aspect the along-grain tile over the
#           across tile (1 square; 4 the direction checker)
#   rings   1: the break's cells are RING bands about a pith crossed by RAYS
#           from it, as wood's end grain is (round 8; the shop meshes and the
#           BrokenTimber boards and post use it); 0 (default, so a mesh that
#           already calls Snap keeps its look) the round-7 grid of shelves and
#           columns. pithx / pithz the pith (x width from the middle,
#           x thickness up from the bottom face: -3 a flat-sawn board's heart well
#           below it, 0.5 a boxed heart), pithd a per-seed shift of it (x width);
#           hold how much the board's faces keep their full teeth (1); heart 1
#           makes the inner rings reach furthest (a post: no pit at its heart)
#   torn    above 0 (round 9): every fibre bundle ends in a BLUNT TORN END roughly
#           across the grain over `torn` of its section (0.85 on the shop meshes
#           and the BrokenTimber lines), at its own depth, never a pyramid tip (a
#           field of small tips read end-on as gravel or crystal); 0 (default, so
#           a mesh that already calls it keeps its look) round 8's tapered tips.
#           torntilt how far each end tilts (0.15: a few degrees to about 20);
#           tornrib 1 gives each bundle one ribbon length (no second, finer set of
#           ribbon cells cutting the bundles into chips); tornsep how deep the
#           cracks between bundles are, x the spires' reach (0.15; large: every
#           bundle free to its root). Finer fibre is the texture layer's.
#   longside 0 (round 11) which half keeps the few long bundles: 0 the -Y board (round 10),
#           1 the +Y piece, so a SnapOff reads like a snapped board end-on (its tongues
#           otherwise all reach near the longest: a shard field). Only with `torn` > 0.
#   lossfollow 0 (round 11) 1 lays the loss on the break's own slant (`lean`, `shelf`); 0 is
#           round 10's near-flat loss plane, which planes a steep break's high side clean.
# KNOBS (round 13): name, unit, range (a value past it is clamped), default, meaning. The top-level knobs
# come first; damage scales deep, fray, loss and chew; age scales chew (0.5 + 0.5 x age) and tipfray (1.5 - 0.5 x age: a weathered break has lost its fine tips); budget scales detail.
#   width      cm           1 to 200         22.5      the board's width (across the grain, X)
#   thick      cm           0.3 to 100       3.8       the board's thickness (Z)
#   damage     x            0 to 3           1.0       how broken: scales the break's reach and its loose material (see the entry's line); 1 as written
#   age        0-2          0 to 2           1.0       how worn: 0 fresh, 1 as written, 2 weathered (see the entry's line)
#   noise      seed         not clamped      3         the seed: any number, every one valid (not clamped)
#   budget     0-2          0 to 2           1         point spacing: 0 game (half the detail), 1 high (as written), 2 ultra (1.5 x the detail); the build line's [triangles=] sets the final count
#   origin     cm           not clamped      (0,0,0)   where the break crosses the board's bottom face, mid-width (the Damage frame)
#   rotation   degrees      not clamped      (0,0,0)   turns the frame (a slanted break, a standing post)
#   deep       x width      0 to 6           1.0       the spires' reach: up to 0.4 x deep x width
#   grain      x width      0.03 to 1        0.17      spire width (about 1/grain spires per shelf)
#   uneven     0-1          0 to 1           0.25      how unequal neighbouring spire widths are
#   rough      0-1          0 to 1           0.8       how unequal the spire lengths are (0 even, 1 stubs and long spires)
#   needle     x            0.1 to 3         0.7       tip sharpness (0.4 blunt, 1.5 needles)
#   skew       x            0 to 2           0.8       how far each tip sits off its spire's middle (0 centred, 1 the edge)
#   tilt       slope        0 to 2           0.35      how the shelves' cell walls lean end-on (0 square prisms)
#   lean       x thickness  0 to 4           1.8       the top face's tear off the bottom face's
#   shelf      0-1          0 to 1           0.65      share of the lean taken in steps rather than one oblique run
#   layers     count        1 to 16          3         shelves through the thickness
#   jog        x step       0 to 1           0.35      how unequal the shelves' steps are
#   wander     x width      0 to 0.5         0.1       sway of the break line
#   slant      x width      0 to 0.5         0.15      slant of the break line across the width
#   sub        x width      0 to 0.5         0.06      steps on each spire: sub-cells stop 0.4-1 x sub x width short (0 none)
#   subw       x spire      0.05 to 1        0.33      a sub-cell's width
#   subrows    count        1 to 8           2         sub-cells to a shelf through the thickness
#   fray       x thickness  0 to 3           1.0       the ribbons' reach (0 none)
#   strip      x width      0.005 to 0.5     0.045     ribbon width
#   ply        x thickness  0.01 to 1        0.18      ribbon thickness
#   sparse     x            0.5 to 4         1.3       how few ribbons are long (1 many, 3 few)
#   root       0-1          0 to 1           0.25      share of a ribbon that is a squared base below its point
#   tipfray    x            0 to 3           0.6       how much longer the ribbons on the spires' tips run (0 even)
#   loss       x reach      0 to 0.6         0.15      share of the spires' length this half loses on its own (0 none)
#   lossblunt  0-1          0 to 1           0.5       how squared the broken-off ends are (0 pointed, 1 square)
#   chew       x width      0 to 0.4         0.08      the edges' chew depth (0 none)
#   chewodd    0-1          0 to 0.9         0.5       how differently the two edges chew
#   bitlen     x thickness  0.1 to 5         1.2       chewed-off edge strips' length along the grain
#   thin       x thickness  0 to 0.6         0.22      the bottom face torn away toward the break (0 none)
#   thinlen    x thickness  0.2 to 10        3.0       how far back the bottom is torn
#   peel       switch       0 to 1           0         1 peels a strip off the top face
#   peelang    degrees      0 to 80          25.0      the peeled strip's lift
#   curl       degrees      -90 to 90        25.0      the peeled strip's further curl
#   peelw      x width      0.01 to 0.3      0.07      the peeled strip's width (Split: a ply's step across the split)
#   peelback   x thickness  0 to 5           1.2       how far behind the tear line the strip tore back (its groove)
#   horn       x thickness  0 to 6           0.0       one long spire (0 none)
#   hornrib    0-1          0 to 1           0.5       how ragged the horn's fibres are (0 one smooth horn)
#   taper      0-1          0 to 1           1.0       each bundle tents through its row (pyramid tips; `torn` blunts them)
#   tvar       0-1          0 to 1           0.5       how many cells stay blunter
#   stap       0-1          0 to 1           1.0       the same tent per sub-cell (narrow sub-bundles)
#   rowjog     0-1          0 to 1           1.0       sub-rows staggered per sub-column
#   long       x reach      0 to 3           0.8       one to three long splinters this much further (0 none)
#   vdep       x reach      0 to 2           0.7       each pair of cells' base set back by its own draw (no comb of valleys)
#   uvfit      0/1/2        0 to 2           1         the torn faces' UVs: 0 the facing split, 1 + narrow windows, 2 an automatic unwrap
#   rings      switch       0 to 1           0         1: cells are growth-ring bands about a pith crossed by rays; 0 a grid
#   pithx      x width      -3 to 3          0.0       the pith across, from the middle
#   pithz      x thickness  -10 to 10        -3.0      the pith up from the bottom face (-3 flat-sawn, 0.5 a boxed heart)
#   pithd      x width      0 to 1           0.15      a per-seed shift of the pith
#   hold       0-1          0 to 1           1.0       how much the board's faces keep their full teeth
#   heart      switch       0 to 1           0         1: the inner rings reach furthest (a post's heart never pits)
#   torn       0-1          0 to 0.98        0.0       bundles end in blunt torn ends over this share of their section (0 tapered tips)
#   torntilt   x            0 to 1           0.0       how far each torn end tilts
#   tornrib    switch       0 to 1           0         1: one ribbon length per bundle
#   tornsep    x reach      0 to 1           0.15      how deep the cracks between bundles run
#   longside   switch       0 to 1           0         which half keeps the few long bundles (1 the +Y piece)
#   lossfollow switch       0 to 1           0         1 lays the loss on the break's own slant
#   detail     x            0.05 to 4        1.0       point spacing scale (2 twice as fine, about 4 x the triangles)
#   fibre      vector       not clamped      (0,1,0)   the grain direction in the mesh's axes, when `rotation` turns the board
#   face       vector       not clamped      (0,0,1)   the wide face's normal in the mesh's axes, when `rotation` turns the board
#   upright    switch       0 to 1           0         1 when the grain stands up +Z (a post): the torn faces' UV split turns with it
#   tile       cm           1 to 10000       100.0     one texture tile
#   aspect     x            0.1 to 20        1.0       the along-grain tile over the across tile (1 square; 4 the direction checker)
Snap = instruction(width=22.5, thick=3.8, damage=1.0, age=1.0, noise=3, budget=1, origin=(0,0,0), rotation=(0,0,0), deep=1.0, grain=0.17, uneven=0.25, rough=0.8, needle=0.7, skew=0.8, tilt=0.35, lean=1.8, shelf=0.65, layers=3, jog=0.35, wander=0.1, slant=0.15, sub=0.06, subw=0.33, subrows=2, fray=1.0, strip=0.045, ply=0.18, sparse=1.3, root=0.25, tipfray=0.6, loss=0.15, lossblunt=0.5, chew=0.08, chewodd=0.5, bitlen=1.2, thin=0.22, thinlen=3.0, peel=0, peelang=25.0, curl=25.0, peelw=0.07, peelback=1.2, horn=0.0, hornrib=0.5, taper=1.0, tvar=0.5, stap=1.0, rowjog=1.0, long=0.8, vdep=0.7, uvfit=1, rings=0, pithx=0.0, pithz=-3.0, pithd=0.15, hold=1.0, heart=0, torn=0.0, torntilt=0.0, tornrib=0, tornsep=0.15, longside=0, lossfollow=0, detail=1.0, fibre=(0,1,0), face=(0,0,1), upright=0, tile=100.0, aspect=1.0) {
  $kdamage = clamp($damage, 0.0, 3.0)
  $kage = clamp($age, 0.0, 2.0)
  $kbudget = clamp($budget, 0.0, 2.0)
  $kwidth = clamp($width, 1.0, 200.0)
  $kthick = clamp($thick, 0.3, 100.0)
  $kdeep = clamp($deep * $kdamage, 0.0, 6.0)
  $kgrain = clamp($grain, 0.03, 1.0)
  $kuneven = clamp($uneven, 0.0, 1.0)
  $krough = clamp($rough, 0.0, 1.0)
  $kneedle = clamp($needle, 0.1, 3.0)
  $kskew = clamp($skew, 0.0, 2.0)
  $ktilt = clamp($tilt, 0.0, 2.0)
  $klean = clamp($lean, 0.0, 4.0)
  $kshelf = clamp($shelf, 0.0, 1.0)
  $klayers = clamp($layers, 1.0, 16.0)
  $kjog = clamp($jog, 0.0, 1.0)
  $kwander = clamp($wander, 0.0, 0.5)
  $kslant = clamp($slant, 0.0, 0.5)
  $ksub = clamp($sub, 0.0, 0.5)
  $ksubw = clamp($subw, 0.05, 1.0)
  $ksubrows = clamp($subrows, 1.0, 8.0)
  $kfray = clamp($fray * $kdamage, 0.0, 3.0)
  $kstrip = clamp($strip, 0.005, 0.5)
  $kply = clamp($ply, 0.01, 1.0)
  $ksparse = clamp($sparse, 0.5, 4.0)
  $kroot = clamp($root, 0.0, 1.0)
  $ktipfray = clamp($tipfray * (1.5 - 0.5 * $kage), 0.0, 3.0)
  $kloss = clamp($loss * $kdamage, 0.0, 0.6)
  $klossblunt = clamp($lossblunt, 0.0, 1.0)
  $kchew = clamp($chew * $kdamage * (0.5 + 0.5 * $kage), 0.0, 0.4)
  $kchewodd = clamp($chewodd, 0.0, 0.9)
  $kbitlen = clamp($bitlen, 0.1, 5.0)
  $kthin = clamp($thin, 0.0, 0.6)
  $kthinlen = clamp($thinlen, 0.2, 10.0)
  $kpeel = clamp($peel, 0.0, 1.0)
  $kpeelang = clamp($peelang, 0.0, 80.0)
  $kcurl = clamp($curl, -90.0, 90.0)
  $kpeelw = clamp($peelw, 0.01, 0.3)
  $kpeelback = clamp($peelback, 0.0, 5.0)
  $khorn = clamp($horn, 0.0, 6.0)
  $khornrib = clamp($hornrib, 0.0, 1.0)
  $ktaper = clamp($taper, 0.0, 1.0)
  $ktvar = clamp($tvar, 0.0, 1.0)
  $kstap = clamp($stap, 0.0, 1.0)
  $krowjog = clamp($rowjog, 0.0, 1.0)
  $klong = clamp($long, 0.0, 3.0)
  $kvdep = clamp($vdep, 0.0, 2.0)
  $kuvfit = clamp($uvfit, 0.0, 2.0)
  $krings = clamp($rings, 0.0, 1.0)
  $kpithx = clamp($pithx, -3.0, 3.0)
  $kpithz = clamp($pithz, -10.0, 10.0)
  $kpithd = clamp($pithd, 0.0, 1.0)
  $khold = clamp($hold, 0.0, 1.0)
  $kheart = clamp($heart, 0.0, 1.0)
  $ktorn = clamp($torn, 0.0, 0.98)
  $ktorntilt = clamp($torntilt, 0.0, 1.0)
  $ktornrib = clamp($tornrib, 0.0, 1.0)
  $ktornsep = clamp($tornsep, 0.0, 1.0)
  $klongside = clamp($longside, 0.0, 1.0)
  $klossfollow = clamp($lossfollow, 0.0, 1.0)
  $kdetail = clamp($detail * (0.5 + 0.5 * $kbudget), 0.05, 4.0)
  $kupright = clamp($upright, 0.0, 1.0)
  $ktile = clamp($tile, 1.0, 10000.0)
  $kaspect = clamp($aspect, 0.1, 20.0)
  subtract($Tear, width=$kwidth, thick=$kthick, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, s=$noise, layers=$klayers, lean=$klean, shelf=$kshelf, jog=$kjog, la=0.4 * $kdeep * $kwidth, ca=$kgrain * $kwidth, uneven=$kuneven, rough=$krough, qa=$kneedle, skew=$kskew, tilt=$ktilt, sub=$ksub, subw=$ksubw, subrows=$ksubrows, lb=$kfray * $kthick, cb=$kstrip * $kwidth, db=$kply * $kthick, sparse=$ksparse, root=$kroot, tipfray=$ktipfray, hl=$khorn * $kthick, hx=$kwidth * (0.6 * (atan(tan((sin($noise * 2.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 0.3), hw=0.12 * $kwidth, hv0=0.15, hv1=0.75, hrib=$khornrib, taper=$ktaper, tvar=$ktvar, stap=$kstap, stag=$krowjog, jc=$krowjog, long=$klong, vdep=$kvdep, rings=$krings, px=($kpithx + $kpithd * (2 * (atan(tan((sin($noise * 6.7) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $kwidth, pz=$kpithz * $kthick + $kpithd * $kwidth * (2 * (atan(tan((sin($noise * 7.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1), hold=$khold, heart=$kheart, torn=$ktorn, ttilt=$ktorntilt, trib=$ktornrib, tsep=$ktornsep, lside=$klongside, wander=$kwander, slant=$kslant, at=$origin, rotate=$rotation)
  if ($kloss > 0) {
    subtract($Loss, width=$kwidth, thick=$kthick, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, la=0.4 * $kdeep * $kwidth, ca=$kgrain * $kwidth, uneven=$kuneven, tilt=$ktilt, layers=$klayers, lb=$kfray * $kthick, cb=$kstrip * $kwidth, db=$kply * $kthick, wander=$kwander, loss=$kloss, lossblunt=$klossblunt, dir=1, s=$noise, hs=91, rings=$krings, px=($kpithx + $kpithd * (2 * (atan(tan((sin($noise * 6.7) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $kwidth, pz=$kpithz * $kthick + $kpithd * $kwidth * (2 * (atan(tan((sin($noise * 7.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1), hold=$khold, heart=$kheart, lean=$klean, shelf=$kshelf, lfol=$klossfollow, at=$origin, rotate=$rotation)
  }
  if ($kchew > 0) {
    subtract($Chew, width=$kwidth, thick=$kthick, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, chew=$kchew, chewodd=$kchewodd, reach=0.5 * (1 + 1) * 0.4 * $kdeep * $kwidth + 0.5 * $klean * $kthick + $kwander * $kwidth + 1.0, zone=0.52 * $kdeep * $kwidth + $klean * $kthick + 2.0 * $kthick, bitlen=$kbitlen, dir=1, s=$noise + 31, at=$origin, rotate=$rotation)
  }
  if ($kthin > 0) {
    subtract($Thin, width=$kwidth, thick=$kthick, thin=$kthin, back=-$kthinlen * $kthick, front=0.4 * $kdeep * $kwidth + 0.5 * $klean * $kthick + $kwander * $kwidth + 1.0, res=3.0 * 0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, s=$noise + 53, at=$origin, rotate=$rotation)
  }
  if ($kpeel > 0) {
    subtract($PeelScar, width=$kwidth, thick=$kthick, la=0.4 * $kdeep * $kwidth, lean=$klean, shelf=$kshelf, layers=$klayers, wander=$kwander, slant=$kslant, peelang=$kpeelang, curl=$kcurl, peelw=$kpeelw, peelback=$kpeelback, dir=1, n=$noise, s=$noise + 47, at=$origin, rotate=$rotation)
    add($PeelStrip, width=$kwidth, thick=$kthick, la=0.4 * $kdeep * $kwidth, lean=$klean, shelf=$kshelf, layers=$klayers, wander=$kwander, slant=$kslant, peelang=$kpeelang, curl=$kcurl, peelw=$kpeelw, peelback=$kpeelback, dir=1, n=$noise, s=$noise + 47, at=$origin, rotate=$rotation)
  }
  if ($kuvfit > 1.5) {
    uv(auto)
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile)) [!cut]
  } else {
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile)) [!cut]
    uv(box, at=$origin, facing=$face, up=$fibre, scale=($kaspect * $ktile, $ktile, $ktile), offset=(0.37, 0.61)) [cut]
    if ($kupright > 0) {
      if ($kdeep > 0) {
        uv(plane, at=$origin, facing=+X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+X]
        uv(plane, at=$origin, facing=-X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-X]
      }
      if ($kfray > 0) {
        uv(plane, at=$origin, facing=+Y, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+Y]
        uv(plane, at=$origin, facing=-Y, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-Y]
      }
      uv(plane, at=$origin, facing=+Z, up=+X, scale=($ktile, $ktile)) [cut, facing=+Z]
      if ($kuvfit > 0.5) {
        if ($kdeep > 0) {
          uv(plane, at=$origin, facing=(0.707, -0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.486, -0.672, -0.558), facing=(0.672, -0.486, 0.558), facing=(0.974, -0.184, -0.132), facing=(0.184, -0.974, 0.132)]
          uv(plane, at=$origin, facing=(0.707, 0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.627, 0.532, -0.57), facing=(0.532, 0.627, 0.57), facing=(0.176, 0.982, -0.067), facing=(0.982, 0.176, 0.067)]
          uv(plane, at=$origin, facing=(-0.707, -0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.627, -0.532, 0.57), facing=(-0.532, -0.627, -0.57), facing=(-0.982, -0.176, -0.067), facing=(-0.176, -0.982, 0.067)]
          uv(plane, at=$origin, facing=(-0.707, 0.707, 0), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.486, 0.672, 0.558), facing=(-0.672, 0.486, -0.558), facing=(-0.184, 0.974, -0.132), facing=(-0.974, 0.184, 0.132)]
          uv(plane, at=$origin, facing=(0.707, 0, 0.707), up=(-0.707, 0, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.98, 0.089, 0.179), facing=(0.179, -0.089, 0.98), facing=(0.516, 0.567, 0.642), facing=(0.642, -0.567, 0.516)]
          uv(plane, at=$origin, facing=(-0.707, 0, 0.707), up=(0.707, 0, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.192, 0.172, 0.966), facing=(-0.966, -0.172, 0.192), facing=(-0.701, 0.547, 0.458), facing=(-0.458, -0.547, 0.701)]
          uv(plane, at=$origin, facing=(0, -0.707, 0.707), up=(0, 0.707, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.507, -0.389, 0.769), facing=(-0.507, -0.769, 0.389), facing=(-0.269, -0.221, 0.938), facing=(0.269, -0.938, 0.221)]
          uv(plane, at=$origin, facing=(0, 0.707, 0.707), up=(0, -0.707, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.528, 0.738, 0.421), facing=(-0.528, 0.421, 0.738), facing=(-0.224, 0.953, 0.206), facing=(0.224, 0.206, 0.953)]
          uv(plane, at=$origin, facing=(0.577, -0.577, 0.577), up=(-0.408, 0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.938, -0.334, 0.093), facing=(-0.028, -0.576, 0.817), facing=(0.594, 0.033, 0.804), facing=(0.316, -0.943, 0.106)]
          uv(plane, at=$origin, facing=(0.577, 0.577, 0.577), up=(-0.408, -0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.846, 0.533, -0.014), facing=(0.064, 0.377, 0.924), facing=(0.139, 0.952, 0.274), facing=(0.771, -0.042, 0.636)]
          uv(plane, at=$origin, facing=(-0.577, -0.577, 0.577), up=(0.408, 0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.126, -0.29, 0.949), facing=(-0.784, -0.62, -0.039), facing=(-0.835, 0.02, 0.55), facing=(-0.075, -0.93, 0.36)]
          uv(plane, at=$origin, facing=(-0.577, 0.577, 0.577), up=(0.408, -0.408, 0.816), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.044, 0.655, 0.755), facing=(-0.954, 0.255, 0.155), facing=(-0.397, 0.916, 0.051), facing=(-0.513, -0.006, 0.859)]
        }
      }
    } else {
      if ($kdeep > 0) {
        uv(plane, at=$origin, facing=+X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+X]
        uv(plane, at=$origin, facing=-X, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-X]
      }
      if ($kfray > 0) {
        uv(plane, at=$origin, facing=+Z, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=+Z]
        uv(plane, at=$origin, facing=-Z, up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=-Z]
      }
      uv(plane, at=$origin, facing=+Y, up=+X, scale=($ktile, $ktile)) [cut, facing=+Y]
      if ($kuvfit > 0.5) {
        if ($kdeep > 0) {
          uv(plane, at=$origin, facing=(0.707, 0, 0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.486, -0.558, 0.672), facing=(0.672, 0.558, 0.486), facing=(0.974, -0.132, 0.184), facing=(0.184, 0.132, 0.974)]
          uv(plane, at=$origin, facing=(0.707, 0, -0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.627, -0.57, -0.532), facing=(0.532, 0.57, -0.627), facing=(0.176, -0.067, -0.982), facing=(0.982, 0.067, -0.176)]
          uv(plane, at=$origin, facing=(-0.707, 0, 0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.627, 0.57, 0.532), facing=(-0.532, -0.57, 0.627), facing=(-0.982, -0.067, 0.176), facing=(-0.176, 0.067, 0.982)]
          uv(plane, at=$origin, facing=(-0.707, 0, -0.707), up=$fibre, scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.486, 0.558, -0.672), facing=(-0.672, -0.558, -0.486), facing=(-0.184, -0.132, -0.974), facing=(-0.974, 0.132, -0.184)]
          uv(plane, at=$origin, facing=(0.707, 0.707, 0), up=(-0.707, 0.707, 0), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.98, 0.179, -0.089), facing=(0.179, 0.98, 0.089), facing=(0.516, 0.642, -0.567), facing=(0.642, 0.516, 0.567)]
          uv(plane, at=$origin, facing=(-0.707, 0.707, 0), up=(0.707, 0.707, 0), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.192, 0.966, -0.172), facing=(-0.966, 0.192, 0.172), facing=(-0.701, 0.458, -0.547), facing=(-0.458, 0.701, 0.547)]
          uv(plane, at=$origin, facing=(0, 0.707, 0.707), up=(0, 0.707, -0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.507, 0.769, 0.389), facing=(-0.507, 0.389, 0.769), facing=(-0.269, 0.938, 0.221), facing=(0.269, 0.221, 0.938)]
          uv(plane, at=$origin, facing=(0, 0.707, -0.707), up=(0, 0.707, 0.707), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.528, 0.421, -0.738), facing=(-0.528, 0.738, -0.421), facing=(-0.224, 0.206, -0.953), facing=(0.224, 0.953, -0.206)]
          uv(plane, at=$origin, facing=(0.577, 0.577, 0.577), up=(-0.408, 0.816, -0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.938, 0.093, 0.334), facing=(-0.028, 0.817, 0.576), facing=(0.594, 0.804, -0.033), facing=(0.316, 0.106, 0.943)]
          uv(plane, at=$origin, facing=(0.577, 0.577, -0.577), up=(-0.408, 0.816, 0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.846, -0.014, -0.533), facing=(0.064, 0.924, -0.377), facing=(0.139, 0.274, -0.952), facing=(0.771, 0.636, 0.042)]
          uv(plane, at=$origin, facing=(-0.577, 0.577, 0.577), up=(0.408, 0.816, -0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(-0.126, 0.949, 0.29), facing=(-0.784, -0.039, 0.62), facing=(-0.835, 0.55, -0.02), facing=(-0.075, 0.36, 0.93)]
          uv(plane, at=$origin, facing=(-0.577, 0.577, -0.577), up=(0.408, 0.816, 0.408), scale=($kaspect * $ktile, $ktile)) [cut, facing=(0.044, 0.755, -0.655), facing=(-0.954, 0.155, -0.255), facing=(-0.397, 0.051, -0.916), facing=(-0.513, 0.859, 0.006)]
        }
      }
    }
  }
}

# THE PIECE THAT CAME OFF — the +Y side of the very same break, so with the
# same arguments it fits `Snap` tooth into socket; its loss, chew and peeled
# strip draw their own seeds, so the halves are complements, never mirrors. The
# knobs are `Snap`'s.
# KNOBS (round 13): name, unit, range (a value past it is clamped), default, meaning. The top-level knobs
# come first; damage scales deep, fray, loss and chew; age scales chew (0.5 + 0.5 x age) and tipfray (1.5 - 0.5 x age: a weathered break has lost its fine tips); budget scales detail.
#   width      cm           1 to 200         22.5      the board's width (across the grain, X)
#   thick      cm           0.3 to 100       3.8       the board's thickness (Z)
#   damage     x            0 to 3           1.0       how broken: scales the break's reach and its loose material (see the entry's line); 1 as written
#   age        0-2          0 to 2           1.0       how worn: 0 fresh, 1 as written, 2 weathered (see the entry's line)
#   noise      seed         not clamped      3         the seed: any number, every one valid (not clamped)
#   budget     0-2          0 to 2           1         point spacing: 0 game (half the detail), 1 high (as written), 2 ultra (1.5 x the detail); the build line's [triangles=] sets the final count
#   origin     cm           not clamped      (0,0,0)   where the break crosses the board's bottom face, mid-width (the Damage frame)
#   rotation   degrees      not clamped      (0,0,0)   turns the frame (a slanted break, a standing post)
#   deep       x width      0 to 6           1.0       the spires' reach: up to 0.4 x deep x width
#   grain      x width      0.03 to 1        0.17      spire width (about 1/grain spires per shelf)
#   uneven     0-1          0 to 1           0.25      how unequal neighbouring spire widths are
#   rough      0-1          0 to 1           0.8       how unequal the spire lengths are (0 even, 1 stubs and long spires)
#   needle     x            0.1 to 3         0.7       tip sharpness (0.4 blunt, 1.5 needles)
#   skew       x            0 to 2           0.8       how far each tip sits off its spire's middle (0 centred, 1 the edge)
#   tilt       slope        0 to 2           0.35      how the shelves' cell walls lean end-on (0 square prisms)
#   lean       x thickness  0 to 4           1.8       the top face's tear off the bottom face's
#   shelf      0-1          0 to 1           0.65      share of the lean taken in steps rather than one oblique run
#   layers     count        1 to 16          3         shelves through the thickness
#   jog        x step       0 to 1           0.35      how unequal the shelves' steps are
#   wander     x width      0 to 0.5         0.1       sway of the break line
#   slant      x width      0 to 0.5         0.15      slant of the break line across the width
#   sub        x width      0 to 0.5         0.06      steps on each spire: sub-cells stop 0.4-1 x sub x width short (0 none)
#   subw       x spire      0.05 to 1        0.33      a sub-cell's width
#   subrows    count        1 to 8           2         sub-cells to a shelf through the thickness
#   fray       x thickness  0 to 3           1.0       the ribbons' reach (0 none)
#   strip      x width      0.005 to 0.5     0.045     ribbon width
#   ply        x thickness  0.01 to 1        0.18      ribbon thickness
#   sparse     x            0.5 to 4         1.3       how few ribbons are long (1 many, 3 few)
#   root       0-1          0 to 1           0.25      share of a ribbon that is a squared base below its point
#   tipfray    x            0 to 3           0.6       how much longer the ribbons on the spires' tips run (0 even)
#   loss       x reach      0 to 0.6         0.15      share of the spires' length this half loses on its own (0 none)
#   lossblunt  0-1          0 to 1           0.5       how squared the broken-off ends are (0 pointed, 1 square)
#   chew       x width      0 to 0.4         0.08      the edges' chew depth (0 none)
#   chewodd    0-1          0 to 0.9         0.5       how differently the two edges chew
#   bitlen     x thickness  0.1 to 5         1.2       chewed-off edge strips' length along the grain
#   thin       x thickness  0 to 0.6         0.22      the bottom face torn away toward the break (0 none)
#   thinlen    x thickness  0.2 to 10        3.0       how far back the bottom is torn
#   peel       switch       0 to 1           0         1 peels a strip off the top face
#   peelang    degrees      0 to 80          25.0      the peeled strip's lift
#   curl       degrees      -90 to 90        25.0      the peeled strip's further curl
#   peelw      x width      0.01 to 0.3      0.07      the peeled strip's width (Split: a ply's step across the split)
#   peelback   x thickness  0 to 5           1.2       how far behind the tear line the strip tore back (its groove)
#   horn       x thickness  0 to 6           0.0       one long spire (0 none)
#   hornrib    0-1          0 to 1           0.5       how ragged the horn's fibres are (0 one smooth horn)
#   taper      0-1          0 to 1           1.0       each bundle tents through its row (pyramid tips; `torn` blunts them)
#   tvar       0-1          0 to 1           0.5       how many cells stay blunter
#   stap       0-1          0 to 1           1.0       the same tent per sub-cell (narrow sub-bundles)
#   rowjog     0-1          0 to 1           1.0       sub-rows staggered per sub-column
#   long       x reach      0 to 3           0.8       one to three long splinters this much further (0 none)
#   vdep       x reach      0 to 2           0.7       each pair of cells' base set back by its own draw (no comb of valleys)
#   uvfit      0/1/2        0 to 2           1         the torn faces' UVs: 0 the facing split, 1 + narrow windows, 2 an automatic unwrap
#   rings      switch       0 to 1           0         1: cells are growth-ring bands about a pith crossed by rays; 0 a grid
#   pithx      x width      -3 to 3          0.0       the pith across, from the middle
#   pithz      x thickness  -10 to 10        -3.0      the pith up from the bottom face (-3 flat-sawn, 0.5 a boxed heart)
#   pithd      x width      0 to 1           0.15      a per-seed shift of the pith
#   hold       0-1          0 to 1           1.0       how much the board's faces keep their full teeth
#   heart      switch       0 to 1           0         1: the inner rings reach furthest (a post's heart never pits)
#   torn       0-1          0 to 0.98        0.0       bundles end in blunt torn ends over this share of their section (0 tapered tips)
#   torntilt   x            0 to 1           0.0       how far each torn end tilts
#   tornrib    switch       0 to 1           0         1: one ribbon length per bundle
#   tornsep    x reach      0 to 1           0.15      how deep the cracks between bundles run
#   longside   switch       0 to 1           0         which half keeps the few long bundles (1 the +Y piece)
#   lossfollow switch       0 to 1           0         1 lays the loss on the break's own slant
#   detail     x            0.05 to 4        1.0       point spacing scale (2 twice as fine, about 4 x the triangles)
#   fibre      vector       not clamped      (0,1,0)   the grain direction in the mesh's axes, when `rotation` turns the board
#   face       vector       not clamped      (0,0,1)   the wide face's normal in the mesh's axes, when `rotation` turns the board
#   upright    switch       0 to 1           0         1 when the grain stands up +Z (a post): the torn faces' UV split turns with it
#   tile       cm           1 to 10000       100.0     one texture tile
#   aspect     x            0.1 to 20        1.0       the along-grain tile over the across tile (1 square; 4 the direction checker)
SnapOff = instruction(width=22.5, thick=3.8, damage=1.0, age=1.0, noise=3, budget=1, origin=(0,0,0), rotation=(0,0,0), deep=1.0, grain=0.17, uneven=0.25, rough=0.8, needle=0.7, skew=0.8, tilt=0.35, lean=1.8, shelf=0.65, layers=3, jog=0.35, wander=0.1, slant=0.15, sub=0.06, subw=0.33, subrows=2, fray=1.0, strip=0.045, ply=0.18, sparse=1.3, root=0.25, tipfray=0.6, loss=0.15, lossblunt=0.5, chew=0.08, chewodd=0.5, bitlen=1.2, thin=0.22, thinlen=3.0, peel=0, peelang=25.0, curl=25.0, peelw=0.07, peelback=1.2, horn=0.0, hornrib=0.5, taper=1.0, tvar=0.5, stap=1.0, rowjog=1.0, long=0.8, vdep=0.7, uvfit=1, rings=0, pithx=0.0, pithz=-3.0, pithd=0.15, hold=1.0, heart=0, torn=0.0, torntilt=0.0, tornrib=0, tornsep=0.15, longside=0, lossfollow=0, detail=1.0, fibre=(0,1,0), face=(0,0,1), upright=0, tile=100.0, aspect=1.0) {
  $kdamage = clamp($damage, 0.0, 3.0)
