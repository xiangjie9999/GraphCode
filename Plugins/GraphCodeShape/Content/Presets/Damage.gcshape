  intersect($Tear, width=$kwidth, thick=$kthick, res=0.0075 * ($kwidth + 3.0 * $kthick) / $kdetail, s=$noise, layers=$klayers, lean=$klean, shelf=$kshelf, jog=$kjog, la=0.4 * $kdeep * $kwidth, ca=$kgrain * $kwidth, uneven=$kuneven, rough=$krough, qa=$kneedle, skew=$kskew, tilt=$ktilt, sub=$ksub, subw=$ksubw, subrows=$ksubrows, lb=$kfray * $kthick, cb=$kstrip * $kwidth, db=$kply * $kthick, sparse=$ksparse, root=$kroot, tipfray=$ktipfray, hl=$khorn * $kthick, hx=$kwidth * (0.6 * (atan(tan((sin($noise * 2.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 0.3), hw=0.12 * $kwidth, hv0=0.15, hv1=0.75, hrib=$khornrib, taper=$ktaper, tvar=$ktvar, stap=$kstap, stag=$krowjog, jc=$krowjog, long=$klong, vdep=$kvdep, rings=$krings, px=($kpithx + $kpithd * (2 * (atan(tan((sin($noise * 6.7) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1)) * $kwidth, pz=$kpithz * $kthick + $kpithd * $kwidth * (2 * (atan(tan((sin($noise * 7.9) * 4375.85) * 180 - 90)) / 180 + 0.5) - 1), hold=$khold, heart=$kheart, torn=$ktorn, ttilt=$ktorntilt, trib=$ktornrib, tsep=$ktornsep, lside=$klongside, wander=$kwander, slant=$kslant, at=$origin, rotate=$rotation)
  if ($kloss > 0) {
