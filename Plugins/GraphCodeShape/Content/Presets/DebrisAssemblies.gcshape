    $e2 = $e2 - floor($e2)
    $e3 = sin(($k0 + 163) * 12.9898 + 0.7) * 43758.5453
    $e3 = $e3 - floor($e3)
    $e4 = sin(($k0 + 164) * 12.9898 + 0.7) * 43758.5453
