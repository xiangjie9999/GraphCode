      } else {
        h1as = add($R.BarStub, stick=$st, damage=$dm, age=$ag, noise=$nzb, budget=$bg, embed=$em, d=$D, end=$fate, tile=$tile, at=$EA1, rotate=(0.0, $pa, $az), join=none)
        warp(to=(point.x + (max(0, 0 - (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz))) * clamp(ceil(1.5 * $D - sqrt(max(0, (point.x - $px) * (point.x - $px) + (point.y - $py) * (point.y - $py) + (point.z - $pz) * (point.z - $pz) - (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz)) * (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz))))), 0, 1)) * $dx, point.y + (max(0, 0 - (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz))) * clamp(ceil(1.5 * $D - sqrt(max(0, (point.x - $px) * (point.x - $px) + (point.y - $py) * (point.y - $py) + (point.z - $pz) * (point.z - $pz) - (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz)) * (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz))))), 0, 1)) * $dy, point.z + (max(0, 0 - (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz))) * clamp(ceil(1.5 * $D - sqrt(max(0, (point.x - $px) * (point.x - $px) + (point.y - $py) * (point.y - $py) + (point.z - $pz) * (point.z - $pz) - (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz)) * (((point.x - $px) * $dx + (point.y - $py) * $dy + (point.z - $pz) * $dz))))), 0, 1)) * $dz)) [$h1as]
