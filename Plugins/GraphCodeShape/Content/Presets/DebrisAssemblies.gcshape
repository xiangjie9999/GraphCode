# DEBRIS ASSEMBLIES — composed debris pieces (L3: each imports only the L2 pieces of Rebar and ConcreteParts;
# Docs/GC-SHAPE-DEBRIS-LANE.md §2 and its lead rulings). GENERATED by Content/__MCPTests/DamageKit/gen/debris/gendebris.py: edit the generator, not this file.
#
#   DA = shape('/GraphCodeShape/Presets/DebrisAssemblies', Face = $MyCast, Broken = $MyAggregate, Steel = $MyRebar, SteelCut = $MyBrightSteel)
#   Heap = mesh() { add($DA.ReinforcedChunk, size=20, damage=0.8, noise=5)  add($DA.ReinforcedChunk, size=12, bars=1, at=(25, 0, 0)) }
#
# REINFORCED CHUNK (the owner's example, kit §14: "concrete with steel bar inside it"): a `ConcreteParts.Chunk` lying on
# its cast skin, with 1-3 bars running through it at cover depth. HOW A BAR IS CLIPPED TO THE BROKEN FACES (dry run D1,
# measured on the built mesh): each bar line has a hidden split point P inside the chunk; two rays cast from P along the
# bar both ways find where the line leaves the chunk (`save($E) [at=P, project=d]`: a point and its normal on the real,
# roughened surface); a `BarStub` or a `BentBar` is placed on each exit with a long hidden root, and a warp on that
# part's handle moves the root's end onto the plane through P. So each end stands out exactly its own `stick`, the two
# stubs of a bar meet at P (one bar, no fragment, no overlap), and no length has to be read (a saved point's
# coordinates cannot be). Bars run near-level (`pitch`), so they leave through broken sides, never the cast skin.
# EACH END ITS OWN FATE (never a comb): stand-out 0.3-1.4 x `stick` (about a fifth of ends stopped inside, but never
# the first bar's first end), bent (share `bend`, a BentBar turned sideways or up, 15-110 degrees), else a stub
# sheared or necked (share `neck`). Bar 1 runs along `dir` near the middle; bar 2 crosses it at right angles one bar
# higher (the mat's other layer); bar 3 is a second main bar a quarter of the width aside (a chunk of 12-24 cm from a
# mat at 30 cm holds one bar each way, rarely two); each is turned up to half of `skew` degrees off its line.
# SLOTS (pathless, bind at import): `Face` cast skin, `Broken` the breaks, `Steel` the bars, `SteelCut` their bright ends.
#   STATES AND TIERS: every piece ships three build lines from one recipe (kit §12.1, §8a.6: the budget is the author's,
#   no ceiling): `_Game` (`budget=0`), `_High` (`budget=1`), `_Ultra` (`budget=2`). Pass any `budget` and your own
#   `[triangles=]` for another weight.
#   SAFE TO TURN (kit §11a): every knob is clamped to the range stated beside it inside the recipe, so a value past it
#   builds the nearest good piece, never a broken mesh. A knob written -1 is AUTO: drawn from `noise` (and `damage`).
#   SEED: `noise` (`seed=` is reserved on add); every draw is a sine hash keyed `noise * 1009 + k`, so an edit above an
#   entry never re-rolls it.
#
# TOP-LEVEL KNOBS (the same names in every kit file), then ADVANCED (bar count, size and stick-out lead them):
#   ReinforcedChunk(size, damage, age, noise, budget | bars, d, stick, ar, tr, faces, cover, dir, skew, pitch, bend, neck, skin, tile)
# meaning, unit, range [clamp], default:
#   size    cm, the chunk's longest side                                         [6, 80]   17
#   damage  how broken: the chunk's angularity and relief (as Chunk), and how far its bars were bent (bend share
#           0.15 + 0.6 x damage, bend angles up to 15 + 95 x damage) and torn (stub ends)   [0, 1]  0.5
#   age     wear of the concrete (as Chunk) and rust of the steel (as Rebar)    [0, 1]    0
#   noise   the seed                                                             [1, 99999] 1
#   budget  0 game, 1 high, 2 ultra: passed to the chunk and to every bar      [0, 2]    1
#   bars    bar lines: 1 one bar, 2 a crossing pair, 3 adds a second main bar   [0, 3]    2
#   d       cm bar diameter: #3 0.95, #4 1.27, #5 1.59                          [0.6, 3.6] 1.27
#   stick   cm mean stand-out of a bar end (each end 0.3-1.4 x it)              [0, 60]   7
#   ar, tr, faces   the chunk's proportions and planes (as Chunk; -1 drawn)     as Chunk  -1
#   cover   cm from the cast skin to the bar (held between 0.25 and 0.4 of the chunk's height; the cross bar one d higher, under 0.55)   [0, 20]  3.8
#   dir     degrees, the direction the main bars run (0 = along the chunk's length)   [any]  0
#   skew    degrees a bar may turn off its line (each its own draw; `spread=` is add()'s)   [0, 45]   8
#   pitch   degrees a bar may climb or fall (held so it cannot reach the skin)  [0, 30]   8
#   bend    share of ends bent (-1: 0.15 + 0.6 x damage)                        [0, 1]    -1
#   neck    share of straight ends necked (the rest sheared)                    [0, 1]    0.25
#   skin    1 the chunk's bottom is cast skin, 0 all broken                     [0, 1]    1
#   tile    cm per UV tile (concrete and steel alike)                           [any]     100

build {
  SM_Debris_ReinforcedChunk_Game  = $RChunkGame  [pivot=(0, 0, 0)]
  SM_Debris_ReinforcedChunk_High  = $RChunkHigh  [pivot=(0, 0, 0)]
  SM_Debris_ReinforcedChunk_Ultra = $RChunkUltra [pivot=(0, 0, 0)]
}

Face     = material()
Broken   = material()
Steel    = material()
SteelCut = material()

R  = shape('/GraphCodeShape/Presets/Rebar', Steel = $Steel, SteelCut = $SteelCut)
CP = shape('/GraphCodeShape/Presets/ConcreteParts', Face = $Face, Broken = $Broken)

# ---- the tiers: one wrapper each (a build line cannot pass knob values) ----------------------------------------
RChunkGame  = mesh(noise=1) { add($ReinforcedChunk, budget=0, noise=$noise) }
RChunkHigh  = mesh(noise=1) { add($ReinforcedChunk, budget=1, noise=$noise) }
RChunkUltra = mesh(noise=1) { add($ReinforcedChunk, budget=2, noise=$noise) }

# ---- ReinforcedChunk --------------------------------------------------------------------------------------------
ReinforcedChunk = mesh(size=17.0, damage=0.5, age=0.0, noise=1, budget=1, bars=2, d=1.27, stick=7.0, ar=-1.0, tr=-1.0, faces=-1, cover=3.8, dir=0.0, skew=8.0, pitch=8.0, bend=-1.0, neck=0.25, skin=1, tile=100.0) {
  $S = clamp($size, 6.0, 80.0)
  $dm = clamp($damage, 0.0, 1.0)
  $ag = clamp($age, 0.0, 1.0)
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $nz = clamp(floor($noise), 1, 99999)
  $k0 = $nz * 1009
  $D = clamp($d, 0.6, 3.6)
  $NB = clamp(floor($bars + 0.5), 0, 3)
  $ST = clamp($stick, 0.0, 60.0)
  # the chunk's proportions, drawn with the same keys Chunk uses, so the bars know its height
  $c1 = sin(($k0 + 41) * 12.9898 + 0.7) * 43758.5453
  $c1 = $c1 - floor($c1)
  $c2 = sin(($k0 + 42) * 12.9898 + 0.7) * 43758.5453
  $c2 = $c2 - floor($c2)
  $AR = clamp(ceil($ar + 0.5), 0, 1) * clamp($ar, 0.3, 1.0) + (1 - clamp(ceil($ar + 0.5), 0, 1)) * (0.5 + 0.25 * $c1)
  $TR = clamp(ceil($tr + 0.5), 0, 1) * clamp($tr, 0.15, 1.0) + (1 - clamp(ceil($tr + 0.5), 0, 1)) * (0.42 - 0.08 * $dm + 0.16 * ($c2 - 0.5))
  $T = $S * $TR
  $Wd = $S * $AR
  add($CP.Chunk, size=$S, damage=$dm, age=$ag, noise=$nz, budget=$bg, ar=$AR, tr=$TR, faces=$faces, skin=$skin, tile=$tile)
  $zc = clamp(clamp($cover, 0.0, 20.0) + 0.5 * $D, 0.25 * $T, 0.4 * $T)
  $pm = min(clamp($pitch, 0.0, 30.0), 57.3 * 0.25 * $T / (0.5 * $S))
  $bnd = clamp(ceil($bend + 0.5), 0, 1) * clamp($bend, 0.0, 1.0) + (1 - clamp(ceil($bend + 0.5), 0, 1)) * (0.15 + 0.6 * $dm)
  $nks = clamp($neck, 0.0, 1.0)
  $sp = clamp($skew, 0.0, 45.0)
  $two = clamp($NB - 1, 0, 1)
  # ---- bar 1
  if ($NB > 0.5) {
    $a1 = sin(($k0 + 141) * 12.9898 + 0.7) * 43758.5453
    $a1 = $a1 - floor($a1)
    $a2 = sin(($k0 + 142) * 12.9898 + 0.7) * 43758.5453
    $a2 = $a2 - floor($a2)
    $a3 = sin(($k0 + 143) * 12.9898 + 0.7) * 43758.5453
