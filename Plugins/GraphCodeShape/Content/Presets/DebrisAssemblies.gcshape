    $dz = sin($el)
    $em = 0.5 * (abs($dx) * $S + abs($dy) * $Wd) + abs($px * $dx + $py * $dy) + 1.0
    save($EA1) [at=($px, $py, $pz), project=($dx, $dy, $dz), within=2 * $S]
    $mx = 0 - ($dx)
    $my = 0 - ($dy)
    $mz = 0 - ($dz)
    $pa = ($el) - 90.0
    $pb = 0 - ($el) - 90.0
    $yb = ($az) + 180.0
    save($EB1) [at=($px, $py, $pz), project=($mx, $my, $mz), within=2 * $S]
    $e1 = sin(($k0 + 151) * 12.9898 + 0.7) * 43758.5453
