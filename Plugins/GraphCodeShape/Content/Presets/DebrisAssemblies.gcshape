        h1ab = add($R.BentBar, len=$st * (1.4 + 1.4 * $e5), damage=$dm, age=$ag, noise=$nzb, budget=$bg, embed=$em, d=$D, root=$st * (0.25 + 0.35 * $e6), angle=15.0 + (20.0 + 75.0 * $dm) * $e7, dir=90.0 + 180.0 * $e5, end=$fate, tile=$tile, at=$EA1, rotate=(0.0, $pa, $az), join=none)
