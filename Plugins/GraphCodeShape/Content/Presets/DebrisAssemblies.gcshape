    $az = $dir + 0.0 + $sp * ($a1 - 0.5)
    $el = $pm * (2 * $a2 - 1)
    $lat = 0.0 + 0.06 * $Wd * (2 * $a3 - 1)
    $alg = 0.08 * $S * (2 * $a4 - 1)
    $px = 0 - sin($az) * $lat + cos($az) * $alg
    $py = cos($az) * $lat + sin($az) * $alg
    $pz = min($zc + 0.0, 0.55 * $T)
    $dx = cos($el) * cos($az)
