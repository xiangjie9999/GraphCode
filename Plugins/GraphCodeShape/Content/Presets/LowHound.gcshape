gcshape 1 into:/Game/AnimalStudies/Hound smooth:.16 shade:75 uv:keep
# A short-legged, long-bodied variety layered on Dog. Dimensions in centimetres.
build { SM_LowHound = $Animal [pivot=(0,0,0)] }

Species = shape('/GraphCodeShape/Presets/Dog')
Base = shape('/GraphCodeShape/Presets/Dog',Feline=$Feline)
# The lower jaw rests beneath the nasal collar. Distances on the border
# profiles are head-length fractions, sampled from occiput to muzzle.
EyeToPlanumFit = $Base.EyeToPlanumFit
EyeToPlanumRatio = $Base.EyeToPlanumRatio
PalpebralTurnInset = $Base.PalpebralTurnInset
SupraorbitalRimRadius = $Base.SupraorbitalRimRadius
