HipShareOffset = profile(0=0,1=0)
RibShareOffset = profile(0=0,1=0)
PelvisOffset = profile(0=0,1=0)
WithersOffset = profile(0=0,1=0)
BackProfileOffset = profile(0=0,1=0)
UnderProfileOffsetScale = 1
UnderProfileOffset = profile(0=0,1=0)
