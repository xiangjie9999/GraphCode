gcshape 1 into:/GraphCodeShape/Presets smooth:0.004 shade:80

# Organic parts, in centimetres. +Z is the growth axis, X is width and Y is
# thickness. Mounting sections start at z=0. Proportions are adjustable design
# defaults for static forms; these recipes do not generate skin weights.
# Build the large forms before adding creases: a blend rebuilds both operands.
build {
  SM_Organic_Segment = $Segment [pivot=(0,0,0), bounds=(2.2,1.9,3.5)]
  SM_Organic_Pad = $Pad [pivot=(0,0,0), bounds=(2.1,1.3,2.9)]
  SM_Organic_Transition = $Transition [pivot=(0,0,0), bounds=(6.9,5.6,24.1)]
}

Skin = material()
Profiles = shape('/GraphCodeShape/Presets/Profiles')

# A continuous transition between two independent elliptical sections. Both
# interfaces have authored width/depth, so a wrist, ankle or neck adapter can
# share its dimensions with the part it joins. No attachment geometry is guessed
# from a rendered bounding box. The default is a forearm-sized blank.
Transition = mesh(length=24, width=6.8, depth=5.5, endwidth=5.2, enddepth=2.5) {
  circle(radius=$endwidth / 2, scale=(1,$enddepth / $endwidth,1))
  $End = plane
  circle(radius=$width / 2, scale=(1,$depth / $width,1))
  loft(to=$End, at=(0,0,$length), profile=$Profiles.SCurve)
  material($Skin)
}

# A tapered soft segment. length, width and depth are centimetres; contour is
# the relative cross-section scale over its length. No sockets are imposed on
# an internal part: the owning finger or limb declares its attachment frames.
Segment = mesh(length=3.4, width=2, depth=1.65, contour=profile(0=100%, .15=106%, .55=96%, 1=88%)) {
  circle(radius=$width / 2, scale=(1,$depth / $width,1))
  extrude(height=$length, to=$contour)
  material($Skin)
}

# A closed ellipsoidal flesh pad, based at z=0. Useful for a fingertip, thenar
# pad or heel. Give it real overlap before joining; its socket is not a weld.
Pad = mesh(width=2, depth=1.2, length=2.8) {
  arc(radius=1, from=-90, to=90)
  revolve(scale=($width / 2,$depth / 2,$length / 2), at=(0,0,$length / 2))
  material($Skin)
}

# Unit disk for a crease stroke. width on FlexionCrease scales this footprint;
# it is independent of the depth of the indentation.
CreaseFoot = plane() { circle(radius=1) }

# Slow approach to a rounded indentation at the stroke centre.
CreaseSlope = profile(0=0%, .45=65%, 1=100%)

# A shallow crease on the -Y palm side. width is the full brush width in cm,
# depth is the inward displacement in cm, and start/end locate the stroke.
# Through-projection is narrowed by facing=-Y; the back stays untouched.
# Call after blending the major forms. A caller may further narrow its region.
FlexionCrease = instruction(width=.24, depth=.035, start=(-.6,-1,3.4), end=(.6,-1,3.4)) {
  displace(by=-$depth, slope=$CreaseSlope, along=-Y) [facing=-Y, in=$CreaseFoot, from=$start, to=$end, project=+Y, scale=$width / 2]
}
