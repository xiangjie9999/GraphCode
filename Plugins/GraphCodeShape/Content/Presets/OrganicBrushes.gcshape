gcshape 1 into:/Game/GraphCodeMarket/GraphCode/OrganicBrushes smooth:.006 shade:80

# Reusable projected sculpting controls, not new language verbs.
# Dimensions and travel are centimetres. The caller owns the part/side mask.
DefaultFootprint = plane() { circle(radius=.5) }
SoftFalloff = profile(0=0%,.25=10%,.5=50%,.75=90%,1=100%)

# Local X/Y are the footprint axes. For a +/-Y-facing finger, (0,90,0)
# puts footprint X across the finger and footprint Y along its length.
# Projection is through the mesh; facing and the caller's mask limit the side.
Dab = instruction(footprint=$DefaultFootprint, centre=(0,0,0), direction=(0,1,0), orientation=(0,90,0), strength=.1, falloff=$SoftFalloff) {
  displace(by=$strength,to=$centre,along=$direction,slope=$falloff) [facing=$direction,in=$footprint,along=$direction,rotate=$orientation,at=$centre]
}
