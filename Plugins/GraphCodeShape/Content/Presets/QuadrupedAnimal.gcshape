gcshape 1 into:/Game/AnimalStudies/Parts/QuadrupedAnimal smooth:.16 shade:75 uv:keep
# Feline=0 selects the medium dog proportions. Feline=1 selects the shorthair.
# Every default below can be overridden on a shape import independently.
build { SM_QuadrupedAnimal = $Animal [pivot=(0,0,0)] }
# Each caller supplies a concrete torso at its requested tessellation.
# A landmark-bearing replacement preserves the named cervical transition band.
TorsoPart = mesh(source=$RequiredSurface,landmarks=1) {
  add($source,join=none)
  if ($landmarks > 0) { save($NeckBand) [$output.NeckBand] }
}
CervicalForm = instruction(baseline=$RequiredCervicalForm) { $baseline() }
HeadStandards = shape('/GraphCodeShape/Presets/AnimalHead',Feline=$Feline)
# The lower jaw rests beneath the nasal collar. Distances on the border
# profiles are head-length fractions, sampled from occiput to muzzle.
