BreastCapStart = $CervicalStandards.BreastCapStart
BladeStationOffset = $CervicalStandards.BladeStationOffset
BladeRake = $CervicalStandards.BladeRake
BladeSpan = $CervicalStandards.BladeSpan
BladeRelief = $CervicalStandards.BladeRelief
HaunchStationOffset = $CervicalStandards.HaunchStationOffset
