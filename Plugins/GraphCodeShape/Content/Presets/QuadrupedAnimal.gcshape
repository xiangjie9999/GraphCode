TailTipFraction = lerp(.36,.39,$Feline)
TailSag = .085
OrbitBreadth = lerp(.94,.67,$Feline)
CaninePlanum = material('/Game/AnimalStudies/Catalogue/Materials/MI_AfraPlanum')
FelinePlanum = material('/Game/AnimalStudies/Catalogue/Materials/MI_RosePlanum')
PlanumTaper = lerp(.91,1.90,$Feline)
MandibleBreadth = lerp(.82,.64,$Feline)
