KeelTaper = $CervicalStandards.KeelTaper
CervicalSeatStation = $CervicalStandards.CervicalSeatStation
CervicalSeatLevel = $CervicalStandards.CervicalSeatLevel
CervicalWithersShare = $CervicalStandards.CervicalWithersShare
CervicalSeatPitch = $CervicalStandards.CervicalSeatPitch
CervicalSeatBand = $CervicalStandards.CervicalSeatBand
ShoulderSeatLevel = $CervicalStandards.ShoulderSeatLevel
HipSeatLevel = $CervicalStandards.HipSeatLevel
HipCroupShare = $CervicalStandards.HipCroupShare
ShoulderSeatRake = $CervicalStandards.ShoulderSeatRake
HipSeatRake = $CervicalStandards.HipSeatRake
TailSeatSlope = $CervicalStandards.TailSeatSlope
CervicalOnset = $CervicalStandards.CervicalOnset
CervicalCapStart = $CervicalStandards.CervicalCapStart
CervicalRootBlend = $CervicalStandards.CervicalRootBlend
SkullCapDepth = $CervicalStandards.SkullCapDepth
SkullBandDepth = $CervicalStandards.SkullBandDepth
CervicalMuscleLevel = $CervicalStandards.CervicalMuscleLevel
CervicalMuscleSlope = $CervicalStandards.CervicalMuscleSlope
CervicalMuscleSpan = $CervicalStandards.CervicalMuscleSpan
CervicalBladeStation = $CervicalStandards.CervicalBladeStation
CervicalBladeRake = $CervicalStandards.CervicalBladeRake
CervicalBladeSpan = $CervicalStandards.CervicalBladeSpan
CervicalHollowStation = $CervicalStandards.CervicalHollowStation
CervicalHollowRake = $CervicalStandards.CervicalHollowRake
CervicalHollowSpan = $CervicalStandards.CervicalHollowSpan
CervicalHollowDepth = $CervicalStandards.CervicalHollowDepth
CervicalBladeLevel = $CervicalStandards.CervicalBladeLevel
CervicalBladeHeight = $CervicalStandards.CervicalBladeHeight
NeckKit = shape('/GraphCodeShape/Presets/QuadrupedNeck',RumpCapSpan=$RumpCapSpan,BreastCapStart=$BreastCapStart,BladeStationOffset=$BladeStationOffset,BladeRake=$BladeRake,BladeSpan=$BladeSpan,BladeRelief=$BladeRelief,HaunchStationOffset=$HaunchStationOffset,HaunchRake=$HaunchRake,HaunchSpan=$HaunchSpan,HaunchRelief=$HaunchRelief,KeelTaper=$KeelTaper,CervicalSeatStation=$CervicalSeatStation,CervicalSeatLevel=$CervicalSeatLevel,CervicalWithersShare=$CervicalWithersShare,CervicalSeatPitch=$CervicalSeatPitch,CervicalSeatBand=$CervicalSeatBand,ShoulderSeatLevel=$ShoulderSeatLevel,HipSeatLevel=$HipSeatLevel,HipCroupShare=$HipCroupShare,ShoulderSeatRake=$ShoulderSeatRake,HipSeatRake=$HipSeatRake,TailSeatSlope=$TailSeatSlope,CervicalOnset=$CervicalOnset,CervicalCapStart=$CervicalCapStart,CervicalRootBlend=$CervicalRootBlend,SkullCapDepth=$SkullCapDepth,SkullBandDepth=$SkullBandDepth,CervicalMuscleLevel=$CervicalMuscleLevel,CervicalMuscleSlope=$CervicalMuscleSlope,CervicalMuscleSpan=$CervicalMuscleSpan,CervicalBladeStation=$CervicalBladeStation,CervicalBladeRake=$CervicalBladeRake,CervicalBladeSpan=$CervicalBladeSpan,CervicalHollowStation=$CervicalHollowStation,CervicalHollowRake=$CervicalHollowRake,CervicalHollowSpan=$CervicalHollowSpan,CervicalHollowDepth=$CervicalHollowDepth,CervicalBladeLevel=$CervicalBladeLevel,CervicalBladeHeight=$CervicalBladeHeight,LoinTravelOffset=$LoinTravelOffset,HipShareOffset=$HipShareOffset,RibShareOffset=$RibShareOffset,PelvisOffset=$PelvisOffset,WithersOffset=$WithersOffset,BackProfileOffset=$BackProfileOffset,UnderProfileOffsetScale=$UnderProfileOffsetScale,UnderProfileOffset=$UnderProfileOffset,FlankOffset=$FlankOffset,CervicalVentralReach=$CervicalVentralReach,CervicalVentralRise=$CervicalVentralRise,CervicalDorsalReach=$CervicalDorsalReach,CervicalDorsalRise=$CervicalDorsalRise,CervicalWidthScale=$CervicalWidthScale,TorsoPart=$TorsoPart,CervicalForm=$CervicalForm,Feline=$Feline,StandingFit=1,SpineOffset=$SpineOffset,BellyOffset=$BellyOffset,TrunkGirthScale=$TrunkGirthScale,ShoulderStation=$ShoulderStation,HipStation=$HipStation,ForeTrack=$ForeTrack*$StanceWidth,HindTrack=$HindTrack*$StanceWidth,TailStation=$TailStation,TailRootLevel=$TailRootLevel,Skin=$Coat,Length=$Length,LoinExtra=$LoinExtra,ChestWidth=$ChestWidth,ChestDepth=$ChestDepth,HipWidth=$HipWidth,WaistWidth=$WaistWidth,Tuck=$Tuck,CroupRise=$CroupRise,WitherRise=$WitherRise,SkullWidth=$SkullWidth,SkullDepth=$SkullDepth,SkullPitch=$SkullPitch,ThroatFullness=$ThroatFullness,BreastProjection=$BreastProjection,JawInset=$JawInset,MuscleRelief=$MuscleRelief,ShoulderRelief=$ShoulderRelief,Reach=$NeckReach,Rise=$NeckRise+$StandingLift,RootWidth=$NeckRootWidth,Stations=$TrunkSections,Sides=$TrunkSides)
ForeX = $NeckKit.ShoulderX
HindX = $NeckKit.HipX
ForeY = $NeckKit.ShoulderY
HindY = $NeckKit.HipY
ForeFootX = $Limbs.ForePawSeat
HindFootX = $Limbs.HindPawSeat
# Each leg owns one complete planted paw. Both lateral pairs share these
# recipes. StanceOffset staggers the feet so the second pair reads in profile.
Fore = mesh(stride=0) {
  add($ForelegPart)
  if ($RegionalMarkings > 0) { material($ForePigmentChart) }
  warp(with=(W: 1-clamp(point.z/max(.00001,$StrideFadeLevel*$Limbs.ForeHeight),0,1)),by=($stride*$W*$W*(3-2*$W),0,0))
}
Hind = mesh(stride=0) {
  add($HindlegPart)
  if ($RegionalMarkings > 0) { material($HindPigmentChart) }
  warp(with=(W: 1-clamp(point.z/max(.00001,$StrideFadeLevel*$Limbs.HindHeight),0,1)),by=($stride*$W*$W*(3-2*$W),0,0))
}
FittedTail = mesh() {
  add($TailPart,join=none)
  if ($RegionalMarkings > 0) { material($TailPigmentChart) }
}
Appendages = mesh() {
  add($Fore,stride=$RightForeStride,at=($ForeX,$ForeY,0),join=none)
  add($Fore,stride=$LeftForeStride,mirror=Y,at=($ForeX,-$ForeY,0),join=none)
  add($Hind,stride=$RightHindStride,at=($HindX,$HindY,0),join=none)
  add($Hind,stride=$LeftHindStride,mirror=Y,at=($HindX,-$HindY,0),join=none)
  add($FittedTail,rotate=($TailRoll,0,$TailYaw),at=($NeckKit.TailX,0,$Clearance+$NeckKit.TailZ),join=none)
}
# Standing landmarks in the flank plane. These pairs follow the scapular
# spine, humerus, femoral shaft and caudal thigh as the trunk or stance changes.
Bell = formula(v) { .5+.5*cos(180*clamp($v,-1,1)) }
AxialLandmark = formula(x,z,along,slope,width,level,depth) { $Bell(($x-$along-$slope*($z-$level))/$width)*$Bell(($z-$level)/$depth) }
MuscleArea = formula(x,z,origin,key) { $AxialLandmark($x,$z,$origin+$MuscleStation($key),$MuscleSlope($key),$MuscleSpan($key),$MuscleLevel($key),$MuscleHeight($key))*$MuscleAmplitude($key) }
# Store a normalized flank chart on the fitted skin before the head is mounted.
# R spans one tail length behind the rump to 1.5 trunk lengths rostrally.
# G and B locate the meridian and brisket in units of the individual's chest depth.
FlankLongitude = weightage() { rule(condition=x,min=-($Length+$LoinExtra),max=1.5*($Length+$LoinExtra),profile=(0=0%,1=100%)) }
FlankBreadth = weightage() { rule(condition=y,min=-$ChestDepth,max=$ChestDepth,profile=(0=0%,1=100%)) }
FlankElevation = weightage() { rule(condition=z,min=$Clearance-1.75*$ChestDepth,max=$Clearance+1.5*$ChestDepth,profile=(0=0%,1=100%)) }
DermalHeight = weightage() { rule(condition=z,min=0,max=$Clearance+$ChestDepth+$WitherRise,profile=(0=0%,1=100%)) }
# Recover the longitudinal station on the bent tail after the surface remesh.
TailLocalX = formula(x,y) { ($x-$NeckKit.TailX)*cos($TailYaw)+$y*sin($TailYaw) }
TailLocalZ = formula(x,y,z) { ($y*cos($TailYaw)-($x-$NeckKit.TailX)*sin($TailYaw))*sin($TailRoll)+($z-$Clearance-$NeckKit.TailZ)*cos($TailRoll) }
ChordFraction = formula(x,z,ax,az,dx,dz) { clamp((($x-$ax)*$dx+($z-$az)*$dz)/max(.00001,$dx*$dx+$dz*$dz),0,1) }
ChordWeight = formula(x,z,ax,az,dx,dz,t) { 1/pow(max(.0001,pow($x-$ax-$t*$dx,2)+pow($z-$az-$t*$dz,2)),2) }
TailCurveStart = $TailRestAngle+$TailCarryDegrees*$TailCarry
TailCurveTurn = $TailCurlDegrees*$TailCurl
TailHalfAngle0 = .5*0*$TailCurveTurn
TailChordScale0 = (sin(abs($TailHalfAngle0))+max(0,.00000001-abs($TailHalfAngle0)*.01745329252))/max(.00000001,abs($TailHalfAngle0)*.01745329252)
TailArcX0 = $TailLength*(-0*cos($TailCurveStart+$TailHalfAngle0)*$TailChordScale0+$TailReachOffset(0)+$TailPigmentReachOffset(0))
TailArcZ0 = $TailLength*(0*sin($TailCurveStart+$TailHalfAngle0)*$TailChordScale0+$TailHeightOffset(0)+$TailPigmentHeightOffset(0)-$TailSag*sin(180*0))
TailHalfAngle1 = .5*.25*$TailCurveTurn
TailChordScale1 = (sin(abs($TailHalfAngle1))+max(0,.00000001-abs($TailHalfAngle1)*.01745329252))/max(.00000001,abs($TailHalfAngle1)*.01745329252)
TailArcX1 = $TailLength*(-.25*cos($TailCurveStart+$TailHalfAngle1)*$TailChordScale1+$TailReachOffset(.25)+$TailPigmentReachOffset(.25))
TailArcZ1 = $TailLength*(.25*sin($TailCurveStart+$TailHalfAngle1)*$TailChordScale1+$TailHeightOffset(.25)+$TailPigmentHeightOffset(.25)-$TailSag*sin(180*.25))
TailHalfAngle2 = .5*.5*$TailCurveTurn
TailChordScale2 = (sin(abs($TailHalfAngle2))+max(0,.00000001-abs($TailHalfAngle2)*.01745329252))/max(.00000001,abs($TailHalfAngle2)*.01745329252)
TailArcX2 = $TailLength*(-.5*cos($TailCurveStart+$TailHalfAngle2)*$TailChordScale2+$TailReachOffset(.5)+$TailPigmentReachOffset(.5))
TailArcZ2 = $TailLength*(.5*sin($TailCurveStart+$TailHalfAngle2)*$TailChordScale2+$TailHeightOffset(.5)+$TailPigmentHeightOffset(.5)-$TailSag*sin(180*.5))
TailHalfAngle3 = .5*.75*$TailCurveTurn
TailChordScale3 = (sin(abs($TailHalfAngle3))+max(0,.00000001-abs($TailHalfAngle3)*.01745329252))/max(.00000001,abs($TailHalfAngle3)*.01745329252)
TailArcX3 = $TailLength*(-.75*cos($TailCurveStart+$TailHalfAngle3)*$TailChordScale3+$TailReachOffset(.75)+$TailPigmentReachOffset(.75))
TailArcZ3 = $TailLength*(.75*sin($TailCurveStart+$TailHalfAngle3)*$TailChordScale3+$TailHeightOffset(.75)+$TailPigmentHeightOffset(.75)-$TailSag*sin(180*.75))
TailHalfAngle4 = .5*1*$TailCurveTurn
TailChordScale4 = (sin(abs($TailHalfAngle4))+max(0,.00000001-abs($TailHalfAngle4)*.01745329252))/max(.00000001,abs($TailHalfAngle4)*.01745329252)
TailArcX4 = $TailLength*(-1*cos($TailCurveStart+$TailHalfAngle4)*$TailChordScale4+$TailReachOffset(1)+$TailPigmentReachOffset(1))
TailArcZ4 = $TailLength*(1*sin($TailCurveStart+$TailHalfAngle4)*$TailChordScale4+$TailHeightOffset(1)+$TailPigmentHeightOffset(1)-$TailSag*sin(180*1))
ChordT0 = formula(x,z) { $ChordFraction($x,$z,$TailArcX0,$TailArcZ0,$TailArcX1-$TailArcX0,$TailArcZ1-$TailArcZ0) }
ChordW0 = formula(x,z) { $ChordWeight($x,$z,$TailArcX0,$TailArcZ0,$TailArcX1-$TailArcX0,$TailArcZ1-$TailArcZ0,$ChordT0($x,$z)) }
ChordT1 = formula(x,z) { $ChordFraction($x,$z,$TailArcX1,$TailArcZ1,$TailArcX2-$TailArcX1,$TailArcZ2-$TailArcZ1) }
ChordW1 = formula(x,z) { $ChordWeight($x,$z,$TailArcX1,$TailArcZ1,$TailArcX2-$TailArcX1,$TailArcZ2-$TailArcZ1,$ChordT1($x,$z)) }
ChordT2 = formula(x,z) { $ChordFraction($x,$z,$TailArcX2,$TailArcZ2,$TailArcX3-$TailArcX2,$TailArcZ3-$TailArcZ2) }
ChordW2 = formula(x,z) { $ChordWeight($x,$z,$TailArcX2,$TailArcZ2,$TailArcX3-$TailArcX2,$TailArcZ3-$TailArcZ2,$ChordT2($x,$z)) }
ChordT3 = formula(x,z) { $ChordFraction($x,$z,$TailArcX3,$TailArcZ3,$TailArcX4-$TailArcX3,$TailArcZ4-$TailArcZ3) }
ChordW3 = formula(x,z) { $ChordWeight($x,$z,$TailArcX3,$TailArcZ3,$TailArcX4-$TailArcX3,$TailArcZ4-$TailArcZ3,$ChordT3($x,$z)) }
TailStationAt = formula(x,z) { ($ChordT0($x,$z)*$ChordW0($x,$z)+(1+$ChordT1($x,$z))*$ChordW1($x,$z)+(2+$ChordT2($x,$z))*$ChordW2($x,$z)+(3+$ChordT3($x,$z))*$ChordW3($x,$z))/(4*($ChordW0($x,$z)+$ChordW1($x,$z)+$ChordW2($x,$z)+$ChordW3($x,$z))) }
Body = mesh() {
  add($NeckKit.WithNeck,at=(0,0,$Clearance))
  add($Appendages,join=blend,falloff=.041*$ChestWidth)
  remesh($UnitedSkinSpacing*$ChestWidth)
  # Ease the pectoral-to-brachial transition on the united skin. Restrict smoothing to the axilla.
  relax($AxillaryBlendRadius) [value=abs(point.x-$ForeX)/max(.00001,$AxillaryLength)+abs(point.z-$Clearance-$AxillaryLevel*$ChestDepth)/max(.00001,$AxillaryDepth),below=$AxillaryBoundary,fade=$AxillaryFalloff]
  warp(with=(X: (point.x-$LoinExtra*clamp((point.x-.23*$Length)/(.27*$Length+$LoinExtra),0,1))/$Length,Z: (point.z-$Clearance)/$ChestDepth,Side: clamp(abs(point.y)/($ScapularMedialFalloff*$ChestWidth),0,1),Scapula: $MuscleArea($X,$Z,$ShoulderStation,.0), ShoulderGroove: $MuscleArea($X,$Z,$ShoulderStation,.125), Triceps: $MuscleArea($X,$Z,$ShoulderStation,.25), Glute: $MuscleArea($X,$Z,$HipStation,.375), Thigh: $MuscleArea($X,$Z,$HipStation,.50), Hamstring: $MuscleArea($X,$Z,$HipStation,.625), Fossa: $MuscleArea($X,$Z,$HipStation,.75), Flank: $MuscleArea($X,$Z,0,1), Relief: ($Scapula+$ShoulderGroove+$Triceps+$Glute+$Thigh+$Hamstring+$Fossa)*$MuscleDefinition+($Condition-1)*$Flank),by=(0,clamp(point.y*10,-1,1)*$ChestWidth*$Side*$Relief,0))
  warp(with=(X: (point.x-$LoinExtra)/$Length,Z: (point.z-$Clearance)/$ChestDepth,Sternum: $Bell(($X-$SternalStation)/$SternalSpan)*$Bell(($Z-$SternalLevel)/$SternalDepthSpan),Midline: 1-clamp(abs(point.y)/($SternalHalfWidth*$ChestWidth),0,1)),by=(0,0,-$SternalDrop*$ChestDepth*$Sternum*$Midline))
  # Faint oblique folds in the loose ventrolateral skin at the neck
  # root. Coordinates follow the cervical seat and shoulder station.
  warp(with=(Run: max(1,$NeckKit.HeadX-$ForeX),X: (point.x-$ForeX)/$Run,H: (point.z-$Clearance)/$ChestDepth,L: abs(point.y)/$ChestWidth,Field: $Bell(($X-$CervicalFoldStation)/$CervicalFoldSpan)*$Bell(($H-$CervicalFoldLevel-$CervicalFoldSlope*$X)/$CervicalFoldDepthSpan)*$Bell(($L-$CervicalFoldOffset)/$CervicalFoldHalfWidth),Valley: pow(.5+.5*cos(360*($CervicalFoldAxialCycles*$X+$CervicalFoldVerticalCycles*$H+$CervicalFoldLateralCycles*$L)),$CervicalFoldSharpness)),by=(0,-clamp(point.y*10,-1,1)*$ChestWidth*$SkinFoldDepth*$Field*$Valley,0))
  uv(box,scale=$Length)
  if ($RegionalMarkings > 0) {
    save($SavedForePigmentChart) [material=$ForePigmentChart]
    save($SavedHindPigmentChart) [material=$HindPigmentChart]
    save($SavedTailPigmentChart) [material=$TailPigmentChart]
  }
  material($Coat)
  if ($RegionalMarkings > 0) {
    material($ForePigmentChart) [$SavedForePigmentChart]
    material($HindPigmentChart) [$SavedHindPigmentChart]
    material($TailPigmentChart) [$SavedTailPigmentChart]
  }
  # Keep the digital pads, interdigital spaces and claw sheaths at source
  # resolution. All four feet use the very same swappable, finished part.
  add($ForePawPart,scale=$ForePawScale,at=($ForeX+$ForeFootX+$RightForeStride,$ForeY,0),join=hard)
  add($ForePawPart,mirror=Y,scale=$ForePawScale,at=($ForeX+$ForeFootX+$LeftForeStride,-$ForeY,0),join=hard)
  add($HindPawPart,scale=$HindPawScale,at=($HindX+$HindFootX+$RightHindStride,$HindY,0),join=hard)
  add($HindPawPart,mirror=Y,scale=$HindPawScale,at=($HindX+$HindFootX+$LeftHindStride,-$HindY,0),join=hard)
  if (max($ForeDewclaw,$CarpalPadScale) > 0) {
    add($Limbs.Accessory,height=$Limbs.ForeHeight,hind=0,stride=$RightForeStride,at=($ForeX,$ForeY,0),join=hard)
    add($Limbs.Accessory,height=$Limbs.ForeHeight,hind=0,stride=$LeftForeStride,mirror=Y,at=($ForeX,-$ForeY,0),join=hard)
  }
  if ($HindDewclaw > 0) {
    add($Limbs.Accessory,height=$Limbs.HindHeight,hind=1,stride=$RightHindStride,at=($HindX,$HindY,0),join=hard)
    add($Limbs.Accessory,height=$Limbs.HindHeight,hind=1,stride=$LeftHindStride,mirror=Y,at=($HindX,-$HindY,0),join=hard)
  }
  if ($RegionalMarkings > 0) {
    material($ForePigmentChart) [material=$Coat,value=max(point.z/$PawWidth,abs(point.x-$ForeX-$ForeFootX-lerp($LeftForeStride,$RightForeStride,clamp(point.y*10000,0,1)))/$PawLength),below=1]
    material($HindPigmentChart) [material=$Coat,value=max(point.z/$PawWidth,abs(point.x-$HindX-$HindFootX-lerp($LeftHindStride,$RightHindStride,clamp(point.y*10000,0,1)))/$PawLength),below=1]
    save($SavedForePigmentChart) [material=$ForePigmentChart]
    save($SavedHindPigmentChart) [material=$HindPigmentChart]
    save($SavedTailPigmentChart) [material=$TailPigmentChart]
    material($Coat) [$SavedForePigmentChart]
    material($Coat) [$SavedHindPigmentChart]
    material($Coat) [$SavedTailPigmentChart]
  }
  save($BodyPigment) [material=$Coat]
  $PigmentLength = select($BodyPigment,weight=$FlankLongitude)
  $PigmentBreadth = select($BodyPigment,weight=$FlankBreadth)
  $PigmentHeight = select($BodyPigment,weight=$FlankElevation)
  colour(0,channel=rgb) [$BodyPigment]
  colour(1,channel=r) [$PigmentLength]
  colour(1,channel=g) [$PigmentBreadth]
  colour(1,channel=b) [$PigmentHeight]
  colour(.12,channel=a) [$BodyPigment]
  if ($RegionalMarkings > 0) {
    material($ForePigmentChart) [$SavedForePigmentChart]
    material($HindPigmentChart) [$SavedHindPigmentChart]
    material($TailPigmentChart) [$SavedTailPigmentChart]
    $ForeMarkLongitude = select($SavedForePigmentChart,weight=$FlankLongitude)
    colour(0,channel=g) [material=$ForePigmentChart]
    colour(1,channel=g) [$ForeMarkLongitude]
    colour(0,channel=r) [material=$ForePigmentChart]
    colour(1,channel=r) [material=$ForePigmentChart,value=.01+.98*clamp(point.z/$Limbs.ForeHeight,0,1),above=0,fade=1]
    colour(.16,channel=a) [material=$ForePigmentChart]
    $HindMarkLongitude = select($SavedHindPigmentChart,weight=$FlankLongitude)
    colour(0,channel=g) [material=$HindPigmentChart]
    colour(1,channel=g) [$HindMarkLongitude]
    colour(0,channel=r) [material=$HindPigmentChart]
    colour(1,channel=r) [material=$HindPigmentChart,value=.01+.98*clamp(point.z/$Limbs.HindHeight,0,1),above=0,fade=1]
    colour(.18,channel=a) [material=$HindPigmentChart]
    colour(0,channel=r) [material=$TailPigmentChart]
    colour(1,channel=r) [material=$TailPigmentChart,value=.01+.98*clamp($TailStationAt($TailLocalX(point.x,point.y),$TailLocalZ(point.x,point.y,point.z)),0,1),above=0,fade=1]
    colour(.20,channel=a) [material=$TailPigmentChart]
    material($Coat) [$SavedForePigmentChart]
    material($Coat) [$SavedHindPigmentChart]
    material($Coat) [$SavedTailPigmentChart]
  }
  if ($DermalChart > 0) {
    save($Dermis) [material=$Coat]
    $FromSole = select($Dermis,weight=$DermalHeight)
    colour(0,channel=b) [$Dermis]
    colour(1,channel=b) [$FromSole]
    colour(.145,channel=a) [$Dermis]
  }
}
# A swappable head supplies its weld surface and its free inserts in the same
# local space. Both passes use the same source and the same cranial seat.
HeadAssembly = mesh(inserts=0) {
  if ($inserts == 0) { add($HeadKit.FaceSkin,join=none) }
  if ($inserts > 0) { add($HeadKit.Details,join=none) }
}
HeadPart = mesh() {
  add($HeadAssembly,inserts=0,join=none)
  add($HeadAssembly,inserts=1,join=none)
  socket(Root,at=($SkullSeatStation*$HeadLength,0,-$SkullSeatDepth*$HeadHeight),facing=-X,up=+Z,type='mammal/skull@1')
}
HeadSeatX = $NeckKit.HeadX-$SkullSeatStation*$HeadLength*cos($HeadCarry)-$SkullSeatDepth*$HeadHeight*sin($HeadCarry)
HeadSeatZ = $Clearance+$NeckKit.HeadZ-$SkullSeatStation*$HeadLength*sin($HeadCarry)+$SkullSeatDepth*$HeadHeight*cos($HeadCarry)
StandingSkin = mesh() {
  add($Body,join=none)
  add($HeadAssembly,inserts=0,at=($HeadSeatX,0,$HeadSeatZ),rotate=(0,$HeadCarry,0),join=hard)
  relax(.075*$HeadWidth) [value=abs(point.x-$NeckKit.HeadX)+.55*abs(point.z-$Clearance-$NeckKit.HeadZ),below=.59*$HeadWidth,fade=.12*$HeadWidth]
  uv(box,scale=$HeadWidth)
  add($HeadAssembly,inserts=1,at=($HeadSeatX,0,$HeadSeatZ),rotate=(0,$HeadCarry,0),join=none)
}


Animal = mesh() {
  add($StandingSkin,join=none)
  if ($UseSpeciesCoat > 0) {
    if ($CoatPalette < .5) { material($CanineCoat) [material=$Coat] }
    if ($CoatPalette >= .5) { material($FelineCoat) [material=$Coat] }
  }
}

# Groom carrier. Only existing coat skin can acquire a growth slot. Eyes,
# lips, nasal leather, pads and claws keep their original roots excluded.
BarrelHair = material('/Engine/BasicShapes/BasicShapeMaterial')
LegHair = material('/Engine/BasicShapes/BasicShapeMaterial')
TailHair = material('/Engine/BasicShapes/BasicShapeMaterial')
RuffHair = material('/Engine/BasicShapes/BasicShapeMaterial')
FaceHair = material('/Engine/BasicShapes/BasicShapeMaterial')
MuzzleHair = material('/Engine/BasicShapes/BasicShapeMaterial')
PinnaHair = material('/Engine/BasicShapes/BasicShapeMaterial')
BareMargin = material('/Engine/BasicShapes/BasicShapeMaterial')
LocalHeadX = formula(x,z) { ($x-$HeadSeatX)*cos($HeadCarry)+($z-$HeadSeatZ)*sin($HeadCarry) }
LocalHeadZ = formula(x,z) { -($x-$HeadSeatX)*sin($HeadCarry)+($z-$HeadSeatZ)*cos($HeadCarry) }
# The two pinnae lie lateral to their roots. A height-only selection also cuts
# the hair between the ears. A folded lobe extends down the side of the skull.
EarGrowth = formula(x,y,z) { max(max(abs($x-$EarSet*$HeadLength)/max(.001,$PinnaHairAxialSpan*$EarWidth),1+($HeadKit.EarRootY-$PinnaHairMedialAllowance*$EarWidth-abs($y))/max(.001,$EarWidth)),1+($HeadKit.EarRootZ-($PinnaHairRootDepth+$EarFold*$EarFold)*$EarHeight-$z)/max(.001,$EarHeight)) }
# The lash-free margin follows the tilted palpebral aperture and its depth.
GrowthOrbitU = formula(x,y) { (-($x-$HeadKit.EyeX)*sin($EyeAngle)+(abs($y)-$HeadKit.EyeY)*cos($EyeAngle))/$EyeSize }
GrowthLidRadius = formula(u,z) { sqrt($u*$u+pow((($z-$HeadKit.EyeZ)/$EyeSize-$CanthusRise*$u-$LowerLidRise*(1-$u*$u))/max(.001,$EyeAperture*$Features.Canthus(clamp(abs($u),0,1))),2)) }
LidGrowthDistance = formula(x,y,z) { max($GrowthLidRadius($GrowthOrbitU($x,$y),$z)/max(.001,$LidHairClearance),abs((($x-$HeadKit.EyeX)*cos($EyeAngle)+(abs($y)-$HeadKit.EyeY)*sin($EyeAngle))/$EyeSize-$CorneaRelief)/max(.001,$LidHairDepth)) }
CoatSurface = mesh() {
  add($StandingSkin,join=none)
  save($HairSkin) [material=$Coat]
  material($BarrelHair) [$HairSkin]
  material($LegHair) [$HairSkin,value=max(abs(point.x-$ForeX)/(.25*$Length),point.z/($Clearance+.19*$ChestDepth)),below=1]
  material($LegHair) [$HairSkin,value=max(abs(point.x-$HindX)/(.34*$Length),point.z/($Clearance+.20*$ChestDepth)),below=1]
  material($TailHair) [$HairSkin,value=max(point.x-$TailStation*$Length+.05*$Length,($Clearance+.35*$ChestDepth-point.z)*clamp(1+point.x/(.15*$Length),0,1)-.01),below=0]
  material($RuffHair) [$HairSkin,value=min(point.x-$ForeX,(point.z-$Clearance-.31*$ChestDepth)),above=0]
  material($FaceHair) [$HairSkin,value=$LocalHeadX(point.x,point.z)/$HeadLength,above=.14]
  material($MuzzleHair) [$HairSkin,value=$LocalHeadX(point.x,point.z)/$HeadLength,above=$EyeSet+.075]
  material($PinnaHair) [$HairSkin,value=$EarGrowth($LocalHeadX(point.x,point.z),point.y,$LocalHeadZ(point.x,point.z)),below=1]
  material($BareMargin) [$HairSkin,value=$LidGrowthDistance($LocalHeadX(point.x,point.z),point.y,$LocalHeadZ(point.x,point.z)),below=1]
}

Torso = mesh() {
  add($NeckKit.StandaloneTorso,join=none)
  save($NeckBand) [$output.NeckBand]
}
Neck = mesh() {
  add($NeckKit.Neck,join=none)
  save($SkullBand) [$output.SkullBand]
}
WithNeck = mesh() {
  add($NeckKit.WithNeck,join=none)
  save($SkullBand) [$output.SkullBand]
}
