# REBAR — the debris lane's steel pieces (L2 primitives, one act each: Docs/GC-SHAPE-DEBRIS-LANE.md, lead rulings 1-3).
# GENERATED by Content/__MCPTests/DamageKit/gen/debris/gendebris.py: edit the generator, not this file.
#
#   R = shape('/GraphCodeShape/Presets/Rebar', Steel = $MyRebar, SteelCut = $MyBrightSteel)
#   Kit = mesh() { add($R.BentBar, len=40, damage=0.7, noise=3)  add($R.BarStub, stick=8, at=(20, 0, 0)) }
#
# THE FRAME: a bar GROWS along +Z from the origin, its section centred on the axis. `BarStub`'s origin is on the
# break plane (the concrete face it leaves), its hidden root running `embed` cm below; `BentBar`'s origin is its root.
# A caller turns +Z to the bar's outward direction with `rotate=(0, elevation - 90, azimuth)` and places it with `at=`.
# SLOTS (pathless, bind at import): `Steel` the bar, `SteelCut` the bright end faces (bind it to the same material as
# `Steel` for one steel). UVs: one cylinder map in the STRAIGHT frame before any bend (U round, V along), `tile` cm a
# tile, so a bent bar keeps its texel density (bends keep arc length).
#   STATES AND TIERS: every piece ships three build lines from one recipe (kit §12.1, §8a.6: the budget is the author's,
#   no ceiling): `_Game` (`budget=0`), `_High` (`budget=1`), `_Ultra` (`budget=2`). Pass any `budget` and your own
#   `[triangles=]` for another weight.
#   SAFE TO TURN (kit §11a): every knob is clamped to the range stated beside it inside the recipe, so a value past it
#   builds the nearest good piece, never a broken mesh. A knob written -1 is AUTO: drawn from `noise` (and `damage`).
#   SEED: `noise` (`seed=` is reserved on add); every draw is a sine hash keyed `noise * 1009 + k`, so an edit above an
#   entry never re-rolls it.
#
# TOP-LEVEL KNOBS (the same names in every kit file), then ADVANCED:
#   Bar(len, damage, age, noise, budget | d, sides, ribs, bow, wob, shear, tile)
#   BarStub(stick, damage, age, noise, budget | embed, d, end, shear, neck, lean, bow, sides, ribs, tile)
#   BentBar(len, damage, age, noise, budget | embed, d, root, angle, radius, dir, bend2, droop, end, shear, neck, sides, ribs, tile)
# meaning, unit, range [clamp], default:
#   len     cm, the bar's length along its axis (BentBar: arc length)            [2, 300]  30
#   stick   cm the stub stands out of the break plane                           [0.3, 60] 6
#   damage  how violent: Bar 0 straight -> 1 bowed 5 % of its length and waved; BarStub 0 a clean cut -> 1 necked or
#           sheared hard and leaning; BentBar 0 a slight bend (10 deg) -> 1 a hook (110 deg) with a second bend and droop
#                                                                                [0, 1]    Bar 0, BarStub 0.5, BentBar 0.5
#   age     rust: section loss to 8 % of the diameter, pitting on `_High`/`_Ultra` (the colour is the material's)
#                                                                                [0, 1]    0
#   noise   the seed                                                             [1, 99999] 1
#   budget  0 game (6 sides, few rings), 1 high (8 sides), 2 ultra (12 sides, dense rings, ribs)   [0, 2] 1
#   d       cm bar diameter: #3 0.95, #4 1.27, #5 1.59 (ASTM A615)                [0.6, 3.6] 1.27
#   embed   cm of hidden root inside the concrete (0.2 = none)                   [0.2, 200] 8 (BentBar 0.2)
#   end     the free end: -1 drawn from damage, 0 sheared, 1 necked (pulled in tension), 2 cut square   [-1, 2] -1
#   shear   degrees the sheared end face lies off square (-1 drawn: 10-40 x damage)   [0, 60] -1
#   neck    share of the diameter lost at a necked end (-1: 0.25 + 0.2 x damage)  [0, 0.6] -1
#   lean    degrees a stub stands off its axis (-1: up to 2 + 10 x damage)        [0, 30] -1
#   bow     cm a bar or stub bows off straight (-1 drawn from damage)            [0, 0.3 x len] -1
#   wob     cm a Bar waves sideways (-1 drawn from damage)                       [0, 0.1 x len] -1
#   root    cm a BentBar runs straight before its bend (-1: 0.13 x len +- 30 %)   [0.5, 0.4 x len] -1
#   angle   degrees of the first bend (-1: 10 + 100 x damage, +- 25 %)           [0, 150] -1
#   radius  inner bend radius in bar diameters (field bends are tight)           [1, 10] 3
#   dir     degrees the bend plane is turned about +Z (-1 drawn)                 [0, 360] -1
#   bend2   degrees of a second bend in its own plane (-1: above damage 0.55)     [0, 120] -1
#   droop   degrees the free part curls on after the bend (-1 drawn from damage)  [0, 60] -1
#   sides   sides of the section (0 = by budget: 6, 8, 12)                       [5, 24] 0
#   ribs    deformation ribs: -1 by budget (ultra), 0 off, 1 on (they need ultra's ring density)   [-1, 1] -1
#   tile    cm per UV tile                                                       [any] 100

build {
  SM_Rebar_Bar_Game       = $BarGame       [pivot=(0, 0, 0)]
  SM_Rebar_Bar_High       = $BarHigh       [pivot=(0, 0, 0)]
  SM_Rebar_Bar_Ultra      = $BarUltra      [pivot=(0, 0, 0)]
  SM_Rebar_BarStub_Game   = $BarStubGame   [pivot=(0, 0, 0)]
  SM_Rebar_BarStub_High   = $BarStubHigh   [pivot=(0, 0, 0)]
  SM_Rebar_BarStub_Ultra  = $BarStubUltra  [pivot=(0, 0, 0)]
  SM_Rebar_BentBar_Game   = $BentBarGame   [pivot=(0, 0, 0)]
  SM_Rebar_BentBar_High   = $BentBarHigh   [pivot=(0, 0, 0)]
  SM_Rebar_BentBar_Ultra  = $BentBarUltra  [pivot=(0, 0, 0)]
}

Steel    = material()
SteelCut = material()

# ---- the tiers: one wrapper each (a build line cannot pass knob values) ----------------------------------------
BarGame      = mesh(noise=1) { add($Bar, budget=0, damage=0.3, noise=$noise) }
BarHigh      = mesh(noise=1) { add($Bar, budget=1, damage=0.3, noise=$noise) }
BarUltra     = mesh(noise=1) { add($Bar, budget=2, damage=0.3, noise=$noise) }
BarStubGame  = mesh(noise=1) { add($BarStub, budget=0, noise=$noise) }
BarStubHigh  = mesh(noise=1) { add($BarStub, budget=1, noise=$noise) }
BarStubUltra = mesh(noise=1) { add($BarStub, budget=2, noise=$noise) }
BentBarGame  = mesh(noise=1) { add($BentBar, budget=0, noise=$noise) }
BentBarHigh  = mesh(noise=1) { add($BentBar, budget=1, noise=$noise) }
BentBarUltra = mesh(noise=1) { add($BentBar, budget=2, noise=$noise) }

