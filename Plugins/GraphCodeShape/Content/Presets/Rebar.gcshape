# ---- Bar: a straight loose bar, both ends sheared ---------------------------------------------------------------
# `len` cm from z = 0 to z = len; `damage` bows it (up to 5 % of its length, mid-span) and waves it sideways;
# both ends are sheared off square by a drawn angle (a flat cap reads as a cut tube, critic 15).
Bar = mesh(len=30.0, damage=0.0, age=0.0, noise=1, budget=1, d=1.27, sides=0, ribs=-1, bow=-1.0, wob=-1.0, shear=-1.0, tile=100.0) {
  $L = clamp($len, 2.0, 300.0)
  $D = clamp($d, 0.6, 3.6)
  $dm = clamp($damage, 0.0, 1.0)
  $ag = clamp($age, 0.0, 1.0)
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $nz = clamp(floor($noise), 1, 99999)
  $k0 = $nz * 1009
  $sd = clamp(ceil($sides - 1 + 0.5), 0, 1) * clamp(floor($sides), 5, 24) + (1 - clamp(ceil($sides - 1 + 0.5), 0, 1)) * (6 + 2 * $bg + 2 * max(0, $bg - 1))
  $rb = clamp(ceil($ribs + 0.5), 0, 1) * clamp($ribs, 0, 1) + (1 - clamp(ceil($ribs + 0.5), 0, 1)) * clamp($bg - 1, 0, 1)
  $q1 = sin(($k0 + 11) * 12.9898 + 0.7) * 43758.5453
  $q1 = $q1 - floor($q1)
  $q2 = sin(($k0 + 12) * 12.9898 + 0.7) * 43758.5453
  $q2 = $q2 - floor($q2)
  $q3 = sin(($k0 + 13) * 12.9898 + 0.7) * 43758.5453
  $q3 = $q3 - floor($q3)
  $q4 = sin(($k0 + 14) * 12.9898 + 0.7) * 43758.5453
  $q4 = $q4 - floor($q4)
  $q5 = sin(($k0 + 15) * 12.9898 + 0.7) * 43758.5453
  $q5 = $q5 - floor($q5)
  $bw = clamp(ceil($bow + 0.5), 0, 1) * clamp($bow, 0.0, 0.3 * $L) + (1 - clamp(ceil($bow + 0.5), 0, 1)) * ($dm * 0.05 * $L * (0.4 + 0.6 * $q1))
  $wb = clamp(ceil($wob + 0.5), 0, 1) * clamp($wob, 0.0, 0.1 * $L) + (1 - clamp(ceil($wob + 0.5), 0, 1)) * ($dm * 0.015 * $L * $q2)
  $wph = 360.0 * $q3
  $sh = clamp(ceil($shear + 0.5), 0, 1) * clamp($shear, 0.0, 60.0) + (1 - clamp(ceil($shear + 0.5), 0, 1)) * (8.0 + 30.0 * (0.3 + 0.7 * $dm) * $q4)
  $As = min(tan($sh) * 0.5 * $D, 0.05 * $L)
  $ph = 360.0 * $q5
  $cph = cos($ph)
  $sph = sin($ph)
  if ($bg > 1.5) {
    circle(radius=$D * 0.5, segments=$sd)
    sweep(along=$BarPath2)
  } else {
    if ($bg > 0.5) {
      circle(radius=$D * 0.5, segments=$sd)
      sweep(along=$BarPath1)
    } else {
      circle(radius=$D * 0.5, segments=$sd)
      sweep(along=$BarPath0)
    }
  }
  material($Steel)
  material($SteelCut) [top]
  material($SteelCut) [bottom]
  warp(to=(point.x, point.y, point.z * $L / 100.0))
  uv(cylinder, at=(0.0, 0.0, 0.0), facing=(0.0, 0.0, 1.0), up=(1.0, 0.0, 0.0), scale=($tile, $tile))
  if ($ag + $rb > 0) {
    warp(to=(point.x * (1 - 0.08 * $ag) * (1 + 0.12 * $ag * clamp($bg, 0, 1) * sin(point.x * 4111.3 + point.y * 2309.7 + point.z * 977.1 + $k0)) * (1 + 0.12 * $rb * pow(max(0, cos(360 * point.z / (2.5 * $D))), 8)), point.y * (1 - 0.08 * $ag) * (1 + 0.12 * $ag * clamp($bg, 0, 1) * sin(point.x * 4111.3 + point.y * 2309.7 + point.z * 977.1 + $k0)) * (1 + 0.12 * $rb * pow(max(0, cos(360 * point.z / (2.5 * $D))), 8)), point.z))
  }
  warp(to=(point.x, point.y, point.z + $As * (point.x * $cph + point.y * $sph) / (0.5 * $D) * (clamp((point.z - 0.93 * $L) / (0.07 * $L), 0, 1) - clamp((0.07 * $L - point.z) / (0.07 * $L), 0, 1))))
  if ($bw + $wb > 0) {
    warp(to=(point.x + $bw * sin(180 * point.z / $L), point.y + $wb * sin(360 * point.z / $L + $wph), point.z))
  }
}

# ---- BarStub: a bar end standing out of a break ------------------------------------------------------------------
# origin on the break plane; hidden root from z = -embed, stand-out to z = stick. The end's fate (sheared, necked, cut
# square) is drawn from `damage` unless `end` names it; above the plane the stub leans (`lean`) and bows (`bow`).
BarStub = mesh(stick=6.0, damage=0.5, age=0.0, noise=1, budget=1, embed=8.0, d=1.27, end=-1, shear=-1.0, neck=-1.0, lean=-1.0, bow=-1.0, sides=0, ribs=-1, tile=100.0) {
  $S = clamp($stick, 0.3, 60.0)
  $E = clamp($embed, 0.2, 200.0)
  $D = clamp($d, 0.6, 3.6)
  $dm = clamp($damage, 0.0, 1.0)
  $ag = clamp($age, 0.0, 1.0)
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $nz = clamp(floor($noise), 1, 99999)
  $k0 = $nz * 1009
  $sd = clamp(ceil($sides - 1 + 0.5), 0, 1) * clamp(floor($sides), 5, 24) + (1 - clamp(ceil($sides - 1 + 0.5), 0, 1)) * (6 + 2 * $bg + 2 * max(0, $bg - 1))
  $rb = clamp(ceil($ribs + 0.5), 0, 1) * clamp($ribs, 0, 1) + (1 - clamp(ceil($ribs + 0.5), 0, 1)) * clamp($bg - 1, 0, 1)
  $qe = sin(($k0 + 31) * 12.9898 + 0.7) * 43758.5453
  $qe = $qe - floor($qe)
  $qs = sin(($k0 + 32) * 12.9898 + 0.7) * 43758.5453
  $qs = $qs - floor($qs)
  $qp = sin(($k0 + 33) * 12.9898 + 0.7) * 43758.5453
  $qp = $qp - floor($qp)
  $ee = clamp(floor($end + 0.5), 0, 2)
  $isNk = clamp(ceil($end + 0.5), 0, 1) * (1 - min(abs($ee - 1), 1)) + (1 - clamp(ceil($end + 0.5), 0, 1)) * clamp(ceil(0.15 + 0.35 * $dm - $qe), 0, 1)
  $isSq = clamp(ceil($end + 0.5), 0, 1) * clamp($ee - 1, 0, 1) + (1 - clamp(ceil($end + 0.5), 0, 1)) * clamp(ceil($qe - 1 + 0.35 * (1 - $dm)), 0, 1)
  $isSh = clamp(1 - $isNk - $isSq, 0, 1)
  $sh = clamp(ceil($shear + 0.5), 0, 1) * clamp($shear, 0.0, 60.0) + (1 - clamp(ceil($shear + 0.5), 0, 1)) * (10.0 + 30.0 * $dm * (0.5 + $qs))
  $As = min(tan($sh) * 0.5 * $D, 0.06 * $S)
  $ph = 360.0 * $qp
  $cph = cos($ph)
  $sph = sin($ph)
  $nk = clamp(ceil($neck + 0.5), 0, 1) * clamp($neck, 0.0, 0.6) + (1 - clamp(ceil($neck + 0.5), 0, 1)) * (0.25 + 0.2 * $dm)
  $NL = min(2.0 * $D, $S)
  $jg = min(0.22 * $D, 0.028 * $S)
  $q6 = sin(($k0 + 16) * 12.9898 + 0.7) * 43758.5453
  $q6 = $q6 - floor($q6)
  $q7 = sin(($k0 + 17) * 12.9898 + 0.7) * 43758.5453
  $q7 = $q7 - floor($q7)
  $q8 = sin(($k0 + 18) * 12.9898 + 0.7) * 43758.5453
  $q8 = $q8 - floor($q8)
  $ln = clamp(ceil($lean + 0.5), 0, 1) * clamp($lean, 0.0, 30.0) + (1 - clamp(ceil($lean + 0.5), 0, 1)) * ((2.0 + 10.0 * $dm) * $q6)
  $bw = clamp(ceil($bow + 0.5), 0, 1) * clamp($bow, 0.0, 0.3 * $S) + (1 - clamp(ceil($bow + 0.5), 0, 1)) * (0.04 * $S * $dm * $q7)
  $lph = 360.0 * $q8
  if ($bg > 1.5) {
    circle(radius=$D * 0.5, segments=$sd)
    sweep(along=$StubPath2)
  } else {
    if ($bg > 0.5) {
      circle(radius=$D * 0.5, segments=$sd)
      sweep(along=$StubPath1)
    } else {
      circle(radius=$D * 0.5, segments=$sd)
      sweep(along=$StubPath0)
    }
  }
  material($Steel)
  material($SteelCut) [top]
  warp(to=(point.x, point.y, 0.0 - $E + $E * min(point.z, 50.0) / 50.0 + $S * max(0.0, point.z - 50.0) / 50.0))
  uv(cylinder, at=(0.0, 0.0, 0.0), facing=(0.0, 0.0, 1.0), up=(1.0, 0.0, 0.0), scale=($tile, $tile))
  if ($ag + $rb > 0) {
    warp(to=(point.x * (1 - 0.08 * $ag) * (1 + 0.12 * $ag * clamp($bg, 0, 1) * sin(point.x * 4111.3 + point.y * 2309.7 + point.z * 977.1 + $k0)) * (1 + 0.12 * $rb * pow(max(0, cos(360 * point.z / (2.5 * $D))), 8)), point.y * (1 - 0.08 * $ag) * (1 + 0.12 * $ag * clamp($bg, 0, 1) * sin(point.x * 4111.3 + point.y * 2309.7 + point.z * 977.1 + $k0)) * (1 + 0.12 * $rb * pow(max(0, cos(360 * point.z / (2.5 * $D))), 8)), point.z))
  }
  if ($isSh > 0.5) {
    warp(to=(point.x + 0.1 * $D * $cph * clamp((point.z - ($S - 0.14 * $S)) / (0.07 * $S), 0, 1), point.y + 0.1 * $D * $sph * clamp((point.z - ($S - 0.14 * $S)) / (0.07 * $S), 0, 1), point.z + $As * (point.x * $cph + point.y * $sph) / (0.5 * $D) * clamp((point.z - ($S - 0.07 * $S)) / (0.07 * $S), 0, 1)))
  }
  if ($isNk > 0.5) {
    warp(to=(point.x * (1 - $nk * pow(clamp((point.z - $S + $NL) / $NL, 0, 1), 2) * (3 - 2 * clamp((point.z - $S + $NL) / $NL, 0, 1))) * (1 - 0.5 * clamp((point.z - ($S - 0.035 * $S)) / (0.035 * $S), 0, 1)), point.y * (1 - $nk * pow(clamp((point.z - $S + $NL) / $NL, 0, 1), 2) * (3 - 2 * clamp((point.z - $S + $NL) / $NL, 0, 1))) * (1 - 0.5 * clamp((point.z - ($S - 0.035 * $S)) / (0.035 * $S), 0, 1)), point.z + $jg * sin(point.x * 5171.3 + point.y * 3113.9 + $k0) * clamp((point.z - ($S - 0.035 * $S)) / (0.035 * $S), 0, 1)))
  }
  if ($ln + $bw > 0) {
    warp(to=(point.x + (tan($ln) * max(0, point.z) + $bw * pow(max(0, point.z) / $S, 2)) * cos($lph), point.y + (tan($ln) * max(0, point.z) + $bw * pow(max(0, point.z) / $S, 2)) * sin($lph), point.z))
  }
}

# ---- BentBar: a bar bent by angle, radius and droop, rooted at z = 0 ----------------------------------------------
# straight for `root` cm, then bent through `angle` round an inner radius of `radius` bar diameters (a kink, not an
# arch), a second bend (`bend2`) in its own plane past the middle of the free part, the free part curling on by `droop`
# degrees; the whole bend plane turned `dir` degrees about +Z. The free end's fate as BarStub. Bends keep arc length.
BentBar = mesh(len=30.0, damage=0.5, age=0.0, noise=1, budget=1, embed=0.2, d=1.27, root=-1.0, angle=-1.0, radius=3.0, dir=-1.0, bend2=-1.0, droop=-1.0, end=-1, shear=-1.0, neck=-1.0, sides=0, ribs=-1, tile=100.0) {
  $L = clamp($len, 3.0, 300.0)
  $E = clamp($embed, 0.2, 200.0)
  $D = clamp($d, 0.6, 3.6)
  $dm = clamp($damage, 0.0, 1.0)
  $ag = clamp($age, 0.0, 1.0)
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $nz = clamp(floor($noise), 1, 99999)
  $k0 = $nz * 1009
  $sd = clamp(ceil($sides - 1 + 0.5), 0, 1) * clamp(floor($sides), 5, 24) + (1 - clamp(ceil($sides - 1 + 0.5), 0, 1)) * (6 + 2 * $bg + 2 * max(0, $bg - 1))
  $rb = clamp(ceil($ribs + 0.5), 0, 1) * clamp($ribs, 0, 1) + (1 - clamp(ceil($ribs + 0.5), 0, 1)) * clamp($bg - 1, 0, 1)
  $q1 = sin(($k0 + 21) * 12.9898 + 0.7) * 43758.5453
  $q1 = $q1 - floor($q1)
  $q2 = sin(($k0 + 22) * 12.9898 + 0.7) * 43758.5453
  $q2 = $q2 - floor($q2)
  $q3 = sin(($k0 + 23) * 12.9898 + 0.7) * 43758.5453
  $q3 = $q3 - floor($q3)
  $q4 = sin(($k0 + 24) * 12.9898 + 0.7) * 43758.5453
  $q4 = $q4 - floor($q4)
  $q5 = sin(($k0 + 25) * 12.9898 + 0.7) * 43758.5453
  $q5 = $q5 - floor($q5)
  $q6 = sin(($k0 + 26) * 12.9898 + 0.7) * 43758.5453
  $q6 = $q6 - floor($q6)
  $q7 = sin(($k0 + 27) * 12.9898 + 0.7) * 43758.5453
  $q7 = $q7 - floor($q7)
  $T = min(3.2 * $D, 0.2 * $L)
  $r0 = clamp(ceil($root + 0.5), 0, 1) * clamp($root, 0.5, 0.4 * $L) + (1 - clamp(ceil($root + 0.5), 0, 1)) * (0.13 * $L * (0.7 + 0.6 * $q1))
  $A1 = clamp(ceil($angle + 0.5), 0, 1) * clamp($angle, 0.0, 150.0) + (1 - clamp(ceil($angle + 0.5), 0, 1)) * ((10.0 + 100.0 * $dm) * (0.75 + 0.5 * $q2))
  $Rc = clamp($radius, 1.0, 10.0) * $D + 0.5 * $D
  $k1 = min(max($Rc * 3.14159 * max($A1, 0.5) / 180.0, 0.4 * $D), 0.45 * $L)
  $R1 = $k1 * 180.0 / (3.14159 * max($A1, 0.01))
  $A2 = clamp(ceil($bend2 + 0.5), 0, 1) * clamp($bend2, 0.0, 120.0) + (1 - clamp(ceil($bend2 + 0.5), 0, 1)) * (70.0 * clamp(($dm - 0.55) / 0.45, 0, 1) * (0.4 + 0.6 * $q3))
  $Ad = clamp(ceil($droop + 0.5), 0, 1) * clamp($droop, 0.0, 60.0) + (1 - clamp(ceil($droop + 0.5), 0, 1)) * (25.0 * $dm * $q4)
  $dr = clamp(ceil($dir + 0.5), 0, 1) * clamp($dir, 0.0, 360.0) + (1 - clamp(ceil($dir + 0.5), 0, 1)) * (360.0 * $q5)
  $ph2 = 60.0 + 240.0 * $q6
  $av = max($L - $r0 - $k1 - $T, 0.3)
  $k2 = min(max($Rc * 3.14159 * max($A2, 0.5) / 180.0, 0.4 * $D), 0.35 * $av)
  $R2 = $k2 * 180.0 / (3.14159 * max($A2, 0.01))
  $fa = 0.45 * ($av - $k2)
  $fb = $av - $k2 - $fa
  $z1 = $r0 + $k1 + $fa
  $z2 = $z1 + $k2
  $Rd = $fb * 180.0 / (3.14159 * max($Ad, 0.01))
  $qe = sin(($k0 + 31) * 12.9898 + 0.7) * 43758.5453
  $qe = $qe - floor($qe)
  $qs = sin(($k0 + 32) * 12.9898 + 0.7) * 43758.5453
  $qs = $qs - floor($qs)
  $qp = sin(($k0 + 33) * 12.9898 + 0.7) * 43758.5453
  $qp = $qp - floor($qp)
  $ee = clamp(floor($end + 0.5), 0, 2)
  $isNk = clamp(ceil($end + 0.5), 0, 1) * (1 - min(abs($ee - 1), 1)) + (1 - clamp(ceil($end + 0.5), 0, 1)) * clamp(ceil(0.15 + 0.35 * $dm - $qe), 0, 1)
  $isSq = clamp(ceil($end + 0.5), 0, 1) * clamp($ee - 1, 0, 1) + (1 - clamp(ceil($end + 0.5), 0, 1)) * clamp(ceil($qe - 1 + 0.35 * (1 - $dm)), 0, 1)
  $isSh = clamp(1 - $isNk - $isSq, 0, 1)
  $sh = clamp(ceil($shear + 0.5), 0, 1) * clamp($shear, 0.0, 60.0) + (1 - clamp(ceil($shear + 0.5), 0, 1)) * (10.0 + 30.0 * $dm * (0.5 + $qs))
  $As = min(tan($sh) * 0.5 * $D, 0.06 * $T)
  $ph = 360.0 * $qp
  $cph = cos($ph)
  $sph = sin($ph)
  $nk = clamp(ceil($neck + 0.5), 0, 1) * clamp($neck, 0.0, 0.6) + (1 - clamp(ceil($neck + 0.5), 0, 1)) * (0.25 + 0.2 * $dm)
  $NL = min(2.0 * $D, $T)
  $jg = min(0.22 * $D, 0.028 * $T)
  if ($bg > 1.5) {
    circle(radius=$D * 0.5, segments=$sd)
    sweep(along=$BentPath2)
  } else {
    if ($bg > 0.5) {
      circle(radius=$D * 0.5, segments=$sd)
      sweep(along=$BentPath1)
    } else {
      circle(radius=$D * 0.5, segments=$sd)
      sweep(along=$BentPath0)
    }
  }
  material($Steel)
  material($SteelCut) [top]
  material($SteelCut) [bottom]
  warp(to=(point.x, point.y, 0.0 - $E + $E * clamp(point.z, 0, 8) / 8.0 + $r0 * clamp(point.z - 8.0, 0, 12) / 12.0 + $k1 * clamp(point.z - 20.0, 0, 25) / 25.0 + $fa * clamp(point.z - 45.0, 0, 15) / 15.0 + $k2 * clamp(point.z - 60.0, 0, 15) / 15.0 + $fb * clamp(point.z - 75.0, 0, 17) / 17.0 + $T * clamp(point.z - 92.0, 0, 8) / 8.0))
  uv(cylinder, at=(0.0, 0.0, 0.0), facing=(0.0, 0.0, 1.0), up=(1.0, 0.0, 0.0), scale=($tile, $tile))
  if ($ag + $rb > 0) {
    warp(to=(point.x * (1 - 0.08 * $ag) * (1 + 0.12 * $ag * clamp($bg, 0, 1) * sin(point.x * 4111.3 + point.y * 2309.7 + point.z * 977.1 + $k0)) * (1 + 0.12 * $rb * pow(max(0, cos(360 * point.z / (2.5 * $D))), 8)), point.y * (1 - 0.08 * $ag) * (1 + 0.12 * $ag * clamp($bg, 0, 1) * sin(point.x * 4111.3 + point.y * 2309.7 + point.z * 977.1 + $k0)) * (1 + 0.12 * $rb * pow(max(0, cos(360 * point.z / (2.5 * $D))), 8)), point.z))
  }
  if ($isSh > 0.5) {
    warp(to=(point.x + 0.1 * $D * $cph * clamp((point.z - ($L - 0.14 * $T)) / (0.07 * $T), 0, 1), point.y + 0.1 * $D * $sph * clamp((point.z - ($L - 0.14 * $T)) / (0.07 * $T), 0, 1), point.z + $As * (point.x * $cph + point.y * $sph) / (0.5 * $D) * clamp((point.z - ($L - 0.07 * $T)) / (0.07 * $T), 0, 1)))
  }
  if ($isNk > 0.5) {
    warp(to=(point.x * (1 - $nk * pow(clamp((point.z - $L + $NL) / $NL, 0, 1), 2) * (3 - 2 * clamp((point.z - $L + $NL) / $NL, 0, 1))) * (1 - 0.5 * clamp((point.z - ($L - 0.035 * $T)) / (0.035 * $T), 0, 1)), point.y * (1 - $nk * pow(clamp((point.z - $L + $NL) / $NL, 0, 1), 2) * (3 - 2 * clamp((point.z - $L + $NL) / $NL, 0, 1))) * (1 - 0.5 * clamp((point.z - ($L - 0.035 * $T)) / (0.035 * $T), 0, 1)), point.z + $jg * sin(point.x * 5171.3 + point.y * 3113.9 + $k0) * clamp((point.z - ($L - 0.035 * $T)) / (0.035 * $T), 0, 1)))
  }
  # the bends, the free end first (each turns everything beyond it rigidly): droop, second bend, first bend
  if ($Ad > 0.5) {
    warp(to=(($Rd * (1 - cos(($Ad * clamp((point.z - $z2) / $fb, 0, 1)))) + point.x * cos(($Ad * clamp((point.z - $z2) / $fb, 0, 1))) + max(0, point.z - $z2 - $fb) * sin($Ad)), point.y, (min(point.z, $z2) + $Rd * sin(($Ad * clamp((point.z - $z2) / $fb, 0, 1))) - point.x * sin(($Ad * clamp((point.z - $z2) / $fb, 0, 1))) + max(0, point.z - $z2 - $fb) * cos($Ad))))
  }
  if ($A2 > 0.5) {
    warp(to=(($R2 * (1 - cos(($A2 * clamp((point.z - $z1) / $k2, 0, 1)))) + (point.x * cos($ph2) + point.y * sin($ph2)) * cos(($A2 * clamp((point.z - $z1) / $k2, 0, 1))) + max(0, point.z - $z1 - $k2) * sin($A2)) * cos($ph2) - (point.y * cos($ph2) - point.x * sin($ph2)) * sin($ph2), ($R2 * (1 - cos(($A2 * clamp((point.z - $z1) / $k2, 0, 1)))) + (point.x * cos($ph2) + point.y * sin($ph2)) * cos(($A2 * clamp((point.z - $z1) / $k2, 0, 1))) + max(0, point.z - $z1 - $k2) * sin($A2)) * sin($ph2) + (point.y * cos($ph2) - point.x * sin($ph2)) * cos($ph2), (min(point.z, $z1) + $R2 * sin(($A2 * clamp((point.z - $z1) / $k2, 0, 1))) - (point.x * cos($ph2) + point.y * sin($ph2)) * sin(($A2 * clamp((point.z - $z1) / $k2, 0, 1))) + max(0, point.z - $z1 - $k2) * cos($A2))))
  }
  if ($A1 > 0.5) {
    warp(to=(($R1 * (1 - cos(($A1 * clamp((point.z - $r0) / $k1, 0, 1)))) + point.x * cos(($A1 * clamp((point.z - $r0) / $k1, 0, 1))) + max(0, point.z - $r0 - $k1) * sin($A1)), point.y, (min(point.z, $r0) + $R1 * sin(($A1 * clamp((point.z - $r0) / $k1, 0, 1))) - point.x * sin(($A1 * clamp((point.z - $r0) / $k1, 0, 1))) + max(0, point.z - $r0 - $k1) * cos($A1))))
  }
  warp(to=(point.x * cos($dr) - point.y * sin($dr), point.x * sin($dr) + point.y * cos($dr), point.z))
}
