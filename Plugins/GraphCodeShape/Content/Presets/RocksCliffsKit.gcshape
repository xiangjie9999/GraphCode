gcshape 1  into:/Game/GraphCodeMarket/GraphCode/RocksCliffsKit  smooth:0.2  shade:40

# 1.0.2 (23 Nov 2026): wears the RockMaterials pack (Codex granite and limestone); photographs show the textured meshes.
# 1.0.1 (23 Nov 2026): real material renders and per-mesh gallery.
# ROCKS AND CLIFFS (23 Nov 2026; owner: "keep going, vegetations, rocks, cliffs"). Recipe on the shipped Stone
# preset: one parametric stone (joint sets, weathering, splits, rounding, relief), assembled here into the big forms a
# game level needs - a CLIFF (rows of jointed blocks, strata stepping in and out), an OUTCROP (boulders of one rock,
# their joints aligned, sunk into the ground), and the loose pieces a PCG graph scatters as SCREE at a cliff's foot.
# Every feature a knob. Frame: z up; a cliff's face looks toward -Y, its back is flat at y = +depth/2, it stands on z = 0.
# MATERIALS: boulders, outcrop and scree wear granite, cliffs wear limestone (RockMaterials pack; also granite with lichen and layered sandstone there). Pass your own with shape(..., Face = $Rock).

build {
  SM_Rock_Cliff_Wide = $DemoCliffWide [pivot=(0, 0, 0), triangles=150000]
  SM_Rock_Cliff_Tall = $DemoCliffTall [pivot=(0, 0, 0), triangles=150000]
  SM_Rock_Cliff_Ledges = $DemoCliffLedges [pivot=(0, 0, 0), triangles=150000]
  SM_Rock_Outcrop = $DemoOutcrop [pivot=(0, 0, 0)]
  SM_Rock_Boulder_Large = $DemoBoulderLarge [pivot=(0, 0, 0)]
  SM_Rock_Scree_A = $DemoScreeA [pivot=(0, 0, 0)]
  SM_Rock_Scree_B = $DemoScreeB [pivot=(0, 0, 0)]
  SM_Rock_Scree_C = $DemoScreeC [pivot=(0, 0, 0)]
  SM_Rock_Scree_D = $DemoScreeD [pivot=(0, 0, 0)]
  SM_Rock_Scree_E = $DemoScreeE [pivot=(0, 0, 0)]
  SM_Rock_Scree_F = $DemoScreeF [pivot=(0, 0, 0)]
}

RockFace = material('/Game/GraphCodeMarket/GraphCode/RockMaterials/Materials/MI_Rock_Granite')
RockBroken = material('/Game/GraphCodeMarket/GraphCode/RockMaterials/Materials/MI_Rock_Granite')
CliffStone = material('/Game/GraphCodeMarket/GraphCode/RockMaterials/Materials/MI_Rock_Limestone')
S = shape('/GraphCodeShape/Presets/Stone', Face = $RockFace, Broken = $RockBroken)

# CLIFF (r3, 23 Nov; critic r2 "brick walls of loaf blocks", critic r2-rocks "a uniform stacked-slab wall"): a cliff is ONE
# mass of BEDS cut by JOINTS, as the photos show it (02, 03, 13):
# - BEDS rest on one another, vary in thickness (some split by a thin parting), PINCH along the face (each bed boundary
#   has its own slope), and the whole stack DIPS;
# - JOINTS belong to SETS that run up through every bed: a near-vertical set every `jspace` cm (each joint one line
#   for the whole cliff, leaning within +-`lean` deg) and an oblique set of up to `obl` through-going joints at `lean2`
#   deg, one sense per cliff; in each bed a joint may close (`persist`), so blocks there are longer;
# - the FACE swings in plan into buttresses and re-entrants (`sway` cm, one pattern for every bed so they run up the
#   cliff), each bed steps by `recess`, each block juts and tilts; a fallen block leaves a deep scar.
# A joint is an open crack `jgap` wide; behind the blocks every bed is one continuous slab (CliffBed).
# COST (owner 23 Nov "remember pcg and optimisation"): no fine-grain roughen (the rock texture carries grain; it was
# ~60 % of the triangles, much of it on hidden bed backs); each cliff build line carries a `triangles=` ceiling.

# CLIFF BED: the continuous slab of one stratum, `w` along the face, `d` deep, between a bottom `za + sa*x` and a top
# `zb + sb*x` (a bed thins and thickens along the face); its skin is broken rock (its flanks and crown are seen)
CliffBed = mesh(w=1200, d=200, za=0, sa=0, zb=120, sb=0, rough=3, noise=1) {
  rect(w=$w, h=$d)
  extrude(height=1)
  warp(to=(point.x, point.y, $za + $sa * point.x + point.z * ($zb + $sb * point.x - $za - $sa * point.x)))
  $m = min($zb - $za, $d)
  roughen(by=max($rough, 0.07 * $m), scale=clamp(0.8 * $m, 40, 260), seed=$noise, form=faceted) [!bottom]
  material($CliffStone)
}

# CLIFF FACE: one joint-bounded block, drawn in ELEVATION (x along the face, z up) by its four corners (bottom-left,
# bottom-right, top-right, top-left), standing `dep` cm out from its back at y = 0 toward -Y. The face tilts a little
# (`ta` across, `tb` up: + leans back), its arrises are worn round by `round` cm, its skin broken in one to three big
# planes about the block's own size (r2: a smaller field broke it into shards) and a faint fine grain.
CliffFace = mesh(x0b=-100, z0b=0, x1b=100, z1b=0, x1t=100, z1t=120, x0t=-100, z0t=120, dep=40, ta=0, tb=0, round=3, rough=4, noise=1) {
  points(($x0b, $z0b), ($x1b, $z1b), ($x1t, $z1t), ($x0t, $z0t), loop=true)
  extrude(height=$dep)
  warp(to=(point.x, -1 * point.z, point.y))
  $xc = 0.25 * ($x0b + $x1b + $x0t + $x1t)
  $zc = 0.25 * ($z0b + $z1b + $z1t + $z0t)
  warp(to=(point.x, point.y - point.y / $dep * ($ta * (point.x - $xc) + $tb * (point.z - $zc)), point.z))
  round($round) [top]
  $m = min(0.5 * ($x1b - $x0b + $x1t - $x0t), 0.5 * ($z0t - $z0b + $z1t - $z1b))
  roughen(by=max($rough, 0.06 * $m), scale=clamp(0.9 * $m, 40, 260), seed=$noise, form=faceted) [!bottom]
  material($CliffStone)
}

# CLIFF ROW: the blocks of one bed (or of one leaf of a split bed) between `za + sa*x` and `zb + sb*x`, its ends at
# -`we0` and +`we1`. Joint j (0..J) is the cliff's own (seeded by `kg`, the same line in every row); joints 0 and J are
# the row's ends. A joint CLOSES in this row unless it persists (seeded by `kr`), never two in a row, and a block runs
# from an open joint to the next open one. `yc` is the bed slab's face, `yf` this row's mean face line, `fall` the
# chance a block has fallen, `top` makes the crown ragged.
CliffRow = mesh(w=1200, h=600, J=8, za=0, sa=0, zb=120, sb=0, we0=600, we1=600, yc=60, yf=-30, sway=40, ph1=0, ph2=0, jut=25, jgap=4, lean=7, tob=35, obl=0, persist=0.75, fall=0, top=0, round=3, rough=4, kr=1, kg=1) {
  $zm = 0.5 * ($za + $zb)
  $sp = $w / $J
  $no = max($obl, 1)
  # the oblique set's lines at this row's mid height (each line is fixed at the cliff's mid height and leans `tob`)
  # each oblique joint its own angle, 0.75-1.25 of `lean2` (owner 23 Nov: real joints are not evenly cut)
  $o1 = $tob * (0.75 + 0.5 * random(seed=$kg + 711, min=0, max=1))
  $o2 = $tob * (0.75 + 0.5 * random(seed=$kg + 712, min=0, max=1))
  $o3 = $tob * (0.75 + 0.5 * random(seed=$kg + 713, min=0, max=1))
  $q1 = -0.5 * $w + $w * (0.5 + 0.3 * (random(seed=$kg + 701, min=0, max=1) - 0.5)) / $no + ($zm - 0.5 * $h) * tan($o1)
  $q2 = -0.5 * $w + $w * (1.5 + 0.3 * (random(seed=$kg + 702, min=0, max=1) - 0.5)) / $no + ($zm - 0.5 * $h) * tan($o2)
  $q3 = -0.5 * $w + $w * (2.5 + 0.3 * (random(seed=$kg + 703, min=0, max=1) - 0.5)) / $no + ($zm - 0.5 * $h) * tan($o3)
  loop ($J) {
    $i = output.index
    $k0 = $kr * 3 + 31 * ($i - 2)
    $k0 = $k0 - 99991 * floor($k0 / 99991)
    $k1 = $kr * 3 + 31 * ($i - 1)
    $k1 = $k1 - 99991 * floor($k1 / 99991)
    $k2 = $kr * 3 + 31 * $i
    $k2 = $k2 - 99991 * floor($k2 / 99991)
    # open in this row? (the ends always; a joint after a closed one always)
    $p0 = 0
    if (random(seed=$k0, min=0, max=1) < $persist) {
      $p0 = 1
    }
    if ($i < 2.5) {
      $p0 = 1
    }
    $p1 = 0
    if (random(seed=$k1, min=0, max=1) < $persist) {
      $p1 = 1
    }
    if ($i < 1.5) {
      $p1 = 1
    }
    $p2 = 0
    if (random(seed=$k2, min=0, max=1) < $persist) {
      $p2 = 1
    }
    if ($i > $J - 0.5) {
      $p2 = 1
    }
    $P1 = max($p1, 1 - $p0)
    $P2 = max($p2, 1 - $p1)
    $jr = $i
    if ($P2 < 0.5) {
      $jr = $i + 1
    }
    if ($P1 > 0.5) {
      # LEFT JOINT i - 1
      $kj = $kg + 211 * ($i - 1)
      $kj = $kj - 99991 * floor($kj / 99991)
      $xl = -0.5 * $w + $sp * ($i - 1 + 0.6 * (random(seed=$kj, min=0, max=1) - 0.5))
      $tl = 2 * $lean * (random(seed=$kj + 1, min=0, max=1) - 0.5)
      if ($obl > 0.5) {
        if (($q1 - $xl) * ($q1 - $xl) < 0.25 * $sp * $sp) {
          $xl = $q1
          $tl = $o1
        }
      }
      if ($obl > 1.5) {
        if (($q2 - $xl) * ($q2 - $xl) < 0.25 * $sp * $sp) {
          $xl = $q2
          $tl = $o2
        }
      }
      if ($obl > 2.5) {
        if (($q3 - $xl) * ($q3 - $xl) < 0.25 * $sp * $sp) {
          $xl = $q3
          $tl = $o3
        }
      }
      if ($i < 1.5) {
        $xl = -1 * $we0
        $tl = 0
      }
      # RIGHT JOINT jr
      $kj = $kg + 211 * $jr
      $kj = $kj - 99991 * floor($kj / 99991)
      $xr = -0.5 * $w + $sp * ($jr + 0.6 * (random(seed=$kj, min=0, max=1) - 0.5))
      $tr = 2 * $lean * (random(seed=$kj + 1, min=0, max=1) - 0.5)
      if ($obl > 0.5) {
        if (($q1 - $xr) * ($q1 - $xr) < 0.25 * $sp * $sp) {
          $xr = $q1
          $tr = $o1
        }
      }
      if ($obl > 1.5) {
        if (($q2 - $xr) * ($q2 - $xr) < 0.25 * $sp * $sp) {
          $xr = $q2
          $tr = $o2
        }
      }
      if ($obl > 2.5) {
        if (($q3 - $xr) * ($q3 - $xr) < 0.25 * $sp * $sp) {
          $xr = $q3
          $tr = $o3
        }
      }
      if ($jr > $J - 0.5) {
        $xr = $we1
        $tr = 0
      }
      $x0b = $xl + ($za - $zm) * tan($tl) + 0.5 * $jgap
      $x0t = $xl + ($zb - $zm) * tan($tl) + 0.5 * $jgap
      $x1b = max($xr + ($za - $zm) * tan($tr) - 0.5 * $jgap, $x0b + 20)
      $x1t = max($xr + ($zb - $zm) * tan($tr) - 0.5 * $jgap, $x0t + 20)
      $kf = $k2 + 11
      if (random(seed=$kf, min=0, max=1) >= $fall) {
        # the bedding crack above it: mostly tight, now and then wide open (photo 13); the crown ragged
        $g = random(seed=$kf + 5, min=0, max=1)
        $tg = $jgap * (0.2 + 2.5 * $g * $g)
        $z0b = $za + $sa * $x0b
        $z1b = $za + $sa * $x1b
        $z0t = max($zb + $sb * $x0t - $tg, $z0b + 12)
        $z1t = max($zb + $sb * $x1t - $tg, $z1b + 12)
        if ($top > 0.5) {
          $z0t = $z0b + (0.5 + 0.55 * $g) * ($zb + $sb * $x0t - $z0b)
          $z1t = $z1b + (0.5 + 0.55 * $g) * ($zb + $sb * $x1t - $z1b)
        }
        # its place in the face: the cliff's sway (buttress or re-entrant) less its own jut
        $xc = 0.25 * ($x0b + $x1b + $x0t + $x1t)
        $front = $yf + $sway * (0.6 * sin(360 * $xc / 560 + $ph1) + 0.4 * sin(360 * $xc / 230 + $ph2)) - $jut * random(seed=$kf + 1, min=0, max=1)
        $dep = $yc + 5 - $front
        $L = 0.5 * ($x1b - $x0b + $x1t - $x0t)
        $H = 0.5 * ($z0t - $z0b + $z1t - $z1b)
        $ta = (random(seed=$kf + 2, min=0, max=1) - 0.5) * min(0.5, 0.6 * $dep / $L)
        $tb = (random(seed=$kf + 3, min=0, max=1) - 0.5) * min(0.6, 0.6 * $dep / $H)
        add($CliffFace, x0b=$x0b, z0b=$z0b, x1b=$x1b, z1b=$z1b, x1t=$x1t, z1t=$z1t, x0t=$x0t, z0t=$z0t, dep=$dep, ta=$ta, tb=$tb, round=$round, rough=$rough, noise=$kf + 4, at=(0, $yc + 5, 0), join=none)
      }
    }
  }
}

# CLIFF: `rows` beds over `h`, `w` wide, `d` deep. Bed thickness varies 0.55-1.45x, each boundary sloping so beds pinch
# along the face, and `split` of them carry a thin parting (two leaves). Each bed steps by up to `recess` cm, beds lean
# back `batter` deg, the cliff narrows toward the top by `taper` of its width (0.25: top 0.75 of base), and the whole
# stack dips `dip` deg along the face (the lowest bed reaching under the ground at the low end, so the module stands
# on z = 0). Joints: `jspace`, `lean`, `lean2`, `obl`, `persist` (above); `gaps` of the upper blocks have fallen.
Cliff = mesh(w=1200, h=600, d=300, rows=5, jspace=150, recess=60, jut=25, batter=8, taper=0, gaps=0.08, jdepth=30, jgap=4, lean=7, lean2=35, obl=0, persist=0.75, split=0.35, sway=40, dip=8, round=3, rough=4, noise=1) {
  $hr = $h / $rows
  $J = clamp(floor($w / $jspace + 0.5), 2, 40)
  $kg = $noise * 7919 + 13
  $kg = $kg - 99991 * floor($kg / 99991)
  $tob = $lean2
  if (random(seed=$kg + 3, min=0, max=1) < 0.5) {
    $tob = -1 * $lean2
  }
  $ph1 = 360 * random(seed=$kg + 5, min=0, max=1)
  $ph2 = 360 * random(seed=$kg + 6, min=0, max=1)
  loop ($rows) {
    $r = output.index
    # each bed BOUNDARY is its own seed (height and slope), so a bed knows its bottom and top without a running sum
    $kb0 = $noise * 1009 + 101 * $r
    $kb0 = $kb0 - 99991 * floor($kb0 / 99991)
    $kb1 = $noise * 1009 + 101 * ($r + 1)
    $kb1 = $kb1 - 99991 * floor($kb1 / 99991)
    $z0 = $hr * ($r - 1) + 0.45 * $hr * (random(seed=$kb0, min=0, max=1) - 0.5)
    $z1 = $hr * $r + 0.45 * $hr * (random(seed=$kb1, min=0, max=1) - 0.5)
    $s0 = $hr / $w * (random(seed=$kb0 + 1, min=0, max=1) - 0.5)
    $s1 = $hr / $w * (random(seed=$kb1 + 1, min=0, max=1) - 0.5)
    if ($r < 1.5) {
      $z0 = -0.5 * $w * tan($dip)
      $s0 = 0
    }
    $top = 0
    if ($r > $rows - 0.5) {
      $z1 = $h
      $s1 = 0
      $top = 1
    }
    $zm = 0.5 * ($z0 + $z1)
    $kr = $kb0 + 7
    # the bed's ends staggered so the cliff's flanks step
    $we0 = 0.5 * $w * (0.93 + 0.07 * random(seed=$kr + 5, min=0, max=1))
    $we1 = 0.5 * $w * (0.93 + 0.07 * random(seed=$kr + 6, min=0, max=1))
    # the bed's mean face line (its own step plus the batter) and its slab's face, behind the deepest re-entrant
    $yf = -0.5 * $d + $recess * (random(seed=$kr, min=0, max=1) - 0.5) + $zm * tan($batter)
    $yc = $yf + $jdepth + $sway
    $yb = max(0.5 * $d, $yc + 40)
    $ct = 1 - 0.45 * $top
    add($CliffBed, w=$we0 + $we1, d=$yb - $yc, za=$z0, sa=$s0, zb=$z0 + $ct * ($z1 - $z0), sb=$s0 + $ct * ($s1 - $s0), rough=$rough, noise=$kr + 1, at=(0.5 * ($we1 - $we0), 0.5 * ($yc + $yb), 0), join=none)
    $fall = 0
    if ($r > 1) {
      $fall = $gaps * ($r - 1) / max($rows - 1, 1) * 2
    }
    if (random(seed=$kr + 9, min=0, max=1) < $split) {
      # a thin parting splits the bed into two leaves, each its own row of blocks
      $f = 0.6 + 0.25 * random(seed=$kr + 10, min=0, max=1)
      $zp = $z0 + $f * ($z1 - $z0)
      $spp = $s0 + $f * ($s1 - $s0)
      add($CliffRow, w=$w, h=$h, J=$J, za=$z0, sa=$s0, zb=$zp, sb=$spp, we0=$we0, we1=$we1, yc=$yc, yf=$yf, sway=$sway, ph1=$ph1, ph2=$ph2, jut=$jut, jgap=$jgap, lean=$lean, tob=$tob, obl=$obl, persist=$persist, fall=$fall, top=0, round=$round, rough=$rough, kr=$kr, kg=$kg, join=none)
      add($CliffRow, w=$w, h=$h, J=$J, za=$zp, sa=$spp, zb=$z1, sb=$s1, we0=$we0, we1=$we1, yc=$yc, yf=$yf + 0.3 * $jut, sway=$sway, ph1=$ph1, ph2=$ph2, jut=$jut, jgap=$jgap, lean=$lean, tob=$tob, obl=$obl, persist=0.5 * $persist, fall=$fall, top=$top, round=$round, rough=$rough, kr=$kr + 50, kg=$kg, join=none)
    } else {
      add($CliffRow, w=$w, h=$h, J=$J, za=$z0, sa=$s0, zb=$z1, sb=$s1, we0=$we0, we1=$we1, yc=$yc, yf=$yf, sway=$sway, ph1=$ph1, ph2=$ph2, jut=$jut, jgap=$jgap, lean=$lean, tob=$tob, obl=$obl, persist=$persist, fall=$fall, top=$top, round=$round, rough=$rough, kr=$kr, kg=$kg, join=none)
    }
  }
  # the taper (the top narrower), then the dip (every bed tilts along the face, the high end at +X)
  warp(to=(point.x * (1 - $taper * point.z / $h), point.y, point.z))
  warp(to=(point.x, point.y, point.z + point.x * tan($dip)))
  uv(box, scale=150)
}

# OUTCROP (r2; critic r2 and photos 07/08: one big stone leads, the rest crowd it): a DOMINANT boulder `size` cm at
# the middle and `n - 1` smaller ones (`minor` of its size, varied +-35 %) round it, each set against it so they touch
# and leaning in toward it up to `tilt` deg; all of one rock, sunk `bury` of their height (bedrock showing). The
# dominant's long axis lies along `strike` deg.
Outcrop = mesh(n=6, size=300, minor=0.42, tilt=18, strike=20, bury=0.28, round=0.65, noise=1, budget=0) {
  $R0 = 0.5 * 0.72 * $size
  add($S.Stone, size=$size, width=0.72, height=0.55, joints=3, jspace=0.55, jtilt=15, jdip=65, breaks=4, abrade=0.7, faces=6, even=80, vary=0.2, split=1, depth=0.12, round=0.55 * $round, fresh=0.35, wear=0.08, cover=0.6, chips=0.25, bed=0.12, seat=0.35, base=0, lean=0.06, lumps=0.05, rough=0.008, grain=0.4, noise=$noise, budget=$budget, at=(0, 0, -1 * $bury * 0.55 * $size), rotate=(0, 0, $strike), join=none)
  loop ($n - 1) {
    $i = output.index
    $k = $noise * 1009 + 37 * $i
    $k = $k - 99991 * floor($k / 99991)
    $s = $minor * $size * (0.65 + 0.7 * random(seed=$k, min=0, max=1))
    $ht = 0.6 * $s
    $a = 360 * $i / ($n - 1) + 40 * (random(seed=$k + 3, min=0, max=1) - 0.5)
    # against the dominant: its half-width (longer along the strike) plus half this stone's own and a 5-15 cm gap
    # (r2 critic: at 0.4 of its own size most of them sank inside the dominant and the outcrop read as one blob)
    $rr = $R0 * (1 + 0.45 * cos($a - $strike) * cos($a - $strike)) + 0.5 * $s + 5 + 10 * random(seed=$k + 5, min=0, max=1)
    $bu = $bury * (0.75 + 0.5 * random(seed=$k + 4, min=0, max=1))
    add($S.Stone, size=$s, width=0.75, height=0.6, joints=3, jspace=0.55, jtilt=15, jdip=65, breaks=4, abrade=0.7, faces=6, even=80, vary=0.2, split=0, round=$round, fresh=0.2, wear=0.08, cover=0.6, chips=0.25, bed=0.12, seat=0.35, base=0, lean=0.06, lumps=0.05, rough=0.008, grain=0.4, noise=$k + 1, budget=$budget, at=($rr * cos($a), $rr * sin($a), -1 * $bu * $ht), rotate=(0, $tilt * (0.5 + 0.5 * random(seed=$k + 2, min=0, max=1)), $a), join=none)
  }
  uv(keep)
}

# SCREE PIECE: a fresh angular fragment fallen from a cliff: split, sharp, little worn, PLATY (critic r2: scree is
# slabs and flakes, not lumps) - `flat` is its thickness against its length
Scree = mesh(size=25, flat=0.32, noise=1, budget=0) {
  add($S.Stone, size=$size, width=0.55 + 0.25 * random(seed=$noise + 3, min=0, max=1), height=$flat, joints=3, jspace=0.6, jtilt=10, jdip=75, breaks=3, faces=6, even=65, vary=0.3, split=2, depth=0.2, round=0.1, fresh=1, wear=0.02, cover=0.5, chips=0.5, bed=0.08, seat=0.8, base=0, lean=0.08, lumps=0.01, rough=0.012, grain=1, noise=$noise, budget=$budget, join=none)
}

#   KitCliff(width cm 200-4000, height cm 100-3000, depth cm 80-800, rows 1-20 beds, jspace cm 40-800 between the
#            upright joints, recess cm a bed steps in/out, jut cm a block stands proud, batter 0-30 deg, taper 0-0.6
#            the top narrows, gaps 0-0.4 fallen blocks, jdepth cm 5-120 a joint's depth, jgap cm 0-20 its opening,
#            lean 0-20 deg the upright set's spread, lean2 0-60 deg the oblique set (each joint 0.75-1.25x),
#            obl 0-3 oblique joints (0, the default: none - declare them where the rock has them),
#            persist 0.3-1 how many joints stay open in a bed, split 0-1 beds with a parting, sway cm 0-300
#            buttresses, dip 0-35 deg the beds tilt along the face, round cm 0-30 arris wear, rough cm 0-30 relief,
#            noise)
KitCliff = mesh(width=1200, height=600, depth=300, rows=5, jspace=150, recess=60, jut=25, batter=8, taper=0, gaps=0.08, jdepth=30, jgap=4, lean=7, lean2=35, obl=0, persist=0.75, split=0.35, sway=40, dip=8, round=3, rough=4, noise=1) {
  add($Cliff, w=clamp($width, 200, 4000), h=clamp($height, 100, 3000), d=clamp($depth, 80, 800), rows=clamp(floor($rows + 0.5), 1, 20), jspace=clamp($jspace, 40, 800), recess=clamp($recess, 0, 400), jut=clamp($jut, 0, 200), batter=clamp($batter, 0, 30), taper=clamp($taper, 0, 0.6), gaps=clamp($gaps, 0, 0.4), jdepth=clamp($jdepth, 5, 120), jgap=clamp($jgap, 0, 20), lean=clamp($lean, 0, 20), lean2=clamp($lean2, 0, 60), obl=clamp(floor($obl + 0.5), 0, 3), persist=clamp($persist, 0.3, 1), split=clamp($split, 0, 1), sway=clamp($sway, 0, 300), dip=clamp($dip, 0, 35), round=clamp($round, 0, 30), rough=clamp($rough, 0, 30), noise=$noise, join=none)
  uv(keep)
}

#   KitOutcrop(count 1-20 stones, size cm 30-600 the dominant one, minor 0.15-0.9 the others against it, tilt 0-40 deg
#              they lean in, strike deg, bury 0-0.7, round 0-1, noise, budget)
KitOutcrop = mesh(count=6, size=300, minor=0.42, tilt=18, strike=20, bury=0.28, round=0.65, noise=1, budget=0) {
  add($Outcrop, n=clamp(floor($count + 0.5), 2, 20), size=clamp($size, 30, 600), minor=clamp($minor, 0.15, 0.9), tilt=clamp($tilt, 0, 40), strike=$strike, bury=clamp($bury, 0, 0.7), round=clamp($round, 0, 1), noise=$noise, budget=clamp(floor($budget + 0.5), -1, 2), join=none)
  uv(keep)
}

DemoCliffWide = mesh() { add($KitCliff, width=1200, height=600, depth=300, rows=5, jspace=160, recess=80, obl=2, sway=55, dip=10, noise=3, join=none)  uv(keep) }
DemoCliffTall = mesh() { add($KitCliff, width=600, height=1100, depth=350, rows=8, jspace=140, recess=50, batter=5, taper=0.25, obl=1, sway=40, dip=4, noise=5, join=none)  uv(keep) }
DemoCliffLedges = mesh() { add($KitCliff, width=1000, height=500, depth=400, rows=6, jspace=180, recess=140, jut=35, batter=12, gaps=0.15, split=0.5, sway=30, dip=2, round=5, noise=7, join=none)  uv(keep) }
DemoOutcrop = mesh() { add($KitOutcrop, count=8, size=300, bury=0.28, noise=9, join=none)  uv(keep) }
DemoBoulderLarge = mesh() { add($S.Boulder, size=260, noise=11, budget=0, join=none)  uv(keep) }
# SCREE (critic r2: six or more platy pieces in a power-law size mix; the PCG graph weights the small ones heavier)
DemoScreeA = mesh() { add($Scree, size=9, flat=0.3, noise=13, join=none)  uv(keep) }
DemoScreeB = mesh() { add($Scree, size=15, flat=0.25, noise=15, join=none)  uv(keep) }
DemoScreeC = mesh() { add($Scree, size=24, flat=0.35, noise=17, join=none)  uv(keep) }
DemoScreeD = mesh() { add($Scree, size=36, flat=0.28, noise=19, join=none)  uv(keep) }
DemoScreeE = mesh() { add($Scree, size=55, flat=0.38, noise=21, join=none)  uv(keep) }
DemoScreeF = mesh() { add($Scree, size=85, flat=0.42, noise=23, join=none)  uv(keep) }
