R8 = plane() { points((0, 0, 0), (0, 12.5, 0), (0, 25, 0), (0, 37.5, 0), (0, 50, 0), (0, 62.5, 0), (0, 75, 0), (0, 87.5, 0), (0, 100, 0)) }
