gcshape 1  into:/GraphCodeShape/Presets  smooth:0.1  shade:40

# RUBBLE — the debris lane's pile composer (L4: imports the L2 pieces and the L3 assemblies; Docs/GC-SHAPE-DEBRIS-LANE.md
# §3 and its lead rulings; judged on "Addendum: debris piles and pieces" of GC-SHAPE-CONCRETE-DAMAGE-CRITIC.md, numbers
# from Research/debris-that-reads-real.md). GENERATED by Content/__MCPTests/DamageKit/gen/debris/gendebris.py: edit the generator, not this file.
#
#   RB = shape('/GraphCodeShape/Presets/Rubble', Face = $MyCast, Broken = $MyAggregate, Steel = $MyRebar, SteelCut = $MyBrightSteel)
#   Heap = mesh() { add($RB.Pile, area=160, damage=0.7, noise=4) }
#   SlabDebris = mesh() { add($RB.Pile, volume=$HoleVolume * 0.7, area=200, noise=17) }   # a subject's _Debris line
#
# HOW A PILE IS MADE: a low irregular BED of fines (the lower third of a heap is half buried in fines; finer than
# about 2-3 cm is the bed's texture, not geometry) is laid at the source; the pieces are dropped by size class onto
# it and onto an elongated ground round it, largest first, each lifted until it rests on what it meets
# (`collide=stack`), tumbled by a drawn turn and sunk `settle` of its height into what it lands on. The classes halve
# in size from the biggest (`size` cm, or sized from `volume`): PLATES (t/w 0.12-0.25), LARGE chunks (`rchunk` of
# them reinforced: bars stand out of about 1 in 3), MID chunks with a share of thin plates (half of those leaning
# steeply), SMALL chunks and FINES (plain few-faced chunks: cheap, they read as texture at range); each class holds
# 2^`grading` times the pieces of the class above (1.5: about 2.8 times per halving, the biggest class carrying the most
# volume), and a few LOOSE BENT BARS lie in the gaps. Big and large pieces stay on the bed near the source (`cluster`);
# small pieces and fines run out in a thin tail `tail` times the heap's width, elongated along +X (the lost member's
# direction); the grounds are deleted after the drop, so no hard edge is left. Every piece draws its own `noise`.
# SLOTS (pathless, bind at import): `Face`, `Broken`, `Steel`, `SteelCut`.
#   STATES AND TIERS: every piece ships three build lines from one recipe (kit §12.1, §8a.6: the budget is the author's,
#   no ceiling): `_Game` (`budget=0`), `_High` (`budget=1`), `_Ultra` (`budget=2`). Pass any `budget` and your own
#   `[triangles=]` for another weight.
#   SAFE TO TURN (kit §11a): every knob is clamped to the range stated beside it inside the recipe, so a value past it
#   builds the nearest good piece, never a broken mesh. A knob written -1 is AUTO: drawn from `noise` (and `damage`).
#   SEED: `noise` (`seed=` is reserved on add); every draw is a sine hash keyed `noise * 1009 + k`, so an edit above an
#   entry never re-rolls it.
#
# TOP-LEVEL KNOBS (the same names in every kit file), then ADVANCED:
#   Pile(area, damage, age, noise, budget | count, volume, size, big, grading, settle, cluster, tail, rchunk, bars, fines, bed, tile)
# meaning, unit, range [clamp], default:
#   area    cm, the longest extent the pile may cover (tail included)            [40, 800]  140
#   damage  passed to every piece: how broken the chunks, how bent the bars    [0, 1]     0.5
#   age     passed to every piece: worn concrete, rusted steel                  [0, 1]     0
#   noise   the seed                                                             [1, 99999] 1
#   budget  0 game, 1 high, 2 ultra (the small class and the fines stay plain at every budget)   [0, 2]  0
#   count   pieces in all (0 = from `big` and `grading`); the classes below the biggest share it by `grading`, each
#           held to 120 (a scatter line past 128 overlapping copies is refused)   [0, 400]  0
#   volume  cm3 of concrete the break removed times its kept share; above 0 it sizes the biggest pieces so the pile's
#           solid volume matches it (pieces ~45 % of their box, plates ~70 %)   [0, 1e7]  0
#   size    cm, the biggest pieces' length when `volume` is 0                    [8, 200]   44
#   big     pieces in the biggest class (the plates)                             [0, 8]     2
#   grading the size-spread exponent: each halving of size holds 2^grading times the pieces (`spread=` is add()'s)   [0.5, 2.5]  1.5
#   settle  share of a piece's height sunk into what it lands on (the bed, the ground, a neighbour)   [0, 0.5]  0.2
#   cluster the heap's length as a share of `area` (big and large pieces stay on it)   [0.15, 1]  0.45
#   tail    how far small pieces and fines run out, in heap lengths              [1, 3]     2.2
#   rchunk  share of large chunks that carry bars                                [0, 1]     0.33
#   bars    loose bent bars lying in the gaps                                    [0, 12]    3
#   fines   scale of the fines count (0 = none)                                  [0, 2]     1
#   bed     1 a low bed of fines under the heap, 0 none                          [0, 1]     1
#   tile    cm per UV tile                                                       [any]      100

build {
  SM_Rubble_Pile_Game  = $PileGame  [pivot=(0, 0, 0)]
  SM_Rubble_Pile_High  = $PileHigh  [pivot=(0, 0, 0)]
}

Face     = material()
Broken   = material()
Steel    = material()
SteelCut = material()

R  = shape('/GraphCodeShape/Presets/Rebar', Steel = $Steel, SteelCut = $SteelCut)
CP = shape('/GraphCodeShape/Presets/ConcreteParts', Face = $Face, Broken = $Broken)
DA = shape('/GraphCodeShape/Presets/DebrisAssemblies', Face = $Face, Broken = $Broken, Steel = $Steel, SteelCut = $SteelCut)

PileGame = mesh(noise=1) { add($Pile, budget=0, noise=$noise) }
PileHigh = mesh(noise=1) { add($Pile, budget=1, noise=$noise) }

# the bed: a low worn mound of fines `len` long (all of it break faces); with `on` 0 a flat seat the pile deletes
Bed = mesh(on=1, len=60.0, ar=0.68, noise=1, tile=100.0) {
  if ($on > 0.5) {
    add($CP.Chunk, size=$len, damage=0.3, age=0.6, noise=$noise, budget=0, ar=$ar, tr=0.12, faces=13, even=30.0, skin=0, tile=$tile)
  } else {
    add($GroundEllipse, rx=0.42 * $len, ry=0.42 * $len * $ar)
  }
}
# a ground the pieces are dropped on, deleted by its handle afterwards (no piece is cut, no face needs UVs)
GroundEllipse = mesh(rx=50.0, ry=30.0) {
  points(($rx * 1.00000, $ry * 0.00000), ($rx * 0.96593, $ry * 0.25882), ($rx * 0.86603, $ry * 0.50000), ($rx * 0.70711, $ry * 0.70711), ($rx * 0.50000, $ry * 0.86603), ($rx * 0.25882, $ry * 0.96593), ($rx * 0.00000, $ry * 1.00000), ($rx * -0.25882, $ry * 0.96593), ($rx * -0.50000, $ry * 0.86603), ($rx * -0.70711, $ry * 0.70711), ($rx * -0.86603, $ry * 0.50000), ($rx * -0.96593, $ry * 0.25882), ($rx * -1.00000, $ry * 0.00000), ($rx * -0.96593, $ry * -0.25882), ($rx * -0.86603, $ry * -0.50000), ($rx * -0.70711, $ry * -0.70711), ($rx * -0.50000, $ry * -0.86603), ($rx * -0.25882, $ry * -0.96593), ($rx * -0.00000, $ry * -1.00000), ($rx * 0.25882, $ry * -0.96593), ($rx * 0.50000, $ry * -0.86603), ($rx * 0.70711, $ry * -0.70711), ($rx * 0.86603, $ry * -0.50000), ($rx * 0.96593, $ry * -0.25882), loop=true)
  extrude(height=1.0)
  place(by=(0, 0, -1.0))
}

# ---- Pile ------------------------------------------------------------------------------------------------------------
Pile = mesh(area=140.0, damage=0.5, age=0.0, noise=1, budget=0, count=0, volume=0.0, size=44.0, big=2, grading=1.5, settle=0.2, cluster=0.45, tail=2.2, rchunk=0.33, bars=3, fines=1.0, bed=1, tile=100.0) {
  $A = clamp($area, 40.0, 800.0)
  $dm = clamp($damage, 0.0, 1.0)
  $ag = clamp($age, 0.0, 1.0)
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $nz = clamp(floor($noise), 1, 99999)
  $k0 = $nz * 1009
  $sp = clamp($grading, 0.5, 2.5)
  $n0 = clamp(floor($big + 0.5), 0, 8)
  $m = pow(2, $sp)
  # the class counts by the grading exponent (the biggest class fixed at `big`), the fines held to 90 a pile
  $f1 = max($n0, 1) * $m
  $f2 = $f1 * $m
  $f3 = $f2 * $m
  $f4 = min($f3 * $m * clamp($fines, 0.0, 2.0), 90.0 * clamp($fines, 0.0, 2.0))
  $cnt = clamp(floor($count + 0.5), 0, 400)
  $sc = clamp(ceil($cnt - 0.5), 0, 1) * max($cnt - $n0, 0) / max($f1 + $f2 + $f3 + $f4, 1) + (1 - clamp(ceil($cnt - 0.5), 0, 1))
  $n1 = min(floor($f1 * $sc + 0.5), 120)
  $n2 = min(floor($f2 * $sc + 0.5), 120)
  $n3 = min(floor($f3 * $sc + 0.5), 120)
  $n4 = min(floor($f4 * $sc + 0.5), 120)
  $n1r = floor($n1 * clamp($rchunk, 0.0, 1.0) + 0.5)
  $n1c = $n1 - $n1r
  $n2p = floor(0.25 * $n2 + 0.5)
  $n2l = floor(0.5 * $n2p + 0.5)
  $n2f = $n2p - $n2l
  $n2c = $n2 - $n2p
  $nb = clamp(floor($bars + 0.5), 0, 12)
  # the biggest pieces' length: given, or from the volume (solid volume per B^3 of each class's mean piece:
  # a plate 0.095, a chunk 0.106 at its own size, the classes at B/2, B/4, B/8, B/16)
  $cf = $n0 * 0.095 + $n1 * 0.01325 + $n2 * 0.00166 + $n3 * 0.000207 + $n4 * 0.0000259
  $hv = clamp(ceil($volume - 0.5), 0, 1)
  $B = clamp($hv * pow(max($volume, 1.0) / max($cf, 0.001), 0.33333) + (1 - $hv) * $size, 8.0, 200.0)
  # the heap (bed and big pieces) and the tail (small pieces and fines), elongated along +X
  $Lh = min(clamp($cluster, 0.15, 1.0) * $A, 0.9 * $A)
  $Lt = min(clamp($tail, 1.0, 3.0) * $Lh, $A) - 0.5 * $B
  $st = clamp($settle, 0.0, 0.5) * 100.0
  $q1 = sin(($k0 + 301) * 12.9898 + 0.7) * 43758.5453
  $q1 = $q1 - floor($q1)
  $q2 = sin(($k0 + 302) * 12.9898 + 0.7) * 43758.5453
  $q2 = $q2 - floor($q2)
  bedh = add($Bed, on=$bed, len=$Lh, ar=0.62 + 0.12 * $q1, noise=$nz * 3 + 1, tile=$tile)
  gt = add($GroundEllipse, rx=0.5 * $Lt, ry=0.3 * $Lt, at=(0.12 * $Lt, 0.0, 0.0))
  # the biggest class: plates, lying near flat on the heap
  if ($n0 > 0.5) {
    add($CP.Plate, w=random(min=0.85 * $B, max=1.15 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=$bg, t=random(min=0.12 * $B, max=0.22 * $B), skins=2, tile=$tile, scatter=$n0, collide=stack, jitter=(turn=(14.0, 14.0, 180.0)), align=(Z: self=$st%), join=none, seed=$k0 + 11) [$bedh, top]
  }
  # large chunks, a share of them reinforced, tumbled (about a third lean past 30 degrees)
  if ($n1r > 0.5) {
    add($DA.ReinforcedChunk, size=random(min=0.42 * $B, max=0.6 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=$bg, bars=random(min=1.0, max=2.49), tile=$tile, scatter=$n1r, collide=stack, jitter=(turn=(40.0, 40.0, 180.0)), align=(Z: self=$st%), join=none, seed=$k0 + 21) [$bedh, top]
  }
  if ($n1c > 0.5) {
    add($CP.Chunk, size=random(min=0.4 * $B, max=0.62 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=$bg, tile=$tile, scatter=$n1c, collide=stack, jitter=(turn=(45.0, 45.0, 180.0)), align=(Z: self=$st%), join=none, seed=$k0 + 31) [$bedh, top]
  }
  # mid chunks and thin plates (half of those plates steep, leaning on what they meet)
  if ($n2c > 0.5) {
    add($CP.Chunk, size=random(min=0.2 * $B, max=0.32 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=$bg, tile=$tile, scatter=$n2c, collide=stack, jitter=(turn=(50.0, 50.0, 180.0)), align=(Z: self=$st%), join=none, seed=$k0 + 41) [$bedh, top]
  }
  if ($n2f > 0.5) {
    add($CP.Plate, w=random(min=0.22 * $B, max=0.36 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=$bg, t=random(min=0.035 * $B, max=0.07 * $B), skins=1, tile=$tile, scatter=$n2f, collide=stack, jitter=(turn=(20.0, 20.0, 180.0)), align=(Z: self=$st%), join=none, seed=$k0 + 51) [$gt, top]
  }
  if ($n2l > 0.5) {
    add($CP.Plate, w=random(min=0.22 * $B, max=0.36 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=$bg, t=random(min=0.035 * $B, max=0.07 * $B), skins=1, tile=$tile, scatter=$n2l, collide=stack, rotate=(62.0, 0.0, 0.0), jitter=(turn=(18.0, 12.0, 180.0)), join=none, seed=$k0 + 53) [$bedh, top]
  }
  # loose bent bars in the gaps, lying (their +Z laid along +X)
  if ($nb > 0.5) {
    add($R.BentBar, len=random(min=0.45 * $B, max=1.3 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=$bg, rotate=(0.0, -90.0, 0.0), tile=$tile, scatter=$nb, collide=stack, jitter=(turn=(8.0, 8.0, 180.0)), join=none, seed=$k0 + 61) [$gt, top]
  }
  # small chunks and fines: plain few-faced chunks (they read as texture at range), out along the tail
  if ($n3 > 0.5) {
    add($CP.Chunk, size=random(min=0.1 * $B, max=0.16 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=0, rough=0.0, faces=random(min=6.0, max=9.0), tile=$tile, scatter=$n3, collide=stack, jitter=(turn=(60.0, 60.0, 180.0)), align=(Z: self=$st%), join=none, seed=$k0 + 71) [$gt, top]
  }
  if ($n4 > 0.5) {
    add($CP.Chunk, size=random(min=0.05 * $B, max=0.085 * $B), damage=$dm, age=$ag, noise=random(min=1.0, max=999.0), budget=0, rough=0.0, faces=random(min=6.0, max=8.0), tile=$tile, scatter=$n4, collide=stack, jitter=(turn=(60.0, 60.0, 180.0)), align=(Z: self=$st%), join=none, seed=$k0 + 81) [$gt, top]
  }
  trim() [$gt]
  if ($bed < 0.5) {
    trim() [$bedh]
  }
  uv(keep)
}
