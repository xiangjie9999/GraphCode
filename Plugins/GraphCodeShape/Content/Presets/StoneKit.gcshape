    $fz = max(3, min(min(0.85 * $fw, 0.85 * $fdp), 18) * (0.6 + 0.4 * $fr4_0))
    $fxx = $gx - 0.5 * $gw + 4 + (0 + 0.5 + 0.25 * (2 * $fr4_1 - 1) * (1 - $fz / max($fw, $fz))) * $fw
    $fyy = $my + 0.1 * $mb + (2 + 0.5 + 0.25 * (2 * $fr4_2 - 1) * (1 - $fz / max($fdp, $fz))) * $fdp
    $fzz = $mz + 0.1 - max(0.18 * 0.42 * $fz, 0.9)
    if ($nfr > 4.5) {
      add($CP.Chunk, size=$fz, damage=0.8, age=0.3, noise=floor(997 * $fr4_3) + 1, budget=$budget_, ar=0.55 + 0.3 * $fr4_4, tr=0.42, skin=0, at=($fxx, $fyy, $fzz), rotate=(0, 0, 360 * $fr4_5), join=none)
    }
    $fr5_0 = sin(($k0 + 96) * 12.9898 + 0.78) * 43758.5453
    $fr5_0 = $fr5_0 - floor($fr5_0)
    $fr5_1 = sin(($k0 + 96) * 12.9898 + 2.398) * 43758.5453
    $fr5_1 = $fr5_1 - floor($fr5_1)
    $fr5_2 = sin(($k0 + 96) * 12.9898 + 4.016) * 43758.5453
    $fr5_2 = $fr5_2 - floor($fr5_2)
    $fr5_3 = sin(($k0 + 96) * 12.9898 + 5.634) * 43758.5453
    $fr5_3 = $fr5_3 - floor($fr5_3)
    $fr5_4 = sin(($k0 + 96) * 12.9898 + 7.252) * 43758.5453
    $fr5_4 = $fr5_4 - floor($fr5_4)
    $fr5_5 = sin(($k0 + 96) * 12.9898 + 8.87) * 43758.5453
    $fr5_5 = $fr5_5 - floor($fr5_5)
    $fz = max(3, min(min(0.85 * $fw, 0.85 * $fdp), 18) * (0.6 + 0.4 * $fr5_0))
    $fxx = $gx - 0.5 * $gw + 4 + (1 + 0.5 + 0.25 * (2 * $fr5_1 - 1) * (1 - $fz / max($fw, $fz))) * $fw
    $fyy = $my + 0.1 * $mb + (2 + 0.5 + 0.25 * (2 * $fr5_2 - 1) * (1 - $fz / max($fdp, $fz))) * $fdp
    $fzz = $mz + 0.1 - max(0.18 * 0.42 * $fz, 0.9)
    if ($nfr > 5.5) {
      add($CP.Chunk, size=$fz, damage=0.8, age=0.3, noise=floor(997 * $fr5_3) + 1, budget=$budget_, ar=0.55 + 0.3 * $fr5_4, tr=0.42, skin=0, at=($fxx, $fyy, $fzz), rotate=(0, 0, 360 * $fr5_5), join=none)
    }
  }
  # round 3: the unbroken faces; every block mapped its own breaks before their facets
  uv(box, at=(0, 0, 0), scale=$tile_) [!cut]
}
