gcshape 1  into:/GraphCodeShape/Presets  smooth:0.12  shade:40

# STONE KIT — the damage kit's stone subjects (Docs/GC-SHAPE-DAMAGE-KIT.md §12: the owner's references and the
# budget ruling; §12.3: nothing is a perfect rectangle). AGED IS THE DEFAULT LOOK: an intact stone here is never new.
# GENERATED by Content/__MCPTests/DamageKit/gen/s1/genstone.py: edit the generator, not this file.
#
#   SK = shape('/GraphCodeShape/Presets/StoneKit', Face = $MyStone, Broken = $MyFreshStone, Joint = $MyDirt)
#   Flight = mesh() { add($SK.Stairs, width=240, steps=8, rise=15, run=34, damage=1, age=1.5, noise=7, budget=1) }
#   Block  = mesh() { add($SK.AgedBlock, l=60, d=30, h=20, damage=0, age=1, noise=3, nose=1.5, chips=1) }
#
# CUSTOMISING (kit §11a): turn the TOP-LEVEL knobs first, the same names in every kit file: size (`width`, `steps`,
# `rise`, `run`; a block's `l`, `d`, `h`), `damage` 0-2 (how broken), `age` 0-2 (how worn), `softness` 0-1 (0 hard and
# crisp, the default; 1 worn round, independent of `age`), `noise` (the seed), `budget`
# 0/1/2 (game / high / ultra), and the material slots below. Each entry's comment lists every knob with its unit, range
# and default; every knob is clamped to its range, so a value past it builds the nearest sound piece.
#
# SUBJECTS: `AgedBlock` (one dressed stone, shared by every subject here), `Stairs` (a stair flight of block
# treads). Every look-defining number is a knob with a default; the seed knob is `noise` (`seed=` is reserved on
# add/subtract) and every draw is keyed `noise * 1009 + index`.
# SLOTS: `Face` the weathered stone, `Broken` every fresh break (chips, a broken corner, a crack, the fracture and the
# fragments), `Joint` the dirt
# and mortar in the joints. They have NO default path (a shipped preset never names a `/Game` asset): bind them at
# import, as above.
# BUDGET TIERS (§12.1, and the owner's ruling in §8a.6: the budget is the AUTHOR's, no ceiling): one recipe, three
# named lines per state. `_Game` is light (the `budget=0` recipe reduced to its `[triangles=]`, about 260 a step block)
# with normal and AO maps baked from `_High`; `_High` is the per-block hero (`budget=1`, a few thousand a block);
# `_Ultra` spends its triangles on SHAPE a close look finds (`budget=2`): fine chips breaking up the front arris and the
# tops of the ends (more where feet wore it), and every chip and break broken into finer facets (round 3: the broad
# faces stay calm, their pitting is the texture's). An author who wants another weight passes
# `budget` and its own `[triangles=]`. Until the next Shape release a baked line lays its own UV0 for the maps (the box
# map then lives on `_High` and `_Ultra`), so `_Game` is judged in clay.
# STATES (kit §2.0): one-line wrappers below, each built with the same grid box and pivot.

build {
  SM_StoneStairs_Aged_Game    = $StairsAgedGame    [bounds=(200, 200, *), pivot=(0, 0, 0), triangles=6000, maps=(normal, ao), from=$StairsAgedHigh]
  SM_StoneStairs_Aged_High    = $StairsAgedHigh    [bounds=(200, 200, *), pivot=(0, 0, 0)]
  SM_StoneStairs_Aged_Ultra   = $StairsAgedUltra   [bounds=(200, 200, *), pivot=(0, 0, 0)]
  SM_StoneStairs_Broken_Game  = $StairsBrokenGame  [bounds=(200, 200, *), pivot=(0, 0, 0), triangles=6400, maps=(normal, ao), from=$StairsBrokenHigh]
  SM_StoneStairs_Broken_High  = $StairsBrokenHigh  [bounds=(200, 200, *), pivot=(0, 0, 0)]
  SM_StoneStairs_Broken_Ultra = $StairsBrokenUltra [bounds=(200, 200, *), pivot=(0, 0, 0)]
}

Face   = material()
Broken = material()
Joint  = material()

# the debris lane's pieces (kit §14): the missing block's fragments are its `Chunk`s, all fresh break
CP = shape('/GraphCodeShape/Presets/ConcreteParts', Face = $Face, Broken = $Broken)

# ---- the states: one wrapper each (a build line cannot pass knob values) ---------------------------------------
StairsAgedGame    = mesh(noise=1) { add($Stairs, budget=0, noise=$noise) }
StairsAgedHigh    = mesh(noise=1) { add($Stairs, budget=1, noise=$noise) }
StairsAgedUltra   = mesh(noise=1) { add($Stairs, budget=2, noise=$noise) }
StairsBrokenGame  = mesh(noise=1) { add($Stairs, budget=0, damage=1, noise=$noise) }
StairsBrokenHigh  = mesh(noise=1) { add($Stairs, budget=1, damage=1, noise=$noise) }
StairsBrokenUltra = mesh(noise=1) { add($Stairs, budget=2, damage=1, noise=$noise) }

# ---- the reference sections: 100 x 100 (across the depth, up), points crowded toward every corner so the
# rounding and the worn nose have points to move; the block body is this lofted 100 along Z, then laid out
SecHi = plane() { points((0, 0), (2, 0), (5, 0), (10, 0), (18, 0), (30, 0), (50, 0), (70, 0), (82, 0), (90, 0), (95, 0), (98, 0), (100, 0), (100, 2), (100, 5), (100, 10), (100, 18), (100, 30), (100, 50), (100, 70), (100, 82), (100, 90), (100, 95), (100, 98), (100, 100), (98, 100), (95, 100), (90, 100), (82, 100), (70, 100), (50, 100), (30, 100), (18, 100), (10, 100), (5, 100), (2, 100), (0, 100), (0, 98), (0, 95), (0, 90), (0, 82), (0, 70), (0, 50), (0, 30), (0, 18), (0, 10), (0, 5), (0, 2), loop=true) }
SecLo = plane() { points((0, 0), (6, 0), (25, 0), (75, 0), (94, 0), (100, 0), (100, 6), (100, 25), (100, 75), (100, 94), (100, 100), (94, 100), (75, 100), (25, 100), (6, 100), (0, 100), (0, 94), (0, 75), (0, 25), (0, 6), loop=true) }

# ---- cutters and fills ----------------------------------------------------------------------------------------
# a chip's cutter: a few-faced irregular solid, centred on its own middle, so its flat facets leave a flaked
# scar of flat planes meeting at sharp edges (conchoidal stone at game cost)
ChipCut = mesh(a=4.0, b=3.0, c=2.0, faces=8, ev=30.0, sd=1) {
  polyhedron(size=($a, $b, $c), faces=floor($faces), evenness=$ev%, seed=floor($sd))
  place(by=(0, 0, 0 - $c * 0.5))
}
# a broken nosing's cutter: three chip cutters in a run, welded into one solid so the block takes one subtract (round 3:
# they overlap, every seed; the block's own relief breaks the scar after the cut)
ScarRun = mesh(x0=0.0, y0=0.0, z0=0.0, a0=12.0, b0=6.0, c0=4.0, f0=8, e0=20.0, s0=1, r0=45.0, p0=0.0, w0=0.0, x1=0.0, y1=0.0, z1=0.0, a1=12.0, b1=6.0, c1=4.0, f1=8, e1=20.0, s1=1, r1=45.0, p1=0.0, w1=0.0, x2=0.0, y2=0.0, z2=0.0, a2=12.0, b2=6.0, c2=4.0, f2=8, e2=20.0, s2=1, r2=45.0, p2=0.0, w2=0.0) {
  add($ChipCut, a=$a0, b=$b0, c=$c0, faces=$f0, ev=$e0, sd=$s0, at=($x0, $y0, $z0), rotate=($r0, $p0, $w0))
  add($ChipCut, a=$a1, b=$b1, c=$c1, faces=$f1, ev=$e1, sd=$s1, at=($x1, $y1, $z1), rotate=($r1, $p1, $w1), join=hard)
  add($ChipCut, a=$a2, b=$b2, c=$c2, faces=$f2, ev=$e2, sd=$s2, at=($x2, $y2, $z2), rotate=($r2, $p2, $w2), join=hard)
}
# round 3, the missing block's fracture: a box (`w` x `h` across, `len` long, up +Z) whose `bottom` end is the face
# toward the stone that stays. That end wanders `amp` cm in two drawn waves across it (the large scale: a height field,
# so it cannot fold), on points `fs` cm apart; the block breaks it into facets afterwards (`crumb`, the small scale).
BreakCut = mesh(w=30.0, h=50.0, len=60.0, amp=3.0, fs=2.0, sd=1) {
  $k = $sd * 1009
  $r0 = sin(($k) * 12.9898 + 0.9) * 43758.5453
  $r0 = $r0 - floor($r0)
  $r1 = sin(($k) * 12.9898 + 2.518) * 43758.5453
  $r1 = $r1 - floor($r1)
  $r2 = sin(($k) * 12.9898 + 4.136) * 43758.5453
  $r2 = $r2 - floor($r2)
  $r3 = sin(($k) * 12.9898 + 5.754) * 43758.5453
  $r3 = $r3 - floor($r3)
  $r4 = sin(($k) * 12.9898 + 7.372) * 43758.5453
  $r4 = $r4 - floor($r4)
  $r5 = sin(($k) * 12.9898 + 8.99) * 43758.5453
  $r5 = $r5 - floor($r5)
  rect(w=$w, h=$h)
  extrude(height=$len)
  warp(by=(0, 0, $amp * (0.55 * sin(point.x * (11 + 8 * $r0) + point.y * (6 + 6 * $r1) + 360 * $r2) + 0.45 * sin(point.x * (5 + 5 * $r3) - point.y * (13 + 9 * $r4) + 360 * $r5)))) [bottom, smooth=$fs]
}
# a crack's cutter: a band `w` wide (each station 0.6-1.4 x), wandering `wand` cm across as it runs `len` along +Y,
# `hh` tall
CrackCut = mesh(len=46.0, w=0.7, wand=3.0, hh=32.0, sd=1) {
  $k = $sd * 1009
  $r0 = sin(($k) * 12.9898 + 0.37) * 43758.5453
  $r0 = $r0 - floor($r0)
  $r1 = sin(($k) * 12.9898 + 1.988) * 43758.5453
  $r1 = $r1 - floor($r1)
  $r2 = sin(($k) * 12.9898 + 3.606) * 43758.5453
  $r2 = $r2 - floor($r2)
  $r3 = sin(($k) * 12.9898 + 5.224) * 43758.5453
  $r3 = $r3 - floor($r3)
  $r4 = sin(($k) * 12.9898 + 6.842) * 43758.5453
  $r4 = $r4 - floor($r4)
  $r5 = sin(($k) * 12.9898 + 8.46) * 43758.5453
  $r5 = $r5 - floor($r5)
  $r6 = sin(($k) * 12.9898 + 10.078) * 43758.5453
  $r6 = $r6 - floor($r6)
  $r7 = sin(($k) * 12.9898 + 11.696) * 43758.5453
  $r7 = $r7 - floor($r7)
  $r8 = sin(($k) * 12.9898 + 13.314) * 43758.5453
  $r8 = $r8 - floor($r8)
  $r9 = sin(($k) * 12.9898 + 14.932) * 43758.5453
  $r9 = $r9 - floor($r9)
  $r10 = sin(($k) * 12.9898 + 16.55) * 43758.5453
  $r10 = $r10 - floor($r10)
  $r11 = sin(($k) * 12.9898 + 18.168) * 43758.5453
  $r11 = $r11 - floor($r11)
  points(($wand * (2 * $r0 - 1) + 0.5 * $w * (0.6 + 0.5 * $r6), $len * 0), ($wand * (2 * $r1 - 1) + 0.5 * $w * (0.6 + 0.5 * $r7), $len * 0.2), ($wand * (2 * $r2 - 1) + 0.5 * $w * (0.6 + 0.5 * $r8), $len * 0.4), ($wand * (2 * $r3 - 1) + 0.5 * $w * (0.6 + 0.5 * $r9), $len * 0.6), ($wand * (2 * $r4 - 1) + 0.5 * $w * (0.6 + 0.5 * $r10), $len * 0.8), ($wand * (2 * $r5 - 1) + 0.5 * $w * (0.6 + 0.5 * $r11), $len * 1), ($wand * (2 * $r5 - 1) - 0.5 * $w * (0.6 + 0.5 * $r11), $len * 1), ($wand * (2 * $r4 - 1) - 0.5 * $w * (0.6 + 0.5 * $r10), $len * 0.8), ($wand * (2 * $r3 - 1) - 0.5 * $w * (0.6 + 0.5 * $r9), $len * 0.6), ($wand * (2 * $r2 - 1) - 0.5 * $w * (0.6 + 0.5 * $r8), $len * 0.4), ($wand * (2 * $r1 - 1) - 0.5 * $w * (0.6 + 0.5 * $r7), $len * 0.2), ($wand * (2 * $r0 - 1) - 0.5 * $w * (0.6 + 0.5 * $r6), $len * 0), loop=true)
  extrude(height=$hh)
}
# a missing block's socket: the dirt and mortar bed it lay on (round 3: its top lumpy, the Stairs set it 1.5 cm into
# the stone below, so only its lumps stand proud and its edge never stands clear of it)
DirtBed = mesh(w=60.0, d=30.0, t=1.4, sd=1) {
  polyhedron(size=($w, $d, $t), faces=10, evenness=30%, seed=floor($sd), mode=prism)
  roughen(by=0.35, scale=8.0, seed=floor($sd) + 5)
  material($Joint)
}

# ---- AgedBlock: one dressed stone, aged (kit §12.3: nothing is a perfect rectangle) ----------------
# The shared stone member for every StoneKit subject (stairs, and next the paving and walls). Frame: x along
# the length from 0 to `l`, y the depth from the FRONT face (y = 0) back to `d`, z up from the bed (z = 0) to
# `h`. Every imperfection is a knob whose 0 gives the perfect block, each drawn per block from
# `noise * 1009 + key`:
#   size     `varyl` cm on the length (a laid course usually leaves this to its joints), `vary` cm on the
#            front face (the face stands proud or set back), `proud` cm on the top (a few mm high or low);
#   arrises  `ease` cm radius, `uneven` its variation (0.6: from 0.4 to 1.6 times, changing along every
#            edge and corner);
#   faces    `bulge` cm out of plane (broad, low waves; end faces at a third, so joints stay open; none on
#            the bed, which nothing sees, and `bulge_back` of it on the back face);
#   level    `fall` cm the top falls across its length and depth (signs drawn); `skew` cm the front face
#            runs off square in plan;
#   settled  `sinkz` cm the whole block sank, `lean` cm one end dropped (+ the far end, - the near end),
#            `tip` cm the front dropped (the back holds);
#   wear     `nose` cm the front-top arris is worn back and down (`nose_w` across the top, `nose_h` down the
#            front; both raised as needed so the profile cannot fold), deepest at `nose_x` (cm along the
#            block, may lie outside it) over `nose_s` cm either side, `nose_base` of it everywhere; `dish`
#            cm a hollow worn into the top over the first `dish_d` cm, deepest with the nose;
#   relief   `relief` cm of weathering on the upper faces, bumps `grain` cm, laid AFTER every cut and never on
#            a break (`[!cut]`): `pits` 0 a smooth Perlin field, 1 pitted (ridged: rounded hollows between
#            sharp rims, the way weathered limestone pits) (hero detail: baked into the game tier);
#   chips    about `chips` per block (0-3 drawn), `chip` cm across (x 0.5 to 0.5 + `chip_var`), flaked off
#            the worn front arris, most near the ends: plane-faceted cutters (`ChipCut`), their faces `[cut]`,
#            `crumb` cm of faceted relief on them (hero detail only); `nbreak` cm, a broken LENGTH of nosing
#            (0 none) centred at `nbreak_x` of the length, `nbreak_d` cm deep into the arris; `fine` fine
#            chips (drawn 0.5-1.5 x, up to 12) of `fine_s` cm along the front arris and the tops of the ends
#            (edge breakup, the ultra tier);
#   ends     `taper_l` / `taper_r` cm the left / right end face slides along the length at the back face
#            (the front holds): ends off square, so a joint opens or closes along its length;
#   breaks   `corner` 1/2 breaks off the left/right front corner (a `corner_s` cm cutter centred a little
#            inside it, so a real piece goes, not a chip); `crack` 1 cracks the
#            block through, front to back, at `crack_x` of its length, `crack_w` cm open;
#   joints   `jends` 1/2/3 paints the left/right/both end faces `Joint` (they face a joint: dirt and moss
#            are the texture`s, kit §12.3 and critic S6, so the joint holds no fill geometry).
# `detail` 1 is the hero section (48 points round, 19 rings); 0 the game recipe (20 points, 7 rings) that
# the game line reduces to its budget. Slots: `Face`, and `Broken` on every `[cut]`. No UVs here: the
# assembly maps once, in its own frame, after the breaks.
# AgedBlock knobs (unit, range, default): TOP-LEVEL first, then advanced. Past its range a value is clamped.
#   * l          cm, 2-600, default 80.0: length (x)
#   * d          cm, 2-200, default 40.0: depth from the front face (y)
#   * h          cm, 2-100, default 16.0: height (z)
#   * damage     0-2, 0-2, default 0.0: a lone block: 0.5 and up breaks a front corner off (side drawn) where `corner` is 0; 1.5 and up also cracks it through
#   * age        0-2, 0-2, default 1.0: multiplies its wear (`nose`, `dish`, `chips`, `nbreak`, `fine`, `relief`) and widens its unevenness (`vary`, `proud`, `fall`, `skew`, `bulge`, `uneven`: 0.6x at 0, 2.5x at 2); 1 leaves every knob as passed
#   * softness   0-1, 0-1, default 0.0: how soft the stone reads, independent of `age` (owner, kit §12.3): 0 crisp (arrises a few mm to about 1 cm, planar faces, rock-like chips); 1 worn round like river-worn or sand-blasted stone (arrises x 4, gentle faces, chips and their facets fade). The foot-wear dish stays `age`s
#   * noise      seed, any, default 1: the seed (draws keyed `noise * 1009 + key`)
#   * detail     0/1, 0-1, default 1: its budget: 1 the hero section (48 points round, 19 rings), 0 the game recipe (20, 7)
#   * key        index, any, default 0: this block`s draw key (a caller laying many passes its own)
#     varyl      cm, 0-20, default 0.0: length drawn +- half this
#     vary       cm, 0-3, default 0.3: front face proud or set back
#     proud      cm, 0-3, default 0.25: top high or low
#     ease       cm, 0-5, default 0.5: arris radius (never past a quarter of the smaller of `d` and `h`; round 3: 0.5, hard)
#     uneven     share, 0-1, default 0.6: the radius varies 1 +- this along every edge
#     bulge      cm, 0-2, default 0.0: faces bulged out of plane, a pillow (round 3: 0; `softness` adds 0.35)
#     facets     cm, 0-2, default 0.25: each face broken into two broad planes at a shallow drawn crease, this far out of plane
#     bulge_back share, 0-1, default 1.0: of it on the back face
#     fall       cm, 0-3, default 0.25: top falls across length and depth
#     skew       cm, 0-3, default 0.3: front face off square in plan
#     sinkz      cm, -5-10, default 0.0: the whole block sank
#     lean       cm, -6-6, default 0.0: one end dropped (+ the far end, - the near end)
#     tip        cm, 0-6, default 0.0: the front dropped, the back held
#     nose       cm, 0-8, default 0.0: front-top arris worn back and down (x `age`)
#     nose_x     cm, any, default 40.0: where along the block the nose is worn deepest (may lie outside it)
#     nose_s     cm, 1-1000, default 60.0: over how far either side
#     nose_w     cm, 1-40, default 10.0: nose wear reach across the top
#     nose_h     cm, 1-40, default 6.0: nose wear reach down the front
#     nose_base  share, 0-1, default 0.35: nose wear everywhere
#     dish       cm, 0-5, default 0.0: hollow worn into the top (x `age`)
#     dish_d     cm, 1-200, default 32.0: over the first this of the depth
#     relief     cm, 0-1, default 0.0: weathering on the upper faces, after every cut, never on one (x `age`)
#     grain      cm, 1-40, default 4.5: its bump size
#     pits       0/1, 0-1, default 0: 1 pitted (ridged), 0 smooth Perlin
#     chips      about, per block, 0-3, default 0.0: small chips on the worn front arris (x `age`)
#     chip       cm, 0.5-20, default 6.0: a chip`s size
#     chip_var   x, 0-2, default 0.9: sizes spread over 0.5 to 0.5 + this
#     crumb      cm, 0-0.6, default 0.3: every chip and break broken again into facets this deep, so a scar has no straight outline and no flat floor (round 3: rock, not a notch; 0 the plane-cut scars of round 2; hero only)
#     crumb_s    cm, 0.4-6, default 1.5: the facets of that relief, across (round 3)
#     nbreak     cm, 0-100, default 0.0: a broken length of nosing, 0 none (x `age`)
#     nbreak_x   share, 0-1, default 0.5: where along the length it centres
#     nbreak_d   cm, 0.5-10, default 3.0: how deep it bites
#     fine       count, 0-12, default 0.0: fine chips on the front arris and the tops of the ends (x `age`)
#     fine_s     cm, 0.3-6, default 1.8: a fine chip`s size
#     flakes     about, per block, 0-4, default 0.0: shallow flakes scaled off the front face (x `age`)
#     flake      cm, 2-40, default 11.0: a flake`s size across
#     flake_d    cm, 0.1-3, default 0.7: how deep a flake bites
#     corner     0/1/2, 0-2, default 0: break the left / right front corner off
#     corner_s   cm, 2-60, default 22.0: its size
#     crack      0/1, 0-1, default 0: crack it through, front to back
#     crack_x    share, 0.05-0.95, default 0.5: where along the length
#     crack_w    cm, 0.1-4, default 0.7: the crack`s opening
#     gone       share, 0-0.9, default 0.0: this share of the length broken away (0 the whole block); the fracture face is rough and wanders
#     gone_side  1/2, 1-2, default 2: which end broke away: 1 the left, 2 the right
#     gone_w     x h, 0-0.5, default 0.18: how far the fracture face wanders, a share of the height
#     jends      0-3, 0-3, default 0: paint the left / right / both end faces `Joint`
#     taper_l    cm, -3-3, default 0.0: the left end face slides along the length at the back (front held)
#     taper_r    cm, -3-3, default 0.0: the same for the right end
#     tile       cm, 10-1000, default 100.0: the box map laid on its break faces before their facets (round 3: the assembly maps the rest)
AgedBlock = mesh(l=80.0, d=40.0, h=16.0, damage=0.0, age=1.0, softness=0.0, noise=1, detail=1, key=0, varyl=0.0, vary=0.3, proud=0.25, ease=0.5, uneven=0.6, bulge=0.0, facets=0.25, bulge_back=1.0, fall=0.25, skew=0.3, sinkz=0.0, lean=0.0, tip=0.0, nose=0.0, nose_x=40.0, nose_s=60.0, nose_w=10.0, nose_h=6.0, nose_base=0.35, dish=0.0, dish_d=32.0, relief=0.0, grain=4.5, pits=0, chips=0.0, chip=6.0, chip_var=0.9, crumb=0.3, crumb_s=1.5, nbreak=0.0, nbreak_x=0.5, nbreak_d=3.0, fine=0.0, fine_s=1.8, flakes=0.0, flake=11.0, flake_d=0.7, corner=0, corner_s=22.0, crack=0, crack_x=0.5, crack_w=0.7, gone=0.0, gone_side=2, gone_w=0.18, jends=0, taper_l=0.0, taper_r=0.0, tile=100.0) {
  # every knob clamped to its range (kit §11a); the rounding never past a quarter of the smaller of depth and height
  $l_ = clamp($l, 2, 600)
  $d_ = clamp($d, 2, 200)
  $h_ = clamp($h, 2, 100)
  $damage_ = clamp($damage, 0, 2)
  $age_ = clamp($age, 0, 2)
  $softness_ = clamp($softness, 0, 1)
  $detail_ = floor(clamp($detail, 0, 1) + 0.5)
  $varyl_ = clamp($varyl, 0, 20)
  $vary_ = clamp($vary, 0, 3)
  $proud_ = clamp($proud, 0, 3)
  $ease_ = clamp($ease, 0, 5)
  $uneven_ = clamp($uneven, 0, 1)
  $bulge_ = clamp($bulge, 0, 2)
  $facets_ = clamp($facets, 0, 2)
  $bulge_back_ = clamp($bulge_back, 0, 1)
  $fall_ = clamp($fall, 0, 3)
  $skew_ = clamp($skew, 0, 3)
