  $kz = $h2 * (0.2 + 0.35 * $k3_1)
  $ka = $flake_ * (0.6 + 0.6 * $k3_2)
  $kd = $flake_d_ * (0.7 + 0.6 * $k3_3)
  $kc = max(2.2 * $kd, 0.08 * $ka)
  $ky = $ya + $sk * ($kxr - 0.5) + $kd - 0.5 * $kc
  $kz = $kz + ($fx * ($kxr - 0.5) - 0.5 * $fy) * $kz / $h2 - $sinkz_ - max($lean_, 0) * $kxr - max(0 - $lean_, 0) * (1 - $kxr) - $tip_
  $kx = $kx + clamp(ceil(0.001 - abs($kx)), 0, 1) * clamp(ceil(abs($kx) * 1000000000), 0, 1) * 0.002
  $ky = $ky + clamp(ceil(0.001 - abs($ky)), 0, 1) * clamp(ceil(abs($ky) * 1000000000), 0, 1) * 0.002
  $kz = $kz + clamp(ceil(0.001 - abs($kz)), 0, 1) * clamp(ceil(abs($kz) * 1000000000), 0, 1) * 0.002
  if ($nflk > 3.5) {
    subtract($ChipCut, a=$ka, b=$ka * (0.45 + 0.35 * $k3_4), c=$kc, faces=7 + floor(4 * $k3_5), ev=10 + 30 * $k3_6, sd=floor(997 * $k3_7) + 1, at=($kx, $ky, $kz), rotate=(90 + 8 * (2 * $k3_5 - 1), 6 * (2 * $k3_6 - 1), 25 * (2 * $k3_4 - 1)))
  }
  $cuts = $nch + clamp($corner_, 0, 1) + clamp(ceil($nbreak_), 0, 1) + $nfine + $nflk + clamp(ceil($gone_ - 0.01), 0, 1) + $crack_
  # round 3: the break faces mapped while they are still plane facets (a box map laid over facets folds hundreds of
  # triangles), then every break broken again into facets: the hero`s ONE octave on its breaks (rock, not a notch; a
  # scar`s outline moves with it, so no straight edge is left). The relief moves points and keeps their map.
  if ($cuts > 0.5) {
    uv(box, at=(0, 0, 0), scale=$tile_) [cut]
    if ($crumb_ * $detail_ > 0) {
      roughen(by=$crumb_, scale=$crumb_s_, seed=floor(997 * $q13) + 1, form=faceted) [cut]
    }
  }
  # the weathered face, laid AFTER every cut and never on one (`[!cut]`: the booleans then cut the plain hero
  # section, not a dense noisy one, and a break stays fresh): one octave on the upper part of the block (the
  # tread and the top of the riser; the bed and the lower faces are hidden in every subject). Hero detail: it
  # bakes into the game tier. NOT `form=faceted`: on a broad face its cells sit on a lattice (S1 round 1). Never on
  # the END faces (`side`: the loft`s caps are the ends): its bumps closed joints and touched the course above.
  if ($relief_ > 0) {
    if ($pits_ > 0.5) {
      roughen(by=$relief_, scale=$grain_, seed=floor(997 * $q15) + 1, form=ridged) [side, !cut, above=45%]
    } else {
      roughen(by=$relief_, scale=$grain_, seed=floor(997 * $q15) + 1) [side, !cut, above=45%]
    }
  }
  material($Face)
  # an end that broke away (`gone`) has no end face left to paint
  $gl0 = clamp(ceil($gone_ - 0.01), 0, 1)
  $jl = (clamp(1 - abs($jends_ - 1), 0, 1) + clamp(1 - abs($jends_ - 3), 0, 1)) * (1 - $gl0 * clamp(2 - $gone_side_, 0, 1))
  $jr = (clamp(1 - abs($jends_ - 2), 0, 1) + clamp(1 - abs($jends_ - 3), 0, 1)) * (1 - $gl0 * clamp($gone_side_ - 1, 0, 1))
  if ($jl > 0.5) {
    material($Joint) [bottom]
  }
  if ($jr > 0.5) {
    material($Joint) [top]
  }
  if ($cuts > 0.5) {
    material($Broken) [cut]
  }
}

# ---- Stairs: an aged stone stair flight --------------------------------------------------------------
# Frame: x across the flight (0 to `width`), y up the flight (the bottom riser at y = 0), z up; the flight
# fills [0, width] x [0, steps * run + lap] (an `inset` cm margin keeps every drawn bulge inside the grid box).
# Each step is a COURSE about `rise` high (risers slightly unequal: each base drawn `rvar` cm about its place,
# the top of the flight kept): a row of step blocks `run + lap` deep (the step above sits on the back
# `lap`), and behind them one filler block to the back of the flight (hidden but for its ends at the sides).
# Block lengths are drawn in [`lmin`, `lmax`]: a `shortp` share are short fillers (up to `shortl` x `lmin`), the
# rest long, and a `split` share of courses end in a long block and a filler (its side drawn) rather than one
# block; each joint is pushed `shift` cm or more (drawn) from every joint of the course below, the way there
# is room; joints `joint` cm open +- `jvar` of that, a `jwide` share opened wide (up to `jwmax` cm), and every
# joint wider or narrower at the back by up to `jtaper` of its width (the block ends off square). Worn: `nose`
# cm at the nose, deepest along a drawn line of traffic near mid-width (`lane` of the width either side), each
# course worn its own amount, and a `dish` hollow behind it; `chips` per block of `chip` cm (x 0.5 to 0.5 +
# `chip_var`); a `bigp` share of blocks with a big chipped front corner (up to `big` cm) and an `nbp` share with
# a broken length of nosing (up to `nbl` cm long, `nbd` cm deep); a `sinkp` share of blocks sunk up to `sink` cm
# and a `tiltp` share tilted (an end or the front dropped) up to `tilt` cm.
# Joints stay open (dirt, mortar and moss are the texture`s job): the faces that meet in a joint wear `Joint`.
# Breaks: `cracks` blocks cracked through (1 to that many, drawn), `corners` 1 breaks a front corner off
# one block, `missing` 1 breaks one block (above the bottom course) `gone` of the way away: the rest stays with a rough
# fracture face, the neighbour on the hole`s side is spalled, the dirt bed shows and `frags` fragments lie on it.
# Every imperfection of a block is AgedBlock`s, passed through by name. UVs: one world-scale box map
# (`tile` cm a tile, anchored at the flight`s origin) on every face, written after every break.
# THE TRIANGLE BUDGET IS THE AUTHOR`S (owner, kit §8a.6): `budget` 0 is the game recipe (about 600 triangles a
# step block before a build line`s `[triangles=]`), 1 high (the hero section, a few thousand a block), 2 ultra (high
# plus the shape only a close look finds: `fine` fine chips of `fine_s` cm breaking up the front arris and the
# tops of the ends (more where the line of traffic wore it), every chip and break broken into finer facets, and
# `ultra` cm of pitted weathering on the broad faces (`pits` 1, ridged; round 3: 0, the broad faces stay calm) at `grain`
# cm on the upper faces, never on a break). No ceiling here.
# Stairs knobs (unit, range, default): TOP-LEVEL first, then advanced. Past its range a value is clamped.
#   * width      cm, 60-600, default 200.0: the flight across
#   * steps      count, 1-12, default 6: steps, one course of blocks each
#   * rise       cm, 10-25, default 16.0: a riser (each course drawn `rvar` about it, the top of the flight kept)
#   * run        cm, 20-50, default 32.0: a tread, front to back
#   * damage     0-2, 0-2, default 0.0: how broken: 0 aged only; 1 broken (one or two blocks cracked through, a front corner broken off, one block broken half away over its dirt bed: a rough-fractured piece stays, the neighbour on the hole`s side is spalled, fragments lie in the hole); 2 heavy (both cracks, a bigger corner break, more big chips and broken nosings)
#   * age        0-2, 0-2, default 1.0: how worn AND how uneven: 0 freshly laid (no wear, chips or settling; the dressed stone`s own tolerances at 0.6x); 1 aged; 2 old (wear, dishing, chips, broken nosings, settling and wide joints doubled, and every sense of unevenness 2.5x: block faces proud and set back, tops high and low and falling, fronts off square, faces out of plane, rounding, risers, joints along their length, sink and tilt, each block`s own state)
#   * softness   0-1, 0-1, default 0.0: how soft the stone reads, independent of `age` (owner, kit §12.3): 0 crisp (arrises a few mm to about 1 cm, planar faces, rock-like chips); 1 worn round like river-worn or sand-blasted stone (arrises x 4, gentle faces, chips and their facets fade). The foot-wear dish stays `age`s
#   * noise      seed, any, default 1: the seed: every draw is keyed `noise * 1009 + index`
#   * budget     0/1/2, 0-2, default 1: triangles: 0 the game recipe (about 600 a block before a build line`s `[triangles=]`), 1 high (about 3.5k a block), 2 ultra (finer facets on every chip and break, and fine chips weighted to the worn line of traffic; the broad faces stay calm)
#     lap        cm, 4-15, default 8.0: how far a step block runs under the step above
#     lmin       cm, 25-100, default 40.0: the shortest block
#     lmax       cm, 40-200, default 120.0: the longest block
#     shortp     share, 0-1, default 0.5: blocks that are short fillers
#     shortl     x lmin, 1-2, default 1.45: the longest short filler
#     split      share, 0-1, default 0.75: courses that end in a long block and a filler
#     shift      cm, 0-30, default 12.0: how far a joint keeps from every joint of the course below
#     joint      cm, 0.1-3, default 0.6: a joint`s usual opening
#     jvar       share, 0-0.9, default 0.5: its variation, +-
#     jwide      share, 0-1, default 0.2: joints opened wide (x `age`)
#     jwmax      cm, 0.5-4, default 2.0: a wide joint`s opening
#     jtaper     share, 0-1, default 0.8: how much wider or narrower a joint is at the back (the block ends off square)
#     inset      cm, 0-2, default 0.5: margin kept inside the grid box
#     bed        cm, 0-5, default 1.5: unused, kept so a caller that passes it still builds
#     nose       cm, 0-6, default 3.4: nosing worn back and down at the line of traffic (x `age`; never past 0.4 of `rise`)
#     nose_w     cm, 2-30, default 14.0: how far the nose wear reaches across the tread
#     nose_h     cm, 2-20, default 7.0: how far it reaches down the riser
#     nose_base  share, 0-1, default 0.12: nose wear left at the ends of the flight
#     lane       x width, 0.05-1, default 0.24: half-width of the worn line of traffic
#     dish       cm, 0-4, default 1.6: tread hollowed by feet, deepest mid-lane (x `age`)
#     chips      per block, 0-3, default 1.0: small chips on the front arris (x `age`; x 1.8 at `damage` 2)
#     chip       cm, 1-15, default 4.5: a small chip`s size
#     chip_var   x, 0-2, default 1.1: chip sizes spread over 0.5 to 0.5 + this
#     bigp       share, 0-1, default 0.22: blocks with a big chipped front corner (x `age`; x 1.8 at `damage` 2)
#     big        cm, 4-30, default 14.0: the biggest chipped corner
#     nbp        share, 0-1, default 0.25: blocks with a broken length of nosing (x `age`; x 1.8 at `damage` 2)
#     nbl        cm, 5-60, default 30.0: the longest broken nosing
#     nbd        cm, 1-8, default 3.5: how deep a broken nosing bites
#     sink       cm, 0-5, default 3.0: how far a sunk block went down (one block a flight always, x `age` up to 1)
#     sinkp      share, 0-1, default 0.12: more blocks sunk, each 0.35-1 x `sink` (x `age`)
#     tilt       cm, 0-5, default 2.5: how far a tilted block`s end or front dropped (one block a flight always, x `age` up to 1)
#     tiltp      share, 0-1, default 0.12: more blocks tilted, each 0.5-1 x `tilt` (x `age`)
#     rvar       cm, 0-3, default 1.5: risers unequal: each course`s base drawn +- this (x the `age` spread)
#     bstate     share, 0-0.9, default 0.5: each block its own state: its nose wear, dish and chips x (1 +- this) and its rounding x (1 +- 0.8 of it), so one block reads fresher, its neighbour more worn (x the `age` spread)
#     vary       cm, 0-2, default 0.3: a block`s front face proud or set back
#     proud      cm, 0-2, default 0.6: a block`s top high or low
#     ease       cm, 0-4, default 0.5: arris rounding (round 3, owner: hard, not soft; was 0.9)
#     uneven     share, 0-1, default 0.6: how much the rounding changes along an edge
#     bulge      cm, 0-1, default 0.0: faces bulged out of plane, a pillow (round 3: 0, owner: no pillow bulge; `softness` adds 0.35)
#     facets     cm, 0-1, default 0.25: each face broken into two broad planes at a shallow drawn crease, this far out of plane (x `age` spread; `softness` 1 takes it away)
#     fall       cm, 0-2, default 0.35: a top falling across its length and depth
#     skew       cm, 0-2, default 0.3: a front face off square in plan
#     relief     cm, 0-1, default 0.0: weathering on every budget (the ultra tier adds `ultra`)
#     ultra      cm, 0-1, default 0.0: the ultra tier`s pitted weathering on the broad faces (x `age`; round 3: 0, the broad faces stay calm and their pitting is the texture`s)
#     grain      cm, 1-30, default 5.0: the weathering`s bump size (smaller costs more triangles)
#     pits       0/1, 0-1, default 1: 1 pitted weathering (rounded hollows between sharp rims), 0 a smooth field
#     fine       per block, 0-12, default 10.0: the ultra tier`s fine chips breaking up the arrises (x `age`; a block takes 0.35 + 0.65 x its share of the worn line of traffic)
#     fine_s     cm, 0.5-5, default 2.4: a fine chip`s size
#     crumb      cm, 0-0.6, default 0.25: every chip and break broken again into facets this deep, so a scar has no straight outline and no flat floor (round 3: rock, not a notch; 0 round 2`s plane-cut scars; the game recipe takes 0 and its maps bake them; the ultra tier 0.75 x)
#     crumb_s    cm, 0.4-6, default 2.2: those facets across (the ultra tier 0.6 x)
#     flakes     per block, 0-4, default 0.7: shallow flakes scaled off the risers (x `age`)
#     flake      cm, 2-40, default 11.0: a flake`s size across
#     flake_d    cm, 0.1-3, default 0.7: how deep a flake bites
#     gone       share, 0.2-0.9, default 0.6: the missing block: this share of it broke away (each 0.8-1.2 x), the rest stays in place with a rough fracture face
#     frags      count, 0-6, default 4: fragments lying on its bed (`ConcreteParts.Chunk`), settled
#     cracks     count, 0-2, default 0: blocks cracked through, at least (`damage` 1 sets 2)
#     crack_w    cm, 0.2-3, default 0.7: a crack`s opening
#     corners    0/1, 0-1, default 0: 1 breaks a front corner off one block (`damage` 1 sets it)
#     corner_s   cm, 5-40, default 22.0: the broken corner`s size (x 1.35 at `damage` 2)
#     missing    0/1, 0-1, default 0: 1 breaks one block half away (`gone` of it), its dirt bed showing, fragments on it (`damage` 1 sets it)
#     tile       cm, 10-1000, default 100.0: the box map`s tile
Stairs = mesh(width=200.0, steps=6, rise=16.0, run=32.0, damage=0.0, age=1.0, softness=0.0, noise=1, budget=1, lap=8.0, lmin=40.0, lmax=120.0, shortp=0.5, shortl=1.45, split=0.75, shift=12.0, joint=0.6, jvar=0.5, jwide=0.2, jwmax=2.0, jtaper=0.8, inset=0.5, bed=1.5, nose=3.4, nose_w=14.0, nose_h=7.0, nose_base=0.12, lane=0.24, dish=1.6, chips=1.0, chip=4.5, chip_var=1.1, bigp=0.22, big=14.0, nbp=0.25, nbl=30.0, nbd=3.5, sink=3.0, sinkp=0.12, tilt=2.5, tiltp=0.12, rvar=1.5, bstate=0.5, vary=0.3, proud=0.6, ease=0.5, uneven=0.6, bulge=0.0, facets=0.25, fall=0.35, skew=0.3, relief=0.0, ultra=0.0, grain=5.0, pits=1, fine=10.0, fine_s=2.4, crumb=0.25, crumb_s=2.2, flakes=0.7, flake=11.0, flake_d=0.7, gone=0.6, frags=4, cracks=0, crack_w=0.7, corners=0, corner_s=22.0, missing=0, tile=100.0) {
  # every knob clamped to its range (kit §11a)
  $width_ = clamp($width, 60, 600)
  $steps_ = floor(clamp($steps, 1, 12) + 0.5)
  $rise_ = clamp($rise, 10, 25)
  $run_ = clamp($run, 20, 50)
  $damage_ = clamp($damage, 0, 2)
  $age_ = clamp($age, 0, 2)
  $softness_ = clamp($softness, 0, 1)
  $budget_ = floor(clamp($budget, 0, 2) + 0.5)
  $lap_ = clamp($lap, 4, 15)
  $lmin_ = clamp($lmin, 25, 100)
  $lmax_ = clamp($lmax, 40, 200)
  $shortp_ = clamp($shortp, 0, 1)
  $shortl_ = clamp($shortl, 1, 2)
  $split_ = clamp($split, 0, 1)
  $shift_ = clamp($shift, 0, 30)
  $joint_ = clamp($joint, 0.1, 3)
  $jvar_ = clamp($jvar, 0, 0.9)
  $jwide_ = clamp($jwide, 0, 1)
  $jwmax_ = clamp($jwmax, 0.5, 4)
  $jtaper_ = clamp($jtaper, 0, 1)
  $inset_ = clamp($inset, 0, 2)
  $bed_ = clamp($bed, 0, 5)
  $nose_ = clamp($nose, 0, 6)
  $nose_w_ = clamp($nose_w, 2, 30)
  $nose_h_ = clamp($nose_h, 2, 20)
  $nose_base_ = clamp($nose_base, 0, 1)
  $lane_ = clamp($lane, 0.05, 1)
  $dish_ = clamp($dish, 0, 4)
  $chips_ = clamp($chips, 0, 3)
  $chip_ = clamp($chip, 1, 15)
  $chip_var_ = clamp($chip_var, 0, 2)
  $bigp_ = clamp($bigp, 0, 1)
  $big_ = clamp($big, 4, 30)
  $nbp_ = clamp($nbp, 0, 1)
  $nbl_ = clamp($nbl, 5, 60)
  $nbd_ = clamp($nbd, 1, 8)
  $sink_ = clamp($sink, 0, 5)
  $sinkp_ = clamp($sinkp, 0, 1)
  $tilt_ = clamp($tilt, 0, 5)
  $tiltp_ = clamp($tiltp, 0, 1)
  $rvar_ = clamp($rvar, 0, 3)
  $bstate_ = clamp($bstate, 0, 0.9)
  $vary_ = clamp($vary, 0, 2)
  $proud_ = clamp($proud, 0, 2)
  $ease_ = clamp($ease, 0, 4)
  $uneven_ = clamp($uneven, 0, 1)
  $bulge_ = clamp($bulge, 0, 1)
  $facets_ = clamp($facets, 0, 1)
  $fall_ = clamp($fall, 0, 2)
  $skew_ = clamp($skew, 0, 2)
  $relief_ = clamp($relief, 0, 1)
  $ultra_ = clamp($ultra, 0, 1)
  $grain_ = clamp($grain, 1, 30)
  $pits_ = floor(clamp($pits, 0, 1) + 0.5)
  $fine_ = clamp($fine, 0, 12)
  $fine_s_ = clamp($fine_s, 0.5, 5)
  $crumb_ = clamp($crumb, 0, 0.6)
  $crumb_s_ = clamp($crumb_s, 0.4, 6)
  $flakes_ = clamp($flakes, 0, 4)
  $flake_ = clamp($flake, 2, 40)
  $flake_d_ = clamp($flake_d, 0.1, 3)
  $gone_ = clamp($gone, 0.2, 0.9)
  $frags_ = floor(clamp($frags, 0, 6) + 0.5)
  $cracks_ = clamp($cracks, 0, 2)
  $crack_w_ = clamp($crack_w, 0.2, 3)
  $corners_ = floor(clamp($corners, 0, 1) + 0.5)
  $corner_s_ = clamp($corner_s, 5, 40)
  $missing_ = floor(clamp($missing, 0, 1) + 0.5)
  $tile_ = clamp($tile, 10, 1000)
  $lmax_ = max($lmax_, 1.5 * $lmin_)
  # `age` scales the wear and the settling; `damage` the breaks (1 is the broken state, 2 heavier)
  $dh = clamp($damage_ - 1, 0, 1)
  $nose_ = $nose_ * $age_
  $dish_ = $dish_ * $age_
  $fine_ = $fine_ * $age_
  $ultra_ = $ultra_ * $age_
  $flakes_ = $flakes_ * $age_
  # round 3: the worn nose never deeper than 0.4 of a riser (at `age` 2 it would reach past the riser)
  $nose_ = min($nose_, 0.4 * $rise_)
  $chips_ = $chips_ * $age_ * (1 + 0.8 * $dh)
  $bigp_ = $bigp_ * $age_ * (1 + 0.8 * $dh)
  $nbp_ = $nbp_ * $age_ * (1 + 0.8 * $dh)
  $sinkp_ = min(1, $sinkp_ * $age_)
  $tiltp_ = min(1, $tiltp_ * $age_)
  $jwide_ = min(1, $jwide_ * $age_)
  $cracks_ = max($cracks_, 2 * clamp(ceil($damage_ - 0.5), 0, 1))
  $corners_ = max($corners_, clamp(ceil($damage_ - 0.5), 0, 1))
  $missing_ = max($missing_, clamp(ceil($damage_ - 0.5), 0, 1))
  $corner_s_ = $corner_s_ * (1 + 0.35 * $dh)
  # every sense of unevenness widened together by `age` (owner): 0.6 at age 0, 1 at 1, 2.5 at 2
  $tm = 0.6 + 0.4 * $age_ + 1.1 * max($age_ - 1, 0)
  $vary_ = $vary_ * $tm
  $proud_ = $proud_ * $tm
  $fall_ = $fall_ * $tm
  $skew_ = $skew_ * $tm
  $bulge_ = $bulge_ * $tm
  $facets_ = $facets_ * $tm
  $rvar_ = $rvar_ * $tm
  $sink_ = $sink_ * $tm
  $tilt_ = $tilt_ * $tm
  # `softness` (owner): the big chipped corners and broken nosings fade with it (AgedBlock fades the rest)
  $bigp_ = $bigp_ * (1 - 0.7 * $softness_)
  $nbp_ = $nbp_ * (1 - 0.7 * $softness_)
  $uneven_ = min(1, $uneven_ * $tm)
  $jvar_ = min(0.9, $jvar_ * $tm)
  $jtaper_ = min(1, $jtaper_ * $tm)
  $bstate_ = min(0.9, $bstate_ * $tm)
  $sink_ = min($sink_, 6)
  $tilt_ = min($tilt_, 6)
  # round 3: the settled picks (one block sunk, one tilted, every flight) fade in over `age` 0-0.5: a fresh flight is true
  $af = clamp(2 * $age_, 0, 1)
  # round 3: the front margin grows with what can stand proud of it (front face, bulge, skew), so no `age` passes the grid box
  $yf = max(0, $vary_ + $bulge_ + 0.35 * $softness_ + $facets_ + 0.5 * $skew_ + 0.1 - $inset_)
  $k0 = $noise * 1009
  # the triangle budget: 0 the game recipe, 1 high, 2 ultra (high plus `ultra` cm of weathering at `grain`)
  $detail = clamp($budget_, 0, 1)
  $rl = $relief_ + clamp($budget_ - 1, 0, 1) * $ultra_
  $nfn = clamp($budget_ - 1, 0, 1) * $fine_
  # round 3: the ultra tier breaks its chips into finer facets (its triangles go to the fractures, not the broad faces)
  $crb = $crumb_ * (1 - 0.25 * clamp($budget_ - 1, 0, 1))
  $crs = $crumb_s_ * (1 - 0.4 * clamp($budget_ - 1, 0, 1))
  $s0 = sin(($k0 + 7) * 12.9898 + 0.37) * 43758.5453
  $s0 = $s0 - floor($s0)
  $s1 = sin(($k0 + 7) * 12.9898 + 1.988) * 43758.5453
  $s1 = $s1 - floor($s1)
  $s2 = sin(($k0 + 7) * 12.9898 + 3.606) * 43758.5453
  $s2 = $s2 - floor($s2)
  $s3 = sin(($k0 + 7) * 12.9898 + 5.224) * 43758.5453
  $s3 = $s3 - floor($s3)
  $s4 = sin(($k0 + 7) * 12.9898 + 6.842) * 43758.5453
  $s4 = $s4 - floor($s4)
  $s5 = sin(($k0 + 7) * 12.9898 + 8.46) * 43758.5453
  $s5 = $s5 - floor($s5)
  $s6 = sin(($k0 + 7) * 12.9898 + 10.078) * 43758.5453
  $s6 = $s6 - floor($s6)
