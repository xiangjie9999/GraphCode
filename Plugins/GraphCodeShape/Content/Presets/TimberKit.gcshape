  }
  material($Face)
  material($Broken) [cut]
}

# ==== THE WALKWAY (kit §12.2): a weathered plank deck on beams over sleepers, rope-lashed at the sleeper ends ====
#
# Along +X; the planks lie across it (grain +Y) on `beams` beams along X, which rest on `sleepers` across near the
# module ends; the sleepers stick out past the plank field and their ends are lashed. The origin is the module's
# min corner at the planks' nominal bottom + their thickness (beams' tops at z = -pthick). Every plank, beam and
# sleeper is an `AgedBoard` with its own index (no two alike). States: `_Aged` (age 1: good condition),
# `_Decayed` (age 1.8: every plank decayed, sag, a loose plank, planks missing, nails proud), `_Broken` (age 0.9,
# damage 0.5: decayed, then an asymmetric hole with Damage.Snap ends, debris on the deck; `_Broken_Debris` is
# what fell through). Every knob is clamped to its range.
#   knob       default unit  range         meaning
#   size_x        300 cm     [100..800]    the module along the walkway
#   size_y        180 cm     [80..400]     across it (the planks' length)
#   damage          0 0-1    [0..1]        0 none; above 0 a hole breaks through (asymmetric, wider with damage), more planks gone whole, overhangs broken off, debris
#   age             1 0-2    [0..2]        0 new, 1 aged (good condition), 1.8 decayed (bad condition), 2 the most: every unevenness x age up to 1, x3 at 2; past 1.1 the planks decay
#   softness        0 0-1    [0..1]        0 crisp, the default (hard arrises, breakouts, faceted cup, stepped ends); toward 1 worn round (driftwood): AgedBoard's softness
#   noise           1 int                  the seed
#   budget          1 0/1/2  [0..2]        0 Game, 1 High, 2 Ultra
#   pin            22 cm     [5..60]       sleepers stick out this far past the plank field (their ends lashed)
#   sleepers        2 count  [2..4]        sleepers across, under the beams
#   sl_w           16 cm     [8..40]       sleeper width
#   sl_d           16 cm     [8..40]       sleeper depth
#   sl_in          24 cm     [5..100]      sleepers in from each module end
#   beams           2 count  [2..3]        beams (stringers) along X
#   beam_w         16 cm     [8..40]       beam width
#   beam_d         20 cm     [8..50]       beam depth
#   beam_in        20 cm     [0..80]       outer beams in from the plank ends
#   beam_wear     1.5 cm     [0..5]        beams' and sleepers' worn arrises
#   pw_lo          12 cm     [6..60]       plank width, least
#   pw_hi          30 cm     [8..80]       plank width, most
#   pthick          8 cm     [2..20]       plank thickness (thick planks, R3)
#   gap_lo        0.3 cm     [0..5]        gap, least
#   gap_hi        1.6 cm     [0..10]       gap, most (x age)
#   stag           14 cm     [0..60]       each end within this of the module edge
#   pflush       0.35 share  [0..1]        ends flush with the edge
#   pslant       0.15 share  [0..1]        planks with ends cut at a slant (slantq x endsq)
#   slantq          4 x      [1..8]        how much further off square a slanted end is
#   cant          0.8 deg    [0..10]       canted across the width up to this
#   plift        0.08 share  [0..1]        planks lifted at one end about a beam
#   lifth         2.5 cm     [0..15]       how far a lifted end rises
#   sprung          1 count  [0..3]        planks sprung up at one end (bent, not lifted)
#   springh         5 cm     [0..30]       how far a sprung end rises (x age)
#   psag          1.2 cm     [0..10]       planks sag between the outer beams (x age)
#   loose        0.12 share  [0..1]        loose planks shifted along their length and turned (x decay)
#   pgone        0.12 share  [0..0.5]      planks missing (x decay; never two side by side)
#   nails           1 0/1    [0..1]        nail heads standing proud on decayed planks (High and Ultra)
#   proud         0.6 cm     [0..3]        how far a nail head stands proud
#   rope            1 0/1    [0..1]        rope lashings at the sleepers' ends (TK15: real turns of Rope, ends tucked;
#                                     the game budget keeps the flat rings)
#   turns           4 count  [1..10]       turns of rope in a lashing
#   rope_r        1.3 cm     [0.3..4]      rope radius
#   rope_at         5 cm     [0..30]       lashing in from the sleeper end
#   debris          4 count  [0..40]       pieces lying on the deck (x age, up to 2 x; 6 more at damage 1)
#   hole_xf       0.5 x      [0..1]        the hole's centre along the module (x size_x)
#   hvar           25 cm     [0..200]      the hole moves this far a seed, each side its own way
#   midbay       0.25 share  [0..1]        broken ends 5-15 cm past the beam (else at it)
#   plevel        0.6 share  [0..1]        broken ends level
#   phang        0.25 share  [0..1]        hanging 15-45 degrees
#   pcrack        0.1 share  [0..1]        cracked 5-15 (else steep 60-80)
#   stub            1 0/1    [0..1]        one stub 10-15 cm at 35-45 degrees
#   deep            1 x      [0.1..4]      the breaks' reach (Damage.Snap)
#   grain        0.24 x      [0.1..0.6]    spire width
#   bslant         10 deg    [0..20]       break slant either way
#   torn         0.85 x      [0..1]        torn fibre ends
#   detail       0.25 cm     [0.1..1]      the breaks' point spacing
#   wvar          0.1 x      [0..0.4]      width
#   tvar         0.12 x      [0..0.4]      thickness
#   taper        0.04 x      [0..0.3]      width along a plank
#   waney         0.5 cm     [0..5]        a non-straight edge
#   ttaper       0.08 x      [0..0.5]      thickness along a plank
#   yaw           0.5 deg    [0..6]        yaw
#   pitch        0.25 deg    [0..6]        pitch
#   roll          0.6 deg    [0..10]       roll
#   lift         0.25 cm     [0..5]        height
#   cup           0.6 cm     [0..4]        cup
#   bow           0.5 cm     [0..15]       bow
#   crook         0.3 cm     [0..15]       crook
#   twist         1.5 deg    [0..20]       twist
#   endsq         1.5 deg    [0..12]       ends off square
#   wear          0.9 cm     [0..4]        wear
#   wearvar       0.6 x      [0..1]        wear varies
#   state        0.35 x      [0..1]        each plank its own condition
#   ridge        0.55 cm     [0..2]        decay: eroded ridges
#   checks          3 count  [0..4]        decay: open checks
#   checkd       0.45 x      [0..0.9]      decay: check depth
#   crumb           5 cm     [0..20]       decay: crumbled ends
#   sliver        0.6 share  [0..1]        decay: slivers off
#   corner       0.45 share  [0..1]        decay: corners missing
#   thin         0.22 x      [0..0.6]      decay: thinner
#   tear          0.8 x      [0..3]        (unused here)
#   bfib         0.06 cm     [0..0.5]      Ultra: fibre on every broken end
#   tile          100 cm     [10..1000]    grain UV tile
#   aspect          1 x      [0.1..10]     grain tile aspect

# a rope turn round a w (up) x h (across) bundle, r its rope radius, centred on its origin in its own plane XY, its
# turn 2r along Z (TK15: Rope's Turn, a real round rope; `ru` 0 = the game ring RingTurn, 1 = Rope; `rs` the ring's rounds)
RopeTurn = mesh(w=26.0, h=16.0, r=1.1, rs=2, ru=1, age=0.0, noise=1, index=0) {
  if ($ru > 0.5) {
    add($Rp.Turn, w=$w, h=$h, corner=0.1 * min($w, $h), r=$r, strands=0, budget=1, age=$age, noise=$noise, index=$index, axis=2, join=none)
  } else {
    add($RingTurn, w=$w, h=$h, r=$r, rs=$rs, ru=0, join=none)
  }
}
# the GAME budget's flat rope ring (the shipped RopeTurn, kept for the game lines): a ring round a w (up) x h (across)
# bundle, r its rope radius, centred on its origin in its own plane XY,
# its turn's width 2r along Z; rs the round's segments
RingHole = plane(w=10.0, h=10.0) { rect(w=$w, h=$h) }
RingTurn = mesh(w=26.0, h=16.0, r=1.1, rs=2, ru=1) {
  rect(w=$w + 2 * $r, h=$h + 2 * $r)
  round(2.2 * $r)
  subtract($RingHole, w=$w, h=$h)
  extrude(height=2 * $r)
  round(0.45 * $r, segments=$rs) [top]
  round(0.45 * $r, segments=$rs) [bottom]
  place(by=(0.0, 0.0, -$r))
  if ($ru > 0.5) {
    uv(auto)
  } else {
    uv(none)
  }
  material($Rope)
}
# a nail head: a short iron cylinder, its top `up` cm above its origin (the plank's top)
Nail = mesh(up=0.6) {
  circle(radius=0.45, segments=8)
  extrude(height=2.0 + $up)
  place(by=(0.0, 0.0, -2.0))
  round(0.15, segments=1) [top]
  uv(none)
  material($Face)
}

# ==== SHARED WOOD OPERATIONS (moved here from WoodRuin, 20 Nov 2026; the lead: "every wooden kit uses the same pieces") ====
# The pieces a weathered plank walkway was built from, now one layer every wooden kit (WoodRuin's decks, the house wall,
# a ladder) calls as $Kit.<name>; each is described where it stands below:
#   DeckBoard   one plank or board, whole: section (AgedSec/DecaySec), cup, bow, crook, twist, taper, waney edge, pitch,
#               roll, a sprung end; decay `decay`/`state`: checks, ridges, crumbled ends (EndRot), gouges, broken lips,
#               worn hollows and edge wander (Gouges), grooves (Grooves); snapped or hinged ends (Damage's Snap); a nail
#   Gouges      gouges, broken top lips, a worn hollow, both long edges wandering with their GAP (`gl`, `gr`, `sd`, `nl`)
#   EndRot      an end rotted back hard in three blocks with a stepped top layer
#   Grooves     long V grooves on a column-locked section
#   WoodPoints, Wear, Rot, Erosion, Checks, EndCracks, Bend   opt-in treatments on ANY wooden shape, in its own grain (OW1);
#               OldWood  the usual set at one age
#   Member      ONE wooden member, its section a setting (round pole/pillar/rung, square post/beam, plank, your own), aged by OldWood
#   JoistBlank, DeckJoist, JoistSec, JRun   an old squared beam/joist/stringer: checks, eroded grain, ends off square
#   Lash        a round rope turn round a bundle (slot `Rope`; Rope's Turn)
#   Cobble, Ball     a field stone (slot `Stone`); drop them with add(..., collide=settle) so each rests on what is under it
#   NailRod     a nail's shank (slot `Iron`)
#   Pole, PoleBlank  a round pole, rung or culm: taper, crook, nodes, sag, checks, eroded grain, rotted foot, worn tread, split
#   Wrap        a round cord turn hugging a round member (`sx` stretches it to wrap two side by side; slot `Rope`; Rope's Turn)
#   RingTurn, RingWrap   the shipped flat rope rings, kept for the game budget's lines (they survive the cut)
#   Hash        the generator hash every piece above keys its draws with
# Slots: `Face`, `Broken`, `Rope` as before, and `Stone`, `Iron` (bind them when importing, or the default grid shows).
# UV (UV15, 20 Nov: the house wall's boards repeated): every board, plank and beam of this kit (AgedBoard, JaggedEnd,
# BrokenBoard, BrokenSeg, DeckBoard, JoistBlank, DeckJoist) draws its own place on the tiling texture from its seed: `$Uo`,
# `$Vo` (a fraction of a tile each) and `$Uf` (the box frame turned 180 degrees about the board's normal, so the grain's
# start flips end to end); a [cut] face keeps its own offset on top (+0.37, +0.61). The scale (texel density) is unchanged.

# the generator hash, written once (kit G28 named formula): the fraction of a sine of a seed and a constant
Hash = formula(s, c) { sin($s * 12.9898 + $c) * 43758.5453 - floor(sin($s * 12.9898 + $c) * 43758.5453) }

# a field cobble lying on the planks (round 8, R3: dull rounded stones, a third to a half of a plank's width): a
# squashed ball `size` cm long, `ar` its width and `tr` its height over that, lumped by a few broad facets of its own
Ball = mesh(size=8.0) {
  arc(radius=0.5 * $size, from=-90, to=90)
  revolve()
}

Cobble = mesh(size=8.0, ar=0.8, tr=0.55, noise=1) {
  add($Ball, size=$size, scale=(1.0, $ar, $tr))
  $cq = 360 * $Hash($noise, 5701.3)
  warp(by=0.06 * $size * (sin(2.1 * point.x / $size * 180 + $cq) + sin(2.7 * point.y / $size * 180 + 2 * $cq) + 0.7 * sin(3.3 * point.z / $size * 180 + 3 * $cq)))
  uv(auto)
  material($Stone)
}

# a ROUND rope turn (round 10; TK15: Rope's Turn): a ring of rope of radius r round a w (up) x h (across) bundle, in its
# plane XY, centred on its origin; `rs` 1 = the game ring (RingLash), 2 or more = Rope
Lash = mesh(w=20.0, h=20.0, r=1.4, rs=3, age=0.0, noise=1, index=0) {
  if ($rs > 1.5) {
    add($Rp.Turn, w=$w, h=$h, corner=0.05 * min($w, $h), r=$r, strands=0, sides=8, detail=1.0, budget=1, age=$age, noise=$noise, index=$index, axis=2, join=none)
  } else {
    add($RingLash, w=$w, h=$h, r=$r, rs=$rs, join=none)
  }
}
# a ROUND cord turn hugging a round member (TK14; TK15: Rope's Turn): a ring of cord of radius r round a pole of radius
# `R`, in its plane XY, centred on its origin; `sx` stretches it in X to an oval round two members side by side; `rs`
# 1 = the game ring (RingWrap), 2 = Rope; `seg` the ring's segments (game)
Wrap = mesh(R=3.0, r=0.5, seg=12, rs=2, sx=1.0, age=0.0, noise=1, index=0) {
  if ($rs > 1.5) {
    add($Rp.Turn, w=2 * $R * max($sx, 1.0), h=2 * $R, corner=$R, r=$r, strands=0, sides=8, detail=1.0, budget=1, age=$age, noise=$noise, index=$index, axis=2, join=none)
  } else {
    add($RingWrap, R=$R, r=$r, seg=$seg, rs=$rs, sx=$sx, join=none)
  }
}
# the GAME budget's ring of rope (the shipped round-10 Lash, kept for the game lines): a ring of rope 2r thick round a w (up) x h (across) bundle, its rims
# rounded 0.9r so the rope's section reads round, not a flat band; in its plane XY, centred on its origin
RingLashHole = plane(w=10.0, h=10.0) { rect(w=$w, h=$h) }

RingLash = mesh(w=20.0, h=20.0, r=1.4, rs=3) {
  rect(w=$w + 4 * $r, h=$h + 4 * $r)
  round(2.4 * $r)
  subtract($RingLashHole, w=$w, h=$h)
  extrude(height=2 * $r)
  round(0.9 * $r, segments=$rs) [top]
  round(0.9 * $r, segments=$rs) [bottom]
  place(by=(0.0, 0.0, -$r))
  uv(auto)
  material($Rope)
}
# the GAME budget's ring of cord (the shipped TK14 Wrap, kept for the game ladder): a ring of cord 2r thick round a pole of radius
# `R`, in its plane XY, centred on its origin; `sx` stretches it in X to an oval (two members side by side; stretched
# before its UV, so the texture keeps its scale); `seg` round the ring, `rs` round the cord
RingWrapHole = plane(R=3.0, seg=12) { circle(radius=$R, segments=$seg) }
RingWrap = mesh(R=3.0, r=0.5, seg=12, rs=2, sx=1.0) {
  circle(radius=$R + 2 * $r, segments=$seg)
  subtract($RingWrapHole, R=$R, seg=$seg)
  extrude(height=2 * $r)
  round(0.9 * $r, segments=$rs) [top]
  round(0.9 * $r, segments=$rs) [bottom]
  place(by=(0.0, 0.0, -$r))
  warp(by=(point.x * (max($sx, 0.2) - 1), 0.0, 0.0))
  uv(auto)
  material($Rope)
}


# a nail's shank, 0.3 cm square, from z = 0 down to -len
NailRod = mesh(len=4.5) {
  rect(w=0.3, h=0.3)
  extrude(height=$len)
  place(by=(0.0, 0.0, -$len))
  uv(box, facing=(0, 0, 1), up=(0, 1, 0), scale=(100.0, 100.0, 100.0))
  material($Iron)
}

# A DECAYED BOARD'S END, ROTTED BACK HARD (round 8; owner: "hard, not soft"; the lead: the ends read "thin and
# papery" as wavy sheets): the end recedes in three BLOCKS across the width, each its own depth, with a few mm of torn
# fibre between the columns, and its top layer stepped back further (a ledge `lg` x the thickness): never a dome or a
# wavy sheet. r0, r1 the -Y and +Y ends' depth (cm; 0 leaves that end); b1, b2 the blocks' edges (x, cm); h1-h3 and
# h4-h6 each block's share; ph the fibre phase. On the board's straight frame (centred on x, bottom z = 0, y 0 to len),
# after `Decay` (which is then called with crumb 0).
EndRot = instruction(w=20.0, t=5.0, len=200.0, r0=0.0, r1=0.0, b1=-2.0, b2=2.0, h1=0.5, h2=0.9, h3=0.4, h4=0.6, h5=0.3, h6=0.9, lg=0.4, ph=0.0) {
  warp(by=(0.0, $r0 * ($h1 + ($h2 - $h1) * clamp(ceil(point.x - $b1), 0, 1) + ($h3 - $h2) * clamp(ceil(point.x - $b2), 0, 1) + 0.0 * sin(2731 * point.x + $ph)) * clamp(1 - point.y / (1.6 * $r0 + 1.0), 0, 1) - $r1 * ($h4 + ($h5 - $h4) * clamp(ceil(point.x + $b2), 0, 1) + ($h6 - $h5) * clamp(ceil(point.x + $b1), 0, 1) + 0.0 * sin(2731 * point.x + 2 * $ph)) * clamp(1 - ($len - point.y) / (1.6 * $r1 + 1.0), 0, 1), -$lg * $t * clamp((point.z - 0.55 * $t) / (0.45 * $t), 0, 1) * (clamp(ceil(0.55 * $r0 - point.y), 0, 1) * clamp(ceil($r0), 0, 1) + clamp(ceil(0.55 * $r1 - ($len - point.y)), 0, 1) * clamp(ceil($r1), 0, 1))))
}

# GOUGES (round 9; the lead against R3: "a few long irregular cracks and gouges of different lengths and depths, broken
# lips along the edges, shallow worn hollows, flat areas between; not dense even grooves"): 2-4 V gouges a plank, each
# its own place across, its own wander, start, length (0.15-0.85 of the plank), depth (0.75-1 x `gd`), its centre on a column of
# the decayed section (`nc` columns between the arrises `a`, `b`) and a half-width of two columns (one where it is shallow), so a gouge is always sampled whole and its walls stay steeper than
# 55 degrees at the weathered depths (the box UV under 1.3; a narrower V falls between columns as a shallow 45-degree dent), NOT locked to the section's columns; the top arrises broken off in irregular runs along both edges, up to
# `lp` cm deep and 1.5-4 cm in, a crisp chamfer; one shallow worn hollow `hd` cm deep; round 10: both long edges wander in
# up to `ew` cm, in long waves and broken runs (the side face moves in over the outer 3.5 cm, so nothing folds). All x the decay `dv`; keyed `k`.
# Round 13 (the lead: "wander the plank, not the gap"): an edge no longer moves IN; each GAP has its own wave (`gl` the
# gap left of this plank, `gr` right, keyed by the floor seed `sd`, along the deck's y: `ys` is where this piece starts; long,
# middle and short (7-16 cm) waves, so an edge breaks rather than bends), and
# both planks either side of a gap follow it, so the edges wander up to `ew` cm while the gap stays a hairline; the deck's two
# outer edges (`nl` lanes; 0 unknown) wander only inward, so the module keeps its bounds.
# On the decayed section's straight frame (centred on x, bottom z = 0, y 0 to len), after `Decay`.
Gouges = instruction(w=20.0, t=5.0, len=200.0, a=0.5, b=0.5, nc=18, dv=0.0, gd=0.0, lp=0.0, hd=0.0, ew=0.0, k=1, ys=0.0, gl=0, gr=1, sd=1, nl=0) {
  warp(by=($ew * ((0.5 * sin(360 * (point.y + $ys) / (120 + 180 * $Hash($sd * 1031 + 37 * $gr, 8101.3 + 3.7 * $gr)) + 360 * $Hash($sd * 1033 + 41 * $gr, 8103.900000000001 + 5.3 * $gr)) + 0.3 * sin(360 * (point.y + $ys) / (30 + 40 * $Hash($sd * 1039 + 43 * $gr, 8106.5 + 7.1 * $gr)) + 360 * $Hash($sd * 1049 + 47 * $gr, 8109.1 + 9.7 * $gr)) + 0.2 * sin(360 * (point.y + $ys) / (7 + 9 * $Hash($sd * 1051 + 53 * $gr, 8111.7 + 11.3 * $gr)) + 360 * $Hash($sd * 1061 + 59 * $gr, 8114.3 + 13.9 * $gr))) * (1 - (clamp(1 - abs($gr - $nl + 1), 0, 1) * clamp(ceil($nl - 0.5), 0, 1))) - abs((0.5 * sin(360 * (point.y + $ys) / (120 + 180 * $Hash($sd * 1031 + 37 * $gr, 8101.3 + 3.7 * $gr)) + 360 * $Hash($sd * 1033 + 41 * $gr, 8103.900000000001 + 5.3 * $gr)) + 0.3 * sin(360 * (point.y + $ys) / (30 + 40 * $Hash($sd * 1039 + 43 * $gr, 8106.5 + 7.1 * $gr)) + 360 * $Hash($sd * 1049 + 47 * $gr, 8109.1 + 9.7 * $gr)) + 0.2 * sin(360 * (point.y + $ys) / (7 + 9 * $Hash($sd * 1051 + 53 * $gr, 8111.7 + 11.3 * $gr)) + 360 * $Hash($sd * 1061 + 59 * $gr, 8114.3 + 13.9 * $gr)))) * (clamp(1 - abs($gr - $nl + 1), 0, 1) * clamp(ceil($nl - 0.5), 0, 1))) * clamp((point.x - (0.5 * $w - 3.5)) / 3.5, 0, 1) + $ew * ((0.5 * sin(360 * (point.y + $ys) / (120 + 180 * $Hash($sd * 1031 + 37 * $gl, 8101.3 + 3.7 * $gl)) + 360 * $Hash($sd * 1033 + 41 * $gl, 8103.900000000001 + 5.3 * $gl)) + 0.3 * sin(360 * (point.y + $ys) / (30 + 40 * $Hash($sd * 1039 + 43 * $gl, 8106.5 + 7.1 * $gl)) + 360 * $Hash($sd * 1049 + 47 * $gl, 8109.1 + 9.7 * $gl)) + 0.2 * sin(360 * (point.y + $ys) / (7 + 9 * $Hash($sd * 1051 + 53 * $gl, 8111.7 + 11.3 * $gl)) + 360 * $Hash($sd * 1061 + 59 * $gl, 8114.3 + 13.9 * $gl))) * (1 - (clamp(1 - abs($gl + 1), 0, 1) * clamp(ceil($nl - 0.5), 0, 1))) + abs((0.5 * sin(360 * (point.y + $ys) / (120 + 180 * $Hash($sd * 1031 + 37 * $gl, 8101.3 + 3.7 * $gl)) + 360 * $Hash($sd * 1033 + 41 * $gl, 8103.900000000001 + 5.3 * $gl)) + 0.3 * sin(360 * (point.y + $ys) / (30 + 40 * $Hash($sd * 1039 + 43 * $gl, 8106.5 + 7.1 * $gl)) + 360 * $Hash($sd * 1049 + 47 * $gl, 8109.1 + 9.7 * $gl)) + 0.2 * sin(360 * (point.y + $ys) / (7 + 9 * $Hash($sd * 1051 + 53 * $gl, 8111.7 + 11.3 * $gl)) + 360 * $Hash($sd * 1061 + 59 * $gl, 8114.3 + 13.9 * $gl)))) * (clamp(1 - abs($gl + 1), 0, 1) * clamp(ceil($nl - 0.5), 0, 1))) * clamp((-1 * point.x - (0.5 * $w - 3.5)) / 3.5, 0, 1), 0.0, -$dv * ($gd * clamp((point.z - 0.6 * $t) / (0.4 * $t), 0, 1) * (clamp(ceil(2 + floor(2.99 * $Hash($k, 6991.7)) - 1 + 0.01), 0, 1) * (0.75 + 0.25 * $Hash($k, 7107.3)) * clamp(1 - abs(point.x - ((0.5 * $w - $b) - floor(((0.5 * $w - $b) - ($w * (-0.36 + 0.72 * $Hash($k, 7098.3)) + 0.1 * $w * sin(360 * point.y / $len * (0.5 + 1.5 * $Hash($k, 7099.9)) + 360 * $Hash($k, 7101.1)))) / (($w - $a - $b) / $nc) + 0.5) * (($w - $a - $b) / $nc))) / ((($w - $a - $b) / $nc) * (1 + clamp(ceil(($gd * $dv * (0.75 + 0.25 * $Hash($k, 7107.3))) - 2.86 * (($w - $a - $b) / $nc)), 0, 1))), 0, 1) * clamp((point.y / $len - ($Hash($k, 7104.3) * (1 - (0.15 + 0.7 * $Hash($k, 7102.7))))) / 0.03, 0, 1) * clamp((($Hash($k, 7104.3) * (1 - (0.15 + 0.7 * $Hash($k, 7102.7)))) + (0.15 + 0.7 * $Hash($k, 7102.7)) - point.y / $len) / 0.03, 0, 1) + clamp(ceil(2 + floor(2.99 * $Hash($k, 6991.7)) - 2 + 0.01), 0, 1) * (0.75 + 0.25 * $Hash($k, 7204.3)) * clamp(1 - abs(point.x - ((0.5 * $w - $b) - floor(((0.5 * $w - $b) - ($w * (-0.36 + 0.72 * $Hash($k, 7195.3)) + 0.1 * $w * sin(360 * point.y / $len * (0.5 + 1.5 * $Hash($k, 7196.9)) + 360 * $Hash($k, 7198.1)))) / (($w - $a - $b) / $nc) + 0.5) * (($w - $a - $b) / $nc))) / ((($w - $a - $b) / $nc) * (1 + clamp(ceil(($gd * $dv * (0.75 + 0.25 * $Hash($k, 7204.3))) - 2.86 * (($w - $a - $b) / $nc)), 0, 1))), 0, 1) * clamp((point.y / $len - ($Hash($k, 7201.3) * (1 - (0.15 + 0.7 * $Hash($k, 7199.7))))) / 0.03, 0, 1) * clamp((($Hash($k, 7201.3) * (1 - (0.15 + 0.7 * $Hash($k, 7199.7)))) + (0.15 + 0.7 * $Hash($k, 7199.7)) - point.y / $len) / 0.03, 0, 1) + clamp(ceil(2 + floor(2.99 * $Hash($k, 6991.7)) - 3 + 0.01), 0, 1) * (0.75 + 0.25 * $Hash($k, 7301.3)) * clamp(1 - abs(point.x - ((0.5 * $w - $b) - floor(((0.5 * $w - $b) - ($w * (-0.36 + 0.72 * $Hash($k, 7292.3)) + 0.1 * $w * sin(360 * point.y / $len * (0.5 + 1.5 * $Hash($k, 7293.9)) + 360 * $Hash($k, 7295.1)))) / (($w - $a - $b) / $nc) + 0.5) * (($w - $a - $b) / $nc))) / ((($w - $a - $b) / $nc) * (1 + clamp(ceil(($gd * $dv * (0.75 + 0.25 * $Hash($k, 7301.3))) - 2.86 * (($w - $a - $b) / $nc)), 0, 1))), 0, 1) * clamp((point.y / $len - ($Hash($k, 7298.3) * (1 - (0.15 + 0.7 * $Hash($k, 7296.7))))) / 0.03, 0, 1) * clamp((($Hash($k, 7298.3) * (1 - (0.15 + 0.7 * $Hash($k, 7296.7)))) + (0.15 + 0.7 * $Hash($k, 7296.7)) - point.y / $len) / 0.03, 0, 1) + clamp(ceil(2 + floor(2.99 * $Hash($k, 6991.7)) - 4 + 0.01), 0, 1) * (0.75 + 0.25 * $Hash($k, 7398.3)) * clamp(1 - abs(point.x - ((0.5 * $w - $b) - floor(((0.5 * $w - $b) - ($w * (-0.36 + 0.72 * $Hash($k, 7389.3)) + 0.1 * $w * sin(360 * point.y / $len * (0.5 + 1.5 * $Hash($k, 7390.9)) + 360 * $Hash($k, 7392.1)))) / (($w - $a - $b) / $nc) + 0.5) * (($w - $a - $b) / $nc))) / ((($w - $a - $b) / $nc) * (1 + clamp(ceil(($gd * $dv * (0.75 + 0.25 * $Hash($k, 7398.3))) - 2.86 * (($w - $a - $b) / $nc)), 0, 1))), 0, 1) * clamp((point.y / $len - ($Hash($k, 7395.3) * (1 - (0.15 + 0.7 * $Hash($k, 7393.7))))) / 0.03, 0, 1) * clamp((($Hash($k, 7395.3) * (1 - (0.15 + 0.7 * $Hash($k, 7393.7)))) + (0.15 + 0.7 * $Hash($k, 7393.7)) - point.y / $len) / 0.03, 0, 1)) + $lp * (clamp(ceil(sin(360 * point.y / $len * (2 + 3 * $Hash($k, 7601.1)) + 360 * $Hash($k, 7602.3)) + sin(360 * point.y / $len * (5 + 4 * $Hash($k, 7603.7)) + 360 * $Hash($k, 7604.9)) - 0.9), 0, 1) * clamp(1 - (0.5 * $w - 1 * point.x) / (1.5 + 2.5 * $Hash($k, 7606.1)), 0, 1) * clamp((point.z - 0.45 * $t) / (0.55 * $t), 0, 1) + clamp(ceil(sin(360 * point.y / $len * (2 + 3 * $Hash($k, 7701.1)) + 360 * $Hash($k, 7702.3)) + sin(360 * point.y / $len * (5 + 4 * $Hash($k, 7703.7)) + 360 * $Hash($k, 7704.9)) - 0.9), 0, 1) * clamp(1 - (0.5 * $w - -1 * point.x) / (1.5 + 2.5 * $Hash($k, 7706.1)), 0, 1) * clamp((point.z - 0.45 * $t) / (0.55 * $t), 0, 1)) + $hd * clamp((point.z - 0.6 * $t) / (0.4 * $t), 0, 1) * clamp(1 - ((point.y / $len - (0.2 + 0.6 * $Hash($k, 7801.3))) / (0.08 + 0.1 * $Hash($k, 7803.7))) * ((point.y / $len - (0.2 + 0.6 * $Hash($k, 7801.3))) / (0.08 + 0.1 * $Hash($k, 7803.7))) - ((point.x - $w * (0.3 * $Hash($k, 7805.9) - 0.15)) / (0.3 * $w)) * ((point.x - $w * (0.3 * $Hash($k, 7805.9) - 0.15)) / (0.3 * $w)), 0, 1))))
}

# ALONG-GRAIN GROOVES (round 8; R3, the owner's weathered walkway: crisp dark grooves over every top, not ribs): a
# share `gs` of the top's even columns (never two side by side, never the two at each arris) sunk into sharp V grooves up to `gd` cm (x the decay), each its own depth, each
# running for a long stretch and fading out (a groove line every so often, flat weathered wood between). On the
# decayed section's straight frame, after `Decay`; `nc` its columns, `ph` the board's phase.
Grooves = instruction(w=20.0, t=5.0, a=0.5, b=0.5, nc=18, dv=0.0, gd=0.0, gs=0.35, ph=0.0) {
  warp(by=(0.0, 0.0, -$gd * $dv * clamp((point.z - 0.6 * $t) / (0.4 * $t), 0, 1) * clamp(1 - abs(floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5) - 2 * floor(floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5) / 2)), 0, 1) * clamp(ceil(floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5) - 1.5), 0, 1) * clamp(ceil($nc - 1.5 - floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5)), 0, 1) * clamp(ceil($gs - (sin(floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5) * 12.9898 + $ph) * 43758.5453 - floor(sin(floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5) * 12.9898 + $ph) * 43758.5453))), 0, 1) * (0.7 + 0.3 * (sin(floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5) * 78.233 + $ph) * 43758.5453 - floor(sin(floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5) * 78.233 + $ph) * 43758.5453))) * clamp(ceil(0.75 + sin(1.7 * point.y + 53 * floor((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) + 0.5) + $ph)), 0, 1)))
}

# OLD WOOD (OW1, 20 Nov 2026; owner: "Can author now makes any wooden things and have this 'old wood treatment'? Like making a
# large pillar for the temple and have it a bit aged"): the age of ANY wooden shape you have built, in its own grain, as
# OPT-IN TREATMENTS on the shape being built (as Weather's `$W.Snow(...)`; owner: "declare what to reuse, the rot, the cracks"):
# WoodPoints, Wear, Rot, Erosion, Checks, EndCracks, Bend, each its own instruction, called in that order; or all at one `age`
# with `OldWood(...)` (below, with the knobs table). `Member(...)` builds one wooden member and takes the same. Measured from the
# Commons photos in `Saved/Gate/Reference/OldWood/` (the table in `Docs/GC-SHAPE-DAMAGE-KIT-ROUNDS.md` "OW1").
#
#   Kit    = shape('/GraphCodeShape/Presets/TimberKit', Face = $Oak, Broken = $OakEnd)
#   Pillar = mesh() { circle(radius=22.5)  extrude(height=400)  $Kit.OldWood(along=[(0, 0, 1)], size=45, age=1, noise=3) }
#   Beam   = mesh() { add($Kit.Member, profile=1, size=20, width=30, length=300, age=0, rotate=(0, -90, 0))
#                     $Kit.OldWood(along=[(1, 0, 0)], size=20, age=1.5, py=15, length=300) }   (a beam laid along X, aged in X)
#
# WHAT IT DOES, in this order (each one HARD, kit section 12.3: breaks and V checks, never pillows):
#   (1) points across the grain where the surface needs them (fewer at `budget=0`, Game)
#   (2) WEAR on convex parts only (`curvature()`): arrises, carved ridges and tips worn back a few mm, hollows kept, in steep
#       breakouts (a sharpened noise; `cell()` jumps threw shards off dense rims), never a round-over
#   (3) ROT AND LOSS AT THE FOOT (from age 0.3: a pillar standing on its stone at age 1 has lost a little of its foot, photo 03): blocky bites up to `rot` cm deep in the lowest `fh` cm, ragged top
#   (4) GRAIN EROSION: sharp latewood ridges standing between eroded earlywood, long ALONG `along` (12:1), deeper at the
#       foot (`foot`) and where the sky is open (`weather_side`, `sky()`: tops and outer faces more, undersides less)
#   (5) CHECKS: long V checks ALONG the grain, RADIAL to the pith line (`px`, `py`), opening outward, deeper than wide, each
#       its own length (2-6 x `size`), closing to a hairline at both ends, following a spiral grain (`spiral` degrees); on a
#       cut end the same checks run in as radial end checks (`endc` of the radius). Crisp: the V is a creased profile, so
#       its lips and floor are cut into the mesh as hard lines wherever it is drawn (GCSHAPE.md "declared creases").
# THE GRAIN FRAME: `along` is the grain direction in the shape's own axes (any direction; X, Y or Z buy points along
# and across it cheaply, an oblique one buys them evenly); the PITH LINE runs along it through `(px, py)`, measured on the two
# directions across it (along Z: px on X, py on Y; along X: px on Y, py on Z; along Y: px on Z, py on X); `base` is where
# the foot is, in cm along `along` (0: the shape stands on its own origin, as every kit frame does).
# Every knob is clamped to its range; a knob at -1 is taken from `age` (the photo values beside it, at age 1 and age 2).
#   knob          default unit      range        what it does
#   along     [(0,0,1)] direction              the grain, a one-entry list (a bare tuple's components cannot be read)
#   size               40 cm        [2..500]     the member's thickness (a pillar's diameter): every derived length scales with it
#   age                 1 0-2       [0..2]       0 new (nothing moves), 1 aged (a temple pillar "a bit aged"), 2 old and weathered
#   checks             -1 count     [0..60]      checks around the member at any one place along it [one every 14 cm of girth at age 1:
#                                                10 round a 45 cm pillar, 3-4 round a 15 cm post (photos 02, 04); half as many again at 2 (r5: uneven, one dominant)]
#   erosion            -1 cm        [0..1.5]     ring erosion: earlywood eaten, latewood ridges standing along the grain [1.6 mm on 45 cm at 1, 7.7 mm at 2]
#   wear               -1 cm        [0..3]       convex wear depth [0.25 at 1, 0.6 at 2; less below size 30]
#   foot               -1 x         [0..3]       extra erosion and checking in the foot zone (x (1 + 2 foot)) [0.5 at 1, 1 at 2]
#   weather_side       -1 0-1       [0..1]       how much more the open side weathers (sky()) [0.6]
#   noise               1 int                    the seed
#   budget              1 0/1/2     [0..2]       0 Game: points ~2.5 cm apart, half the checks, half as long again, no erosion or
#                                                hollows (write `[triangles=]` on the build line); 1 High: points every size/25 across,
#                                                never under 1 cm (finer grain is the material's); 2 Ultra: x 0.62
#   base                0 cm                     the foot's place along `along`
#   px, py              0 cm                     the pith line, across the grain (see THE GRAIN FRAME)
#   spiral             -1 deg       [0..15]      spiral grain: the checks lean this much off `along` [3]
#   clen               -1 x size    [0.5..20]    a check's typical length [8: long and thin, following the grain]
#   mouth              -1 cm        [0..10]      a check's width at the surface [0.015 x size at 1 (r7: 0.012 was ~1 px on a 4 m pillar seen whole), 0.032 x size at 2]
#   cdepth             -1 cm        [0..100]     a check's depth [5 x mouth, at most 0.3 x size]
#   share              -1 0-1       [0.05..0.95] how much of each check line is open [0.65]
#   endc               -1 x radius  [0..1]       how far end checks run in from the rim [0.35 at 1, 0.5 at 2]
#   rot                -1 cm        [0..50]      the foot's loss depth [0 below age 0.3, 0.05 x size at 1 (2.3 cm on a 45 cm pillar), 0.08 x size at 2]
#   relief             -1 cm        [0..5]       RETIRED r5 (broad hollows read as cloth draped on the shaft): kept as a knob, does nothing
#   fh                 -1 cm        [0..1000]    the foot zone's height [0.6 x size]
#   length             -1 cm                     the member's length from `base`, when known (Member passes it): checks ease out
#                                                at the cut ends and end cracks stop short of the rim, so the rim keeps its points
#   slabs              -1 count     [0..6]       SLAB LOSS (photo 01): flat shelves split off along the grain, bounded by a check,
#                                                torn off in steps at both ends [none below age 1.3; 1 at 1.5, 2 at 2 per 2 x size]
#   holes              -1 count     [0..4]       ROT HOLES: round cavities wider inside than at the mouth [none below 1.6; 2 at 2]
#   ease               -1 cm        [0..5]       the worn soft rim: every cut end eased inward, smoothly [0.004 x size at 1, 0.016 at 2]
#   top, bulge      1, 0 x                       the member's taper and entasis (Member passes them), so a shelf's depth is from its face
#   cut                 0 0/1                    1: the checks are CUT (a thin V subtracted along the grain: crisp at any width, no creases);
#                                                Member passes 1 with its section (`hw`, `hh` half sizes; -1 round); 0 the sampled V
#                                                (any carved shape whose section is not known)
OwDot = formula(x, y, z, a, b, c, o) { $x * $a + $y * $b + $z * $c - $o }
OwCos = formula(u, v, s, k) { ($u * cos($k * $s) - $v * sin($k * $s)) / sqrt($u * $u + $v * $v + 0.0001) }
OwSin = formula(u, v, s, k) { ($u * sin($k * $s) + $v * cos($k * $s)) / sqrt($u * $u + $v * $v + 0.0001) }
OwPick = formula(v, d) { $v + (1 - clamp(ceil($v + 0.5), 0, 1)) * ($d - $v) }
OwV = profile(0 = 0@sharp, 0.5 = 1@sharp, 1 = 0@sharp) [linear]
OwV1 = profile(0 = 0, 0.5 = 1@sharp, 1 = 0) [linear]

# ---- the TREATMENTS: each its own instruction on the shape being built (as Weather's `$W.Snow(...)`); call only the ones you
# want, in this order, after building the member. Each NEEDS the grain (`along`, `size`, the pith `px`, `py`, the foot `base`)
# and POINTS across the grain: call `WoodPoints` first, or have built them yourself. `OldWood(age=)` calls the usual set.

# POINTS across the grain (and fewer along it), by a near-still roughen whose cells are long along the grain: across every
# min(size/25, pi size / 12 checks), never under 1 cm (Game 2.5 cm); the cut ends every size/50 (never under 0.5 cm)
#   count -1 the checks the points are for [pi size / 14]
WoodPoints = instruction(along=[(0, 0, 1)], size=40.0, count=-1.0, noise=1, budget=1, length=-1.0, base=0.0) {
  $D = clamp($size, 2, 500)
  $R = 0.5 * $D
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $gm = clamp(ceil(0.5 - $bg), 0, 1)
  $K = floor($noise) * 1009 + 71
  # the grain, normalised, and two directions across it (e1 level when the grain is not upright)
  $gn = sqrt($along[0].x * $along[0].x + $along[0].y * $along[0].y + $along[0].z * $along[0].z) + 0.000001
  $ax = $along[0].x / $gn
  $ay = $along[0].y / $gn
  $az = $along[0].z / $gn
  $up = clamp(ceil(abs($az) - 0.9), 0, 1)
  $f1 = (1 - $up) * (0 - $ay) + $up * (1 - $ax * $ax)
  $f2 = (1 - $up) * $ax + $up * (0 - $ax * $ay)
  $f3 = $up * (0 - $ax * $az)
  $fn = sqrt($f1 * $f1 + $f2 * $f2 + $f3 * $f3) + 0.000001
  $e1x = $f1 / $fn
  $e1y = $f2 / $fn
  $e1z = $f3 / $fn
  $e2x = $ay * $e1z - $az * $e1y
  $e2y = $az * $e1x - $ax * $e1z
  $e2z = $ax * $e1y - $ay * $e1x
  $N = clamp($OwPick($count, 3.14159 * $D / 14), 0, 60) * (1 - 0.5 * $gm)
  # r9: under 40 cm the across spacing floor falls toward 0.3 cm (0.025 x size): on a 14 cm post the fibre ridges (2.5 cm apart)
  # sampled every ~1 cm on irregular points drew zigzag bands; the points are cheap there (about 2,000 on a 14 cm x 160 cm post)
  $fl = clamp(0.025 * $D, 0.3, 1) * (1 + 1.5 * $gm) * (1 - 0.38 * max($bg - 1, 0))
  # (1) POINTS across the grain (and fewer along it), bought by a near-still roughen whose cells are long along the grain
  # across the grain every min(size/25, pi size / 12 checks), never under $fl (1 cm High, 2.5 cm Game): the checks' creased
  # lines stay under the build's allowance (half the mesh's own triangles); where that would need finer points ($fine), only
  # the checks' floors are creased (OwV1: a third of the lines), so many checks on old wood cost no more points
  $dA = 3 * max($fl, min(0.04 * $D * (1 + 2 * $gm), 3.14159 * $D / (12 * max($N, 1))))
  $dL = max(0.6 * $D, 6) * (1 + $gm) * (1 - 0.38 * max($bg - 1, 0))
  if (abs($az) > 0.9) {
    roughen(by=0.01, scale=($dA, $dA, $dL), seed=$K + 1) [value=abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az), below=0.6]
  } else {
    if (abs($ax) > 0.9) {
      roughen(by=0.01, scale=($dL, $dA, $dA), seed=$K + 1) [value=abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az), below=0.6]
    } else {
      if (abs($ay) > 0.9) {
        roughen(by=0.01, scale=($dA, $dL, $dA), seed=$K + 1) [value=abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az), below=0.6]
      } else {
        roughen(by=0.01, scale=$dA, seed=$K + 1) [value=abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az), below=0.6]
      }
    }
  }
  # the rim band (r7): within a row of either cut end the long faces take points every ~0.8 cm both ways, so the eased rim is
  # round and the end of every check, ridge and slab lands on points (the 9 cm rows threw a fringe of spikes there at age 2)
  $Lx = $length + (1 - clamp(ceil($length), 0, 1)) * (1000000 - $length)
  $wb = $dL / 3 + max(2, 0.06 * $D)
  $dR = max(2.4, min($dA, 0.09 * $D)) * (1 + $gm)
  if (abs($az) > 0.9) {
    roughen(by=0.01, scale=($dA, $dA, $dR), seed=$K + 9) [value=min($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base), $Lx - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base)) + 100000 * clamp(ceil(abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az) - 0.6), 0, 1), below=$wb]
  } else {
    if (abs($ax) > 0.9) {
      roughen(by=0.01, scale=($dR, $dA, $dA), seed=$K + 9) [value=min($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base), $Lx - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base)) + 100000 * clamp(ceil(abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az) - 0.6), 0, 1), below=$wb]
    } else {
      if (abs($ay) > 0.9) {
        roughen(by=0.01, scale=($dA, $dR, $dA), seed=$K + 9) [value=min($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base), $Lx - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base)) + 100000 * clamp(ceil(abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az) - 0.6), 0, 1), below=$wb]
      } else {
        roughen(by=0.01, scale=$dR, seed=$K + 9) [value=min($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base), $Lx - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base)) + 100000 * clamp(ceil(abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az) - 0.6), 0, 1), below=$wb]
      }
    }
  }
  # the cut ends: points every size/50 (never under 0.5 cm; Game twice that) for the end checks
  roughen(by=0.01, scale=max(0.06 * $D, 1.5) * (1 + $gm), seed=$K + 8) [value=abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az), above=0.6]
}

# WEAR on convex parts only (`curvature()`): arrises, carved ridges and tips worn back, hollows kept, in steep breakouts,
# never a round-over; more where the sky is open. Needs points on the arrises.
#   amount 0.25 cm [0..3] the deepest wear     weather_side 0.6 [0..1] how much more the sky-open faces wear
Wear = instruction(amount=0.25, size=40.0, weather_side=0.6, noise=1, along=[(0, 0, 1)], length=-1.0, base=0.0, px=0.0, py=0.0) {
  $D = clamp($size, 2, 500)
  $R = 0.5 * $D
  # the grain, normalised, and two directions across it (e1 level when the grain is not upright)
  $gn = sqrt($along[0].x * $along[0].x + $along[0].y * $along[0].y + $along[0].z * $along[0].z) + 0.000001
  $ax = $along[0].x / $gn
  $ay = $along[0].y / $gn
  $az = $along[0].z / $gn
  $up = clamp(ceil(abs($az) - 0.9), 0, 1)
  $f1 = (1 - $up) * (0 - $ay) + $up * (1 - $ax * $ax)
  $f2 = (1 - $up) * $ax + $up * (0 - $ax * $ay)
  $f3 = $up * (0 - $ax * $az)
  $fn = sqrt($f1 * $f1 + $f2 * $f2 + $f3 * $f3) + 0.000001
  $e1x = $f1 / $fn
  $e1y = $f2 / $fn
  $e1z = $f3 / $fn
  $e2x = $ay * $e1z - $az * $e1y
  $e2y = $az * $e1x - $ax * $e1z
  $e2z = $ax * $e1y - $ay * $e1x
  # off the cut ends' rims (r7): the rim is eased by Erosion's smooth `ease`; a wear along the normal there turned 521 triangles over
  $Lx = $length + (1 - clamp(ceil($length), 0, 1)) * (1000000 - $length)
  $we = max(2, 0.06 * $D)
  $K = floor($noise) * 1009 + 71
  $W = clamp($amount, 0, 3)
  $ws = clamp($weather_side, 0, 1)
  # r7: worn INWARD toward the pith line, not along the normal: a check's or a shelf's lip then slides down its own wall (the
  # walls are radial) and cannot fold over (along the normal it turned 4,047 triangles over at the shelves' lips)
  if ($W > 0.005) {
    warp(by=(0 - ($W * clamp((curvature() - 0.15) / 0.5, 0, 1) * (0.5 + 0.5 * clamp(0.5 + noise(point.x / (0.12 * $D + 2), point.y / (0.12 * $D + 2), point.z / (0.12 * $D + 2), $K + 2), 0, 1)) * clamp(1 + $ws * (2 * sky() - 1), 0.3, 2) * clamp((min($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base), $Lx - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base)) - 0.5 * $we) / (0.5 * $we), 0, 1)) * ($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) * $e1x + $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) * $e2x) / (sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) + 0.001), 0 - ($W * clamp((curvature() - 0.15) / 0.5, 0, 1) * (0.5 + 0.5 * clamp(0.5 + noise(point.x / (0.12 * $D + 2), point.y / (0.12 * $D + 2), point.z / (0.12 * $D + 2), $K + 2), 0, 1)) * clamp(1 + $ws * (2 * sky() - 1), 0.3, 2) * clamp((min($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base), $Lx - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base)) - 0.5 * $we) / (0.5 * $we), 0, 1)) * ($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) * $e1y + $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) * $e2y) / (sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) + 0.001), 0 - ($W * clamp((curvature() - 0.15) / 0.5, 0, 1) * (0.5 + 0.5 * clamp(0.5 + noise(point.x / (0.12 * $D + 2), point.y / (0.12 * $D + 2), point.z / (0.12 * $D + 2), $K + 2), 0, 1)) * clamp(1 + $ws * (2 * sky() - 1), 0.3, 2) * clamp((min($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base), $Lx - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base)) - 0.5 * $we) / (0.5 * $we), 0, 1)) * ($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) * $e1z + $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) * $e2z) / (sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) + 0.001)))
  }
}

# ROT AND LOSS AT THE FOOT: LOSS, a concave band eaten INWARD along the radius (r5, owner: "rot is loss ... not a frill sticking
# out"): deepest at the base, easing smoothly to nothing 0.55-0.9 fh up (its top uneven round the girth), fibres along the grain
# inside it; the end face in the zone shrinks with it (the move scales with the radius), so no flange is left and
# nothing leaves the section.
#   amount -1 cm [0..50] [0.05 x size at age 1]     fh -1 cm [0..1000] the foot zone [0.6 x size]
Rot = instruction(along=[(0, 0, 1)], size=40.0, amount=-1.0, fh=-1.0, base=0.0, px=0.0, py=0.0, noise=1, budget=1) {
  $D = clamp($size, 2, 500)
  $R = 0.5 * $D
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $gm = clamp(ceil(0.5 - $bg), 0, 1)
  $K = floor($noise) * 1009 + 71
  # the grain, normalised, and two directions across it (e1 level when the grain is not upright)
  $gn = sqrt($along[0].x * $along[0].x + $along[0].y * $along[0].y + $along[0].z * $along[0].z) + 0.000001
  $ax = $along[0].x / $gn
  $ay = $along[0].y / $gn
  $az = $along[0].z / $gn
  $up = clamp(ceil(abs($az) - 0.9), 0, 1)
  $f1 = (1 - $up) * (0 - $ay) + $up * (1 - $ax * $ax)
  $f2 = (1 - $up) * $ax + $up * (0 - $ax * $ay)
  $f3 = $up * (0 - $ax * $az)
  $fn = sqrt($f1 * $f1 + $f2 * $f2 + $f3 * $f3) + 0.000001
  $e1x = $f1 / $fn
  $e1y = $f2 / $fn
  $e1z = $f3 / $fn
  $e2x = $ay * $e1z - $az * $e1y
  $e2y = $az * $e1x - $ax * $e1z
  $e2z = $ax * $e1y - $ay * $e1x
  $rt = clamp($OwPick($amount, 0.07 * $D), 0, 50)
  $Fz = clamp($OwPick($fh, 0.6 * $D), 0, 1000)
  if ($rt > 0.01) {
    warp(by=(0 - $rt * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1) * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1) * (3 - 2 * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1)) * (0.75 + 0.25 * clamp(0.5 + noise(2.5 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0) * $R / max($Fz, 1), 2.5 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0) * $R / max($Fz, 1), $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / (0.6 * max($Fz, 0.01)), $K + 4), 0, 1)) * clamp(sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $R, 0, 1) * ($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) * $e1x + $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) * $e2x) / (sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) + 0.001), 0 - $rt * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1) * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1) * (3 - 2 * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1)) * (0.75 + 0.25 * clamp(0.5 + noise(2.5 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0) * $R / max($Fz, 1), 2.5 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0) * $R / max($Fz, 1), $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / (0.6 * max($Fz, 0.01)), $K + 4), 0, 1)) * clamp(sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $R, 0, 1) * ($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) * $e1y + $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) * $e2y) / (sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) + 0.001), 0 - $rt * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1) * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1) * (3 - 2 * clamp(1 - $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / ($Fz * (0.55 + 0.35 * clamp(0.5 + noise(1.2 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.2 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 0, $K + 3), 0, 1))), 0, 1)) * (0.75 + 0.25 * clamp(0.5 + noise(2.5 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0) * $R / max($Fz, 1), 2.5 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0) * $R / max($Fz, 1), $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / (0.6 * max($Fz, 0.01)), $K + 4), 0, 1)) * clamp(sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $R, 0, 1) * ($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) * $e1z + $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) * $e2z) / (sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) + 0.001)))
  }
}

# GRAIN EROSION: fibre relief: latewood crests standing between eroded earlywood, long ALONG the grain, at most a millimetre,
# moved INWARD along the radius on the long faces only (r5: never along a normal, never out of the section)
# deeper at the foot and where the sky is open. High and Ultra only (Game: the material).
#   amount -1 cm [0..0.5] crest relief [0.002 x size, at most 0.1]   relief: retired (does nothing)
#   foot 0.5 x [0..3] x (1 + 2 foot) in the foot zone   fh -1 cm [0.6 x size]   weather_side 0.6 [0..1]
Erosion = instruction(along=[(0, 0, 1)], size=40.0, amount=-1.0, relief=-1.0, foot=0.5, fh=-1.0, weather_side=0.6, base=0.0, px=0.0, py=0.0, noise=1, budget=1, length=-1.0, ease=0.0, top=1.0) {
  $D = clamp($size, 2, 500)
  $R = 0.5 * $D
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $gm = clamp(ceil(0.5 - $bg), 0, 1)
  $K = floor($noise) * 1009 + 71
  # the grain, normalised, and two directions across it (e1 level when the grain is not upright)
  $gn = sqrt($along[0].x * $along[0].x + $along[0].y * $along[0].y + $along[0].z * $along[0].z) + 0.000001
  $ax = $along[0].x / $gn
  $ay = $along[0].y / $gn
  $az = $along[0].z / $gn
  $up = clamp(ceil(abs($az) - 0.9), 0, 1)
  $f1 = (1 - $up) * (0 - $ay) + $up * (1 - $ax * $ax)
  $f2 = (1 - $up) * $ax + $up * (0 - $ax * $ay)
  $f3 = $up * (0 - $ax * $az)
  $fn = sqrt($f1 * $f1 + $f2 * $f2 + $f3 * $f3) + 0.000001
  $e1x = $f1 / $fn
  $e1y = $f2 / $fn
  $e1z = $f3 / $fn
  $e2x = $ay * $e1z - $az * $e1y
  $e2y = $az * $e1x - $ax * $e1z
  $e2z = $ax * $e1y - $ay * $e1x
  $E = clamp($OwPick($amount, 0.0035 * $D), 0, 1.5) * min($bg, 1)
  # ring spacing (cm) and how many ridges round the member: about one every 2 cm of girth
  $sp = clamp(0.012 * $D, 0.4, 0.9)
  $kr = max($D / 10, 0.5)
  $spe = max(2 * max(0.06 * $D, 1.5) / 3, 1)
  $M = 0
  $Ft = clamp($foot, 0, 3)
  $Fz = clamp($OwPick($fh, 0.6 * $D), 0, 1000)
  $ws = clamp($weather_side, 0, 1)
  $Sr = max(0.12 * $D, 3) * (1 - 0.38 * max($bg - 1, 0))
  $re = 3.14159 * $D / $Sr / 5.6
  $Le = 0.6 * $D
  $rm = 1.87
  $Lm = 1.5 * $D
