# the aging of a board (or of a broken board) in its own frame, in this order: each top arris's round shrinks
# toward its corner along the length (wa, wb: the most it shrinks; rm: the larger radius, which finds the round's
# points), then cup, bow and crook, the ends off square; round 2: the width and thickness along it (taper, a waney
# edge, ttap), sag between supports, a sprung end, twist, roll and pitch; last the yaw about its middle and the lift
Age = instruction(w=20.0, t=5.0, len=200.0, cupv=0.0, bowv=0.0, crookv=0.0, e0=0.0, e1=0.0, yawv=0.0, liftv=0.0, rm=0.0, wa=0.0, wb=0.0, ph=0.0, fr=1.0, twistv=0.0, taperv=0.0, wanev=0.0, wanek=1.0, wanes=1.0, ttapv=0.0, pitchv=0.0, rollv=0.0, curlv=0.0, curlf=0.5, curls=0, sagv=0.0, sag0=0.25, sag1=0.75, softv=0.0) {
  if ($rm * ($wa + $wb) > 0.0001) {
    warp(by=($wb * (0.5 + 0.5 * sin(360 * $fr * clamp(point.y / $len, 0, 1) + $ph)) * (0.5 * $w - point.x) * clamp(ceil(point.x - (0.5 * $w - $rm - 0.01)), 0, 1) * clamp(ceil(point.z - ($t - $rm - 0.01)), 0, 1) + $wa * (0.5 + 0.5 * sin(360 * $fr * clamp(point.y / $len, 0, 1) + $ph + 137)) * (-0.5 * $w - point.x) * clamp(ceil((-0.5 * $w + $rm + 0.01) - point.x), 0, 1) * clamp(ceil(point.z - ($t - $rm - 0.01)), 0, 1), 0.0, ($wb * (0.5 + 0.5 * sin(360 * $fr * clamp(point.y / $len, 0, 1) + $ph)) * clamp(ceil(point.x - (0.5 * $w - $rm - 0.01)), 0, 1) * clamp(ceil(point.z - ($t - $rm - 0.01)), 0, 1) + $wa * (0.5 + 0.5 * sin(360 * $fr * clamp(point.y / $len, 0, 1) + $ph + 137)) * clamp(ceil((-0.5 * $w + $rm + 0.01) - point.x), 0, 1) * clamp(ceil(point.z - ($t - $rm - 0.01)), 0, 1)) * ($t - point.z)))
  }
  if (abs($cupv) + abs($bowv) + abs($crookv) > 0.0001) {
    warp(by=($crookv * sin(180 * clamp(point.y / $len, 0, 1)), 0.0, $cupv * ((1 - $softv) * abs(2 * point.x / $w) + $softv * (2 * point.x / $w) * (2 * point.x / $w)) + $bowv * sin(180 * clamp(point.y / $len, 0, 1))))
  }
  if (abs($e0) + abs($e1) > 0.0001) {
    warp(by=(0.0, point.x * (tan($e0) * (1 - clamp(point.y / $len, 0, 1)) + tan($e1) * clamp(point.y / $len, 0, 1)), 0.0))
  }
  if (abs($taperv) + abs($wanev) + abs($ttapv) > 0.0001) {
    warp(to=(point.x * (1 + $taperv * (clamp(point.y / $len, 0, 1) - 0.5)) + $wanev * clamp($wanes * point.x / (0.5 * $w), 0, 1) * ($softv * sin(180 * $wanek * clamp(point.y / $len, 0, 1) + 57 * $wanek) - (1 - $softv) * clamp(3 * (sin(410 * clamp(point.y / $len, 0, 1) + 57 * $wanek) + 0.7 * sin(970 * clamp(point.y / $len, 0, 1) + 131 * $wanek) - 0.9), 0, 1)), point.y, point.z * (1 + $ttapv * (clamp(point.y / $len, 0, 1) - 0.5))))
  }
  if (abs($sagv) > 0.0001) {
    warp(by=(0.0, 0.0, -$sagv * sin(180 * clamp((clamp(point.y / $len, 0, 1) - $sag0) / max($sag1 - $sag0, 0.05), 0, 1))))
  }
  if (abs($curlv) > 0.0001) {
    warp(by=(0.0, 0.0, $curlv * (max(abs($curls - clamp(point.y / $len, 0, 1)) - $curlf, 0) / max(1 - $curlf, 0.05)) * (max(abs($curls - clamp(point.y / $len, 0, 1)) - $curlf, 0) / max(1 - $curlf, 0.05))))
  }
  if (abs($twistv) + abs($rollv) > 0.0001) {
    warp(to=(point.x * cos(($rollv + $twistv * (clamp(point.y / $len, 0, 1) - 0.5))) - (point.z - 0.5 * $t) * sin(($rollv + $twistv * (clamp(point.y / $len, 0, 1) - 0.5))), point.y, 0.5 * $t + point.x * sin(($rollv + $twistv * (clamp(point.y / $len, 0, 1) - 0.5))) + (point.z - 0.5 * $t) * cos(($rollv + $twistv * (clamp(point.y / $len, 0, 1) - 0.5)))))
  }
  if (abs($pitchv) > 0.0001) {
    warp(by=(0.0, 0.0, (point.y - 0.5 * $len) * tan($pitchv)))
  }
  if (abs($yawv) + abs($liftv) > 0.0001) {
    warp(to=(point.x * cos($yawv) - (point.y - 0.5 * $len) * sin($yawv), 0.5 * $len + point.x * sin($yawv) + (point.y - 0.5 * $len) * cos($yawv), point.z + $liftv))
  }
}

# DECAY (round 2): a board's bad condition, on the `DecaySec` section in its straight frame, BEFORE `Age` bends it.
#   dv       0-1, how decayed (0 changes nothing); ridge cm: the top eroded to ridges along the grain
#   cd1-cd3  open checks (cm deep) on top columns cx1-cx3, each from cy to cy + cl along it (fractions); the third
#            starts at the -Y end (an end split)
#   crumb    cm: both ends rounded and crumbled back, ragged across the width (crf the -Y end's share, crb the +Y
#            end's: 0 on a snapped end)
#   sl, sly  a sliver split off the +X edge from sly to sly + 0.35 of the length (sl 1)
#   co, coe, cos  a corner missing (co 1) at the -Y (coe 0) or +Y end, on the +X (cos 1) or -X side
#   softv    0 crisp (sharp ridge crests, V checks with lips, stepped fibrous ends); 1 worn round (soft ridges, domed ends)
Decay = instruction(w=20.0, t=5.0, len=200.0, a=0.5, b=0.5, dv=0.0, ridge=0.45, ph=0.0, cd1=0.0, cd2=0.0, cd3=0.0, cx1=5, cx2=9, cx3=13, cy1=0.1, cl1=0.5, cy2=0.5, cl2=1.0, cy3=0.0, cl3=0.3, crumb=4.0, crf=0.7, sl=0, sly=0.3, co=0, coe=0, cos=1, nc=18, crb=1.0, softv=0.0) {
  if ($dv > 0.001) {
    warp(by=(0.0, 0.0, -$ridge * $dv * clamp((point.z - 0.55 * $t) / (0.45 * $t), 0, 1) * ((1 - $softv) * abs(sin((97 * point.x + $ph + 40 * sin(1.3 * point.y + $ph) + 30 * sin(53 * point.x)))) + $softv * (0.5 + 0.5 * sin((97 * point.x + $ph + 40 * sin(1.3 * point.y + $ph) + 30 * sin(53 * point.x)))) * (0.5 + 0.5 * sin((97 * point.x + $ph + 40 * sin(1.3 * point.y + $ph) + 30 * sin(53 * point.x)))))))
    warp(by=(0.0, 0.0, -clamp((point.z - 0.55 * $t) / (0.45 * $t), 0, 1) * ($cd1 * (clamp(1 - abs((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) - $cx1 * $nc / 18), 0, 1) - 0.18 * (1 - $softv) * clamp(1 - 2 * abs(abs((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) - $cx1 * $nc / 18) - 1), 0, 1)) * clamp((clamp(point.y / $len, 0, 1) - $cy1) / 0.08 + 1, 0, 1) * clamp(($cy1 + $cl1 - clamp(point.y / $len, 0, 1)) / 0.08 + 1, 0, 1) + $cd2 * (clamp(1 - abs((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) - $cx2 * $nc / 18), 0, 1) - 0.18 * (1 - $softv) * clamp(1 - 2 * abs(abs((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) - $cx2 * $nc / 18) - 1), 0, 1)) * clamp((clamp(point.y / $len, 0, 1) - $cy2) / 0.08 + 1, 0, 1) * clamp(($cy2 + $cl2 - clamp(point.y / $len, 0, 1)) / 0.08 + 1, 0, 1) + $cd3 * (clamp(1 - abs((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) - $cx3 * $nc / 18), 0, 1) - 0.18 * (1 - $softv) * clamp(1 - 2 * abs(abs((0.5 * $w - $b - point.x) / max(($w - $a - $b) / $nc, 0.01) - $cx3 * $nc / 18) - 1), 0, 1)) * clamp((clamp(point.y / $len, 0, 1) - $cy3) / 0.08 + 1, 0, 1) * clamp(($cy3 + $cl3 - clamp(point.y / $len, 0, 1)) / 0.08 + 1, 0, 1))))
    warp(by=(0.0, $dv * (clamp(1 - point.y / max($crumb * $crf, 0.5), 0, 1) * $crumb * $crf * 0.6 * ((1 - $softv) * (0.3 + 0.35 * (1 + sin(2731 * point.x + 13 * $ph))) + $softv * (0.6 + 0.4 * sin(19 * point.x + 3 * $ph))) - clamp(1 - ($len - point.y) / max($crumb * $crb, 0.5), 0, 1) * clamp(ceil($crb - 0.001), 0, 1) * $crumb * $crb * 0.6 * ((1 - $softv) * (0.3 + 0.35 * (1 + sin(2731 * point.x + 13 * $ph))) + $softv * (0.6 + 0.4 * sin(19 * point.x + 3 * $ph)))), -$dv * clamp((point.z - 0.55 * $t) / (0.45 * $t), 0, 1) * $t * ($softv * 0.3 * (clamp(1 - point.y / max($crumb * $crf, 0.5), 0, 1) * clamp(1 - point.y / max($crumb * $crf, 0.5), 0, 1) + clamp(1 - ($len - point.y) / max($crumb * $crb, 0.5), 0, 1) * clamp(ceil($crb - 0.001), 0, 1) * clamp(1 - ($len - point.y) / max($crumb * $crb, 0.5), 0, 1) * clamp(ceil($crb - 0.001), 0, 1)) * (0.7 + 0.3 * sin(31 * point.x + $ph)) + (1 - $softv) * 0.4 * clamp(floor(3 * max(clamp(1 - point.y / max($crumb * $crf, 0.5), 0, 1), clamp(1 - ($len - point.y) / max($crumb * $crb, 0.5), 0, 1) * clamp(ceil($crb - 0.001), 0, 1)) + (0.3 + 0.35 * (1 + sin(2731 * point.x + 13 * $ph)))) / 3, 0, 1))))
    if ($sl > 0.5) {
      warp(by=(-0.25 * $t * clamp((point.x - (0.5 * $w - $b - 2.5 * ($w - $a - $b) / 18)) / 0.2, 0, 1) * clamp((clamp(point.y / $len, 0, 1) - $sly) / 0.05, 0, 1) * clamp(($sly + 0.35 - clamp(point.y / $len, 0, 1)) / 0.05, 0, 1) * clamp(point.z / $t, 0, 1), 0.0, -0.55 * $t * clamp((point.x - (0.5 * $w - $b - 2.5 * ($w - $a - $b) / 18)) / 0.2, 0, 1) * clamp((clamp(point.y / $len, 0, 1) - $sly) / 0.05, 0, 1) * clamp(($sly + 0.35 - clamp(point.y / $len, 0, 1)) / 0.05, 0, 1) * clamp(point.z / $t, 0, 1)))
    }
    if ($co > 0.5) {
      warp(by=(0.0, 0.0, -0.65 * clamp(($cos * point.x - (0.5 * $w - 0.3 * $w)) / 0.3, 0, 1) * clamp(((1 - $coe) * (0.7 * $w - point.y) + $coe * (point.y - $len + 0.7 * $w)) / 0.3, 0, 1) * point.z))
    }
  }
}

# ==== JAGGED END (round 2): a board's snapped end as an OUTLINE both tiers cut (kit §13: an L2 operation) =======
#
# `$JaggedEnd(width=, thick=, base=, damage=, noise=, budget=, ...)` cuts the +Y end of the board in the current mesh
# (the Damage frame: centred on x, bottom on z = 0, grain +Y, its sawn end at y = 0 and the board running past `base`)
# to a jagged break whose base is at y = base, then maps it: the skin box-mapped along the grain and the torn faces
# (`[cut]`) on their own offset, as the Damage entries do. It paints nothing: write `material($Broken) [cut]` after.
# A fence picket, a pale, a slat, a board wall's top or a hole's edge all reuse it; `AgedBoard` calls it for damage > 0.
#   width, thick       cm (1-100, 0.3-50): the board's section
#   base               cm (0 or more): the break's base along the board
#   damage             0-1 (0.5): how broken; the teeth reach (0.3 + 1.2 damage) x the width
#   noise              the seed (pass the member's key)
#   budget             0 Game (the outline alone, 20-60 triangles of top), 1 High (+ splinter jogs, coarse fibre),
#                      2 Ultra (fine fibre)
#   style              -1 drawn (0.2 each); 0 spikes, 1 stepped (two or three shelves), 2 hooked (a tall tooth leaning
#                      over a low neighbour), 3 short (low and ragged), 4 slanted (one long tear rising across)
#   reach              x width (-1: from damage; 0.05-4): the tallest teeth
#   tear               0-3 (0.8): the torn faces lean through the thickness by up to this, each tooth its own way,
#                      so a break face is a torn surface, never the outline pushed straight through the board
#   jag, fib, fsc      cm (-1: from budget): splinter jogs on the flanks; fibre ridges on the torn faces and their size
#   uvs, tile, aspect  1 maps (0 writes uv(none)); the grain tile (cm) and its along/across ratio
JagCutG = mesh(w=20.0, t=2.5, hb=100.0, key=1, sty=0, rx=1.0, tear=0.8) {
  $R = $rx * $w
  $jw1 = sin($key * 12.9898 + 701.3) * 43758.5453
  $jw1 = $jw1 - floor($jw1)
  $jw2 = sin($key * 12.9898 + 713.2) * 43758.5453
  $jw2 = $jw2 - floor($jw2)
  $jw3 = sin($key * 12.9898 + 725.1) * 43758.5453
  $jw3 = $jw3 - floor($jw3)
  $jw4 = sin($key * 12.9898 + 737.0) * 43758.5453
  $jw4 = $jw4 - floor($jw4)
  $jw5 = sin($key * 12.9898 + 748.9) * 43758.5453
  $jw5 = $jw5 - floor($jw5)
  $jw6 = sin($key * 12.9898 + 760.8) * 43758.5453
  $jw6 = $jw6 - floor($jw6)
  $jq1 = sin($key * 12.9898 + 772.7) * 43758.5453
