  $wv = $waneyC * (0.3 + 0.7 * $ad24)
  $wk = 0.5 + 1.5 * $ad25
  $ws = 2 * floor(2 * $ad26) - 1
  $tt = $ttaperA * (2 * $ad27 - 1)
  $pt = $pitchA * (2 * $ad28 - 1)
  $rl = $rollA * (2 * $ad29 - 1)
  $dv = clamp($decayA * (1 + $stateC * (2 * $ad30 - 1)), 0, 1)
  $nck = min(floor($checksC * (0.4 + 0.6 * $ad31) + 0.5), 3) * clamp(ceil($dv - 0.05), 0, 1)
  $cx1 = 3 + floor(13 * $ad32)
  $cx2 = 3 + floor(13 * $ad33)
  $cx3 = 3 + floor(13 * $ad34)
  $cy1 = 0.05 + 0.3 * $ad35
  $cl1 = 0.3 + 0.6 * $ad36
  $cy2 = 0.35 + 0.4 * $ad37
  $cl2 = 1.0
  $cy3 = 0.0
  $cl3 = 0.15 + 0.4 * $ad38
