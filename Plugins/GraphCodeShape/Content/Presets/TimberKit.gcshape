  }
  $Age(w=$Wd, t=$Td, len=$lage, cupv=$cp, bowv=$bw, crookv=$ck, e0=$e0, e1=$e1 * (1 - clamp(ceil($dmg - 0.001), 0, 1)), yawv=$yw, liftv=$lf, rm=$rm * (1 - clamp(ceil($dv - 0.001), 0, 1)), wa=$wa, wb=$wb, ph=$ph, fr=$fr, twistv=$tw, taperv=$tp, wanev=$wv, wanek=$wk, wanes=$ws, ttapv=$tt, pitchv=$pt, rollv=$rl, curlv=$curlC, curlf=$curlfC, curls=$curlsC, sagv=$sagC, sag0=$sag0C, sag1=$sag1C, softv=$softnessC)
