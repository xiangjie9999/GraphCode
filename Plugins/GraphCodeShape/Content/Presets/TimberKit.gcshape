  $rl = $roll * (2 * $ad29 - 1)
  $dv = clamp($decay * (1 + 0.0 * (2 * $ad30 - 1)), 0, 1)
  $nck = min(floor($checks * (0.4 + 0.6 * $ad31) + 0.5), 3) * clamp(ceil($dv - 0.05), 0, 1)
  $cx1 = 3 + floor(13 * $ad32)
  $cx2 = 3 + floor(13 * $ad33)
  $cx3 = 3 + floor(13 * $ad34)
  $cy1 = 0.05 + 0.3 * $ad35
  $cl1 = 0.3 + 0.6 * $ad36
  $cy2 = 0.35 + 0.4 * $ad37
