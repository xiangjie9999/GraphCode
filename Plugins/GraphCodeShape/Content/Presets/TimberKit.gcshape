            add($BrokenSeg, len=$L0, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, hdeep=0.3, hbn=11, deep=$deepC, grain=$grainC, slant=$bslantC, torn=$tornC, detail=$detailC, layers=2, fray=0.4, sub=0.0, chew=0.05, lean=1.2, fib=$fb, at=($x, $hA, $zb), rotate=($t0, 0.0, 0.0), join=none)
          } else {
            add($BrokenBoard, len=$yA - $y0, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, deep=$deepC, grain=$grainC, slant=$bslantC, torn=$tornC, detail=$detailC, layers=2, fray=0.4, sub=0.0, chew=0.05, lean=1.2, fib=$fb, bn=23, at=($x, $y0, $zb), rotate=(0.0, 0.0, 0.0), join=none)
          }
          if ($g1 > 0.5) {
            add($BrokenBoard, len=$y1 - $hB, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, deep=0.3, grain=$grainC, slant=0.0, torn=0.0, detail=$detailC, layers=2, fray=0.0, sub=0.0, chew=0.0, lean=0.6, bn=51, at=($x, $y1, $zb), rotate=(0.0, 0.0, 180.0), join=none)
            add($BrokenSeg, len=$L1, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, hdeep=0.3, hbn=51, deep=$deepC, grain=$grainC, slant=$bslantC, torn=$tornC, detail=$detailC, layers=2, fray=0.4, sub=0.0, chew=0.05, lean=1.2, fib=$fb, at=($x, $hB, $zb), rotate=($t1, 0.0, 180.0), join=none)
          } else {
            add($BrokenBoard, len=$y1 - $yB, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, deep=$deepC, grain=$grainC, slant=$bslantC, torn=$tornC, detail=$detailC, layers=2, fray=0.4, sub=0.0, chew=0.05, lean=1.2, fib=$fb, bn=63, at=($x, $y1, $zb), rotate=(0.0, 0.0, 180.0), join=none)
          }
        } else {
          # broken at side A only: a short stub on A, the long rest from the +Y end, held by beam B
          add($BrokenBoard, len=$yA - $y0, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, deep=$deepC, grain=$grainC, slant=$bslantC, torn=$tornC, detail=$detailC, layers=2, fray=0.4, sub=0.0, chew=0.05, lean=1.2, fib=$fb, bn=23, at=($x, $y0, $zb), join=none)
          add($BrokenBoard, len=$y1 - $yA - 4.0, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, deep=$deepC, grain=$grainC, slant=$bslantC, torn=$tornC, detail=$detailC, layers=2, fray=0.4, sub=0.0, chew=0.05, lean=1.2, fib=$fb, bn=67, at=($x, $y1, $zb), rotate=(0.0, 0.0, 180.0), join=none)
        }
      } else {
        # broken at side B only
        add($BrokenBoard, len=$y1 - $yB, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, deep=$deepC, grain=$grainC, slant=$bslantC, torn=$tornC, detail=$detailC, layers=2, fray=0.4, sub=0.0, chew=0.05, lean=1.2, fib=$fb, bn=63, at=($x, $y1, $zb), rotate=(0.0, 0.0, 180.0), join=none)
        add($BrokenBoard, len=$yB - $y0 - 4.0, width=$width, thick=$pthickC * (1 - $thinC * $decayA), wvar=$wvarC, tvar=$tvarC, lvar=0.0, yaw=$yawA, lift=$liftA, cup=$cupA, bow=$bowA, crook=$crookA, endsq=$esq, wear=$wearS, wearvar=$wearvarC, softness=$softnessC, twist=$twistA, taper=$taperA, waney=$waneyC, ttaper=$ttaperA, pitch=$pitchA, roll=$rollA, decay=$dv, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=0.0, arris=$AR, seg=$seg, uvs=1, tile=$tileC, aspect=$aspectC, noise=$noiseC, index=$i, deep=$deepC, grain=$grainC, slant=$bslantC, torn=$tornC, detail=$detailC, layers=2, fray=0.4, sub=0.0, chew=0.05, lean=1.2, fib=$fb, bn=27, at=($x, $y0, $zb), join=none)
      }
    }
  }
  # debris lying on the deck: dropped onto a hidden plate inside the planks and lifted until each rests on a plank
  if ($ndeb > 0.5) {
    deckground = add($Deb.Ground, width=$size_xC - 40.0, depth=$fB - $fA, at=(0.5 * $size_xC, 0.5 * ($fA + $fB), -0.6 * $pthickC), join=none)
    add($Deb.Piece, length=random(min=4.0, max=10.0), ar=random(min=2.5, max=7.0), tr=random(min=0.3, max=0.7), tip=random(min=0.3, max=0.95), taper=random(min=0.2, max=0.6), kink=random(min=-10.0, max=10.0), twist=random(min=-12.0, max=12.0), fray=random(min=3.0, max=7.0), frayw=random(min=0.08, max=0.2), bend=random(min=0.4, max=1.2), tile=$tileC, aspect=$aspectC, uoff=random(min=0.0, max=1.0), voff=random(min=0.0, max=1.0), noise=random(min=1.0, max=999.0), scatter=floor(0.5 * $ndeb + 0.5), apart=2.0, collide=stack, jitter=(turn=(6.0, 6.0, 180.0)), align=(Z: self=0%), join=none, seed=$noiseC + 71) [$deckground]
    add($Deb.Chip, length=random(min=1.5, max=4.0), ar=random(min=2.0, max=4.0), curl=random(min=10.0, max=30.0), bow=random(min=-0.1, max=0.1), twist=random(min=-25.0, max=25.0), hinge=random(min=0.0, max=1.4), tile=$tileC, aspect=$aspectC, uoff=random(min=0.0, max=1.0), voff=random(min=0.0, max=1.0), noise=random(min=1.0, max=999.0), scatter=$ndeb - floor(0.5 * $ndeb + 0.5) + 1, apart=1.0, collide=stack, jitter=(turn=(6.0, 6.0, 180.0)), align=(Z: self=0%), join=none, seed=$noiseC + 73) [$deckground]
    trim() [$deckground]
  }
}

# ==== THE BOARD WALL (kit §12.2): vertical boards on rails, snapped tops, a ragged hole ===========================
#
# Along +X, the boards' back faces near y = 0 (each stands forward by what its own shape reaches back), the rails
# behind, a post at the -X end. Every board is an `AgedBoard` (its own index); a snapped top or a hole's edge is
# its `JaggedEnd`, a family other than its neighbour's (spikes, stepped, hooked, short, slanted) at a height that
# jumps from its neighbour's. States: `_Aged` (damage 0), `_Snapped` (damage 0.5, mode 0), `_Holed` (damage 0.5,
# mode 1; `_Holed_Debris` is what fell out). Every knob is clamped to its range.
#   knob       default unit  range         meaning
#   size_x        200 cm     [60..600]     the module along the wall
#   height        240 cm     [60..500]     the boards' height
#   damage          0 0-1    [0..1]        0 none; mode 0: the tops snap lower and more jagged with damage; mode 1: a ragged hole, larger with damage
#   age             1 0-2    [0..2]        0 new, 1 aged, 2 decayed: every unevenness x age up to 1, x3 at 2; past 1.1 the boards decay
#   softness        0 0-1    [0..1]        0 crisp, the default; toward 1 worn round (driftwood): AgedBoard's softness
#   noise           1 int                  the seed
#   budget          1 0/1/2  [0..2]        0 Game, 1 High, 2 Ultra
#   mode            0 0/1    [0..1]        what damage does: 0 snaps the tops, 1 breaks a ragged hole
#   bw_lo          18 cm     [6..60]       board width, least
#   bw_hi          32 cm     [8..80]       board width, most
#   bthick        2.5 cm     [0.8..10]     board thickness
#   gap_lo        0.1 cm     [0..5]        gap, least
#   gap_hi          1 cm     [0..10]       gap, most (x age)
#   rail_w          5 cm     [2..20]       rail depth
#   rail_h         12 cm     [4..30]       rail height
#   rail_z1     0.125 x      [0..1]        lower rail (x height)
#   rail_z2     0.354 x      [0..1]        middle rail (x height)
#   rail_top        1 0/1    [0..1]        a top rail where the tops stand whole
#   post            1 0/1    [0..1]        a post at the -X end
#   post_w          9 cm     [4..30]       post size
#   bottom          3 cm     [0..20]       bottoms uneven: each board lifted up to this (x age)
#   sfull          -1 share  [-1..1]       mode 0: boards left whole (-1: 0.25 (1 - damage))
#   reach          -1 x width [-1..4]       the tallest teeth (-1: 0.3 + 1.2 damage)
#   tear          0.8 x      [0..3]        torn faces lean through the thickness
#   hxf         0.575 x      [0..1]        mode 1: the hole's centre (x size_x)
#   hzf           0.7 x      [0..1]        its height (x height)
#   hrag         0.35 x      [0..1]        how ragged the hole's outline is
#   wvar         0.12 x      [0..0.4]      width
#   tvar         0.12 x      [0..0.4]      thickness
#   lvar         0.01 x      [0..0.4]      length
#   taper        0.07 x      [0..0.3]      width along a board
#   waney           1 cm     [0..5]        a non-straight edge
#   ttaper        0.1 x      [0..0.5]      thickness along a board
#   yaw          0.45 deg    [0..6]        lean in the wall's plane
#   pitch        0.25 deg    [0..6]        lean out of it
#   roll            1 deg    [0..10]       turned about its length (an edge proud)
#   lift          0.2 cm     [0..5]        proud or sunk
#   cup          0.45 cm     [0..4]        cup
#   bow           1.5 cm     [0..15]       bow out of the wall
#   crook         1.5 cm     [0..15]       crook in the wall's plane
#   twist         2.5 deg    [0..20]       twist
#   endsq           3 deg    [0..12]       ends off square
#   wear          0.4 cm     [0..4]        wear
#   wearvar       0.6 x      [0..1]        wear varies
#   state        0.35 x      [0..1]        each board its own condition
#   ridge         0.3 cm     [0..2]        decay: eroded ridges
#   checks          3 count  [0..4]        decay: open checks
#   checkd        0.5 x      [0..0.9]      decay: check depth
#   crumb           4 cm     [0..20]       decay: crumbled ends
#   sliver        0.5 share  [0..1]        decay: slivers off
#   corner        0.4 share  [0..1]        decay: corners missing
#   thin          0.2 x      [0..0.6]      decay: thinner
#   tile          100 cm     [10..1000]    grain UV tile
#   aspect          1 x      [0.1..10]     grain tile aspect
BoardWall = mesh(size_x=200.0, height=240.0, damage=0.0, age=1.0, softness=0.0, noise=1, budget=1, mode=0, bw_lo=18.0, bw_hi=32.0, bthick=2.5, gap_lo=0.1, gap_hi=1.0, rail_w=5.0, rail_h=12.0, rail_z1=0.125, rail_z2=0.354, rail_top=1, post=1, post_w=9.0, bottom=3.0, sfull=-1.0, reach=-1.0, tear=0.8, hxf=0.575, hzf=0.7, hrag=0.35, wvar=0.12, tvar=0.12, lvar=0.01, taper=0.07, waney=1.0, ttaper=0.1, yaw=0.45, pitch=0.25, roll=1.0, lift=0.2, cup=0.45, bow=1.5, crook=1.5, twist=2.5, endsq=3.0, wear=0.4, wearvar=0.6, state=0.35, ridge=0.3, checks=3, checkd=0.5, crumb=4.0, sliver=0.5, corner=0.4, thin=0.2, tile=100.0, aspect=1.0) {
  $size_xC = clamp($size_x, 60, 600)
  $heightC = clamp($height, 60, 500)
  $damageC = clamp($damage, 0, 1)
  $ageC = clamp($age, 0, 2)
  $softnessC = clamp($softness, 0, 1)
  $noiseC = floor($noise)
  $budgetC = clamp(floor($budget + 0.5), 0, 2)
  $modeC = clamp(floor($mode + 0.5), 0, 1)
  $bw_loC = clamp($bw_lo, 6, 60)
  $bw_hiC = clamp($bw_hi, 8, 80)
  $bthickC = clamp($bthick, 0.8, 10)
  $gap_loC = clamp($gap_lo, 0, 5)
  $gap_hiC = clamp($gap_hi, 0, 10)
  $rail_wC = clamp($rail_w, 2, 20)
  $rail_hC = clamp($rail_h, 4, 30)
  $rail_z1C = clamp($rail_z1, 0, 1)
  $rail_z2C = clamp($rail_z2, 0, 1)
  $rail_topC = clamp(floor($rail_top + 0.5), 0, 1)
  $postC = clamp(floor($post + 0.5), 0, 1)
  $post_wC = clamp($post_w, 4, 30)
  $bottomC = clamp($bottom, 0, 20)
  $sfullC = clamp($sfull, -1, 1)
  $reachC = clamp($reach, -1, 4)
  $tearC = clamp($tear, 0, 3)
  $hxfC = clamp($hxf, 0, 1)
  $hzfC = clamp($hzf, 0, 1)
  $hragC = clamp($hrag, 0, 1)
  $wvarC = clamp($wvar, 0, 0.4)
  $tvarC = clamp($tvar, 0, 0.4)
  $lvarC = clamp($lvar, 0, 0.4)
  $taperC = clamp($taper, 0, 0.3)
  $waneyC = clamp($waney, 0, 5)
  $ttaperC = clamp($ttaper, 0, 0.5)
  $yawC = clamp($yaw, 0, 6)
  $pitchC = clamp($pitch, 0, 6)
  $rollC = clamp($roll, 0, 10)
  $liftC = clamp($lift, 0, 5)
  $cupC = clamp($cup, 0, 4)
  $bowC = clamp($bow, 0, 15)
  $crookC = clamp($crook, 0, 15)
  $twistC = clamp($twist, 0, 20)
  $endsqC = clamp($endsq, 0, 12)
  $wearC = clamp($wear, 0, 4)
  $wearvarC = clamp($wearvar, 0, 1)
  $stateC = clamp($state, 0, 1)
  $ridgeC = clamp($ridge, 0, 2)
  $checksC = clamp(floor($checks + 0.5), 0, 4)
  $checkdC = clamp($checkd, 0, 0.9)
  $crumbC = clamp($crumb, 0, 20)
  $sliverC = clamp($sliver, 0, 1)
  $cornerC = clamp($corner, 0, 1)
  $thinC = clamp($thin, 0, 0.6)
  $tileC = clamp($tile, 10, 1000)
  $aspectC = clamp($aspect, 0.1, 10)
  $agf = (min($ageC, 1) + 2 * max($ageC - 1, 0))
  $decayA = clamp(($ageC - 1.1) / 0.7, 0, 1)
  $AR = 1 + 2 * min($budgetC, 1)
  $seg = 2 + 2 * min($budgetC, 1) + 4 * max($budgetC - 1, 0)
  $snap = clamp(ceil($damageC - 0.02), 0, 1) * (1 - $modeC)
  $hole = clamp(ceil($damageC - 0.02), 0, 1) * $modeC
  $gapH = $gap_loC + ($gap_hiC - $gap_loC) * min(max($agf, 0.3), 3.0)
  $sfl = 0.25 * (1 - $damageC) + clamp(ceil($sfullC + 0.5), 0, 1) * ($sfullC - 0.25 * (1 - $damageC))
  $rxw = 0.3 + 1.2 * $damageC + clamp(ceil($reachC), 0, 1) * ($reachC - 0.3 - 1.2 * $damageC)
  $hrx = min(15.0 + 55.0 * $damageC, 0.4 * $size_xC)
  $hrz = min(12.0 + 44.0 * $damageC, 0.25 * $heightC)
  $hreach = 0.25 + 0.4 * $damageC
  $hxw = clamp($hxfC * $size_xC, $hrx, $size_xC - $hrx)
  $hzw = clamp($hzfC * $heightC, 1.25 * $hrz + 10.0, $heightC - 1.25 * $hrz - 10.0)
  $fm = 0.92 - 0.55 * $damageC
  $flo = max($fm - 0.22, 0.2)
  $fhi = min($fm + 0.2, 0.97)
  $botA = min($bottomC * $agf, 20.0)
  $wq0 = sin($noiseC * 1009 * 12.9898 + 1501.3) * 43758.5453
  $wq0 = $wq0 - floor($wq0)
  $wq1 = sin($noiseC * 1009 * 12.9898 + 1517.9) * 43758.5453
  $wq1 = $wq1 - floor($wq1)
  $xa = 0.3
  # the rails behind the boards and a post at the -X end; the top rail only where the tops stand whole
  add($AgedBoard, width=$rail_wC, thick=$rail_hC, length=$size_xC - 1.0, damage=0.0, age=$ageC, softness=$softnessC, noise=$noiseC, budget=$budgetC, index=950, wvar=0.04, tvar=0.0, lvar=0.0, yaw=0.15, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.3, twist=0.0, taper=0.02, waney=0.3, ttaper=0.0, wear=$wearC, endsq=0.5, decay=0.0, arris=$AR, seg=$seg, tile=$tileC, aspect=$aspectC, at=(0.5, 0.3 + 0.5 * $rail_wC, $rail_z1C * $heightC), rotate=(0.0, 0.0, -90.0))
