 $A4)), ((0.5 * $w - ($ua4) * $w) + 0.7 * ((0.5 * $w - ($c4) * $w) - (0.5 * $w - ($ua4) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj15 - 1) * clamp(abs((0.5 * $w - ($c4) * $w) - (0.5 * $w - ($ua4) * $w)) * 0.25, 0, 1), $hb + $A4 + 0.7 * ($V4 - $A4)), ((0.5 * $w - ($c4) * $w), $hb + $V4), ((0.5 * $w - ($c4) * $w) + 0.35 * ((0.5 * $w - ($ua5) * $w) - (0.5 * $w - ($c4) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj16 - 1) * clamp(abs((0.5 * $w - ($ua5) * $w) - (0.5 * $w - ($c4) * $w)) * 0.25, 0, 1), $hb + $V4 + 0.35 * ($A5 - $V4)), ((0.5 * $w - ($c4) * $w) + 0.7 * ((0.5 * $w - ($ua5) * $w) - (0.5 * $w - ($c4) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj17 - 1) * clamp(abs((0.5 * $w - ($ua5) * $w) - (0.5 * $w - ($c4) * $w)) * 0.25, 0, 1), $hb + $V4 + 0.7 * ($A5 - $V4)), ((0.5 * $w - ($ua5) * $w), $hb + $A5), ((0.5 * $w - ($ua5) * $w) + 0.35 * ((0.5 * $w - ($c5) * $w) - (0.5 * $w - ($ua5) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj18 - 1) * clamp(abs((0.5 * $w - ($c5) * $w) - (0.5 * $w - ($ua5) * $w)) * 0.25, 0, 1), $hb + $A5 + 0.35 * ($V5 - $A5)), ((0.5 * $w - ($ua5) * $w) + 0.7 * ((0.5 * $w - ($c5) * $w) - (0.5 * $w - ($ua5) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj19 - 1) * clamp(abs((0.5 * $w - ($c5) * $w) - (0.5 * $w - ($ua5) * $w)) * 0.25, 0, 1), $hb + $A5 + 0.7 * ($V5 - $A5)), ((0.5 * $w - ($c5) * $w), $hb + $V5), ((0.5 * $w - ($c5) * $w) + 0.35 * ((0.5 * $w - ($ua6) * $w) - (0.5 * $w - ($c5) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj20 - 1) * clamp(abs((0.5 * $w - ($ua6) * $w) - (0.5 * $w - ($c5) * $w)) * 0.25, 0, 1), $hb + $V5 + 0.35 * ($A6 - $V5)), ((0.5 * $w - ($c5) * $w) + 0.7 * ((0.5 * $w - ($ua6) * $w) - (0.5 * $w - ($c5) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj21 - 1) * clamp(abs((0.5 * $w - ($ua6) * $w) - (0.5 * $w - ($c5) * $w)) * 0.25, 0, 1), $hb + $V5 + 0.7 * ($A6 - $V5)), ((0.5 * $w - ($ua6) * $w), $hb + $A6), ((0.5 * $w - ($ua6) * $w) + 0.35 * ((0.5 * $w - (1.0) * $w) - (0.5 * $w - ($ua6) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj22 - 1) * clamp(abs((0.5 * $w - (1.0) * $w) - (0.5 * $w - ($ua6) * $w)) * 0.25, 0, 1), $hb + $A6 + 0.35 * ($E1 - $A6)), ((0.5 * $w - ($ua6) * $w) + 0.7 * ((0.5 * $w - (1.0) * $w) - (0.5 * $w - ($ua6) * $w)) + $jag * (1 - 0.85 * $f2) * (2 * $jj23 - 1) * clamp(abs((0.5 * $w - (1.0) * $w) - (0.5 * $w - ($ua6) * $w)) * 0.25, 0, 1), $hb + $A6 + 0.7 * ($E1 - $A6)), ((0.5 * $w - (1.0) * $w), $hb + $E1), (-0.75 * $w, $hb + $E1), loop=true)
  extrude(height=$t + 1.2)
  place(by=(0.0, 0.0, -0.6))
  if ($tear > 0.001) {
    warp(by=(0.0, $tear * (point.z - 0.5 * $t) * (0.65 * sin(23 * point.x + 360 * $jp1) + 0.35 * sin(61 * point.x + 360 * $jp2)), 0.0))
  }
}
JaggedEnd = instruction(width=20.0, thick=2.5, base=100.0, damage=0.5, noise=1, budget=1, style=-1, reach=-1.0, tear=0.8, jag=-1.0, fib=-1.0, fsc=-1.0, uvs=1, tile=100.0, aspect=1.0) {
  $jW = clamp($width, 1.0, 100.0)
  $jT = clamp($thick, 0.3, 50.0)
  $jB = max($base, 0.0)
  $jD = clamp($damage, 0, 1)
  $jU = clamp(floor($budget + 0.5), 0, 2)
  $jK = floor($noise)
  $jS = sin($jK * 12.9898 + 877.1) * 43758.5453
  $jS = floor(5 * ($jS - floor($jS)))
  $jS = $jS + clamp(ceil($style + 0.5), 0, 1) * (clamp(floor($style + 0.5), 0, 4) - $jS)
  $jR = 0.3 + 1.2 * $jD + clamp(ceil($reach), 0, 1) * (clamp($reach, 0.05, 4.0) - 0.3 - 1.2 * $jD)
  $jTe = clamp($tear, 0, 3)
  $jG = 0.8 * min($jU, 1) + clamp(ceil($jag + 0.5), 0, 1) * (clamp($jag, 0, 3) - 0.8 * min($jU, 1))
  $jF = 0.08 * min($jU, 1) + clamp(ceil($fib + 0.5), 0, 1) * (clamp($fib, 0, 1) - 0.08 * min($jU, 1))
  $jFs = 2.4 - 1.6 * max($jU - 1, 0) + clamp(ceil($fsc + 0.5), 0, 1) * (clamp($fsc, 0.3, 10) - 2.4 + 1.6 * max($jU - 1, 0))
  if ($jG > 0.001) {
    intersect($JagCutH, w=$jW, t=$jT, hb=$jB, key=$jK, sty=$jS, rx=$jR, tear=$jTe, jag=$jG)
  } else {
    intersect($JagCutG, w=$jW, t=$jT, hb=$jB, key=$jK, sty=$jS, rx=$jR, tear=$jTe)
  }
  if ($jF > 0.001) {
    roughen(by=$jF, scale=($jFs, 6 * $jFs, $jFs), seed=$jK, form=ridged) [cut]
  }
  if ($uvs > 0.5) {
    uv(box, facing=(0, 0, 1), up=(0, 1, 0), scale=($aspect * $tile, $tile, $tile)) [!cut]
    uv(box, facing=(0, 0, 1), up=(0, 1, 0), scale=($aspect * $tile, $tile, $tile), offset=(0.37, 0.61)) [cut]
  } else {
    uv(none)
  }
}

# AGED BOARD (round 2), the part every kit subject places: the shared imperfections (kit §12.3), in every sense
# at once, each its own knob, `age` widening them all, and past age 1.1 the board's decay (checks, ridges
# along the grain, crumbled ends, a sliver off an edge, a missing corner, thinner); `damage` snaps its +Y end
# (`JaggedEnd`). The Damage frame: centred on x, bottom on z = 0, y from 0 to its length, grain +Y. Every knob
# is clamped to its range. Its slots are pathless: bind `Face` and `Broken` when importing, or the engine draws
# its default material (a ~12 cm grid in clay renders; not the mesh).
#   knob       default unit  range         meaning
#   width          20 cm     [2..60]       nominal width (across the grain)
#   thick           5 cm     [0.5..30]     nominal thickness
#   length        200 cm     [5..1000]     nominal length (along the grain, +Y)
#   damage          0 0-1    [0..1]        0 sawn ends; above 0 the +Y end is snapped by `JaggedEnd`, its teeth and break lower with it
#   age             1 0-2    [0..2]        0 new, 1 aged (the defaults below), 2 decayed (the kit-wide scale): every age-scaled knob x age up to 1, then x (1 + 2 (age - 1)), so x3 at 2; past 1.1 the board decays (fully at 1.8) (checks, ridges, crumbled ends, a sliver, a missing corner)
#   softness        0 0-1    [0..1]        0 crisp, the default (kit §12.3 hard, not soft): arrises worn 2-6 mm, breakouts, a faceted cup, stepped fibrous ends, sharp ridges; toward 1 worn round (driftwood): arrises to 1.75 cm, wavy edges, domed ends, soft ridges
#   noise           1 int                  the seed; a member's draws are keyed noise * 1009 + index
#   budget          1 0/1/2  [0..2]        0 Game (chamfered arrises, 2 segments, no UVs), 1 High, 2 Ultra (8 segments, finer fibre)
#   index           0 int                  the member's number in its assembly
#   wvar         0.08 x      [0..0.4]      width +- this fraction member to member
#   tvar         0.05 x      [0..0.4]      thickness +- this fraction member to member
#   lvar         0.05 x      [0..0.4]      length +- this fraction
#   taper        0.03 x      [0..0.3]      width changes along the member by up to this fraction (one end narrower) (x age)
#   waney         0.4 cm     [0..5]        one edge not straight: a slow wave of up to this many cm
#   ttaper       0.06 x      [0..0.5]      thickness changes along the member by up to this fraction (x age)
#   yaw           0.5 deg    [0..6]        turned 0.4-1 x this either way about its middle (x age)
#   pitch        0.25 deg    [0..6]        one end up, the other down, about its middle (x age)
#   roll          0.4 deg    [0..10]       rolled about its length (one edge proud) (x age)
#   lift         0.15 cm     [0..5]        raised or sunk up to this (x age)
#   cup           0.3 cm     [0..4]        edges 0.3-1 x this off the middle (up on 3 members of 4) (x age)
#   bow           0.4 cm     [0..15]       middle up or down up to this (x age)
#   crook        0.25 cm     [0..15]       middle sideways up to this (x age)
#   twist         0.6 deg    [0..20]       one end turned against the other about the length (x age)
#   endsq         1.5 deg    [0..12]       each end up to this off square
#   wear          0.5 cm     [0..4]        top arrises worn round to about this radius (x age)
#   wearvar       0.6 x      [0..1]        how much the wear differs arris to arris and along the member
#   state        0.35 x      [0..1]        each member its own condition: its age-scaled knobs and its decay x (1 +- state)
#   decay          -1 0-1    [-1..1]       -1: from age ((age - 1.1) / 0.7); else the decay itself
#   ridge        0.45 cm     [0..2]        decay: top eroded to ridges along the grain, this deep
#   checks          3 count  [0..4]        decay: open checks and splits along the grain, up to this many
#   checkd       0.45 x      [0..0.9]      decay: a check this fraction of the thickness deep (an end split deeper)
#   crumb           4 cm     [0..20]       decay: ends rounded and crumbled back up to this
#   sliver        0.6 share  [0..1]        decay: share of members with a sliver split off one edge
#   corner       0.45 share  [0..1]        decay: share of members with a corner missing
#   thin         0.22 x      [0..0.6]      decay: thinner by up to this fraction
#   base           -1 cm     [-1..1000]    -1: the break base at (1 - 0.3 damage) x length; else this many cm from the sawn end
#   tk              0 int                  offsets the snapped end draws (a second break on one member)
#   style          -1 -1..4  [-1..4]       -1 drawn; 0 spikes, 1 stepped, 2 hooked, 3 short, 4 slanted
#   reach          -1 x width [-1..4]       -1: 0.3 + 1.2 damage; the teeth reach this x the width above the break base
#   tear          0.8 x      [0..3]        the torn faces lean through the thickness by up to this (cm per cm)
#   curl            0 cm     [0..30]       one end sprung up by this
#   curlf         0.5 x      [0..0.95]     where along the member the spring starts
#   curls           0 0/1    [0..1]        which end springs (0 the +Y end)
#   sag             0 cm     [0..10]       sags this much between sag0 and sag1
#   sag0         0.25 x      [0..1]        sag span start (fraction of the length)
#   sag1         0.75 x      [0..1]        sag span end
#   arris          -1 -1/1/3 [-1..3]       -1 from budget; 3 rounded arrises, 1 chamfers
#   seg            -1 -1/1/2/4/8/16 [-1..16]      -1 from budget; segments along
#   uvs            -1 -1/0/1 [-1..1]       -1 from budget; 1 tiling grain UVs, 0 none (the bake lays them out)
#   tile          100 cm     [10..1000]    grain UV tile along the member
#   aspect          1 x      [0.1..10]     along-grain tile over the across one
AgedBoard = mesh(width=20.0, thick=5.0, length=200.0, damage=0.0, age=1.0, softness=0.0, noise=1, budget=1, index=0, wvar=0.08, tvar=0.05, lvar=0.05, taper=0.03, waney=0.4, ttaper=0.06, yaw=0.5, pitch=0.25, roll=0.4, lift=0.15, cup=0.3, bow=0.4, crook=0.25, twist=0.6, endsq=1.5, wear=0.5, wearvar=0.6, state=0.35, decay=-1.0, ridge=0.45, checks=3, checkd=0.45, crumb=4.0, sliver=0.6, corner=0.45, thin=0.22, base=-1.0, tk=0, style=-1, reach=-1.0, tear=0.8, curl=0.0, curlf=0.5, curls=0, sag=0.0, sag0=0.25, sag1=0.75, arris=-1, seg=-1, uvs=-1, tile=100.0, aspect=1.0) {
  $widthC = clamp($width, 2, 60)
  $thickC = clamp($thick, 0.5, 30)
  $lengthC = clamp($length, 5, 1000)
  $damageC = clamp($damage, 0, 1)
  $ageC = clamp($age, 0, 2)
  $softnessC = clamp($softness, 0, 1)
  $noiseC = floor($noise)
  $budgetC = clamp(floor($budget + 0.5), 0, 2)
  $indexC = floor($index)
  $wvarC = clamp($wvar, 0, 0.4)
  $tvarC = clamp($tvar, 0, 0.4)
  $lvarC = clamp($lvar, 0, 0.4)
  $taperC = clamp($taper, 0, 0.3)
  $waneyC = clamp($waney, 0, 5)
  $ttaperC = clamp($ttaper, 0, 0.5)
  $yawC = clamp($yaw, 0, 6)
  $pitchC = clamp($pitch, 0, 6)
  $rollC = clamp($roll, 0, 10)
  $liftC = clamp($lift, 0, 5)
  $cupC = clamp($cup, 0, 4)
  $bowC = clamp($bow, 0, 15)
  $crookC = clamp($crook, 0, 15)
  $twistC = clamp($twist, 0, 20)
  $endsqC = clamp($endsq, 0, 12)
  $wearC = clamp($wear, 0, 4)
  $wearvarC = clamp($wearvar, 0, 1)
  $stateC = clamp($state, 0, 1)
  $decayC = clamp($decay, -1, 1)
  $ridgeC = clamp($ridge, 0, 2)
  $checksC = clamp(floor($checks + 0.5), 0, 4)
  $checkdC = clamp($checkd, 0, 0.9)
  $crumbC = clamp($crumb, 0, 20)
  $sliverC = clamp($sliver, 0, 1)
  $cornerC = clamp($corner, 0, 1)
  $thinC = clamp($thin, 0, 0.6)
  $baseC = clamp($base, -1, 1000)
  $tkC = floor($tk)
  $styleC = clamp(floor($style + 0.5), -1, 4)
  $reachC = clamp($reach, -1, 4)
  $tearC = clamp($tear, 0, 3)
  $curlC = clamp($curl, 0, 30)
  $curlfC = clamp($curlf, 0, 0.95)
  $curlsC = clamp(floor($curls + 0.5), 0, 1)
  $sagC = clamp($sag, 0, 10)
  $sag0C = clamp($sag0, 0, 1)
  $sag1C = clamp($sag1, 0, 1)
  $arrisC = clamp(floor($arris + 0.5), -1, 3)
  $segC = clamp(floor($seg + 0.5), -1, 16)
  $uvsC = clamp(floor($uvs + 0.5), -1, 1)
  $tileC = clamp($tile, 10, 1000)
  $aspectC = clamp($aspect, 0.1, 10)
  $agf = (min($ageC, 1) + 2 * max($ageC - 1, 0))
  $decayA = $decayC + (1 - clamp(ceil($decayC + 0.5), 0, 1)) * (clamp(($ageC - 1.1) / 0.7, 0, 1) - $decayC)
  $AR = $arrisC + (1 - clamp(ceil($arrisC + 0.5), 0, 1)) * (1 + 2 * min($budgetC, 1) - $arrisC)
  $SG = $segC + (1 - clamp(ceil($segC + 0.5), 0, 1)) * (2 + 2 * min($budgetC, 1) + 4 * max($budgetC - 1, 0) - $segC)
  $UV = $uvsC + (1 - clamp(ceil($uvsC + 0.5), 0, 1)) * (min($budgetC, 1) - $uvsC)
  $KK = $noiseC * 1009 + $indexC
