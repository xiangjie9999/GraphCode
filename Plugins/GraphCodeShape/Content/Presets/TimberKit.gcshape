  $jq2 = sin($key * 12.9898 + 784.6) * 43758.5453
  $jq2 = $jq2 - floor($jq2)
  $jq3 = sin($key * 12.9898 + 796.5) * 43758.5453
  $jq3 = $jq3 - floor($jq3)
  $jq4 = sin($key * 12.9898 + 808.4) * 43758.5453
  $jq4 = $jq4 - floor($jq4)
  $jq5 = sin($key * 12.9898 + 820.3) * 43758.5453
  $jq5 = $jq5 - floor($jq5)
  $jq6 = sin($key * 12.9898 + 832.2) * 43758.5453
  $jq6 = $jq6 - floor($jq6)
  $jr1 = sin($key * 12.9898 + 844.1) * 43758.5453
  $jr1 = $jr1 - floor($jr1)
  $jr2 = sin($key * 12.9898 + 856.0) * 43758.5453
  $jr2 = $jr2 - floor($jr2)
  $jr3 = sin($key * 12.9898 + 867.9) * 43758.5453
  $jr3 = $jr3 - floor($jr3)
  $jr4 = sin($key * 12.9898 + 879.8) * 43758.5453
