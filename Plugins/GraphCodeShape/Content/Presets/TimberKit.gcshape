  $Lhi = $R * (0.5 + 0.4 * $ja)
  $Llo = $R * (0.04 + 0.12 * $jb)
  $ti = 1 + floor(6 * $jt)
  $sdir = floor(2 * $jd)
  $sbase = $R * (0.04 + 0.1 * $ja)
  $A1 = $f0 * $R * (0.1 + 0.6 * $jr1 + clamp(1 - abs($ti - 1), 0, 1) * (0.6 + 0.3 * $jz - 0.6 * $jr1)) + $f2 * $R * ((0.06 + 0.22 * $jr1) * (1 - clamp(1 - abs($hm - 1), 0, 1)) * (1 - 0.5 * clamp(1 - abs($hm + $hd - 1), 0, 1)) + clamp(1 - abs($hm - 1), 0, 1) * (0.7 + 0.3 * $jz)) + (1 - $f0 - $f2) * ($f1 * ($Llo + ($Lhi - $Llo) * ($sd * (clamp(ceil($ua1 - $s1), 0, 1) * (1 - 0.5 * $s3) + 0.5 * $s3 * clamp(ceil($ua1 - $s2), 0, 1)) + (1 - $sd) * (1 - (clamp(ceil($ua1 - $s1), 0, 1) * (1 - 0.5 * $s3) + 0.5 * $s3 * clamp(ceil($ua1 - $s2), 0, 1))))) + $f3 * ($sbase * (1 + 0.6 * ($ua1 - 0.5) * (2 * $ja - 1))) + $f4 * ($R * (0.04 + (0.7 + 0.3 * $ja) * ($sdir * $ua1 + (1 - $sdir) * (1 - $ua1)))) + $f2 * 0.05 * $R) + ($f1 * (0.05 + 0.15 * $jr1) + $f3 * (0.05 + 0.18 * $jr1) + $f4 * (0.04 + 0.12 * $jr1)) * $R
  $A2 = $f0 * $R * (0.1 + 0.6 * $jr2 + clamp(1 - abs($ti - 2), 0, 1) * (0.6 + 0.3 * $jz - 0.6 * $jr2)) + $f2 * $R * ((0.06 + 0.22 * $jr2) * (1 - clamp(1 - abs($hm - 2), 0, 1)) * (1 - 0.5 * clamp(1 - abs($hm + $hd - 2), 0, 1)) + clamp(1 - abs($hm - 2), 0, 1) * (0.7 + 0.3 * $jz)) + (1 - $f0 - $f2) * ($f1 * ($Llo + ($Lhi - $Llo) * ($sd * (clamp(ceil($ua2 - $s1), 0, 1) * (1 - 0.5 * $s3) + 0.5 * $s3 * clamp(ceil($ua2 - $s2), 0, 1)) + (1 - $sd) * (1 - (clamp(ceil($ua2 - $s1), 0, 1) * (1 - 0.5 * $s3) + 0.5 * $s3 * clamp(ceil($ua2 - $s2), 0, 1))))) + $f3 * ($sbase * (1 + 0.6 * ($ua2 - 0.5) * (2 * $ja - 1))) + $f4 * ($R * (0.04 + (0.7 + 0.3 * $ja) * ($sdir * $ua2 + (1 - $sdir) * (1 - $ua2)))) + $f2 * 0.05 * $R) + ($f1 * (0.05 + 0.15 * $jr2) + $f3 * (0.05 + 0.18 * $jr2) + $f4 * (0.04 + 0.12 * $jr2)) * $R
  $A3 = $f0 * $R * (0.1 + 0.6 * $jr3 + clamp(1 - abs($ti - 3), 0, 1) * (0.6 + 0.3 * $jz - 0.6 * $jr3)) + $f2 * $R * ((0.06 + 0.22 * $jr3) * (1 - clamp(1 - abs($hm - 3), 0, 1)) * (1 - 0.5 * clamp(1 - abs($hm + $hd - 3), 0, 1)) + clamp(1 - abs($hm - 3), 0, 1) * (0.7 + 0.3 * $jz)) + (1 - $f0 - $f2) * ($f1 * ($Llo + ($Lhi - $Llo) * ($sd * (clamp(ceil($ua3 - $s1), 0, 1) * (1 - 0.5 * $s3) + 0.5 * $s3 * clamp(ceil($ua3 - $s2), 0, 1)) + (1 - $sd) * (1 - (clamp(ceil($ua3 - $s1), 0, 1) * (1 - 0.5 * $s3) + 0.5 * $s3 * clamp(ceil($ua3 - $s2), 0, 1))))) + $f3 * ($sbase * (1 + 0.6 * ($ua3 - 0.5) * (2 * $ja - 1))) + $f4 * ($R * (0.04 + (0.7 + 0.3 * $ja) * ($sdir * $ua3 + (1 - $sdir) * (1 - $ua3)))) + $f2 * 0.05 * $R) + ($f1 * (0.05 + 0.15 * $jr3) + $f3 * (0.05 + 0.18 * $jr3) + $f4 * (0.04 + 0.12 * $jr3)) * $R
