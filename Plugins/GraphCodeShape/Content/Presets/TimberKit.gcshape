  $ua4 = $c3 + (0.3 + 0.4 * $jq4) * ($c4 - $c3)
  $ua5 = $c4 + (0.3 + 0.4 * $jq5) * ($c5 - $c4)
  $ua6 = $c5 + (0.3 + 0.4 * $jq6) * ($c6 - $c5)
  $hm = 2 + floor(4 * $jd)
  $hd = 2 * floor(2 * $jc) - 1
  $hk = 0.35 + 0.3 * $jb
  $im2 = clamp(1 - abs($hm - 2), 0, 1)
  $ua2 = $ua2 + $f2 * $im2 * (clamp($hd, 0, 1) * ($c2 - $ua2 + $hk * ($c3 - $c2)) - clamp(-$hd, 0, 1) * ($ua2 - $c1 + $hk * ($c1 - $c0)))
  $im3 = clamp(1 - abs($hm - 3), 0, 1)
  $ua3 = $ua3 + $f2 * $im3 * (clamp($hd, 0, 1) * ($c3 - $ua3 + $hk * ($c4 - $c3)) - clamp(-$hd, 0, 1) * ($ua3 - $c2 + $hk * ($c2 - $c1)))
  $im4 = clamp(1 - abs($hm - 4), 0, 1)
