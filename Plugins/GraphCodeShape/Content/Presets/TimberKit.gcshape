)) - 0.5), 0, 1) - 1) * $ax, 0 - $Ee * clamp((1 - sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / ($R * (1 + ($tq - 1) * clamp($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / $Lx, 0, 1)))) / 0.1, 0, 1) * ((0.3 + 0.7 * clamp(sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $R, 0, 1)) * (0.25 + clamp(0.35 + 1.3 * noise(2.5 * $OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) / $R, 2.5 * $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) / $R, $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / $D + 3, $K + 15), 0, 1)) * 0.8 * (0.5 + 0.5 * sin(360 * (sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $spe + 0.7 * noise(1.5 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.5 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / (1.5 * $D), $K + 14) + 0.35 * noise(4 * $OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) / $R, 4 * $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) / $R, $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / $D, $K + 16)))) + 0.5 * pow(clamp(sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $R, 0, 1), 3) * (0.5 + 0.5 * clamp(0.35 + 1.3 * noise(2.5 * $OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) / $R, 2.5 * $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) / $R, $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / $D + 3, $K + 15), 0, 1))) * (2 * clamp(ceil((point.t.x * abs($ax) + point.t.y * abs($ay) + point.t.z * abs($az)) - 0.5), 0, 1) - 1) * $ay, 0 - $Ee * clamp((1 - sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / ($R * (1 + ($tq - 1) * clamp($OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / $Lx, 0, 1)))) / 0.1, 0, 1) * ((0.3 + 0.7 * clamp(sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $R, 0, 1)) * (0.25 + clamp(0.35 + 1.3 * noise(2.5 * $OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) / $R, 2.5 * $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) / $R, $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / $D + 3, $K + 15), 0, 1)) * 0.8 * (0.5 + 0.5 * sin(360 * (sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $spe + 0.7 * noise(1.5 * $OwCos($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), 1.5 * $OwSin($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 0, 0), $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / (1.5 * $D), $K + 14) + 0.35 * noise(4 * $OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) / $R, 4 * $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) / $R, $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / $D, $K + 16)))) + 0.5 * pow(clamp(sqrt(pow($OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px), 2) + pow($OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py), 2)) / $R, 0, 1), 3) * (0.5 + 0.5 * clamp(0.35 + 1.3 * noise(2.5 * $OwDot(point.x, point.y, point.z, $e1x, $e1y, $e1z, $px) / $R, 2.5 * $OwDot(point.x, point.y, point.z, $e2x, $e2y, $e2z, $py) / $R, $OwDot(point.x, point.y, point.z, $ax, $ay, $az, $base) / $D + 3, $K + 15), 0, 1))) * (2 * clamp(ceil((point.t.x * abs($ax) + point.t.y * abs($ay) + point.t.z * abs($az)) - 0.5), 0, 1) - 1) * $az)) [value=abs(point.normal.x * $ax + point.normal.y * $ay + point.normal.z * $az), above=0.7]
  }
}

# CHECKS: long V checks ALONG the grain, RADIAL to the pith line, opening outward, deeper than wide, each its own length,
# closing to a hairline at both ends, following a spiral grain; on a cut end the same field runs in as radial END CRACKS.
# Crisp: the V is a creased profile (its lips and floor cut into the mesh as hard lines). `sides`, `ends` 0/1 choose where.
# r5 (owner: "checks are V-shaped ... lips that stay together ... one dominant ... no outward spikes"): the long faces move
# INWARD along the radius to the pith line, the cut ends INWARD along the grain, never along a normal; a slow noise round the
# member makes one check dominant and the rest lesser; only the dominant ones (2-5) run in on a cut end, widest at the rim.
#   count -1 [0..60] checks round the member at one place [pi size / 14: one per 14 cm of girth]   mouth -1 cm [0.012 x size]
#   depth -1 cm [5 x mouth, at most 0.3 size]   clen 6 x size [0.5..20] a check's length   share 0.65 how much of a line is open
#   spiral 3 deg [0..15]   endc 0.35 x radius [0..1] how far end cracks run in   foot 0.5, fh -1: deeper in the foot zone
#   length -1 cm: the member's length from `base` (Member passes it): checks ease out at the cut ends, the rim stays whole
Checks = instruction(along=[(0, 0, 1)], size=40.0, count=-1.0, mouth=-1.0, depth=-1.0, clen=6.0, share=0.65, spiral=3.0, endc=0.35, foot=0.5, fh=-1.0, sides=1, ends=1, length=-1.0, base=0.0, px=0.0, py=0.0, noise=1, budget=1, cut=0, hw=-1.0, hh=-1.0, top=1.0, bulge=0.0) {
  $D = clamp($size, 2, 500)
  $R = 0.5 * $D
  $bg = clamp(floor($budget + 0.5), 0, 2)
  $gm = clamp(ceil(0.5 - $bg), 0, 1)
  $K = floor($noise) * 1009 + 71
  # the grain, normalised, and two directions across it (e1 level when the grain is not upright)
  $gn = sqrt($along[0].x * $along[0].x + $along[0].y * $along[0].y + $along[0].z * $along[0].z) + 0.000001
  $ax = $along[0].x / $gn
  $ay = $along[0].y / $gn
  $az = $along[0].z / $gn
  $up = clamp(ceil(abs($az) - 0.9), 0, 1)
  $f1 = (1 - $up) * (0 - $ay) + $up * (1 - $ax * $ax)
  $f2 = (1 - $up) * $ax + $up * (0 - $ax * $ay)
  $f3 = $up * (0 - $ax * $az)
  $fn = sqrt($f1 * $f1 + $f2 * $f2 + $f3 * $f3) + 0.000001
  $e1x = $f1 / $fn
  $e1y = $f2 / $fn
  $e1z = $f3 / $fn
  $e2x = $ay * $e1z - $az * $e1y
  $e2y = $az * $e1x - $ax * $e1z
  $e2z = $ax * $e1y - $ay * $e1x
  $N = clamp($OwPick($count, 3.14159 * $D / 14), 0, 60) * (1 - 0.5 * $gm)
  $cl = min(clamp($clen, 0.5, 20) * (1 + 0.5 * $gm), 20)
  $mo = clamp($OwPick($mouth, 0.012 * $D), 0, 10)
  $cd = clamp($OwPick($depth, min(5 * $mo, 0.3 * $D)), 0, 100)
  $sh = clamp($share, 0.05, 0.95)
  $sp = clamp($spiral, 0, 15)
  $ec = clamp($endc, 0, 1)
  $Ft = clamp($foot, 0, 3)
  $Fz = clamp($OwPick($fh, 0.6 * $D), 0, 1000)
  $sd = clamp($sides, 0, 1)
  $en = clamp($ends, 0, 1)
  # the member's length (from `base`), when known: the side checks ease out within 1.5 x their depth of a cut end and the end
  # cracks stop short of the rim, so the rim keeps its points (both sinking at once left them standing as spikes at age 2)
  $Lx = $length + (1 - clamp(ceil($length), 0, 1)) * (1000000 - $length)
  $fl = (1 + 1.5 * $gm) * (1 - 0.38 * max($bg - 1, 0))
  $sk = deg(tan($sp) / $R)
  $rho = max($N, 0.5) / ($sh * 9)
  $rg = 0.8 * $rho
  # the checks' lines run 80 x size before they wander a radius (r5, lead: a long split leaning across the shaft read as a slash;
  # real drying checks follow the grain, near-vertical, the spiral only a few degrees)
  $Lc = 80 * $D
  $Lg = $cl * $D
  $th = 0.5 - $sh
  # end grain checks first: the gate is opened by `$eb` within the last 8 % of the member at either end
  $eb = 0.4
  # the field changes about 0.7 a unit per unit across a check (measured on the 45 cm pillar: 1.3 drew the mouth 3 x wide, 0.43 a
  # hairline the mesh could not hold); where the points are too coarse for the lips ($fine), only the floors are creased (OwV1)
  $wn = 0.5 * $mo * 0.7 * $rho / $R
  $rin = $R * (1 - $ec)
  # r7: where a check is open (its band three times as wide) the long faces take points ALONG the grain as fine as across it,
  # so a lip is drawn by its own crease and never by a 9 cm row of points (the r6 sawtooth); with those points the lips are
  # creased on High too (r6 creased only the floors past ~9 checks); Game keeps the floors only
  $fr = max($fl, min(0.04 * $D * (1 + 2 * $gm), 3.14159 * $D / (12 * max($N, 1))))
  # creasing the lips too cost ~50 s on one age-2 round (60 lines); floors only where the checks are dense, as in r6
  $fine = max($gm, clamp(ceil($fl - 3.14159 * $D / (12 * max($N, 1))), 0, 1))
  $ct = clamp(floor($cut + 0.5), 0, 1)
  if ($ct > 0.5) {
    # CUT CHECKS (r7, the method that replaced the sampled V on members): each check is a thin V cut away along the grain, so
    # its lips are crisp at any width, nothing moves outward, and no crease is cut; `hw`, `hh` (-1: round, radius size/2 about
    # the pith) give a rectangular section's half sizes about the frame's origin, so a check starts at the face it opens on
    $Ls = $length + (1 - clamp(ceil($length), 0, 1)) * (4 * $D - $length)
    $ox = $base * $ax + $px * $e1x + $py * $e2x
    $oy = $base * $ay + $px * $e1y + $py * $e2y
    $oz = $base * $az + $px * $e1z + $py * $e2z
    $rect = clamp(ceil($hw), 0, 1)
    $hwv = max($hw, 0.01)
    $hhv = max($hh, 0.01)
    # a plank's pith lies outside its section, below it: its checks open on the top face only
    $pout = $rect * clamp(ceil(abs($py) - $hhv), 0, 1)
    $win = atan(0.85 * $hwv / max($hhv + abs($py), 0.1))
    $tq = (1 - $rect) * clamp($top, 0.3, 1.5) + $rect
    $bq = (1 - $rect) * clamp($bulge, 0, 0.3)
    $Lc = max(min($cl * $D, 0.9 * $Ls), 2)
    # how many: `count` round the member at any one place; each is about 0.9 Lc long and `share` of each line is open (photo 02:
    # ~5 across the pillar's front, so ~10 round it)
    $nc = clamp(floor($N * $Ls / (0.9 * $Lc) + 0.5), 1, 24) * clamp(ceil($N - 0.5), 0, 1) * $sd
    $rk = (1 - $rect) * $sk
    $th0 = 360 * $Hash($K, 401.9)
    if ($nc > 0.5) {
      loop (repeat=$nc) {
        $i = output.index
        $q = $K + 41 * $i + 3
        # one or two dominant, the rest lesser and uneven
        $dm = 0.2 + 0.8 * pow($Hash($q, 403.1), 2)
        $ln = min($Lc * (0.5 + 0.8 * $Hash($q, 405.7)), 0.98 * $Ls)
        # end grain checks first: four in ten run out of a cut end, open there and deepened as the radial end check
        $s0 = clamp(ceil($Hash($q, 407.9) - 0.6), 0, 1) * $en
        $s1 = clamp(ceil($Hash($q, 409.3) - 0.6), 0, 1) * $en * (1 - $s0)
        $z0 = ($Ls - $ln) * $Hash($q, 411.1) * (1 - $s0 - $s1) + $s0 * (0 - 0.5) + $s1 * ($Ls + 0.5 - $ln)
        $th = (1 - $pout) * ($th0 + 137.508 * $i + 6 * ($Hash($q, 413.3) - 0.5)) + $pout * (90 + (2 * $Hash($q, 413.3) - 1) * $win)
        $c = cos($th)
        $s = sin($th)
        $tx = ((2 * clamp(ceil($c), 0, 1) - 1) * $hwv - $px) / ((2 * clamp(ceil($c), 0, 1) - 1) * max(abs($c), 0.0001))
        $ty = ((2 * clamp(ceil($s), 0, 1) - 1) * $hhv - $py) / ((2 * clamp(ceil($s), 0, 1) - 1) * max(abs($s), 0.0001))
        $rs = (1 - $rect) * $R + $rect * min($tx, $ty)
        # a mouth under ~3 mm left the boolean too thin a wedge to seat (the 9 cm fence rails, r7)
        $wk = max($mo * (0.45 + 0.55 * $dm), min(0.3, 0.04 * $D))
        $dk = min($cd * $dm, 0.8 * $rs)
        $ek = clamp($ec * $R / max($dk, 0.1) - 1, 0, 4)
        subtract($OwCheckCut, len=$ln, w=$wk, cd=$dk, H=2 + 0.05 * $D, z0=$z0, th=$th, rs=$rs, rk=$rk, wn=2 * (1 - $rect), s0=$s0, s1=$s1, endk=$ek, Ls=$Ls, tq=$tq, bq=$bq, D=$D, key=$q, ox=$ox, oy=$oy, oz=$oz, ax=$ax, ay=$ay, az=$az, e1x=$e1x, e1y=$e1y, e1z=$e1z, e2x=$e2x, e2y=$e2y, e2z=$e2z)
      }
    }
