# END CRACKS alone: `Checks` on the cut ends only (radial, from the rim `endc` of the radius in)
EndCracks = instruction(along=[(0, 0, 1)], size=40.0, count=-1.0, mouth=-1.0, depth=-1.0, endc=0.35, spiral=3.0, base=0.0, px=0.0, py=0.0, noise=1, budget=1) {
  $Checks(along=$along, size=$size, count=$count, mouth=$mouth, depth=$depth, endc=$endc, spiral=$spiral, sides=0, ends=1, base=$base, px=$px, py=$py, noise=$noise, budget=$budget)
}

# SLAB LOSS AND ROT HOLES (OW1 r7; photo 01, the old fence post): on very old wood a SLAB splits off along the grain and is
# lost, leaving a flat SHELF bounded on one side by a check (its wall, with the crack running on past it) and torn off at
# both ends in STEPS; rot eats one or two round HOLES into the heart. Both are CUT AWAY (`subtract`), so nothing can leave the
# original section, and the shelf is planar and crisp (a split face, not a dent). Call it first, before `WoodPoints`: the
# later treatments then give the shelf its fibre, its worn lips and its checks like any other face.
#   count -1 [0..3] slabs [none below age 1.3; 1 at 1.5, 3 at 2 on a member 2 x its size long or more]
#   holes -1 [0..2] rot holes, long along the grain [none below age 1.6 or under 14 cm; 2 at age 2 on a member 2 x its size long]
#   depth -1 cm [0..50] a shelf's depth below the face at its middle [0.04-0.1 x size, drawn]
#   length -1 cm the member's length from `base` (Member passes it; unknown: 4 x size); top, bulge: Member's taper and entasis
#   (the shelf's depth is measured from the face where it lies); age 0-2 scales the count and the depth
OwSlabCut = mesh(rp=18.0, ua=-12.0, ub=6.0, len=40.0, z0=0.0, H=6.0, tear=0.3, fib=0.3, tilt=0.0, key=1, th=0.0, tl=0.0, sk=1.0, dir=0, jt=0.1, ox=0.0, oy=0.0, oz=0.0, ax=0.0, ay=0.0, az=1.0, e1x=1.0, e1y=0.0, e1z=0.0, e2x=0.0, e2y=1.0, e2z=0.0) {
  # r8 (lead: "clean rectangular windows ... like a door"): the footprint is six columns across (x, round the member) whose ends
  # step OBLIQUELY with the grain (each riser runs along y, the grain): longest beside the check wall (`ub`), shortening toward
  # the run-out side, so the shelf tapers to both ends; the floor tilts
  # along its length (`tilt` cm), so its width runs out unevenly; the sides tear (`tear`)
  $wq = $ub - $ua
  # each shelf its own slope of the torn ends (0.15-0.30 of its length across it) and uneven steps
  $sl = (0.15 + 0.15 * $Hash($key, 97.1)) * clamp($sk, 0, 2)
  # r9: `dir` 1 runs the slope the other way (the longest column at `ua`); `sk` scales it (a narrow strip on a square post: 0.35)
  $dr = clamp(floor($dir + 0.5), 0, 1)
  $x1 = $ua + $wq * (1/6 + 0.11 * ($Hash($key, 103.5) - 0.5))
  $x2 = $ua + $wq * (2/6 + 0.11 * ($Hash($key, 105.7) - 0.5))
