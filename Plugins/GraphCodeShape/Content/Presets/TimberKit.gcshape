  $jt = sin($key * 12.9898 + 998.8) * 43758.5453
  $jt = $jt - floor($jt)
  $jz = sin($key * 12.9898 + 1010.7) * 43758.5453
  $jz = $jz - floor($jz)
  $ja = sin($key * 12.9898 + 1022.6) * 43758.5453
  $ja = $ja - floor($ja)
  $jb = sin($key * 12.9898 + 1034.5) * 43758.5453
  $jb = $jb - floor($jb)
  $jc = sin($key * 12.9898 + 1046.4) * 43758.5453
  $jc = $jc - floor($jc)
  $jd = sin($key * 12.9898 + 1058.3) * 43758.5453
  $jd = $jd - floor($jd)
  $jp1 = sin($key * 12.9898 + 1070.2) * 43758.5453
  $jp1 = $jp1 - floor($jp1)
  $jp2 = sin($key * 12.9898 + 1082.1) * 43758.5453
  $jp2 = $jp2 - floor($jp2)
  $f0 = clamp(1 - abs($sty - 0), 0, 1)
  $f1 = clamp(1 - abs($sty - 1), 0, 1)
  $f2 = clamp(1 - abs($sty - 2), 0, 1)
  $f3 = clamp(1 - abs($sty - 3), 0, 1)
  $f4 = clamp(1 - abs($sty - 4), 0, 1)
  $su = 0.4 + 1.2 * $jw1 + 0.4 + 1.2 * $jw2 + 0.4 + 1.2 * $jw3 + 0.4 + 1.2 * $jw4 + 0.4 + 1.2 * $jw5 + 0.4 + 1.2 * $jw6
  $c1 = (0.4 + 1.2 * $jw1) / $su
  $c2 = (0.4 + 1.2 * $jw1 + 0.4 + 1.2 * $jw2) / $su
  $c3 = (0.4 + 1.2 * $jw1 + 0.4 + 1.2 * $jw2 + 0.4 + 1.2 * $jw3) / $su
  $c4 = (0.4 + 1.2 * $jw1 + 0.4 + 1.2 * $jw2 + 0.4 + 1.2 * $jw3 + 0.4 + 1.2 * $jw4) / $su
  $c5 = (0.4 + 1.2 * $jw1 + 0.4 + 1.2 * $jw2 + 0.4 + 1.2 * $jw3 + 0.4 + 1.2 * $jw4 + 0.4 + 1.2 * $jw5) / $su
  $c0 = 0.0
  $c6 = 1.0
  $ua1 = $c0 + (0.3 + 0.4 * $jq1) * ($c1 - $c0)
  $ua2 = $c1 + (0.3 + 0.4 * $jq2) * ($c2 - $c1)
