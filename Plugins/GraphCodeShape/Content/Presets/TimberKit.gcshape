          $s1 = clamp(ceil($Hash($qb, 509.7) - 0.7), 0, 1) * (1 - $s0)
          $z0 = ($Ls - $cl) * $Hash($qb, 511.9) * (1 - $s0 - $s1) + $s0 * (0 - 0.5) + $s1 * ($Ls + 0.5 - $cl)
          subtract($OwCheckCut, len=$cl, w=max(min(0.3, 0.04 * $D), 0.35 + 0.45 * $Hash($qb, 513.3)), cd=min($D * (0.1 + 0.12 * $Hash($qb, 515.7)), 0.8 * $hf), H=2 + 0.05 * $D, z0=$z0, th=$thf, rs=$hf, u=$bj, s0=$s0, s1=$s1, endk=1, Ls=$Ls, D=$D, key=$qb, ox=$ox, oy=$oy, oz=$oz, ax=$ax, ay=$ay, az=$az, e1x=$e1x, e1y=$e1y, e1z=$e1z, e2x=$e2x, e2y=$e2y, e2z=$e2z)
        }
      }
    }
    # (b) the strips lost, up to two lengths each, the arris strips likelier (run out past the arris, so the corner goes too)
    loop (repeat=4) {
      $f = output.index
      $thf = 90 * $f
      $hf = abs(cos($thf)) * $hwv + abs(sin($thf)) * $hhv
      $ht = abs(sin($thf)) * $hwv + abs(cos($thf)) * $hhv
      $nst = clamp(floor(2 * $ht / 3.4 + 0.5), 2, 6)
      loop (repeat=3 * $nst) {
        $k = output.index
        $j = floor($k / 3)
        $sg = $k - 3 * $j
        $q = $K + 211 * $f + 17 * $k + 3
        $e0 = clamp(1 - $j, 0, 1)
        $e1 = clamp($j + 2 - $nst, 0, 1)
        # photo 01: every strip broken at several heights, each loss ending in a jagged step; the first (sg 0) long, two more
        # (sg 1, 2) shorter, narrower and deeper, anywhere along the strip, so the ends step within a strip and between strips
        if ($Hash($q, 521.7) < $pl * (1 + 0.3 * max($e0, $e1)) * (1 - 0.2 * $sg)) {
          $bl = (1 - $e0) * (0 - $ht + 2 * $ht * ($j + 0.35 * ($Hash($K + 101 * $f + 13 * $j, 501.3) - 0.5)) / $nst) + $e0 * (0 - $ht - 3)
          $br = (1 - $e1) * (0 - $ht + 2 * $ht * ($j + 1 + 0.35 * ($Hash($K + 101 * $f + 13 * ($j + 1), 501.3) - 0.5)) / $nst) + $e1 * ($ht + 3)
          $wl = $br - $bl
          $sn = clamp($sg, 0, 1)
          $u0 = $bl + $sn * $wl * 0.45 * $Hash($q, 537.1)
          $u1 = $br - $sn * $wl * 0.45 * $Hash($q, 539.3)
          # photo 01: the outer wood breaks along a few lines ACROSS the face, neighbouring strips ending near the same height, so
          # the face reads in torn bands: four break heights per face (one in each quarter); a loss runs from one to the next
          # (the first loss, one time in three, to the one after), each end its own few cm off the line
          $i0 = clamp(floor(4 * $Hash($q, 523.1)), 0, 3 - clamp(1 - $sn, 0, 1) * clamp(ceil($Hash($q, 524.7) - 0.67), 0, 1))
          $i1 = $i0 + 1 + (1 - $sn) * clamp(ceil($Hash($q, 524.7) - 0.67), 0, 1)
          $za = $ms + $uq * ($i0 + 0.2 + 0.6 * $Hash($K + 101 * $f + 7 * $i0, 561.1)) / 4.6 + 0.03 * $Ls * ($Hash($q, 525.3) - 0.5)
          $zb = $ms + $uq * ($i1 + 0.2 + 0.6 * $Hash($K + 101 * $f + 7 * $i1, 561.1)) / 4.6 + 0.03 * $Ls * ($Hash($q, 526.9) - 0.5)
          $ln = clamp($zb - $za, 3, $uq)
          $zc = clamp(0.5 * ($za + $zb), $ms + 0.5 * $ln, $Ls - $ms - 0.5 * $ln)
          # photo 01: a lost strip steps 1-3 cm (r9's first build at 0.5-1.9 cm on the 14 cm post read as shallow recesses)
          $dd = min($D * (0.07 + 0.1 * $Hash($q, 527.9) + 0.04 * $sg) * (0.5 + 0.5 * $ga), 0.45 * $hf)
          # the torn ends run ACROSS the grain (photo 01): a strip's slope and column steps small (`sk` 0.1, `jt` about 1.2 cm)
          subtract($OwSlabCut, rp=$hf - $dd, ua=$u0 - 0.12 - 0.2 * $Hash($q, 529.1), ub=$u1 + 0.12 + 0.2 * $Hash($q, 531.3), len=$ln, z0=$zc - 0.5 * $ln, H=$dd + 2, tilt=0.8 * $dd * ($Hash($q, 533.7) - 0.5), key=$q, th=$thf, tl=$tl, sk=0.1, jt=min(0.1, 1.2 / $ln), dir=floor(2 * $Hash($q, 535.9)), ox=$ox, oy=$oy, oz=$oz, ax=$ax, ay=$ay, az=$az, e1x=$e1x, e1y=$e1y, e1z=$e1z, e2x=$e2x, e2y=$e2y, e2z=$e2z)
        }
      }
    }
    # (c) the arrises eaten back: up to three torn facets on each, each at its own angle (30-60 deg off the face) and depth
    loop (repeat=12) {
      $k = output.index
      $a = floor($k / 3)
      $sg = $k - 3 * $a
      $q = $K + 307 * $a + 19 * $sg + 11
      if ($Hash($q, 541.3) < 0.45 + 0.45 * $ga) {
        $cx = (2 * clamp(ceil(cos(45 + 90 * $a)), 0, 1) - 1) * $hwv
        $cy = (2 * clamp(ceil(sin(45 + 90 * $a)), 0, 1) - 1) * $hhv
        # 30-60 deg off the face (r9: at 22 deg a facet met the roughened face so obliquely the cut did not seat)
        $ps = 30 + 30 * $Hash($q, 543.7)
        $ph = 90 * $a + $ps
        $dd = $D * (0.04 + 0.08 * $Hash($q, 545.9)) * (0.5 + 0.5 * $ga)
        $ln = $Ls * (0.2 + 0.3 * $Hash($q, 547.1))
        $zc = clamp($ms + 0.5 * $ln + max($uq - $ln, 0) * ($sg + 0.5 + 0.8 * ($Hash($q, 549.3) - 0.5)) / 3, $ms + 0.5 * $ln, $Ls - $ms - 0.5 * $ln)
        $tc = 0 - $cx * sin($ph) + $cy * cos($ph)
        subtract($OwSlabCut, rp=$cx * cos($ph) + $cy * sin($ph) - $dd, ua=$tc - $dd * cos($ps) / sin($ps) - 0.6, ub=$tc + $dd * sin($ps) / cos($ps) + 0.6, len=$ln, z0=$zc - 0.5 * $ln, H=$dd + 2, tilt=0.6 * $dd * ($Hash($q, 551.3) - 0.5), key=$q, th=$ph, tl=$tl, sk=0.3, jt=min(0.1, 2 / $ln), dir=floor(2 * $Hash($q, 553.9)), ox=$ox, oy=$oy, oz=$oz, ax=$ax, ay=$ay, az=$az, e1x=$e1x, e1y=$e1y, e1z=$e1z, e2x=$e2x, e2y=$e2y, e2z=$e2z)
      }
    }
  }
  if ($ns * (1 - $lam) > 0.5) {
    loop (repeat=$ns) {
      $i = output.index
      $q = $K + 37 * $i
      # long, each its own length, depth and width, overlapping in height and never aligned: round the member about a quarter
      # turn apart (lead r8: "2-3 shelves of different widths and depths, overlapping in height, never aligned")
      $ln = min($D * (0.9 + 0.8 * $Hash($q, 201.1)), 0.9 * $us)
      $zc = $m + 0.5 * $ln + max($us - $ln, 0) * $Hash($q, 203.3)
      $tt = clamp($zc / $Ls, 0, 1)
      $sc = 1 + ($tq - 1) * $tt + $bq * sin(180 * min(1, $tt / 0.66))
      $th = (1 - $rect) * ($th0 + ($i - 1) * (80 + 30 * $Hash($q, 209.3))) + $rect * (1 - $pout) * 90 * floor(4 * $Hash($q, 209.3)) + $pout * 90
      $c = cos($th)
      $s = sin($th)
      $tx = ((2 * clamp(ceil($c), 0, 1) - 1) * $hwv - $px) / ((2 * clamp(ceil($c), 0, 1) - 1) * max(abs($c), 0.0001))
      $ty = ((2 * clamp(ceil($s), 0, 1) - 1) * $hhv - $py) / ((2 * clamp(ceil($s), 0, 1) - 1) * max(abs($s), 0.0001))
      $Rl = ((1 - $rect) * $R + $rect * min($tx, $ty)) * $sc
      # depth: a round's shelf 0.03-0.11 x size; a rectangle's (a square post's face) 0.08-0.18, or it barely read on a 14 cm post
      $hd = min(clamp($OwPick($depth, $D * (0.03 + 0.05 * $rect + (0.08 + 0.02 * $rect) * $Hash($q, 205.7))), 0, 50) * (0.5 + 0.5 * $ga), (1 - $rect) * 0.35 * $Rl + $rect * 0.6 * min($hwv, $hhv))
      $rp = $Rl - $hd
      $cc = sqrt(max($Rl * $Rl - $rp * $rp, 0.01))
      $ce = abs($s) * $hwv + abs($c) * $hhv
      $ua = (1 - $rect) * (-1.3 * $cc) + $rect * (0 - $ce - 1)
      $ub = (1 - $rect) * (0.2 + 0.5 * $Hash($q, 207.9)) * $cc + $rect * (0.6 * $Hash($q, 207.9) - 0.1) * $ce
      subtract($OwSlabCut, rp=$rp, ua=$ua, ub=$ub, len=$ln, z0=$zc - 0.5 * $ln, H=$hd + 2, tear=min(0.3, 0.02 * $D), fib=min(0.35, 0.25 * $hd), tilt=1.2 * $hd * ($Hash($q, 213.1) - 0.5), key=$q, th=$th, tl=$tl, ox=$ox, oy=$oy, oz=$oz, ax=$ax, ay=$ay, az=$az, e1x=$e1x, e1y=$e1y, e1z=$e1z, e2x=$e2x, e2y=$e2y, e2z=$e2z)
      $sl = min($ln * (1.3 + 0.5 * $Hash($q, 211.1)), $Ls - $m)
      # the bounding check starts below the tilted floor's lowest point (from the floor plane its mouth crossed the tilted floor
      # nearly flat: an oblique coincidence the boolean could not seat, r8), so its walls rise square through the floor
      subtract($OwCheckCut, len=$sl, w=2 * min(0.3, 0.02 * $D) + 0.2, cd=0.6 * $hd, H=1.8 * $hd + 2, z0=clamp($zc - 0.5 * $sl, 0.5 * $m, max(0.5 * $m, $Ls - 0.5 * $m - $sl)), th=$th, rs=$rp - 0.7 * $hd, u=$ub, D=$D, Ls=$Ls, key=$q + 5, ox=$ox, oy=$oy, oz=$oz, ax=$ax, ay=$ay, az=$az, e1x=$e1x, e1y=$e1y, e1z=$e1z, e2x=$e2x, e2y=$e2y, e2z=$e2z)
    }
  }
  if ($nh > 0.5) {
    loop (repeat=$nh) {
      $j = output.index
      $q = $K + 53 * $j + 7
      $zh = $m + ($j - 0.5 + 0.6 * ($Hash($q, 301.1) - 0.5)) / $nh * $us
      $tt = clamp($zh / $Ls, 0, 1)
      $sc = 1 + ($tq - 1) * $tt + $bq * sin(180 * min(1, $tt / 0.66))
      $th = (1 - $rect) * (360 * $Hash($q, 305.7) + 97 * $j) + $rect * (1 - $pout) * 90 * floor(4 * $Hash($q, 305.7)) + $pout * 90
      $c = cos($th)
      $s = sin($th)
      $tx = ((2 * clamp(ceil($c), 0, 1) - 1) * $hwv - $px) / ((2 * clamp(ceil($c), 0, 1) - 1) * max(abs($c), 0.0001))
      $ty = ((2 * clamp(ceil($s), 0, 1) - 1) * $hhv - $py) / ((2 * clamp(ceil($s), 0, 1) - 1) * max(abs($s), 0.0001))
      $Rl = ((1 - $rect) * $R + $rect * min($tx, $ty)) * $sc
      $rr = min($D * (0.08 + 0.04 * $Hash($q, 303.3)), (1 - $rect) * $R + $rect * 0.8 * min($hwv, $hhv))
      subtract($OwHoleCut, rr=$rr, rt=0.55 * $rr, ra=1.8 * $rr, rc=$Rl - 0.65 * $rr, zc=$zh, key=$q, th=$th, ox=$ox, oy=$oy, oz=$oz, ax=$ax, ay=$ay, az=$az, e1x=$e1x, e1y=$e1y, e1z=$e1z, e2x=$e2x, e2y=$e2y, e2z=$e2z)
    }
  }
  # the cut faces take even points (the cuts left long fans, which the later warps shaded as crumpled patches)
  # r9: coarser along the grain (x 8) than across: the isotropic points were 226k of the r9 post's 274k triangles
  $sx = max(3, 0.08 * $D)
  if ($ns + $nh > 0.5) {
    if (abs($az) > 0.9) {
      roughen(by=0.01, scale=($sx, $sx, 8 * $sx), seed=$K + 19) [cut]
    } else {
      if (abs($ax) > 0.9) {
        roughen(by=0.01, scale=(8 * $sx, $sx, $sx), seed=$K + 19) [cut]
      } else {
        if (abs($ay) > 0.9) {
          roughen(by=0.01, scale=($sx, 8 * $sx, $sx), seed=$K + 19) [cut]
        } else {
          roughen(by=0.01, scale=$sx, seed=$K + 19) [cut]
        }
      }
    }
  }
}

# OLD WOOD, the usual set at one `age` (0 new, 1 aged: "a bit aged", 2 old): WoodPoints, Wear, Rot (from age 0.3), Erosion,
# Checks with their end cracks, every amount from `age` where its knob is -1 (the photo values in the header above).
OldWood = instruction(along=[(0, 0, 1)], size=40.0, age=1.0, checks=-1.0, erosion=-1.0, wear=-1.0, foot=-1.0, weather_side=-1.0, noise=1, budget=1, base=0.0, px=0.0, py=0.0, spiral=-1.0, clen=-1.0, mouth=-1.0, cdepth=-1.0, share=-1.0, endc=-1.0, rot=-1.0, fh=-1.0, relief=-1.0, length=-1.0, slabs=-1.0, holes=-1.0, ease=-1.0, top=1.0, bulge=0.0, cut=0, hw=-1.0, hh=-1.0) {
  $A = clamp($age, 0, 2)
  $a1 = min($A, 1)
  $a2 = max($A - 1, 0)
  $D = clamp($size, 2, 500)
  $N = clamp($OwPick($checks, 3.14159 * $D * ($a1 / 14 + $a2 / 28)), 0, 60)
  $E = clamp($OwPick($erosion, min(1, 0.0035 * $D * $a1 + $a2 * min(max(0.0135 * $D, 0.5), 0.05 * $D))), 0, 1.5)
  $M = 0
  $W = clamp($OwPick($wear, min(1, $D / 30) * (0.25 * $a1 + 0.35 * $a2)), 0, 3)
  $Ft = clamp($OwPick($foot, 0.5 * $a1 + 0.5 * $a2), 0, 3)
  $ws = clamp($OwPick($weather_side, 0.6), 0, 1)
  $sp = clamp($OwPick($spiral, 3), 0, 15)
  $cl = clamp($OwPick($clen, 8), 0.5, 20)
  # r7: past age 1 a check opens about a centimetre whatever the member's size (photo 01; scaled with size, a 14 cm post's
  # checks stayed 4 mm hairlines at age 1.8), never past 0.08 size
  $mo = clamp($OwPick($mouth, min(0.015 * $D * $a1 + $a2 * max(0.017 * $D, 0.7), 0.08 * $D)), 0, 10)
  $cd = clamp($OwPick($cdepth, min(5 * $mo, 0.3 * $D)), 0, 100)
  $sh = clamp($OwPick($share, 0.65), 0.05, 0.95)
  $ec = clamp($OwPick($endc, 0.35 * $a1 + 0.15 * $a2), 0, 1)
  $rt = clamp($OwPick($rot, $D * (0.05 * clamp(($A - 0.3) / 0.7, 0, 1) + 0.03 * clamp($A - 1, 0, 1))), 0, 50)
  $Fz = clamp($OwPick($fh, 0.6 * $D), 0, 1000)
  # the worn soft rim (r7): every cut end eased in this far, smoothly [0.004 x size at age 1, 0.016 x size at 2]
  $ee = clamp($OwPick($ease, $D * (0.004 * $a1 + 0.012 * $a2)), 0, 5)
  if ($A > 0.01) {
    # points first, then the cuts (r7: thin wedges cut against the bare extrusion's 4 m tall triangles failed to seat, pinching it)
    $WoodPoints(along=$along, size=$D, count=$N, noise=$noise, budget=$budget, length=$length, base=$base)
    # cut checks (`cut=1`, a member of known section) go in with the slabs, before the points; sampled ones (a carved shape) last
    $ctw = clamp(floor($cut + 0.5), 0, 1)
    # slabs and rot holes on any member of 8 cm or more: rounds, and (r8) square posts and planks into a face from an arris
    $sok = clamp(ceil($D - 7.5), 0, 1)
    # r9: a square post past age 1.3 ages as strips (Slabs), whose checks run between the strips: the random side checks stay off
    # (one landing a few mm from a strip's wall left a sliver)
    $lmo = clamp(ceil($hw), 0, 1) * (1 - clamp(ceil(abs($py) - max($hh, 0.01)), 0, 1)) * clamp(ceil($A - 1.3), 0, 1) * $sok * clamp(ceil($OwPick($slabs, 1) - 0.5), 0, 1)
    if ($ctw > 0.5) {
      $Checks(along=$along, size=$D, count=$N, mouth=$mo, depth=$cd, clen=$cl, share=$sh, spiral=$sp, endc=$ec, foot=$Ft, fh=$Fz, sides=1 - $lmo, length=$length, base=$base, px=$px, py=$py, noise=$noise, budget=$budget, cut=1, hw=$hw, hh=$hh, top=$top, bulge=$bulge)
    }
    # the slabs after the checks: a shelf splits off along a check and cuts through the others (checks over a cut shelf did not seat)
    if ($A * $sok > 1.3) {
      $Slabs(along=$along, size=$D, count=$slabs, holes=$holes, age=$A, length=$length, top=$top, bulge=$bulge, base=$base, px=$px, py=$py, noise=$noise, hw=$hw, hh=$hh)
    }
    # a member with cut checks is worn by the rim's ease and the erosion; curvature wear on the cuts' fine lips folded (r7)
    $Wear(amount=$W * (1 - $ctw), size=$D, weather_side=$ws, noise=$noise, along=$along, length=$length, base=$base, px=$px, py=$py)
    if ($rt > 0.01) {
      $Rot(along=$along, size=$D, amount=$rt, fh=$Fz, base=$base, px=$px, py=$py, noise=$noise, budget=$budget)
    }
    $Erosion(along=$along, size=$D, amount=$E, relief=$M, foot=$Ft, fh=$Fz, weather_side=$ws, base=$base, px=$px, py=$py, noise=$noise, budget=$budget, length=$length, ease=$ee, top=$top)
    if ($ctw < 0.5) {
      $Checks(along=$along, size=$D, count=$N, mouth=$mo, depth=$cd, clen=$cl, share=$sh, spiral=$sp, endc=$ec, foot=$Ft, fh=$Fz, length=$length, base=$base, px=$px, py=$py, noise=$noise, budget=$budget)
    }
  }
}


# BEND: a member's bends, on a member STANDING along +Z from z = 0, centred (the `Member` frame); every amount signed, 0 none.
# bow, crook, twist, cup and a waney edge are the boards' own `Age`, REUSED: the member is turned into the board frame (grain +Y,
# bottom on z = 0, a proper turn so its faces stay outward), aged, and turned back; bow is across the thickness (Y), crook
# across the width (X). sag is a beam's dip toward +X (laid with rotate=(0, -90, 0), +X points down); wobble an unsawn pole's
# wandering axis (waves ~7 size long); knots stand where the wood round them is sunk (r9: inward only). Call it after the age and the UV, so both bend with the wood.
#   profile 0 round / 1 square / 2 plank   size, width (-1 = size), length cm   bow, crook, cup, waney, sag, wobble, knots cm   twist deg
Bend = instruction(profile=0, size=20.0, width=-1.0, length=200.0, bow=0.0, crook=0.0, twist=0.0, cup=0.0, waney=0.0, sag=0.0, wobble=0.0, knots=0.0, noise=1) {
  $pq = clamp(floor($profile + 0.5), 0, 3)
  $sz = clamp($size, 1, 300)
  $wd = clamp($OwPick($width, $sz), 1, 600)
  $ln = clamp($length, 1, 2000)
  $Km = floor($noise) * 1009 + 23
  $sawn = clamp(ceil($pq - 0.5), 0, 1) * clamp(ceil(2.5 - $pq), 0, 1)
  $bw = clamp($bow, -0.2 * $ln, 0.2 * $ln)
  $ck = clamp($crook, -0.2 * $ln, 0.2 * $ln)
  $tw = clamp($twist, -90, 90)
  $cu = clamp($cup, -0.2 * $wd, 0.2 * $wd) * $sawn
  $wv = clamp($waney, 0, 0.2 * $wd) * $sawn
  $sg = clamp($sag, 0, 0.2 * $ln)
  $wo = clamp($wobble, 0, 2 * $sz)
  $kn = clamp($knots, 0, 0.5 * $sz)
  if (abs($bw) + abs($ck) + abs($tw) + abs($cu) + $wv > 0.01) {
    warp(to=(point.x, point.z, 0.5 * $sz - point.y))
    $Age(w=$wd * $sawn + $sz * (1 - $sawn), t=$sz, len=$ln, cupv=$cu, bowv=$bw, crookv=$ck, twistv=$tw, wanev=$wv, wanek=0.5 + 1.5 * $Hash($Km, 4161.9), wanes=2 * floor(2 * $Hash($Km, 4167.1)) - 1)
    warp(to=(point.x, 0.5 * $sz - point.z, point.y))
  }
  # r9 (owner: nothing leaves the original section): the knots stand because the wood AROUND them is sunk (up to 0.8 x `knots`,
  # radially, before the axis wanders), never by pushing them out along the normal; near the axis the sink fades (an end face's pith)
  if ($kn > 0.01) {
    warp(by=(0 - point.x * $kn * clamp(0.8 - max(0, 2 * noise(point.x / (0.3 * $sz), point.y / (0.3 * $sz), point.z / (0.5 * $sz), $Km + 5) - 0.6), 0, 0.8) * clamp(sqrt(point.x * point.x + point.y * point.y) / (0.4 * $sz), 0, 1) / (sqrt(point.x * point.x + point.y * point.y) + 0.001), 0 - point.y * $kn * clamp(0.8 - max(0, 2 * noise(point.x / (0.3 * $sz), point.y / (0.3 * $sz), point.z / (0.5 * $sz), $Km + 5) - 0.6), 0, 0.8) * clamp(sqrt(point.x * point.x + point.y * point.y) / (0.4 * $sz), 0, 1) / (sqrt(point.x * point.x + point.y * point.y) + 0.001), 0))
  }
  if ($sg + $wo > 0.01) {
    warp(to=(point.x + $sg * 4 * point.t.z * (1 - point.t.z) + $wo * noise(0.3, 0.7, point.z / (7 * $sz), $Km + 3), point.y + $wo * noise(0.9, 0.2, point.z / (7 * $sz), $Km + 4), point.z))
  }
}

# ONE WOODEN MEMBER (OW1, owner 20 Nov: "Everything should be a kit"; "a ladder would share the same thing as a pole, make it
# bigger and it becomes a pillar"): a post, pole, rail, rung, beam, plank or pillar is ONE entry with its section as a setting,
# aged by `OldWood` in its own grain. It STANDS along +Z from z = 0 to `length`, centred on x = y = 0 (the grain +Z); lay it down
# or turn it with `add(..., rotate=)`, the age stays in its own frame.
#   Kit    = shape('/GraphCodeShape/Presets/TimberKit', Face = $Oak, Broken = $OakEnd)
#   Pillar = mesh() { add($Kit.Member, profile=0, size=45, length=400, top=0.88, bulge=0.06, age=1, noise=3) }
#   Rail   = mesh() { add($Kit.Member, profile=0, size=8, length=200, age=1.2, rotate=(0, 90, 0)) }
#   knob      default unit  range        what it does
#   profile         0 0-3   [0..3]       0 round (a pole, a pillar, a rung), 1 square or rectangular (a post, a beam), 2 plank
#                                        (flat-sawn: the pith far off one face), 3 your own `section` (a plane() entry, in cm)
#   size           20 cm    [1..300]     the thickness: a round's diameter, a square's side, a plank's thickness (a plank
#                                        AGES by its width: its checks, erosion and rot scale with `width`, its checks at most
#                                        0.35 of the thickness deep)
#   width          -1 cm    [-1..600]    the other side: -1 = size (round, square) or 5 x size (plank)
#   length        200 cm    [1..2000]    along the grain (+Z)
#   top             1 x     [0.3..1.5]   the top's width over the foot's (a taper; a pillar's top 0.86-0.9, photo 02)
#   bulge           0 x     [0..0.3]     an entasis: the shaft swells this share of its width at 0.33 of its length
#   arris           0 cm    [0..5]       a square's or plank's long arrises chamfered (0: sawn crisp, worn by OldWood's `wear`;
#                                        a chamfer must cut deeper than about 2.5 x the calling file's `smooth:` or round() refuses it)
#   section    (none) plane()            profile 3's outline, centred on its own origin
#   bow            -1 cm    [0..0.2 L]   the middle off line along X, its sign drawn [L/400 aged, L/150 at age 2, x 0.4-1 a seed]
#   crook          -1 cm    [0..0.2 L]   the middle off line along Y [0.6 x bow's]
#   twist          -1 deg   [0..90]      one end turned against the other about the axis [2 at age 1, 6 at age 2, x 0.4-1]
#   cup            -1 cm    [0..0.2 w]   a plank's face cupped across (sign drawn) [0.3 x age, x 0.3-1; 0 on a round or square]
#   waney          -1 cm    [0..0.2 w]   a plank's edge not straight [0.4 x age]
#   bow, crook, twist, cup, waney are the kit's `Age` (the boards' bends), run in the board frame: bow across the thickness
#   (Y), crook across the width (X)
#   sag             0 cm    [0..0.2 L]   a parabola toward +X (laid with rotate=(0, -90, 0), +X points DOWN): a beam between supports
#   pole            0 0/1                1: an UNSAWN pole (a fence rail, a ladder pole): its axis wanders and knots stand out
#   wobble         -1 x size [0..2]      pole 1: the axis wanders this much, in waves ~7 size long [0.35]
#   knots          -1 cm    [0..0.5 size] pole 1: the knots stand this far (r9: the wood round them sunk 0.8 x this, inward only) [0.04 x size]
#   turned          0 0/1                1: a turned member (a temple pillar): straight, no bow, crook or twist from age; entasis only
#   slabs, holes   -1 count            OldWood's slab loss and rot holes (from age 1.3 / 1.6); a plank draws none unless asked
#   ease           -1 cm                OldWood's worn soft rim at the cut ends
#   seam          180 deg   [-360..360]  a round's one UV seam, about the axis from +X: 180 the back (away from the front view);
#                                        0 the underside of a rail laid with rotate=(0, -90, 0)
#   age, noise, budget and every advanced OldWood knob (checks .. fh, relief) pass to `OldWood` unchanged; `age` 0 is the new
#   member; `budget` 0 Game (the silhouette and the few long checks; write `[triangles=]` on its build line), 1 High
#   Slots: `Face` the long faces, `Broken` the cut ends (end grain).
OwNoSec = plane() { circle(radius=10) }
Member = mesh(profile=0, size=20.0, width=-1.0, length=200.0, top=1.0, bulge=0.0, arris=0.0, section=$OwNoSec, age=1.0, noise=1, budget=1, checks=-1.0, erosion=-1.0, wear=-1.0, foot=-1.0, weather_side=-1.0, spiral=-1.0, clen=-1.0, mouth=-1.0, cdepth=-1.0, share=-1.0, endc=-1.0, rot=-1.0, fh=-1.0, relief=-1.0, bow=-1.0, crook=-1.0, twist=-1.0, cup=-1.0, waney=-1.0, sag=0.0, pole=0, wobble=-1.0, knots=-1.0, seam=180.0, turned=0, slabs=-1.0, holes=-1.0, ease=-1.0) {
  $pq = clamp(floor($profile + 0.5), 0, 3)
  $sz = clamp($size, 1, 300)
  $wd = clamp($OwPick($width, $sz * (1 + 4 * clamp(1 - abs($pq - 2), 0, 1))), 1, 600)
  $ln = clamp($length, 1, 2000)
  $ar = clamp($arris, 0, 0.3 * $sz)
  if ($pq < 0.5) {
    # at least 48 sides (the UV wrap's sixteen strips each need faces), about 2 cm apart on a big round
    circle(radius=0.5 * $sz, segments=clamp(ceil(1.5708 * $sz), 48, 256))
  } else {
    if ($pq < 2.5) {
      rect(w=$wd, h=$sz)
      if ($ar > 0.01) {
        round($ar, segments=1)
      }
    } else {
      add($section, join=none)
    }
  }
  extrude(height=$ln)
  $tp = clamp($top, 0.3, 1.5)
  $bg2 = clamp($bulge, 0, 0.3)
  if (abs($tp - 1) + $bg2 > 0.001) {
    warp(to=(point.x * (1 + ($tp - 1) * point.t.z + $bg2 * sin(180 * min(1, point.t.z / 0.66))), point.y * (1 + ($tp - 1) * point.t.z + $bg2 * sin(180 * min(1, point.t.z / 0.66))), point.z)) [smooth=0.25 * $sz]
  }
  # the pith: on the axis of a round or square; far below the face of a flat-sawn plank, so its checks run along the face
  $Kit_py = 0 - 1.5 * $wd * clamp(1 - abs($pq - 2), 0, 1)
  # a plank ages by its WIDTH (by its thickness a 3 cm plank drew no checks), its checks never deeper than 0.35 of the thickness
  $pk = clamp(1 - abs($pq - 2), 0, 1)
  $Dm = min($sz, $wd) * (1 - $pk) + $wd * $pk
  $cdm = $OwPick($cdepth, $pk * (0.35 * $sz * clamp($age, 0, 1) + 1) - 1)
  # end cracks run in `endc` of the radius from the rim; on a taper the top is narrower, so they are measured from the top's
  # own rim (else the top's band was a sliver and its cracks did not read)
  $ecm = 1 - min(1, $tp) * (1 - clamp($OwPick($endc, 0.35 * clamp($age, 0, 1) + 0.15 * clamp($age - 1, 0, 1)), 0, 1))
  $OldWood(along=[(0, 0, 1)], size=$Dm, age=$age, noise=$noise, budget=$budget, py=$Kit_py, checks=$checks, erosion=$erosion, wear=$wear, foot=$foot, weather_side=$weather_side, spiral=$spiral, clen=$clen, mouth=$mouth, cdepth=$cdm, share=$share, endc=$ecm, rot=$rot, fh=$fh, relief=$relief, length=$ln, slabs=$OwPick($slabs, 0 - 1 + $pk), holes=$OwPick($holes, 0 - 1 + $pk), ease=$ease, top=$tp, bulge=$bg2, cut=clamp(ceil(2.5 - $pq), 0, 1), hw=0.5 * $wd - (0.5 * $wd + 1) * clamp(ceil(0.5 - $pq), 0, 1), hh=0.5 * $sz - (0.5 * $sz + 1) * clamp(ceil(0.5 - $pq), 0, 1))
  # one member is one piece: a sliver a shelf and a check left between them is dropped (r8, the probe's 20-triangle fleck)
  if ($age > 1.3) {
    keep(largest)
  }
  # UV BEFORE THE BENDS (the bends carry it). UV15: every member its own place on the tiling texture ($Uo, $Vo); the grain runs
  # along U, 100 cm a tile, as on the boards. A square or plank: one box, its grain's start flipped end to end ($Uf). A round:
  # ONE CONTINUOUS WRAP with one seam, at `seam` degrees about the axis from +X (180: the back, away from the front view; 0:
  # the underside of a rail laid with rotate=(0, -90, 0)): sixteen planar strips round the axis (each within 11.25 degrees
  # of its own, stretch under 1.02), each shifted on V by the strips before it so they join edge to edge (V runs against the angle, measured on a probe; a strip spans size x sin 11.25 deg); the taper is
  # undone for the projection and put back (a turn of the whole member would refold its triangles), so strips meet on a taper too;
  # a check's walls take their strip too: seen edge-on their V runs out, but U (the grain) runs on down the wall, which is what
  # the eye reads in a check (a face-normal test to give walls their own projection broke the strips into patches); every
  # projection is framed on the member's own axis (`at=(0, 0, 0)`; unstated, each strip took its own bounds centre and stepped)
  $Km = floor($noise) * 1009 + 23
  $Uo = $Hash($Km, 7311.3)
  $Vo = $Hash($Km, 7337.9)
  $Uf = 2 * floor(2 * $Hash($Km, 7363.1)) - 1
  if ($pq < 0.5) {
    $sa = clamp($seam, -360, 360)
    # a strip takes a face only when all its corners lie in its window, so the windows overlap by more than a face is wide
    # (about 1.2 cm High, 3 cm Game, measured round the axis); narrower windows left faces on the box: thin rails banded
    $mg = cos(11.25 + max(3, 43 * (1.2 + 1.8 * clamp(ceil(0.5 - $budget), 0, 1)) / (0.5 * $sz)))
    # a strip takes a face only when all its corners lie in its window, so the windows overlap by more than a face is wide
    # (about 1.2 cm High, 3 cm Game, measured round the axis); narrower windows left faces on the box: thin rails banded
    $mg = cos(11.25 + max(3, 43 * (1.2 + 1.8 * clamp(ceil(0.5 - $budget), 0, 1)) / (0.5 * $sz)))
    $tf = $tp - 1
    warp(to=(point.x / (1 + $tf * clamp(point.z / $ln, 0, 1) + $bg2 * sin(180 * clamp(point.z / (0.66 * $ln), 0, 1))), point.y / (1 + $tf * clamp(point.z / $ln, 0, 1) + $bg2 * sin(180 * clamp(point.z / (0.66 * $ln), 0, 1))), point.z))
    uv(box, at=(0, 0, 0), facing=(1, 0, 0), up=(0, 0, 1), scale=(100, 100, 100), offset=($Uo, $Vo))
    $c0 = cos($sa + 11.25)
    $s0 = sin($sa + 11.25)
    $c1 = cos($sa + 33.75)
    $s1 = sin($sa + 33.75)
    $c2 = cos($sa + 56.25)
    $s2 = sin($sa + 56.25)
    $c3 = cos($sa + 78.75)
    $s3 = sin($sa + 78.75)
    $c4 = cos($sa + 101.25)
    $s4 = sin($sa + 101.25)
    $c5 = cos($sa + 123.75)
    $s5 = sin($sa + 123.75)
    $c6 = cos($sa + 146.25)
    $s6 = sin($sa + 146.25)
    $c7 = cos($sa + 168.75)
    $s7 = sin($sa + 168.75)
    $c8 = cos($sa + 191.25)
    $s8 = sin($sa + 191.25)
    $c9 = cos($sa + 213.75)
    $s9 = sin($sa + 213.75)
    $c10 = cos($sa + 236.25)
    $s10 = sin($sa + 236.25)
    $c11 = cos($sa + 258.75)
    $s11 = sin($sa + 258.75)
    $c12 = cos($sa + 281.25)
    $s12 = sin($sa + 281.25)
    $c13 = cos($sa + 303.75)
    $s13 = sin($sa + 303.75)
    $c14 = cos($sa + 326.25)
    $s14 = sin($sa + 326.25)
    $c15 = cos($sa + 348.75)
    $s15 = sin($sa + 348.75)
    # first eight wide windows (50 degrees either side; same centres and shifts as every other strip, so they agree with the
    # strips to the third order): a long sliver a check's creases cut, too wide for any strip's window, takes one of these, not the box
    uv(plane, at=(0, 0, 0), facing=($c0, $s0, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.000000 * $sz)) [side, value=(point.x * $c0 + point.y * $s0) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=0.64279]
    uv(plane, at=(0, 0, 0), facing=($c2, $s2, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.003902 * $sz)) [side, value=(point.x * $c2 + point.y * $s2) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=0.64279]
    uv(plane, at=(0, 0, 0), facing=($c4, $s4, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.007804 * $sz)) [side, value=(point.x * $c4 + point.y * $s4) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=0.64279]
    uv(plane, at=(0, 0, 0), facing=($c6, $s6, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.011705 * $sz)) [side, value=(point.x * $c6 + point.y * $s6) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=0.64279]
    uv(plane, at=(0, 0, 0), facing=($c8, $s8, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.015607 * $sz)) [side, value=(point.x * $c8 + point.y * $s8) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=0.64279]
    uv(plane, at=(0, 0, 0), facing=($c10, $s10, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.019509 * $sz)) [side, value=(point.x * $c10 + point.y * $s10) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=0.64279]
    uv(plane, at=(0, 0, 0), facing=($c12, $s12, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.023411 * $sz)) [side, value=(point.x * $c12 + point.y * $s12) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=0.64279]
    uv(plane, at=(0, 0, 0), facing=($c14, $s14, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.027313 * $sz)) [side, value=(point.x * $c14 + point.y * $s14) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=0.64279]
    uv(plane, at=(0, 0, 0), facing=($c0, $s0, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.000000 * $sz)) [side, value=(point.x * $c0 + point.y * $s0) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c1, $s1, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.001951 * $sz)) [side, value=(point.x * $c1 + point.y * $s1) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c2, $s2, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.003902 * $sz)) [side, value=(point.x * $c2 + point.y * $s2) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c3, $s3, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.005853 * $sz)) [side, value=(point.x * $c3 + point.y * $s3) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c4, $s4, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.007804 * $sz)) [side, value=(point.x * $c4 + point.y * $s4) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c5, $s5, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.009755 * $sz)) [side, value=(point.x * $c5 + point.y * $s5) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c6, $s6, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.011705 * $sz)) [side, value=(point.x * $c6 + point.y * $s6) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c7, $s7, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.013656 * $sz)) [side, value=(point.x * $c7 + point.y * $s7) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c8, $s8, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.015607 * $sz)) [side, value=(point.x * $c8 + point.y * $s8) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c9, $s9, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.017558 * $sz)) [side, value=(point.x * $c9 + point.y * $s9) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c10, $s10, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.019509 * $sz)) [side, value=(point.x * $c10 + point.y * $s10) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c11, $s11, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.021460 * $sz)) [side, value=(point.x * $c11 + point.y * $s11) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c12, $s12, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.023411 * $sz)) [side, value=(point.x * $c12 + point.y * $s12) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c13, $s13, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.025362 * $sz)) [side, value=(point.x * $c13 + point.y * $s13) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c14, $s14, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.027313 * $sz)) [side, value=(point.x * $c14 + point.y * $s14) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    uv(plane, at=(0, 0, 0), facing=($c15, $s15, 0), up=(0, 0, 1), scale=(100, 100), offset=($Uo, $Vo - 0.029264 * $sz)) [side, value=(point.x * $c15 + point.y * $s15) / sqrt(point.x * point.x + point.y * point.y + 0.0001), above=$mg]
    warp(to=(point.x * (1 + $tf * clamp(point.z / $ln, 0, 1) + $bg2 * sin(180 * clamp(point.z / (0.66 * $ln), 0, 1))), point.y * (1 + $tf * clamp(point.z / $ln, 0, 1) + $bg2 * sin(180 * clamp(point.z / (0.66 * $ln), 0, 1))), point.z))
  } else {
    uv(box, at=(0, 0, 0), facing=(1, 0, 0), up=(0, 0, $Uf), scale=(100, 100, 100), offset=($Uo, $Vo))
  }
  # THE BENDS (after the age and the UV, so the checks and the texture bend with the wood), each its own seeded sign; `age` drives bow, crook and twist
  # (aged L/400, weathered L/150: Docs/Research/wooden-house-walls.md), `sag` is the author's (a beam between supports);
  # `pole` 1: an unsawn pole's axis wanders (`wobble`) and its knots stand out (`knots`)
  $Am = clamp($age, 0, 2)
  $am1 = min($Am, 1)
  $am2 = max($Am - 1, 0)
  $bl = $ln * ($am1 / 400 + $am2 * (1 / 150 - 1 / 400))
  # a TURNED member (a temple pillar) is straight: no bow, crook or twist
  $tn = 1 - clamp(floor($turned + 0.5), 0, 1)
  $bw = $tn * clamp($OwPick($bow, $bl * (0.4 + 0.6 * $Hash($Km, 4111.3))), 0, 0.2 * $ln) * (2 * floor(2 * $Hash($Km, 4127.9)) - 1)
  $ck = $tn * clamp($OwPick($crook, 0.6 * $bl * (0.4 + 0.6 * $Hash($Km, 4133.1))), 0, 0.2 * $ln) * (2 * floor(2 * $Hash($Km, 4139.7)) - 1)
  $tw = $tn * clamp($OwPick($twist, (2 * $am1 + 4 * $am2) * (0.4 + 0.6 * $Hash($Km, 4143.3))), 0, 90) * (2 * floor(2 * $Hash($Km, 4149.1)) - 1)
  $sg = clamp($sag, 0, 0.2 * $ln)
  $pl = clamp(floor($pole + 0.5), 0, 1)
  $wo = clamp($OwPick($wobble, 0.35 * $sz), 0, 2 * $sz) * $pl
  $kn = clamp($OwPick($knots, 0.04 * $sz), 0, 0.5 * $sz) * $pl
  $sawn = clamp(ceil($pq - 0.5), 0, 1) * clamp(ceil(2.5 - $pq), 0, 1)
  $cu = clamp($OwPick($cup, 0.3 * ($am1 + 2 * $am2) * clamp(1 - abs($pq - 2), 0, 1) * (0.3 + 0.7 * $Hash($Km, 4151.7))), 0, 0.2 * $wd) * (1 - 2 * clamp(ceil($Hash($Km, 4157.3) - 0.75), 0, 1)) * $sawn
  $wv = clamp($OwPick($waney, 0.4 * ($am1 + 2 * $am2) * clamp(1 - abs($pq - 2), 0, 1)), 0, 0.2 * $wd) * $sawn
  $Bend(profile=$pq, size=$sz, width=$wd, length=$ln, bow=$bw, crook=$ck, twist=$tw, cup=$cu, waney=$wv, sag=$sg, wobble=$wo, knots=$kn, noise=$noise)
  # an aged cut end has weathered grey like the faces (lead r5: "Broken is only for fresh breaks"); a new member keeps fresh end grain
  material($Face)
  if ($age < 0.3) {
    material($Broken) [top]
    material($Broken) [bottom]
  }
}

# ---- the aged floor's pieces (round 6; round 7 decayed) -----------------------------------------------

# ONE BOARD OF THE FLOOR, or the piece of it a break leaves: TimberKit's `AgedBoard` recipe (its draws, its worn
# section, its `Decay` and `Age`), keyed `noise * 1009 + index` as AgedBoard is, with the floor's rules over the drawn
# numbers (the floor's rules, written out below). In the board's own frame (centred on x, bottom on z = 0, y from 0 to
# `length`). Round 7: every sense of unevenness (twist, taper and a waney edge held inside its lane, thickness along,
# pitch and roll with the board lifted so no corner sinks), and above `decay` 0 the board decayed BEFORE it breaks
# (ridges, open checks, crumbled ends, a sliver, a missing corner; shrunk by `shrink`, thinned by `thin`), each bay
# between joists sagging `bsag` (ys: where the board starts in the module, js the joist spacing, sy the module's
# length), and `plift` (a share, drawn per board) of the uncut boards springing an end `liftc` cm.
# Each end may be cut at `c0` / `c1` (k = 1 a deck break, keeping the side toward the board's middle; 2 the hinge's
# torn line, its level side; 3 its complement, the turned side); the piece is then moved so `pivot` is its origin
# (a turned piece turns about its hinge) and, on the stub, a nail goes in 1.2 cm past it.
DeckBoard = mesh(width=14.0, thick=1.9, length=200.0, wvar=0.015, tvar=0.05, lvar=0.0, yaw=0.5, lift=0.15, cup=0.3, bow=0.25, crook=0.25, endsq=1.5, wear=0.5, wearvar=0.6, arris=3, seg=4, room=0.2, g0=0.1, ea0=0.0, g1=0.1, ea1=0.0, k0=0, c0=0.0, k1=0, c1=200.0, pivot=0.0, deep=0.75, grain=0.24, lean=1.6, ang=0.0, splint=0.8, vdep=0.7, horn=0.0, rings=0, torn=0.0, torntilt=0.0, tornrib=0, tornsep=0.15, uvbox=1, detail=0.12, nb=1, hinge=0.0, hdetail=0.12, nh=1, nail=0, shade=0.0, tile=100.0, aspect=1.0, softness=0.0, twist=0.0, taper=0.0, waney=0.0, ttaper=0.0, pitch=0.0, roll=0.0, decay=0.0, state=0.35, ridge=0.45, checks=3, checkd=0.45, crumb=4.0, sliver=0.6, corner=0.45, thin=0.15, shrink=0.06, bsag=0.0, js=40.0, sy=200.0, ys=0.0, plift=0.0, liftc=0.0, noise=1, index=0, groove=0.0, gshare=0.35, gouge=0.0, lips=0.0, hollow=0.0, edgew=0.0, nl=0) {
  $K = $noise * 1009 + $index
  $Uo = $Hash($K, 7311.3)
  $Vo = $Hash($K, 7337.9)
  $Uf = 2 * floor(2 * $Hash($K, 7363.1)) - 1
  loop (20) {
    $ix = output.index
    $ad[$ix] = $Hash($K, floor(10 * (3.1 + 17.3 * $ix) + 0.5) / 10)
  }
  $Wd = $width * (1 + $wvar * (2 * $ad[1] - 1))
  $Td = $thick * (1 + $tvar * (2 * $ad[2] - 1))
  $Ld = $length * (1 + $lvar * (2 * $ad[3] - 1))
  $yw = $yaw * (0.4 + 0.6 * $ad[4]) * (2 * floor(2 * $ad[5]) - 1)
  $lf = $lift * (2 * $ad[6] - 1)
  $cp = $cup * (0.3 + 0.7 * $ad[7]) * (1 - 2 * clamp(ceil($ad[8] - 0.75), 0, 1))
  $bw = $bow * (2 * $ad[9] - 1)
  $ck = $crook * (2 * $ad[10] - 1)
  $e0 = $endsq * (2 * $ad[11] - 1)
  $e1 = $endsq * (2 * $ad[12] - 1)
  $rcap = min(0.3 * $Wd, 0.4 * $Td)
  $ra = min(max($wear * (1 + $wearvar * (2 * $ad[13] - 1)), 0.1 * $wear), $rcap)
  $rb = min(max($wear * (1 + $wearvar * (2 * $ad[14] - 1)), 0.1 * $wear), $rcap)
  $rc = min(0.35 * $wear * (0.6 + 0.8 * $ad[15]), $rcap)
  $rd = min(0.35 * $wear * (0.6 + 0.8 * $ad[16]), $rcap)
  $rm = max($ra, $rb)
  $wa = min($wearvar, 0.8) * (0.3 + 0.7 * $ad[17])
  $wb = min($wearvar, 0.8) * (0.3 + 0.7 * $ad[18])
  $ph = 360 * $ad[19]
  $fr = 0.6 + 1.2 * $ad[20]
  loop (24) {
    $ix = output.index + 20
    $ad[$ix] = $Hash($K, floor(10 * (3.1 + 17.3 * $ix) + 0.5) / 10)
  }
  $tw = $twist * (0.3 + 0.7 * $ad[21]) * (2 * floor(2 * $ad[22]) - 1)
  $tp = $taper * (2 * $ad[23] - 1)
  $wv = $waney * (0.3 + 0.7 * $ad[24])
  $wk = 0.5 + 1.5 * $ad[25]
  $ws = 2 * floor(2 * $ad[26]) - 1
  $tt = $ttaper * (2 * $ad[27] - 1)
  $pt = $pitch * (2 * $ad[28] - 1)
  $rl = $roll * (2 * $ad[29] - 1)
  $dv = clamp($decay * (1 + $state * (2 * $ad[30] - 1)), 0, 1)
  $nck = min(floor($checks * (0.4 + 0.6 * $ad[31]) + 0.5), 3) * clamp(ceil($dv - 0.05), 0, 1)
  $cx1 = 3 + floor(13 * $ad[32])
  $cx2 = 3 + floor(13 * $ad[33])
  $cx3 = 3 + floor(13 * $ad[34])
  $cy1 = 0.05 + 0.3 * $ad[35]
  $cl1 = 0.3 + 0.6 * $ad[36]
  $cy2 = 0.35 + 0.4 * $ad[37]
  $cl2 = 1.0
  $cy3 = 0.0
  $cl3 = 0.15 + 0.4 * $ad[38]
  $sl = clamp(ceil($sliver * $dv - $ad[39]), 0, 1)
  $sly = 0.1 + 0.5 * $ad[40]
  $co = clamp(ceil($corner * $dv - $ad[41]), 0, 1)
  $coe = floor(2 * $ad[42])
  $cos = 2 * floor(2 * $ad[43]) - 1
  $crf = 0.5 + 0.5 * $ad[44]
  $Wd0 = max($Wd, 11.0)
  $Td0 = $Td
  $Wd = ($Wd - 2 * $wv) * (1 - 0.5 * abs($tp)) * (1 - $shrink * $dv)
  $Td = $Td * (1 - $thin * $dv)
  $lf = abs($lf) + max(-$cp, 0) + 0.5 * $Ld * abs(tan($pt)) + 0.5 * $Wd * abs(sin($rl)) + 0.5 * $Wd * abs(sin(0.5 * $tw))
  $bw = abs($bw)
  $e0 = $ea0
  $e1 = $ea1
  $kq = min(1, $room / max(0.5 * $Ld * abs(sin($yw)) + abs($ck), 0.001), max(min($g0, $g1) - 0.01, 0) / max(0.5 * $Wd * abs(sin($yw)), 0.0001))
  $yw = $yw * $kq
  $ck = $ck * $kq
  $ad45 = $Hash($K, 4219.3)
  $ad46 = $Hash($K, 4283.9)
  $ad47 = $Hash($K, 4351.1)
  $cu = $liftc * clamp(ceil($plift - $ad45), 0, 1) * (1 - clamp($k0 + $k1, 0, 1))
  $cf = 0.55 + 0.3 * $ad46
  $cs = floor(2 * $ad47)
  if ($dv > 0.001) {
    $NC = 18 + 18 * clamp(ceil($seg - 5), 0, 1)
    if ($seg > 5) {
      add($DecaySecU, w=$Wd, t=$Td, a=max($ra, 0.25), b=max($rb, 0.25), c=$rc, d=$rd, scale=(1.0, $Ld / 100.0, 1.0))
    } else {
      if ($arris > 1.5) {
        add($DecaySec, w=$Wd, t=$Td, a=max($ra, 0.25), b=max($rb, 0.25), c=$rc, d=$rd, scale=(1.0, $Ld / 100.0, 1.0))
      } else {
        add($DecaySecG, w=$Wd, t=$Td, a=max($ra, 0.25), b=max($rb, 0.25), c=$rc, d=$rd, scale=(1.0, $Ld / 100.0, 1.0))
      }
    }
  } else {
    if ($arris > 1.5) {
      add($AgedSec3, w=$Wd, t=$Td, a=$ra, b=$rb, c=$rc, d=$rd, seg=$seg, scale=(1.0, $Ld / 100.0, 1.0))
    } else {
      add($AgedSec1, w=$Wd, t=$Td, a=$ra, b=$rb, c=$rc, d=$rd, seg=$seg, scale=(1.0, $Ld / 100.0, 1.0))
    }
  }
  if ($k0 * clamp(ceil(($c0) - (0.5)), 0, 1) * clamp(ceil(($Ld - 0.5) - ($c0)), 0, 1) > 0.5) {
    if ($k0 > 2.5) {
      $Dmg.SnapOff(width=$Wd0, thick=$Td0, deep=$hinge, lean=0.6, wander=0.05, layers=2, fray=0.0, loss=0.0, chew=0.0, thin=0.0, detail=$hdetail, noise=$nh, origin=(0.0, $c0, 0.0), rotation=(0.0, 0.0, 0.0), uvfit=2 * $uvbox, tile=$tile, aspect=$aspect)
    } else {
      if ($k0 > 1.5) {
        $Dmg.Snap(width=$Wd0, thick=$Td0, deep=$hinge, lean=0.6, wander=0.05, layers=2, fray=0.0, loss=0.0, chew=0.0, thin=0.0, detail=$hdetail, noise=$nh, origin=(0.0, $c0, 0.0), rotation=(0.0, 0.0, 180.0), uvfit=2 * $uvbox, tile=$tile, aspect=$aspect)
      } else {
        $Dmg.Snap(width=$Wd0, thick=$Td0, deep=$deep, grain=$grain, lean=$lean, layers=2, rings=$rings, uneven=0.4, rough=1.0, long=$splint, vdep=$vdep, horn=$horn, torn=$torn, torntilt=$torntilt, tornrib=$tornrib, tornsep=$tornsep, loss=0.0, chew=0.05, detail=$detail, noise=$nb, origin=(0.0, $c0, 0.0), rotation=(0.0, 0.0, 180.0 + $ang), uvfit=2 * $uvbox, tile=$tile, aspect=$aspect)
      }
    }
  }
  if ($k1 * clamp(ceil(($c1) - (0.5)), 0, 1) * clamp(ceil(($Ld - 0.5) - ($c1)), 0, 1) > 0.5) {
    if ($k1 > 2.5) {
      $Dmg.SnapOff(width=$Wd0, thick=$Td0, deep=$hinge, lean=0.6, wander=0.05, layers=2, fray=0.0, loss=0.0, chew=0.0, thin=0.0, detail=$hdetail, noise=$nh, origin=(0.0, $c1, 0.0), rotation=(0.0, 0.0, 180.0), uvfit=2 * $uvbox, tile=$tile, aspect=$aspect)
    } else {
      if ($k1 > 1.5) {
        $Dmg.Snap(width=$Wd0, thick=$Td0, deep=$hinge, lean=0.6, wander=0.05, layers=2, fray=0.0, loss=0.0, chew=0.0, thin=0.0, detail=$hdetail, noise=$nh, origin=(0.0, $c1, 0.0), rotation=(0.0, 0.0, 0.0), uvfit=2 * $uvbox, tile=$tile, aspect=$aspect)
      } else {
        $Dmg.Snap(width=$Wd0, thick=$Td0, deep=$deep, grain=$grain, lean=$lean, layers=2, rings=$rings, uneven=0.4, rough=1.0, long=$splint, vdep=$vdep, horn=$horn, torn=$torn, torntilt=$torntilt, tornrib=$tornrib, tornsep=$tornsep, loss=0.0, chew=0.05, detail=$detail, noise=$nb, origin=(0.0, $c1, 0.0), rotation=(0.0, 0.0, $ang), uvfit=2 * $uvbox, tile=$tile, aspect=$aspect)
      }
    }
  }
  $cut = clamp($k0 + $k1, 0, 1)
  if ($cut > 0.5) {
    keep(largest)
  }
  if ($dv > 0.001) {
    $Decay(w=$Wd, t=$Td, len=$Ld, a=max($ra, 0.25), b=max($rb, 0.25), dv=$dv, ridge=$ridge, ph=$ph, cd1=clamp(ceil($nck - 0.5), 0, 1) * $checkd * $Td * $dv, cd2=clamp(ceil($nck - 1.5), 0, 1) * $checkd * $Td * $dv, cd3=clamp(ceil($nck - 2.5), 0, 1) * min(1.6 * $checkd, 0.85) * $Td * $dv, cx1=$cx1, cx2=$cx2, cx3=$cx3, cy1=$cy1, cl1=$cl1, cy2=$cy2, cl2=$cl2, cy3=$cy3, cl3=$cl3, crumb=$crumb * $dv * $softness, crf=$crf, sl=$sl, sly=$sly, co=$co, coe=$coe, cos=$cos, nc=$NC, softv=$softness)
    if ($groove * $dv > 0.001) {
      $Grooves(w=$Wd, t=$Td, a=max($ra, 0.25), b=max($rb, 0.25), nc=$NC, dv=$dv, gd=$groove, gs=$gshare, ph=$ph)
    }
    if (($gouge + $lips + $hollow + $edgew) * $dv > 0.001) {
      $Gouges(w=$Wd, t=$Td, len=$Ld, a=max($ra, 0.25), b=max($rb, 0.25), nc=$NC, dv=$dv, gd=$gouge, lp=$lips, hd=$hollow, ew=$edgew, k=$K + 17, ys=$ys, gl=floor($index / 4) - 1, gr=floor($index / 4), sd=$noise, nl=$nl)
    }
    $er1 = $Hash($K, 6101.3)
    $er2 = $Hash($K, 6133.1)
    $er3 = $Hash($K, 6167.9)
    $er4 = $Hash($K, 6199.7)
    $er5 = $Hash($K, 6231.3)
    $er6 = $Hash($K, 6263.9)
    $er7 = $Hash($K, 6295.1)
    $er8 = $Hash($K, 6329.7)
    $EndRot(w=$Wd, t=$Td, len=$Ld, r0=$crumb * $dv * $crf * (1 - $softness), r1=$crumb * $dv * (1 - $softness), b1=$Wd * (0.12 + 0.2 * $er1 - 0.5), b2=$Wd * (0.55 + 0.25 * $er2 - 0.5), h1=0.1 + 0.9 * $er3, h2=0.1 + 0.9 * $er4, h3=0.1 + 0.9 * $er5, h4=0.1 + 0.9 * $er6, h5=0.1 + 0.9 * $er7, h6=0.1 + 0.9 * $er8, lg=0.15 + 0.15 * $er1, ph=$ph)
  }
  if ($bsag * $dv > 0.001) {
    warp(by=(0.0, 0.0, -$bsag * $dv * (1 - 2 * abs((point.y + $ys) / $js - floor((point.y + $ys) / $js + 0.5))) * clamp((point.y + $ys - 0.5 * $js) / 2.0, 0, 1) * clamp(($sy - 0.5 * $js - point.y - $ys) / 2.0, 0, 1)))
  }
  $Age(w=$Wd, t=$Td, len=$Ld, cupv=$cp, bowv=$bw, crookv=$ck, e0=$e0, e1=$e1, yawv=$yw, liftv=$lf, rm=$rm * (1 - clamp(ceil($dv - 0.001), 0, 1)), wa=$wa, wb=$wb, ph=$ph, fr=$fr, twistv=$tw, taperv=$tp, wanev=$wv, wanek=$wk, wanes=$ws, ttapv=$tt, pitchv=$pt, rollv=$rl, curlv=$cu, curlf=$cf, curls=$cs, softv=$softness)
  if ($cut > 0.5) {
    uv(box, facing=(0, 0, 1), up=(0, $Uf, 0), scale=($aspect * $tile, $tile, $tile), offset=($Uo, $Vo)) [!cut]
    if (1 > 0.5) {
      uv(box, facing=(0, 0, 1), up=(0, $Uf, 0), scale=($aspect * $tile, $tile, $tile), offset=($Uo + 0.37, $Vo + 0.61)) [cut]
    }
    material($Face)
    material($Broken) [cut]
  } else {
    uv(box, facing=(0, 0, 1), up=(0, $Uf, 0), scale=($aspect * $tile, $tile, $tile), offset=($Uo, $Vo))
    material($Face)
  }
  # this board's state (fresher or darker): vertex colour R, one value a board, keyed as its draws are
  $sh = $Hash($K, 4127.3)
  colour(1 - $shade * $sh, channel=r)
  if ($nail > 0.5) {
    add($NailRod, len=4.5, at=(0.0, $pivot + 1.2, 0.0), join=none)
  }
  place(by=(0.0, -$pivot, 0.0))
}

JRun = plane() { points((0.0, 0, 0.0), (0.0, 1.25, 0.0), (0.0, 3, 0.0), (0.0, 6, 0.0), (0.0, 10, 0.0), (0.0, 15, 0.0), (0.0, 21, 0.0), (0.0, 28, 0.0), (0.0, 35, 0.0), (0.0, 42.5, 0.0), (0.0, 50, 0.0), (0.0, 57.5, 0.0), (0.0, 65, 0.0), (0.0, 72, 0.0), (0.0, 79, 0.0), (0.0, 85, 0.0), (0.0, 90, 0.0), (0.0, 94, 0.0), (0.0, 97, 0.0), (0.0, 98.75, 0.0), (0.0, 100, 0.0)) }

# an old joist's section (round 8): arrises chamfered 20 degrees off the faces (box UV stretch stays low) and 13 rows down each side, so the sides can take checks
JoistSec = mesh(w=3.8, t=18.4, a=0.3, c=0.3) {
  points((-0.5 * $w + $c, 0.0), (0.0, 0.0), (0.5 * $w - $c, 0.0), (0.5 * $w, 0.364 * $c), (0.5 * $w, 1 * $t / 14), (0.5 * $w, 2 * $t / 14), (0.5 * $w, 3 * $t / 14), (0.5 * $w, 4 * $t / 14), (0.5 * $w, 5 * $t / 14), (0.5 * $w, 6 * $t / 14), (0.5 * $w, 7 * $t / 14), (0.5 * $w, 8 * $t / 14), (0.5 * $w, 9 * $t / 14), (0.5 * $w, 10 * $t / 14), (0.5 * $w, 11 * $t / 14), (0.5 * $w, 12 * $t / 14), (0.5 * $w, 13 * $t / 14), (0.5 * $w, $t - 0.364 * $a), (0.5 * $w - $a, $t), (0.0, $t), (-0.5 * $w + $a, $t), (-0.5 * $w, $t - 0.364 * $a), (-0.5 * $w, 13 * $t / 14), (-0.5 * $w, 12 * $t / 14), (-0.5 * $w, 11 * $t / 14), (-0.5 * $w, 10 * $t / 14), (-0.5 * $w, 9 * $t / 14), (-0.5 * $w, 8 * $t / 14), (-0.5 * $w, 7 * $t / 14), (-0.5 * $w, 6 * $t / 14), (-0.5 * $w, 5 * $t / 14), (-0.5 * $w, 4 * $t / 14), (-0.5 * $w, 3 * $t / 14), (-0.5 * $w, 2 * $t / 14), (-0.5 * $w, 1 * $t / 14), (-0.5 * $w, 0.364 * $c), loop=true)
  sweep(along=$JRun)
}

# AN OLD JOIST'S BLANK (round 8; the lead: "the joists are clean square boxes"): `JoistSec` on `JRun` (21 stations,
# crowded at the ends), aged `dv` 0-1 HARD (owner: decay shows as breaks, never rounding): the grain eroded into ridges
# along each side; two open checks along the sides and one from an end, V-shaped with sharp walls and a narrow mouth,
# deeper than wide (`checkd` x the width at full decay); each end off square by up to `ends` cm through the depth and
# across the width; `chips` breakouts knocked off the bottom arrises near the ends. Frame: centred on x, bottom on
# z = 0, y from 0 to len (the Damage frame: grain +Y, depth up +Z).
JoistBlank = mesh(w=3.8, t=18.4, len=200.0, dv=0.0, checkd=0.35, ends=0.6, chips=2, softness=0.0, tile=100.0, aspect=1.0, noise=1, index=0) {
  $K = $noise * 1019 + $index
  $Uo = $Hash($K, 7311.3)
  $Vo = $Hash($K, 7337.9)
  $Uf = 2 * floor(2 * $Hash($K, 7363.1)) - 1
  loop (24) {
    $ix = output.index - 1
    $jz[$ix] = $Hash($K, floor(10 * (5003.1 + 23.9 * $ix) + 0.5) / 10)
  }
  $ac = min(0.3 + 0.6 * $softness, 0.8 * $t / 14)
  add($JoistSec, w=$w, t=$t, a=$ac, c=$ac, scale=(1.0, $len / 100.0, 1.0))
  if ($dv > 0.001) {
    $sp = $t / 14
    $ph = 360 * $jz[0]
    $s1 = 2 * floor(2 * $jz[1]) - 1
    $r1 = 3 + floor(8 * $jz[2])
    $y1 = 0.08 + 0.35 * $jz[3]
    $l1 = 0.3 + 0.45 * $jz[4]
    $d1 = $checkd * $w * $dv * (0.6 + 0.4 * $jz[5])
    $s2 = -$s1
    $r2 = 3 + floor(8 * $jz[6])
    $y2 = 0.25 + 0.4 * $jz[7]
    $l2 = 0.25 + 0.45 * $jz[8]
    $d2 = $checkd * $w * $dv * (0.5 + 0.4 * $jz[9])
    $s3 = 2 * floor(2 * $jz[11]) - 1
    $r3 = 4 + floor(6 * $jz[12])
    $l3 = 0.08 + 0.14 * $jz[13]
    $y3 = floor(2 * $jz[10]) * (1 - $l3) - (1 - floor(2 * $jz[10])) * 0.05
    $l3 = $l3 + 0.05
    $d3 = min(1.25 * $checkd, 0.45) * $w * $dv
    $e0a = $ends * (0.4 + 0.6 * $dv) * $jz[14]
    $e0b = $ends * (0.4 + 0.6 * $dv) * $jz[15]
    $e1a = $ends * (0.4 + 0.6 * $dv) * $jz[16]
    $e1b = $ends * (0.4 + 0.6 * $dv) * $jz[17]
    $nch = min($chips, 2) * $dv
    $ks1 = 2 * floor(2 * $jz[18]) - 1
    $ka1 = $len * (0.01 + 0.06 * $jz[19])
    $kb1 = $ka1 + 4.0 + 7.0 * $jz[20]
    $kd1 = clamp(ceil($nch - 0.3), 0, 1) * (0.6 + 0.8 * $jz[21]) * $dv
    $ks2 = -$ks1
    $kb2 = $len * (0.99 - 0.06 * $jz[22])
    $ka2 = $kb2 - 4.0 - 7.0 * $jz[23]
    $kd2 = clamp(ceil($nch - 1.3), 0, 1) * (0.5 + 0.7 * $jz[20]) * $dv
    warp(by=(-$s1 * $d1 * clamp(1 - abs(point.z / $sp - $r1), 0, 1) * clamp((point.y / $len - $y1) / 0.02 + 1, 0, 1) * clamp(($y1 + $l1 - point.y / $len) / 0.02 + 1, 0, 1) * clamp(ceil($s1 * point.x - (0.5 * $w - 0.02)), 0, 1) + -$s2 * $d2 * clamp(1 - abs(point.z / $sp - $r2), 0, 1) * clamp((point.y / $len - $y2) / 0.02 + 1, 0, 1) * clamp(($y2 + $l2 - point.y / $len) / 0.02 + 1, 0, 1) * clamp(ceil($s2 * point.x - (0.5 * $w - 0.02)), 0, 1) + -$s3 * $d3 * clamp(1 - abs(point.z / $sp - $r3), 0, 1) * clamp((point.y / $len - $y3) / 0.02 + 1, 0, 1) * clamp(($y3 + $l3 - point.y / $len) / 0.02 + 1, 0, 1) * clamp(ceil($s3 * point.x - (0.5 * $w - 0.02)), 0, 1) + -(2 * clamp(ceil(point.x), 0, 1) - 1) * 0.16 * $dv * abs(sin(131 * point.z / $sp + $ph + 40 * sin(1.3 * point.y + $ph))) * clamp(ceil(abs(point.x) - (0.5 * $w - 0.02)), 0, 1) * clamp(ceil(point.z - $ac - 0.01), 0, 1) * clamp(ceil($t - $ac - 0.01 - point.z), 0, 1) + -$ks1 * $kd1 * clamp(1 - point.z / 2.8, 0, 1) * clamp((point.y - $ka1) / 1.0 + 1, 0, 1) * clamp(($kb1 - point.y) / 1.0 + 1, 0, 1) * clamp(ceil($ks1 * point.x - 0.2 * $w), 0, 1) + -$ks2 * $kd2 * clamp(1 - point.z / 2.8, 0, 1) * clamp((point.y - $ka2) / 1.0 + 1, 0, 1) * clamp(($kb2 - point.y) / 1.0 + 1, 0, 1) * clamp(ceil($ks2 * point.x - 0.2 * $w), 0, 1), clamp(1 - point.y / 0.5, 0, 1) * ($e0a * point.z / $t + $e0b * (0.5 + point.x / $w)) - clamp(1 - ($len - point.y) / 0.5, 0, 1) * ($e1a * (1 - point.z / $t) + $e1b * (0.5 - point.x / $w)), 0.42 * $sp * ($r1 - point.z / $sp) * clamp(1 - abs(abs(point.z / $sp - $r1) - 1), 0, 1) * clamp((point.y / $len - $y1) / 0.02 + 1, 0, 1) * clamp(($y1 + $l1 - point.y / $len) / 0.02 + 1, 0, 1) * clamp(ceil($s1 * point.x - (0.5 * $w - 0.02)), 0, 1) + 0.42 * $sp * ($r2 - point.z / $sp) * clamp(1 - abs(abs(point.z / $sp - $r2) - 1), 0, 1) * clamp((point.y / $len - $y2) / 0.02 + 1, 0, 1) * clamp(($y2 + $l2 - point.y / $len) / 0.02 + 1, 0, 1) * clamp(ceil($s2 * point.x - (0.5 * $w - 0.02)), 0, 1) + 0.42 * $sp * ($r3 - point.z / $sp) * clamp(1 - abs(abs(point.z / $sp - $r3) - 1), 0, 1) * clamp((point.y / $len - $y3) / 0.02 + 1, 0, 1) * clamp(($y3 + $l3 - point.y / $len) / 0.02 + 1, 0, 1) * clamp(ceil($s3 * point.x - (0.5 * $w - 0.02)), 0, 1) + 0.55 * $kd1 * clamp(1 - point.z / 0.6, 0, 1) * clamp((point.y - $ka1) / 1.0 + 1, 0, 1) * clamp(($kb1 - point.y) / 1.0 + 1, 0, 1) * clamp(ceil($ks1 * point.x - 0.2 * $w), 0, 1) + 0.55 * $kd2 * clamp(1 - point.z / 0.6, 0, 1) * clamp((point.y - $ka2) / 1.0 + 1, 0, 1) * clamp(($kb2 - point.y) / 1.0 + 1, 0, 1) * clamp(ceil($ks2 * point.x - 0.2 * $w), 0, 1)))
  }
  uv(box, facing=(0, 0, 1), up=(0, $Uf, 0), scale=($aspect * $tile, $tile, $tile), offset=($Uo, $Vo))
  material($Face)
}

# a joist of the floor, its own: width and depth varied, sagging and crooked a little along its length; built along
# +Y, its top at z = 0 (the deck turns it to run along X under the boards). Round 8: at budget 1 and 2 an OLD joist
# (`JoistBlank`: checks, eroded grain, ends off square, breakouts), decayed `jdv`; its sag stays `jsag` so the boards still bear on it
DeckJoist = mesh(w=3.8, d=18.4, len=200.0, jvw=0.05, jvd=0.03, jsag=0.4, jcrook=0.3, arris=3, softness=0.0, tile=100.0, aspect=1.0, noise=1, index=0, jdv=0.0, jcheck=0.35, jends=0.6, jchips=2) {
  $K = $noise * 1013 + $index
  $Uo = $Hash($K, 7311.3)
  $Vo = $Hash($K, 7337.9)
  $Uf = 2 * floor(2 * $Hash($K, 7363.1)) - 1
  $jq1 = $Hash($K, 3011.3)
  $jq2 = $Hash($K, 3127.9)
  $jq3 = $Hash($K, 3251.7)
  $jq4 = $Hash($K, 3389.3)
  $Jw = $w * (1 + $jvw * (2 * $jq1 - 1))
  $Jd = $d * (1 + $jvd * (2 * $jq2 - 1))
  if ($arris > 1.5) {
    add($JoistBlank, w=$Jw, t=$Jd, len=$len, dv=$jdv, checkd=$jcheck, ends=$jends, chips=$jchips, softness=$softness, tile=$tile, aspect=$aspect, noise=$noise, index=$index)
  } else {
    add($AgedSec1, w=$Jw, t=$Jd, a=0.2 + 0.5 * $softness, b=0.2 + 0.4 * $softness, c=0.15, d=0.15, seg=2, scale=(1.0, $len / 100.0, 1.0))
  }
  $Age(w=$Jw, t=$Jd, len=$len, bowv=-$jsag * (0.4 + 0.6 * $jq3), crookv=$jcrook * (2 * $jq4 - 1), softv=$softness)
  uv(box, facing=(0, 0, 1), up=(0, $Uf, 0), scale=($aspect * $tile, $tile, $tile), offset=($Uo, $Vo))
  material($Face)
  place(by=(0.0, 0.0, -$Jd))
}

# a round POLE (TK14, ladders: a peeled pole rail, a round rung, a bamboo culm): `r` cm radius on its axis, along +Y from
# 0 to `len`. `taper` the top's radius lost (share); `crook` cm of bow sideways (and a smaller second wave); `oval` the
# section's squash; `nodes` 0 or the spacing (cm) of raised rings (a bamboo culm's nodes, 0.06 r proud); `sag` cm the middle
# drops (a loaded or cracked rung); decay `dv` 0-1: two long open checks (`checkd` x r deep at full decay, each its own
# place and length), eroded grain (`ero` x r of blotchy loss along the grain) and a rotted foot `foot` cm long (the y = 0
# end shrinks and breaks up); `wear` cm worn off its top (+z) over its middle (a rung's tread); `split` 0-1 a crack along
# its underside (-z) over the middle third, that share of r deep (a cracked rung); `seg` round segments; keyed `noise`, `index`
PoleBlank = mesh(r=3.0, seg=10) {
  circle(radius=$r, segments=$seg)
  sweep(along=$JRun)
}
Pole = mesh(r=3.0, len=200.0, taper=0.1, crook=1.0, oval=0.08, nodes=0.0, sag=0.0, dv=0.0, checkd=0.3, ero=0.0, foot=0.0, wear=0.0, split=0.0, seg=10, tile=100.0, aspect=1.0, noise=1, index=0) {
  $K = $noise * 1033 + $index
  $q1 = $Hash($K, 6011.3)
  $q2 = $Hash($K, 6037.9)
  $q3 = $Hash($K, 6061.7)
  $q4 = $Hash($K, 6089.3)
  $q5 = $Hash($K, 6113.1)
  $q6 = $Hash($K, 6151.9)
  $q7 = $Hash($K, 6173.3)
  $q8 = $Hash($K, 6199.7)
  $L = max($len, 1.0)
  add($PoleBlank, r=$r, seg=$seg, scale=(1.0, $L / 100.0, 1.0))
  # the UV goes on the straight blank, a box projection as every board's (the grain along the member; 8-12 sides keep it
  # under 1.25), each pole its own place on the texture and turned end for end at random: the bends, sag and checks
  # below carry it with the surface
  uv(box, facing=(0, 0, 1), up=(0, 2 * floor(2 * $Hash($K, 7363.1)) - 1, 0), scale=($aspect * $tile, $tile, $tile), offset=($Hash($K, 7311.3), $Hash($K, 7337.9)))
  warp(by=(-point.x * $taper * point.y / $L + point.x * $oval * (2 * $q1 - 1) + $crook * (2 * $q2 - 1) * sin(180 * point.y / $L) + 0.35 * $crook * (2 * $q3 - 1) * sin(540 * point.y / $L + 360 * $q4), 0.0, -point.z * $taper * point.y / $L - point.z * $oval * (2 * $q1 - 1) + 0.5 * $crook * (2 * $q5 - 1) * sin(180 * point.y / $L) - $sag * sin(180 * clamp(point.y / $L, 0, 1))))
  if ($nodes > 0.5) {
    warp(by=(0.06 * point.x * clamp(1 - abs(point.y / $nodes - floor(point.y / $nodes + 0.5 + 0.3 * $q6) + 0.3 * $q6) * $nodes / 1.2, 0, 1), 0.0, 0.06 * point.z * clamp(1 - abs(point.y / $nodes - floor(point.y / $nodes + 0.5 + 0.3 * $q6) + 0.3 * $q6) * $nodes / 1.2, 0, 1)))
  }
  if ($dv > 0.001) {
    $c1x = $r * (0.5 * $q6 - 0.25)
    $c1a = $L * 0.6 * $q7
    $c1b = $c1a + $L * (0.25 + 0.4 * $q8)
    $c2z = $r * (0.5 * $q8 - 0.25)
    $c2a = $L * 0.5 * $q3
    $c2b = $c2a + $L * (0.2 + 0.45 * $q5)
    warp(by=(-$checkd * $r * $dv * clamp(1 - abs(point.z - $c2z) / (0.34 * $r + 0.3), 0, 1) * clamp(point.x / (0.5 * $r), 0, 1) * clamp((point.y - $c2a) / 3.0, 0, 1) * clamp(($c2b - point.y) / 3.0, 0, 1), 0.0, -$checkd * $r * $dv * clamp(1 - abs(point.x - $c1x) / (0.34 * $r + 0.3), 0, 1) * clamp(point.z / (0.5 * $r), 0, 1) * clamp((point.y - $c1a) / 3.0, 0, 1) * clamp(($c1b - point.y) / 3.0, 0, 1)))
    if ($ero * $dv > 0.001) {
      warp(by=(-point.x * $ero * $dv * (0.5 + 0.5 * sin(360 * (point.y / (9.0 + 6.0 * $q2) + $q4) + 1080 * point.x / $r)) * (0.5 + 0.5 * sin(360 * (point.y / (14.0 + 9.0 * $q5) + $q7) + 720 * point.z / $r)), 0.0, -point.z * $ero * $dv * (0.5 + 0.5 * sin(360 * (point.y / (9.0 + 6.0 * $q2) + $q4) + 1080 * point.x / $r)) * (0.5 + 0.5 * sin(360 * (point.y / (14.0 + 9.0 * $q5) + $q7) + 720 * point.z / $r))))
    }
    if ($foot > 0.1) {
      warp(by=(-0.45 * point.x * clamp(1 - point.y / $foot, 0, 1) * (0.6 + 0.4 * sin(720 * point.x / $r + 360 * $q1)), 0.0, -0.45 * point.z * clamp(1 - point.y / $foot, 0, 1) * (0.6 + 0.4 * sin(720 * point.z / $r + 360 * $q3))))
    }
  }
  if ($wear > 0.001) {
    warp(by=(0.0, 0.0, -$wear * clamp((point.z - 0.3 * $r) / (0.7 * $r), 0, 1) * sin(180 * clamp((point.y / $L - 0.12) / 0.76, 0, 1))))
  }
  if ($split > 0.001) {
    warp(by=(0.0, 0.0, $split * $r * clamp(1 - abs(point.x) / (0.18 * $r + 0.15), 0, 1) * clamp(-point.z / (0.5 * $r), 0, 1) * clamp((point.y - 0.33 * $L) / 2.0, 0, 1) * clamp((0.67 * $L - point.y) / 2.0, 0, 1)))
  }
  material($Face)
}

Walkway = mesh(size_x=300.0, size_y=180.0, damage=0.0, age=1.0, softness=0.0, noise=1, budget=1, pin=22.0, sleepers=2, sl_w=16.0, sl_d=16.0, sl_in=24.0, beams=2, beam_w=16.0, beam_d=20.0, beam_in=20.0, beam_wear=1.5, pw_lo=12.0, pw_hi=30.0, pthick=8.0, gap_lo=0.3, gap_hi=1.6, stag=14.0, pflush=0.35, pslant=0.15, slantq=4.0, cant=0.8, plift=0.08, lifth=2.5, sprung=1, springh=5.0, psag=1.2, loose=0.12, pgone=0.12, nails=1, proud=0.6, rope=1, turns=4, rope_r=1.3, rope_at=5.0, debris=4, hole_xf=0.5, hvar=25.0, midbay=0.25, plevel=0.6, phang=0.25, pcrack=0.1, stub=1, deep=1.0, grain=0.24, bslant=10.0, torn=0.85, detail=0.25, wvar=0.1, tvar=0.12, taper=0.04, waney=0.5, ttaper=0.08, yaw=0.5, pitch=0.25, roll=0.6, lift=0.25, cup=0.6, bow=0.5, crook=0.3, twist=1.5, endsq=1.5, wear=0.9, wearvar=0.6, state=0.35, ridge=0.55, checks=3, checkd=0.45, crumb=5.0, sliver=0.6, corner=0.45, thin=0.22, tear=0.8, bfib=0.06, tile=100.0, aspect=1.0) {
  $size_xC = clamp($size_x, 100, 800)
  $size_yC = clamp($size_y, 80, 400)
  $damageC = clamp($damage, 0, 1)
  $ageC = clamp($age, 0, 2)
  $softnessC = clamp($softness, 0, 1)
  $noiseC = floor($noise)
  $budgetC = clamp(floor($budget + 0.5), 0, 2)
  $pinC = clamp($pin, 5, 60)
  $sleepersC = clamp(floor($sleepers + 0.5), 2, 4)
  $sl_wC = clamp($sl_w, 8, 40)
  $sl_dC = clamp($sl_d, 8, 40)
  $sl_inC = clamp($sl_in, 5, 100)
  $beamsC = clamp(floor($beams + 0.5), 2, 3)
  $beam_wC = clamp($beam_w, 8, 40)
  $beam_dC = clamp($beam_d, 8, 50)
  $beam_inC = clamp($beam_in, 0, 80)
  $beam_wearC = clamp($beam_wear, 0, 5)
  $pw_loC = clamp($pw_lo, 6, 60)
  $pw_hiC = clamp($pw_hi, 8, 80)
  $pthickC = clamp($pthick, 2, 20)
  $gap_loC = clamp($gap_lo, 0, 5)
  $gap_hiC = clamp($gap_hi, 0, 10)
  $stagC = clamp($stag, 0, 60)
  $pflushC = clamp($pflush, 0, 1)
  $pslantC = clamp($pslant, 0, 1)
  $slantqC = clamp($slantq, 1, 8)
  $cantC = clamp($cant, 0, 10)
  $pliftC = clamp($plift, 0, 1)
  $lifthC = clamp($lifth, 0, 15)
  $sprungC = clamp(floor($sprung + 0.5), 0, 3)
  $springhC = clamp($springh, 0, 30)
  $psagC = clamp($psag, 0, 10)
  $looseC = clamp($loose, 0, 1)
  $pgoneC = clamp($pgone, 0, 0.5)
  $nailsC = clamp(floor($nails + 0.5), 0, 1)
  $proudC = clamp($proud, 0, 3)
  $ropeC = clamp(floor($rope + 0.5), 0, 1)
  $turnsC = clamp(floor($turns + 0.5), 1, 10)
  $rope_rC = clamp($rope_r, 0.3, 4)
  $rope_atC = clamp($rope_at, 0, 30)
  $debrisC = clamp(floor($debris + 0.5), 0, 40)
  $hole_xfC = clamp($hole_xf, 0, 1)
  $hvarC = clamp($hvar, 0, 200)
  $midbayC = clamp($midbay, 0, 1)
  $plevelC = clamp($plevel, 0, 1)
  $phangC = clamp($phang, 0, 1)
  $pcrackC = clamp($pcrack, 0, 1)
  $stubC = clamp(floor($stub + 0.5), 0, 1)
  $deepC = clamp($deep, 0.1, 4)
  $grainC = clamp($grain, 0.1, 0.6)
  $bslantC = clamp($bslant, 0, 20)
  $tornC = clamp($torn, 0, 1)
  $detailC = clamp($detail, 0.1, 1)
  $wvarC = clamp($wvar, 0, 0.4)
  $tvarC = clamp($tvar, 0, 0.4)
  $taperC = clamp($taper, 0, 0.3)
  $waneyC = clamp($waney, 0, 5)
  $ttaperC = clamp($ttaper, 0, 0.5)
  $yawC = clamp($yaw, 0, 6)
  $pitchC = clamp($pitch, 0, 6)
  $rollC = clamp($roll, 0, 10)
  $liftC = clamp($lift, 0, 5)
  $cupC = clamp($cup, 0, 4)
  $bowC = clamp($bow, 0, 15)
  $crookC = clamp($crook, 0, 15)
  $twistC = clamp($twist, 0, 20)
  $endsqC = clamp($endsq, 0, 12)
  $wearC = clamp($wear, 0, 4)
  $wearvarC = clamp($wearvar, 0, 1)
  $stateC = clamp($state, 0, 1)
  $ridgeC = clamp($ridge, 0, 2)
  $checksC = clamp(floor($checks + 0.5), 0, 4)
  $checkdC = clamp($checkd, 0, 0.9)
  $crumbC = clamp($crumb, 0, 20)
  $sliverC = clamp($sliver, 0, 1)
  $cornerC = clamp($corner, 0, 1)
  $thinC = clamp($thin, 0, 0.6)
  $tearC = clamp($tear, 0, 3)
  $bfibC = clamp($bfib, 0, 0.5)
  $tileC = clamp($tile, 10, 1000)
  $aspectC = clamp($aspect, 0.1, 10)
  $pinC = min($pinC, 0.12 * $size_yC)
  $beam_inC = min($beam_inC, 0.1 * $size_yC)
  $beam_wC = min($beam_wC, 0.1 * $size_yC)
  $sl_inC = min($sl_inC, 0.12 * $size_xC)
  $stagC = min($stagC, 0.08 * $size_yC)
  $agf = (min($ageC, 1) + 2 * max($ageC - 1, 0))
  $decayA = clamp(($ageC - 1.1) / 0.7, 0, 1)
  $AR = 1 + 2 * min($budgetC, 1)
  $seg = 2 + 2 * min($budgetC, 1) + 4 * max($budgetC - 1, 0)
  $fb = $bfibC * max($budgetC - 1, 0)
  $hole = clamp(ceil($damageC - 0.02), 0, 1)
  $hole_rx = 12.0 + 56.0 * $damageC
  $pmiss = 0.1 + 0.4 * $damageC
  $pend = 0.24 * $damageC
  $gapH = $gap_loC + ($gap_hiC - $gap_loC) * min(max($agf, 0.3), 3.0)
  $ndeb = floor($debrisC * min($agf, 2.0) + 6 * $damageC + 0.5)
  $sagA = min($psagC * $agf, 10.0)
  $sprA = min($springhC * $agf, 30.0)
  $hq0 = sin($noiseC * 1009 * 12.9898 + 901.7) * 43758.5453
  $hq0 = $hq0 - floor($hq0)
  $hq1 = sin($noiseC * 1009 * 12.9898 + 917.3) * 43758.5453
  $hq1 = $hq1 - floor($hq1)
  $hq2 = sin($noiseC * 1009 * 12.9898 + 933.1) * 43758.5453
  $hq2 = $hq2 - floor($hq2)
  $hq3 = sin($noiseC * 1009 * 12.9898 + 947.9) * 43758.5453
  $hq3 = $hq3 - floor($hq3)
  $hq4 = sin($noiseC * 1009 * 12.9898 + 961.3) * 43758.5453
  $hq4 = $hq4 - floor($hq4)
  $hq5 = sin($noiseC * 1009 * 12.9898 + 977.7) * 43758.5453
  $hq5 = $hq5 - floor($hq5)
  $hx = $hole_xfC * $size_xC + $hvarC * (2 * $hq0 - 1)
  $hxA = $hx + 0.5 * $hvarC * (2 * $hq1 - 1)
  $rxA = $hole_rx * (0.7 + 0.5 * $hq2)
  $hxB = $hx + 0.5 * $hvarC * (2 * $hq3 - 1)
  $rxB = $hole_rx * (0.7 + 0.5 * $hq4)
  $fA = $pinC + $beam_inC + $beam_wC
  $fB = $size_yC - $pinC - $beam_inC - $beam_wC
  $mA = 0.5 * ($size_yC - $beam_wC) + (1 - clamp($beamsC - 2, 0, 1)) * 999.0
  $mB = 0.5 * ($size_yC + $beam_wC) - (1 - clamp($beamsC - 2, 0, 1)) * 999.0
  $xa = 0.3
  # the beams: along X, 0.5 cm in from each module end (a tiled walkway's beams meet end to end)
  add($AgedBoard, width=$beam_wC, thick=$beam_dC, length=$size_xC - 1.0, damage=0.0, age=$ageC, softness=$softnessC, noise=$noiseC, budget=$budgetC, index=900, wvar=0.05, tvar=0.0, lvar=0.0, yaw=0.15, pitch=0.0, roll=0.3, lift=0.0, cup=0.0, bow=0.0, crook=0.4, twist=0.5, taper=0.02, waney=0.4, ttaper=0.03, wear=$beam_wearC, endsq=0.5, decay=0.0, arris=$AR, seg=$seg, tile=$tileC, aspect=$aspectC, at=(0.5, $pinC + $beam_inC + 0.5 * $beam_wC, -$pthickC - $beam_dC), rotate=(0.0, 0.0, -90.0))
  loop (repeat=$beamsC - 1) {
    $bi = output.index
    $yb = $pinC + $beam_inC + 0.5 * $beam_wC + ($size_yC - 2 * $pinC - 2 * $beam_inC - $beam_wC) * $bi / max($beamsC - 1, 1)
    add($AgedBoard, width=$beam_wC, thick=$beam_dC, length=$size_xC - 1.0, damage=0.0, age=$ageC, softness=$softnessC, noise=$noiseC, budget=$budgetC, index=900 + $bi, wvar=0.05, tvar=0.0, lvar=0.0, yaw=0.15, pitch=0.0, roll=0.3, lift=0.0, cup=0.0, bow=0.0, crook=0.4, twist=0.5, taper=0.02, waney=0.4, ttaper=0.03, wear=$beam_wearC, endsq=0.5, decay=0.0, arris=$AR, seg=$seg, tile=$tileC, aspect=$aspectC, at=(0.5, $yb, -$pthickC - $beam_dC), rotate=(0.0, 0.0, -90.0), join=none)
  }
  # the sleepers, their ends lashed with `turns` turns of rope
  loop (repeat=$sleepersC) {
