  }
  $Age(w=$Wd, t=$Td, len=$Ld, cupv=$cp, bowv=$bw, crookv=$ck, e0=$e0, e1=$e1 * (1 - $brkd), yawv=$yw, liftv=$lf, rm=$rm * (1 - clamp(ceil($dv - 0.001), 0, 1)), wa=$wa, wb=$wb, ph=$ph, fr=$fr, twistv=$tw, taperv=$tp, wanev=$wv, wanek=$wk, wanes=$ws, ttapv=$tt, pitchv=$pt, rollv=$rl, softv=$softness)
  if ($uvs > 0.5) {
