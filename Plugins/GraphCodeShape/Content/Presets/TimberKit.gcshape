Slabs = instruction(along=[(0, 0, 1)], size=40.0, count=-1.0, holes=-1.0, depth=-1.0, age=2.0, length=-1.0, top=1.0, bulge=0.0, base=0.0, px=0.0, py=0.0, noise=1, hw=-1.0, hh=-1.0) {
