  $rcap = min(0.3 * $Wd, 0.4 * $Td)
  $ra = min(max($wearS * (1 + $wearvarC * (2 * $ad13 - 1)), 0.1 * $wearS), $rcap)
  $rb = min(max($wearS * (1 + $wearvarC * (2 * $ad14 - 1)), 0.1 * $wearS), $rcap)
  $rc = min(0.35 * $wearS * (0.6 + 0.8 * $ad15), $rcap)
  $rd = min(0.35 * $wearS * (0.6 + 0.8 * $ad16), $rcap)
  $rm = max($ra, $rb)
  $wa = min($wearvarC, 0.8) * (0.3 + 0.7 * $ad17)
  $wb = min($wearvarC, 0.8) * (0.3 + 0.7 * $ad18)
  $ph = 360 * $ad19
  $fr = 0.6 + 1.2 * $ad20
  $ad21 = sin($K * 12.9898 + 366.4) * 43758.5453
  $ad21 = $ad21 - floor($ad21)
  $ad22 = sin($K * 12.9898 + 383.7) * 43758.5453
