  $ad18 = sin($K * 12.9898 + 314.5) * 43758.5453
  $ad18 = $ad18 - floor($ad18)
  $ad19 = sin($K * 12.9898 + 331.8) * 43758.5453
  $ad19 = $ad19 - floor($ad19)
