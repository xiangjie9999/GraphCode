    $ad38 = sin($K * 12.9898 + 660.5) * 43758.5453
    $ad38 = $ad38 - floor($ad38)
    $ad39 = sin($K * 12.9898 + 677.8) * 43758.5453
    $ad39 = $ad39 - floor($ad39)
    $ad40 = sin($K * 12.9898 + 695.1) * 43758.5453
    $ad40 = $ad40 - floor($ad40)
    $ad41 = sin($K * 12.9898 + 712.4) * 43758.5453
    $ad41 = $ad41 - floor($ad41)
    $ad42 = sin($K * 12.9898 + 729.7) * 43758.5453
    $ad42 = $ad42 - floor($ad42)
    $ad43 = sin($K * 12.9898 + 747.0) * 43758.5453
    $ad43 = $ad43 - floor($ad43)
    $ad44 = sin($K * 12.9898 + 764.3) * 43758.5453
    $ad44 = $ad44 - floor($ad44)
    $tw = $twistA * (0.3 + 0.7 * $ad21) * (2 * floor(2 * $ad22) - 1)
    $tp = $taperA * (2 * $ad23 - 1)
    $wv = $waneyC * (0.3 + 0.7 * $ad24)
    $wk = 0.5 + 1.5 * $ad25
    $ws = 2 * floor(2 * $ad26) - 1
    $tt = $ttaperA * (2 * $ad27 - 1)
    $pt = $pitchA * (2 * $ad28 - 1)
    $rl = $rollA * (2 * $ad29 - 1)
    $dv = clamp($decayA * (1 + $stateC * (2 * $ad30 - 1)), 0, 1)
    $nck = min(floor($checksC * (0.4 + 0.6 * $ad31) + 0.5), 3) * clamp(ceil($dv - 0.05), 0, 1)
    $cx1 = 3 + floor(13 * $ad32)
    $cx2 = 3 + floor(13 * $ad33)
    $cx3 = 3 + floor(13 * $ad34)
    $cy1 = 0.05 + 0.3 * $ad35
    $cl1 = 0.3 + 0.6 * $ad36
    $cy2 = 0.35 + 0.4 * $ad37
    $cl2 = 1.0
    $cy3 = 0.0
    $cl3 = 0.15 + 0.4 * $ad38
    $sl = clamp(ceil($sliverC * $dv - $ad39), 0, 1)
    $sly = 0.1 + 0.5 * $ad40
    $co = clamp(ceil($cornerC * $dv - $ad41), 0, 1)
    $coe = floor(2 * $ad42)
    $cos = 2 * floor(2 * $ad43) - 1
    $crf = 0.5 + 0.5 * $ad44
    $Wc = $Wd * cos($yw)
    $Ex = $heightC * abs(sin($yw)) + 2 * abs($ck) + abs($wv) + 0.5 * $Wd * abs($tp)
    $x = $xc + 0.5 * ($Wc + $Ex)
    $xc = $xc + $Wc + $Ex + $gp
    $Hd = $Ld
    $zback = max(-$cp, 0) + max(-$bw, 0) + 0.5 * $Wd * abs(sin($rl)) + 0.5 * $Wd * abs(sin(0.5 * $tw)) + 0.5 * $Ld * abs(tan($pt)) + max(-$lf, 0) + 0.05
    $bz = $botA * $bbz * clamp(ceil(0.6 - $bbt), 0, 1)
    $sw = $snap * clamp(ceil($bsf - $sfl), 0, 1)
    $dj = 0.07 + 0.2 * $bsh
    $sgn = 2 * floor(2 * $bsg) - 1
    $fn = $fp + $sgn * $dj
    $fo = min(clamp(ceil($fn - $fhi), 0, 1) + clamp(ceil($flo - $fn), 0, 1), 1)
    $fn = clamp($fn - 2 * $fo * $sgn * $dj, $flo, $fhi)
    $fp = $fp + $sw * ($fn - $fp)
    $hs = $fn * $Ld
    $sty = $stp + 1 + floor(4 * $bst)
    $sty = $sty - 5 * floor($sty / 5)
    $stp = $stp + $sw * ($sty - $stp)
    $dx = ($x - $hxw) / $hrx
    $hh = $hole * $hrz * sqrt(max(1 - $dx * $dx, 0)) * (1 - $hragC + 2 * $hragC * $bh1)
    $zlo = $hzw - $hh * (0.8 + 0.4 * $bh2)
    $zhi = $hzw + $hh * (0.8 + 0.4 * $bh3)
    $ho = $hole * clamp(ceil($zhi - $zlo - 2 * $hreach * $Wd - 6.0), 0, 1)
    $styL = $stL + 1 + floor(4 * $bsu)
    $styL = $styL - 5 * floor($styL / 5)
    $stL = $stL + $ho * ($styL - $stL)
    $styU = $stU + 1 + floor(4 * $bh4)
    $styU = $styU - 5 * floor($styU / 5)
    $stU = $stU + $ho * ($styU - $stU)
    if ($ho > 0.5) {
      add($AgedBoard, width=$width, thick=$bthickC, length=$zlo - $bz, age=$ageC, softness=$softnessC, noise=$noiseC, budget=$budgetC, index=$i, wvar=$wvarC, tvar=$tvarC, taper=$taperC, waney=$waneyC, ttaper=$ttaperC, yaw=$yawC, pitch=$pitchC, roll=$rollC, lift=$liftC, cup=$cupC, bow=$bowC, crook=$crookC, twist=$twistC, wear=$wearC, wearvar=$wearvarC, state=$stateC, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=$thinC, tear=$tearC, decay=$decayA, lvar=0.0, endsq=$endsqC, tile=$tileC, aspect=$aspectC, arris=$AR, seg=$seg, damage=$damageC, base=$zlo - $bz, reach=$hreach, style=$styL, at=($x, -$zback, $bz), rotate=(-90.0, 0.0, 0.0), join=none)
      add($AgedBoard, width=$width, thick=$bthickC, length=$Hd - $zhi, age=$ageC, softness=$softnessC, noise=$noiseC, budget=$budgetC, index=$i, wvar=$wvarC, tvar=$tvarC, taper=$taperC, waney=$waneyC, ttaper=$ttaperC, yaw=$yawC, pitch=$pitchC, roll=$rollC, lift=$liftC, cup=$cupC, bow=$bowC, crook=$crookC, twist=$twistC, wear=$wearC, wearvar=$wearvarC, state=$stateC, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=$thinC, tear=$tearC, decay=$decayA, lvar=0.0, endsq=$endsqC, tile=$tileC, aspect=$aspectC, arris=$AR, seg=$seg, damage=$damageC, base=$Hd - $zhi, reach=$hreach, style=$styU, tk=37, at=($x, -$zback, $Hd + $bz), rotate=(90.0, 0.0, 180.0), join=none)
    } else {
      if ($sw > 0.5) {
        add($AgedBoard, width=$width, thick=$bthickC, length=$length, age=$ageC, softness=$softnessC, noise=$noiseC, budget=$budgetC, index=$i, wvar=$wvarC, tvar=$tvarC, taper=$taperC, waney=$waneyC, ttaper=$ttaperC, yaw=$yawC, pitch=$pitchC, roll=$rollC, lift=$liftC, cup=$cupC, bow=$bowC, crook=$crookC, twist=$twistC, wear=$wearC, wearvar=$wearvarC, state=$stateC, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=$thinC, tear=$tearC, decay=$decayA, lvar=$lvarC, endsq=$endsqC, tile=$tileC, aspect=$aspectC, arris=$AR, seg=$seg, damage=$damageC, base=$hs, reach=$rxw, style=$sty, at=($x, -$zback, $bz), rotate=(-90.0, 0.0, 0.0), join=none)
      } else {
        add($AgedBoard, width=$width, thick=$bthickC, length=$length, age=$ageC, softness=$softnessC, noise=$noiseC, budget=$budgetC, index=$i, wvar=$wvarC, tvar=$tvarC, taper=$taperC, waney=$waneyC, ttaper=$ttaperC, yaw=$yawC, pitch=$pitchC, roll=$rollC, lift=$liftC, cup=$cupC, bow=$bowC, crook=$crookC, twist=$twistC, wear=$wearC, wearvar=$wearvarC, state=$stateC, ridge=$ridgeC, checks=$checksC, checkd=$checkdC, crumb=$crumbC, sliver=$sliverC, corner=$cornerC, thin=$thinC, tear=$tearC, decay=$decayA, lvar=$lvarC, endsq=$endsqC, tile=$tileC, aspect=$aspectC, arris=$AR, seg=$seg, damage=0.0, at=($x, -$zback, $bz), rotate=(-90.0, 0.0, 0.0), join=none)
      }
    }
  }
}

# ==== THE LADDER (TK14, owner 20 Nov: "Similar approach can be used for ladder as well?"; measured from Commons photos in
# `Saved/Gate/Reference/Ladder/`, the table in `Docs/GC-SHAPE-DAMAGE-KIT-ROUNDS.md` "TK14") ================================
#
#   Kit = shape('/GraphCodeShape/Presets/TimberKit', Face = $Oak, Broken = $OakTorn, Rope = $Hemp, Iron = $Iron)
#   Old = mesh() { add($Kit.Ladder, type=1, height=320.0, age=1.6, noise=4) }
#
# A ladder STANDING on z = 0, rails rising along +Z, its front (the rungs' climbing side) toward -Y, centred on x = 0.
# `lean` (degrees) tips the top toward +Y about the foot: 12-20 against a wall in the photos. Every knob is clamped; a
# knob whose default is -1 is taken from `type` (the photo values in brackets); any value 0 or more overrides it.
#   knob     default unit  range       what it does
#   type          0  0-3              construction: 0 pole rails, round rungs LASHED on their front with rope (Bandelier
#                                     pole ladder) [width 60, pitch 30, rails 10, rungs 5.5, ends standing out 12]; 1 pole rails,
#                                     round rungs THROUGH holes in them (peeled-pole and bamboo ladders) [42, 28, 7.5, 4.2,
#                                     1.5]; 2 sawn rails, round rungs through them (village and church ladders) [44, 29,
#                                     6 x 9, 5, 1.5]; 3 sawn rails, flat rungs housed in them and nailed (attic, step-ladder
#                                     side) [42, 27, 3.5 x 9, flat 9 x 2.5]; NOTE 20 Nov: type 3 has not passed the critic yet
#                                     (its treads' UV stretch 1.33-1.36, its rails too straight), so it ships no build line
#   height      300  100-800 cm       rail length, foot to top
#   width        -1  20-150 cm        rail centre to rail centre at the foot
#   splay        -1  0-0.6 x width cm how much narrower the top is than the foot [6, 4, 7, 8]
#   pitch        -1  18-45 cm         rung to rung; the first rung 0.85 pitch above the foot
#   rails        -1  0-1              0 round poles, 1 sawn
#   rungs        -1  0-1              0 round, 1 flat boards
#   joint        -1  0-2              0 through the rails, 1 lashed on the front, 2 housed in the rails and nailed
#   rail_w       -1  2-20 cm          a pole rail's diameter, or a sawn rail's face width (across the ladder)
#   rail_d       -1  2-25 cm          a sawn rail's depth, front to back [9]; a pole's is its diameter
#   rung_d       -1  2-10 cm          a round rung's diameter
#   rung_w       -1  4-20 cm          a flat rung's width, along the rails [9]
#   rung_t       -1  1-6 cm           a flat rung's thickness [2.5]
#   over         -1  0-25 cm          how far a round rung's ends stand past the rails' outer faces
#   age         1.0  0-2              0 new (straight, clean); 1 aged (open checks along the rails, rung tops worn, the
#                                     rails a little crooked, the pitch a little uneven); 2 decayed (deep checks, eroded
#                                     grain, rotted feet, missing rungs leaving their holes, a cracked sagging rung, slack
#                                     lashing)
#   missing    0.35  0-1              past age 1, the share of rungs gone x (age - 1); never the first or the last rung
#   crack         1  0-1              past age 1.2, one rung cracked along its underside and sagging
#   slack       1.0  0-3 cm           past age 0.8, how far a lashing has slipped down and opened, x (age - 0.8)
#                                     (the game rings; a draped lashing is pulled tight)
#   holes         1  0-1              a missing through-rung leaves its holes in the rails (types 1, 2)
#   lean        0.0  0-30 deg         tips the ladder about its foot, the top toward +Y
#   budget        1  0-2              0 game (6- and 8-sided poles, no checks), 1 high, 2 ultra; a lashing (joint 1,
#                                     round rail and rung) is rings at game, at high and ultra a real square lashing
#                                     (4 turns a side, 2 frapping) draped onto the crossing as built
#   noise         1                   the seed
Ladder = mesh(type=0, height=300.0, width=-1.0, splay=-1.0, pitch=-1.0, rails=-1, rungs=-1, joint=-1, rail_w=-1.0, rail_d=-1.0, rung_d=-1.0, rung_w=-1.0, rung_t=-1.0, over=-1.0, age=1.0, missing=0.35, crack=1, slack=1.0, holes=1, lean=0.0, budget=1, noise=1) {
  add($LadderFlat, type=$type, height=$height, width=$width, splay=$splay, pitch=$pitch, rails=$rails, rungs=$rungs, joint=$joint, rail_w=$rail_w, rail_d=$rail_d, rung_d=$rung_d, rung_w=$rung_w, rung_t=$rung_t, over=$over, age=$age, missing=$missing, crack=$crack, slack=$slack, holes=$holes, budget=$budget, noise=$noise, rotate=(90.0 - clamp($lean, 0.0, 30.0), 0.0, 0.0))
}
# a nail head on a rail's face (with its own UVs, unlike `Nail`)
LadderNail = mesh() {
  circle(radius=0.5, segments=6)
  extrude(height=0.35)
  uv(box, scale=(20.0, 20.0, 20.0))
  material($Iron)
}
# the ladder LYING on its back: rails along +Y from the foot (y = 0), rungs along X, its front toward +Z
LadderFlat = mesh(type=0, height=300.0, width=-1.0, splay=-1.0, pitch=-1.0, rails=-1, rungs=-1, joint=-1, rail_w=-1.0, rail_d=-1.0, rung_d=-1.0, rung_w=-1.0, rung_t=-1.0, over=-1.0, age=1.0, missing=0.25, crack=1, slack=1.0, holes=1, budget=1, noise=1) {
  $T = clamp(floor($type + 0.5), 0, 3)
  $i0 = clamp(1 - abs($T - 0), 0, 1)
  $i1 = clamp(1 - abs($T - 1), 0, 1)
  $i2 = clamp(1 - abs($T - 2), 0, 1)
  $i3 = clamp(1 - abs($T - 3), 0, 1)
  $H = clamp($height, 100.0, 800.0)
  $A = clamp($age, 0.0, 2.0)
  $BG = clamp(floor($budget + 0.5), 0, 2)
  $dW = clamp(ceil(-$width), 0, 1)
  $W = $dW * (60.0 * $i0 + 42.0 * $i1 + 44.0 * $i2 + 42.0 * $i3) + (1 - $dW) * clamp($width, 20.0, 150.0)
  $dS = clamp(ceil(-$splay), 0, 1)
  $SP = clamp($dS * (6.0 * $i0 + 4.0 * $i1 + 7.0 * $i2 + 8.0 * $i3) + (1 - $dS) * $splay, 0.0, 0.6 * $W)
  $dP = clamp(ceil(-$pitch), 0, 1)
  $P = $dP * (30.0 * $i0 + 28.0 * $i1 + 29.0 * $i2 + 27.0 * $i3) + (1 - $dP) * clamp($pitch, 18.0, 45.0)
  $dRs = clamp(ceil(-$rails), 0, 1)
  $RS = clamp(floor($dRs * ($i2 + $i3) + (1 - $dRs) * $rails + 0.5), 0, 1)
  $dRg = clamp(ceil(-$rungs), 0, 1)
  $RG = clamp(floor($dRg * $i3 + (1 - $dRg) * $rungs + 0.5), 0, 1)
  $dJ = clamp(ceil(-$joint), 0, 1)
  $J = clamp(floor($dJ * ($i0 + 2 * $i3) + (1 - $dJ) * $joint + 0.5), 0, 2)
  $dRw = clamp(ceil(-$rail_w), 0, 1)
  $RW = $dRw * (10.0 * $i0 + 7.5 * $i1 + 6.0 * $i2 + 3.5 * $i3) + (1 - $dRw) * clamp($rail_w, 2.0, 20.0)
  $dRd = clamp(ceil(-$rail_d), 0, 1)
  $RD = (1 - $RS) * $RW + $RS * ($dRd * 9.0 + (1 - $dRd) * clamp($rail_d, 2.0, 25.0))
  $dGd = clamp(ceil(-$rung_d), 0, 1)
  $GD = $dGd * (5.5 * $i0 + 4.2 * $i1 + 5.0 * $i2 + 4.0 * $i3) + (1 - $dGd) * clamp($rung_d, 2.0, 10.0)
  $dGw = clamp(ceil(-$rung_w), 0, 1)
  $GW = $dGw * 9.0 + (1 - $dGw) * clamp($rung_w, 4.0, 20.0)
  $dGt = clamp(ceil(-$rung_t), 0, 1)
  $GT = $dGt * 2.5 + (1 - $dGt) * clamp($rung_t, 1.0, 6.0)
  $dOv = clamp(ceil(-$over), 0, 1)
  $OV = $dOv * (12.0 * $i0 + 1.5 * $i1 + 1.5 * $i2) + (1 - $dOv) * clamp($over, 0.0, 25.0)
  # age, from the photos: checks open past 0.5, the grain erodes and the feet rot toward 2
  $DV = clamp(($A - 0.2) / 1.4, 0, 1)
  $ERO = 0.32 * clamp(($A - 1.0) / 1.0, 0, 1)
  $FOOT = 22.0 * clamp(($A - 1.2) / 0.8, 0, 1)
  $CRK = $H * 0.006 * (0.3 + 0.7 * min($A, 1.0)) * (1 + 0.6 * clamp($A - 1.0, 0, 1))
  $WEAR = $GD * 0.05 * min($A, 1.5)
  $MS = clamp($missing, 0.0, 1.0) * clamp($A - 1.0, 0, 1)
  $SL = clamp($slack, 0.0, 3.0) * clamp($A - 0.8, 0, 1.2)
  $segP = 6 + 4 * min($BG, 1) + 4 * clamp($BG - 1, 0, 1)
  $segG = 6 + 2 * min($BG, 1) + 4 * clamp($BG - 1, 0, 1)
  $dvB = $DV * min($BG, 1)
  $deg = 57.2958 * 0.5 * $SP / $H
  # the rails
  if ($RS < 0.5) {
    add($Pole, r=0.5 * $RW, len=$H, taper=0.14, crook=$CRK, oval=0.1, dv=$dvB, checkd=0.35 + 0.15 * clamp($A - 1.0, 0, 1), ero=$ERO, foot=$FOOT, seg=$segP, noise=$noise, index=1, at=(0.5 * $W, 0.0, 0.0), rotate=(0.0, 0.0, $deg), join=none)
    add($Pole, r=0.5 * $RW, len=$H, taper=0.14, crook=$CRK, oval=0.1, dv=$dvB, checkd=0.35 + 0.15 * clamp($A - 1.0, 0, 1), ero=$ERO, foot=$FOOT, seg=$segP, noise=$noise, index=2, at=(-0.5 * $W, 0.0, 0.0), rotate=(0.0, 0.0, -$deg), join=none)
  } else {
    add($DeckJoist, w=$RW, d=$RD, len=$H, jvw=0.08, jvd=0.06, jsag=1.5 * $A, jcrook=1.5 * $A, arris=3, jdv=$dvB, jcheck=0.45, jends=1.2 * min($A, 1.0), noise=$noise, index=1, at=(0.5 * $W, 0.0, 0.5 * $RD), rotate=(0.0, 0.0, $deg), join=none)
    add($DeckJoist, w=$RW, d=$RD, len=$H, jvw=0.08, jvd=0.06, jsag=1.5 * $A, jcrook=1.5 * $A, arris=3, jdv=$dvB, jcheck=0.45, jends=1.2 * min($A, 1.0), noise=$noise, index=2, at=(-0.5 * $W, 0.0, 0.5 * $RD), rotate=(0.0, 0.0, -$deg), join=none)
  }
  # the rungs
  $N = max(floor(($H - 1.15 * $P) / $P) + 1, 1)
  $kc = 1 + floor(max($N - 2, 1) * $Hash($noise * 1069 + 5, 7091.3) * 0.999)
  $CRF = clamp(floor($crack + 0.5), 0, 1) * clamp(ceil($A - 1.2), 0, 1)
  loop (repeat=$N) {
    $k = output.index - 1
    $y = $P * (0.85 + $k) + $P * 0.06 * $A * (2 * $Hash($noise * 1051 + $k, 7011.3) - 1)
    $w = $W - $SP * $y / $H
    $ms = clamp(ceil($MS - $Hash($noise * 1061 + $k, 7033.7)), 0, 1) * clamp($k, 0, 1) * clamp($N - 1 - $k, 0, 1)
    $cr = $CRF * clamp(1 - abs($k - $kc), 0, 1) * (1 - $ms)
    $zr = clamp(1 - abs($J - 1), 0, 1) * (0.5 * $RD + 0.42 * $GD)
    $gl = $w + $RW + 2 * $OV
    if ($ms < 0.5) {
      if ($RG < 0.5) {
        add($Pole, r=0.5 * $GD, len=$gl, taper=0.05, crook=0.15 + 0.25 * $A, oval=0.06, sag=0.2 * $A + 2.0 * $cr, dv=0.8 * $dvB, checkd=0.3, wear=$WEAR, split=0.7 * $cr, seg=$segG, noise=$noise, index=100 + $k, at=(0.5 * $gl, $y, $zr), rotate=(0.0, 0.0, 90.0), join=none)
      } else {
        add($DeckBoard, width=$GW, thick=$GT, length=$w + 0.9 * $RW, wvar=0.12, tvar=0.15, yaw=0.9 * $A, lift=0.35 * $A, cup=0.15 * $A, bow=0.2 * $A, crook=0.15 * $A, endsq=0.5, wear=0.08, arris=3, seg=2 + 2 * min($BG, 1), decay=0.6 * $dvB * clamp($A - 1.0, 0, 1), state=0.3, ridge=0.1, checks=2, checkd=0.3, crumb=1.5 * $A, gouge=0.6 * clamp($A - 0.6, 0, 1.4), lips=0.3 * $A, hollow=0.25 * $A, edgew=0.0, twist=0.4 * $A, roll=0.3 * $A, noise=$noise, index=4 * $k, nl=0, at=(0.5 * ($w + 0.9 * $RW), $y, -0.5 * $GT), rotate=(0.0, 0.0, 90.0), join=none)
        add($LadderNail, at=(0.5 * $w, $y, 0.5 * $RD), join=none)
        add($LadderNail, at=(-0.5 * $w, $y, 0.5 * $RD), join=none)
      }
      if ($J > 0.5) {
        if ($J < 1.5) {
          # a SQUARE LASHING. High and Ultra, round rail and rung: a real one (`LadderLashRope`), its path declared in
          # rope path words and draped onto this crossing's rail and rung as built (crook, taper, oval, checks). Game, or a
          # sawn rail or flat rung: the rings below, as the photos' (08): two cord turns round the rail above the rung and
          # two below, hugging the pole, and two frapping turns round rail and rung together (an oval), slipped down
          # `slack` and looser with age
          if (min($BG, 1) * (1 - $RS) * (1 - $RG) > 0.5) {
            add($LadderLashRope, sd=0, H=$H, W=$W, w=$w, deg=$deg, RW=$RW, GD=$GD, y=$y, zr=$zr, gl=$gl, CRK=$CRK, dvB=$dvB, ERO=$ERO, FOOT=$FOOT, segP=$segP, segG=$segG, A=$A, cr=$cr, WEAR=$WEAR, k=$k, BG=$BG, noise=$noise, join=none)
            add($LadderLashRope, sd=1, H=$H, W=$W, w=$w, deg=$deg, RW=$RW, GD=$GD, y=$y, zr=$zr, gl=$gl, CRK=$CRK, dvB=$dvB, ERO=$ERO, FOOT=$FOOT, segP=$segP, segG=$segG, A=$A, cr=$cr, WEAR=$WEAR, k=$k, BG=$BG, noise=$noise, join=none)
          }
          if (min($BG, 1) * (1 - $RS) * (1 - $RG) < 0.5) {
          $ra = 0.5 * $RW + 0.15 * $SL
          $zc = 0.5 * ($zr + 0.5 * $GD - 0.5 * $RW)
          $rb = 0.5 * ($zr + 0.5 * $GD + 0.5 * $RW) + 0.2 * $SL
          # the game budget keeps one turn below, one above and one frapping turn a side
          $nl = 3 + 3 * min($BG, 1)
          loop (repeat=2 * $nl) {
            $q = output.index - 1
            $sd = floor($q / $nl)
            $tq = ($q - $nl * $sd) * (1 + clamp(1 - $BG, 0, 1))
            $xs = (1 - 2 * $sd) * 0.5 * $w
            $ys = $y - $SL * (1 - 0.4 * $sd)
            $fr = floor($tq / 4)
            $yo = (1 - $fr) * (2 * floor(($tq + 0.5) / 2) - 1) * (0.5 * $GD + 0.6 + 1.1 * ($tq - 2 * floor($tq / 2))) + $fr * 1.1 * ($tq - 4.5)
            add($RingWrap, R=(1 - $fr) * $ra + $fr * $ra, r=0.5, seg=8 + 2 * min($BG, 1) + 2 * clamp($BG - 1, 0, 1), rs=1 + clamp($BG - 1, 0, 1), sx=1 + $fr * ($rb / $ra - 1), at=($xs, $ys + $yo, $fr * $zc), rotate=(0.0, 90.0, 90.0), join=none)
          }
          }
        }
      }
    } else {
      if ($J > 0.5) {
        if ($J < 1.5) {
          add($RingWrap, R=0.5 * $RW + 0.2, r=0.5, seg=8 + 4 * min($BG, 1), rs=1 + min($BG, 1), at=(0.5 * $w, $y - 4.0, 0.0), rotate=(0.0, 90.0, 90.0), join=none)
          add($RingWrap, R=0.5 * $RW + 0.3, r=0.5, seg=8 + 4 * min($BG, 1), rs=1 + min($BG, 1), at=(0.5 * $w, $y - 5.1, 0.0), rotate=(0.0, 90.0, 90.0), join=none)
        }
      } else {
        if (clamp(floor($holes + 0.5), 0, 1) > 0.5) {
          subtract($PoleBlank, r=0.52 * $GD, seg=$segG, scale=(1.0, ($w + $RW + 4.0) / 100.0, 1.0), at=(0.5 * ($w + $RW + 4.0), $y, 0.0), rotate=(0.0, 0.0, 90.0))
        }
      }
    }
  }
}

# ---- THE LADDER'S SQUARE LASHING, ITS PATH DECLARED IN ROPE PATH WORDS (21 Nov 2026, `Docs/GC-SHAPE-DRAPE.md` "PATH
# WORDS"): High and Ultra, round rail and rung. `drape` pulls the path tight onto this crossing's rail and rung exactly as
# LadderFlat builds them (crook, taper, oval, checks), and onto itself ----
# The rail and the rung of one crossing, LadderFlat's own Pole calls (the same knobs, so the same mesh)
LadderRail = mesh(sd=0, H=300.0, W=60.0, deg=0.0, RW=10.0, CRK=1.0, dvB=0.0, A=1.0, ERO=0.0, FOOT=0.0, segP=10, noise=1) {
  add($Pole, r=0.5 * $RW, len=$H, taper=0.14, crook=$CRK, oval=0.1, dv=$dvB, checkd=0.35 + 0.15 * clamp($A - 1.0, 0, 1), ero=$ERO, foot=$FOOT, seg=$segP, noise=$noise, index=1 + $sd, at=((1 - 2 * $sd) * 0.5 * $W, 0.0, 0.0), rotate=(0.0, 0.0, (1 - 2 * $sd) * $deg), join=none)
}
LadderRung = mesh(GD=5.5, gl=80.0, y=30.0, zr=7.0, A=1.0, cr=0.0, dvB=0.0, WEAR=0.0, segG=8, k=0, noise=1) {
  add($Pole, r=0.5 * $GD, len=$gl, taper=0.05, crook=0.15 + 0.25 * $A, oval=0.06, sag=0.2 * $A + 2.0 * $cr, dv=0.8 * $dvB, checkd=0.3, wear=$WEAR, split=0.7 * $cr, seg=$segG, noise=$noise, index=100 + $k, at=(0.5 * $gl, $y, $zr), rotate=(0.0, 0.0, 90.0), join=none)
}
# The lashing's path, in words (the crossing's own rail and rung, read as built): the start laid along the rung under the
# turns, its tail just past the outer turn; `turns` turns, over the rung each side of the rail and under the rail each side
# of the rung, each a rope further out; `frap` frapping turns between them (round the way the turns went); the end under
# the lower band where the frapping ends and laid down the rail's flank. Over is the front (+Z, the side you see); +X is
# outward on the right rail (sd 0), -X on the left (`$s`)
LadderLash = plane(sd=0, H=300.0, W=60.0, w=60.0, deg=0.0, RW=10.0, GD=5.5, y=30.0, zr=7.0, gl=80.0, CRK=1.0, dvB=0.0, ERO=0.0, FOOT=0.0, segP=10, segG=8, A=1.0, cr=0.0, WEAR=0.0, k=0, noise=1, r=0.5, turns=4, frap=2) {
  $s = 1 - 2 * $sd
  at($LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), at=$LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), beside=$s, ring=$turns + 1.2, angle=120, r=$r, off=0.5, hold)
  at($LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), at=$LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), beside=$s, ring=0.6, angle=120, off=0.5, hold)
  loop (repeat=$turns) {
    over($LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), at=$LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), beside=$s, ring=output.index)
    under($LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), at=$LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), beside=1, ring=output.index)
    over($LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), at=$LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), beside=-$s, ring=output.index)
    under($LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), at=$LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), beside=-1, ring=output.index)
  }
  between($LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), $LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), turns=$frap, way=$s)
  at($LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), at=$LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), beside=-1, ring=$turns + 1.0, angle=-62 * $s, off=0.5, hold)
  at($LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), at=$LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise), beside=-1, ring=$turns + 3.0, angle=-62 * $s, off=0.9, hold)
  drape(onto=($LadderRail(sd=$sd, H=$H, W=$W, deg=$deg, RW=$RW, CRK=$CRK, dvB=$dvB, A=$A, ERO=$ERO, FOOT=$FOOT, segP=$segP, noise=$noise), $LadderRung(GD=$GD, gl=$gl, y=$y, zr=$zr, A=$A, cr=$cr, dvB=$dvB, WEAR=$WEAR, segG=$segG, k=$k, noise=$noise)), r=$r, taut, self)
}
# the rope laid along it: High a plain rope (the bound material carries the lay) of 10 sides, stations 2.2 cm apart (under
# 40 deg of turn round the rung: smooth under `shade:40`), ends cut square (`fray` 0.04: no taper, no fibres); Ultra 12
# sides, 1.4 cm, frayed ends and loose fibres. Its length is near the drape's (measured on the ladder's crossings, 386-416
# cm); `follow` stretches it to fit
LadderLashRope = mesh(sd=0, H=300.0, W=60.0, w=60.0, deg=0.0, RW=10.0, GD=5.5, y=30.0, zr=7.0, gl=80.0, CRK=1.0, dvB=0.0, ERO=0.0, FOOT=0.0, segP=10, segG=8, A=1.0, cr=0.0, WEAR=0.0, k=0, BG=1, noise=1) {
  $r = 0.5
  # the drape's length on the photographed crossing (rung 5.5, rail 10) is 411 cm: 26.5 cm a cm of rung and rail
  $Le = 26.5 * ($GD + $RW)
  if ($BG < 1.5) {
    add($Rp.Line, r=$r, len=$Le, strands=0, budget=1, sides=10, sp=2.2, ends=3, fray=0.04, age=$A, noise=$noise, index=200 + 2 * $k + $sd, join=none)
  } else {
    add($Rp.Line, r=$r, len=$Le, strands=0, budget=2, sides=12, sp=1.4, ends=3, age=$A, noise=$noise, index=200 + 2 * $k + $sd, join=none)
  }
  follow(along=$LadderLash(sd=$sd, H=$H, W=$W, w=$w, deg=$deg, RW=$RW, GD=$GD, y=$y, zr=$zr, gl=$gl, CRK=$CRK, dvB=$dvB, ERO=$ERO, FOOT=$FOOT, segP=$segP, segG=$segG, A=$A, cr=$cr, WEAR=$WEAR, k=$k, noise=$noise))
}


LadderPoleLashedGame  = mesh() { add($Ladder, type=0, height=300.0, age=1.2, budget=0, noise=3) }
LadderPoleLashedHigh  = mesh() { add($Ladder, type=0, height=300.0, age=1.2, budget=1, noise=3) }
LadderPoleThroughGame = mesh() { add($Ladder, type=1, height=300.0, age=1.2, budget=0, noise=4) }
LadderPoleThroughHigh = mesh() { add($Ladder, type=1, height=300.0, age=1.2, budget=1, noise=4) }
LadderSawnRoundGame   = mesh() { add($Ladder, type=2, height=300.0, age=1.2, budget=0, noise=5) }
LadderSawnRoundHigh   = mesh() { add($Ladder, type=2, height=300.0, age=1.2, budget=1, noise=5) }

# ==== DEBRIS LINES: what fell through the walkway's hole, what fell out of the wall's hole ==========================
# In the subject's own frame, so the line placed at the subject's transform lies where it fell. Pieces from
# `Debris` (Smashed boards, a Splinters heap, Chips); the debris lane's pieces replace them when they pass.
#   knob       default unit  range         meaning
#   size_x        300 cm     [100..800]    the walkway module it lies under
#   size_y        180 cm     [80..400]     across it
#   damage        0.5 0-1    [0..1]        how much fell
#   age           0.9 0-1    [0..1]        (the pieces' wear: Debris draws its own)
#   noise           1 int                  the walkway's seed (the hole is found the same way)
#   budget          1 0/1/2  [0..2]        tiers
#   pthick          8 cm     [2..20]       the planks' thickness
#   drop           44 cm     [0..500]      the ground below the planks' top
#   hole_xf       0.5 x      [0..1]        as the walkway
#   hvar           25 cm     [0..200]      as the walkway
WalkwayDebris = mesh(size_x=300.0, size_y=180.0, damage=0.5, age=0.9, noise=1, budget=1, pthick=8.0, drop=44.0, hole_xf=0.5, hvar=25.0) {
  $size_xC = clamp($size_x, 100, 800)
  $size_yC = clamp($size_y, 80, 400)
  $damageC = clamp($damage, 0, 1)
  $ageC = clamp($age, 0, 1)
  $noiseC = floor($noise)
  $budgetC = clamp(floor($budget + 0.5), 0, 2)
  $pthickC = clamp($pthick, 2, 20)
  $dropC = clamp($drop, 0, 500)
  $hole_xfC = clamp($hole_xf, 0, 1)
  $hvarC = clamp($hvar, 0, 200)
  $hq0 = sin($noiseC * 1009 * 12.9898 + 901.7) * 43758.5453
  $hq0 = $hq0 - floor($hq0)
  $hq6 = sin($noiseC * 1009 * 12.9898 + 991.9) * 43758.5453
  $hq6 = $hq6 - floor($hq6)
  $hq7 = sin($noiseC * 1009 * 12.9898 + 1003.7) * 43758.5453
  $hq7 = $hq7 - floor($hq7)
  $hx = $hole_xfC * $size_xC + $hvarC * (2 * $hq0 - 1)
  $zg = -$pthickC - $dropC
  add($Deb.Smashed, width=22.0, length=50.0 + 40.0 * $damageC, thick=$pthickC, pieces=5, splits=3, push=3.0 + 4.0 * $damageC, noise=$noiseC + 3, at=($hx - 8.0, 0.5 * $size_yC - 12.0, $zg), rotate=(0.0, 0.0, 70.0 + 40.0 * $hq6))
  if ($damageC > 0.35) {
    add($Deb.Smashed, width=18.0, length=40.0 + 30.0 * $damageC, thick=$pthickC, pieces=4, splits=2, push=3.0, noise=$noiseC + 9, at=($hx + 22.0, 0.5 * $size_yC + 20.0, $zg), rotate=(0.0, 0.0, 100.0 + 50.0 * $hq7), join=none)
  }
  add($Deb.Splinters, count=floor(6 + 8 * $damageC), chips=floor(6 + 10 * $damageC), area=40.0 + 30.0 * $damageC, noise=$noiseC + 5, at=($hx + 10.0, 0.5 * $size_yC - 30.0, $zg), join=none)
}

#   knob       default unit  range         meaning (the wall's debris)
#   size_x        200 cm     [60..600]     the wall module it lies in front of
#   height        240 cm     [60..500]     the wall's height
#   damage        0.5 0-1    [0..1]        how much fell
#   age             1 0-2    [0..2]        (the pieces' wear: Debris draws its own)
#   noise           1 int                  the seed
#   budget          1 0/1/2  [0..2]        tiers
#   bthick        2.5 cm     [0.8..10]     the boards' thickness
#   hxf         0.575 x      [0..1]        as the wall
BoardWallDebris = mesh(size_x=200.0, height=240.0, damage=0.5, age=1.0, noise=1, budget=1, bthick=2.5, hxf=0.575) {
  $size_xC = clamp($size_x, 60, 600)
  $heightC = clamp($height, 60, 500)
  $damageC = clamp($damage, 0, 1)
  $ageC = clamp($age, 0, 2)
  $noiseC = floor($noise)
  $budgetC = clamp(floor($budget + 0.5), 0, 2)
  $bthickC = clamp($bthick, 0.8, 10)
  $hxfC = clamp($hxf, 0, 1)
  $wq2 = sin($noiseC * 1009 * 12.9898 + 1531.1) * 43758.5453
  $wq2 = $wq2 - floor($wq2)
  $wq3 = sin($noiseC * 1009 * 12.9898 + 1543.7) * 43758.5453
  $wq3 = $wq3 - floor($wq3)
  $hx = $hxfC * $size_xC
  add($Deb.Smashed, width=24.0, length=50.0 + 50.0 * $damageC, thick=$bthickC, pieces=5, splits=3, push=3.0 + 3.0 * $damageC, noise=$noiseC + 3, at=($hx - 10.0, -38.0, 0.0), rotate=(0.0, 0.0, 15.0 + 50.0 * $wq2))
  add($Deb.Splinters, count=floor(6 + 8 * $damageC), chips=floor(6 + 10 * $damageC), area=40.0 + 20.0 * $damageC, noise=$noiseC + 5, at=($hx + 25.0, -30.0, 0.0), join=none)
  if ($damageC > 0.35) {
    add($Deb.Smashed, width=20.0, length=40.0, thick=$bthickC, pieces=3, splits=2, push=2.0, noise=$noiseC + 11, at=($hx + 50.0, -55.0, 0.0), rotate=(0.0, 0.0, -20.0 + 40.0 * $wq3), join=none)
  }
}

# ---- the states and tiers (kit §2.0.1, §12.1): a state is a table of the top-level knobs
AgedBoardHigh              = mesh() { add($AgedBoard, noise=3, index=2, budget=1) }
AgedBoardGame              = mesh() { add($AgedBoard, noise=3, index=2, budget=0) }
WalkwayAgedHigh            = mesh() { add($Walkway, damage=0.0, age=1.0, noise=6, budget=1) }
WalkwayAgedGame            = mesh() { add($Walkway, damage=0.0, age=1.0, noise=6, budget=0) }
WalkwayDecayedHigh         = mesh() { add($Walkway, damage=0.0, age=1.8, noise=6, budget=1) }
WalkwayDecayedGame         = mesh() { add($Walkway, damage=0.0, age=1.8, noise=6, budget=0) }
WalkwayBrokenHigh          = mesh() { add($Walkway, damage=0.5, age=1.8, noise=6, budget=1) }
WalkwayBrokenGame          = mesh() { add($Walkway, damage=0.5, age=1.8, noise=6, budget=0) }
WalkwayBrokenDebrisHigh    = mesh() { add($WalkwayDebris, damage=0.5, age=1.8, noise=6, budget=1) }
WalkwayBrokenDebrisGame    = mesh() { add($WalkwayDebris, damage=0.5, age=1.8, noise=6, budget=0) }
BoardWallAgedHigh          = mesh() { add($BoardWall, damage=0.0, age=1.0, noise=6, budget=1) }
BoardWallAgedGame          = mesh() { add($BoardWall, damage=0.0, age=1.0, noise=6, budget=0) }
BoardWallSnappedHigh       = mesh() { add($BoardWall, damage=0.5, age=1.0, mode=0, noise=6, budget=1) }
BoardWallSnappedGame       = mesh() { add($BoardWall, damage=0.5, age=1.0, mode=0, noise=6, budget=0) }
BoardWallHoledHigh         = mesh() { add($BoardWall, damage=0.5, age=1.0, mode=1, noise=6, budget=1) }
BoardWallHoledGame         = mesh() { add($BoardWall, damage=0.5, age=1.0, mode=1, noise=6, budget=0) }
BoardWallHoledDebrisHigh   = mesh() { add($BoardWallDebris, damage=0.5, age=1.0, noise=6, budget=1) }
BoardWallHoledDebrisGame   = mesh() { add($BoardWallDebris, damage=0.5, age=1.0, noise=6, budget=0) }

# ==== HOUSE WALL (owner 20 Nov 2026: "wooden house wall ... aged and weathered and also new one? ... a slider for how aged
# it is"; plan `Docs/GC-SHAPE-WOOD-HOUSE-WALL.md`, research `Docs/Research/wooden-house-walls.md`) ==========================
#
# ONE wall module, its construction a setting and its age ONE slider: `age` 0 new (straight, tight, crisp), 1 aged (joints
# opened by shrinkage, boards cupped and bowed, end checks, a few nails proud, a slight lean), 2 weathered (deep checks,
# eroded grain, split, loose and missing boards, a rotten foot, the frame leaning and sagging). Every board is the kit's
# `AgedBoard`; decay is clustered at the foot, the module's ends and the joints, never spread as noise.
#
#   Kit  = shape('/GraphCodeShape/Presets/TimberKit', Face = $Wood, Broken = $WoodTorn)
#   Barn = mesh() { add($Kit.HouseWall, type=0, size_x=300.0, height=240.0, age=1.6, noise=3) }
#   Gate = mesh() { add($Kit.HouseWall, type=3, size_x=360.0, height=230.0, age=1.3) }
#
# The frame: the wall runs along +X from x = 0 to size_x, stands on z = 0 up to height, and FACES -Y (the boards' faces
# toward -Y, the framing behind them at y >= 0). Modules placed end to end along X tile. Every knob is clamped to its range.
# A knob whose default is -1 is DERIVED (from `type`, `age` or `damage`, as its line says); any value 0 or above overrides
# it. Defaults are the values measured on the photographs (Docs/GC-SHAPE-WOOD-HOUSE-WALL.md §2, photo numbers in brackets).
#   knob       default unit  range         meaning
#   type            0 0-3    [0..3]        construction: 0 board-and-batten (vertical boards on girts, a batten over every
#                                          joint), 1 clapboard (horizontal lap boards on studs), 2 shiplap (flush horizontal
#                                          boards with a rebated joint), 3 East Asian post-and-plank (square posts on a sill,
#                                          a head beam, a through rail, boards infilling each bay: the owner's gate)
#   size_x        300 cm     [60..600]     the module along the wall
#   height        240 cm     [60..500]     the wall's height
#   age             1 0-2    [0..2]        THE SLIDER: 0 new, 1 aged, 2 weathered; every -1 knob below follows it
#   damage         -1 0-1    [-1..1]       how broken (missing, split, loose boards, a rotten foot, battens off);
#                                          -1: 0.7 x (age - 1) above age 1, 0 below
#   softness        0 0-1    [0..1]        0 crisp (hard breaks, the default); 1 worn round (driftwood): AgedBoard's
#                                          rounding, domed ends, soft ridges, and edges waving 4x as far; at 1 the
#                                          ridges x0.3, crumbs x0.25, slivers 0, torn corners x0.4, a third of the
#                                          checks, x0.6 deep,
#                                          arris wear x4
#   noise           1 int                  the seed; every member draws noise * 1009 + its index
#   budget          1 0/1/2  [0..2]        0 Game (chamfered arrises, 2 segments, the decayed top 9 columns), 1 High, 2 Ultra
#   board_w        -1 cm     [4..60]       board width (lap types: the whole board); -1: 24 / 17.5 / 18.4 / 15 by type
#   board_t        -1 cm     [0.8..10]     board thickness (clapboard: its butt); -1: 1.9 / 1.4 / 1.9 / 3 by type
#   gap            -1 cm     [0..10]       the joint as built (age 0); -1: 1.3 under a batten (0.3 without) / 0.05 / 0.6 (the 6 mm "nickel gap") / 0.5 (the gate's joint lines) by type
#   lap            -1 cm     [0..15]       clapboard lap, shiplap rebate, plank tongue; -1: 0 / 3 / 2.5 / 1.5 by type
#   foot            0 cm     [0..60]       clearance from z = 0 to the boards' foot (the framing still reaches z = 0)
#   bottom          1 cm     [0..10]       type 0: each board's foot raised its own amount, up to this at age 1 (x3 at 2)
#   shrink          6 %      [0..15]       how far each joint opens at age 2, % of the board width (2 % at age 1, research's 2-5 mm a joint);
#                                          each joint its own 0.3-1.7 x
#   battens         1 0/1    [0..1]        type 0: the battens (0 plain vertical boards, a barn wall)
#   batten_w      6.4 cm     [2..15]       batten width
#   batten_t      1.9 cm     [0.8..5]      batten thickness
#   girt_p         60 cm     [30..150]     type 0: girt spacing (girts 9 x 4.5 behind the boards)
#   stud_p       40.6 cm     [25..120]     types 1, 2: stud spacing (studs 3.8 x 8.9, a sole and a top plate)
#   post_p        180 cm     [60..400]     type 3: post spacing (the bay)
#   post_w         11 cm     [6..30]       type 3: post size (square)
#   sill_h         12 cm     [0..40]       type 3: the sill beam's height (0: no sill)
#   head_h         18 cm     [0..60]       type 3: the head beam's height (0: none)
#   rail            1 0/1    [0..1]        type 3: the through rail (nuki) across the bay's face
#   rail_z       0.33 x      [0.05..0.95]  type 3: its height, x the bay's clear height
#   infill          0 0/1    [0..1]        type 3: 0 vertical boards (the gate), 1 horizontal planks (dropped into grooved posts)
#   missing        -1 share  [0..0.6]      boards gone (toward the module's ends and the foot, clustered); -1: 0.09 x damage
#   rot            -1 cm     [0..120]      the rotten foot: boards eaten back this high at most, ragged, clustered;
#                                          horizontal types lose and drop their lowest courses; -1: 50 x damage
#   split          -1 share  [0..0.6]      boards split through along the grain (two pieces, a crack); -1: 0.1 x damage
#   loose          -1 share  [0..1]        boards with a sprung end (vertical: the foot; horizontal: one hanging off a nail);
#                                          -1: 0.25 x damage
#   lift           -1 cm     [0..15]       how far a loose end springs; -1: 1 + 3 x damage
#   battoff        -1 share  [0..1]        type 0: battens gone (and half of those beside a missing board); -1: 0.35 x damage
#   nails          -1 share  [0..1]        nails standing proud; -1: 0.05 at age 1, 0.25 at age 2
#   proud          -1 cm     [0..1.5]      how far; -1: 0.15 at age 1, 0.5 at age 2
#   lean           -1 %      [0..4]        the frame racked: the top moves +X this % of the height; -1: 0.35 at age 1, 1 at 2
#   sag            -1 cm     [0..15]       the top line sags mid-module; -1: 0.6 at age 1, 2 at age 2
#   decay          -1 0-1    [-1..1]       the boards' weathering (AgedBoard's decay: eroded ridges along the grain, open
#                                          checks, crumbled ends, slivers, missing corners, thinner); -1: (age - 0.5) / 1.5 (a third at age 1)
#   wvar           -1 x      [0..0.4]      board width +- this; -1: 0.15 x age / 2 (new boards are milled equal)
#   cup            -1 cm     [0..4]        cup at age 1 (x3 at age 2), toward the bark side; -1: 1.5 % of board_w (research 0.5-1.5 %)
#   bow            -1 cm     [0..15]       bow at age 1, out of the wall (x3 at 2); -1: length / 1600 (a board nailed at
#                                          every girt or stud bows only between them)
#   crook          -1 cm     [0..10]       crook at age 1, in the wall's plane (x3 at 2); -1: length / 3200 (horizontal / 4800)
#   roll          0.6 deg    [0..10]       a board turned about its length (one edge proud), at age 1
#   twist           1 deg    [0..20]       twist at age 1 (horizontal boards 0.4 x)
#   yaw          0.02 deg    [0..3]        lean in the wall's plane at age 1
#   taper       0.015 x      [0..0.3]      width along a board
#   waney         0.3 cm     [0..5]        a non-straight edge at age 1 (x3 at 2, 0 when new; x(1 + 3 softness))
#   ttaper       0.06 x      [0..0.5]      thickness along a board
#   endsq         1.5 deg    [0..12]       ends off square (x min(age, 1))
#   wear          0.1 cm     [0..4]        arrises worn at age 1 (x3 at 2, at most 6 mm; hard; posts, beams, girts 0.3 x); a sawn
#                                          arris of 1.2 mm on top, so a new wall's joints read
#   state        0.35 x      [0..1]        each board its own condition
#   ridge        0.15 cm     [0..2]        decay: the grain eroded to ridges this deep
#   checks          3 count  [0..4]        decay: open checks along the grain
#   checkd        0.5 x      [0..0.9]      decay: a check this share of the thickness deep
#   crumb           4 cm     [0..20]       decay: ends crumbled back
#   sliver        0.4 share  [0..1]        decay: a sliver split off an edge
#   corner        0.4 share  [0..1]        decay: a corner missing
#   thin         0.15 x      [0..0.6]      decay: thinner
#   tile          100 cm     [10..1000]    grain UV tile
#   aspect          1 x      [0.1..10]     grain tile aspect
# Slots: `Face` (every board, batten, post and nail) and `Broken` (the rotten feet's torn faces); pathless, bind them.
HwPick = formula(v, d) { $d + clamp(ceil($v + 0.5), 0, 1) * ($v - $d) }
HwIs   = formula(t, k) { clamp(1 - abs($t - $k), 0, 1) }
# 1 when a joint at x would sit within 1.5 studs of the course below's, or on the stud of the two below that
HwConf = formula(x, a, b, c, s) { max(clamp(ceil(1.5 * $s - abs($x - $a)), 0, 1), max(clamp(ceil(1 - abs($x - $b)), 0, 1), clamp(ceil(1 - abs($x - $c)), 0, 1))) }
HwHash = formula(s, c) { sin($s * 12.9898 + $c) * 43758.5453 - floor(sin($s * 12.9898 + $c) * 43758.5453) }

# HwVRun (a HouseWall part): a run of vertical boards across [0, span] with their back faces near y = 0, from z = 0 up to
# len; optional battens over the joints (bat 1) and proud nails at the girt heights (ng girts from gz0, gdz apart). The
# wall-level values arrive already resolved (HouseWall works them out); wx, x0 place the run in the wall for the clusters.
HwVRun = mesh(span=300.0, len=240.0, bot=0.0, n0=0, A=1.0, S=0.0, N=1, B=1, BW=24.0, BT=1.9, GP=1.3, SHR=0.0, WV=0.0, DEC=0.0, MS=0.0, RT=0.0, SP=0.0, LS=0.0, LH=2.0, NP=0.0, PR=0.0, ng=0, gz0=20.0, gdz=60.0, bat=0, btw=6.4, btt=1.9, BO=0.0, wx=300.0, x0=0.0, cup=0.24, bow=0.4, crook=0.15, roll=0.4, twist=1.0, yaw=0.05, taper=0.03, waney=0.3, ttaper=0.06, endsq=0.0, wear=0.2, state=0.35, ridge=0.35, checks=3, checkd=0.5, crumb=4.0, sliver=0.4, corner=0.4, thin=0.15, tile=100.0, aspect=1.0) {
  $agf = min($A, 1) + 2 * max($A - 1, 0)
  $MF = $agf * (1 + $state)
  $tv = 0.06 * min($A, 1)
  # AgedBoard's age is at least 0.1, so a new board still has a sawn arris of about 1.2 mm (its other age-1 knobs x0.1
  # are below a millimetre); the wear passed makes the arris 0.12 + wear x (0/1/3) cm
  $AE = max($A, 0.1)
  $agfe = min($AE, 1) + 2 * max($AE - 1, 0)
  $WE = (0.12 + $wear * $agf) / $agfe
  # an edge's wave grows with age (0 on a new board); AgedBoard takes it as it is
  $wny = $waney * $agf * (1 + 3 * $S)
  # the room each board's bend takes sideways (crook, yaw, taper, a waney edge), added to its joint
  $E = $agf * (2 * $crook + 0.5 * $len * tan($yaw) + 0.125 * $BW * $taper) + 0.5 * $wny
  $n = 0
  $cum = 0.0
  $SW = 0.0
  $stop = 0
  loop (repeat=floor($span / (0.6 * $BW)) + 2) {
    $i = output.index - 1
    $K = $N * 1009 + $n0 + $i
    $wr[$i] = $BW * (1 + $WV * (2 * $HwHash($K, 11.3) - 1))
    $fit = clamp(ceil($span - $cum - 0.5 * $wr[$i]), 0, 1) * (1 - $stop)
    $stop = max($stop, 1 - $fit)
    $n = $n + $fit
    $SW = $SW + $fit * $wr[$i]
    $cum = $cum + $fit * ($wr[$i] + $GP + $E)
  }
  $n = max($n, 1)
  $SW = max($SW, $wr[0])
  $sc = max($span - $n * ($GP + $E), 0.3 * $span) / $SW
  $zf = 0.6 * $MF * ($cup + $bow) + 0.5 * $BW * sin($MF * ($roll + 0.5 * $twist)) + 0.05
  # a batten rests on the boards' most forward point (their cupped edges and bow), so it never sinks into them
  $yb = -($zf + $BT + 0.7 * $MF * $cup + $MF * $bow) + 0.1
  $xc = 0.0
  loop (repeat=$n) {
    $i = output.index - 1
    $K = $N * 1009 + $n0 + $i
    $w = $wr[$i] * $sc
    $x = $xc + 0.5 * ($GP + $E) + 0.5 * $w
    $xc = $xc + $w + $GP + $E
    $xj[$i] = $xc
    $wb = $w * (1 - $SHR * (0.3 + 1.4 * $HwHash($K, 23.9)))
    $xw = $x0 + $x
    $clu = 0.5 + 0.5 * sin(360 * 1.7 * $xw / $wx + 360 * $HwHash($N, 5.1))
    $edg = clamp(1 - min($xw, $wx - $xw) / 60, 0, 1)
    $gone = clamp(ceil($MS * (0.3 + 1.4 * $clu + 0.3 * $edg) - $HwHash($K, 31.7)), 0, 1)
    $gn[$i] = $gone
    $rt = $RT * (0.3 + 0.7 * $clu) * (0.5 + 0.5 * $HwHash($K, 37.1)) * clamp(ceil(0.05 + 0.5 * $clu * $clu + 0.4 * $edg - $HwHash($K, 41.3)), 0, 1)
    $spl = clamp(ceil($SP - $HwHash($K, 43.9)), 0, 1)
    $lse = clamp(ceil($LS * (0.5 + $clu) - $HwHash($K, 47.3)), 0, 1)
    $cl = $lse * $LH * (0.5 + 0.5 * $HwHash($K, 53.1))
    # each board's foot its own height (photo 10: feet uneven by a few cm at age 2)
    $bz = $bot * $agf * $HwHash($K, 87.7)
    $zb = 0.6 * $MF * ($cup + $bow + 0.05) + 0.5 * $wb * sin($MF * ($roll + 0.5 * $twist)) + 0.05
    if ($gone < 0.5) {
      if ($rt > 1.5) {
        $Lr = $len - $rt
        $rx = 0.2 + 0.35 * $HwHash($K, 59.3)
        add($AgedBoard, width=$wb, thick=$BT, length=$Lr, damage=0.5, base=$Lr - $rx * $wb, reach=$rx, tear=0.3, style=1 + 2 * floor(2 * $HwHash($K, 61.7)), age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + $i, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=$roll, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=min($DEC + 0.3, 1), ridge=$ridge, checks=$checks, checkd=$checkd, crumb=$crumb, sliver=$sliver, corner=$corner, thin=$thin, tile=$tile, aspect=$aspect, at=($x, -$zb, $len), rotate=(90.0, 0.0, 180.0), join=none)
      } else {
        if ($spl > 0.5) {
          $f = 0.35 + 0.3 * $HwHash($K, 67.1)
          $ck = 0.4 + 1.0 * $HwHash($K, 71.3)
          $wl = $f * $wb - 0.5 * $ck
          $wr2 = (1 - $f) * $wb - 0.5 * $ck
          add($AgedBoard, width=$wl, thick=$BT, length=$len - $bz, damage=0.0, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + $i, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=$roll, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=$DEC, ridge=$ridge, checks=$checks, checkd=$checkd, crumb=$crumb, sliver=$sliver, corner=$corner, thin=$thin, tile=$tile, aspect=$aspect, at=($x - 0.5 * $wb + 0.5 * $wl, -$zb, $bz), rotate=(-90.0, 0.0, 0.0), join=none)
          add($AgedBoard, width=$wr2, thick=$BT, length=$len - $bz, damage=0.0, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + $i + 700, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=2 * $roll, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=$DEC, ridge=$ridge, checks=$checks, checkd=$checkd, crumb=$crumb, sliver=$sliver, corner=$corner, thin=$thin, curl=$cl + 1.0, curlf=0.6, curls=1, tile=$tile, aspect=$aspect, at=($x + 0.5 * $wb - 0.5 * $wr2, -$zb - 0.2, $bz), rotate=(-90.0, 0.0, 0.0), join=none)
        } else {
          add($AgedBoard, width=$wb, thick=$BT, length=$len - $bz, damage=0.0, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + $i, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=$roll, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=$DEC, ridge=$ridge, checks=$checks, checkd=$checkd, crumb=$crumb, sliver=$sliver, corner=$corner, thin=$thin, curl=$cl, curlf=0.55, curls=1, tile=$tile, aspect=$aspect, at=($x, -$zb, $bz), rotate=(-90.0, 0.0, 0.0), join=none)
        }
      }
      if ($ng > 0.5) {
        loop (repeat=$ng) {
          $g = output.index - 1
          $KN = $K * 31 + $g
          if ($NP - $HwHash($KN, 79.1) > 0) {
            add($Nail, up=$PR * (0.5 + $HwHash($KN, 83.3)), at=($x - 3.5 + 7 * floor(2 * $HwHash($KN, 89.9)), -$zb - $BT, $gz0 + $g * $gdz), rotate=(-90.0, 0.0, 0.0), join=none)
          }
        }
      }
    }
  }
  # the battens: one over every joint between two boards, nailed through to the girts; they go first (battoff), and
  # mostly where a board beside them is gone
  if ($bat * clamp(ceil($n - 1.5), 0, 1) > 0.5) {
    loop (repeat=$n - 1) {
      $j = output.index - 1
      $KB = $N * 1009 + $n0 + 300 + $j
      $xb = $xj[$j]
      $xw = $x0 + $xb
      $clu = 0.5 + 0.5 * sin(360 * 1.7 * $xw / $wx + 360 * $HwHash($N, 5.1))
      $off = clamp(ceil($BO * (0.5 + $clu) - $HwHash($KB, 97.3)), 0, 1)
      $off = max($off, max($gn[$j], $gn[$j + 1]) * clamp(ceil(0.5 - $HwHash($KB, 101.9)), 0, 1))
      $bz0 = 0.5 + $RT * 0.6 * (0.3 + 0.7 * $clu) * $HwHash($KB, 103.7)
      $bl = $len - $bz0 - 0.5
      $lb = clamp(ceil($BO * 0.6 - $HwHash($KB, 107.1)), 0, 1) * (1.0 + 2.5 * $HwHash($KB, 109.3))
      if ($off < 0.5) {
        add($AgedBoard, width=$btw, thick=$btt, length=$bl, damage=0.0, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 300 + $j, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.0, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.5 * $roll, lift=0.0, cup=0.0, bow=0.5 * $bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=$DEC, ridge=$ridge, checks=2, checkd=$checkd, crumb=$crumb, sliver=$sliver, corner=$corner, thin=$thin, curl=$lb, curlf=0.6, curls=floor(2 * $HwHash($KB, 113.9)), tile=$tile, aspect=$aspect, at=($xb, $yb, $bz0), rotate=(-90.0, 0.0, 0.0), join=none)
        if ($ng > 0.5) {
          loop (repeat=$ng) {
            $g = output.index - 1
            $KN = $KB * 37 + $g
            if ($NP - $HwHash($KN, 79.1) > 0) {
              add($Nail, up=$PR * (0.5 + $HwHash($KN, 83.3)), at=($xb, $yb - $btt, $gz0 + $g * $gdz), rotate=(-90.0, 0.0, 0.0), join=none)
            }
          }
        }
      }
    }
  }
}

# HwHRun (a HouseWall part): horizontal courses across [0, span] filling z 0 to hgt, back faces near y = 0.
#   mode 1 lap (clapboard: each board tilted so its butt stands on the course below, a starter strip at the foot),
#   mode 2 flush (shiplap: the rebate shows as a strip behind each joint), mode 3 infill (tongued planks in a bay, their
#   ends running 1.5 cm into the posts' grooves, no butt joints). sp: the stud pitch (butt joints and nails fall on studs).
HwHRun = mesh(mode=1, span=300.0, hgt=240.0, n0=0, A=1.0, S=0.0, N=1, B=1, BW=17.5, BT=1.4, GP=0.05, LP=3.0, SHR=0.0, DEC=0.0, MS=0.0, RT=0.0, SP=0.0, LS=0.0, NP=0.0, PR=0.0, sp=40.6, wx=300.0, x0=0.0, cup=0.18, bow=0.5, crook=0.2, roll=0.4, twist=1.0, yaw=0.05, taper=0.03, waney=0.3, ttaper=0.06, endsq=0.0, wear=0.2, state=0.35, ridge=0.35, checks=3, checkd=0.5, crumb=4.0, sliver=0.4, corner=0.4, thin=0.15, tile=100.0, aspect=1.0) {
  $agf = min($A, 1) + 2 * max($A - 1, 0)
  $MF = $agf * (1 + $state)
  $tv = 0.06 * min($A, 1)
  $AE = max($A, 0.1)
  $agfe = min($AE, 1) + 2 * max($AE - 1, 0)
  $WE = (0.12 + $wear * $agf) / $agfe
  $wny = $waney * $agf * (1 + 3 * $S)
  $lap = clamp(1 - abs($mode - 1), 0, 1)
  $Ex = max($BW - $LP, 2.0)
  # lap: courses of exposure Ee fit exactly; flush and infill: courses of pitch Pe fit exactly
  $nC = max(1, floor(($hgt - $lap * $LP) / $Ex + 0.5))
  $Pe = ($hgt - $lap * $LP) / $nC
  $tilt = $lap * atan(min($BT / $Pe, 0.5))
  $bg = 0.05 + 0.15 * min($A, 1) + 0.25 * max($A - 1, 0)
  $ins = clamp(1 - abs($mode - 3), 0, 1)
  $hung = 0
  $pj = -999.0
  $pj2 = -999.0
  $pj3 = -999.0
  $hxc = -999.0
  if ($lap > 0.5) {
    add($AgedBoard, width=4.0, thick=$Pe * sin($tilt) + 0.2, length=$span, damage=0.0, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 990, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.0, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.0, twist=0.0, endsq=0.0, wear=$WE, decay=$DEC, tile=$tile, aspect=$aspect, at=(0.0, 0.0, 2.0), rotate=(0.0, -90.0, -90.0), join=none)
  }
  loop (repeat=$nC) {
    $k = output.index - 1
    $KC = $N * 1009 + $n0 + 40 * $k
    $zb0 = $k * $Pe
    # the hole left in the course below (-999 none): this course's hole, if any, steps off it (staggered, not stacked)
    $hxp = $hxc
    $hxc = -999.0
    $gc = 0
    $hb = $Pe - $GP - $SHR * $Pe * (0.3 + 1.4 * $HwHash($KC, 13.7)) - 2 * $MF * $crook * (1 - $lap)
    $W = $lap * $BW + (1 - $lap) * $hb
    $zc = $zb0 + $lap * (0.5 * $W * cos($tilt)) + (1 - $lap) * (0.5 * $Pe)
    $yc = -$lap * 0.5 * $W * sin($tilt)
    $foot = clamp(ceil($RT - $zb0 - $W), 0, 1)
    # one butt joint in about half the courses, on a stud (lap and flush; none in a bay)
    $hasj = (1 - $ins) * clamp(ceil(0.55 - $HwHash($KC, 17.9)), 0, 1) * clamp(ceil($span - 150), 0, 1)
    # its stud drawn at random (never a push to the next stud: that stepped the joints up the wall in a staircase);
    # redrawn up to three times while it would sit near the course below's joint or on the stud of the two below that
    $nst = max(floor($span / $sp) - 1, 1)
    $xjn = $sp * (1 + floor($nst * $HwHash($KC, 19.3)))
    if ($HwConf($xjn, $pj, $pj2, $pj3, $sp) > 0.5) {
      $xjn = $sp * (1 + floor($nst * $HwHash($KC, 21.1)))
    }
    if ($HwConf($xjn, $pj, $pj2, $pj3, $sp) > 0.5) {
      $xjn = $sp * (1 + floor($nst * $HwHash($KC, 25.7)))
    }
    if ($HwConf($xjn, $pj, $pj2, $pj3, $sp) > 0.5) {
      $xjn = $sp * (1 + floor($nst * $HwHash($KC, 27.3)))
    }
    if ($HwConf($xjn, $pj, $pj2, $pj3, $sp) > 0.5) {
      $xjn = $xjn + 3 * $sp
      if ($xjn > $nst * $sp + 1) {
        $xjn = $xjn - $nst * $sp
      }
    }
    $xjn = clamp($xjn, min($sp, 0.5 * $span), max($span - $sp, 0.5 * $span))
    $pj3 = $hasj * $pj2 + (1 - $hasj) * $pj3
    $pj2 = $hasj * $pj + (1 - $hasj) * $pj2
    $pj = $hasj * $xjn + (1 - $hasj) * $pj
    # a second joint in about a third of the long courses, two to four studs from the first: boards of uneven length
    $has2 = $hasj * clamp(ceil(0.35 - $HwHash($KC, 23.3)), 0, 1) * clamp(ceil($span - 260), 0, 1)
    $xj2 = $xjn + $sp * (2 + floor(3 * $HwHash($KC, 29.9))) * (1 - 2 * clamp(ceil($xjn - 0.5 * $span), 0, 1))
    $has2 = $has2 * clamp(ceil($xj2 - $sp + 0.5), 0, 1) * clamp(ceil($span - $sp - $xj2 + 0.5), 0, 1) * (1 - $HwConf($xj2, $pj2, $pj3, $pj3, $sp))
    $ja = $xjn * (1 - $has2) + $has2 * min($xjn, $xj2)
    $jb = $has2 * max($xjn, $xj2)
    $np = 1 + $hasj + $has2
    loop (repeat=$np) {
      $p = output.index - 1
      $K = $KC + $p
      $e0 = $HwIs($p, 0)
      $e1 = $HwIs($p, 1)
      $e2 = $HwIs($p, 2)
      $last = $HwIs($p, $np - 1)
      $xs = $e0 * (-$ins * 1.5) + $e1 * ($ja + 0.5 * $bg) + $e2 * ($jb + 0.5 * $bg)
      $xe = $last * ($span + $ins * 1.5) + (1 - $last) * ($e0 * ($ja - 0.5 * $bg) + $e1 * ($jb - 0.5 * $bg))
      $L = max($xe - $xs, 5.0)
      $xm = $x0 + 0.5 * ($xs + $xe)
      $clu = 0.5 + 0.5 * sin(360 * 1.3 * $xm / $wx + 360 * $HwHash($N, 7.7))
      $edg = clamp(1 - min($xm, $wx - $xm) / 80, 0, 1)
      $fz = clamp(1 - $zb0 / max(3 * $Pe, 1), 0, 1)
      $gone = clamp(ceil($MS * (0.05 + 0.4 * $clu * $clu + 1.5 * $fz + 0.3 * $edg) - $HwHash($K, 31.7)), 0, 1)
      $gone = max($gone, $foot * clamp(ceil(0.1 + 0.4 * $clu - $HwHash($K, 37.3)), 0, 1))
      $near = clamp(ceil($hxp - $xs), 0, 1) * clamp(ceil($xe - $hxp), 0, 1)
      $gone = max($gone, $near * clamp(ceil(0.45 * min($MS / 0.06, 1) - $HwHash($K, 33.1)), 0, 1))
      # one hole per course: two in one course read as a row of slots
      $gone = $gone * (1 - $gc) * (1 - $HwIs($k, 1 + floor(3 * $HwHash($N + $n0, 44.4))) * clamp(ceil($span * (0.1 + 0.8 * $HwHash($N + $n0, 46.6)) - $xs), 0, 1) * clamp(ceil($xe - $span * (0.1 + 0.8 * $HwHash($N + $n0, 46.6))), 0, 1) * clamp(ceil($LS - 0.001), 0, 1))
      $gc = max($gc, $gone)
      # one board hangs off a nail in a course just above the foot (never the bottom one: no room to swing), at a place
      # drawn from the wall's seed, not the first piece reached (that put every wall's hanging board at the same end)
      $kh = 1 + floor(3 * $HwHash($N + $n0, 44.4))
      $xh = $span * (0.1 + 0.8 * $HwHash($N + $n0, 46.6))
      $hang = (1 - $gone) * (1 - $ins) * (1 - $hung) * $HwIs($k, $kh) * clamp(ceil($xh - $xs), 0, 1) * clamp(ceil($xe - $xh), 0, 1) * clamp(ceil($LS - 0.001), 0, 1)
      $hang = $hang * (1 - $gc)
      $gc = max($gc, $hang)
      $hung = max($hung, $hang)
      $dk = min($DEC + 0.5 * $foot, 1)
      $zbk = 0.6 * $MF * ($cup + $bow + 0.05) + 0.5 * $W * sin($MF * ($roll + 0.5 * $twist)) + 0.05
      $stub = $gone * (1 - $ins)
      if ($stub > 0.5) {
        $sl = 1
        $sr = 1
        # a lost board is a broken-OUT length G (2.5-6.5 board widths, longer at the foot) somewhere along the board,
        # never the whole board: both nailed ends stay as stubs of uneven length with torn ends facing the hole
        $G0 = $W * (2.5 + 4 * $HwHash($K, 57.1)) + $foot * $W * 3 * $HwHash($K, 61.3)
        $G = min($G0, max($L - 16, 0.6 * $L))
        $hlo = $xs + 8 + 0.5 * $G
        $hhi = max($xe - 8 - 0.5 * $G, $hlo)
        $hc = $near * clamp($hxp + ($HwHash($K, 73.3) - 0.5) * 0.9 * $G, $hlo, $hhi) + (1 - $near) * ($hlo + ($hhi - $hlo) * $HwHash($K, 67.7))
        $hxc = $hc
        $Ls = $hc - 0.5 * $G - $xs
        $Lr = max($xe - $hc - 0.5 * $G, 8)
        $rxs = min(0.4 + 0.8 * $HwHash($K, 59.9), 0.4 * $G / $W)
        $rxr = min(0.3 + 0.8 * $HwHash($K, 71.9), 0.4 * $G / $W)
        if ($sl > 0.5) {
  add($AgedBoard, width=$W, thick=$BT, length=$Ls + $rxs * $W, damage=0.6, base=$Ls, reach=$rxs, style=-1, tk=3, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 40 * $k + $p, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=0.0, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=min($DEC + 0.3, 1), ridge=$ridge, checks=$checks, checkd=$checkd, crumb=0.4 * $crumb, sliver=$sliver, corner=$corner, thin=$thin, tile=$tile, aspect=$aspect, at=($xs, $yc - $zbk * (1 - 0.6 * $lap), $zc), rotate=(0.0, -90.0 + $tilt, -90.0), join=none)
        }
        if ($sr > 0.5) {
  add($AgedBoard, width=$W, thick=$BT, length=$Lr + $rxr * $W, damage=0.6, base=$Lr, reach=$rxr, style=-1, tk=5, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 40 * $k + $p + 500, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=0.0, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=min($DEC + 0.3, 1), ridge=$ridge, checks=$checks, checkd=$checkd, crumb=0.4 * $crumb, sliver=$sliver, corner=$corner, thin=$thin, tile=$tile, aspect=$aspect, at=($xe, $yc - $zbk * (1 - 0.6 * $lap), $zc), rotate=(0.0, 90.0 - $tilt, 90.0), join=none)
        }
      }
      if ($gone < 0.5) {
        if ($hang > 0.5) {
          # a hanging board is the length that broke off around the seed's place, swung down on its one nail at its -X
          # end; both other lengths stay nailed, their torn ends facing it (a 3 m board never swings whole)
          $Lh = min($L, 45 + 75 * $HwHash($K, 49.3))
          $rxh = 0.3 + 0.6 * $HwHash($K, 51.7)
          $rxm = 0.3 + 0.6 * $HwHash($K, 53.9)
          $rxl = 0.3 + 0.6 * $HwHash($K, 55.1)
          $xp = $xs + max(0, min($xh - $xs - 0.3 * $Lh, $L - $Lh))
          $Ll = $xp - $xs - $rxl * $W - 1.5
          $Lm = $xe - $xp - $Lh - ($rxh + $rxm) * $W - 1.5
          $b = min(6 + 12 * $HwHash($K, 47.7), asin(clamp(0.85 * ($zc - 0.5 * $W) / $Lh, 0.02, 0.9)))
          add($AgedBoard, width=$W, thick=$BT, length=$Lh + $rxh * $W, damage=0.6, base=$Lh, reach=$rxh, style=-1, tk=7, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 40 * $k + $p, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=$dk, ridge=$ridge, checks=$checks, checkd=$checkd, crumb=0.4 * $crumb, sliver=$sliver, corner=$corner, thin=$thin, tile=$tile, aspect=$aspect, at=($xp, $yc - $BT - $zbk - 0.6, $zc), rotate=(90.0, -90.0 + $b, 180.0), join=none)
          if ($Ll > 12) {
            add($AgedBoard, width=$W, thick=$BT, length=$Ll + $rxl * $W, damage=0.6, base=$Ll, reach=$rxl, style=-1, tk=3, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 40 * $k + $p + 650, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=0.0, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=$dk, ridge=$ridge, checks=$checks, checkd=$checkd, crumb=0.4 * $crumb, sliver=$sliver, corner=$corner, thin=$thin, tile=$tile, aspect=$aspect, at=($xs, $yc - $zbk * (1 - 0.6 * $lap), $zc), rotate=(0.0, -90.0 + $tilt, -90.0), join=none)
          }
          if ($Lm > 12) {
            add($AgedBoard, width=$W, thick=$BT, length=$Lm + $rxm * $W, damage=0.6, base=$Lm, reach=$rxm, style=-1, tk=5, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 40 * $k + $p + 600, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=0.0, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=$dk, ridge=$ridge, checks=$checks, checkd=$checkd, crumb=0.4 * $crumb, sliver=$sliver, corner=$corner, thin=$thin, tile=$tile, aspect=$aspect, at=($xe, $yc - $zbk * (1 - 0.6 * $lap), $zc), rotate=(0.0, 90.0 - $tilt, 90.0), join=none)
          }
        } else {
          add($AgedBoard, width=$W, thick=$BT, length=$L, damage=0.0, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 40 * $k + $p, wvar=0.0, tvar=$tv, lvar=0.0, taper=$taper, waney=$wny, ttaper=$ttaper, yaw=$yaw, pitch=0.0, roll=(1 - $lap) * $roll, lift=0.05, cup=$cup, bow=$bow, crook=$crook, twist=$twist, endsq=$endsq, wear=$WE, wearvar=0.6, state=$state, decay=$dk, ridge=$ridge, checks=$checks, checkd=$checkd, crumb=0.4 * $crumb, sliver=$sliver, corner=$corner, thin=$thin, tile=$tile, aspect=$aspect, at=($xs, $yc - $zbk * (1 - 0.6 * $lap), $zc), rotate=(0.0, -90.0 + $tilt, -90.0), join=none)
        }
        # proud nails on the studs this piece crosses (lap: through the lap, 2.5 cm above the butt)
        $ns = floor($L / $sp) + 1
        loop (repeat=$ns) {
          $s = output.index - 1
          $KN = $K * 31 + $s
          $xn = $sp * (ceil($xs / $sp) + $s)
          if (($NP - $HwHash($KN, 79.1)) * (1 - $hang) * clamp(ceil($xe - 2 - $xn), 0, 1) * clamp(ceil($xn - $xs - 2), 0, 1) > 0) {
            add($Nail, up=$PR * (0.5 + $HwHash($KN, 83.3)), at=($xn, $yc - $zbk * (1 - 0.6 * $lap) - $BT + $lap * ($zc - $zb0 - 2.5) * tan($tilt), $lap * ($zb0 + 2.5) + (1 - $lap) * $zc), rotate=(-90.0, 0.0, 0.0), join=none)
          }
        }
      }
    }
    # flush and infill: the rebate (or tongue) behind the joint above this course, seen through the gap
    if ((1 - $lap) * clamp(ceil($nC - 1.5 - $k), 0, 1) > 0.5) {
      add($AgedBoard, width=max($LP, 0.5) * 2, thick=0.5 * $BT, length=$span + 2 * $ins * 1.5, damage=0.0, age=$AE, softness=$S, noise=$N, budget=$B, index=$n0 + 40 * $k + 20, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.0, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.0, twist=0.0, endsq=0.0, wear=0.0, decay=0.0, tile=$tile, aspect=$aspect, at=(-$ins * 1.5, -0.02, ($k + 1) * $Pe), rotate=(0.0, -90.0, -90.0), join=none)
    }
  }
}

HouseWall = mesh(type=0, size_x=300.0, height=240.0, age=1.0, damage=-1.0, softness=0.0, noise=1, budget=1, board_w=-1.0, board_t=-1.0, gap=-1.0, lap=-1.0, foot=0.0, bottom=1.0, shrink=6.0, battens=1, batten_w=6.4, batten_t=1.9, girt_p=60.0, stud_p=40.6, post_p=180.0, post_w=11.0, sill_h=12.0, head_h=18.0, rail=1, rail_z=0.33, infill=0, missing=-1.0, rot=-1.0, split=-1.0, loose=-1.0, lift=-1.0, battoff=-1.0, nails=-1.0, proud=-1.0, lean=-1.0, sag=-1.0, decay=-1.0, wvar=-1.0, cup=-1.0, bow=-1.0, crook=-1.0, roll=0.6, twist=1.0, yaw=0.02, taper=0.015, waney=0.3, ttaper=0.06, endsq=1.5, wear=0.1, state=0.35, ridge=0.15, checks=3, checkd=0.5, crumb=4.0, sliver=0.4, corner=0.4, thin=0.15, tile=100.0, aspect=1.0) {
  $T = clamp(floor($type + 0.5), 0, 3)
  $X = clamp($size_x, 60, 600)
  $H = clamp($height, 60, 500)
  $A = clamp($age, 0, 2)
  $S = clamp($softness, 0, 1)
  $N = floor($noise)
  $B = clamp(floor($budget + 0.5), 0, 2)
  $NR = $N + 101 * $T
  $t0 = $HwIs($T, 0)
  $t1 = $HwIs($T, 1)
  $t2 = $HwIs($T, 2)
  $t3 = $HwIs($T, 3)
  $a1 = min($A, 1)
  $a2 = max($A - 1, 0)
  $BW = clamp($HwPick($board_w, 24.0 * $t0 + 17.5 * $t1 + 18.4 * $t2 + 15.0 * $t3), 4, 60)
  $BT = clamp($HwPick($board_t, 1.9 * $t0 + 1.4 * $t1 + 1.9 * $t2 + 3.0 * $t3), 0.8, 10)
  $BAT = clamp(floor($battens + 0.5), 0, 1)
  $GP = clamp($HwPick($gap, (1.3 * $BAT + 0.3 * (1 - $BAT)) * $t0 + 0.05 * $t1 + 0.6 * $t2 + 0.5 * $t3), 0, 10)
  $LP = clamp($HwPick($lap, 3.0 * $t1 + 2.5 * $t2 + 1.5 * $t3), 0, 15)
  $FT = clamp($foot, 0, 60)
  $BOT = clamp($bottom, 0, 10)
  $D = clamp($HwPick($damage, 0.7 * $a2), 0, 1)
  $SHR = clamp($shrink, 0, 15) / 100 * (0.33 * $a1 + 0.67 * $a2)
  $BTW = clamp($batten_w, 2, 15)
  $BTT = clamp($batten_t, 0.8, 5)
  $GPI = clamp($girt_p, 30, 150)
  $SPI = clamp($stud_p, 25, 120)
  $PPI = clamp($post_p, 60, 400)
  $PW = clamp($post_w, 6, 30)
  $SH = clamp($sill_h, 0, 40)
  $HH = clamp($head_h, 0, 60)
  $RL = clamp(floor($rail + 0.5), 0, 1)
  $RZ = clamp($rail_z, 0.05, 0.95)
  $INF = clamp(floor($infill + 0.5), 0, 1)
  $MS = clamp($HwPick($missing, 0.09 * $D), 0, 0.6)
  $RT = clamp($HwPick($rot, 50.0 * $D), 0, 120)
  $SP = clamp($HwPick($split, 0.1 * $D), 0, 0.6)
  $LS = clamp($HwPick($loose, 0.25 * $D), 0, 1)
  $LH = clamp($HwPick($lift, 1.0 + 3.0 * $D), 0, 15)
  $BO = clamp($HwPick($battoff, 0.35 * $D), 0, 1)
  $NP = clamp($HwPick($nails, 0.05 * $a1 + 0.2 * $a2), 0, 1)
  $PR = clamp($HwPick($proud, 0.15 * $a1 + 0.35 * $a2), 0, 1.5)
  $LN = clamp($HwPick($lean, 0.35 * $a1 + 0.65 * $a2), 0, 4)
  $SG = clamp($HwPick($sag, 0.6 * $a1 + 1.4 * $a2), 0, 15)
  $DEC = clamp($HwPick($decay, clamp(($A - 0.5) / 1.5, 0, 1)), 0, 1)
  $WV = clamp($HwPick($wvar, 0.075 * $A), 0, 0.4)
  $CUP = clamp($HwPick($cup, 0.015 * $BW), 0, 4)
  $Lv = $t0 * ($H - $FT) + $t3 * (1 - $INF) * ($H - $SH - $HH) + ($t1 + $t2) * min($X, 300) + $t3 * $INF * $PPI
  # horizontal boards are nailed at every stud, so they bow and crook between studs only
  $hz = $t1 + $t2 + $t3 * $INF
  $BOW = clamp($HwPick($bow, $Lv / 1600 + 0 * $hz), 0, 15)
  $CRK = clamp($HwPick($crook, (1 - $hz) * $Lv / 3200 + $hz * $Lv / 4800), 0, 10)
  $ROL = clamp($roll, 0, 10)
  $TWI = clamp($twist, 0, 20) * (1 - 0.6 * $hz)
  $YAW = clamp($yaw, 0, 3)
  $TAP = clamp($taper, 0, 0.3)
  $WAN = clamp($waney, 0, 5)
  $TTA = clamp($ttaper, 0, 0.5)
  $ESQ = clamp($endsq, 0, 12) * $a1
  $WEA = clamp($wear, 0, 4) * (1 + 3 * $S)
  $STA = clamp($state, 0, 1)
  # softness also wears the breaks themselves smooth (driftwood has no splinters): ridges, crumbs, slivers, torn
  # corners and check depth fall with it, and the arrises' wear radius grows
  $RID = clamp($ridge, 0, 2) * (1 - 0.7 * $S)
  $CHK = clamp(floor($checks * (1 - 0.67 * $S) + 0.5), 0, 4)
  $CHD = clamp($checkd, 0, 0.9) * (1 - 0.4 * $S)
  $CRU = clamp($crumb, 0, 20) * (1 - 0.75 * $S)
  $SLV = clamp($sliver, 0, 1) * (1 - $S)
  $COR = clamp($corner, 0, 1) * (1 - 0.6 * $S)
  $THN = clamp($thin, 0, 0.6)
  $TIL = clamp($tile, 10, 1000)
  $ASP = clamp($aspect, 0.1, 10)
  $fdec = 0.6 * $DEC
  # ---- type 0, board-and-batten: girts behind the boards (9 tall, 4.5 deep, y 0..4.5) on two end posts (9 x 9) ----
  if ($t0 > 0.5) {
    $ng = max(2, floor(($H - $FT - 40) / $GPI + 0.5) + 1)
    $gdz = ($H - $FT - 40) / ($ng - 1)
    loop (repeat=$ng) {
      $g = output.index - 1
      add($AgedBoard, width=9.0, thick=4.5, length=$X, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=400 + $g, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.2, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.3, twist=0.0, endsq=0.0, wear=0.3 * $WEA, state=$STA, decay=$fdec, ridge=$RID, checks=2, checkd=$CHD, crumb=$CRU, sliver=0.0, corner=0.0, thin=0.0, tile=$TIL, aspect=$ASP, at=(0.0, 4.5, $FT + 20 + $g * $gdz), rotate=(0.0, -90.0, -90.0), join=none)
    }
    add($AgedBoard, width=9.0, thick=9.0, length=$H, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=420, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.2, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.2, crook=0.2, twist=0.0, endsq=0.0, wear=0.3 * $WEA, state=$STA, decay=$fdec, ridge=$RID, checks=2, checkd=$CHD, crumb=$CRU, sliver=0.0, corner=0.0, thin=0.0, tile=$TIL, aspect=$ASP, at=(4.5, 13.5, 0.0), rotate=(-90.0, 0.0, 0.0), join=none)
    add($AgedBoard, width=9.0, thick=9.0, length=$H, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=421, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.2, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.2, crook=0.2, twist=0.0, endsq=0.0, wear=0.3 * $WEA, state=$STA, decay=$fdec, ridge=$RID, checks=2, checkd=$CHD, crumb=$CRU, sliver=0.0, corner=0.0, thin=0.0, tile=$TIL, aspect=$ASP, at=($X - 4.5, 13.5, 0.0), rotate=(-90.0, 0.0, 0.0), join=none)
    add($HwVRun, span=$X, len=$H - $FT, bot=$BOT, n0=0, A=$A, S=$S, N=$NR, B=$B, BW=$BW, BT=$BT, GP=$GP, SHR=$SHR, WV=$WV, DEC=$DEC, MS=$MS, RT=$RT, SP=$SP, LS=$LS, LH=$LH, NP=$NP, PR=$PR, ng=$ng, gz0=20.0, gdz=$gdz, bat=$BAT, btw=$BTW, btt=$BTT, BO=$BO, wx=$X, x0=0.0, cup=$CUP, bow=$BOW, crook=$CRK, roll=$ROL, twist=$TWI, yaw=$YAW, taper=$TAP, waney=$WAN, ttaper=$TTA, endsq=$ESQ, wear=$WEA, state=$STA, ridge=$RID, checks=$CHK, checkd=$CHD, crumb=$CRU, sliver=$SLV, corner=$COR, thin=$THN, tile=$TIL, aspect=$ASP, at=(0.0, 0.0, $FT), join=none)
  }
  # ---- types 1 and 2, clapboard and shiplap: studs (3.8 wide, 8.9 deep, y 0..8.9) between a sole and a top plate ----
  if ($t1 + $t2 > 0.5) {
    $ns = floor(($X - 3.8) / $SPI) + 1
    loop (repeat=$ns) {
      $s = output.index - 1
      add($AgedBoard, width=3.8, thick=8.9, length=$H - 7.6, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=430 + $s, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.0, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.2, twist=0.0, endsq=0.0, wear=0.0, state=$STA, decay=0.0, tile=$TIL, aspect=$ASP, at=(1.9 + $s * $SPI, 8.9, 3.8), rotate=(-90.0, 0.0, 0.0), join=none)
    }
    add($AgedBoard, width=3.8, thick=8.9, length=$H - 7.6, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=429, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.0, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.2, twist=0.0, endsq=0.0, wear=0.0, state=$STA, decay=0.0, tile=$TIL, aspect=$ASP, at=($X - 1.9, 8.9, 3.8), rotate=(-90.0, 0.0, 0.0), join=none)
    add($AgedBoard, width=3.8, thick=8.9, length=$X, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=427, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.0, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.0, twist=0.0, endsq=0.0, wear=0.0, state=$STA, decay=0.0, tile=$TIL, aspect=$ASP, at=(0.0, 8.9, 1.9), rotate=(0.0, -90.0, -90.0), join=none)
    add($AgedBoard, width=3.8, thick=8.9, length=$X, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=428, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.0, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.0, twist=0.0, endsq=0.0, wear=0.0, state=$STA, decay=0.0, tile=$TIL, aspect=$ASP, at=(0.0, 8.9, $H - 1.9), rotate=(0.0, -90.0, -90.0), join=none)
    add($HwHRun, mode=1 + $t2, span=$X, hgt=$H - $FT, n0=0, A=$A, S=$S, N=$NR, B=$B, BW=$BW, BT=$BT, GP=$GP, LP=$LP, SHR=$SHR, DEC=$DEC, MS=$MS, RT=$RT, SP=$SP, LS=$LS, NP=$NP, PR=$PR, sp=$SPI, wx=$X, x0=0.0, cup=$CUP, bow=$BOW, crook=$CRK, roll=$ROL, twist=$TWI, yaw=$YAW, taper=$TAP, waney=$WAN, ttaper=$TTA, endsq=$ESQ, wear=$WEA, state=$STA, ridge=$RID, checks=$CHK, checkd=$CHD, crumb=$CRU, sliver=$SLV, corner=$COR, thin=$THN, tile=$TIL, aspect=$ASP, at=(0.0, 0.0, $FT), join=none)
  }
  # ---- type 3, post-and-plank: a sill beam, square posts at the bay pitch, a head beam, a through rail on the face, and
  # the boards (vertical, or planks) centred in the posts' depth, each bay its own run ----
  if ($t3 > 0.5) {
    $nb = max(1, floor(($X - $PW) / $PPI + 0.5))
    $pp = ($X - $PW) / $nb
    $HC = $H - $SH - $HH
    $pg = $GP + 0.5 * $SHR * $BW
    if ($SH > 0.5) {
      add($AgedBoard, width=$SH, thick=$PW + 1.0, length=$X, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=440, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.3, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.0, twist=0.0, endsq=0.0, wear=0.3 * $WEA, state=$STA, decay=min($DEC * 1.2, 1), ridge=$RID, checks=$CHK, checkd=0.4, crumb=$CRU, sliver=0.0, corner=$COR, thin=0.05, tile=$TIL, aspect=$ASP, at=(0.0, 0.5 * ($PW + 1.0), 0.5 * $SH), rotate=(0.0, -90.0, -90.0), join=none)
    }
    if ($HH > 0.5) {
      add($AgedBoard, width=$HH, thick=$PW + 2.0, length=$X, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=441, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.3, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.0, twist=0.0, endsq=0.0, wear=0.3 * $WEA, state=$STA, decay=$fdec, ridge=$RID, checks=$CHK, checkd=0.4, crumb=$CRU, sliver=0.0, corner=0.0, thin=0.0, tile=$TIL, aspect=$ASP, at=(0.0, 0.5 * ($PW + 2.0), $H - 0.5 * $HH), rotate=(0.0, -90.0, -90.0), join=none)
    }
    loop (repeat=$nb + 1) {
      $q = output.index - 1
      add($AgedBoard, width=$PW, thick=$PW, length=$HC, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=450 + $q, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.3, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.3, crook=0.3, twist=0.0, endsq=0.0, wear=0.3 * $WEA, state=$STA, decay=$fdec, ridge=$RID, checks=$CHK, checkd=0.4, crumb=0.0, sliver=0.0, corner=0.0, thin=0.0, tile=$TIL, aspect=$ASP, at=(0.5 * $PW + $q * $pp, 0.5 * $PW, $SH), rotate=(-90.0, 0.0, 0.0), join=none)
      if ($q < $nb - 0.5) {
        $bx = 0.5 * $PW + $q * $pp + 0.5 * $PW
        if ($INF < 0.5) {
          add($HwVRun, span=$pp - $PW - 2 * $pg, len=$HC, bot=0.0, n0=60 * $q, A=$A, S=$S, N=$NR, B=$B, BW=$BW, BT=$BT, GP=$GP, SHR=$SHR, WV=$WV, DEC=$DEC, MS=$MS, RT=$RT, SP=$SP, LS=$LS, LH=$LH, NP=0.0, PR=0.0, ng=0, bat=0, wx=$X, x0=$bx + $pg, cup=$CUP, bow=$BOW, crook=$CRK, roll=$ROL, twist=$TWI, yaw=$YAW, taper=$TAP, waney=$WAN, ttaper=$TTA, endsq=$ESQ, wear=$WEA, state=$STA, ridge=$RID, checks=$CHK, checkd=$CHD, crumb=$CRU, sliver=$SLV, corner=$COR, thin=$THN, tile=$TIL, aspect=$ASP, at=($bx + $pg, 0.5 * $BT, $SH), join=none)
        } else {
          add($HwHRun, mode=3, span=$pp - $PW, hgt=$HC, n0=60 * $q, A=$A, S=$S, N=$NR, B=$B, BW=$BW, BT=$BT, GP=$GP, LP=$LP, SHR=$SHR, DEC=$DEC, MS=$MS, RT=$RT, SP=$SP, LS=0.0, NP=0.0, PR=0.0, sp=$pp, wx=$X, x0=$bx, cup=$CUP, bow=$BOW, crook=$CRK, roll=$ROL, twist=$TWI, yaw=$YAW, taper=$TAP, waney=$WAN, ttaper=$TTA, endsq=$ESQ, wear=$WEA, state=$STA, ridge=$RID, checks=$CHK, checkd=$CHD, crumb=$CRU, sliver=$SLV, corner=$COR, thin=$THN, tile=$TIL, aspect=$ASP, at=($bx, 0.5 * $BT, $SH), join=none)
        }
      }
    }
    if ($RL > 0.5) {
      add($AgedBoard, width=10.5, thick=3.0, length=$X, damage=0.0, age=$A, softness=$S, noise=$N, budget=$B, index=470, wvar=0.0, tvar=0.0, lvar=0.0, taper=0.0, waney=0.2, ttaper=0.0, yaw=0.0, pitch=0.0, roll=0.0, lift=0.0, cup=0.0, bow=0.0, crook=0.3, twist=0.0, endsq=0.0, wear=0.3 * $WEA, state=$STA, decay=$fdec, ridge=$RID, checks=2, checkd=$CHD, crumb=$CRU, sliver=0.0, corner=0.0, thin=0.0, tile=$TIL, aspect=$ASP, at=(0.0, -0.5 * $BT - 0.4 - $CUP * (min($A, 1) + 2 * max($A - 1, 0)), $SH + $RZ * $HC), rotate=(0.0, -90.0, -90.0), join=none)
    }
  }
  # ---- the frame racks and sags with age (the whole module, after every member is placed) ----
  if ($LN + $SG > 0.001) {
    warp(by=(point.z * $LN / 100, 0.0, -$SG * sin(180 * clamp(point.x / $X, 0, 1)) * clamp(point.z / $H, 0, 1)))
  }
}

# the HouseWall states the build block ships (Game from the High; noise 6, the photos' defaults; Gate at 360 x 230)
HouseWallBattenAgedHigh          = mesh() { add($HouseWall, type=0, age=1.0, noise=6, budget=1) }
HouseWallBattenAgedGame          = mesh() { add($HouseWall, type=0, age=1.0, noise=6, budget=0) }
HouseWallBattenWeatheredHigh     = mesh() { add($HouseWall, type=0, age=2.0, noise=6, budget=1) }
HouseWallBattenWeatheredGame     = mesh() { add($HouseWall, type=0, age=2.0, noise=6, budget=0) }
HouseWallClapboardAgedHigh       = mesh() { add($HouseWall, type=1, age=1.0, noise=6, budget=1) }
HouseWallClapboardAgedGame       = mesh() { add($HouseWall, type=1, age=1.0, noise=6, budget=0) }
HouseWallClapboardWeatheredHigh  = mesh() { add($HouseWall, type=1, age=2.0, noise=6, budget=1) }
HouseWallClapboardWeatheredGame  = mesh() { add($HouseWall, type=1, age=2.0, noise=6, budget=0) }
HouseWallShiplapAgedHigh         = mesh() { add($HouseWall, type=2, age=1.0, noise=6, budget=1) }
HouseWallShiplapAgedGame         = mesh() { add($HouseWall, type=2, age=1.0, noise=6, budget=0) }
HouseWallShiplapWeatheredHigh    = mesh() { add($HouseWall, type=2, age=2.0, noise=6, budget=1) }
HouseWallShiplapWeatheredGame    = mesh() { add($HouseWall, type=2, age=2.0, noise=6, budget=0) }
HouseWallGateAgedHigh            = mesh() { add($HouseWall, type=3, size_x=360.0, height=230.0, age=1.0, noise=6, budget=1) }
HouseWallGateAgedGame            = mesh() { add($HouseWall, type=3, size_x=360.0, height=230.0, age=1.0, noise=6, budget=0) }
