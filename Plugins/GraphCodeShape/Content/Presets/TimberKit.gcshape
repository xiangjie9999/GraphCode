  $ang = $slant * (2 * $ad20 - 1)
  $ext = 0.4 * $deep * $Wd * (1 + $long + $vdep) + $lean * $Td + 6.0
  $brkd = clamp(ceil($brk - 0.5), 0, 1)
  if ($dv > 0.001) {
    add($DecaySec, w=$Wd, t=$Td, a=max($ra, 0.25), b=max($rb, 0.25), c=$rc, d=$rd, scale=(1.0, ($Ld + $brkd * $ext) / 100.0, 1.0))
  } else {
    if ($arris > 1.5) {
      add($AgedSec3, w=$Wd, t=$Td, a=$ra, b=$rb, c=$rc, d=$rd, seg=$seg, scale=(1.0, ($Ld + $brkd * $ext) / 100.0, 1.0))
    } else {
      add($AgedSec1, w=$Wd, t=$Td, a=$ra, b=$rb, c=$rc, d=$rd, seg=$seg, scale=(1.0, ($Ld + $brkd * $ext) / 100.0, 1.0))
    }
  }
  if ($brk > 0.5) {
    $Dmg.Snap(width=$Wd, thick=$Td, deep=$deep, grain=$grain, lean=$lean, layers=$layers, uneven=$uneven, rough=$rough, needle=$needle, skew=$skew, fray=$fray, sub=$sub, long=$long, vdep=$vdep, torn=$torn, torntilt=0.15, tornrib=1, tornsep=0.15, loss=0.0, chew=$chew, detail=$detail, noise=$K + $bn, origin=(0.0, $Ld, 0.0), rotation=(0.0, 0.0, $ang), uvfit=2, tile=$tile, aspect=$aspect)
    keep(largest)
    if ($fib > 0.001) {
      roughen(by=$fib, scale=(0.9, 5.4, 0.9), seed=$K + $bn, form=ridged) [cut]
    }
  }
  if ($dv > 0.001) {
    $Decay(w=$Wd, t=$Td, len=$Ld, a=$ra, b=$rb, dv=$dv, ridge=$ridge, ph=$ph, cd1=clamp(ceil($nck - 0.5), 0, 1) * $checkd * $Td * $dv, cd2=clamp(ceil($nck - 1.5), 0, 1) * $checkd * $Td * $dv, cd3=clamp(ceil($nck - 2.5), 0, 1) * min(1.6 * $checkd, 0.85) * $Td * $dv, cx1=$cx1, cx2=$cx2, cx3=$cx3, cy1=$cy1, cl1=$cl1, cy2=$cy2, cl2=$cl2, cy3=$cy3, cl3=$cl3, crumb=$crumb * $dv, crf=$crf, sl=$sl, sly=$sly, co=$co, coe=$coe, cos=$cos, nc=$NC, softv=$softness, crb=1 - $brkd)
  }
  $Age(w=$Wd, t=$Td, len=$Ld, cupv=$cp, bowv=$bw, crookv=$ck, e0=$e0, e1=$e1 * (1 - $brkd), yawv=$yw, liftv=$lf, rm=$rm * (1 - clamp(ceil($dv - 0.001), 0, 1)), wa=$wa, wb=$wb, ph=$ph, fr=$fr, twistv=$tw, taperv=$tp, wanev=$wv, wanek=$wk, wanes=$ws, ttapv=$tt, pitchv=$pt, rollv=$rl, softv=$softness)
  if ($uvs > 0.5) {
    if ($brk > 0.5) {
      uv(box, facing=(0, 0, 1), up=(0, 1, 0), scale=($aspect * $tile, $tile, $tile)) [!cut]
      uv(box, facing=(0, 0, 1), up=(0, 1, 0), scale=($aspect * $tile, $tile, $tile), offset=(0.37, 0.61)) [cut]
    } else {
      uv(box, facing=(0, 0, 1), up=(0, 1, 0), scale=($aspect * $tile, $tile, $tile))
    }
  } else {
    uv(none)
  }
  material($Face)
  if ($brk > 0.5) {
    material($Broken) [cut]
  }
}

# A TURNED PIECE OF A BROKEN BOARD (`BrokenSeg`, advanced): y from 0 (its hinge, the `SnapOff` of the short torn break
# the board's near part ends in: `BrokenBoard` with deep=hdeep, lean 0.6, no slant, fray, sub or chew, and bn=hbn, the
# same index and width, so the two fit tooth into socket) to a `Damage.Snap` at y = len; decayed and aged as its board.
BrokenSeg = mesh(len=20.0, softness=0.0, width=20.0, thick=5.0, wvar=0.08, tvar=0.05, lvar=0.05, yaw=0.5, lift=0.15, cup=0.3, bow=0.4, crook=0.25, endsq=1.5, wear=0.5, wearvar=0.6, twist=0.6, taper=0.03, waney=0.4, ttaper=0.06, pitch=0.25, roll=0.4, decay=0.0, ridge=0.45, checks=3, checkd=0.45, crumb=4.0, sliver=0.6, corner=0.45, thin=0.22, arris=3, seg=4, uvs=1, tile=100.0, aspect=1.0, noise=1, index=0, hdeep=0.3, hbn=11, brk=1, deep=4.0, grain=0.22, layers=2, uneven=0.4, rough=1.0, needle=0.7, skew=0.8, fray=1.0, sub=0.06, chew=0.05, lean=1.0, slant=10.0, long=0.8, vdep=0.7, torn=0.0, bn=0, detail=0.4, fib=0.0) {
  $length = $len
  $K = $noise * 1009 + $index
  $ad1 = sin($K * 12.9898 + 20.4) * 43758.5453
  $ad1 = $ad1 - floor($ad1)
  $ad2 = sin($K * 12.9898 + 37.7) * 43758.5453
  $ad2 = $ad2 - floor($ad2)
  $ad3 = sin($K * 12.9898 + 55.0) * 43758.5453
  $ad3 = $ad3 - floor($ad3)
  $ad4 = sin($K * 12.9898 + 72.3) * 43758.5453
  $ad4 = $ad4 - floor($ad4)
  $ad5 = sin($K * 12.9898 + 89.6) * 43758.5453
  $ad5 = $ad5 - floor($ad5)
  $ad6 = sin($K * 12.9898 + 106.9) * 43758.5453
  $ad6 = $ad6 - floor($ad6)
  $ad7 = sin($K * 12.9898 + 124.2) * 43758.5453
  $ad7 = $ad7 - floor($ad7)
  $ad8 = sin($K * 12.9898 + 141.5) * 43758.5453
  $ad8 = $ad8 - floor($ad8)
  $ad9 = sin($K * 12.9898 + 158.8) * 43758.5453
  $ad9 = $ad9 - floor($ad9)
  $ad10 = sin($K * 12.9898 + 176.1) * 43758.5453
  $ad10 = $ad10 - floor($ad10)
  $ad11 = sin($K * 12.9898 + 193.4) * 43758.5453
  $ad11 = $ad11 - floor($ad11)
  $ad12 = sin($K * 12.9898 + 210.7) * 43758.5453
  $ad12 = $ad12 - floor($ad12)
  $ad13 = sin($K * 12.9898 + 228.0) * 43758.5453
  $ad13 = $ad13 - floor($ad13)
  $ad14 = sin($K * 12.9898 + 245.3) * 43758.5453
  $ad14 = $ad14 - floor($ad14)
  $ad15 = sin($K * 12.9898 + 262.6) * 43758.5453
  $ad15 = $ad15 - floor($ad15)
  $ad16 = sin($K * 12.9898 + 279.9) * 43758.5453
  $ad16 = $ad16 - floor($ad16)
  $ad17 = sin($K * 12.9898 + 297.2) * 43758.5453
  $ad17 = $ad17 - floor($ad17)
  $ad18 = sin($K * 12.9898 + 314.5) * 43758.5453
  $ad18 = $ad18 - floor($ad18)
  $ad19 = sin($K * 12.9898 + 331.8) * 43758.5453
  $ad19 = $ad19 - floor($ad19)
  $ad20 = sin($K * 12.9898 + 349.1) * 43758.5453
  $ad20 = $ad20 - floor($ad20)
  $Wd = $width * (1 + $wvar * (2 * $ad1 - 1))
  $Td = $thick * (1 + $tvar * (2 * $ad2 - 1))
  $Ld = $length * (1 + 0.0 * (2 * $ad3 - 1))
  $yw = $yaw * (0.4 + 0.6 * $ad4) * (2 * floor(2 * $ad5) - 1)
  $lf = $lift * (2 * $ad6 - 1)
  $cp = $cup * (0.3 + 0.7 * $ad7) * (1 - 2 * clamp(ceil($ad8 - 0.75), 0, 1))
  $bw = $bow * (2 * $ad9 - 1)
  $ck = $crook * (2 * $ad10 - 1)
  $e0 = $endsq * (2 * $ad11 - 1)
  $e1 = $endsq * (2 * $ad12 - 1)
  $rcap = min(0.3 * $Wd, 0.4 * $Td)
  $ra = min(max($wear * (1 + $wearvar * (2 * $ad13 - 1)), 0.1 * $wear), $rcap)
  $rb = min(max($wear * (1 + $wearvar * (2 * $ad14 - 1)), 0.1 * $wear), $rcap)
  $rc = min(0.35 * $wear * (0.6 + 0.8 * $ad15), $rcap)
  $rd = min(0.35 * $wear * (0.6 + 0.8 * $ad16), $rcap)
  $rm = max($ra, $rb)
  $wa = min($wearvar, 0.8) * (0.3 + 0.7 * $ad17)
  $wb = min($wearvar, 0.8) * (0.3 + 0.7 * $ad18)
  $ph = 360 * $ad19
  $fr = 0.6 + 1.2 * $ad20
  $ad21 = sin($K * 12.9898 + 366.4) * 43758.5453
  $ad21 = $ad21 - floor($ad21)
  $ad22 = sin($K * 12.9898 + 383.7) * 43758.5453
  $ad22 = $ad22 - floor($ad22)
  $ad23 = sin($K * 12.9898 + 401.0) * 43758.5453
  $ad23 = $ad23 - floor($ad23)
  $ad24 = sin($K * 12.9898 + 418.3) * 43758.5453
  $ad24 = $ad24 - floor($ad24)
  $ad25 = sin($K * 12.9898 + 435.6) * 43758.5453
  $ad25 = $ad25 - floor($ad25)
  $ad26 = sin($K * 12.9898 + 452.9) * 43758.5453
  $ad26 = $ad26 - floor($ad26)
  $ad27 = sin($K * 12.9898 + 470.2) * 43758.5453
  $ad27 = $ad27 - floor($ad27)
  $ad28 = sin($K * 12.9898 + 487.5) * 43758.5453
  $ad28 = $ad28 - floor($ad28)
  $ad29 = sin($K * 12.9898 + 504.8) * 43758.5453
  $ad29 = $ad29 - floor($ad29)
  $ad30 = sin($K * 12.9898 + 522.1) * 43758.5453
  $ad30 = $ad30 - floor($ad30)
  $ad31 = sin($K * 12.9898 + 539.4) * 43758.5453
  $ad31 = $ad31 - floor($ad31)
  $ad32 = sin($K * 12.9898 + 556.7) * 43758.5453
  $ad32 = $ad32 - floor($ad32)
  $ad33 = sin($K * 12.9898 + 574.0) * 43758.5453
  $ad33 = $ad33 - floor($ad33)
  $ad34 = sin($K * 12.9898 + 591.3) * 43758.5453
  $ad34 = $ad34 - floor($ad34)
  $ad35 = sin($K * 12.9898 + 608.6) * 43758.5453
  $ad35 = $ad35 - floor($ad35)
  $ad36 = sin($K * 12.9898 + 625.9) * 43758.5453
  $ad36 = $ad36 - floor($ad36)
  $ad37 = sin($K * 12.9898 + 643.2) * 43758.5453
  $ad37 = $ad37 - floor($ad37)
  $ad38 = sin($K * 12.9898 + 660.5) * 43758.5453
  $ad38 = $ad38 - floor($ad38)
  $ad39 = sin($K * 12.9898 + 677.8) * 43758.5453
  $ad39 = $ad39 - floor($ad39)
  $ad40 = sin($K * 12.9898 + 695.1) * 43758.5453
  $ad40 = $ad40 - floor($ad40)
  $ad41 = sin($K * 12.9898 + 712.4) * 43758.5453
  $ad41 = $ad41 - floor($ad41)
  $ad42 = sin($K * 12.9898 + 729.7) * 43758.5453
  $ad42 = $ad42 - floor($ad42)
  $ad43 = sin($K * 12.9898 + 747.0) * 43758.5453
  $ad43 = $ad43 - floor($ad43)
  $ad44 = sin($K * 12.9898 + 764.3) * 43758.5453
  $ad44 = $ad44 - floor($ad44)
  $tw = $twist * (0.3 + 0.7 * $ad21) * (2 * floor(2 * $ad22) - 1)
  $tp = $taper * (2 * $ad23 - 1)
  $wv = $waney * (0.3 + 0.7 * $ad24)
  $wk = 0.5 + 1.5 * $ad25
  $ws = 2 * floor(2 * $ad26) - 1
  $tt = $ttaper * (2 * $ad27 - 1)
  $pt = $pitch * (2 * $ad28 - 1)
  $rl = $roll * (2 * $ad29 - 1)
  $dv = clamp($decay * (1 + 0.0 * (2 * $ad30 - 1)), 0, 1)
  $nck = min(floor($checks * (0.4 + 0.6 * $ad31) + 0.5), 3) * clamp(ceil($dv - 0.05), 0, 1)
  $cx1 = 3 + floor(13 * $ad32)
  $cx2 = 3 + floor(13 * $ad33)
  $cx3 = 3 + floor(13 * $ad34)
  $cy1 = 0.05 + 0.3 * $ad35
  $cl1 = 0.3 + 0.6 * $ad36
  $cy2 = 0.35 + 0.4 * $ad37
  $cl2 = 1.0
  $cy3 = 0.0
  $cl3 = 0.15 + 0.4 * $ad38
  $sl = clamp(ceil($sliver * $dv - $ad39), 0, 1)
  $sly = 0.1 + 0.5 * $ad40
  $co = clamp(ceil($corner * $dv - $ad41), 0, 1)
  $coe = floor(2 * $ad42)
  $cos = 2 * floor(2 * $ad43) - 1
  $crf = 0.5 + 0.5 * $ad44
  $ang = $slant * (2 * $ad19 - 1)
  $ex0 = 0.4 * $hdeep * $Wd * (1 + $long + $vdep) + 0.6 * $Td + 6.0
  $ex1 = 0.4 * $deep * $Wd * (1 + $long + $vdep) + $lean * $Td + 6.0
  if ($dv > 0.001) {
    add($DecaySec, w=$Wd, t=$Td, a=max($ra, 0.25), b=max($rb, 0.25), c=$rc, d=$rd, scale=(1.0, ($Ld + $ex0 + $ex1) / 100.0, 1.0), at=(0.0, -$ex0, 0.0))
  } else {
    if ($arris > 1.5) {
      add($AgedSec3, w=$Wd, t=$Td, a=$ra, b=$rb, c=$rc, d=$rd, seg=$seg, scale=(1.0, ($Ld + $ex0 + $ex1) / 100.0, 1.0), at=(0.0, -$ex0, 0.0))
    } else {
      add($AgedSec1, w=$Wd, t=$Td, a=$ra, b=$rb, c=$rc, d=$rd, seg=$seg, scale=(1.0, ($Ld + $ex0 + $ex1) / 100.0, 1.0), at=(0.0, -$ex0, 0.0))
    }
  }
  $Dmg.SnapOff(width=$Wd, thick=$Td, deep=$hdeep, grain=$grain, lean=0.6, layers=2, uneven=$uneven, rough=$rough, needle=$needle, skew=$skew, fray=0.0, sub=0.0, long=$long, vdep=$vdep, torn=0.0, torntilt=0.15, tornrib=1, tornsep=0.15, loss=0.0, chew=0.0, detail=$detail, noise=$K + $hbn, origin=(0.0, 0.0, 0.0), rotation=(0.0, 0.0, 0.0), uvfit=2, tile=$tile, aspect=$aspect)
  $Dmg.Snap(width=$Wd, thick=$Td, deep=$deep, grain=$grain, lean=$lean, layers=$layers, uneven=$uneven, rough=$rough, needle=$needle, skew=$skew, fray=$fray, sub=$sub, long=$long, vdep=$vdep, torn=$torn, torntilt=0.15, tornrib=1, tornsep=0.15, loss=0.0, chew=$chew, detail=$detail, noise=$K + $bn + 5, origin=(0.0, $Ld, 0.0), rotation=(0.0, 0.0, $ang), uvfit=2, tile=$tile, aspect=$aspect)
  keep(largest)
  if ($fib > 0.001) {
    roughen(by=$fib, scale=(0.9, 5.4, 0.9), seed=$K + $bn + 5, form=ridged) [cut]
  }
  $NC = 18
  if ($dv > 0.001) {
    $Decay(w=$Wd, t=$Td, len=$Ld, a=$ra, b=$rb, dv=$dv, ridge=$ridge, ph=$ph, cd1=clamp(ceil($nck - 0.5), 0, 1) * $checkd * $Td * $dv, cd2=clamp(ceil($nck - 1.5), 0, 1) * $checkd * $Td * $dv, cd3=clamp(ceil($nck - 2.5), 0, 1) * min(1.6 * $checkd, 0.85) * $Td * $dv, cx1=$cx1, cx2=$cx2, cx3=$cx3, cy1=$cy1, cl1=$cl1, cy2=$cy2, cl2=$cl2, cy3=$cy3, cl3=$cl3, crumb=0.0, crf=$crf, sl=$sl, sly=$sly, co=$co, coe=$coe, cos=$cos, nc=$NC, softv=$softness, crb=0.0)
  }
  $Age(w=$Wd, t=$Td, len=$Ld, cupv=$cp, bowv=$bw, crookv=$ck, e0=0.0, e1=0.0, yawv=$yw, liftv=$lf, rm=$rm * (1 - clamp(ceil($dv - 0.001), 0, 1)), wa=$wa, wb=$wb, ph=$ph, fr=$fr, twistv=$tw, taperv=$tp, wanev=$wv, wanek=$wk, wanes=$ws, ttapv=$tt, pitchv=$pt, rollv=$rl, softv=$softness)
  if ($uvs > 0.5) {
    uv(box, facing=(0, 0, 1), up=(0, 1, 0), scale=($aspect * $tile, $tile, $tile)) [!cut]
    uv(box, facing=(0, 0, 1), up=(0, 1, 0), scale=($aspect * $tile, $tile, $tile), offset=(0.37, 0.61)) [cut]
  } else {
    uv(none)
  }
  material($Face)
  material($Broken) [cut]
}

# ==== THE WALKWAY (kit §12.2): a weathered plank deck on beams over sleepers, rope-lashed at the sleeper ends ====
#
# Along +X; the planks lie across it (grain +Y) on `beams` beams along X, which rest on `sleepers` across near the
# module ends; the sleepers stick out past the plank field and their ends are lashed. The origin is the module's
# min corner at the planks' nominal bottom + their thickness (beams' tops at z = -pthick). Every plank, beam and
# sleeper is an `AgedBoard` with its own index (no two alike). States: `_Aged` (age 1: good condition),
# `_Decayed` (age 1.8: every plank decayed, sag, a loose plank, planks missing, nails proud), `_Broken` (age 0.9,
# damage 0.5: decayed, then an asymmetric hole with Damage.Snap ends, debris on the deck; `_Broken_Debris` is
# what fell through). Every knob is clamped to its range.
#   knob       default unit  range         meaning
#   size_x        300 cm     [100..800]    the module along the walkway
#   size_y        180 cm     [80..400]     across it (the planks' length)
#   damage          0 0-1    [0..1]        0 none; above 0 a hole breaks through (asymmetric, wider with damage), more planks gone whole, overhangs broken off, debris
#   age             1 0-2    [0..2]        0 new, 1 aged (good condition), 1.8 decayed (bad condition), 2 the most: every unevenness x age up to 1, x3 at 2; past 1.1 the planks decay
#   softness        0 0-1    [0..1]        0 crisp, the default (hard arrises, breakouts, faceted cup, stepped ends); toward 1 worn round (driftwood): AgedBoard's softness
#   noise           1 int                  the seed
#   budget          1 0/1/2  [0..2]        0 Game, 1 High, 2 Ultra
#   pin            22 cm     [5..60]       sleepers stick out this far past the plank field (their ends lashed)
#   sleepers        2 count  [2..4]        sleepers across, under the beams
#   sl_w           16 cm     [8..40]       sleeper width
#   sl_d           16 cm     [8..40]       sleeper depth
#   sl_in          24 cm     [5..100]      sleepers in from each module end
#   beams           2 count  [2..3]        beams (stringers) along X
#   beam_w         16 cm     [8..40]       beam width
#   beam_d         20 cm     [8..50]       beam depth
#   beam_in        20 cm     [0..80]       outer beams in from the plank ends
#   beam_wear     1.5 cm     [0..5]        beams' and sleepers' worn arrises
#   pw_lo          12 cm     [6..60]       plank width, least
#   pw_hi          30 cm     [8..80]       plank width, most
#   pthick          8 cm     [2..20]       plank thickness (thick planks, R3)
#   gap_lo        0.3 cm     [0..5]        gap, least
#   gap_hi        1.6 cm     [0..10]       gap, most (x age)
#   stag           14 cm     [0..60]       each end within this of the module edge
#   pflush       0.35 share  [0..1]        ends flush with the edge
#   pslant       0.15 share  [0..1]        planks with ends cut at a slant (slantq x endsq)
#   slantq          4 x      [1..8]        how much further off square a slanted end is
#   cant          0.8 deg    [0..10]       canted across the width up to this
#   plift        0.08 share  [0..1]        planks lifted at one end about a beam
#   lifth         2.5 cm     [0..15]       how far a lifted end rises
#   sprung          1 count  [0..3]        planks sprung up at one end (bent, not lifted)
#   springh         5 cm     [0..30]       how far a sprung end rises (x age)
#   psag          1.2 cm     [0..10]       planks sag between the outer beams (x age)
#   loose        0.12 share  [0..1]        loose planks shifted along their length and turned (x decay)
#   pgone        0.12 share  [0..0.5]      planks missing (x decay; never two side by side)
#   nails           1 0/1    [0..1]        nail heads standing proud on decayed planks (High and Ultra)
#   proud         0.6 cm     [0..3]        how far a nail head stands proud
#   rope            1 0/1    [0..1]        rope lashings at the sleepers' ends
#   turns           4 count  [1..10]       turns of rope in a lashing
#   rope_r        1.3 cm     [0.3..4]      rope radius
#   rope_at         5 cm     [0..30]       lashing in from the sleeper end
#   debris          4 count  [0..40]       pieces lying on the deck (x age, up to 2 x; 6 more at damage 1)
#   hole_xf       0.5 x      [0..1]        the hole's centre along the module (x size_x)
#   hvar           25 cm     [0..200]      the hole moves this far a seed, each side its own way
#   midbay       0.25 share  [0..1]        broken ends 5-15 cm past the beam (else at it)
#   plevel        0.6 share  [0..1]        broken ends level
#   phang        0.25 share  [0..1]        hanging 15-45 degrees
#   pcrack        0.1 share  [0..1]        cracked 5-15 (else steep 60-80)
#   stub            1 0/1    [0..1]        one stub 10-15 cm at 35-45 degrees
#   deep            1 x      [0.1..4]      the breaks' reach (Damage.Snap)
#   grain        0.24 x      [0.1..0.6]    spire width
#   bslant         10 deg    [0..20]       break slant either way
#   torn         0.85 x      [0..1]        torn fibre ends
#   detail       0.25 cm     [0.1..1]      the breaks' point spacing
#   wvar          0.1 x      [0..0.4]      width
#   tvar         0.12 x      [0..0.4]      thickness
#   taper        0.04 x      [0..0.3]      width along a plank
#   waney         0.5 cm     [0..5]        a non-straight edge
#   ttaper       0.08 x      [0..0.5]      thickness along a plank
#   yaw           0.5 deg    [0..6]        yaw
#   pitch        0.25 deg    [0..6]        pitch
#   roll          0.6 deg    [0..10]       roll
#   lift         0.25 cm     [0..5]        height
#   cup           0.6 cm     [0..4]        cup
#   bow           0.5 cm     [0..15]       bow
#   crook         0.3 cm     [0..15]       crook
#   twist         1.5 deg    [0..20]       twist
#   endsq         1.5 deg    [0..12]       ends off square
#   wear          0.9 cm     [0..4]        wear
#   wearvar       0.6 x      [0..1]        wear varies
#   state        0.35 x      [0..1]        each plank its own condition
#   ridge        0.55 cm     [0..2]        decay: eroded ridges
#   checks          3 count  [0..4]        decay: open checks
#   checkd       0.45 x      [0..0.9]      decay: check depth
#   crumb           5 cm     [0..20]       decay: crumbled ends
#   sliver        0.6 share  [0..1]        decay: slivers off
#   corner       0.45 share  [0..1]        decay: corners missing
#   thin         0.22 x      [0..0.6]      decay: thinner
#   tear          0.8 x      [0..3]        (unused here)
#   bfib         0.06 cm     [0..0.5]      Ultra: fibre on every broken end
#   tile          100 cm     [10..1000]    grain UV tile
#   aspect          1 x      [0.1..10]     grain tile aspect

# a rope turn round a w (up) x h (across) bundle, r its rope radius, centred on its origin in its own plane XY,
# its turn's width 2r along Z; rs the round's segments
RopeHole = plane(w=10.0, h=10.0) { rect(w=$w, h=$h) }
RopeTurn = mesh(w=26.0, h=16.0, r=1.1, rs=2, ru=1) {
  rect(w=$w + 2 * $r, h=$h + 2 * $r)
  round(2.2 * $r)
  subtract($RopeHole, w=$w, h=$h)
  extrude(height=2 * $r)
  round(0.45 * $r, segments=$rs) [top]
  round(0.45 * $r, segments=$rs) [bottom]
  place(by=(0.0, 0.0, -$r))
  if ($ru > 0.5) {
    uv(auto)
  } else {
    uv(none)
  }
  material($Rope)
}
# a nail head: a short iron cylinder, its top `up` cm above its origin (the plank's top)
Nail = mesh(up=0.6) {
  circle(radius=0.45, segments=8)
  extrude(height=2.0 + $up)
  place(by=(0.0, 0.0, -2.0))
  round(0.15, segments=1) [top]
  uv(none)
  material($Face)
}

