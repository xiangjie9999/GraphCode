  $ad13 = sin($K * 12.9898 + 228.0) * 43758.5453
  $ad13 = $ad13 - floor($ad13)
  $ad14 = sin($K * 12.9898 + 245.3) * 43758.5453
  $ad14 = $ad14 - floor($ad14)
  $ad15 = sin($K * 12.9898 + 262.6) * 43758.5453
  $ad15 = $ad15 - floor($ad15)
  $ad16 = sin($K * 12.9898 + 279.9) * 43758.5453
  $ad16 = $ad16 - floor($ad16)
  $ad17 = sin($K * 12.9898 + 297.2) * 43758.5453
