    }
  } else {
    uv(none)
  }
  material($Face)
  if ($brk > 0.5) {
    material($Broken) [cut]
  }
}

# A TURNED PIECE OF A BROKEN BOARD (`BrokenSeg`, advanced): y from 0 (its hinge, the `SnapOff` of the short torn break
# the board's near part ends in: `BrokenBoard` with deep=hdeep, lean 0.6, no slant, fray, sub or chew, and bn=hbn, the
