      # TK17 (21 Nov 2026): every face on the nearest of nine planes, the top, two diagonals and a side across the grain,
      # two diagonals and an end along it, so no face is mapped more than 22.5 degrees off its plane across the grain
      # (stretch 1.57 to 1.10 on a board at age 1.6: the box's own merges had laid 45-55 degree check walls, ridge flanks
      # and arris rounds on the top). A band is the meet of two 60-degree cones; the later lines win where bands overlap.
      # The grain runs along +Y on every plane at the box's own tiles (along it `aspect` x `tile`, across it `tile`). The
      # crumbled ends (crumb + 3 cm) keep the box: planes there folded the UVs of the crowded end stations
      uv(plane, at=(0, 0, 0), facing=+Z, up=(0, $Uf, 0), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=+Z, value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
      uv(plane, at=(0, 0, 0), facing=(0, 0.7071, 0.7071), up=(0, $Uf, 0), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=(0, 0.9914, 0.1305), facing=(0, 0.1305, 0.9914), value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
      uv(plane, at=(0, 0, 0), facing=(0, -0.7071, 0.7071), up=(0, $Uf, 0), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=(0, -0.9914, 0.1305), facing=(0, -0.1305, 0.9914), value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
      uv(plane, at=(0, 0, 0), facing=+Y, up=(0, 0, 1), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=(0, 0.966, -0.259), facing=(0, 0.966, 0.259), value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
      uv(plane, at=(0, 0, 0), facing=-Y, up=(0, 0, 1), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=(0, -0.966, -0.259), facing=(0, -0.966, 0.259), value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
      uv(plane, at=(0, 0, 0), facing=(0.7071, 0, 0.7071), up=(0, $Uf, 0), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=(0.9914, 0, 0.1305), facing=(0.1305, 0, 0.9914), value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
      uv(plane, at=(0, 0, 0), facing=(-0.7071, 0, 0.7071), up=(0, $Uf, 0), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=(-0.9914, 0, 0.1305), facing=(-0.1305, 0, 0.9914), value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
      uv(plane, at=(0, 0, 0), facing=+X, up=(0, $Uf, 0), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=(0.7934, 0, -0.6088), facing=(0.7934, 0, 0.6088), value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
      uv(plane, at=(0, 0, 0), facing=-X, up=(0, $Uf, 0), scale=($aspectC * $tileC, $tileC), offset=($Uo, $Vo)) [facing=(-0.7934, 0, -0.6088), facing=(-0.7934, 0, 0.6088), value=min(point.y, $lage - point.y), above=$crumbC * $dv + 3]
    } else {
      uv(none)
    }
  }
  material($Face)
  if ($dmg > 0.001) {
    material($Broken) [cut]
  }
}

