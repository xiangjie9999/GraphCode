  $jr6 = sin($key * 12.9898 + 903.6) * 43758.5453
  $jr6 = $jr6 - floor($jr6)
  $jv1 = sin($key * 12.9898 + 915.5) * 43758.5453
  $jv1 = $jv1 - floor($jv1)
  $jv2 = sin($key * 12.9898 + 927.4) * 43758.5453
  $jv2 = $jv2 - floor($jv2)
  $jv3 = sin($key * 12.9898 + 939.3) * 43758.5453
  $jv3 = $jv3 - floor($jv3)
  $jv4 = sin($key * 12.9898 + 951.2) * 43758.5453
  $jv4 = $jv4 - floor($jv4)
  $jv5 = sin($key * 12.9898 + 963.1) * 43758.5453
  $jv5 = $jv5 - floor($jv5)
  $je0 = sin($key * 12.9898 + 975.0) * 43758.5453
  $je0 = $je0 - floor($je0)
  $je1 = sin($key * 12.9898 + 986.9) * 43758.5453
