gcshape 1  into:/Game/GraphCodeMarket/GraphCode/TimberKitUltra  smooth:0.5  shade:40

# TIMBER KIT, ULTRA TIER: each TimberKit subject at `budget=2` (its third tier, the heavy one), in a file of its own
# so the kit builds in a few minutes and these lines are built only when wanted (kit §12.1: the budget is the
# author's). One recipe: the same entry and seed as the kit's Game and High lines.
# GENERATED by `Content/__MCPTests/DamageKit/gen/gentimber.py`; edit the generator, never this file.

build {
  SM_AgedBoard_Ultra             = $AgedBoardUltra           [pivot=base]
  SM_Walkway_Aged_Ultra          = $WalkwayAgedUltra         [bounds=(300, 180, *), pivot=(0, 0, 0)]
  SM_Walkway_Decayed_Ultra       = $WalkwayDecayedUltra      [bounds=(300, 180, *), pivot=(0, 0, 0)]
  SM_Walkway_Broken_Ultra        = $WalkwayBrokenUltra       [bounds=(300, 180, *), pivot=(0, 0, 0)]
  SM_Walkway_Broken_Debris_Ultra = $WalkwayBrokenDebrisUltra [pivot=(0, 0, 0)]
  SM_BoardWall_Aged_Ultra        = $BoardWallAgedUltra       [bounds=(200, *, *), pivot=(0, 0, 0)]
  SM_BoardWall_Snapped_Ultra     = $BoardWallSnappedUltra    [bounds=(200, *, *), pivot=(0, 0, 0)]
  SM_BoardWall_Holed_Ultra       = $BoardWallHoledUltra      [bounds=(200, *, *), pivot=(0, 0, 0)]
  SM_BoardWall_Holed_Debris_Ultra = $BoardWallHoledDebrisUltra [pivot=(0, 0, 0)]
}

Kit = shape('/GraphCodeShape/Presets/TimberKit')

AgedBoardUltra           = mesh() { add($Kit.AgedBoard, noise=3, index=2, budget=2) }
WalkwayAgedUltra         = mesh() { add($Kit.Walkway, damage=0.0, age=1.0, noise=6, budget=2) }
WalkwayDecayedUltra      = mesh() { add($Kit.Walkway, damage=0.0, age=1.8, noise=6, budget=2) }
WalkwayBrokenUltra       = mesh() { add($Kit.Walkway, damage=0.5, age=1.8, noise=6, budget=2) }
WalkwayBrokenDebrisUltra = mesh() { add($Kit.WalkwayDebris, damage=0.5, age=1.8, noise=6, budget=2) }
BoardWallAgedUltra       = mesh() { add($Kit.BoardWall, damage=0.0, age=1.0, noise=6, budget=2) }
BoardWallSnappedUltra    = mesh() { add($Kit.BoardWall, damage=0.5, age=1.0, mode=0, noise=6, budget=2) }
BoardWallHoledUltra      = mesh() { add($Kit.BoardWall, damage=0.5, age=1.0, mode=1, noise=6, budget=2) }
BoardWallHoledDebrisUltra = mesh() { add($Kit.BoardWallDebris, damage=0.5, age=1.0, noise=6, budget=2) }
