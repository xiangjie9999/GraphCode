gcshape 1  into:/Game/GraphCodeMarket/GraphCode/UnderstoryKit  smooth:0.25  shade:60

# UnderstoryFlowers: builds one group of the understory parts from Understory.gcshape (one file per group: the 8M resident
# triangle ceiling is per build).

build {
  SM_Und_Flower_Daisy = $DemoDaisy [pivot=(0, 0, 0)]
  SM_Und_Flower_Poppy = $DemoPoppy [pivot=(0, 0, 0)]
  SM_Und_Flower_Bluebell = $DemoBluebell [pivot=(0, 0, 0)]
  SM_Und_Flower_Foxglove = $DemoFoxglove [pivot=(0, 0, 0)]
}

DemoDaisy = mesh() { add($U.KitFlower, species=0, stems=4, noise=21, join=none)  uv(keep) }
DemoPoppy = mesh() { add($U.KitFlower, species=1, stems=3, noise=23, join=none)  uv(keep) }
DemoBluebell = mesh() { add($U.KitFlower, species=2, stems=2, noise=25, join=none)  uv(keep) }
DemoFoxglove = mesh() { add($U.KitFlower, species=3, noise=27, join=none)  uv(keep) }
U = shape('/GraphCodeShape/Presets/UnderstoryKit')
