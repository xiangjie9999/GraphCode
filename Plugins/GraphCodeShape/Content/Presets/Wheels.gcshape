gcshape 1  into:/Game/GraphCodeMarket/GraphCode/Wheels  smooth:0.5  shade:40

# WHEELS — a tyre whose tread is MOVED into it rather than cut out of it (2026-10-30).
#
#   Wheels = shape('/GraphCodeShape/Presets/Wheels')
#   Car = mesh() {
#     add($Body)
#     add($Wheels.Tyre, r=33.0, w=22.0, at=(140.0, 85.0, 33.0), rotate=(90.0, 0.0, 0.0))
#   }
#
# WHY NOT CUTTERS: the 28 Oct field report's tyre cut its tread with `subtract` arrays, and "where the
# tread cuts meet the tyre, 130 of 436 checked spots fold and 50 of 54 cross" — a boolean grazing a round
# surface leaves slivers. Here the tread is a `warp`: every point of the band moves IN along its own
# normal by a groove pattern of where it is. No boolean runs, no triangle is made or broken, so the
# tyre stays one closed piece and nothing can fold or cross.
#
# THE CONTRACT IS SOLIDS': at the origin, round the z axis, lying on z = 0 (its mounting face), one
# slot, and parameters named for what an author knows — `r` the outside radius, `w` the width across
# the tread, `wall` how deep the section is from tread to bead, `grooves` how many run across the tread,
# `depth` how deep they are. Turn it on its side with `rotate=(90, 0, 0)` to stand it on a road.

build {
  SM_Wheels_Tyre = $Tyre
}

Rubber = material()

# The tread pattern, for any round band about z: grooves ACROSS the band, `grooves` of them round the
# circle, and one groove round its middle. Each point moves in along its normal by `depth` where a groove
# is and not at all between them. The band factor keeps the move on the TREAD — full within 0.15 cm of
# the outside radius `r`, nothing below 0.4 cm — and off the shoulders: moving in along the normal on a
# convex edge pushes its two sides toward each other, and they fold (measured 2026-10-30: 708 triangles
# turned over where an earlier band reached the shoulder's facets). A groove's walls slope over
# about 0.65 cm, wider than the points under them: a wall steeper than its points can follow came
# back with a jagged staircase edge in the first render (2026-10-30), and a moulded tread has a
# chamfered edge anyway.
Tread = instruction(r=32.0, w=20.0, grooves=24, depth=0.8) {
  warp(by=-$depth * max(clamp((cos($grooves * atan2(point.y, point.x)) - 0.7) * 4, 0, 1), clamp((cos(360 * point.z / $w) - 0.9) * 10, 0, 1)) * clamp((sqrt(point.x * point.x + point.y * point.y) - ($r - 0.4)) * 4, 0, 1))
}

# A tyre: a rounded section revolved into a ring (`revolve` centres it on z = 0), the tread moved in,
# then lifted onto z = 0. The ring is cut in 96 and its shoulders in 8, so the tread is a near-true
# circle (an 18-sided one sat half a centimetre inside `r` at every flat) and no edge the grooves reach
# is sharp. `[smooth=2]` gives the band points about 0.4 cm apart, so a groove's walls are steep and
# its floor is flat.
Tyre = mesh(r=32.0, w=20.0, wall=8.0, grooves=24, depth=0.8) {
  rect(w=$wall, h=$w)
  round($wall * 0.3, segments=8)
  revolve(offset=$r - $wall / 2, segments=96)
  $Tread(r=$r, w=$w, grooves=$grooves, depth=$depth) [smooth=2.0]
  place(by=(0.0, 0.0, $w / 2))
  material($Rubber)
}
