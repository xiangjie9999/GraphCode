  $Lmin = $js + 1.0
  $Lmax = 2 * $js - $joist_w_c - 6.0
  $rqG = 0.16 * 0.4 * $bw * 1.38 + $lean_c * $board_t_c + 0.5 * $bw * tan(4.0) + 1.5
  $rqP = 0.16 * $pdeep_c * $bw * 1.38 + $lean_c * $board_t_c + 0.5 * $bw * tan(0.33 * clamp($slant, 0.0, 20.0)) + 1.5
  # the crossers 1-3 (one board's middle piece each, fallen across the V): every value is a list over c; w[c][q] the draws h s x p y o q
  loop (3) {
    $cn = output.index
    loop (7) {
      $cq = output.index - 1
      $w[$cn][$cq] = $Hash($noise * 1009, floor(10 * (509.3 + 37.1 * $cn + 5.3 * $cq) + 0.5) / 10)
    }
    $h[$cn] = $cn
    if ($cn > 2.5) {
      $h[$cn] = 1 + floor(2 * $w[$cn][0])
    }
    $g[$cn] = clamp(2 - $h[$cn], 0, 1)
    $cvd[$cn] = ($g[$cn]) * ($vd1) + (1 - ($g[$cn])) * ($vd2)
    $cvy[$cn] = ($g[$cn]) * ($vy1) + (1 - ($g[$cn])) * ($vy2)
    $cxb[$cn] = ($g[$cn]) * ($xb1) + (1 - ($g[$cn])) * ($xb2)
    $cza[$cn] = ($g[$cn]) * ($za1) + (1 - ($g[$cn])) * ($za2)
    $cXA[$cn] = ($g[$cn]) * ($XA1) + (1 - ($g[$cn])) * ($XA2)
    $cXB[$cn] = ($g[$cn]) * ($XB1) + (1 - ($g[$cn])) * ($XB2)
    $cP0[$cn] = ($g[$cn]) * (max($XA1, $xc1) + 6.0) + (1 - ($g[$cn])) * ($XA2 + 20.0)
    $cP1[$cn] = ($g[$cn]) * ($XB1 - 20.0) + (1 - ($g[$cn])) * (min($XB2, $xc2) - 6.0)
    $sg[$cn] = 2 * $g[$cn] - 1
    $xP[$cn] = $cP0[$cn] + max($cP1[$cn] - $cP0[$cn], 0) * $w[$cn][2]
    $dP[$cn] = max($sg[$cn] * ($xP[$cn] - $cxb[$cn]), 0)
    $sl[$cn] = 1 + floor(2 * $w[$cn][1])
    $ys[$cn] = 3 - 2 * $sl[$cn]
    $ye[$cn] = $yv + $sg[$cn] * $dP[$cn] * tan($cvy[$cn]) - $ys[$cn] * 0.5 * $joist_w_c
    $ze[$cn] = $cza[$cn] - $dP[$cn] / cos($cvy[$cn]) * tan($cvd[$cn])
    $me[$cn] = -$sg[$cn] * tan($cvd[$cn]) / cos($cvy[$cn])
    $H[$cn] = $ze[$cn] + $below_c - 0.8
    $su[$cn] = -$sg[$cn]
    $pe[$cn] = max(($H[$cn]) / sin($xlo_c + ($xhi_c - $xlo_c) * $w[$cn][3]), 1.0) * cos($xlo_c + ($xhi_c - $xlo_c) * $w[$cn][3])
    $pf[$cn] = asin(clamp((($g[$cn]) * ($cXB[$cn] - $xP[$cn]) + (1 - ($g[$cn])) * ($xP[$cn] - $cXA[$cn]) - 7.0) / $pe[$cn], 0.0, 0.999))
    $ps[$cn] = min($ylo_c + (clamp($yhi, 0.0, 85.0) - $ylo_c) * $w[$cn][4], $pf[$cn])
    $ux[$cn] = $su[$cn] * sin($ps[$cn])
    $uy[$cn] = $ys[$cn] * cos($ps[$cn])
    $fo[$cn] = 0.12 + 0.22 * $w[$cn][5]
    $pd[$cn] = $xlo_c + ($xhi_c - $xlo_c) * $w[$cn][3]
    $lf[$cn] = abs(tan($pd[$cn]) * $ux[$cn] - $me[$cn]) * 0.5 * $bw / cos($ps[$cn])
    $Wl[$cn] = abs($ye[$cn] - (2 - $sl[$cn]) * $fj[1] - ($sl[$cn] - 1) * $fj[2]) - 2.0 - 0.5 * $bw * sin($ps[$cn])
    $x_pa[$cn] = asin(clamp(($H[$cn] + $lf[$cn]) / ($Lmax * (1 - $fo[$cn]) + $rqG), 0.01, 0.999))
    $x_pb[$cn] = asin(clamp(($H[$cn] + $lf[$cn]) / ($Lmin * (1 - $fo[$cn]) + $rqG), 0.01, 0.999))
    $pc[$cn] = atan(max($H[$cn] + $lf[$cn], 0.1) * cos($ps[$cn]) / max($Wl[$cn], 1.0))
    $pl[$cn] = max($xlo_c, $x_pa[$cn], $pc[$cn])
    $ph[$cn] = min($xhi_c, $x_pb[$cn])
    $ok[$cn] = clamp(ceil(($ph[$cn] + 0.001) - ($pl[$cn])), 0, 1) * clamp(ceil(($H[$cn]) - (4.0)), 0, 1) * clamp(ceil(($cP1[$cn]) - ($cP0[$cn])), 0, 1) * clamp(ceil(($ps[$cn]) - ($ylo_c - 0.001)), 0, 1)
    $ph[$cn] = min(clamp($pd[$cn], $pl[$cn], max($pl[$cn], $ph[$cn])), 85.0)
    $lf[$cn] = abs(tan($ph[$cn]) * $ux[$cn] - $me[$cn]) * 0.5 * $bw / cos($ps[$cn]) + 0.3
    $Pz[$cn] = $ze[$cn] + $lf[$cn]
    $d[$cn] = max(($Pz[$cn] + $below_c - 0.8) / sin($ph[$cn]) - $rqG, 1.0)
    $Wh[$cn] = abs((2 - $sl[$cn]) * $fj[2] + ($sl[$cn] - 1) * $fj[1] - $ye[$cn]) - 2.0 - 0.5 * $bw * sin($ps[$cn])
    $qT[$cn] = $Pz[$cn] - $d[$cn] * sin($ph[$cn]) + $board_t_c * cos($ph[$cn]) + $board_t_c
    $qY[$cn] = $ye[$cn] - $d[$cn] * cos($ph[$cn]) * $uy[$cn]
    $qL[$cn] = 0.5 * $bw * sin($ps[$cn]) * tan($xcone_c) + 0.5
    $c1[$cn] = (-$qL[$cn] - $qT[$cn] - ($qY[$cn] - $fj[1]) * tan($xcone_c)) / max(sin($ph[$cn]) + $uy[$cn] * cos($ph[$cn]) * tan($xcone_c), 0.05) - $d[$cn]
    $c2[$cn] = (-$qL[$cn] - $qT[$cn] - ($fj[2] - $qY[$cn]) * tan($xcone_c)) / max(sin($ph[$cn]) - $uy[$cn] * cos($ph[$cn]) * tan($xcone_c), 0.05) - $d[$cn]
    $o[$cn] = min($d[$cn] * $fo[$cn] / (1 - $fo[$cn]), $Wh[$cn] / (cos($ph[$cn]) * cos($ps[$cn])) - $rqG, $c1[$cn] - $rqG * 0.5, $c2[$cn] - $rqG * 0.5)
    $ok[$cn] = $ok[$cn] * clamp(ceil(($o[$cn]) - (3.0)), 0, 1)
    $o[$cn] = max($o[$cn], 0)
    $Lc[$cn] = $d[$cn] + $o[$cn]
    $ok[$cn] = $ok[$cn] * clamp(ceil(($Lc[$cn]) - ($Lmin)), 0, 1) * clamp(ceil(($Lmax) - ($Lc[$cn])), 0, 1)
    $Qx[$cn] = $xP[$cn] - $d[$cn] * cos($ph[$cn]) * $ux[$cn]
    $Qy[$cn] = $ye[$cn] - $d[$cn] * cos($ph[$cn]) * $uy[$cn]
    $Qz[$cn] = $Pz[$cn] - $d[$cn] * sin($ph[$cn])
    $xm[$cn] = $Qx[$cn] + min(-$rqG * cos($ph[$cn]) * $ux[$cn], ($Lc[$cn] + $rqG) * cos($ph[$cn]) * $ux[$cn]) - 0.5 * $bw * abs($uy[$cn]) - 2.0
    $xM[$cn] = $Qx[$cn] + max(-$rqG * cos($ph[$cn]) * $ux[$cn], ($Lc[$cn] + $rqG) * cos($ph[$cn]) * $ux[$cn]) + 0.5 * $bw * abs($uy[$cn]) + 2.0
    $ok[$cn] = $ok[$cn] * clamp(ceil(($xm[$cn]) - ($cXA[$cn])), 0, 1) * clamp(ceil(($cXB[$cn]) - ($xM[$cn])), 0, 1) * clamp(ceil(($cXB[$cn] - $cXA[$cn]) - (20.0)), 0, 1)
    $ce[$cn] = $ok[$cn] * clamp(ceil((clamp($cross, 0.0, 3.0) + 0.5) - ($cn)), 0, 1)
    if ($cn > 1.5) {
      loop (repeat=$cn - 1) {
        $cm = output.index
        $ce[$cn] = $ce[$cn] * (1 - $ce[$cm] * clamp(ceil(($xM[$cm] + 2.0) - ($xm[$cn])), 0, 1) * clamp(ceil(($xM[$cn] + 2.0) - ($xm[$cm])), 0, 1))
      }
    }
    $x_src[$cn] = clamp(floor(0.5 * ($xm[$cn] + $xM[$cn]) / $pitch), $iL, $iR)
    if ($cn > 1.5) {
      loop (repeat=$cn - 1) {
        $cm = output.index
        $ce[$cn] = $ce[$cn] * (1 - $ce[$cm] * clamp(1 - abs(($x_src[$cn]) - ($x_src[$cm])), 0, 1))
      }
    }
    $x_ss[$cn] = 1 + floor(2 * $w[$cn][6])
    $yw[$cn] = atan2(-$ux[$cn], $uy[$cn])
    $Tx[$cn] = $Qx[$cn] - $board_t_c * $ux[$cn] * sin($ph[$cn])
    $Ty[$cn] = $Qy[$cn] - $board_t_c * $uy[$cn] * sin($ph[$cn])
    $Tz[$cn] = $Qz[$cn] + $board_t_c * cos($ph[$cn])
    $x_cB[$cn] = $ux[$cn] * tan($ph[$cn])
    $cC[$cn] = $uy[$cn] * tan($ph[$cn])
    $x_cA[$cn] = $Tz[$cn] - $x_cB[$cn] * $Tx[$cn] - $cC[$cn] * $Ty[$cn]
    $ax[$cn] = $ux[$cn] * cos($ph[$cn])
    $ay[$cn] = $uy[$cn] * cos($ph[$cn])
    $az[$cn] = sin($ph[$cn])
    $axd[$cn] = max(abs($ax[$cn]), 0.001) * (2 * clamp(ceil($ax[$cn] * 1000), 0, 1) - 1)
  }
  $qm1 = $Hash($noise * 1009, 3541.7)
  $qm2 = $Hash($noise * 1009, 3617.3)
  $DK = $decay_c + (1 - clamp(ceil($decay_c + 0.5), 0, 1)) * (clamp(($AGE - 1.1) / 0.7, 0, 1) - $decay_c)
  $qs1 = $Hash($noise * 1009, 3701.3)
  $qs2 = $Hash($noise * 1009, 3779.9)
  $reach = 0.5 * $js + 2.0
  $hx = 0.5 * ($iL + $iR + 1) * $pitch
  $grx = min(clamp($grow, 1.0, 2.5) * 0.5 * ($iR - $iL + 1) * $pitch, min($hx, $SX - $hx) + 20.0 - $reach)
  $gry = 12.0
  # round 8 (debris rubric P2, P3): each fallen piece is DROPPED from over where it was, pulled `heap` toward the
  # V, and SETTLES (G31) on the ground, the Wreck's members that reach it, and the pieces already down
  $HP = 1 - clamp($heap, 0.0, 0.9)
  groundA = add($Disc, scale=(max($grx, 1.0), $gry, 1.0), at=($hx, $fj[1] - 2.0, -1.0))
  groundB = add($Disc, scale=(max($grx, 1.0), $gry, 1.0), at=($hx, $fj[2] + 2.0, -1.0))
  $sb1 = max(($below_c - $vh - $band_c) / sin($vd1), 0)
  if ($xs + $vreach_c - $sb1 > 0.5) {
    add($Stop, width=$joist_w_c + 1.0, thick=$joist_d_c + 1.0, length=$xs + $vreach_c - $sb1, at=($xb1 + 1 * $sb1 * cos($vd1) * cos($vy1), $yv + 1 * $sb1 * cos($vd1) * sin($vy1), -$vh - $sb1 * sin($vd1) - 0.5 + $below_c), rotate=($vd1, 0.0, -90.0 + $vy1), join=none)
  }
  $sb2 = max(($below_c - $vh - $band_c) / sin($vd2), 0)
  if ($SX - $xs + $vreach_c - $sb2 > 0.5) {
    add($Stop, width=$joist_w_c + 1.0, thick=$joist_d_c + 1.0, length=$SX - $xs + $vreach_c - $sb2, at=($xb2 + -1 * $sb2 * cos($vd2) * cos($vy2), $yv + -1 * $sb2 * cos($vd2) * sin($vy2), -$vh - $sb2 * sin($vd2) - 0.5 + $below_c), rotate=($vd2, 0.0, 90.0 + $vy2), join=none)
  }
  # the crossers: a board's middle piece fallen across the V
  loop (3) {
    $cn = output.index
    if ($ce[$cn] > 0.5) {
      add($Stop, width=$bw + 1.0, thick=$board_t_c + 1.0, length=min($Lc[$cn] + 2 * $rqG, $rqG + max($band_c - $Qz[$cn] - $below_c, 0) / sin($ph[$cn])), at=($Qx[$cn] - $rqG * $ax[$cn], $Qy[$cn] - $rqG * $ay[$cn], $Qz[$cn] - $rqG * $az[$cn] - 0.5 + $below_c), rotate=(-$ph[$cn], 0.0, $yw[$cn]), join=none)
    }
  }
  $pa = 0
  $pb = 0
  loop (repeat=$n) {
    $i = output.index - 1
    $ub0 = $Hash(($fseed * 1009 + $i), 2111.3)
    $ub1 = $Hash(($fseed * 1009 + $i + 1), 2111.3)
    $vb0 = $Hash(($fseed * 1009 + $i), 2237.9)
    $vb1 = $Hash(($fseed * 1009 + $i + 1), 2237.9)
    $Xl = ($i) * $pitch + clamp($i, 0, 1) * clamp($wjit, 0.0, 0.25) * $FLY * $pitch * (2 * $ub0 - 1) * (1.5 - 0.5 * (2 * $ub0 - 1) * (2 * $ub0 - 1))
    $Xr = ($i + 1) * $pitch + clamp($n - 1 - ($i), 0, 1) * clamp($wjit, 0.0, 0.25) * $FLY * $pitch * (2 * $ub1 - 1) * (1.5 - 0.5 * (2 * $ub1 - 1) * (2 * $ub1 - 1))
    $gl = (clamp($i, 0, 1)) * ($gapmin_c + (clamp($gapmax, 0.0, 2.0) - $gapmin_c) * $F * $vb0) + (1 - (clamp($i, 0, 1))) * (clamp($egap, 0.0, 1.0))
    $gr = (clamp($n - 1 - ($i), 0, 1)) * ($gapmin_c + (clamp($gapmax, 0.0, 2.0) - $gapmin_c) * $F * $vb1) + (1 - (clamp($n - 1 - ($i), 0, 1))) * (clamp($egap, 0.0, 1.0))
    $lw = $Xr - $Xl - 0.5 * ($gl + $gr)
    $x = $Xl + 0.5 * $gl + 0.5 * $lw
    $jd1 = $Hash(($fseed * 1009 + $i), 2363.1)
    $jd2 = $Hash(($fseed * 1009 + $i), 2489.3)
    $jd3 = $Hash(($fseed * 1009 + $i), 2531.7)
    $jd4 = $Hash(($fseed * 1009 + $i), 2677.9)
    $jd5 = $Hash(($fseed * 1009 + $i), 2711.3)
    $jd6 = $Hash(($fseed * 1009 + $i), 2857.9)
    $jd7 = $Hash(($fseed * 1009 + $i), 2903.7)
    $jd8 = $Hash(($fseed * 1009 + $i), 2971.1)
    $jd9 = $Hash(($fseed * 1009 + $i), 3049.3)
    $jd10 = $Hash(($fseed * 1009 + $i), 3121.9)
    $nint = $joists_c - 2
    $ja0 = clamp(ceil($jd1 - $pnone_c), 0, 1) * clamp(1 + floor($nint * ($jd1 - $pnone_c) / max(1 - $pnone_c, 0.001)), 1, $nint)
    $jc1 = clamp(ceil(($ja0) - (0.5)), 0, 1) * max(clamp(1 - abs(($ja0) - ($pa)), 0, 1), clamp(1 - abs(($ja0) - ($pb)), 0, 1))
    $ja1 = $ja0 + $jc1 * (1 + (($ja0) - ($nint) * floor(($ja0) / ($nint))) - $ja0)
    $jc2 = $jc1 * max(clamp(1 - abs(($ja1) - ($pa)), 0, 1), clamp(1 - abs(($ja1) - ($pb)), 0, 1))
    $ja2 = $ja1 + $jc2 * (1 + (($ja1) - ($nint) * floor(($ja1) / ($nint))) - $ja1)
    $jc3 = $jc2 * max(clamp(1 - abs(($ja2) - ($pa)), 0, 1), clamp(1 - abs(($ja2) - ($pb)), 0, 1))
    $ja = $ja2 * (1 - $jc3)
    $jb = clamp(ceil(($ja) - (0.5)), 0, 1) * clamp(ceil(($nint + 0.5) - ($ja + 2)), 0, 1) * clamp(ceil((clamp($ptwo, 0.0, 1.0)) - ($jd2)), 0, 1) * (1 - max(clamp(1 - abs(($ja + 2) - ($pa)), 0, 1), clamp(1 - abs(($ja + 2) - ($pb)), 0, 1))) * ($ja + 2)
    $pa = $ja
    $pb = $jb
    $h1 = clamp(ceil(($ja) - (0.5)), 0, 1)
    $h2 = clamp(ceil(($jb) - (0.5)), 0, 1)
    $jy1 = ($h1) * (($ja + 0.5) * $js) + (1 - ($h1)) * ($SY)
    $jy2 = ($h2) * (($jb + 0.5) * $js) + (1 - ($h2)) * ($SY)
    $hb1 = 0.5 * ($bgmin_c + (clamp($bgmax, 0.05, 2.0) - $bgmin_c) * $jd3)
    $hb2 = 0.5 * ($bgmin_c + (clamp($bgmax, 0.05, 2.0) - $bgmin_c) * $jd4)
    $fa0 = 0.6 * clamp($endsq, 0.0, 5.0) * $F * (2 * $jd8 - 1)
    $fa3 = 0.6 * clamp($endsq, 0.0, 5.0) * $F * (2 * $jd10 - 1)
    $ei0 = clamp($einset, 0.02, 40.0) + clamp($eivar, 0.0, 20.0) * $F * $jd7 + 0.5 * $bw * abs(tan($fa0))
    $ei1 = clamp($einset, 0.02, 40.0) + clamp($eivar, 0.0, 20.0) * $F * $jd9 + 0.5 * $bw * abs(tan($fa3))
    $sab[0] = ($ei0, ($h1) * ($jy1 - $hb1) + (1 - ($h1)) * ($SY - $ei1))
    $sab[1] = ($jy1 + $hb1, ($h2) * ($jy2 - $hb2) + (1 - ($h2)) * ($SY - $ei1))
    $sab[2] = ($jy2 + $hb2, $SY - $ei1)
    $K = $noise * 1009 + $i
    $ins = clamp(ceil($sx - abs($x - $cx)), 0, 1)
    # wd[k]: dnb dnm dmw dsw hd1 hd2 tfs rr1 rr2 rr3 dfa dfb lsd lg1 lg2 (the board's own draws); kd[place][kind]: the five break places S1 MA SV MB S2, kind p l dr sr vr hn hh a r e
    loop (15) {
      $ix = output.index - 1
      $wd[$ix] = $Hash($K, floor(10 * (907.3 + 13.7 * $ix) + 0.5) / 10)
    }
    loop (5) {
      $sll = output.index - 1
      loop (10) {
        $mk = output.index - 1
        $kd[$sll][$mk] = $Hash($K, floor(10 * (907.3 + 13.7 * (15 + 10 * $sll + $mk)) + 0.5) / 10)
      }
    }
    $d1b = max($x - 0.5 * $bw - $xb1, 0) / cos($vy1)
    $d2b = max($xb2 - $x - 0.5 * $bw, 0) / cos($vy2)
    $u2b = clamp(ceil(($xt2 + 0.5) - ($d2b)), 0, 1)
    $u1b = max(clamp(ceil(($xt1 + 0.5) - ($d1b)), 0, 1), 1 - $u2b)
    $D1b = max($d1b, $joist_d_c * sin($vd1)) * tan($vd1) - $joist_d_c * (1 / cos($vd1) - 1)
    $D2b = max($d2b, $joist_d_c * sin($vd2)) * tan($vd2) - $joist_d_c * (1 / cos($vd2) - 1)
    $Dx = min(($u1b) * ($D1b) + (1 - ($u1b)) * (60.0), ($u2b) * ($D2b) + (1 - ($u2b)) * (60.0))
    $y1b = $yv + ($x - $xb1) * tan($vy1)
    $y2b = $yv - ($xb2 - $x) * tan($vy2)
    $yn[1] = min(($u1b) * ($y1b) + (1 - ($u1b)) * (999.0), ($u2b) * ($y2b) + (1 - ($u2b)) * (999.0)) - 0.5 * $joist_w_c - 0.3
    $yn[2] = max(($u1b) * ($y1b) + (1 - ($u1b)) * (-999.0), ($u2b) * ($y2b) + (1 - ($u2b)) * (-999.0)) + 0.5 * $joist_w_c + 0.3
    $yvb = 0.5 * ($yn[1] + $yn[2])
    $dn[1] = $yn[1] - $fj[1]
    $dn[2] = $fj[2] - $yn[2]
    $df[1] = $yn[2] - $fj[1]
    $df[2] = $fj[2] - $yn[1]
    $sag = $ins * clamp(ceil(($dsag_c) - ($Dx)), 0, 1)
    $brk = $ins - $sag
    $shl = $brk * clamp(ceil(($Dsg) - ($Dx)), 0, 1)
    $nb = 2 + clamp(ceil(clamp($pthree, 0.0, 1.0) - $wd[0]), 0, 1)
    $n2 = clamp(1 - abs(($nb) - (2)), 0, 1)
    $nm = $n2 * (clamp(ceil($wd[1] - 0.75 + $pmid_c), 0, 1) + clamp(ceil($wd[1] - 1.25 + $pmid_c), 0, 1)) + (1 - $n2) * (1 + clamp(ceil($wd[1] - 2 + 3 * $pmid_c), 0, 1))
    $nsp = $nb - $nm
    $bk[1] = clamp($nm - 1, 0, 1) + clamp(1 - abs(($nm) - (1)), 0, 1) * clamp(ceil(0.5 - $wd[2]), 0, 1)
    $bk[3] = $nm - $bk[1]
    $sk = floor(3 * $wd[3])
    $z0 = clamp(1 - abs(($sk) - (0)), 0, 1)
    $z1 = clamp(1 - abs(($sk) - (1)), 0, 1)
    $z2 = clamp(1 - abs(($sk) - (2)), 0, 1)
    $p3 = clamp(1 - abs(($nsp) - (3)), 0, 1)
    $p2 = clamp(1 - abs(($nsp) - (2)), 0, 1)
    $p1 = clamp(1 - abs(($nsp) - (1)), 0, 1)
    $bk[0] = $p3 + $p1 * $z0 + $p2 * (1 - $z0)
    $bk[2] = $p3 + $p1 * $z1 + $p2 * (1 - $z1)
    $bk[4] = $p3 + $p1 * $z2 + $p2 * (1 - $z2)
    $jkv = $brk * max(clamp(1 - abs(($ja) - ($kv)), 0, 1), clamp(1 - abs(($jb) - ($kv)), 0, 1))
    $bk[2] = max($bk[2], $jkv)
    $yk[0] = $fj[1] - 1.5 + 4.0 * $kd[0][0]
    $yk[1] = $fj[1] + 5.0 + ($yn[1] - $fj[1] - 10.0) * $kd[1][0]
    $yk[2] = $yvb - 2.0 + 4.0 * $kd[2][0]
    $yk[3] = $yn[2] + 5.0 + ($fj[2] - $yn[2] - 10.0) * $kd[3][0]
    $yk[4] = $fj[2] + 1.5 - 4.0 * $kd[4][0]
    $fA = $shl * (1 - $bk[0]) * (1 - $bk[1])
    $cA = clamp(ceil(0.5 - $wd[10]), 0, 1)
    $bk[0] = max($bk[0], $fA * $cA)
    $bk[1] = max($bk[1], $fA * (1 - $cA))
    $fB = $shl * (1 - $bk[4]) * (1 - $bk[3])
    $cB = clamp(ceil(0.5 - $wd[11]), 0, 1)
    $bk[4] = max($bk[4], $fB * $cB)
    $bk[3] = max($bk[3], $fB * (1 - $cB))
    # the crossers over this board and this column
    loop (3) {
      $cn = output.index
      $sc[$cn] = $ce[$cn] * clamp(1 - abs(($i) - ($x_src[$cn])), 0, 1)
      $cr[$cn] = $ce[$cn] * clamp(ceil(($x + 0.5 * $pitch) - ($xm[$cn])), 0, 1) * clamp(ceil(($xM[$cn]) - ($x - 0.5 * $pitch)), 0, 1)
    }
    # the break kind of each place (round 3-4: short or long, spires, slant, a horn now and then, torn ends on short ones)
    loop (5) {
      $sll = output.index - 1
      $lgS[$sll] = clamp(ceil(clamp($long, 0.0, 1.0) - $kd[$sll][1]), 0, 1)
      $dpS[$sll] = (clamp($deep, 0.2, 1.5) + (clamp($ldeep, 0.4, 2.5) - clamp($deep, 0.2, 1.5)) * $lgS[$sll]) * (0.85 + 0.3 * $kd[$sll][2])
      $spS[$sll] = clamp($splint, 0.2, 2.0) * (0.6 + 0.8 * $kd[$sll][3])
      $vpS[$sll] = 0.4 + 0.6 * $kd[$sll][4]
      $tnS[$sll] = clamp($torn, 0.0, 1.0) * (1 - $lgS[$sll])
      $hnS[$sll] = clamp(ceil(clamp($horn, 0.0, 1.0) - $kd[$sll][5]), 0, 1) * (1.2 + 1.3 * $kd[$sll][6]) * (1 - clamp(ceil($tnS[$sll]), 0, 1))
      $aS[$sll] = clamp($slant, 0.0, 20.0) * (2 * $kd[$sll][7] - 1)
      $rS[$sll] = $grain_c * (0.75 + 0.5 * $kd[$sll][8])
      $eS[$sll] = $lean_c * (0.6 + 0.8 * $kd[$sll][9])
      $rqS[$sll] = 0.16 * $dpS[$sll] * $bw * (1 + 0.3 * $spS[$sll] + 0.2 * $vpS[$sll]) + 0.5 * $eS[$sll] * $board_t_c + 0.6 * $hnS[$sll] * $board_t_c + 0.5 * $bw * tan(abs($aS[$sll])) + 1.5 + clamp(ceil($tnS[$sll]), 0, 1)
      $kS[$sll] = $K * 16 + $sll
    }
    $src = $brk * max($sc[1], $sc[2], $sc[3])
    $scs = $sc[1] * $x_ss[1] + $sc[2] * $x_ss[2] + $sc[3] * $x_ss[3]
    $sLc = $sc[1] * $Lc[1] + $sc[2] * $Lc[2] + $sc[3] * $Lc[3]
    $crd = max($cr[1], $cr[2], $cr[3])
    $f1 = $src * clamp(2 - $scs, 0, 1)
    $f2 = $src * clamp($scs - 1, 0, 1)
    $bk[0] = $f1 + (1 - $src) * $bk[0]
    $bk[1] = $f2 + (1 - $src) * $bk[1]
    $bk[2] = (1 - $src) * $bk[2]
    $bk[3] = $f1 + (1 - $src) * $bk[3]
    $bk[4] = $f2 + (1 - $src) * $bk[4]
    $yk[3] = ($f1) * ($yk[0] + $sLc) + (1 - ($f1)) * ($yk[3])
    $yk[1] = ($f2) * ($yk[4] - $sLc) + (1 - ($f2)) * ($yk[1])
    $Us = clamp(ceil(($yk[0]) - ($jy1)), 0, 1) + clamp(ceil(($yk[0]) - ($jy2)), 0, 1)
    $UA = $sab[$Us].x
    $Vs = clamp(ceil(($yk[4]) - ($jy1)), 0, 1) + clamp(ceil(($yk[4]) - ($jy2)), 0, 1)
    $VB = $sab[$Vs].y
    $jV = (clamp(1 - abs(($Vs) - (0)), 0, 1)) * $h1 + (clamp(1 - abs(($Vs) - (1)), 0, 1)) * $h2
    $bt1 = $brk * $bk[0] * clamp(ceil((6.0) - ($yk[0] - $UA)), 0, 1) * clamp(ceil(($Us) - (0.5)), 0, 1)
    $bt2 = $brk * $bk[4] * clamp(ceil((6.0) - ($VB - $yk[4])), 0, 1) * $jV
    $yk[0] = ($bt1) * ((clamp(1 - abs(($Us) - (1)), 0, 1)) * ($jy1 - $hb1) + (1 - (clamp(1 - abs(($Us) - (1)), 0, 1))) * ($jy2 - $hb2)) + (1 - ($bt1)) * ($yk[0])
    $yk[4] = ($bt2) * ((clamp(1 - abs(($Vs) - (0)), 0, 1)) * ($jy1 + $hb1) + (1 - (clamp(1 - abs(($Vs) - (0)), 0, 1))) * ($jy2 + $hb2)) + (1 - ($bt2)) * ($yk[4])
    $hSt = max($bk[1], $bk[0])
    $stI = ($bk[1]) * ($yk[1]) + (1 - ($bk[1])) * ($yk[0])
    $hEn = max($bk[3], $bk[4])
    $enI = ($bk[3]) * ($yk[3]) + (1 - ($bk[3])) * ($yk[4])
    $spI = $brk * (1 - $bk[2]) * $hSt * $hEn * (1 - $src)
    $sa = $yn[1] + 0.3 - $stI
    $sb = $enI - $yn[2] + 0.3
    $slo = 1 + clamp(ceil($sb - $sa), 0, 1)
    $sd = max($sa, $sb)
    $so = min($sa, $sb) + $yn[2] - $yn[1] - 0.6
    $zpc = -$board_t_c - $Dx
    $Hs = $zpc + $below_c - 0.8
    $rqL = $rqP
    $pgs = asin(clamp($Hs / max($sd + $rqL, 1.0), 0.0, 0.999))
    $wq = (clamp(1 - abs(($slo) - (1)), 0, 1)) * ($fj[2] - $yn[1] - 0.3) + (1 - (clamp(1 - abs(($slo) - (1)), 0, 1))) * ($yn[2] - 0.3 - $fj[1])
    $qA = $so + $board_t_c * tan($vlo_c)
    $qB = $board_t_c - $so * tan($vlo_c)
    $qC = -0.8 - ($zpc + 0.2 + $board_t_c + $wq * tan($vlo_c))
    $pcs = asin(clamp($qC / sqrt($qA * $qA + $qB * $qB), -1.0, 1.0)) - atan2($qB, $qA)
    $fsv = $spI * max($crd, clamp(ceil(($so) - (clamp($smax, 2.0, 40.0))), 0, 1), clamp(ceil(($vlo_c) - ($pgs)), 0, 1), clamp(ceil(($vlo_c) - ($pcs)), 0, 1))
    $bk[2] = max($bk[2], $fsv)
    $ss = $spI * (1 - $fsv)
    $phs = min($vlo_c + ($vhi_c - $vlo_c) * $wd[6], $pgs, $pcs)
    $sgr = $ss * clamp(ceil(($vlo_c + ($vhi_c - $vlo_c) * $wd[6]) - ($pgs)), 0, 1)
    $sLs = $enI - $stI
    $sdr = 3 - 2 * $slo
    $ypc = (clamp(1 - abs(($slo) - (1)), 0, 1)) * ($yn[1] + 0.3) + (1 - (clamp(1 - abs(($slo) - (1)), 0, 1))) * ($yn[2] - 0.3)
    $scx = cos($phs)
    $ssn = sin($phs)
    $sFy = $ypc + $sdr * 0.5 * ($so - $sd) * $scx
    $sFz = $zpc + 0.2 + 0.5 * ($so - $sd) * $ssn
    $sly = $ypc - $sdr * $sd * $scx - $sdr * $board_t_c * $ssn
    $slz = $zpc + 0.2 - $sd * $ssn + $board_t_c * $scx
    $shy = $ypc + $sdr * $so * $scx - $sdr * $board_t_c * $ssn
    $shz = $zpc + 0.2 + $so * $ssn + $board_t_c * $scx
    $r1 = $brk * (1 - $bk[0])
    $r2 = $brk * (1 - $bk[4])
    $j[1] = $bk[1] * 1 + (1 - $bk[1]) * ($bk[2] * 2 + (1 - $bk[2]) * ($bk[3] * 3 + (1 - $bk[3]) * 4))
    $e[1] = $bk[1] * $yk[1] + (1 - $bk[1]) * ($bk[2] * $yk[2] + (1 - $bk[2]) * ($bk[3] * $yk[3] + (1 - $bk[3]) * $yk[4]))
    $j[2] = $bk[3] * 3 + (1 - $bk[3]) * ($bk[2] * 2 + (1 - $bk[2]) * ($bk[1] * 1 + (1 - $bk[1]) * 0))
    $e[2] = $bk[3] * $yk[3] + (1 - $bk[3]) * ($bk[2] * $yk[2] + (1 - $bk[2]) * ($bk[1] * $yk[1] + (1 - $bk[1]) * $yk[0]))
    $L[1] = $e[1] - $fj[1]
    $L[2] = $fj[2] - $e[2]
    # each rim piece's break takes its place's kind
    loop (2) {
      $sd2 = output.index
      $rqE[$sd2] = $rqS[$j[$sd2]]
    }
    # the middle pieces: one from each break to the next break (from S1, MA, SV, MB); the next break is the first active place after it
    loop (4) {
      $pq = output.index - 1
      $pm = $bk[4]
      $peP[$pq] = $yk[4]
      $pjP[$pq] = 4
      if ($pq < 2.5) {
        loop (repeat=3 - $pq) {
          $pt = 4 - output.index
          $pm = max($pm, $bk[$pt])
          $peP[$pq] = $bk[$pt] * $yk[$pt] + (1 - $bk[$pt]) * $peP[$pq]
          $pjP[$pq] = $bk[$pt] * $pt + (1 - $bk[$pt]) * $pjP[$pq]
        }
      }
      $pxP[$pq] = $brk * $bk[$pq] * $pm
      $pLP[$pq] = $peP[$pq] - $yk[$pq]
      $pvP[$pq] = 0
      if ($pq < 1.5) {
        $pvP[$pq] = clamp(ceil(($pjP[$pq]) - (2.5)), 0, 1)
      }
      $pfP[$pq] = $pxP[$pq] * (1 - $pvP[$pq])
    }
    $zc = -$board_t_c - $Dx
    $Hc = $zc + $below_c - 0.8
    $zjb = $zc - $joist_d_c
    $lk[1] = $pfP[0] * clamp(1 - abs(($pjP[0]) - (2)), 0, 1) + $pfP[1] * clamp(1 - abs(($pjP[1]) - (2)), 0, 1)
    $ll[1] = $pfP[0] * clamp(1 - abs(($pjP[0]) - (2)), 0, 1) * $pLP[0] + $pfP[1] * clamp(1 - abs(($pjP[1]) - (2)), 0, 1) * $pLP[1]
    $lh[1] = $rqP
    $lk[2] = $pfP[2]
    $ll[2] = $pLP[2]
    $lh[2] = $rqP
    # each leaner: on the joist's top corner, or standing against its face
    loop (2) {
      $sdi = output.index
      $lk[$sdi] = $lk[$sdi] * (1 - $crd) * clamp(ceil(($ll[$sdi]) - (8.0)), 0, 1)
      $ll[$sdi] = max($ll[$sdi], 2.0)
      $lr[$sdi] = $Hc / max($ll[$sdi] - 1.5 + $lh[$sdi], 1.0)
      $pk[$sdi] = asin(clamp($lr[$sdi], 0.0, 0.999))
      $lv[$sdi] = $lk[$sdi] * clamp(ceil((0.985) - ($lr[$sdi])), 0, 1) * clamp(ceil(($pk[$sdi]) - ($vlo_c)), 0, 1)
      $pg[$sdi] = 62.0 + 18.0 * $wd[12 + $sdi]
      $lb[$sdi] = -$below_c + 0.8 + ($lh[$sdi] + $ll[$sdi] + $rqS[2]) * sin($pg[$sdi])
      $x_lw[$sdi] = $lk[$sdi] * clamp(ceil(($lb[$sdi]) - ($zjb + 1.0)), 0, 1) * clamp(ceil(($zc - 0.5) - ($lb[$sdi] + $board_t_c * cos($pg[$sdi]))), 0, 1)
    }
    $lc[1] = $lv[1] * (1 - $lv[2] * clamp(ceil(($wd[12]) - (0.5)), 0, 1))
    $lc[2] = $lv[2] * (1 - $lc[1])
    loop (2) {
      $sdi = output.index
      $lF[$sdi] = (1 - $lc[$sdi]) * $x_lw[$sdi]
      $lx[$sdi] = $lc[$sdi] + $lF[$sdi]
    }
    # where each leaner stands, and its top face's end corners
    loop (2) {
      $sdi = output.index
      $sgn = 3 - 2 * $sdi
      $lp[$sdi] = ($lc[$sdi]) * ($pk[$sdi]) + (1 - ($lc[$sdi])) * ($pg[$sdi])
      $ly[$sdi] = $yn[$sdi] + 0.3 * $sgn
      $lQy[$sdi] = ($lc[$sdi]) * ($ly[$sdi] - $sgn * ($ll[$sdi] - 1.5) * cos($lp[$sdi])) + (1 - ($lc[$sdi])) * ($ly[$sdi] - $sgn * (0.3 + ($ll[$sdi] + $rqS[2]) * cos($lp[$sdi])))
      $lQz[$sdi] = ($lc[$sdi]) * ($zc + 0.2 - ($ll[$sdi] - 1.5) * sin($lp[$sdi])) + (1 - ($lc[$sdi])) * (-$below_c + 0.8 + $lh[$sdi] * sin($lp[$sdi]))
      $lay[$sdi] = $lQy[$sdi] - $sgn * $board_t_c * sin($lp[$sdi])
      $laz[$sdi] = $lQz[$sdi] + $board_t_c * cos($lp[$sdi])
      $lby[$sdi] = $lay[$sdi] + $sgn * $ll[$sdi] * cos($lp[$sdi])
      $lbz[$sdi] = $laz[$sdi] + $ll[$sdi] * sin($lp[$sdi])
    }
    $pfP[0] = $pfP[0] * (1 - $lx[1] * clamp(1 - abs(($pjP[0]) - (2)), 0, 1))
    $pfP[1] = $pfP[1] * (1 - $lx[1] * clamp(1 - abs(($pjP[1]) - (2)), 0, 1))
    $pfP[2] = $pfP[2] * (1 - $lx[2])
    # the rim pieces' rest: each swings down about its hinge until it meets the V, a seesaw, a crosser or the ground, or hangs
    loop (2) {
      $sdi = output.index
      $sgn = 3 - 2 * $sdi
      $Lr[$sdi] = max($L[$sdi], 1.0)
      $Dv[$sdi] = max($Dx - 0.3, 0.01)
      $tn[$sdi] = atan($Dv[$sdi] / $dn[$sdi])
      $tf[$sdi] = atan($Dv[$sdi] / $df[$sdi])
      $tt[$sdi] = asin(clamp($Dv[$sdi] / $Lr[$sdi], 0.0, 0.999))
      $vn[$sdi] = clamp(ceil(($Lr[$sdi] * cos($tn[$sdi])) - ($dn[$sdi])), 0, 1)
      $vf[$sdi] = clamp(ceil(($Lr[$sdi] * cos($tf[$sdi])) - ($df[$sdi])), 0, 1)
      $vt[$sdi] = clamp(ceil(($Lr[$sdi] * cos($tt[$sdi])) - ($dn[$sdi])), 0, 1) * clamp(ceil(($df[$sdi]) - ($Lr[$sdi] * cos($tt[$sdi]))), 0, 1)
      $tV[$sdi] = min(($vf[$sdi]) * ($tf[$sdi]) + (1 - ($vf[$sdi])) * (999.0), ($vt[$sdi]) * ($tt[$sdi]) + (1 - ($vt[$sdi])) * (999.0), ($vn[$sdi]) * ($tn[$sdi]) + (1 - ($vn[$sdi])) * (999.0))
      $vV[$sdi] = max($vf[$sdi], $vt[$sdi], $vn[$sdi])
      $tq[$sdi] = acos(clamp(($dn[$sdi] - 1.0 - $rqE[$sdi]) / $Lr[$sdi], 0.0, 1.0))
      $th[$sdi] = max($vlo_c + ($vhi_c - $vlo_c) * $wd[3 + $sdi], $tq[$sdi])
      $tg[$sdi] = asin(clamp(($below_c - $board_t_c - 0.3) / ($Lr[$sdi] + $rqE[$sdi]), 0.0, 0.999))
      $gq[$sdi] = clamp(ceil(($Lr[$sdi] + $rqE[$sdi]) - ($below_c - $board_t_c - 0.3)), 0, 1)
      $tO[$sdi] = 999.0
      # each leaner: its top face's two end corners and the tip on it
      loop (2) {
        $lni = output.index
        $tcr = $sgn * (($lay[$lni]) - $fj[$sdi])
        $tcz = -$board_t_c - ($laz[$lni])
        $tcv = ($lx[$lni]) * clamp(ceil(($tcr) - (0.5)), 0, 1) * clamp(ceil(($tcz) - (0.0)), 0, 1) * clamp(ceil(($Lr[$sdi] * $Lr[$sdi]) - ($tcr * $tcr + $tcz * $tcz)), 0, 1)
        $tct = atan2(max($tcz, 0.001), max($tcr, 0.001))
        $tO[$sdi] = min($tO[$sdi], ($tcv) * ($tct) + (1 - ($tcv)) * (999.0))
        $tcr = $sgn * (($lby[$lni]) - $fj[$sdi])
        $tcz = -$board_t_c - ($lbz[$lni])
        $tcv = ($lx[$lni]) * clamp(ceil(($tcr) - (0.5)), 0, 1) * clamp(ceil(($tcz) - (0.0)), 0, 1) * clamp(ceil(($Lr[$sdi] * $Lr[$sdi]) - ($tcr * $tcr + $tcz * $tcz)), 0, 1)
        $tct = atan2(max($tcz, 0.001), max($tcr, 0.001))
        $tO[$sdi] = min($tO[$sdi], ($tcv) * ($tct) + (1 - ($tcv)) * (999.0))
        $tcK = -$board_t_c - ($laz[$lni]) - (($lbz[$lni] - $laz[$lni]) / ($lby[$lni] - $lay[$lni])) * ($fj[$sdi] - ($lay[$lni]))
        $tcR = $Lr[$sdi] * sqrt(1 + (($lbz[$lni] - $laz[$lni]) / ($lby[$lni] - $lay[$lni])) * (($lbz[$lni] - $laz[$lni]) / ($lby[$lni] - $lay[$lni])))
        $tcd = atan((($lbz[$lni] - $laz[$lni]) / ($lby[$lni] - $lay[$lni])) * $sgn)
        $tcq = clamp($tcK / $tcR, -1.0, 1.0)
        $tct = asin($tcq) - $tcd
        $tcy = $fj[$sdi] + $sgn * $Lr[$sdi] * cos(clamp($tct, 0.0, 89.0))
        $tcv = ($lx[$lni]) * (1) * clamp(ceil((0.999) - (abs($tcK / $tcR))), 0, 1) * clamp(ceil(($tct) - (0.5)), 0, 1) * clamp(ceil((89.0) - ($tct)), 0, 1) * clamp(ceil(($tcy) - (min($lay[$lni], $lby[$lni]))), 0, 1) * clamp(ceil((max($lay[$lni], $lby[$lni])) - ($tcy)), 0, 1)
        $tO[$sdi] = min($tO[$sdi], ($tcv) * ($tct) + (1 - ($tcv)) * (999.0))
      }
      # the seesaw: its two top end corners and the tip on its top face
      $tcr = $sgn * (($sly) - $fj[$sdi])
      $tcz = -$board_t_c - ($slz)
      $tcv = ($ss) * clamp(ceil(($tcr) - (0.5)), 0, 1) * clamp(ceil(($tcz) - (0.0)), 0, 1) * clamp(ceil(($Lr[$sdi] * $Lr[$sdi]) - ($tcr * $tcr + $tcz * $tcz)), 0, 1)
      $tct = atan2(max($tcz, 0.001), max($tcr, 0.001))
      $tO[$sdi] = min($tO[$sdi], ($tcv) * ($tct) + (1 - ($tcv)) * (999.0))
      $tcr = $sgn * (($shy) - $fj[$sdi])
      $tcz = -$board_t_c - ($shz)
      $tcv = ($ss) * clamp(ceil(($tcr) - (0.5)), 0, 1) * clamp(ceil(($tcz) - (0.0)), 0, 1) * clamp(ceil(($Lr[$sdi] * $Lr[$sdi]) - ($tcr * $tcr + $tcz * $tcz)), 0, 1)
      $tct = atan2(max($tcz, 0.001), max($tcr, 0.001))
      $tO[$sdi] = min($tO[$sdi], ($tcv) * ($tct) + (1 - ($tcv)) * (999.0))
      $tcK = -$board_t_c - ($slz) - (($shz - $slz) / ($shy - $sly)) * ($fj[$sdi] - ($sly))
      $tcR = $Lr[$sdi] * sqrt(1 + (($shz - $slz) / ($shy - $sly)) * (($shz - $slz) / ($shy - $sly)))
      $tcd = atan((($shz - $slz) / ($shy - $sly)) * $sgn)
      $tcq = clamp($tcK / $tcR, -1.0, 1.0)
      $tct = asin($tcq) - $tcd
      $tcy = $fj[$sdi] + $sgn * $Lr[$sdi] * cos(clamp($tct, 0.0, 89.0))
      $tcv = ($ss) * (1) * clamp(ceil((0.999) - (abs($tcK / $tcR))), 0, 1) * clamp(ceil(($tct) - (0.5)), 0, 1) * clamp(ceil((89.0) - ($tct)), 0, 1) * clamp(ceil(($tcy) - (min($sly, $shy))), 0, 1) * clamp(ceil((max($sly, $shy)) - ($tcy)), 0, 1)
      $tO[$sdi] = min($tO[$sdi], ($tcv) * ($tct) + (1 - ($tcv)) * (999.0))
      # each crosser over this column: the corners of its top face inside the column's strip (the long edges and the end edges),
      # the tip corners on its top face, the tip edge on its long edges
      loop (3) {
        $cn = output.index
        loop (2) {
          $sn = 3 - 2 * output.index
          $tsL = ((($x - 0.5 * $bw)) - ($Tx[$cn] + $sn * 0.5 * $bw * $uy[$cn])) / $axd[$cn]
          $tsR = ((($x + 0.5 * $bw)) - ($Tx[$cn] + $sn * 0.5 * $bw * $uy[$cn])) / $axd[$cn]
          $tsa = max(min($tsL, $tsR), 0)
          $tsb = min(max($tsL, $tsR), $Lc[$cn])
          $tcr = $sgn * ((($Ty[$cn] - $sn * 0.5 * $bw * $ux[$cn]) + $tsa * $ay[$cn]) - $fj[$sdi])
          $tcz = -$board_t_c - ($Tz[$cn] + $tsa * $az[$cn])
          $tcv = ($cr[$cn] * clamp(ceil(($tsb) - ($tsa)), 0, 1)) * clamp(ceil(($tcr) - (0.5)), 0, 1) * clamp(ceil(($tcz) - (0.0)), 0, 1) * clamp(ceil(($Lr[$sdi] * $Lr[$sdi]) - ($tcr * $tcr + $tcz * $tcz)), 0, 1)
          $tct = atan2(max($tcz, 0.001), max($tcr, 0.001))
          $tO[$sdi] = min($tO[$sdi], ($tcv) * ($tct) + (1 - ($tcv)) * (999.0))
          $tcr = $sgn * ((($Ty[$cn] - $sn * 0.5 * $bw * $ux[$cn]) + $tsb * $ay[$cn]) - $fj[$sdi])
          $tcz = -$board_t_c - ($Tz[$cn] + $tsb * $az[$cn])
          $tcv = ($cr[$cn] * clamp(ceil(($tsb) - ($tsa)), 0, 1)) * clamp(ceil(($tcr) - (0.5)), 0, 1) * clamp(ceil(($tcz) - (0.0)), 0, 1) * clamp(ceil(($Lr[$sdi] * $Lr[$sdi]) - ($tcr * $tcr + $tcz * $tcz)), 0, 1)
          $tct = atan2(max($tcz, 0.001), max($tcr, 0.001))
          $tO[$sdi] = min($tO[$sdi], ($tcv) * ($tct) + (1 - ($tcv)) * (999.0))
          $tcK = -$board_t_c - ($Tz[$cn]) - ($az[$cn] / $ay[$cn]) * ($fj[$sdi] - (($Ty[$cn] - $sn * 0.5 * $bw * $ux[$cn])))
          $tcR = $Lr[$sdi] * sqrt(1 + ($az[$cn] / $ay[$cn]) * ($az[$cn] / $ay[$cn]))
          $tcd = atan(($az[$cn] / $ay[$cn]) * $sgn)
          $tcq = clamp($tcK / $tcR, -1.0, 1.0)
