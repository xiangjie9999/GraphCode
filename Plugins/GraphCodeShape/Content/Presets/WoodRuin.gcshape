# ---- the states (kit §2.0.1: a state is a table of knob values; a build line cannot pass them) ------
# each state at three grades from one recipe (kit §12.1, §8a item 6): Game, High, Ultra

DeckIntactGame = mesh() { add($Deck, damage=0.0, budget=0) }
DeckIntactHigh = mesh() { add($Deck, damage=0.0, budget=1) }
# THE WEATHERED WALKWAY (rounds 8-13; owner: "Not broken deck, but normal weathered one", copied from R3:
# `Saved/References/OwnerRefs/2026-11-19/3-weathered-plank-walkway-rope-lashed-beam-drystone-wall.jpg`, round 8's table in
# `Docs/GC-SHAPE-DAMAGE-KIT-ROUNDS.md`). Heavy planks laid ACROSS the walk (along +Y) on three long old stringers running ALONG
# it (X); modules placed end to end along X, each with its own `fseed`, make one walkway; most joins sit over a lashed cross
# timber (a run's last module takes `tieat=2` and ends on one). Its knobs, in plain words (each clamped; the defaults are R3's):
#   size_x   200  100-400 cm   the module's length along the walk        size_y   300  100-400 cm  the walk's width (the planks' length)
#   age      1.6  0-2          how weathered: 0 new, 0.5 fresh, 1 aged, 1.6 R3, 2 worst. Drives the decay (gouges, lips, rotted
#                              ends: 0 at age 0, R3's at 1.6, full at 2) and scales cup, raised ends, missing planks and edge
#                              wander by age / 1.6 (squared past 1.6), and opens a third check toward 2
#   board_w   24  8-40 cm      plank width (each varies 1.6:1)           board_t   12  1.2-16 cm   plank thickness (R3: 0.4-0.6 of the width)
#   gap     0.45  0.1-2 cm     the widest gap between planks (hairlines; the edges wander WITH their gap, never opening it)
#   cup      0.9  0-3 cm       each plank's cup (x age; R3 is mild)      steps    1    0-3 x       unevenness: thickness steps (+-15 % x steps), roll, pitch, twist
#   edges    2.5  0-3 cm       long edges wandering, in waves            gouge   3.5  0-4 cm      the long gouges and cracks in the tops
#            (both as on R3's 24-wide plank; a narrower or thinner plank gets them, and its ends' crumbling, in proportion)
#   end_stagger 20 0-20 cm     how far the plank ends stagger at each side (the planks stop 14 short, so the stringers'
#                              sides show; both scale with size_y / 300). Not `stagger`: that is `add`'s own argument
#   stones     6  0-20         single stones   cluster 8 0-20 a cluster of stones   grit 20 0-60 small stones (all settled, slot `Stone`)
#   tiep    0.75  0-1          the share of modules with a support       tieat    0    0-3        where: 0 start, 1 end, 2 both (a run's last module), 3 drawn
#                              (each support drifts up to 12 cm in from its end, and its ends sit back under the planks)
#   rope       1  0-1          rope lashing on the supports (slot `Rope`) missing 0.5 0-1          the share of modules missing one plank
#   loose   0.35  0-1          the share of planks with a sprung end
#   budget     1  0-2          0 game (the beams' checks and grain left to the baked maps), 1 high, 2 ultra; noise and fseed the seeds
DeckWeathered = mesh(size_x=200.0, size_y=300.0, age=1.6, board_w=24.0, board_t=12.0, gap=0.45, cup=0.9, steps=1.0, edges=2.5, gouge=3.5, end_stagger=20.0, stones=6, cluster=8, grit=20, tiep=0.75, tieat=0, rope=1, missing=0.5, loose=0.35, budget=1, noise=5, fseed=5) {
  $st = clamp($steps, 0.0, 3.0)
  $bw = clamp($board_w, 8.0, 40.0)
  $bt = clamp($board_t, 1.2, 16.0)
  $sy = clamp($size_y, 100.0, 400.0)
  $A = clamp($age, 0.0, 2.0)
  $ak = min($A / 1.6, 1.0) * max($A / 1.6, 1.0) * max($A / 1.6, 1.0)
  $dk = min($A / 1.6, 1.0) * 0.714286 + clamp(($A - 1.6) / 0.4, 0, 1) * 0.285714
  $aw = clamp(($A - 1.6) / 0.4, 0, 1)
  $gm = 1 - clamp(ceil($budget - 0.5), 0, 1)
  $nw = min($bw / 24.0, 1.0)
  # edge wander, gouge depth and the ends' crumbling are R3's on R3's 24 x 12 plank and scale down with a narrower or thinner
  # one; the plank ends' inset and stagger scale with the walk's width, so a narrow walk keeps R3's proportions; past R3's age
  # (1.6) the wood's own damage grows with (age / 1.6) squared and a third check opens
  add($Deck, size_x=clamp($size_x, 100.0, 400.0), size_y=$sy, damage=0.0, age=$A, decay=$dk, budget=max(clamp(floor($budget + 0.5), 0, 2), 1), noise=$noise, fseed=$fseed, board_w=$bw, board_t=$bt, joists=3, joist_w=26.0, joist_d=28.0, einset=14.0 * $sy / 300.0, gapmin=0.2, gapmax=max(clamp($gap, 0.1, 2.0), 0.2), btaper=0.01, shrink=0.0, eivar=clamp($end_stagger, 0.0, 20.0) * $sy / 300.0, pnone=0.85, tvar=0.15 * $st, lift=0.0, jsag=0.1, jends=0.15, jdecay=1.0 - 0.7 * $gm, jcheck=0.35 * (1 - $gm), broll=2.5 * $st, bpitch=0.6 * $st, bttaper=0.12 * $st, btwist=1.5 * $st, cup=min(clamp($cup, 0.0, 3.0) * $ak, 3.0), wear=0.1, ridge=0.15, groove=0.0, gouge=min(clamp($gouge, 0.0, 4.0) * min($bt / 9.0, 1.0) * $ak, 4.0), lips=1.3, hollow=0.8, edgew=min(clamp($edges, 0.0, 3.0) * $nw * $ak, 3.0), bwaney=0.2, checks=2 + $aw, checkd=0.5 + 0.15 * $aw, crumb=20.0 * $nw, thin=0.05, bsag=0.0, plift=min(clamp($loose, 0.0, 1.0) * $ak, 1.0), liftc=5.0, missing=1, missp=min(clamp($missing, 0.0, 1.0) * $ak, 1.0), sliver=0.15, corner=0.0, stones=clamp($stones, 0.0, 20.0), stonesz=10.0, stonesc=clamp($cluster, 0.0, 20.0), grit=clamp($grit, 0.0, 60.0), ties=1, tiep=clamp($tiep, 0.0, 1.0), tieat=clamp($tieat, 0.0, 3.0), tie_w=20.0, rope=clamp($rope, 0.0, 1.0), ropes=3, tiein=1.0, tiex=12.0)
}
DeckWeatheredGame = mesh() { add($DeckWeathered, budget=0, tiep=1.0) }
DeckWeatheredHigh = mesh() { add($DeckWeathered, budget=2, tiep=1.0) }
DeckIntactUltra = mesh() { add($Deck, damage=0.0, budget=2, detail=0.084, hdetail=0.072, jdetail=0.18) }
DeckBrokenGame = mesh() { add($Deck, age=1.8, noise=17, budget=0) }
DeckBrokenHigh = mesh() { add($Deck, age=1.8, noise=17, budget=1) }
DeckBrokenUltra = mesh() { add($Deck, age=1.8, noise=17, budget=2, detail=0.084, hdetail=0.072, jdetail=0.18) }
DeckBroken300Game = mesh() { add($Deck, size_x=300.0, age=1.8, noise=17, budget=0) }
DeckBroken300High = mesh() { add($Deck, size_x=300.0, age=1.8, noise=17, budget=1) }
DeckBroken300Ultra = mesh() { add($Deck, size_x=300.0, age=1.8, noise=17, budget=2, detail=0.084, hdetail=0.072, jdetail=0.18) }
DeckWreckedGame = mesh() { add($Wreck, age=1.8, hole_rx=85.0, detail=0.06, hdetail=0.06, jdetail=0.2, noise=23, budget=0) }
DeckWreckedHigh = mesh() { add($Wreck, age=1.8, hole_rx=85.0, detail=0.06, hdetail=0.06, jdetail=0.2, noise=23, budget=1) }
DeckWreckedUltra = mesh() { add($Wreck, age=1.8, hole_rx=85.0, detail=0.06, hdetail=0.06, jdetail=0.12, noise=23, budget=2) }
DeckBrokenDebris = mesh() { add($DeckDebris, age=1.8, noise=17, splinters=0.0, frag=110.0, lsplit=0.15, budget=0) }
DeckBroken300Debris = mesh() { add($DeckDebris, size_x=300.0, age=1.8, noise=17, splinters=0.0, frag=110.0, lsplit=0.15, budget=0) }
DeckWreckedDebris = mesh() { add($WreckDebris, age=1.8, hole_rx=85.0, detail=0.06, hdetail=0.06, jdetail=0.2, noise=23) }

