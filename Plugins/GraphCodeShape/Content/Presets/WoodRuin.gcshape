        add($Frag, len=$pL3, width=$lw / (1 + $bvar_c * $F), index=$dI3, n0=$kMB, l0=(1 - $lq3) * $pdeep_c + (1 - (1 - $lq3)) * $dpMB, a0=(1 - $lq3) * 0.33 * $aMB + (1 - (1 - $lq3)) * $aMB, r0=(1 - $lq3) * $grain_c + (1 - (1 - $lq3)) * $rMB, q0=(1 - $lq3) * $lean_c + (1 - (1 - $lq3)) * $eMB, s0=(1 - $lq3) * 0.8 + (1 - (1 - $lq3)) * $spMB, v0=(1 - $lq3) * 0.7 + (1 - (1 - $lq3)) * $vpMB, h0=(1 - (1 - $lq3)) * $hnMB, n1=$dkn3, l1=(1 - $lq3) * $pdeep_c + (1 - (1 - $lq3)) * $dpN3, a1=(1 - $lq3) * 0.33 * $aN3 + (1 - (1 - $lq3)) * $aN3, r1=(1 - $lq3) * $grain_c + (1 - (1 - $lq3)) * $rN3, q1=(1 - $lq3) * $lean_c + (1 - (1 - $lq3)) * $eN3, s1=(1 - $lq3) * 0.8 + (1 - (1 - $lq3)) * $spN3, v1=(1 - $lq3) * 0.7 + (1 - (1 - $lq3)) * $vpN3, h1=(1 - (1 - $lq3)) * $hnN3, far=$fr3 * $lq3, t0=(1 - (1 - $lq3)) * $tnMB, t1=(1 - (1 - $lq3)) * $tnN3, saw0=$dw03, saw1=$dw13, torntilt=$torntilt_c, tornrib=$tornrib_c, tornsep=$tornsep_c, thick=$board_t_c, wvar=$bvar_c * $F, tvar=$tvar_c * $F, cup=$cup_c * $F, wear=$wear_c * (0.3 + 0.7 * $F), wearvar=min($wearvar_c * $F, 1.0), noise=$fseed, arris=3, seg=1, detail=$ddetail_c, tile=$tile_c, aspect=$aspect_c, split=0, tl=$tl3, ed=0.0, scatter=1, collide=stack, jitter=(turn=($tumble_c, $tumble_c, 25.0)), join=none, rotate=(0.0, 0.0, 90.0), seed=$K * 5 + 4) [$groundB, top]
      } else {
        if ($pf3 * $crumbs_c * clamp(ceil(($pL3) - (4.0)), 0, 1) > 0.5) {
          add($Debris.Chips, count=$crumbs_c, area=0.5 * $pL3 + 4.0, tile=$tile_c, aspect=$aspect_c, noise=$K * 5 + 14, scatter=1, collide=stack, join=none, seed=$K * 5 + 24) [$groundB, top]
        }
      }
    }
  }
  trim() [$groundA]
  trim() [$groundB]
  trim() [material=$Block]
  uv(keep)
}

# ---- the states (kit §2.0.1: a state is a table of knob values; a build line cannot pass them) ------
