  $wearvar_c = clamp($wearvar, 0.0, 1.0)
  $decay_c = clamp($decay, -1.0, 1.0)
  $dstate_c = clamp($dstate, 0.0, 1.0)
  $ridge_c = clamp($ridge, 0.0, 2.0)
  $checks_c = clamp($checks, 0.0, 3.0)
  $checkd_c = clamp($checkd, 0.0, 0.9)
  $crumb_c = clamp($crumb, 0.0, 20.0)
  $sliver_c = clamp($sliver, 0.0, 1.0)
  $corner_c = clamp($corner, 0.0, 1.0)
  $thin_c = clamp($thin, 0.0, 0.6)
