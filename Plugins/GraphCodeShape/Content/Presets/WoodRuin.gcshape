  # the joists, each its own (width, depth, sag, crook); their tops at the boards' bottom
  add($DeckJoist, w=$joist_w_c, d=$joist_d_c, len=$SX, jvw=$jvw_c * $F, jvd=$jvd_c * $F, jsag=$jsag_c * $F, jcrook=$jcrook_c * $F, arris=$arris, tile=$tile_c, aspect=$aspect_c, noise=$fseed, index=0, at=(0.0, 0.5 * $js, -$board_t_c), rotate=(0.0, 0.0, -90.0))
