  $bvar_c = clamp($bvar, 0.0, 0.05)
  $tvar_c = clamp($tvar, 0.0, 0.45)
  $yaw_c = clamp($yaw, 0.0, 1.5)
  $lift_c = clamp($lift, 0.0, 2.0)
  $cup_c = clamp($cup, 0.0, 3.0)
  $bow_c = clamp($bow, 0.0, 1.0)
  $crook_c = clamp($crook, 0.0, 1.0)
  $endsq_c = clamp($endsq, 0.0, 5.0)
  $wear_c = clamp($wear, 0.0, 1.5)
  $wearvar_c = clamp($wearvar, 0.0, 1.0)
  $shade_c = clamp($shade, 0.0, 0.6)
  $btwist_c = clamp($btwist, 0.0, 6.0)
  $btaper_c = clamp($btaper, 0.0, 0.2)
  $bwaney_c = clamp($bwaney, 0.0, 1.5)
  $bttaper_c = clamp($bttaper, 0.0, 0.3)
  $bpitch_c = clamp($bpitch, 0.0, 3.0)
  $broll_c = clamp($broll, 0.0, 8.0)
