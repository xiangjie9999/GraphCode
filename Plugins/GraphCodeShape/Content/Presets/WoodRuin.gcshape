      $syp = (1 - $scl) * $SY * (0.18 + 0.64 * ((1 - $sdr) * $sv + $sdr * (0.25 * $sv + 0.75 * $sside))) + $scl * ($ccy + (5.0 + 15.0 * sqrt(max($c - $NS - $NG + 0.5, 0.0) / max($NC, 1))) * sin((137.5 * ($c - $NS - $NG) + 360 * $sv)))
      $sz = (1 - $sg) * clamp($stonesz, 2.0, 20.0) * (0.45 + 1.0 * $Hash($noise * 1009 + $c, 4563.9)) + $sg * (1.0 + 2.0 * $Hash($noise * 1009 + $c, 4563.9))
      add($Kit.Cobble, size=$sz, ar=0.6 + 0.35 * $Hash($noise * 1009 + $c, 4595.1), tr=0.45 + 0.3 * $Hash($noise * 1009 + $c, 4627.7), noise=$noise * 1009 + 4600 + $c, at=($sxp, $syp, 25.0), rotate=(0.0, 0.0, 360 * $su), collide=settle, join=none)
