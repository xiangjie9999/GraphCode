  $n = floor($SX / (clamp($board_w, 8.0, 40.0) + $board_gap_c) + 0.5)
  $pitch = $SX / $n
  $bw = $pitch - $board_gap_c
  $js = $SY / $joists_c
  $clr = $js - $joist_w_c
  $q0 = $Hash($noise * 1009, 13.1)
  $q1 = $Hash($noise * 1009, 27.7)
  $q2 = $Hash($noise * 1009, 41.3)
  $q3 = $Hash($noise * 1009, 55.9)
  $q4 = $Hash($noise * 1009, 69.1)
  $q5 = $Hash($noise * 1009, 83.3)
  $q6 = $Hash($noise * 1009, 97.9)
  $q7 = $Hash($noise * 1009, 111.7)
  $q8 = $Hash($noise * 1009, 125.3)
  $q9 = $Hash($noise * 1009, 139.9)
  $q10 = $Hash($noise * 1009, 153.1)
  $q11 = $Hash($noise * 1009, 167.7)
  $q12 = $Hash($noise * 1009, 181.3)
  $q13 = $Hash($noise * 1009, 195.9)
  $q14 = $Hash($noise * 1009, 209.1)
  $q15 = $Hash($noise * 1009, 223.3)
  $q16 = $Hash($noise * 1009, 237.9)
  $q17 = $Hash($noise * 1009, 251.7)
  $q18 = $Hash($noise * 1009, 265.3)
  $q19 = $Hash($noise * 1009, 279.9)
  $q20 = $Hash($noise * 1009, 293.1)
  $q21 = $Hash($noise * 1009, 307.7)
  $q22 = $Hash($noise * 1009, 321.3)
  $q23 = $Hash($noise * 1009, 335.9)
  $sx = $DMG * clamp($hole_rx, 5.0, 150.0) * (1 + clamp($svar, 0.0, 0.5) * (2 * $q0 - 1))
  $sx = min($sx, 0.5 * $SX - 1.2 * $SX / floor($SX / (clamp($board_w, 8.0, 40.0) + $board_gap_c) + 0.5))
  $hy = $DMG * clamp($hole_ry, 5.0, 100.0) * (1 + clamp($svar, 0.0, 0.5) * (2 * $q1 - 1))
  $cx = clamp($hole_x, 0.0, 1.0) * $SX + clamp($cvar, 0.0, 50.0) * (2 * $q2 - 1)
  $cx = clamp($cx, min($sx + 0.5 * $pitch, 0.5 * $SX), max($SX - $sx - 0.5 * $pitch, 0.5 * $SX))
  $cy = clamp(clamp($hole_y, 0.0, 1.0) * $SY + clamp($cvar, 0.0, 50.0) * (2 * $q3 - 1), $js, $SY - $js)
  $iL = ceil(($cx - $sx) / $pitch - 0.5)
  $iR = floor(($cx + $sx) / $pitch - 0.5)
  $m = $iR - $iL + 1
  $S = min(floor((clamp($survive, 0.0, 2.0) + 1) * $q15 * 0.999), max($m - 2, 0))
  $s1 = clamp(floor(($m - 1) * (0.15 + 0.2 * $q16 + 0.5 * floor(2 * $q17)) + 0.5), 1, max($m - 2, 1))
  $s2 = clamp($s1 + 1 - 2 * floor(2 * $q17), 1, max($m - 2, 1))
  $s2 = $s2 + clamp(1 - abs($s2 - $s1), 0, 1) * (2 * clamp($m - 3 - $s1, 0, 1) - 1)
  $tj1 = clamp(floor(($cy - $hy) / $js), 0, $joists_c - 2)
  $tj2 = clamp(floor(($cy + $hy) / $js), $tj1 + 1, $joists_c - 1)
  $lo1 = max($tj1 - 1, 0)
  $hi1 = min($tj1 + 1, $joists_c - 2)
  $lo2 = max($tj2 - 1, 1)
  $hi2 = min($tj2 + 1, $joists_c - 1)
  $o1 = clamp($tj1 + clamp(ceil($q4 - 0.8), 0, 1) - clamp(ceil(0.2 - $q4), 0, 1), $lo1, $hi1)
  $o2 = clamp($tj2 + clamp(ceil($q5 - 0.8), 0, 1) - clamp(ceil(0.2 - $q5), 0, 1), $lo2, $hi2)
  $stb = $iL + floor(($m - 1) * (0.05 + 0.2 * $q6))
  $stb = $stb + clamp(ceil($q7 - 0.5), 0, 1) * ($iL + $iR - 2 * $stb)
  $sts = 1 + floor(2 * $q8)
  $rfb = $iL + floor(($m - 1) * (0.1 + 0.15 * $q9))
  $rfb = $rfb + clamp(ceil($q10 - 0.5), 0, 1) * ($iL + $iR - 2 * $rfb)
  $kb = clamp(floor(0.5 * ($o1 + $o2)), 0, $joists_c - 2)
  $yc = ($kb + 1) * $js
  $hr = 0.3 * $board_t_c + 0.05 * $bw + 0.3
  $qm1 = $Hash($noise * 1009, 3541.7)
  $qm2 = $Hash($noise * 1009, 3617.3)
  $DK = $decay_c + (1 - clamp(ceil($decay_c + 0.5), 0, 1)) * (clamp(($AGE - 1.1) / 0.7, 0, 1) - $decay_c)
  $mlo = max($iL - 2, 0)
  $mhi = min($iR + 2, $n - 1)
  $mno = $n - max($mhi - $mlo + 1, 0)
  $mr = floor($mno * $qm1 * 0.999)
  $mi = $mr + clamp(ceil($mr - $mlo + 0.5), 0, 1) * max($mhi - $mlo + 1, 0)
  $msk = clamp(ceil((clamp($missing, 0.0, 1.0) * $DK) - (0.5)), 0, 1) * clamp(ceil(($mno) - (0.5)), 0, 1) * clamp(ceil(clamp($missp, 0.0, 1.0) - $Hash($fseed * 1021 + 3, 4911.7)), 0, 1)
  # round 8-11 (R3: lashed cross timbers under the stringers at the walk's SUPPORTS, their ends standing out past the plank ends):
  # `ties` old squared timbers `tie_w` cm, across the walk (along Y, the module's full width) under the beams (2 cm into them: they
  # bear), at a module END (where the stringers meet: the joint sits over it), in a share `tiep` of modules; `tieat` 0 the start
  # (x = 0: a run of modules is a support at every joint), 1 the end, 2 both (the last module of a run), 3 an end drawn from the floor seed
  $tmix = $Hash($fseed * 1009 + 17, 4689.7 + 37.3 * $fseed)
  $TA = clamp(floor($tieat + 0.5), 0, 3)
  $TB = clamp(1 - abs($TA - 2), 0, 1)
  $NT = floor(clamp($ties, 0.0, 3.0) + 0.5) * max(clamp(ceil(clamp($tiep, 0.0, 1.0) - $Hash($fseed * 1013 + 5, 4711.9 + 101.3 * $tmix)), 0, 1), $TB)
  if ($NT > 0.5) {
    loop (repeat=$NT * (1 + $TB)) {
      $tq0 = output.index
      $tsec = $TB * clamp(ceil($tq0 - $NT - 0.5), 0, 1)
      $tq = $tq0 - $NT * $tsec
      $tend = clamp(1 - abs($TA - 3), 0, 1) * floor(2 * $Hash($fseed * 1019 + 13 * $tq, 4701.3 + 211.7 * $tmix)) + clamp(1 - abs($TA - 1), 0, 1) + $tsec
      $tx = (1 - $tend) * (0.6 * clamp($tie_w, 6.0, 30.0) + 2.5 + 40.0 * ($tq - 1)) + $tend * ($SX - 0.6 * clamp($tie_w, 6.0, 30.0) - 2.5 - 40.0 * ($tq - 1))
      # round 13 (the lead: from above the supports read as a ladder): `tiex` cm, each support drifts that far at most in from
      # its end; `tiein` 0-1, its two ends sit back under the planks (each its own way, 0.6-1.5 x the plank ends' inset x tiein)
      $th = $Hash($fseed * 1051 + 7 * $tq0, 4723.9 + 53.9 * $tmix)
      $tx = $tx + clamp($tiex, 0.0, 40.0) * $th * (1 - 2 * $tend)
      $ty0 = clamp($tiein, 0.0, 1.0) * $einset_c * (0.6 + 0.9 * $Hash($fseed * 1061 + 11 * $tq0, 4741.3 + 61.7 * $tmix))
      $ty1 = $SY - clamp($tiein, 0.0, 1.0) * $einset_c * (0.6 + 0.9 * $Hash($fseed * 1063 + 13 * $tq0, 4757.9 + 67.1 * $tmix))
      add($Kit.DeckJoist, w=clamp($tie_w, 6.0, 30.0), d=clamp($tie_w, 6.0, 30.0), len=$ty1 - $ty0, jvw=0.05 * $F, jvd=0.03 * $F, jsag=0.0, jcrook=0.3 * $F, arris=$arris, softness=$SOFT, jdv=$JDV, jcheck=$jcheck_c, jends=$jends_c, tile=$tile_c, aspect=$aspect_c, noise=$fseed, index=20 + $tq, at=($tx, $ty0, -$board_t_c - clamp($joist_d, 10.0, 30.0) + 2.0), join=none)
      if (clamp($rope, 0.0, 1.0) > 0.5) {
        loop (repeat=2 * clamp(floor($ropes + 0.5), 1, 5)) {
          $rq = output.index
          $rn = clamp(floor($ropes + 0.5), 1, 5)
