    $F1 = $Rr * $p1
    $F2 = $Rr * ($p2 - $p1)
    $F3 = $Rr * (1 - $p2)
    $lf1 = clamp(ceil($long_c - $f3), 0, 1)
    $lf2 = clamp(ceil($long_c - $f4), 0, 1)
    $sl1 = $deep_c + ($ldeep_c - $deep_c) * clamp(ceil($long_c - $f3), 0, 1)
    $sl2 = $deep_c + ($ldeep_c - $deep_c) * clamp(ceil($long_c - $f4), 0, 1)
    $sb1 = $slant_c * (2 * $f5 - 1)
    $sb2 = $slant_c * (2 * $f6 - 1)
    $spl = clamp(ceil($splinters_c - $f7), 0, 1)
    $splen = 6.0 + 10.0 * $f8
    $ls1 = clamp(ceil($lsplit_c - $k1), 0, 1)
    $ls2 = clamp(ceil($lsplit_c - $k2), 0, 1)
    $ls3 = clamp(ceil($lsplit_c - $k3), 0, 1)
    $tl1 = clamp(ceil($tilt_c - $k4), 0, 1) * atan((5 + 9 * $k7) / max($F1, 10)) * (2 * floor(2 * $k10) - 1)
    $tl2 = clamp(ceil($tilt_c - $k5), 0, 1) * atan((5 + 9 * $k8) / max($F2, 10)) * (2 * floor(2 * $k11) - 1)
    $tl3 = clamp(ceil($tilt_c - $k6), 0, 1) * atan((5 + 9 * $k9) / max($F3, 10)) * (2 * floor(2 * $k12) - 1)
    $ed1 = clamp(ceil($edge_c - $k7), 0, 1) * (75 + 15 * $k10)
    $ed2 = clamp(ceil($edge_c - $k8), 0, 1) * (75 + 15 * $k11)
    $ed3 = clamp(ceil($edge_c - $k9), 0, 1) * (75 + 15 * $k12)
    $lq1 = clamp(ceil($F1 - $dshort_c), 0, 1)
    $lq2 = clamp(ceil($F2 - $dshort_c), 0, 1)
    $lq3 = clamp(ceil($F3 - $dshort_c), 0, 1)
    $fm1 = $y1 + 0.5 * $F1
    $fm2 = $y1 + $F1 + 0.5 * $F2
    $fm3 = $y1 + $F1 + $F2 + 0.5 * $F3
    $fi1 = 4 * $i + clamp(ceil(($fm1) - ($jy1)), 0, 1) + clamp(ceil(($fm1) - ($jy2)), 0, 1)
    $fi2 = 4 * $i + clamp(ceil(($fm2) - ($jy1)), 0, 1) + clamp(ceil(($fm2) - ($jy2)), 0, 1)
    $fi3 = 4 * $i + clamp(ceil(($fm3) - ($jy1)), 0, 1) + clamp(ceil(($fm3) - ($jy2)), 0, 1)
    if ($brk * clamp(ceil($Rr - $dmin_c), 0, 1) > 0.5) {
      add($Frag, len=$F1, width=$lw / (1 + $bvar_c * $F), index=$fi1, saw0=$bt1, saw1=(1 - $w2f) * $bt2, n0=$K, l0=$lq1 * $dp1 + (1 - $lq1) * $deep_c, a0=$a1, r0=$r1, q0=$e1, s0=$sp1, v0=$vp1, h0=$hn1 * $lq1, n1=$K + 211 + (1 - $w2f) * (50 - 211), l1=$lq1 * ($sl1 + (1 - $w2f) * ($dp2 - $sl1)) + (1 - $lq1) * $deep_c, a1=$sb1 + (1 - $w2f) * ($a2 - $sb1), r1=$r1 + (1 - $w2f) * ($r2 - $r1), q1=$e1 + (1 - $w2f) * ($e2 - $e1), s1=0.8 + (1 - $w2f) * ($sp2 - 0.8), v1=0.7 + (1 - $w2f) * ($vp2 - 0.7), h1=(1 - $w2f) * $hn2 * $lq1, far=(1 - $w2f) * $lq1, t0=$tn1 * $lq1, t1=($w2f * $torn_c * (1 - $lf1) + (1 - $w2f) * $tn2) * $lq1, split=$ls1, sx=0.35 + 0.3 * $k10, thick=$board_t_c, wvar=$bvar_c * $F, tvar=$tvar_c * $F, cup=$cup_c * $F, wear=$wear_c * (0.3 + 0.7 * $F), wearvar=min($wearvar_c * $F, 1.0), noise=$fseed, arris=3, seg=1, detail=$ddetail_c, torntilt=$torntilt_c, tornrib=$tornrib_c, tornsep=$tornsep_c, tile=$tile_c, aspect=$aspect_c, tl=$tl1, ed=$ed1, scatter=1, collide=stack, jitter=(turn=($tumble_c, $tumble_c, 180.0)), join=none, seed=$K * 3 + 1) [$ground, top]
      if ($w2f > 0.5) {
        add($Frag, len=$F2, width=$lw / (1 + $bvar_c * $F), index=$fi2, saw1=(1 - $w3f) * $bt2, n0=$K + 211, l0=$lq2 * $sl1 + (1 - $lq2) * $deep_c, a0=$sb1, r0=$r1, q0=$e1, n1=$K + 337 + (1 - $w3f) * (50 - 337), l1=$lq2 * ($sl2 + (1 - $w3f) * ($dp2 - $sl2)) + (1 - $lq2) * $deep_c, a1=$sb2 + (1 - $w3f) * ($a2 - $sb2), r1=$r2, q1=$e2, s1=0.8 + (1 - $w3f) * ($sp2 - 0.8), v1=0.7 + (1 - $w3f) * ($vp2 - 0.7), h1=(1 - $w3f) * $hn2 * $lq2, far=(1 - $w3f) * $lq2, t0=$torn_c * (1 - $lf1) * $lq2, t1=($w3f * $torn_c * (1 - $lf2) + (1 - $w3f) * $tn2) * $lq2, split=$ls2, sx=0.35 + 0.3 * $k11, thick=$board_t_c, wvar=$bvar_c * $F, tvar=$tvar_c * $F, cup=$cup_c * $F, wear=$wear_c * (0.3 + 0.7 * $F), wearvar=min($wearvar_c * $F, 1.0), noise=$fseed, arris=3, seg=1, detail=$ddetail_c, torntilt=$torntilt_c, tornrib=$tornrib_c, tornsep=$tornsep_c, tile=$tile_c, aspect=$aspect_c, tl=$tl2, ed=$ed2, scatter=1, collide=stack, jitter=(turn=($tumble_c, $tumble_c, 180.0)), join=none, seed=$K * 3 + 2) [$ground, top]
      }
      if ($w3f > 0.5) {
        add($Frag, len=$F3, width=$lw / (1 + $bvar_c * $F), index=$fi3, saw1=$bt2, n0=$K + 337, l0=$lq3 * $sl2 + (1 - $lq3) * $deep_c, a0=$sb2, r0=$r2, q0=$e2, n1=$K + 50, l1=$lq3 * $dp2 + (1 - $lq3) * $deep_c, a1=$a2, r1=$r2, q1=$e2, s1=$sp2, v1=$vp2, h1=$hn2 * $lq3, far=$lq3, t0=$torn_c * (1 - $lf2) * $lq3, t1=$tn2 * $lq3, split=$ls3, sx=0.35 + 0.3 * $k12, thick=$board_t_c, wvar=$bvar_c * $F, tvar=$tvar_c * $F, cup=$cup_c * $F, wear=$wear_c * (0.3 + 0.7 * $F), wearvar=min($wearvar_c * $F, 1.0), noise=$fseed, arris=3, seg=1, detail=$ddetail_c, torntilt=$torntilt_c, tornrib=$tornrib_c, tornsep=$tornsep_c, tile=$tile_c, aspect=$aspect_c, tl=$tl3, ed=$ed3, scatter=1, collide=stack, jitter=(turn=($tumble_c, $tumble_c, 180.0)), join=none, seed=$K * 3 + 3) [$ground, top]
      }
      if ($spl > 0.5) {
        add($Debris.Splinter, length=$splen, ar=9.0 + 5.0 * $f9, kink=8.0 + 6.0 * $f9, twist=30.0 * (2 * $f8 - 1), fray=5, tile=$tile_c, aspect=$aspect_c, noise=$K + 401, scatter=1, collide=stack, jitter=(turn=($tumble_c, $tumble_c, 180.0)), join=none, seed=$K * 3 + 4) [$ground, top]
      }
    }
  }
  trim() [$ground]
  uv(keep)
}

# ---- the collapse (W1 round 5; round 6 on the aged floor): `Wreck` and its pile `WreckDebris` --------------

# what keeps the pile clear of the pieces that reach the ground; deleted again by its slot
Stop = mesh(width=14.0, thick=1.9, length=20.0) {
  rect(w=$width, h=$length)
  extrude(height=$thick)
  place(by=(0.0, 0.5 * $length, 0.0))
  material($Block)
}

# THE COLLAPSE (`SM_WoodDeck_Wrecked`): the snapped joist's halves rest their tips on the ground `below` cm under the
# deck's top (60), and the boards over it are a heap: each breaks at 2 or 3 places (`pthree`; `pmid` of the drawn breaks
# mid-board); a piece still nailed to a rim joist rests on the V, a crosser, a seesaw or a leaner, or hangs `vlo`-`vhi`;
# a middle piece nailed to the snapped joist is a seesaw; one that broke at the V leans on the joist; up to `cross`
# pieces lie across the V yawed `ylo`-`yhi` off their rows (`xlo`-`xhi` degrees); every other piece falls through to
# `WreckDebris`; boards where the V is under `dsag` deep sag. Round 6: the same aged floor as `Deck` (its knobs, its
# seed `age`): a butt joint over the snapped joist splits its lane there (nothing spans it, the ends sawn), a level end
# at a rim whose board began on that joist is the joint's clean butt end. The math is written once in `gen/genwreck.py`.
# The six top-level knobs lead (`damage` here scales the collapse's span, clamped 0.4-1.4); the floor's, the joists' and
# the breaks' knobs are Deck's (its table above); the collapse's own:
# Wreck's own knobs:
#   knob        default   range          unit      meaning
#   below       60.0      20-300         cm        the ground under the deck top: nothing goes lower; the pile lies on it
#   vdrop       40.0      5-70           deg       the snapped joist's halves turn 80-100 % of this unless their tips reach the ground
#   vsplay      2.5       0-10           deg       the halves' splay in plan
#   vreach      14.0      0-30           cm        how far the joist's torn end reaches past its nominal end
#   vmin        30.0      10-60          deg       a rim piece resting on the V under this breaks short and hangs
#   dsag        10.0      2-40           cm        a board where the V is shallower than this sags into it
#   pthree      0.5       0-1            share     boards over the V that break at three places (the rest at two)
#   pmid        0.6       0-1            share     drawn breaks that are mid-board
#   pdeep       0.75      0.2-1.5        x width   a plain break's depth (feet on the ground, short pieces)
#   vlo         30.0      10-80          deg       a piece resting on nothing hangs at least this
#   vhi         80.0      20-88          deg       ... and at most this
#   smax        15.0      2-40           cm        a seesaw's short side at most
#   cross       3         0-3            count     the most crossers (pieces fallen across the V, yawed)
#   xlo         30.0      10-80          deg       a crosser's least rest angle
#   xhi         55.0      10-85          deg       a crosser's most rest angle
#   ylo         15.0      0-80           deg       a crosser's least yaw off its row
#   yhi         55.0      0-85           deg       a crosser's most yaw
#   xcone       15.0      0-45           deg       a crosser stays under the planes falling this from each rim
#
# WreckDebris adds:
#   knob        default   range          unit      meaning
#   dmin        12.0      4-60           cm        a removed run shorter than this is lost (WreckDebris: lies as crumbs)
#   crumbs      3         0-8            count     chips a lost piece leaves on the ground
#   dshort      60.0      0-120          cm        a fragment shorter than this takes plain fresh ends
#   grow        1.3       1-2.5          x         the pile's footprint over the hole's
#   tumble      8.0       0-45           deg       each fragment tumbled up to this
#   tilt        0.25      0-1            share     fragments lying tilted, one end raised
#   traise      6.0       0-20           cm        a tilted pile piece's raised end
#   band        18.0      0-60           cm        what reaches the ground keeps the pile clear up to this
#   ddetail     0.07      0.06-0.3       cm        the fragments' point spacing
Wreck = mesh(size_x=200.0, size_y=200.0, damage=1.0, age=1.0, noise=1, budget=1, board_w=14.0, board_t=1.9, board_gap=0.3, joists=5, joist_w=3.8, joist_d=18.4, fseed=5, wjit=0.05, gapmin=0.1, gapmax=0.8, egap=0.3, einset=0.05, pnone=0.2, ptwo=0.35, bgmin=0.15, bgmax=0.4, bvar=0.015, tvar=0.05, yaw=0.5, lift=0.15, cup=0.3, bow=0.25, crook=0.25, endsq=1.5, wear=0.5, wearvar=0.6, jvw=0.05, jvd=0.03, jsag=0.4, jcrook=0.3, shade=0.15, hole_x=0.5, hole_y=0.5, hole_rx=85.0, cvar=25.0, svar=0.25, below=60.0, vdrop=40.0, vsplay=2.5, vreach=14.0, vmin=30.0, dsag=10.0, pthree=0.5, pmid=0.6, pdeep=0.75, vlo=30.0, vhi=80.0, smax=15.0, cross=3, xlo=30.0, xhi=55.0, ylo=15.0, yhi=55.0, xcone=15.0, rimfrag=1, rimchips=4, long=0.5, deep=0.75, ldeep=1.3, splint=1.0, slant=12.0, grain=0.24, lean=1.6, horn=0.3, rings=0, torn=0.85, torntilt=0.15, tornrib=1, tornsep=0.15, uvbox=1, detail=0.14, hdetail=0.12, jdetail=0.3, tile=100.0, aspect=1.0) {
  $board_w_c = clamp($board_w, 8.0, 25.0)
  $board_t_c = clamp($board_t, 1.2, 5.0)
  $board_gap_c = clamp($board_gap, 0.1, 1.0)
  $joists_c = clamp($joists, 3.0, 8.0)
  $joist_w_c = clamp($joist_w, 3.0, 10.0)
  $joist_d_c = clamp($joist_d, 10.0, 30.0)
  $wjit_c = clamp($wjit, 0.0, 0.1)
  $gapmin_c = clamp($gapmin, 0.0, 1.0)
  $gapmax_c = clamp($gapmax, 0.0, 2.0)
  $egap_c = clamp($egap, 0.0, 1.0)
  $einset_c = clamp($einset, 0.02, 0.3)
  $pnone_c = clamp($pnone, 0.0, 1.0)
  $ptwo_c = clamp($ptwo, 0.0, 1.0)
  $bgmin_c = clamp($bgmin, 0.05, 1.0)
  $bgmax_c = clamp($bgmax, 0.05, 2.0)
  $bvar_c = clamp($bvar, 0.0, 0.05)
  $tvar_c = clamp($tvar, 0.0, 0.15)
  $yaw_c = clamp($yaw, 0.0, 1.5)
  $lift_c = clamp($lift, 0.0, 0.6)
  $cup_c = clamp($cup, 0.0, 1.0)
  $bow_c = clamp($bow, 0.0, 1.0)
  $crook_c = clamp($crook, 0.0, 1.0)
  $endsq_c = clamp($endsq, 0.0, 5.0)
  $wear_c = clamp($wear, 0.0, 1.5)
  $wearvar_c = clamp($wearvar, 0.0, 1.0)
  $jvw_c = clamp($jvw, 0.0, 0.15)
  $jvd_c = clamp($jvd, 0.0, 0.1)
  $jsag_c = clamp($jsag, 0.0, 2.0)
  $jcrook_c = clamp($jcrook, 0.0, 1.0)
  $shade_c = clamp($shade, 0.0, 0.6)
  $hole_x_c = clamp($hole_x, 0.0, 1.0)
  $hole_y_c = clamp($hole_y, 0.0, 1.0)
  $hole_rx_c = clamp($hole_rx, 5.0, 150.0)
  $cvar_c = clamp($cvar, 0.0, 50.0)
  $svar_c = clamp($svar, 0.0, 0.5)
  $below_c = clamp($below, 20.0, 300.0)
  $vdrop_c = clamp($vdrop, 5.0, 70.0)
  $vsplay_c = clamp($vsplay, 0.0, 10.0)
  $vreach_c = clamp($vreach, 0.0, 30.0)
  $vmin_c = clamp($vmin, 10.0, 60.0)
  $dsag_c = clamp($dsag, 2.0, 40.0)
  $pthree_c = clamp($pthree, 0.0, 1.0)
  $pmid_c = clamp($pmid, 0.0, 1.0)
  $pdeep_c = clamp($pdeep, 0.2, 1.5)
  $vlo_c = clamp($vlo, 10.0, 80.0)
  $vhi_c = clamp($vhi, 20.0, 88.0)
  $smax_c = clamp($smax, 2.0, 40.0)
  $cross_c = clamp($cross, 0.0, 3.0)
  $xlo_c = clamp($xlo, 10.0, 80.0)
  $xhi_c = clamp($xhi, 10.0, 85.0)
  $ylo_c = clamp($ylo, 0.0, 80.0)
  $yhi_c = clamp($yhi, 0.0, 85.0)
  $xcone_c = clamp($xcone, 0.0, 45.0)
  $rimfrag_c = clamp($rimfrag, 0.0, 1.0)
  $rimchips_c = clamp($rimchips, 0.0, 10.0)
  $long_c = clamp($long, 0.0, 1.0)
  $deep_c = clamp($deep, 0.2, 1.5)
  $ldeep_c = clamp($ldeep, 0.4, 2.5)
  $splint_c = clamp($splint, 0.2, 2.0)
  $slant_c = clamp($slant, 0.0, 20.0)
  $grain_c = clamp($grain, 0.1, 0.6)
  $lean_c = clamp($lean, 0.0, 3.0)
  $horn_c = clamp($horn, 0.0, 1.0)
  $rings_c = clamp($rings, 0.0, 1.0)
  $torn_c = clamp($torn, 0.0, 1.0)
  $torntilt_c = clamp($torntilt, 0.0, 0.5)
  $tornrib_c = clamp($tornrib, 0.0, 1.0)
  $tornsep_c = clamp($tornsep, 0.0, 0.5)
  $uvbox_c = clamp($uvbox, 0.0, 1.0)
  $detail_c = clamp($detail, 0.06, 0.4)
  $hdetail_c = clamp($hdetail, 0.06, 0.4)
  $jdetail_c = clamp($jdetail, 0.1, 0.6)
  $tile_c = clamp($tile, 20.0, 400.0)
  $aspect_c = clamp($aspect, 0.25, 4.0)
  $SX = clamp($size_x, 100.0, 400.0)
  $SY = clamp($size_y, 100.0, 400.0)
  $DMG = clamp($damage, 0.4, 1.4)
  $AGE = clamp($age, 0.0, 2.0)
  $F = 0.5 * $AGE * (1 + $AGE)
  $BG = clamp(floor($budget + 0.5), 0, 2)
  $arris = 1 + 2 * clamp($BG, 0, 1)
  $seg = 2 * (1 + clamp($BG, 0, 1)) * (1 + clamp($BG - 1, 0, 1))
  $n = floor($SX / ($board_w_c + $board_gap_c) + 0.5)
  $pitch = $SX / $n
  $bw = $pitch - $board_gap_c
  $js = $SY / $joists_c
  $clr = $js - $joist_w_c
  $q0 = sin($noise * 1009 * 12.9898 + 13.1) * 43758.5453
  $q0 = $q0 - floor($q0)
  $q2 = sin($noise * 1009 * 12.9898 + 41.3) * 43758.5453
  $q2 = $q2 - floor($q2)
  $q3 = sin($noise * 1009 * 12.9898 + 55.9) * 43758.5453
  $q3 = $q3 - floor($q3)
  $q9 = sin($noise * 1009 * 12.9898 + 139.9) * 43758.5453
  $q9 = $q9 - floor($q9)
  $q10 = sin($noise * 1009 * 12.9898 + 153.1) * 43758.5453
  $q10 = $q10 - floor($q10)
  $sx = $DMG * $hole_rx_c * (1 + $svar_c * (2 * $q0 - 1))
  $sx = min($sx, 0.5 * $SX - 1.2 * $pitch)
  $cx = $hole_x_c * $SX + $cvar_c * (2 * $q2 - 1)
  $cx = clamp($cx, min($sx + 0.5 * $pitch, 0.5 * $SX), max($SX - $sx - 0.5 * $pitch, 0.5 * $SX))
  $cy = clamp($hole_y_c * $SY + $cvar_c * (2 * $q3 - 1), $js, $SY - $js)
  $kv = clamp(floor($cy / $js), 1, $joists_c - 2)
  $iL = ceil(($cx - $sx) / $pitch - 0.5)
  $iR = floor(($cx + $sx) / $pitch - 0.5)
  $m = $iR - $iL + 1
  $rfb = $iL + floor(($m - 1) * (0.1 + 0.15 * $q9))
  $rfb = $rfb + clamp(ceil($q10 - 0.5), 0, 1) * ($iL + $iR - 2 * $rfb)
  $fj1 = ($kv - 0.5) * $js + 0.5 * $joist_w_c
  $fj2 = ($kv + 1.5) * $js - 0.5 * $joist_w_c
  $yv = ($kv + 0.5) * $js
  $v0 = sin($noise * 1009 * 12.9898 + 413.1) * 43758.5453
  $v0 = $v0 - floor($v0)
  $v1 = sin($noise * 1009 * 12.9898 + 427.7) * 43758.5453
  $v1 = $v1 - floor($v1)
  $v2 = sin($noise * 1009 * 12.9898 + 441.3) * 43758.5453
  $v2 = $v2 - floor($v2)
  $v3 = sin($noise * 1009 * 12.9898 + 455.9) * 43758.5453
  $v3 = $v3 - floor($v3)
  $v4 = sin($noise * 1009 * 12.9898 + 469.1) * 43758.5453
  $v4 = $v4 - floor($v4)
  $xs = $cx + 0.3 * $sx * (2 * $v0 - 1)
  $vh = $board_t_c + $joist_d_c
  $vg1 = clamp(($below_c - $vh - 0.8) / ($xs + $vreach_c), 0.02, 0.999)
  $vg2 = clamp(($below_c - $vh - 0.8) / ($SX - $xs + $vreach_c), 0.02, 0.999)
  $vd1 = min($vdrop_c * (0.8 + 0.2 * $v1), asin($vg1))
  $vd2 = min($vdrop_c * (0.8 + 0.2 * $v2), asin($vg2))
  $vy1 = $vsplay_c * (0.5 + 0.5 * $v3)
  $vy2 = $vsplay_c * (0.5 + 0.5 * $v4)
  $xb1 = 0.5 * $joist_w_c * sin($vy1) + 0.05
  $xb2 = $SX - 0.5 * $joist_w_c * sin($vy2) - 0.05
  $za1 = -$vh + $joist_d_c / cos($vd1)
  $za2 = -$vh + $joist_d_c / cos($vd2)
  $xt1 = $xs * cos($vd1) + $joist_d_c * sin($vd1)
  $xt2 = ($SX - $xs) * cos($vd2) + $joist_d_c * sin($vd2)
  $Dsg = 0.6 + $js * tan($vmin_c)
  $es1 = ($dsag_c - $joist_d_c + $joist_d_c / cos($vd1)) / tan($vd1)
  $es2 = ($dsag_c - $joist_d_c + $joist_d_c / cos($vd2)) / tan($vd2)
  $nf1 = max($iL, ceil(($xb1 + $es1 * cos($vy1) + 0.5 * $bw) / $pitch - 0.5))
  $nl2 = min($iR, floor(($xb2 - $es2 * cos($vy2) - 0.5 * $bw) / $pitch - 0.5))
  $XA1 = $nf1 * $pitch
  $XB1 = min(($iR + 1) * $pitch, $xs - 8.0)
  $XA2 = max($iL * $pitch, $xs + 8.0)
