  $deep_c = clamp($deep, 0.2, 1.5)
  $ldeep_c = clamp($ldeep, 0.4, 2.5)
  $slant_c = clamp($slant, 0.0, 20.0)
  $torn_c = clamp($torn, 0.0, 1.0)
  $torntilt_c = clamp($torntilt, 0.0, 0.5)
  $tornrib_c = clamp($tornrib, 0.0, 1.0)
  $tornsep_c = clamp($tornsep, 0.0, 0.5)
  $tile_c = clamp($tile, 20.0, 400.0)
  $aspect_c = clamp($aspect, 0.25, 4.0)
  $dshort_c = clamp($dshort, 0.0, 120.0)
  $frag_c = clamp($frag, 30.0, 200.0)
  $tumble_c = clamp($tumble, 0.0, 45.0)
  $tilt_c = clamp($tilt, 0.0, 1.0)
  $edge_c = clamp($edge, 0.0, 1.0)
  $lsplit_c = clamp($lsplit, 0.0, 1.0)
  $ddetail_c = clamp($ddetail, 0.06, 0.3)
  $SX = clamp($size_x, 100.0, 400.0)
  $SY = clamp($size_y, 100.0, 400.0)
  $DMG = clamp($damage, 0.0, 1.6)
  $AGE = clamp($age, 0.0, 2.0)
  $F = min($AGE, 1.0) + 2 * max($AGE - 1.0, 0.0)
  $FLY = min($F, 1.0)
  $SOFT = clamp($softness, 0.0, 1.0)
  $jdecay_c = clamp($jdecay, 0.0, 1.0)
  $jcheck_c = clamp($jcheck, 0.0, 0.45)
  $jends_c = clamp($jends, 0.0, 0.6)
  $sease_c = clamp($sease, 0.02, 0.3)
  $sthru_c = clamp($sthru, 0.0, 1.0)
  $groove_c = clamp($groove, 0.0, 3.0)
  $gshare_c = clamp($gshare, 0.0, 1.0)
  $gouge_c = clamp($gouge, 0.0, 4.0)
  $lips_c = clamp($lips, 0.0, 3.0)
  $hollow_c = clamp($hollow, 0.0, 2.0)
  $edgew_c = clamp($edgew, 0.0, 3.0)
  $JDV = $jdecay_c * min($AGE, 1.0) * (0.35 + 0.65 * clamp(($AGE - 1.0) / 0.8, 0, 1))
  $n = floor($SX / (clamp($board_w, 8.0, 40.0) + $board_gap_c) + 0.5)
  $pitch = $SX / $n
  $bw = $pitch - $board_gap_c
  $js = $SY / $joists_c
  $clr = $js - $joist_w_c
  $q0 = $Hash($noise * 1009, 13.1)
  $q1 = $Hash($noise * 1009, 27.7)
  $q2 = $Hash($noise * 1009, 41.3)
  $q3 = $Hash($noise * 1009, 55.9)
  $q4 = $Hash($noise * 1009, 69.1)
  $q5 = $Hash($noise * 1009, 83.3)
  $q6 = $Hash($noise * 1009, 97.9)
  $q7 = $Hash($noise * 1009, 111.7)
  $q8 = $Hash($noise * 1009, 125.3)
  $q9 = $Hash($noise * 1009, 139.9)
  $q10 = $Hash($noise * 1009, 153.1)
  $q11 = $Hash($noise * 1009, 167.7)
  $q12 = $Hash($noise * 1009, 181.3)
  $q13 = $Hash($noise * 1009, 195.9)
  $q14 = $Hash($noise * 1009, 209.1)
  $q15 = $Hash($noise * 1009, 223.3)
  $q16 = $Hash($noise * 1009, 237.9)
  $q17 = $Hash($noise * 1009, 251.7)
  $q18 = $Hash($noise * 1009, 265.3)
  $q19 = $Hash($noise * 1009, 279.9)
  $q20 = $Hash($noise * 1009, 293.1)
  $q21 = $Hash($noise * 1009, 307.7)
  $q22 = $Hash($noise * 1009, 321.3)
  $q23 = $Hash($noise * 1009, 335.9)
  $sx = $DMG * clamp($hole_rx, 5.0, 150.0) * (1 + clamp($svar, 0.0, 0.5) * (2 * $q0 - 1))
  $sx = min($sx, 0.5 * $SX - 1.2 * $SX / floor($SX / (clamp($board_w, 8.0, 40.0) + $board_gap_c) + 0.5))
  $hy = $DMG * clamp($hole_ry, 5.0, 100.0) * (1 + clamp($svar, 0.0, 0.5) * (2 * $q1 - 1))
  $cx = clamp($hole_x, 0.0, 1.0) * $SX + clamp($cvar, 0.0, 50.0) * (2 * $q2 - 1)
  $cx = clamp($cx, min($sx + 0.5 * $pitch, 0.5 * $SX), max($SX - $sx - 0.5 * $pitch, 0.5 * $SX))
  $cy = clamp(clamp($hole_y, 0.0, 1.0) * $SY + clamp($cvar, 0.0, 50.0) * (2 * $q3 - 1), $js, $SY - $js)
  $iL = ceil(($cx - $sx) / $pitch - 0.5)
  $iR = floor(($cx + $sx) / $pitch - 0.5)
  $m = $iR - $iL + 1
  $S = min(floor((clamp($survive, 0.0, 2.0) + 1) * $q15 * 0.999), max($m - 2, 0))
  $s1 = clamp(floor(($m - 1) * (0.15 + 0.2 * $q16 + 0.5 * floor(2 * $q17)) + 0.5), 1, max($m - 2, 1))
  $s2 = clamp($s1 + 1 - 2 * floor(2 * $q17), 1, max($m - 2, 1))
  $s2 = $s2 + clamp(1 - abs($s2 - $s1), 0, 1) * (2 * clamp($m - 3 - $s1, 0, 1) - 1)
  $tj1 = clamp(floor(($cy - $hy) / $js), 0, $joists_c - 2)
  $tj2 = clamp(floor(($cy + $hy) / $js), $tj1 + 1, $joists_c - 1)
  $lo1 = max($tj1 - 1, 0)
  $hi1 = min($tj1 + 1, $joists_c - 2)
  $lo2 = max($tj2 - 1, 1)
  $hi2 = min($tj2 + 1, $joists_c - 1)
  $o1 = clamp($tj1 + clamp(ceil($q4 - 0.8), 0, 1) - clamp(ceil(0.2 - $q4), 0, 1), $lo1, $hi1)
  $o2 = clamp($tj2 + clamp(ceil($q5 - 0.8), 0, 1) - clamp(ceil(0.2 - $q5), 0, 1), $lo2, $hi2)
  $stb = $iL + floor(($m - 1) * (0.05 + 0.2 * $q6))
  $stb = $stb + clamp(ceil($q7 - 0.5), 0, 1) * ($iL + $iR - 2 * $stb)
  $sts = 1 + floor(2 * $q8)
  $rfb = $iL + floor(($m - 1) * (0.1 + 0.15 * $q9))
  $rfb = $rfb + clamp(ceil($q10 - 0.5), 0, 1) * ($iL + $iR - 2 * $rfb)
  $qm1 = $Hash($noise * 1009, 3541.7)
  $qm2 = $Hash($noise * 1009, 3617.3)
  $DK = $decay_c + (1 - clamp(ceil($decay_c + 0.5), 0, 1)) * (clamp(($AGE - 1.1) / 0.7, 0, 1) - $decay_c)
  # the pile falls on the hole's footprint grown grow times, clamped so that no fragment (at most fcap long,
  # landing by its centre at any turn) reaches past the debris line's 20 cm margin round the module (kit 2.0.3)
  $fcap = 1.6 * $frag_c
  $reach = 0.5 * $fcap + 0.5 * $bw + 2.0
  $grx = min(clamp($grow, 1.0, 2.5) * ($sx + 0.5 * $pitch), min($cx, $SX - $cx) + 20.0 - $reach)
  $gry = min(clamp($grow, 1.0, 2.5) * $hy, min($cy, $SY - $cy) + 20.0 - $reach)
  ground = add($Disc, scale=(max($grx, 1.0), max($gry, 1.0), 1.0), at=($cx, $cy, -1.0))
  # round 8 (debris rubric P2, P3): each piece is DROPPED from over where it was, pulled `heap` toward the hole's middle,
  # and SETTLES (G31) on the ground and on the pieces already down: a heap, every piece resting on what is under it
  $HP = 1 - clamp($heap, 0.0, 0.9)
  $j1 = $o1
  $j2 = $o2
  $pa = 0
  $pb = 0
  loop (repeat=$n) {
    $i = output.index - 1
    $ub0 = $Hash(($fseed * 1009 + $i), 2111.3)
    $ub1 = $Hash(($fseed * 1009 + $i + 1), 2111.3)
    $vb0 = $Hash(($fseed * 1009 + $i), 2237.9)
    $vb1 = $Hash(($fseed * 1009 + $i + 1), 2237.9)
    $Xl = ($i) * $pitch + clamp($i, 0, 1) * clamp($wjit, 0.0, 0.25) * $FLY * $pitch * (2 * $ub0 - 1) * (1.5 - 0.5 * (2 * $ub0 - 1) * (2 * $ub0 - 1))
    $Xr = ($i + 1) * $pitch + clamp($n - 1 - ($i), 0, 1) * clamp($wjit, 0.0, 0.25) * $FLY * $pitch * (2 * $ub1 - 1) * (1.5 - 0.5 * (2 * $ub1 - 1) * (2 * $ub1 - 1))
    $gl = (clamp($i, 0, 1)) * ($gapmin_c + (clamp($gapmax, 0.0, 2.0) - $gapmin_c) * $F * $vb0) + (1 - (clamp($i, 0, 1))) * (clamp($egap, 0.0, 1.0))
    $gr = (clamp($n - 1 - ($i), 0, 1)) * ($gapmin_c + (clamp($gapmax, 0.0, 2.0) - $gapmin_c) * $F * $vb1) + (1 - (clamp($n - 1 - ($i), 0, 1))) * (clamp($egap, 0.0, 1.0))
    $lw = $Xr - $Xl - 0.5 * ($gl + $gr)
    $x = $Xl + 0.5 * $gl + 0.5 * $lw
    $jd1 = $Hash(($fseed * 1009 + $i), 2363.1)
    $jd2 = $Hash(($fseed * 1009 + $i), 2489.3)
    $jd3 = $Hash(($fseed * 1009 + $i), 2531.7)
    $jd4 = $Hash(($fseed * 1009 + $i), 2677.9)
    $jd5 = $Hash(($fseed * 1009 + $i), 2711.3)
    $jd6 = $Hash(($fseed * 1009 + $i), 2857.9)
    $jd7 = $Hash(($fseed * 1009 + $i), 2903.7)
    $jd8 = $Hash(($fseed * 1009 + $i), 2971.1)
    $jd9 = $Hash(($fseed * 1009 + $i), 3049.3)
    $jd10 = $Hash(($fseed * 1009 + $i), 3121.9)
    $nint = $joists_c - 2
    $ja0 = clamp(ceil($jd1 - $pnone_c), 0, 1) * clamp(1 + floor($nint * ($jd1 - $pnone_c) / max(1 - $pnone_c, 0.001)), 1, $nint)
    $jc1 = clamp(ceil(($ja0) - (0.5)), 0, 1) * max(clamp(1 - abs(($ja0) - ($pa)), 0, 1), clamp(1 - abs(($ja0) - ($pb)), 0, 1))
    $ja1 = $ja0 + $jc1 * (1 + (($ja0) - ($nint) * floor(($ja0) / ($nint))) - $ja0)
    $jc2 = $jc1 * max(clamp(1 - abs(($ja1) - ($pa)), 0, 1), clamp(1 - abs(($ja1) - ($pb)), 0, 1))
    $ja2 = $ja1 + $jc2 * (1 + (($ja1) - ($nint) * floor(($ja1) / ($nint))) - $ja1)
    $jc3 = $jc2 * max(clamp(1 - abs(($ja2) - ($pa)), 0, 1), clamp(1 - abs(($ja2) - ($pb)), 0, 1))
    $ja = $ja2 * (1 - $jc3)
    $jb = clamp(ceil(($ja) - (0.5)), 0, 1) * clamp(ceil(($nint + 0.5) - ($ja + 2)), 0, 1) * clamp(ceil((clamp($ptwo, 0.0, 1.0)) - ($jd2)), 0, 1) * (1 - max(clamp(1 - abs(($ja + 2) - ($pa)), 0, 1), clamp(1 - abs(($ja + 2) - ($pb)), 0, 1))) * ($ja + 2)
    $pa = $ja
    $pb = $jb
    $h1 = clamp(ceil(($ja) - (0.5)), 0, 1)
    $h2 = clamp(ceil(($jb) - (0.5)), 0, 1)
    $jy1 = ($h1) * (($ja + 0.5) * $js) + (1 - ($h1)) * ($SY)
    $jy2 = ($h2) * (($jb + 0.5) * $js) + (1 - ($h2)) * ($SY)
    $hb1 = 0.5 * ($bgmin_c + (clamp($bgmax, 0.05, 2.0) - $bgmin_c) * $jd3)
    $hb2 = 0.5 * ($bgmin_c + (clamp($bgmax, 0.05, 2.0) - $bgmin_c) * $jd4)
    $fa0 = 0.6 * clamp($endsq, 0.0, 5.0) * $F * (2 * $jd8 - 1)
    $fa3 = 0.6 * clamp($endsq, 0.0, 5.0) * $F * (2 * $jd10 - 1)
    $ei0 = clamp($einset, 0.02, 40.0) + clamp($eivar, 0.0, 20.0) * $F * $jd7 + 0.5 * $bw * abs(tan($fa0))
    $ei1 = clamp($einset, 0.02, 40.0) + clamp($eivar, 0.0, 20.0) * $F * $jd9 + 0.5 * $bw * abs(tan($fa3))
    $sab[0] = ($ei0, ($h1) * ($jy1 - $hb1) + (1 - ($h1)) * ($SY - $ei1))
    $sab[1] = ($jy1 + $hb1, ($h2) * ($jy2 - $hb2) + (1 - ($h2)) * ($SY - $ei1))
    $sab[2] = ($jy2 + $hb2, $SY - $ei1)
    $K = $noise * 1009 + $i
    $ins = clamp(ceil($sx - abs($x - $cx)), 0, 1)
    $li = $i - $iL
    # bd[k]: wj1 wl1 wj2 wl2 ft1 ft2 pc1 pc2 po1 po2 ps1 ps2 an1 an2 ab1 ab2 ln1 ln2 l1 l2 dr1 dr2 sr1 sr2 vr1 vr2 hn1 hn2 hh1 hh2 a1 a2 r1 r2 e1 e2 z1 z2 lay wx wc1 wc2 wf1 wf2 rr1 rr2 rr3
    loop (47) {
      $ix = output.index - 1
      $bd[$ix] = $Hash($K, floor(10 * (11.3 + 13.7 * $ix) + 0.5) / 10)
    }
    $lg1 = clamp(ceil($long_c - $bd[18]), 0, 1)
    $lg2 = clamp(ceil($long_c - $bd[19]), 0, 1)
    $dp1 = ($deep_c + ($ldeep_c - $deep_c) * $lg1) * (0.85 + 0.3 * $bd[20])
    $dp2 = ($deep_c + ($ldeep_c - $deep_c) * $lg2) * (0.85 + 0.3 * $bd[21])
    $sp1 = clamp($splint, 0.2, 2.0) * (0.6 + 0.8 * $bd[22])
    $sp2 = clamp($splint, 0.2, 2.0) * (0.6 + 0.8 * $bd[23])
    $vp1 = 0.4 + 0.6 * $bd[24]
    $vp2 = 0.4 + 0.6 * $bd[25]
    $tn1 = $torn_c * (1 - $lg1)
    $tn2 = $torn_c * (1 - $lg2)
    $bd[26] = clamp(ceil(clamp($horn, 0.0, 1.0) - $bd[26]), 0, 1) * (1.2 + 1.3 * $bd[28]) * (1 - clamp(ceil($tn1), 0, 1))
    $bd[27] = clamp(ceil(clamp($horn, 0.0, 1.0) - $bd[27]), 0, 1) * (1.2 + 1.3 * $bd[29]) * (1 - clamp(ceil($tn2), 0, 1))
    $bd[30] = $slant_c * (2 * $bd[30] - 1)
    $bd[31] = $slant_c * (2 * $bd[31] - 1)
    $bd[32] = clamp($grain, 0.1, 0.6) * (0.75 + 0.5 * $bd[32])
    $bd[33] = clamp($grain, 0.1, 0.6) * (0.75 + 0.5 * $bd[33])
    $bd[34] = clamp($lean, 0.0, 3.0) * (0.6 + 0.8 * $bd[34])
    $bd[35] = clamp($lean, 0.0, 3.0) * (0.6 + 0.8 * $bd[35])
    $rq1 = 0.16 * $dp1 * $bw * (1 + 0.3 * $sp1 + 0.2 * $vp1) + 0.5 * $bd[34] * $board_t_c + 0.6 * $bd[26] * $board_t_c + 0.5 * $bw * tan(abs($bd[30])) + 1.5 + clamp(ceil($tn1), 0, 1)
    $rq2 = 0.16 * $dp2 * $bw * (1 + 0.3 * $sp2 + 0.2 * $vp2) + 0.5 * $bd[35] * $board_t_c + 0.6 * $bd[27] * $board_t_c + 0.5 * $bw * tan(abs($bd[31])) + 1.5 + clamp(ceil($tn2), 0, 1)
    $jp1 = clamp(ceil(clamp($jump, 0.0, 1.0) - $bd[0]), 0, 1)
    $j1 = $ins * clamp($j1 + $jp1 * ($tj1 - $j1 + (1 - abs($tj1 - $j1)) * (2 * floor(2 * $bd[1]) - 1)), $lo1, $hi1) + (1 - $ins) * $o1
    $jp2 = clamp(ceil(clamp($jump, 0.0, 1.0) - $bd[2]), 0, 1)
    $j2 = $ins * clamp($j2 + $jp2 * ($tj2 - $j2 + (1 - abs($tj2 - $j2)) * (2 * floor(2 * $bd[3]) - 1)), $lo2, $hi2) + (1 - $ins) * $o2
    $j2 = max($j2, $j1 + 1)
    $fj1 = ($j1 + 0.5) * $js + 0.5 * $joist_w_c
    $fj2 = ($j2 + 0.5) * $js - 0.5 * $joist_w_c
    $ob = clamp(1 - abs($j2 - $j1 - 1), 0, 1)
    $lv1 = clamp(ceil($plevel_c - $bd[4]), 0, 1)
    $hg1 = clamp(ceil($plevel_c + $phang_c - $bd[4]), 0, 1) - $lv1
    $ck1 = clamp(ceil($plevel_c + $phang_c + clamp($pcrack, 0.0, 1.0) - $bd[4]), 0, 1) - $lv1 - $hg1
    $st1 = 1 - $lv1 - $hg1 - $ck1
    $lv2 = clamp(ceil($plevel_c - $bd[5]), 0, 1)
    $hg2 = clamp(ceil($plevel_c + $phang_c - $bd[5]), 0, 1) - $lv2
    $ck2 = clamp(ceil($plevel_c + $phang_c + clamp($pcrack, 0.0, 1.0) - $bd[5]), 0, 1) - $lv2 - $hg2
    $st2 = 1 - $lv2 - $hg2 - $ck2
    $nl1 = clamp($stub, 0.0, 1.0) * clamp(1 - abs($i - $stb), 0, 1) * clamp(2 - $sts, 0, 1)
    $nl2 = clamp($stub, 0.0, 1.0) * clamp(1 - abs($i - $stb), 0, 1) * clamp($sts - 1, 0, 1)
    $fl1 = $ob * $nl2
    $lv1 = max($lv1 * (1 - $nl1), $fl1)
    $hg1 = $hg1 * (1 - $nl1) * (1 - $fl1)
    $ck1 = $ck1 * (1 - $nl1) * (1 - $fl1)
    $st1 = $st1 * (1 - $nl1) * (1 - $fl1)
    $fl2 = $ob * (1 - $lv1) * (1 - $nl2)
    $lv2 = max($lv2 * (1 - $nl2), $fl2)
    $hg2 = $hg2 * (1 - $nl2) * (1 - $fl2)
    $ck2 = $ck2 * (1 - $nl2) * (1 - $fl2)
    $st2 = $st2 * (1 - $nl2) * (1 - $fl2)
    $ss1 = $lv1 * max(clamp(ceil(clamp($pshort, 0.0, 1.0) - $bd[10]), 0, 1), $ob) * clamp($j1, 0, 1)
    $ss2 = $lv2 * max(clamp(ceil(clamp($pshort, 0.0, 1.0) - $bd[11]), 0, 1), $ob) * clamp($joists_c - 1 - $j2, 0, 1)
    $md1 = ($lv1 + $ck1 * (1 - $ob)) * clamp(ceil(clamp($midbay, 0.0, 1.0) - $bd[6]), 0, 1) * (1 - $ob * (1 - $ss1))
    $md2 = ($lv2 + $ck2 * (1 - $ob)) * clamp(ceil(clamp($midbay, 0.0, 1.0) - $bd[7]), 0, 1) * (1 - $ob * (1 - $ss2))
    $u1 = (1 - $md1) * (-1.5 + 4.0 * $bd[8]) + $md1 * ((1 - $ss1) * (5.0 + 10.0 * $bd[8]) - $ss1 * ($joist_w_c + 5.0 + 10.0 * $bd[8]))
    $u2 = (1 - $md2) * (-1.5 + 4.0 * $bd[9]) + $md2 * ((1 - $ss2) * (5.0 + 10.0 * $bd[9]) - $ss2 * ($joist_w_c + 5.0 + 10.0 * $bd[9]))
    $hy1 = $fj1 + $ck1 * max($u1, 0)
    $hy2 = $fj2 - $ck2 * max($u2, 0)
    $y1 = $fj1 + $u1
    $y2 = $fj2 - $u2
    $mm1 = 0.5 * ($bd[12] + $bd[14])
    $mm2 = 0.5 * ($bd[13] + $bd[15])
    $t1 = $hg1 * ($hlo_c + (clamp($hhi, 0.0, 85.0) - $hlo_c) * $mm1 * (0.6 + 0.4 * $mm1)) + $ck1 * ($clo_c + (clamp($chi, 0.0, 45.0) - $clo_c) * $bd[12]) + $st1 * ($slo_c + (clamp($shi, 30.0, 88.0) - $slo_c) * $bd[12]) + $nl1 * ($nlo_c + (clamp($nhi, 10.0, 85.0) - $nlo_c) * $bd[12])
    $t2 = $hg2 * ($hlo_c + (clamp($hhi, 0.0, 85.0) - $hlo_c) * $mm2 * (0.6 + 0.4 * $mm2)) + $ck2 * ($clo_c + (clamp($chi, 0.0, 45.0) - $clo_c) * $bd[13]) + $st2 * ($slo_c + (clamp($shi, 30.0, 88.0) - $slo_c) * $bd[13]) + $nl2 * ($nlo_c + (clamp($nhi, 10.0, 85.0) - $nlo_c) * $bd[13])
    $L1 = $hg1 * (12.0 + 16.0 * $bd[16]) + $ck1 * (14.0 + 16.0 * $bd[16]) + $st1 * (10.0 + 14.0 * $bd[16]) + $nl1 * ($nmin_c + (clamp($nmax, 4.0, 30.0) - $nmin_c) * $bd[16])
    $L2 = $hg2 * (12.0 + 16.0 * $bd[17]) + $ck2 * (14.0 + 16.0 * $bd[17]) + $st2 * (10.0 + 14.0 * $bd[17]) + $nl2 * ($nmin_c + (clamp($nmax, 4.0, 30.0) - $nmin_c) * $bd[17])
    $L1 = min($L1, ($clr - ($hy1 - $fj1) - 1.5 - $rq1 - $board_t_c * sin($t1)) / max(cos($t1), 0.05))
    $L2 = min($L2, ($clr - ($fj2 - $hy2) - 1.5 - $rq2 - $board_t_c * sin($t2)) / max(cos($t2), 0.05))
    $L1 = min($L1, $ob * $lv2 * ($y2 - $hy1 - $rq2 - 1.5 - $rq1) / max(cos($t1), 0.05) + (1 - $ob * $lv2) * 999.0)
    $L2 = min($L2, $ob * $lv1 * ($hy2 - $y1 - $rq1 - 1.5 - $rq2) / max(cos($t2), 0.05) + (1 - $ob * $lv1) * 999.0)
    $N1 = $lv1 * $y1 + (1 - $lv1) * $hy1
    $N2 = $lv2 * $y2 + (1 - $lv2) * $hy2
    $L1 = min($L1, max(($N2 - $N1 - clamp($gmin, 5.0, 60.0)) * (1 - 0.5 * (1 - $lv2)), 0))
    $L2 = min($L2, max(($N2 - $N1 - clamp($gmin, 5.0, 60.0)) * (1 - 0.5 * (1 - $lv1)), 0))
    $g1 = (1 - $lv1) * clamp(ceil($L1 - 6.0), 0, 1)
